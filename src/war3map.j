//library AMHAbility:
// B947: lightweight synchronous source context, no file I/O or tracing timer.
function B991BlocksBasic takes unit u991,integer order991 returns boolean
local integer p991=0
local unit a991=null
local boolean result991=false
if u991==null or u991==B991OrderOwner then
return false
endif
set p991=GetPlayerId(GetOwningPlayer(u991))
if p991>=12 or B991Owner[p991]!=u991 or M7[p991]!=u991 or B991Until[p991]<=0. or GetHeroLevel(u991)<10 then
return false
endif
if order991!=851971 and order991!=851972 and order991!=851983 and order991!=851984 and order991!=851985 and order991!=851986 and order991!=851990 and order991!=851993 then
return false
endif
set a991=B991Attacker[p991]
// The decision callback validates the attack target; this early wrapper uses native queries only.
set result991=GetWidgetLife(u991)>.405 and a991!=null and GetWidgetLife(a991)>.405 and IsUnitEnemy(a991,GetOwningPlayer(u991)) and IsUnitVisible(a991,GetOwningPlayer(u991)) and IsUnitInRange(u991,a991,350.) and (TimerGetElapsed(W)-B991HitTime[p991]<=1.5 or B993ControlPending[p991] or TimerGetElapsed(W)<B993ThreatUntil[p991] or GetUnitCurrentOrder(a991)==851983)
set a991=null
return result991
endfunction
function B957BlocksOrder takes unit unit957,integer order957,integer kind957,real x957,real y957 returns boolean
local integer player957=0
if GetUnitTypeId(unit957)=='H0DO' and (order957==851971 or order957==851972 or order957==851983 or order957==851984 or order957==851985 or order957==851986 or order957==851990 or order957==851993) and LoadReal(L7,GetHandleId(unit957),StringHash("B1021Hold"))>TimerGetElapsed(W) and not LoadBoolean(L7,GetHandleId(unit957),StringHash("B1021Issuing")) then
return true
endif
if B991BlocksBasic(unit957,order957) then
return true
endif
if unit957==null or unit957==B957OrderOwner then
return false
endif
set player957=GetPlayerId(GetOwningPlayer(unit957))
if player957>=12 or unit957!=M7[player957] or GetPlayerController(GetOwningPlayer(unit957))!=MAP_CONTROL_COMPUTER or B957State[player957]==0 then
return false
endif
if order957!=851971 and order957!=851972 and order957!=851983 and order957!=851984 and order957!=851985 and order957!=851986 and order957!=851990 and order957!=851993 then
return false
endif
// Preserve close self-defense, but never let a distant target pull a gathering hero out.
if B957State[player957]!=3 and kind957==3 and (order957==851983 or order957==851985) then
if (x957-GetUnitX(unit957))*(x957-GetUnitX(unit957))+(y957-GetUnitY(unit957))*(y957-GetUnitY(unit957))<810000. then
if B957State[player957]==4 or (x957-B957X[player957])*(x957-B957X[player957])+(y957-B957Y[player957])*(y957-B957Y[player957])<2560000. then
return false
endif
endif
endif
return true
endfunction
function B947IssueBuildOrderById takes string site947,unit u947,integer id947,real x947,real y947 returns boolean
local string previousSite947=B947OrderSite
local unit previousUnit947=B947OrderUnit
local widget previousTarget947=B947OrderTarget
local integer previousOrder947=B947OrderId
local integer previousKind947=B947OrderKind
local boolean result947=false
if B946DetectCount==0 then
set previousUnit947=null
set previousTarget947=null
return IssueBuildOrderById(u947,id947,x947,y947)
endif
set B947OrderSite=site947
set B947OrderUnit=u947
set B947OrderTarget=null
set B947OrderId=id947
set B947OrderKind=2
set result947=IssueBuildOrderById(u947,id947,x947,y947)
set B947OrderSite=previousSite947
set B947OrderUnit=previousUnit947
set B947OrderTarget=previousTarget947
set B947OrderId=previousOrder947
set B947OrderKind=previousKind947
set previousUnit947=null
set previousTarget947=null
return result947
endfunction
