function E7G takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,7,false)
if IsUnitAlly(b1060GetSpellTargetUnit,GetOwningPlayer(b1060GetTriggerUnit))==false then
call TriggerAddCondition(t,Condition(function E4G))
call SaveUnitHandle(L7,(I97),(2),(b1060GetTriggerUnit))
call SaveUnitHandle(L7,(I97),(17),(b1060GetSpellTargetUnit))
call SaveEffectHandle(L7,(I97),(175),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",b1060GetSpellTargetUnit,"chest")))
call SaveEffectHandle(L7,(I97),(176),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",b1060GetTriggerUnit,"chest")))
call UnitAddAbility(b1060GetTriggerUnit,'A1ZJ')
call UnitAddAbility(b1060GetSpellTargetUnit,'A1ZJ')
call UnitMakeAbilityPermanent(b1060GetTriggerUnit,true,'A1ZJ')
call UnitMakeAbilityPermanent(b1060GetSpellTargetUnit,true,'A1ZJ')
else
call TriggerAddCondition(t,Condition(function NIOZ))
call SaveUnitHandle(L7,(I97),(2),(b1060GetTriggerUnit))
call SaveUnitHandle(L7,(I97),(17),(b1060GetSpellTargetUnit))
call SaveEffectHandle(L7,(I97),(175),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",b1060GetSpellTargetUnit,"chest")))
call SaveEffectHandle(L7,(I97),(176),(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl",b1060GetTriggerUnit,"chest")))
call UnitAddAbility(b1060GetTriggerUnit,'A1ZJ')
call UnitAddAbility(b1060GetSpellTargetUnit,'A2RE')
call UnitMakeAbilityPermanent(b1060GetTriggerUnit,true,'A1ZJ')
call UnitMakeAbilityPermanent(b1060GetSpellTargetUnit,true,'A2RE')
endif
set t=null
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
