call UnitRemoveAbility(m5,'Aetl')
set suijiDetectXnKillDummy=CreateUnit(GetOwningPlayer(p5),'e00E',0,0,0)
call UnitDamageTarget(suijiDetectXnKillDummy,m5,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitApplyTimedLife(suijiDetectXnKillDummy,'BTLF',1.)
		set XMGL_KILL=false
	endif
	call Add_EX_PlayerDamage(p5,m5,B39)
endif
call NQ7(OB7,"LastX",x)
call NQ7(OB7,"LastY",y)
call NP7(OB7,"Iteration",QI+1)
if XH7(m5)then
call NM7(OB7)
call OZ7(t)
elseif QI>durationIterations then
call UnitRemoveAbility(m5,'A0IH')
call UnitRemoveAbility(m5,'B08L')
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set m5=null
set suijiDetectXnKillDummy=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function xp takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer V77=B287_GetUnitAbilityLevel(p5,'A0LH')+B287_GetUnitAbilityLevel(p5,'A2Z9')+Labike_Multiple_Skill_Level(p5,'A0LH')
local real YM7=50+100*V77
local integer OB7=Get_Multiple_Skill_Key(p5,'A0LH')
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
local integer durationCount=SuijiMode_GetDurationMulticastCount(p5,B287_GetSpellAbilityId())
local integer id=GetUnitTypeId(p5)
if N5E>0 then
    if WQ7(m5) then
        call PLK(m5)
    else
    call SuijiMode_EnsureExactLiveAbilityLevel(m5,'A0IH',V77,true)
        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",m5,"chest"))
        call NT7(I97,"Source",p5)
        call NT7(I97,"Target",m5)
        call NP7(I97,"Level",V77)
        call NQ7(I97,"LastX",GetUnitX(m5))
        call NQ7(I97,"LastY",GetUnitY(m5))
        call NP7(I97,"Iteration",0)
        call NP7(I97,"DurationIterations",48*durationCount)
        call TriggerRegisterTimerEvent(t,.25,true)
        call TriggerAddCondition(t,Condition(function xn))
        call TriggerRegisterDeathEvent(t,m5)
        if((LoadInteger(L7,(GetHandleId((m5))),((2485))))==1)and YM7>=GetUnitState(m5,UNIT_STATE_LIFE)-2 then
            set YM7=GetUnitState(m5,UNIT_STATE_LIFE)-2
        endif
        if KW7(m5)then
            set YM7=0
        endif
        call B67(p5,m5,3,YM7)
        call LINGXIA(p5,m5)
    endif
    call UnitRemoveAbility(p5,skill)
    set N5E=N5E-1
    call SaveInteger(MSK,(OB7),(30),(N5E))
    set skill=(LoadInteger(MSK,(OB7),(N5E)))
    if SuijiMode_EnsureExactLiveAbilityLevel(p5,skill,V77,true) then
    call Multiple_Skill_SyncButton(p5,skill)
    call Reset_Skill_range(p5)
    endif
    call DGBD(p5,m5)
else
    call X377(GetOwningPlayer(p5),"无可用次数")
endif
if N5E==0 then
    set WF8=(LoadReal(MSK,(OB7),(50)))
    if WF8>0 then
        call Multiple_Skill_StartZeroCooldown(p5,skill,WF8)
        call TimerStart(N84[GetPlayerId(GetOwningPlayer(p5))],WF8,false,null)
    endif
endif
set p5=null
set m5=null
set t=null
endfunction
