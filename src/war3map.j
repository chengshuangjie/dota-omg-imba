endif
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId=='A2MB' then
call KillUnit(BB7)
call KillUnit(BB72)
call OZ7(t)
call FlushChildHashtable(L7,(I97))
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH or m5==null or XH7(m5)then
call KillUnit(BB7)
call KillUnit(BB72)
call OZ7(t)
call FlushChildHashtable(L7,(I97))
set t=null
set BB7=null
set BB72=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
else
set WF8=WF8+1
call NP7(I97,"Count",WF8)
endif
if V77==1 then
set DGE=180
elseif V77==2 then
set DGE=150
