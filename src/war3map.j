call KillUnit(BB7A)
endif
set t=null
set p5=null
set BB7=null
set BB7A=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call GIE(OB7)
call NM7(OB7)
call OZ7(t)
call KillUnit(BB7)
call KillUnit(BB7A)
else
if V77==1 then
set GUE=.7
elseif V77==2 then
set GUE=.6
else
set GUE=.5
endif
set GUE=GUE/.05
if ModuloInteger(U38,R2I(GUE))==0 or U38==1 then
set OB7_TMP=OB7
call GSE(p5,BB7,BB7A,V77,b)
endif
call SetUnitX(BB7,GetUnitX(p5))
call SetUnitY(BB7,GetUnitY(p5))
	if BB7A!=null then
		call SetUnitX(BB7A,GetUnitX(p5))
