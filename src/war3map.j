local trigger t
if(OO7(GetHandleId(b1060GetTriggerUnit),"HasMorphling")==false)then
set t=CreateTrigger()
call NT7(GetHandleId(t),"Morphling",b1060GetTriggerUnit)
call NV7(GetHandleId(b1060GetTriggerUnit),"ColorTrigger",t)
