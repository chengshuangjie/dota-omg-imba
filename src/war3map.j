call NR7(OB7,"OrderType","Target")
call N37(OB7,"OrderTarget",GetOrderTarget())
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER then
if uv or KF7(GetUnitX(WI7),GetUnitY(WI7),b1060GetOrderPointX,b1060GetOrderPointY)>800 then
call NR7(OB7,"OrderType","Point")
call NQ7(OB7,"OrderPointX",b1060GetOrderPointX)
call NQ7(OB7,"OrderPointY",b1060GetOrderPointY)
else
call NS7(OB7,"Idle",true)
endif
else
call NR7(OB7,"OrderType","Instant")
endif
