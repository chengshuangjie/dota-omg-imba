//大招面板显示
function iev takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local real XB4=0
local real Xn5
local integer id=B287_GetSpellAbilityId()
local real d=ReduceUnitAbilityCoolDownReal(WI7)
local integer I97=GetHandleId(WI7)
local integer level=B287_GetUnitAbilityLevel(WI7,id)
if IsUnitType(WI7,UNIT_TYPE_HERO)and LoadBoolean(ZCC,-id,1)then
set Xn5=LoadReal(ZCC,-id,level)
if Xn5==0 then
if LoadBoolean(ZCC,-id,0)then
set Xn5=LoadReal(ZCC,-id,1)
endif
endif
set Xn5=SuijiMode_GetEffectiveCooldownBase(WI7,id,level,Xn5)
if Xn5>0 then
if ivv(GetUnitTypeId(WI7),id)==false then
if HaveSavedHandle(ZCC,I97,id)then
set XB4=LoadReal(L7,GetHandleId(LoadTriggerHandle(ZCC,I97,id)),1)
else
set XB4=Xn5
if d>0 then
set XB4=Xn5*d
endif
endif
call TimerStart(N84[GetPlayerId(GetOwningPlayer(WI7))],XB4,false,null)
endif
endif
endif
if id=='A02W' then
call TimerStart(N84[GetPlayerId(GetOwningPlayer(WI7))],0,false,null)
endif
set WI7=null
endfunction
function ixv takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function iev))
set t=null
set i=0
loop
exitwhen(i>$D)
set N84[i]=CreateTimer()
set i=i+1
endloop
set NCC=InitHashtable()
endfunction
