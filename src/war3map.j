// B834: a failed Blink replacement owns one existing item, never a second
// copy. Retry for at most two seconds; another unit's pickup ends ownership.
function B834BlinkReturnTick takes nothing returns nothing
local timer b834Timer=GetExpiredTimer()
local integer b834Key=GetHandleId(b834Timer)
local unit b834Hero=LoadUnitHandle(L7,b834Key,2)
local item b834Item=LoadItemHandle(L7,b834Key,3)
local integer b834Tries=LoadInteger(L7,b834Key,4)+1
if b834Hero!=null and GetUnitTypeId(b834Hero)!=0 and b834Item!=null and GetItemTypeId(b834Item)!=0 and IsItemOwned(b834Item)==false then
call SetItemPosition(b834Item,GetUnitX(b834Hero),GetUnitY(b834Hero))
if UnitAlive(b834Hero) and OO7(GetHandleId(b834Hero),"B834ReincarnationPending")==false then
call UnitAddItem(b834Hero,b834Item)
endif
if IsItemOwned(b834Item)==false and b834Tries<20 then
call SaveInteger(L7,b834Key,4,b834Tries)
set b834Hero=null
set b834Item=null
set b834Timer=null
return
endif
endif
call FlushChildHashtable(L7,b834Key)
call PauseTimer(b834Timer)
call DestroyTimer(b834Timer)
set b834Hero=null
set b834Item=null
set b834Timer=null
endfunction
function AY8 takes unit WI7,integer n5,integer AZ8 returns item
local real x=AV8(WI7)
local real y=AX8(WI7)
local item QU8=CreateItem(n5,x,y)
local integer i=0
local boolean array AA8
local item Z4
local timer b834Return=null
local boolean b834Blink=n5==ZU[RW] or n5==ZU[TW] or n5==ZU[it_sg] or n5==ZU[it_sgban] or n5==ZU[it_xjsg] or n5==ZU[it_xjsgban] or n5==ZU[it_sssg] or n5==ZU[it_sssgban]
if b834Blink and WI7!=null and GetUnitTypeId(WI7)!=0 then
call SetItemPosition(QU8,GetUnitX(WI7),GetUnitY(WI7))
// B1041: pickup listeners must see the replacement's owner immediately.
call SetItemPlayer(QU8,IR4,false)
endif
set GF7=IR4
call DisableTrigger(H94)
if n5>0 then
loop
exitwhen i>(UnitInventorySize(WI7)-1)
if UnitItemInSlot(WI7,i)==null and i!=AZ8 then
set Z4=CreateItem('I02M',x,y)
call UnitAddItem(WI7,Z4)
set AA8[i]=true
else
set AA8[i]=false
endif
if i==AZ8 then
call EnableTrigger(H94)
call UnitAddItem(WI7,QU8)
call DisableTrigger(H94)
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>5
if AA8[i] then
call RemoveItem(UnitItemInSlot(WI7,i))
endif
set i=i+1
endloop
endif
call EnableTrigger(H94)
if b834Blink and WI7!=null and GetUnitTypeId(WI7)!=0 and IsItemOwned(QU8)==false then
set b834Return=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b834Return),2,WI7)
call SaveItemHandle(L7,GetHandleId(b834Return),3,QU8)
call TimerStart(b834Return,.10,true,function B834BlinkReturnTick)
endif
set HA4=QU8
set QU8=null
set Z4=null
set b834Return=null
return HA4
endfunction
