	if(IsMagicImmuneUnit((b1060GetFilterUnit))== false and IsUnitEnemy(IN4, GetOwningPlayer((b1060GetFilterUnit))) and(IsAliveNotStrucNotWard((b1060GetFilterUnit))))!= null then
		call B67(IN4, (b1060GetFilterUnit), 1, IJ4)
