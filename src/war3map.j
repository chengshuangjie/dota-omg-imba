endfunction
function L4 takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-Wz
local real dy=GetDestructableY(GetFilterDestructable())-Yz
return(dx*dx+dy*dy<=bj_enumDestructableRadius)
endfunction
