    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品11 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 11)))
    //祭品77 天鹰119 王者之戒英雄88
    //头颅111  战鼓无次数189
    //散魂剑117 2级散失无次数110
    //撒旦55  支配信使版112
    //打野爪71 近战补刀斧62
    //穷鬼盾89 远程圆盾43
    //冰眼57 远程毒球70
    //大晕102 晕锤远程104
    //先锋盾64 远程圆盾43
    //秘奥跳109 小跳22 禁用小跳23
    //盛势闪光128 小跳22 禁用小跳23
    //迅疾闪光130 小跳22 禁用小跳23
    //call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000XRO |r"+I2S(XRO))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品0 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 0)))
