function FYD_TS takes nothing returns nothing
	local unit ZX7 = null
	local unit IH7 = W22
    local unit u=null
	local integer h=0
	local integer level=0
    local integer times
    local group g=null
    local group g2=null
    local boolexpr spiritLanceBounceFilter=null
    local unit BB7=null
    local trigger missileTrigger=GetTriggeringTrigger()
    local trigger nextMissile=null
    local timer chainTimer=LoadTimerHandle(TABLE_HY,GetHandleId(missileTrigger),StringHash("B582BounceChain"))
    if chainTimer==null then
        set IH7=null
        set missileTrigger=null
        return
    endif
    set h=GetHandleId(chainTimer)
    set ZX7=LoadUnitHandle(TABLE_P,h,0)
    set g=LoadGroupHandle(TABLE_P,h,1)
    if ZX7==null or GetUnitTypeId(ZX7)==0 or IH7==null or GetUnitTypeId(IH7)==0 or g==null then
        call B582_DestroyBounceChain(chainTimer)
        set ZX7=null
        set IH7=null
        set g=null
        set missileTrigger=null
        set chainTimer=null
        return
    endif
    set level=LoadInteger(TABLE_P,h,2)
    set times=LoadInteger(TABLE_P,h,3)
    call GroupAddUnit(g, IH7)
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A10C')
call SetUnitAbilityLevel(BB7,'A10C',level)
    call B947IssueTargetOrderById("FYD_TS @ war3map.j:81550 (B968)",BB7,$D00DD,IH7)
    call CommonUnitAddStun(IH7,1.,false)
    call B67(ZX7,IH7,1,25+75*level)
    call FTD(GetOwningPlayer(ZX7),IH7,level)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",IH7,"origin"))
    if times==3 then
        call LINGXIA(ZX7,IH7)
    endif
    if times>0 then
        set g2 = WS7()
        set U22=ZX7
        set spiritLanceBounceFilter=Condition(function DKX)
        call GroupEnumUnitsInRange(g2, GetUnitX(IH7), GetUnitY(IH7), 400, spiritLanceBounceFilter)
        call DestroyBoolExpr(spiritLanceBounceFilter)
        call GroupRemoveGroup(g, g2)
        set u=GroupPickRandomUnit(g2)
        if u!= null and WQ7(u)==false then
            set nextMissile=NHX_TANSHE(ZX7,IH7,u,'h06L',"FYD_TS",1000,true,"")
            call SaveTimerHandle(TABLE_HY,GetHandleId(nextMissile),StringHash("B582BounceChain"),chainTimer)
            call SaveInteger(TABLE_P,h,3,times-1)
        else
            call B582_DestroyBounceChain(chainTimer)
        endif
        call WR7(g2)
        set g2 = null
    else
        call B582_DestroyBounceChain(chainTimer)
    endif
    set g=null
    set BB7=null
    set spiritLanceBounceFilter=null
	set ZX7 = null
	set IH7 = null
    set missileTrigger=null
    set nextMissile=null
    set chainTimer=null
endfunction
function FYD takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A10C')
call SetUnitAbilityLevel(BB7,'A10C',level)
    call B947IssueTargetOrderById("FYD @ war3map.j:81595 (B968)",BB7,$D00DD,IH7)
    call CommonUnitAddStun(IH7,1.,false)
    call B67(ZX7,IH7,1,25+75*level)
    call FTD(GetOwningPlayer(ZX7),IH7,level)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",IH7,"origin"))
    call LINGXIA(ZX7,IH7)
    set BB7=null
	set ZX7 = null
	set IH7 = null
endfunction
function FZD takes unit ZX7,unit IH7,integer BC7 returns nothing
	local trigger t=null
    local timer chainTimer=null
    local integer chainHandle=0
    if IsUnitIllusion(ZX7) then
        call NHX(ZX7, IH7,'h06L', "",1000, true,"")
    else
        if PhantomLancerSpiritLance_HasScepter(ZX7) then
            set chainTimer=CreateTimer()
            set chainHandle=GetHandleId(chainTimer)
            call SaveUnitHandle(TABLE_P,chainHandle,0,ZX7)
            call SaveGroupHandle(TABLE_P,chainHandle,1,WS7())
            call SaveInteger(TABLE_P,chainHandle,2,BC7)
            // IMBA: bounce count x2 cap 8.
            call SaveInteger(TABLE_P,chainHandle,3,IMinBJ(3*imbaMult,8))
            call TimerStart(chainTimer,15.,false,function B582_BounceChainTimeout)
            set t=NHX(ZX7, IH7,'h06L', "FYD_TS",1000, true,"")
            call SaveTimerHandle(TABLE_HY,GetHandleId(t),StringHash("B582BounceChain"),chainTimer)
        else
            set t=NHX(ZX7, IH7,'h06L', "FYD",1000, true,"")
            call SaveInteger(TABLE_HY, GetHandleId(t), 10, BC7)
        endif
    endif
	set t = null
