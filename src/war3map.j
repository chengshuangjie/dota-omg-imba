function Sn takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
// The unified passive-orb controller owns Impetus in random OMG mode.
// Keeping this legacy per-attack listener active creates overlapping 3-second
// damage triggers; several canceled or fast attacks can then all consume the
// same later hit and multiply one Impetus into extreme damage.
if SUIJI_UNIFIED_ORB_PASSIVE then
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED then
if X_9(GetAttacker())>0 and(OO7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn")or(GZ[304+GetPlayerId(GetOwningPlayer(GetAttacker()))]))and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetAttacker()==O77(GetHandleId(b1060GetTriggeringTrigger),"Hero")then
call Y89()
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER then
if(b1060GetIssuedOrderId==$D011F)then
call NS7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn",true)
elseif(b1060GetIssuedOrderId==$D0120)then
call NS7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn",false)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and (b1060B287_GetSpellAbilityId=='A0DY' or b1060B287_GetSpellAbilityId=='A1WB') then
call Y89()
endif
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function Y99 takes unit WI7,boolean UA9 returns nothing
