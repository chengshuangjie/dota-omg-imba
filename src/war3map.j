function SuijiMode_FlakSideGunnerTargetFilter takes nothing returns boolean
local unit target=GetFilterUnit()
local unit source=SUIJI_FLAK_SIDE_GUNNER_SOURCE
local boolean valid=false
if source!=null and target!=null and GetUnitTypeId(target)!=0 then
set valid=UnitAlive(target) and IsHideUnit(target)==false and GetUnitAbilityLevel(target,'Aloc')==0 and GetUnitAbilityLevel(target,'A04R')==0 and AE7(target)==false and ISWUDI(target)==false and IsUnitEnemy(target,GetOwningPlayer(source)) and IsUnitVisible(target,GetOwningPlayer(source)) and KE7(source,target)<=600.
endif
set target=null
set source=null
return valid
endfunction
function SuijiMode_FlakSideGunnerProjectileHit takes nothing returns nothing
local trigger missile=GetTriggeringTrigger()
local integer missileHandle=GetHandleId(missile)
local unit source=LoadUnitHandle(TABLE_HY,missileHandle,43)
local unit target=W22
local integer h=0
if source!=null and target!=null and GetUnitTypeId(source)!=0 and GetUnitTypeId(target)!=0 then
set h=GetHandleId(source)
call NS7(h,"SuijiFlakSideGunnerAttacking",true)
set WXX=source
set YXX=target
set PVV=false
set EOO=h
call SaveBoolean(TABLE_HY,h,10,IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source))
call SaveBoolean(TABLE_HY,h,11,IsUnitType(target,UNIT_TYPE_STRUCTURE))
call SaveBoolean(TABLE_HY,h,14,GetUnitAbilityLevel(target,'A04R')==0)
call SaveBoolean(TABLE_HY,h,15,IsUnitEnemy(source,GetOwningPlayer(target)))
call ExecuteAttackEvent(0)
call ExecuteAttackEvent(1)
if LoadBoolean(TABLE_HY,h,11)==false and LoadBoolean(TABLE_HY,h,14) then
call ExecuteAttackEvent(2)
if LoadBoolean(TABLE_HY,h,15) then
call ExecuteAttackEvent(3)
if IsMagicImmuneUnit(target)==false then
call ExecuteAttackEvent(4)
endif
endif
endif
set ZX7_tmp=source
set IH7_tmp=target
call ExecuteFunc("Func_MNGJ")
set ZX7_tmp=null
set IH7_tmp=null
call NS7(h,"SuijiFlakSideGunnerAttacking",false)
endif
set missile=null
set source=null
set target=null
endfunction
function SuijiMode_FlakSideGunnerAttackTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit source=LoadUnitHandle(L7,th,0)
local unit target=null
local group g=null
local boolexpr filter=null
local trigger missile=null
if source==null or GetUnitTypeId(source)==0 then
if source!=null then
call SuijiMode_FlakSideGunnerDestroyAttackTimer(source)
call SuijiMode_FlakSideGunnerDestroyReviveTimer(source)
call SuijiMode_FlakSideGunnerDestroyLifecycle(source)
endif
set t=null
set source=null
return
endif
if SuijiMode_FlakSideGunnerEligible(source)==false then
call SuijiMode_FlakSideGunnerDestroyAttackTimer(source)
call SuijiMode_FlakSideGunnerDestroyReviveTimer(source)
call SuijiMode_FlakSideGunnerDestroyLifecycle(source)
call SuijiMode_FlakSideGunnerRemoveCompanion(source)
set t=null
set source=null
return
endif
if UnitAlive(source)==false then
call SuijiMode_FlakSideGunnerDestroyAttackTimer(source)
set t=null
set source=null
return
endif
if AK7(source) or IsHideUnit(source) then
set t=null
set source=null
return
endif
set g=WS7()
set filter=Condition(function SuijiMode_FlakSideGunnerTargetFilter)
set SUIJI_FLAK_SIDE_GUNNER_SOURCE=source
call GroupEnumUnitsInRange(g,GetUnitX(source),GetUnitY(source),600.,filter)
set SUIJI_FLAK_SIDE_GUNNER_SOURCE=null
call DestroyBoolExpr(filter)
set filter=null
set target=GroupPickRandomUnit(g)
call WR7(g)
set g=null
if target!=null and UnitAlive(target) and GetUnitTypeId(target)!=0 and IsHideUnit(target)==false and GetUnitAbilityLevel(target,'A04R')==0 and AE7(target)==false and ISWUDI(target)==false and IsUnitEnemy(target,GetOwningPlayer(source)) and IsUnitVisible(target,GetOwningPlayer(source)) and KE7(source,target)<=600. then
set missile=NHX(source,target,'h0HH',"SuijiMode_FlakSideGunnerProjectileHit",3000.,false,"Abilities\\Weapons\\Rifle\\RifleImpact.mdl")
endif
set t=null
set source=null
set target=null
set missile=null
endfunction
function SuijiMode_FlakSideGunnerStartAttackTimer takes unit u returns nothing
local integer h=0
local timer t=null
if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false or SuijiMode_FlakSideGunnerEligible(u)==false then
return
endif
set h=GetHandleId(u)
if LoadTimerHandle(L7,h,StringHash("SuijiFlakSideGunnerAttackTimer"))!=null then
return
endif
set t=CreateTimer()
call SaveTimerHandle(L7,h,StringHash("SuijiFlakSideGunnerAttackTimer"),t)
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call TimerStart(t,1.3,true,function SuijiMode_FlakSideGunnerAttackTick)
set t=null
endfunction
function SuijiMode_FlakSideGunnerReviveTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(L7,GetHandleId(t),0)
if u==null or GetUnitTypeId(u)==0 then
if u!=null then
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerDestroyLifecycle(u)
endif
set t=null
set u=null
return
endif
if SuijiMode_FlakSideGunnerEligible(u)==false then
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerDestroyLifecycle(u)
call SuijiMode_FlakSideGunnerRemoveCompanion(u)
elseif UnitAlive(u) then
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerStartAttackTimer(u)
endif
set t=null
set u=null
endfunction
function SuijiMode_FlakSideGunnerStartReviveTimer takes unit u returns nothing
local integer h=0
local timer t=null
if u==null or GetUnitTypeId(u)==0 or SuijiMode_FlakSideGunnerEligible(u)==false then
return
endif
set h=GetHandleId(u)
if LoadTimerHandle(L7,h,StringHash("SuijiFlakSideGunnerReviveTimer"))!=null then
return
endif
set t=CreateTimer()
call SaveTimerHandle(L7,h,StringHash("SuijiFlakSideGunnerReviveTimer"),t)
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call TimerStart(t,.5,true,function SuijiMode_FlakSideGunnerReviveTick)
set t=null
endfunction
function SuijiMode_FlakSideGunnerLifecycleEvent takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local unit u=GetTriggerUnit()
if u==null or GetUnitTypeId(u)==0 or SuijiMode_FlakSideGunnerEligible(u)==false then
if u!=null then
call SuijiMode_FlakSideGunnerDestroyAttackTimer(u)
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerDestroyLifecycle(u)
call SuijiMode_FlakSideGunnerRemoveCompanion(u)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call SuijiMode_FlakSideGunnerDestroyAttackTimer(u)
call SuijiMode_FlakSideGunnerStartReviveTimer(u)
elseif b1060GetTriggerEventId==EVENT_UNIT_HERO_REVIVE_FINISH then
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerStartAttackTimer(u)
endif
set u=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SuijiMode_FlakSideGunnerStartLifecycle takes unit u returns nothing
local integer h=0
local trigger t=null
if u==null or GetUnitTypeId(u)==0 or SuijiMode_FlakSideGunnerEligible(u)==false then
return
endif
set h=GetHandleId(u)
if LoadTriggerHandle(L7,h,StringHash("SuijiFlakSideGunnerLifecycle"))!=null then
return
endif
set t=CreateTrigger()
call SaveTriggerHandle(L7,h,StringHash("SuijiFlakSideGunnerLifecycle"),t)
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_HERO_REVIVE_FINISH)
call TriggerAddCondition(t,Condition(function SuijiMode_FlakSideGunnerLifecycleEvent))
set t=null
endfunction
function SuijiMode_FlakSideGunnerReconcile takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
if SuijiMode_FlakSideGunnerEligible(u) then
if GetUnitAbilityLevel(u,'ZSG1')==0 then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'ZSG1',1,true)
endif
call SuijiMode_FlakSideGunnerStartLifecycle(u)
if UnitAlive(u) then
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerStartAttackTimer(u)
else
call SuijiMode_FlakSideGunnerDestroyAttackTimer(u)
call SuijiMode_FlakSideGunnerStartReviveTimer(u)
endif
else
call SuijiMode_FlakSideGunnerDestroyAttackTimer(u)
call SuijiMode_FlakSideGunnerDestroyReviveTimer(u)
call SuijiMode_FlakSideGunnerDestroyLifecycle(u)
call SuijiMode_FlakSideGunnerRemoveCompanion(u)
endif
endfunction
function SuijiMode_RazorScepterRefresh takes unit u,boolean active returns boolean
return SuijiMode_ScepterRegistryRefresh(u,'A1AO','A1UV',active,"（双目标、可攻击建筑）")
endfunction
function SuijiMode_RazorScepterIsActive takes unit u returns boolean
return SuijiMode_ScepterRegistryIsActive(u,'A1AO')
endfunction
function SuijiMode_LunaScepterIsActive takes unit u returns boolean
return SuijiMode_ScepterRegistryIsActive(u,'A054')
endfunction
// Teleport's Cast definition and the live engine cast point are separate owners.
// Only apply at an audited transition; the delayed pass rechecks the current source.
function B1045TeleportApply takes unit furionUnit1045,integer furionExpected1045 returns nothing
local integer furionPhysical1045=0
local ability furionAbility1045=null
local real furionCast1045=3.
local integer furionLevel1045=1
if furionUnit1045==null or GetUnitTypeId(furionUnit1045)==0 or IsUnitIllusion(furionUnit1045) then
return
endif
set furionPhysical1045=B287_GetPhysicalAbilityId(furionUnit1045,'A01O')
if furionPhysical1045!=furionExpected1045 or (furionPhysical1045!='A01O' and furionPhysical1045!='Y00M') or GetUnitAbilityLevel(furionUnit1045,furionPhysical1045)<=0 then
return
endif
set furionAbility1045=MHAbility_GetAbility(furionUnit1045,furionPhysical1045)
if furionAbility1045==null then
return
endif
if MHAbility_GetId(furionAbility1045)!=furionPhysical1045 then
set furionAbility1045=null
return
endif
if SuijiMode_ScepterRegistryIsActive(furionUnit1045,'A01O') then
set furionCast1045=1.
endif
loop
exitwhen furionLevel1045>4
call YDWESetUnitAbilityDataReal(furionUnit1045,furionPhysical1045,furionLevel1045,ABILITY_DATA_CAST,furionCast1045)
set furionLevel1045=furionLevel1045+1
endloop
if SuijiMode_ScepterRegistryIsActive(furionUnit1045,'A01O') then
// B1050: the ability countdown owns the one-second wait; do not add a unit cast point.
call MHAbility_SetCastpoint(furionUnit1045,furionPhysical1045,0.)
else
call MHAbility_SetCastpoint(furionUnit1045,furionPhysical1045,furionCast1045)
endif
set furionAbility1045=null
endfunction
function B1045TeleportDelayed takes nothing returns nothing
local timer furionTimer1045=GetExpiredTimer()
local integer furionTimerKey1045=GetHandleId(furionTimer1045)
local unit furionSource1045=LoadUnitHandle(L7,furionTimerKey1045,0)
call B1045TeleportApply(furionSource1045,LoadInteger(L7,furionTimerKey1045,1))
call FlushChildHashtable(L7,furionTimerKey1045)
call PauseTimer(furionTimer1045)
call DestroyTimer(furionTimer1045)
set furionSource1045=null
set furionTimer1045=null
endfunction
function B1045TeleportSchedule takes unit furionSource1045 returns nothing
local integer furionPhysical1045=0
local timer furionTimer1045=null
if furionSource1045==null or GetUnitTypeId(furionSource1045)==0 or IsUnitIllusion(furionSource1045) then
return
endif
set furionPhysical1045=B287_GetPhysicalAbilityId(furionSource1045,'A01O')
if (furionPhysical1045!='A01O' and furionPhysical1045!='Y00M') or GetUnitAbilityLevel(furionSource1045,furionPhysical1045)<=0 then
return
endif
call B1045TeleportApply(furionSource1045,furionPhysical1045)
set furionTimer1045=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(furionTimer1045),0,furionSource1045)
call SaveInteger(L7,GetHandleId(furionTimer1045),1,furionPhysical1045)
call TimerStart(furionTimer1045,.05,false,function B1045TeleportDelayed)
set furionTimer1045=null
endfunction
function SuijiMode_ScepterRegistryRefreshBatch takes unit u,boolean active returns boolean
local boolean changed=false
call B1099EarthSetScepter(u,active)
if SuijiMode_ScepterRegistryRefresh(u,'A0SB',0,active,"（每次成功施放，对攻击距离内可攻击的敌人发动一次继承装备与法球的攻击）") then
set changed=true
endif
if SuijiMode_ScepterRegistryRefresh(u,'A0CA',0,active,"（缩地伤害留下4.6秒标记；退出0.2秒后攻击1200范围内标记目标，继承装备与法球，无需另学连击）") then
set changed=true
endif
if SuijiMode_ScepterRegistryRefresh(u,'A01O',0,active,"（传送冷却时间为0，施法时间为1秒；吞噬神杖同样生效）") then
call SuijiMode_ApplyRegisteredCooldown4(u,'A01O',active,50.,40.,30.,20.,0.,0.,0.,0.)
call SuijiMode_ApplyRegisteredRealField4(u,'A01O',active,ABILITY_DATA_CAST,3.,3.,3.,3.,1.,1.,1.,1.)
call B1045TeleportSchedule(u)
set changed=true
endif
if MiaoStarted and LoadBoolean(MiaoTable,GetHandleId(u),100) then
if SuijiMode_ScepterRegistryRefresh(u,'AMdQ',0,active,"（二连桔梗：命中后概率刷新并恢复15%最大魔法；连刷每次增伤25%，累计100%转真实伤害）") then
