function U39 takes nothing returns boolean
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
local integer V77=0
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(p5) or not B1023HitLive(m5)) then
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==p5 then
call NM7(OB7)
call OZ7(t)
set V77=B287_GetUnitAbilityLevel(p5,'A07A')
if OT7(p5,"WindWalk|CD")==false then
call O37(p5,"WindWalk|CD",.5)
if IsUnitType(m5,UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(m5,GetOwningPlayer(p5))then
call B67(p5,m5,2,30*V77)
call YW7(I2S(R2I(30*V77)),1,p5,.027,$D8,0,0,$D8)
call OX7(p5,"WindWalkBH|Active")
set t=OE7(GetHandleId(p5),"ai|WWTrigger")
call NM7(GetHandleId(t))
call OZ7(t)
endif
endif
endif
else
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function U69 takes nothing returns boolean
local trigger t=null
local unit m5=null
local unit p5=null
local integer OB7
local integer V77
if not B1023HitLive(GetAttacker()) or not B1023HitLive(GetTriggerUnit()) then
set t=null
set m5=null
set p5=null
return false
endif
if OT7(GetAttacker(),"WindWalkBH|Active")then
set t=CreateTrigger()
set m5=GetTriggerUnit()
set p5=GetAttacker()
set OB7=GetHandleId(t)
call B1023RegisterDamage(t,m5)
call TriggerRegisterTimerEvent(t,2.,false)
call TriggerAddCondition(t,Condition(function U39))
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
if OO7(GetHandleId(p5),"JinadaActive")then
set V77=B287_GetUnitAbilityLevel(p5,'A1IQ')
if V77==0 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==1 then
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==2 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==3 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==4 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
endif
else
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
endif
set m5=null
set p5=null
set t=null
endif
return false
endfunction
