local unit suijiAstralCaster=GetTriggerUnit()
local unit suijiAstralTarget=GetSpellTargetUnit()
if suijiAstralCaster==null or suijiAstralTarget==null or GetUnitTypeId(suijiAstralCaster)==0 or GetUnitTypeId(suijiAstralTarget)==0 then
set suijiAstralCaster=null
set suijiAstralTarget=null
return
endif
if IsUnitAlly(suijiAstralTarget,GetOwningPlayer(suijiAstralCaster))and OO7(GetHandleId(GetOwningPlayer(suijiAstralTarget)),"DisableHelp")and suijiAstralTarget!=suijiAstralCaster then
call KR7(suijiAstralCaster)
call X37(GetOwningPlayer(suijiAstralCaster),GetObjectName('n038'))
elseif GetUnitTypeId(suijiAstralTarget)=='n00L' then
call KR7(suijiAstralCaster)
call X37(GetOwningPlayer(suijiAstralCaster),GetObjectName('n0K9'))
