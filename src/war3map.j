function AddDoubleClickSkillID takes integer iSkillId returns nothing
    // Eligibility belongs to the logical skill family, not to one object's
    // static hotkey.  Native, fixed-clone and charge-state buttons may receive
    // their real hotkey only after the hero's command card is built.
    call SaveBoolean(LocalHashTable,iSkillId,KEY_USE_DOUBLECLICK_SPELL,true)
endfunction
