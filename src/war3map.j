function EUD takes unit ZX7 returns integer
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A088')
local boolean HaveA=false
local integer r=0
// IMBA: multicast prob x2 cap100, casts r x2 cap6 (imbaMult gates).
local integer id=GetPlayerId(GetOwningPlayer(ZX7))
if ZX7==ChaosObserverBoss and GetUnitTypeId(ZX7)=='NB0S' and GetUnitAbilityLevel(ZX7,'A9BM')>0 then
    set V77=GetUnitAbilityLevel(ZX7,'A9BM')
    set HaveA=true
elseif ZX7==TianxingRedBoss and GetUnitTypeId(ZX7)=='NTY1' and GetUnitAbilityLevel(ZX7,'TRMC')>0 then
    set V77=GetUnitAbilityLevel(ZX7,'TRMC')
    set HaveA=true
endif
if ISLABIKE(ZX7) then
    if GetUnitLevel(ZX7)>=16 then
        set V77=3
    elseif GetUnitLevel(ZX7)>=11 then
        set V77=2
    elseif GetUnitLevel(ZX7)>=6 then
        set V77=1
    endif
endif
if ZX7==ChaosObserverBoss and GetUnitTypeId(ZX7)=='NB0S' and GetUnitAbilityLevel(ZX7,'A9BM')>0 then
set HaveA=true
elseif ZX7==TianxingRedBoss and GetUnitTypeId(ZX7)=='NTY1' and GetUnitAbilityLevel(ZX7,'TRMC')>0 then
set HaveA=true
elseif SuijiMode_ScepterRegistryIsActive(ZX7,'A088') then
set HaveA=true
else
set HaveA=false
endif
if V77==1 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,IMinBJ(5*imbaMult,100)) then
            set r=IMinBJ(5*imbaMult,6)
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,IMinBJ(50*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+2,IMinBJ(40*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
    endif
elseif V77==2 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,IMinBJ(5*imbaMult,100)) then
            set r=IMinBJ(5*imbaMult,6)
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,IMinBJ(30*imbaMult,100)) then
            set r=IMinBJ(3*imbaMult,6)
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,IMinBJ(60*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+3,IMinBJ(25*imbaMult,100)) then
            set r=IMinBJ(3*imbaMult,6)
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,IMinBJ(50*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
        endif
elseif V77==3 then
    set TI4[id]=TI4[id]+1
    if HaveA then
        if GetPrdRandom(ZX7,'A088'+5,IMinBJ(5*imbaMult,100)) then
            set r=IMinBJ(5*imbaMult,6)
            set N4[id]=N4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+4,IMinBJ(20*imbaMult,100)) then
            set r=IMinBJ(4*imbaMult,6)
            set TH4[id]=TH4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,IMinBJ(40*imbaMult,100)) then
            set r=IMinBJ(3*imbaMult,6)
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,IMinBJ(80*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
    else
        if GetPrdRandom(ZX7,'A088'+4,IMinBJ(15*imbaMult,100)) then
            set r=IMinBJ(4*imbaMult,6)
            set TH4[id]=TH4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+3,IMinBJ(30*imbaMult,100)) then
            set r=IMinBJ(3*imbaMult,6)
            set TG4[id]=TG4[id]+1
        elseif GetPrdRandom(ZX7,'A088'+2,IMinBJ(60*imbaMult,100)) then
            set r=IMinBJ(2*imbaMult,6)
            set TF4[id]=TF4[id]+1
        endif
    endif
endif
return r
endfunction
function EYD takes nothing returns boolean
local unit m5=GetFilterUnit()
local unit WI7=GetTriggerUnit()
if IsUnitAlly(m5,GetOwningPlayer(WI7)) and GetUnitState(m5,UNIT_STATE_LIFE)>0 and GetUnitAbilityLevel(m5,'Bblo')==0 then
if(GetOwningPlayer(m5)==Z7[0]or GetOwningPlayer(m5)==A7[0])then
if GetUnitTypeId(m5)=='ugho' or GetUnitTypeId(m5)=='u001' or GetUnitTypeId(m5)=='unec' or GetUnitTypeId(m5)=='u002' then
set m5=null
set WI7=null
return true
endif
if GetUnitTypeId(m5)=='esen' or GetUnitTypeId(m5)=='e00V' or GetUnitTypeId(m5)=='edry' or GetUnitTypeId(m5)=='e00W' then
set m5=null
set WI7=null
return true
endif
return false
elseif IsUnitType(m5,UNIT_TYPE_HERO) then
set m5=null
set WI7=null
return true
elseif GetOwningPlayer(m5)==GetOwningPlayer(WI7) and KW7(m5)==false then
set m5=null
set WI7=null
return true
endif
endif
set m5=null
set WI7=null
return false
endfunction
function EZD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
local integer skillbuff
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
local real duration=30.*SuijiMode_GetDurationMulticastCount(ZX7,skill)
if level==1 then
    set skillbuff='A4I6'
elseif level==2 then
    set skillbuff='A4I7'
elseif level==3 then
    set skillbuff='A4I8'
elseif level==4 then
    set skillbuff='A4I9'
endif
call ADD_SX_BUFF(IH7,skillbuff,duration)
set ZX7=null
set IH7=null
endfunction
