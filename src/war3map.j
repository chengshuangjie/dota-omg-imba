call TriggerAddCondition(t,Condition(function XXGL))
set t=null
endfunction
function YLG2 takes unit u,integer d returns nothing
local integer array b
local integer a=d
local integer c=1
local integer i=0
local integer UDD
if d<1 then
call UnitRemoveAbility(u,D17[0])
call UnitRemoveAbility(u,D17[1])
call UnitRemoveAbility(u,D17[2])
call UnitRemoveAbility(u,D17[3])
call UnitRemoveAbility(u,D17[4])
call UnitRemoveAbility(u,D17[5])
call UnitRemoveAbility(u,D17[6])
call UnitRemoveAbility(u,D17[7])
call UnitRemoveAbility(u,D17[8])
call UnitRemoveAbility(u,D17[9])
call UnitRemoveAbility(u,D17[10])
call UnitRemoveAbility(u,D17[11])
return
endif
loop
exitwhen c==0
set c=a/2
set b[i]=a-c*2
set a=c
set i=i+1
endloop
set UDD=11
set i=0
loop
exitwhen i>UDD
if b[i]==1 then
call XF7(u,D17[i])
else
call UnitRemoveAbility(u,D17[i])
endif
set i=i+1
endloop
endfunction
function RHD takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local unit BB7
if AK7((b1060GetEnumUnit))==false then
call UnitRemoveAbility((b1060GetEnumUnit),'B0EY')
call UnitShareVision((b1060GetEnumUnit),GetOwningPlayer(YG4),true)
else
call UnitShareVision((b1060GetEnumUnit),GetOwningPlayer(YG4),true)
if GetUnitAbilityLevel((b1060GetEnumUnit),'B0EY')==0 and GetUnitAbilityLevel((b1060GetEnumUnit),'B00T')==0 and GetUnitAbilityLevel((b1060GetEnumUnit),'B0JN')==0 and GetUnitAbilityLevel((b1060GetEnumUnit),'B00L')==0 then
set BB7=CreateUnit(GetOwningPlayer(YG4),'e00E',GetUnitX((b1060GetEnumUnit)),GetUnitY((b1060GetEnumUnit)),0)
call UnitAddAbility(BB7,'A2AH')
call B947IssueTargetOrderById("RHD @ war3map.j:92693 (B968)",BB7,$D00B5,(b1060GetEnumUnit))
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endif
endif
set b1060GetEnumUnit=null
endfunction
function RID takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real D4D=YH4*0+.3
if XH7(YG4) or IsUnitInGroup((b1060GetEnumUnit),YF4)==false or GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)/GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE)>D4D or(GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)/GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE)>D4D/2 and AK7((b1060GetEnumUnit)))then
call GroupRemoveUnit(YE4,(b1060GetEnumUnit))
call UnitShareVision((b1060GetEnumUnit),GetOwningPlayer(YG4),false)
call UnitRemoveAbility((b1060GetEnumUnit),'B0EY')
endif
set b1060GetEnumUnit=null
endfunction
function RJD takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real D4D
if XH7(YG4)==false and IsUnitInGroup((b1060GetEnumUnit),YE4)==false and IsUnitIllusion((b1060GetEnumUnit))==false then
set D4D=YH4*0+.3
if GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)/GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE)<D4D and AK7((b1060GetEnumUnit))==false then
call GroupAddUnit(YE4,(b1060GetEnumUnit))
elseif GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)/GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE)<D4D/2 then
call GroupAddUnit(YE4,(b1060GetEnumUnit))
endif
endif
set b1060GetEnumUnit=null
endfunction
function RKD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local group RMD=(LoadGroupHandle(L7,(I97),(22)))
local group g=WS7()
local integer BC7=0
local integer number
if ZX7==null or GetUnitTypeId(ZX7)==0 or RMD==null or B287_GetUnitAbilityLevel(ZX7,'A0I8')<=0 then
if ZX7!=null and GetUnitTypeId(ZX7)!=0 then
call YLG2(ZX7,0)
call UnitRemoveAbility(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', 0)
endif
if RMD!=null then
call WR7(RMD)
endif
call WR7(g)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set g=null
set RMD=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A0I8')
set IN4=ZX7
set YG4=ZX7
set YE4=RMD
set YH4=BC7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),25+25000,Condition(function A_7))
call ForGroup(g,function RJD)
set YF4=g
call ForGroup(YE4,function RID)
call ForGroup(YE4,function RHD)
set number=CountUnitsInGroup(YE4)
if FirstOfGroup(YE4)==null then
call YLG2(ZX7,0)
call UnitRemoveAbility(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', 0)
else
call YLG2(ZX7,(10*BC7-5)*number)
call XF7(ZX7,'A214')
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A214', number)
call SaveInteger(TABLE_K, GetHandleId(ZX7),'A215', BC7)
endif
call WR7(g)
set t=null
set ZX7=null
set g=null
set RMD=null
return false
endfunction
function HAI takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer number = 0
	local integer BC7 = 0
	local integer I2X = 0
	if u==null or GetUnitTypeId(u)==0 then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		set t = null
		set u = null
		return false
	endif
	set number = LoadInteger(TABLE_K, GetHandleId(u),'A214')
	set BC7 = LoadInteger(TABLE_K, GetHandleId(u),'A215')
	set I2X =(10* BC7 -5)* number
    if ISPH(u) then
        set I2X=0
    endif
	call SetUnitImitateMoveSpeed(u, I2X, 0)
	set t = null
	set u = null
	return false
endfunction
function RND takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function RKD))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveGroupHandle(L7,(I97),(22),(WS7()))
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t, .1, true)
call TriggerAddCondition(t, Condition(function HAI))
call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, ZX7)
set t=null
set ZX7=null
endfunction
