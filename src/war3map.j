if GetUnitTypeId(GetTriggerUnit())!='H00M' and GetUnitTypeId(GetTriggerUnit())!='H07G' and GetUnitTypeId(GetTriggerUnit())!='H00Y' and GetUnitTypeId(GetTriggerUnit())!='H0B8' and GetUnitTypeId(GetTriggerUnit())!='Z053' and (IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) or AS7(GetTriggerUnit())) and IsUnitIllusion(GetTriggerUnit())==false and OO7(GetHandleId(GetTriggerUnit()),"DamageRegisterAlready")==false then
if O44 and(GetUnitTypeId(GetTriggerUnit())!='O00P' or(GetUnitTypeId(GetTriggerUnit())=='O00P' and O74))then
call T48(GetTriggerUnit())
endif
endif
return false
endfunction
