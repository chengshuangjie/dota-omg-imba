call SuijiMode_StartScriptedFlight(b1060GetTriggerUnit,2,18.*SuijiMode_GetDurationMulticastCount(b1060GetTriggerUnit,'A19Z'))
call KYG()
elseif GetUnitTypeId(b1060GetTriggerUnit)=='O016' then
call KYG()
elseif IsTerrainPathable(GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit),PATHING_TYPE_WALKABILITY)then
call KCG()
endif
endif
else
if B287_GetLearnedSkill()=='A19Z' and B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A19Z')==1 and IsUnitIllusion(b1060GetTriggerUnit)==false then
call KAG()
endif
endif
