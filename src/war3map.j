function SuijiMode_IsSameTransformRestoreFamily takes integer skill,integer activeSkill returns boolean
if skill==activeSkill then
return true
endif
if (skill=='A11T' or skill=='A4AS') and (activeSkill=='A11T' or activeSkill=='A4AS') then
return true
endif
if (skill=='A0MQ' or skill=='A1B6') and (activeSkill=='A0MQ' or activeSkill=='A1B6') then
return true
endif
// B566: native Sven's engine-owned A1WH/X1WH buttons are the two sides of one
// transformation.  Never let the 0.20-second command-card repair loop restore
// the opposite side while ANcr is rebuilding the unit.
if (skill=='A1WH' or skill=='X1WH') and (activeSkill=='A1WH' or activeSkill=='X1WH') then
return true
endif
if (skill=='A2NE' or skill=='A3NE') and (activeSkill=='A2NE' or activeSkill=='A3NE') then
return true
endif
return false
endfunction
function SuijiMode_MulticastForbiddenSkill takes integer skill returns boolean
// The dedicated TP icon has three modes, but all of them cast through A4T0.
// It owns one channel/cooldown/charge lifecycle and must never be repeated.
if skill=='A4T0' then
return true
endif
if skill=='ZBBA' then
return true
endif
if skill=='A088' or skill=='A1NE' or skill=='A2IG' then
return true
endif
// Skill-bar managers and transient secondary buttons must execute exactly
// once. Repeating Spell Steal, Invoke, Telekinesis Land, Snowball, or Release
// Snowball reruns command-card/state controllers.
if skill=='A27H' or skill=='A2TZ' or skill=='A21Y' or skill=='A1GU' or skill=='A27X' or skill=='A1S7' or skill=='A4HF' then
return true
endif
if skill=='A0RV' or skill=='A14I' or skill=='A12P' or skill=='A1D6' or skill=='A229' or skill=='A0KU' then
return true
endif
if skill=='A1TA' or skill=='A1T8' or skill=='A1TB' or skill=='A4G0' then
return true
endif
// Toggle/state buttons own an engine transition rather than a repeatable spell
// effect. Reissuing them through Multicast can immediately undo the intended
// state or leave their helper controller out of sync.
if skill=='A0MP' or skill=='A28Q' then
return true
endif
if skill=='A0DH' or skill=='A1OB' then
return true
endif
if skill=='A1W8' or skill=='A1W9' or skill=='A0O0' or skill=='A1EJ' then
return true
endif
if skill=='A2CI' or skill=='A2SB' or skill=='A2BG' or skill=='A2SA' then
return true
endif
if skill=='A0MU' or skill=='A0A2' then
return true
endif
if skill=='A1T5' or skill=='A235' or skill=='A1U6' or skill=='A2UO' then
return true
endif
if skill=='A0S8' or skill=='A1QP' or skill=='A0QK' or skill=='A21Q' then
return true
endif
if skill=='A1YY' or skill=='A1RK' or skill=='A4IK' then
return true
endif
if SuijiMode_IsTransformMulticastForbiddenSkill(skill) then
return true
endif
if SuijiMode_IsChannelOrDrainSkill(skill) then
if SuijiMode_IsDrainMulticastAllowedSkill(skill)==false then
return true
endif
endif
if skill=='A04W' or skill=='A08D' or skill=='A08A' or skill=='A089' or skill=='A2KQ' then
return true
endif
if skill=='A011' or skill=='A007' or skill=='A01T' or skill=='A00F' then
return true
endif
if skill=='A083' or skill=='A08F' or skill=='A08G' or skill=='A08I' then
return true
endif
return false
endfunction
