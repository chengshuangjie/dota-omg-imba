return id=='A21V' or id=='A21W' or id=='A21X' or id=='A21Y' or id=='A1GU' or id=='Aamk' or id=='A0NR' or id=='A02T' or id=='A0GC' or id=='A0HA' or id=='A0RT' or id=='A0SA' or id=='A121' or id=='A13D' or id=='A1MN' or id=='A1NH' or id=='A1S9' or id=='A1TU' or id=='A1WF' or id=='A1Z2' or id=='A1Z3' or id=='A205' or id=='A20N' or id=='A21H' or id=='A24A' or id=='A24B' or id=='A24E' or id=='A2E6' or id=='A2MB' or id=='A2NI' or id=='A4HF' or id=='ZT01' or id=='ZT02' or id=='ZT07' or id=='ZT08' or id=='ZPNK' or id=='ZPNL'
