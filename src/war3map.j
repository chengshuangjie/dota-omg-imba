call NU7(OB7,"FX2",AddSpecialEffectTarget(tx,WI7,"left hand"))
call TriggerRegisterTimerEvent(t,1+V77,false)
call TriggerAddCondition(t,Condition(function R5F))
set WI7=null
set t=null
