endif
set i=i+1
endloop
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,45," ")
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,45,"|cff99ccff输入|r |c00ff0303-swap #|r |cff99ccff来交换或者输入-swapcancel取消交换|r")
