endloop
call LINGXIA(p5,m5)
call WR7(g)
call NN7(GetHandleId(p5),"748")
call NM7(OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set p5=null
set m5=null
set g=null
