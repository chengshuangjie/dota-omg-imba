if B287_GetLearnedSkill()=='A1IQ' and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A1IQ')==1 and IsUnitIllusion(GetTriggerUnit())==false then
call UZ9(GetTriggerUnit(),false)
endif
return false
endfunction
