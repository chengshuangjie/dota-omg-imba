call B947IssueTargetOrderById("B7D @ war3map.j:100852 (B968)",RH4,$D008F,IH7)
if GetUnitAbilityLevel(IH7,'B0BQ')==1 and GetUnitAbilityLevel(IH7,'A2YL')==0 then
call Z57(IH7,'A2YL',1,5,0)
