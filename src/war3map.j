function SuijiMode_InitInternalRuntimeHelperVisibility takes nothing returns nothing
// B562: These rawcodes are synchronized internal stat/status layers, never
// command-card owners.  Hide them once for every player before any runtime
// attachment.  Keep their legal coordinates, parents, values and add/remove
// lifecycles unchanged; do not use MemHack inspection or local-player state.
// B570: Invoker and his orb system are not members of the OMG random pools.
// Restore Dota's native A0WD 21-level Spell Book and hide only that container.
call M_9('A0WD')
// B565: native Sven owns the original A0WO/A2SX Dota spellbook lifecycle.
// Random Y0EP uses direct bounded JASS state and attaches no runtime helper.
call M_9('A0XE')
// B571: A0XE is the hidden Battle Trance Spell Book.  Its A0XJ child must
// remain enabled or the container loses the original hand effect.
// B662: restore the remaining original Dota timed-status spellbooks.  B544
// attached their passive children directly, and B556 later gave those children
// legal command-card coordinates for crash safety.  Native status/card refreshes
// such as silence could therefore expose the empty-Art children as green icons.
// Disable only the Aspb containers; their passive children must stay enabled.
call M_9('A126')
call M_9('A1ZX')
call M_9('A204')
call M_9('A28F')
call M_9('A2MK')
call M_9('A2N6')
call M_9('A2NB')
call M_9('A2NC')
call M_9('A2ND')
call M_9('A2RY')
call M_9('A2T6')
call M_9('A2VY')
call M_9('A2YQ')
call M_9('A4A8')
// B733: the defense bull-soul reward is a timed passive aura.  Keep its
// QDSM child inside a disabled spellbook instead of attaching that hidden
// AOae object directly to a selected hero's command card.
call M_9('QDSB')
// Death Prophet's Silence grants the old Witchcraft movement aura through a
// disabled spellbook.  Never attach A02C directly: its visible C hotkey steals
// Soul Siphon's command and its legacy icon materializes on the command card.
call M_9('A6DP')
call M_9('S00A')
call M_9('ZBRM')
call M_9('ZAMR')
call M_9('ZCRG')
call M_9('ZDKA')
call M_9('ZFFM')
call M_9('ZLHA')
call M_9('ZTBD')
call M_9('ZUDH')
call M_9('ZWLA')
// Blade Fury owns its own immunity book; do not disable the passive child.
call M_9('ZBFB')
endfunction
