function W4E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
if BB7!=null and GetUnitTypeId(BB7)=='e01V' then
call RemoveUnit(BB7)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set BB7=null
set ZX7=null
return false
endif
if BB7!=null and GetUnitTypeId(BB7)=='e01V' then
if XH7(ZX7)==false then
call SetUnitX(BB7,GetUnitX(ZX7))
call SetUnitY(BB7,GetUnitY(ZX7))
endif
endif
set t=null
set BB7=null
set ZX7=null
return false
endfunction
function W7E takes unit WX7,boolean UA9 returns nothing
local integer BC7=0
local unit BB7
local trigger t
local integer I97
local integer i=0
local integer h=0
if WX7==null or GetUnitTypeId(WX7)==0 then
set WX7=null
return
endif
set BC7=B287_GetUnitAbilityLevel(WX7,'A03E')
set i=GetPlayerId(GetOwningPlayer(WX7))
set h=GetHandleId(WX7)
if UA9 then
set BB7=O77(h,"FeralHeartCaster")
endif
if BB7==null and (BC7==1 or UA9) then
set BB7=CreateUnit(GetOwningPlayer(WX7),'e01V',0,0,0)
call XF7(BB7,'A0ZJ')
call NT7(h,"FeralHeartCaster",BB7)
set t=CreateTrigger()
set yxqs[i]=t
set I97=GetHandleId(t)
call TriggerAddCondition(t,Condition(function W4E))
call TriggerRegisterTimerEvent(t,.2,true)
call SaveUnitHandle(L7,(I97),(2),(WX7))
call SaveUnitHandle(L7,(I97),(19),(BB7))
elseif BB7==null then
set BB7=O77(h,"FeralHeartCaster")
endif
if BB7==null then
set BB7=null
return
endif
if BC7==2 then
call UnitRemoveAbility(BB7,'A0ZJ')
call XF7(BB7,'A0ZI')
elseif BC7==3 then
call UnitRemoveAbility(BB7,'A0ZJ')
call UnitRemoveAbility(BB7,'A0ZI')
call XF7(BB7,'A0ZH')
elseif BC7==4 then
call UnitRemoveAbility(BB7,'A0ZJ')
call UnitRemoveAbility(BB7,'A0ZI')
call UnitRemoveAbility(BB7,'A0ZH')
call XF7(BB7,'A0ZG')
endif
set BB7=null
endfunction
