if eggAlly1093!=null and eggAlly1093!=eggCaster1093 and GetUnitTypeId(eggAlly1093)!=0 and UnitAlive(eggAlly1093) and IsUnitAlly(eggAlly1093,GetOwningPlayer(eggCaster1093)) and IsUnitType(eggAlly1093,UNIT_TYPE_HERO) and IsUnitIllusion(eggAlly1093)==false and IsHideUnit(eggAlly1093)==false and OT7(eggAlly1093,"EGG")==false then
