function ZGF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A141' or B287_GetSpellAbilityId()=='A1WI' then
call ZFF()
endif
endfunction
function CKYX2 takes nothing returns nothing
local player j8=GetTriggerPlayer()
local player p
local integer i=1
local integer n=1
local integer objectid
local string array VH
loop
exitwhen i>11
if i==6 then
set i=7
endif
set p=Player(i)
if p!=j8 and TA7(p) and IsPlayerAlly(p, j8) then
set n=1
loop
exitwhen n>8
set objectid=LoadInteger(TABLE_XJ,(GetHandleId(KU4[GetPlayerId(p)])),(n))
if objectid>0 then
set VH[n]=GetObjectName(objectid)
endif
set n=n+1
endloop
if GetUnitAbilityLevel(KU4[GetPlayerId(p)],'A4DD')>0 then
call DisplayTimedTextToPlayer(j8,0,0,20,Q[GetPlayerId(p)]+GetPlayerName(p)+"|r: "+VH[1]+"、"+VH[2]+"、"+VH[3]+"、"+VH[4]+"、"+VH[5]+"、"+VH[6]+"、"+VH[7]+"、"+VH[8])
endif
endif
set i=i+1
endloop
set j8=null
set p=null
endfunction
function SuijiTavernB316_LimitHeroChoices takes unit tavern returns nothing
local integer h=0
local integer i=5
local integer heroType=0
local integer heroIndex=0
local integer b910FourthSlot=0
local integer b910FourthHero=0
local integer b931BoundHero=0
local integer b931BoundIndex=0
local integer b931BoundSlot=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
// B910: slots 4/5/6 already contain one random AGI/STR/INT hero.
// Choose an attribute uniformly, retaining the original duplicate/pool guards.
// Swap before pruning so the discarded fourth hero is released exactly once.
if LoadInteger(TABLE_XJ,h,5)!=0 and LoadInteger(TABLE_XJ,h,6)!=0 then
set b910FourthSlot=GetRandomInt(4,6)
set b910FourthHero=LoadInteger(TABLE_XJ,h,b910FourthSlot)
call SaveInteger(TABLE_XJ,h,b910FourthSlot,LoadInteger(TABLE_XJ,h,4))
call SaveInteger(TABLE_XJ,h,4,b910FourthHero)
endif
loop
exitwhen i>8
set heroType=LoadInteger(TABLE_XJ,h,i)
if heroType!=0 then
call RemoveUnitFromStock(tavern,heroType)
set heroIndex=GetUnitPointValueByType(heroType)
if heroIndex>=KL4 and heroIndex<=K54 then
set J[heroIndex]=false
endif
call SaveInteger(TABLE_XJ,h,i,0)
endif
set i=i+1
endloop
// Keep exact-account bound heroes after initial setup and every refresh.
if SPEPLAYER[GetPlayerId(GetOwningPlayer(tavern))]==59 then
set b931BoundHero='Otch'
set b931BoundIndex=8
set b931BoundSlot=2
elseif B894PlayerIdentityRow[GetPlayerId(GetOwningPlayer(tavern))]==17 then
set b931BoundHero='Eevi'
set b931BoundIndex=99
set b931BoundSlot=1
elseif B894PlayerIdentityRow[GetPlayerId(GetOwningPlayer(tavern))]==23 then
set b931BoundHero='Ewar'
set b931BoundIndex=60
set b931BoundSlot=1
endif
if SUIJI_MODE and b931BoundHero!=0 then
set i=1
loop
exitwhen i>4 or LoadInteger(TABLE_XJ,h,i)==b931BoundHero
set i=i+1
endloop
if i>4 then
set heroType=LoadInteger(TABLE_XJ,h,b931BoundSlot)
if heroType!=0 then
call RemoveUnitFromStock(tavern,heroType)
set heroIndex=GetUnitPointValueByType(heroType)
if heroIndex>=KL4 and heroIndex<=K54 then
set J[heroIndex]=false
endif
endif
call SaveInteger(TABLE_XJ,h,b931BoundSlot,b931BoundHero)
call AddUnitToStock(tavern,b931BoundHero,1,1)
endif
set J[b931BoundIndex]=true
endif
endfunction
function SSYX takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer i=GetPlayerId(p)
local unit u=SuijiTavernB295_GetHeroStore(GetPlayerId(p))
local integer I97=GetHandleId(u)
local integer Q39=0
local integer Q69=0
local integer QL9=0
local integer left=LoadInteger(TABLE_XJ,I97,100)
local boolean freeRandom=SpecialTitle_HasFreeRandom(p)
if freeRandom==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<100 then
call X37(p,"刷新英雄需要100金币")
set p=null
set u=null
return
endif
if freeRandom==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-100)
endif
call SaveInteger(TABLE_XJ,I97,100,left)
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(1)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(2)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(3)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(4)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(5)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(6)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(7)))
call RemoveUnitFromStock(u,LoadInteger(TABLE_XJ,(I97),(8)))
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(1)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(2)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(3)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(4)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(5)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(6)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(7)))]=false
set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(I97),(8)))]=false
set Q39=QC9(Q39,Q69,1)
set Q69=QC9(Q39,Q69,2)
set QL9=QC9(Q39,Q69,3)
call SaveInteger(TABLE_XJ,(I97),(1),(K34[Q39]))
call SaveInteger(TABLE_XJ,(I97),(2),(K34[Q69]))
call SaveInteger(TABLE_XJ,(I97),(3),(K34[QL9]))
call AddUnitToStock(u,K34[Q39],1,1)
//call QY9(p,K34[Q39])
call AddUnitToStock(u,K34[Q69],1,1)
//call QY9(p,K34[Q69])
call AddUnitToStock(u,K34[QL9],1,1)
//call QY9(p,K34[QL9])
set Q39=QC9(Q39,Q69,1)
set Q69=QC9(Q39,Q69,2)
set QL9=QC9(Q39,Q69,3)
call SaveInteger(TABLE_XJ,(I97),(4),(K34[Q39]))
call SaveInteger(TABLE_XJ,(I97),(5),(K34[Q69]))
call SaveInteger(TABLE_XJ,(I97),(6),(K34[QL9]))
call AddUnitToStock(u,K34[Q39],1,1)
//call QY9(p,K34[Q39])
call AddUnitToStock(u,K34[Q69],1,1)
//call QY9(p,K34[Q69])
call AddUnitToStock(u,K34[QL9],1,1)
//call QY9(p,K34[QL9])
set Q39=QC9(Q39,Q69,1)
set Q69=QC9(Q39,Q69,3)
call SaveInteger(TABLE_XJ,I97,7,K34[Q39])
call SaveInteger(TABLE_XJ,I97,8,K34[Q69])
call AddUnitToStock(u,K34[Q39],1,1)
call AddUnitToStock(u,K34[Q69],1,1)
call SuijiTavernB316_LimitHeroChoices(u)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(u,p)
if IsPlayerAlly(GetLocalPlayer(),p) then
if freeRandom then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p)]+(KZ4[GetPlayerId(p)])+"|r |c00ffff00使用称号特权免费刷新了4个英雄候选，可无限刷新|r")
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p)]+(KZ4[GetPlayerId(p)])+"|r |c00ffff00花费100金币刷新了4个英雄候选，可无限刷新|r")
endif
endif
set p=null
set u=null
endfunction
