set B922WheelText[6]="就这？"
loop
exitwhen emojiIndex921>=12
call TriggerRegisterPlayerChatEvent(emojiChat921,Player(emojiIndex921),"-emoji1",true)
set emojiIndex921=emojiIndex921+1
endloop
call TriggerAddAction(emojiChat921,function B921EmojiChat)
set emojiChat921=null
endfunction
// B922: Local-only UI/input state is never read by the sync receiver.
function B922WheelClose takes nothing returns nothing
local integer wheelHide922=0
set B922WheelOpen=false
set B922AltStamp=-10.
loop
exitwhen wheelHide922>6
call DzFrameShow(B922WheelFrame[wheelHide922],false)
set wheelHide922=wheelHide922+1
endloop
endfunction
function B923WheelCaption takes integer wheelSlot923 returns string
if wheelSlot923==3 then
return "大小姐驾到，|n通通闪开！"
endif
return B922WheelText[wheelSlot923]
endfunction
// Local visibility only; frames are allocated once during initialization.
function B923WheelRefresh takes nothing returns nothing
local integer wheelSlot923=1
set B922Hover=-1
call DzFrameShow(B922WheelFrame[0],B922WheelOpen)
loop
exitwhen wheelSlot923>6
call DzFrameSetText(B922WheelLabel[wheelSlot923],B923WheelCaption(wheelSlot923))
call DzFrameShow(B922WheelFrame[wheelSlot923],B922WheelOpen)
set wheelSlot923=wheelSlot923+1
endloop
endfunction
function B922WheelHit takes nothing returns integer
local integer wheelWidth922=DzGetWindowWidth()
local integer wheelHeight922=DzGetWindowHeight()
local integer wheelPick922=1
local real wheelX922
local real wheelY922
if wheelWidth922<=0 or wheelHeight922<=0 then
return 0
endif
set wheelX922=I2R(DzGetMouseXRelative())*.8/I2R(wheelWidth922)
set wheelY922=I2R(wheelHeight922-DzGetMouseYRelative())*.6/I2R(wheelHeight922)
loop
exitwhen wheelPick922>6
if RAbsBJ(wheelX922-B922WheelX[wheelPick922])<=.07 and RAbsBJ(wheelY922-B922WheelY[wheelPick922])<=.045 then
return wheelPick922
endif
set wheelPick922=wheelPick922+1
endloop
return 0
endfunction
function B922WheelChoose takes integer wheelChoice922 returns nothing
if MHUI_IsChatEditBarOn() or TpSlotLocalTargeting or MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) then
call B922WheelClose()
return
endif
call B922WheelClose()
if wheelChoice922>=1 and wheelChoice922<=6 then
if GetGameTime()>=B922LocalReadyAt then
set B922LocalReadyAt=GetGameTime()+B923EmojiDuration[wheelChoice922]
call DzSyncData("B923E",I2S(wheelChoice922))
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0.,0.,2.,"|cFFFFCC00表情轮盘正在冷却，请稍候。|r")
endif
endif
endfunction
function B922WheelMouse takes nothing returns boolean
local integer wheelMouse922=MHEvent_GetKey()
if B922WheelOpen and (wheelMouse922==MEMHACK_VK_LBUTTON or wheelMouse922==MEMHACK_VK_RBUTTON) then
set B922MouseRelease=wheelMouse922
if wheelMouse922==MEMHACK_VK_LBUTTON then
call B922WheelChoose(B922WheelHit())
else
call B922WheelClose()
endif
call MHEvent_SetKey(-1)
return true
endif
return false
endfunction
function B922WheelMouseUp takes nothing returns boolean
if B922MouseRelease!=0 and MHEvent_GetKey()==B922MouseRelease then
set B922MouseRelease=0
call MHEvent_SetKey(-1)
endif
return false
endfunction
function B922WheelHover takes nothing returns boolean
local integer wheelHover922
local integer wheelPaint922=1
if B922WheelOpen then
if MHUI_IsChatEditBarOn() or TpSlotLocalTargeting or MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) then
call B922WheelClose()
return false
endif
set wheelHover922=B922WheelHit()
if wheelHover922!=B922Hover then
set B922Hover=wheelHover922
loop
exitwhen wheelPaint922>6
if wheelPaint922==wheelHover922 then
call DzFrameSetText(B922WheelLabel[wheelPaint922],"|cFFFFCC00> "+B923WheelCaption(wheelPaint922)+" <|r")
else
call DzFrameSetText(B922WheelLabel[wheelPaint922],B923WheelCaption(wheelPaint922))
endif
set wheelPaint922=wheelPaint922+1
endloop
endif
endif
return false
endfunction
function B922WheelKeyDown takes nothing returns boolean
local integer wheelKey922=MHEvent_GetKey()
local real wheelNow922=GetGameTime()
if wheelKey922==18 or wheelKey922==164 or wheelKey922==165 then
if B922AltHeld then
return false
endif
set B922AltHeld=true
if MHUI_IsChatEditBarOn() or EditingHotKeyIndex>0 or IsSetUpUIEnable or UpdateLogIsShow or bMenuMainPanelIsEnable or TpSlotLocalTargeting or MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) or MHMsg_IsKeyDown(OSKEY_SHIFT) or DzIsKeyDown(17) then
set B922AltStamp=-10.
return false
endif
if B922WheelOpen then
call B922WheelClose()
elseif B922AltStamp>=0. and wheelNow922>=B922AltStamp and wheelNow922-B922AltStamp<=.30 then
set B922WheelOpen=true
set B922AltStamp=-10.
call B923WheelRefresh()
call B922WheelHover()
else
set B922AltStamp=wheelNow922
endif
elseif wheelKey922>0 then
set B922AltStamp=-10.
if B922WheelOpen then
call B922WheelClose()
if wheelKey922==27 then
call MHEvent_SetKey(-1)
endif
endif
endif
return false
endfunction
function B922WheelKeyUp takes nothing returns boolean
local integer wheelUp922=MHEvent_GetKey()
if wheelUp922==18 or wheelUp922==164 or wheelUp922==165 then
set B922AltHeld=false
endif
return false
endfunction
function B922WheelSync takes nothing returns nothing
local player wheelSender922=DzGetTriggerSyncPlayer()
local integer wheelPid922=GetPlayerId(wheelSender922)
local string wheelData922=DzGetTriggerSyncData()
local integer wheelValue922=S2I(wheelData922)
if wheelPid922>=0 and wheelPid922<12 and GetPlayerController(wheelSender922)==MAP_CONTROL_USER and GetPlayerSlotState(wheelSender922)==PLAYER_SLOT_STATE_PLAYING and wheelValue922>=1 and wheelValue922<=6 and I2S(wheelValue922)==wheelData922 then
if GetGameTime()>=B922SyncReadyAt[wheelPid922] then
if not B923EmojiShowPlayer(wheelSender922,wheelValue922) then
set wheelSender922=null
return
endif
set B922SyncReadyAt[wheelPid922]=GetGameTime()+B923EmojiDuration[wheelValue922]
if IsPlayerAlly(GetLocalPlayer(),wheelSender922) or WG7(GetLocalPlayer()) then
call EXDisplayChat(wheelSender922,1,"|cFF66CCFF[表情]|r "+B922WheelText[wheelValue922])
endif
endif
endif
set wheelSender922=null
endfunction
function B922WheelInit takes nothing returns nothing
local integer wheelInit922=0
local trigger wheelTrig922
local real wheelAngle922
loop
exitwhen wheelInit922>6
set B922WheelFrame[wheelInit922]=DzCreateFrameByTagName("BACKDROP",null,GameUI,"TooltipBackDrop",9220+wheelInit922)
call DzFrameSetPriority(B922WheelFrame[wheelInit922],180)
if wheelInit922==0 then
call DzFrameSetAbsolutePoint(B922WheelFrame[0],4,.4,.365)
call DzFrameSetSize(B922WheelFrame[0],.14,.075)
else
set wheelAngle922=(90.-I2R(wheelInit922-1)*60.)*bj_DEGTORAD
set B922WheelX[wheelInit922]=.4+.175*Cos(wheelAngle922)
set B922WheelY[wheelInit922]=.365+.115*Sin(wheelAngle922)
call DzFrameSetAbsolutePoint(B922WheelFrame[wheelInit922],4,B922WheelX[wheelInit922],B922WheelY[wheelInit922])
call DzFrameSetSize(B922WheelFrame[wheelInit922],.14,.09)
endif
set B922WheelLabel[wheelInit922]=DzCreateFrameByTagName("TEXT",null,B922WheelFrame[wheelInit922],"CheckBox_Text",9220+wheelInit922)
call DzFrameSetPoint(B922WheelLabel[wheelInit922],4,B922WheelFrame[wheelInit922],4,0.,0.)
call DzFrameSetPriority(B922WheelLabel[wheelInit922],182)
if wheelInit922==0 then
call DzFrameSetText(B922WheelLabel[0],"|cFFFFCC00表情轮盘|r|n点击发送表情和文字|nEsc / 右键取消")
else
set B923WheelIcon[wheelInit922]=DzCreateFrameByTagName("BACKDROP",null,B922WheelFrame[wheelInit922],"template",9240+wheelInit922)
call DzFrameSetTexture(B923WheelIcon[wheelInit922],B923EmojiIcon[wheelInit922],0)
call DzFrameSetSize(B923WheelIcon[wheelInit922],.05,.05)
call DzFrameSetPoint(B923WheelIcon[wheelInit922],4,B922WheelFrame[wheelInit922],4,0.,.015)
call DzFrameSetPriority(B923WheelIcon[wheelInit922],181)
call DzFrameClearAllPoints(B922WheelLabel[wheelInit922])
call DzFrameSetPoint(B922WheelLabel[wheelInit922],4,B922WheelFrame[wheelInit922],4,0.,-.025)
call DzFrameSetText(B922WheelLabel[wheelInit922],B923WheelCaption(wheelInit922))
endif
call DzFrameShow(B922WheelFrame[wheelInit922],false)
set wheelInit922=wheelInit922+1
endloop
set wheelTrig922=CreateTrigger()
call MHMsgKeyDownEvent_Register(wheelTrig922)
call TriggerAddCondition(wheelTrig922,Condition(function B922WheelKeyDown))
set wheelTrig922=CreateTrigger()
call MHMsgKeyUpEvent_Register(wheelTrig922)
call TriggerAddCondition(wheelTrig922,Condition(function B922WheelKeyUp))
set wheelTrig922=CreateTrigger()
call MHMsgMouseUpEvent_Register(wheelTrig922)
call TriggerAddCondition(wheelTrig922,Condition(function B922WheelMouseUp))
set wheelTrig922=CreateTrigger()
call MHMsgMouseMoveEvent_Register(wheelTrig922)
call TriggerAddCondition(wheelTrig922,Condition(function B922WheelHover))
set wheelTrig922=CreateTrigger()
call DzTriggerRegisterSyncData(wheelTrig922,"B923E",false)
call TriggerAddAction(wheelTrig922,function B922WheelSync)
set wheelTrig922=null
endfunction
function OnClickSkillButton takes nothing returns boolean
local integer key1060=MHEvent_GetKey()
local integer frame1060=MHEvent_GetFrame()
    local integer skillButton
    local integer abilityId
    local unit selectedShop
    local integer pid=GetPlayerId(GetLocalPlayer())
    if B922WheelMouse() or B922MouseRelease!=0 then
        call MHEvent_SetKey(-1)
        return false
    endif
    set B922AltStamp=-10.
    if B843GooLog and key1060==MEMHACK_VK_LBUTTON then
        call B843GooLogClick(frame1060)
    endif
    if LoadBoolean(L7,StringHash("OmgDeleteSkillPending"),pid) and key1060 == MEMHACK_VK_LBUTTON then
        set skillButton=frame1060
        set abilityId=MHUIData_GetCommandButtonAbility(skillButton)
        if abilityId!=0 then
            call DzSyncData("omgdel",I2S(abilityId))
            call MHEvent_SetKey(- 1)
        endif
    elseif MHMsg_IsKeyDown(OSKEY_SHIFT) and key1060 == MEMHACK_VK_LBUTTON then
        set skillButton=frame1060
        set abilityId=MHUIData_GetCommandButtonAbility(skillButton)
        if abilityId=='Asud' or abilityId=='Asel' then
            set selectedShop=MHPlayer_GetSelectUnit()
            if QuickBuy_AddLocal(skillButton,selectedShop) then
                call MHEvent_SetKey(-1)
            endif
        endif
    elseif MHMsg_IsKeyDown(OSKEY_ALT) and key1060 == MEMHACK_VK_LBUTTON then
        set skillButton=frame1060
        call onClickSkillCommandButton(skillButton)
        call MHEvent_SetKey(- 1)
    endif
    set selectedShop=null
    return false
endfunction
function GetItemButtonIndex takes integer itemButton returns integer
    local integer i= 1
    loop
        exitwhen i > 6
        if itemButton == ItemBarButton[i] then
            return i
        endif
        set i=i + 1
    endloop
    return 0
endfunction
function OnClickItemButton takes nothing returns boolean
local integer key1060=MHEvent_GetKey()
local integer frame1060=MHEvent_GetFrame()
    local integer itemButton
    local integer itemSlot
    if B922WheelMouse() or B922MouseRelease!=0 then
        call MHEvent_SetKey(-1)
        return false
    endif
    set B922AltStamp=-10.
    if MHMsg_IsKeyDown(OSKEY_ALT) and key1060 == MEMHACK_VK_LBUTTON then
        set itemButton=frame1060
        set itemSlot=GetItemButtonIndex(itemButton)
        if itemSlot>0 then
            call onClickItemCommandButton(GetPlayerId(GetLocalPlayer()),itemSlot - 1)
        endif
        call MHEvent_SetKey(- 1)
    endif
    return false
endfunction
// B911: local input only; the existing CHAT sync owns allied delivery/throttling.
function B1042DoubleClick takes unit tipUnit1042 returns boolean
local real tipTime1042=GetGameTime()
if GetHandleId(tipUnit1042)==B1042LocalUnitId and tipTime1042-B1042LocalTime>=0. and tipTime1042-B1042LocalTime<=.35 then
set B1042LocalUnitId=0
set B1042LocalTime=-10.
call DzSyncData("B1042TIP",I2S(GetPlayerId(GetOwningPlayer(tipUnit1042)))+";"+I2S(GetHandleId(tipUnit1042)))
return true
endif
set B1042LocalUnitId=GetHandleId(tipUnit1042)
set B1042LocalTime=tipTime1042
return false
endfunction
function B911PingWorldUnit takes nothing returns boolean
    local unit b911PingUnit=null
    local player b911PingPlayer=GetLocalPlayer()
    local integer b911PingType=0
    local integer b911PingHeight=DzGetWindowHeight()
    local real b911PingY=0.
    local string b911PingMessage=null
    if MHUI_IsChatEditBarOn() or MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) or TpSlotLocalTargeting or b911PingHeight<=0 then
        set b911PingPlayer=null
        return false
    endif
    // Conservative world viewport: exclude console, custom TP button and top UI.
    // Do not use DzIsMouseOverUI: it rejects the world viewport on some KK clients.
    set b911PingY=I2R(b911PingHeight-DzGetMouseYRelative())*.6/I2R(b911PingHeight)
    if b911PingY<.22 or b911PingY>.56 then
        set b911PingPlayer=null
        return false
    endif
    set b911PingUnit=MHMsg_GetCursorUnit()
    if b911PingUnit==null or GetUnitTypeId(b911PingUnit)==0 or not UnitAlive(b911PingUnit) or IsUnitHidden(b911PingUnit) or not IsUnitVisible(b911PingUnit,b911PingPlayer) then
        set b911PingUnit=null
        set b911PingPlayer=null
        return false
    endif
    set b911PingType=GetUnitTypeId(b911PingUnit)
    if not IsUnitType(b911PingUnit,UNIT_TYPE_HERO) or IsUnitIllusion(b911PingUnit) then
        set B1042LocalUnitId=0
        set B1042LocalTime=-10.
    endif
    if b911PingType=='e00R' or b911PingType=='e011' or b911PingType=='e00S' or b911PingType=='e019' or b911PingType=='u00M' or b911PingType=='u00D' or b911PingType=='u00N' or b911PingType=='u00T' then
        if IsUnitEnemy(b911PingUnit,b911PingPlayer) then
            set b911PingMessage="准备推进，攻击对方防御塔 > |cFFFFFF00"+GetUnitName(b911PingUnit)+"|r"
        elseif IsUnitAlly(b911PingUnit,b911PingPlayer) then
            set b911PingMessage="注意防守我方防御塔 > |cFFFFFF00"+GetUnitName(b911PingUnit)+"|r"
        endif
    elseif IsUnitType(b911PingUnit,UNIT_TYPE_HERO) and not IsUnitIllusion(b911PingUnit) then
        if B1042DoubleClick(b911PingUnit) then
            set b911PingUnit=null
            set b911PingPlayer=null
            return true
        endif
        if IsUnitOwnedByPlayer(b911PingUnit,b911PingPlayer) then
            set b911PingMessage="队友救救我！ > |cFFFFFF00"+GetUnitName(b911PingUnit)+"|r"
        elseif IsUnitEnemy(b911PingUnit,b911PingPlayer) then
            set b911PingMessage="注意对方英雄 > |cFFFF6060"+GetUnitName(b911PingUnit)+"|r"
        elseif IsUnitAlly(b911PingUnit,b911PingPlayer) then
            set b911PingMessage="注意队友英雄 > |cFFFFFF00"+GetUnitName(b911PingUnit)+"|r"
        endif
    endif
    set b911PingUnit=null
    set b911PingPlayer=null
    if b911PingMessage!=null then
        call s__PlayerChat_SendChatToAlliedPlayers(b911PingMessage)
        set b911PingMessage=null
        return true
    endif
    return false
endfunction
function ClickMouseButton takes nothing returns boolean
    local integer key=MHEvent_GetKey()
    if B922WheelMouse() or B922MouseRelease!=0 then
        call MHEvent_SetKey(-1)
        return false
    endif
    set B922AltStamp=-10.
    if key!=MEMHACK_VK_LBUTTON or not MHMsg_IsKeyDown(OSKEY_ALT) then
        set B1042LocalUnitId=0
        set B1042LocalTime=-10.
    endif
    if key==MEMHACK_VK_LBUTTON and MHMsg_IsKeyDown(OSKEY_ALT) then
        if B911PingWorldUnit() then
            call MHEvent_SetKey(-1)
        else
            set B1042LocalUnitId=0
            set B1042LocalTime=-10.
        endif
    endif
    if key == MEMHACK_VK_RBUTTON and OT7(MHPlayer_GetSelectUnit(),"DISRB") then
        if not DzIsKeyDown(16) then
            call ClearTextMessages()
            call MHUI_PlayErrorSound()
            call DisplayTimedTextToPlayer(GetLocalPlayer(),.5,-1.,2., "|cffffcc00传送只能用停止(S)键打断|r")
            call MHEvent_SetKey(-1)
        endif
    endif
    return false
endfunction
