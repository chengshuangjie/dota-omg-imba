local integer h=0
local trigger t=null
if u==null then
return
endif
set h=GetHandleId(u)
set t=LoadTriggerHandle(L7,h,StringHash("SuijiFlakSideGunnerLifecycle"))
if t!=null then
call RemoveSavedHandle(L7,h,StringHash("SuijiFlakSideGunnerLifecycle"))
call NM7(GetHandleId(t))
call OZ7(t)
