function SuijiTest_PresetHero takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetHero"),pid)
endfunction
function SuijiTest_PresetSmall takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetSmall"),pid)
endfunction
function SuijiTest_PresetUlt takes integer pid returns integer
return LoadInteger(L7,StringHash("SuijiTestPresetUlt"),pid)
endfunction
function SuijiTest_PresetController takes integer pid returns player
return LoadPlayerHandle(L7,StringHash("SuijiTestPresetController"),pid)
endfunction
function SuijiTest_HasPreset takes integer pid returns boolean
return SuijiTest_PresetHero(pid)!=0 and SuijiTest_PresetSmall(pid)!=0 and SuijiTest_PresetUlt(pid)!=0
endfunction
function SuijiTest_FindHeroIndex takes integer hero returns integer
local integer idx=KL4
loop
exitwhen idx>K54
if K34[idx]==hero then
return idx
endif
set idx=idx+1
endloop
return 0
endfunction
function SuijiMode_AIHeroAttribute takes integer heroIndex returns integer
local integer hero=0
local integer i=1
if heroIndex<KL4 or heroIndex>K54 then
return 0
endif
set hero=K34[heroIndex]
loop
exitwhen i>M74
if M44[i]==hero then
return 1
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>K_4
if K24[i]==hero then
return 2
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>M94
if M84[i]==hero then
return 3
endif
set i=i+1
endloop
return 0
endfunction
function SuijiMode_AIHeroMatchesFloor takes player p,integer heroIndex returns boolean
local integer floor=i5(p)
local integer attribute=SuijiMode_AIHeroAttribute(heroIndex)
if floor==6 or floor==7 then
return attribute==1
elseif floor==8 then
return attribute==2
elseif floor==9 or floor==10 then
return attribute==3
endif
return true
endfunction
