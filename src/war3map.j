set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if GetUnitTypeId(p5)==0 or GetUnitTypeId(BB7)==0 or UnitAlive(p5)==false or UnitAlive(BB7)==false or (b and (BB7A==null or GetUnitTypeId(BB7A)==0 or UnitAlive(BB7A)==false)) then
call GIE(OB7)
