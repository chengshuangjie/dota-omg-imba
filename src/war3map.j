function S38 takes unit attackSource1053,unit attackTarget1053 returns nothing
local unit S68=attackSource1053
local unit m5=attackTarget1053
local group g=null
local integer orderKey1109=0
if S68==null or m5==null or GetUnitTypeId(S68)==0 or GetUnitTypeId(m5)==0 or not UnitAlive(S68) or not UnitAlive(m5) then
set S68=null
set m5=null
return
endif
// B1109: suppress only this unit's recursive order helper, never Tri_attack.
set orderKey1109=GetHandleId(S68)
if LoadBoolean(L7,orderKey1109,StringHash("B1109S38Running")) then
set S68=null
set m5=null
return
endif
call SaveBoolean(L7,orderKey1109,StringHash("B1109S38Running"),true)
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(S68),GetUnitY(S68),900,Condition(function SC8))
call WR7(g)
if GetUnitTypeId(S68)!=0 and UnitAlive(S68) and N24!=null and GetUnitTypeId(N24)!=0 and UnitAlive(N24) then
call B947IssueTargetOrderById("S38 @ war3map.j:39753 (B968)",S68,$D000F,N24)
call GroupAddUnit(KU,S68)
elseif GetUnitTypeId(S68)!=0 and UnitAlive(S68) and GetUnitTypeId(m5)!=0 and UnitAlive(m5) and IsUnitType(m5,UNIT_TYPE_HERO) and N_4!=null and GetUnitTypeId(N_4)!=0 and UnitAlive(N_4) then
call B947IssueTargetOrderById("S38 @ war3map.j:39756 (B968)",S68,$D000F,N_4)
call GroupAddUnit(KU,S68)
endif
call RemoveSavedBoolean(L7,orderKey1109,StringHash("B1109S38Running"))
set N24=null
set N_4=null
set S68=null
set m5=null
set g=null
endfunction
function SL8 takes nothing returns nothing
