function OLO takes player p, item it returns nothing
	local timer t
	local integer TME = GetPlayerId(p)
	local integer O5=GetPlayerId(p)
	local integer i=IMaxBJ(0,BUY[O5]-10)
	local boolean b=false
	loop
	exitwhen i>BUY[O5] or b
		if (GetItemTypeId(it)==LoadInteger(TABLE_BUY,O5,i) or Special_Item(O5,i,it)) and GetGameTime()-LoadReal(TABLE_BUY,O5,i)<10. and Alreay_Use(it)==false then
		set b=true
		call SaveInteger(TABLE_BUY, O5, i, 0)
		set t = CreateTimer()
		call TimerStart(t, 0, false, function OHO)
		call SavePlayerHandle(TABLE_HY, GetHandleId(t), 0, p)
		call SaveInteger(TABLE_HY, GetHandleId(t), 1, GetItemTypeId(it))
		set t = null
		endif
		set i=i+1
	endloop
endfunction
