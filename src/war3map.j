call TriggerAddCondition(t,Condition(function B1010GuiseHit))
set t=null
endfunction
function GND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local destructable IH7=(LoadDestructableHandle(L7,(I97),(20)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer WF8=LoadInteger(L7,I97,34)
local real DUR=LoadReal(L7,I97,1)
set WF8=WF8+1
call SaveInteger(L7,(I97),(34),(WF8))
if WF8>DUR or GetDestructableLife(IH7)<=0 or UnitAlive(BB7)==false then
call KillUnit(BB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
return false
endfunction
function GOD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local destructable IH7=GetDestructableInRange(x,y,125)
local unit BB7
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local real DUR=600
if GetOwningPlayer(ZX7)==GetLocalPlayer() then
call AddIndicator(IH7,255,255,0,255)
endif
set x=GetDestructableX(IH7)
set y=GetDestructableY(IH7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0BT',x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(BB7,'BTLF',DUR)
if IsUnitAlly(ZX7, GetLocalPlayer()) then
	call MHUnit_EnableViewSkill(BB7 , GetLocalPlayer())
endif
// call SaveUnitHandle(TABLE_HY,GetHandleId(ZX7),'bird',GetHandleId(BB7))
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function GND))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveDestructableHandle(L7,(I97),(20),(IH7))
call SaveReal(L7,I97,1,DUR*10.)
call SaveInteger(L7,(I97),(34),(0))
set t=null
set ZX7=null
set IH7=null
set BB7=null
endfunction
