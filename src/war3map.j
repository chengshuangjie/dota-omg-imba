function UnitAddPermanentAbility takes unit tri_u, integer skill returns boolean
	return UnitAddAbility(tri_u, skill) and UnitMakeAbilityPermanent(tri_u, true, skill)
endfunction
function UnitAddPermanentAbilitySetLevel takes unit u, integer id, integer level returns nothing
	if GetUnitAbilityLevel(u, id) == 0 then
		call UnitAddPermanentAbility(u, id)
	endif
	call SetUnitAbilityLevel(u, id, level)
endfunction
//闪烁类技能
function OXX takes integer id returns boolean
	if MiaoStarted and (id=='AMdD' or id=='AMdF') then
		return true
	endif
	if id =='A0ME' or id =='AEbl' or id =='Abbk' or id =='A01O' or id =='A0FN' or id =='A14O' or id =='A2YR' or id =='A4HR' or id =='A4HS' then
		return true
	elseif id=='A0B8' or id=='A4KW' then
		return true
	endif
		return false
endfunction
function RadianBetweenUnit takes unit a,unit b returns real
	return Atan2(GetUnitY(b) - GetUnitY(a), GetUnitX(b) - GetUnitX(a))
endfunction
function AngleBetweenXY takes real x1, real y1, real x2, real y2 returns real
	return bj_RADTODEG * Atan2(y2 -y1, x2 -x1)
endfunction
function AngleBetweenUnit takes unit a, unit b returns real
	return bj_RADTODEG * Atan2(GetUnitY(b)-GetUnitY(a), GetUnitX(b)-GetUnitX(a))
endfunction
//坐标修正
function CoordinateX50 takes real x returns real
	local real dx = GetRectMinX(bj_mapInitialPlayableArea)+ 50
	if(x < dx) then
		return dx
	endif
	set dx = GetRectMaxX(bj_mapInitialPlayableArea)-50
	if(x > dx) then
		return dx
	endif
	return x
endfunction
function CoordinateY50 takes real y returns real
	local real dy = GetRectMinY(bj_mapInitialPlayableArea)+ 50
	if(y < dy) then
		return dy
	endif
	// set dy = GetRectMaxY(bj_mapInitialPlayableArea)-50
    set dy = 7146
	if(y > dy) then
		return dy
	endif
	return y
endfunction
//创建一个一次性计时器，返回值是计时器的整数地址，需要手动销毁。
function TimerStartSingle takes real timeout, code callback returns integer
	local timer t = CreateTimer()
	local integer h = GetHandleId(t)
	call FlushChildHashtable(TABLE_HY, h)
	call TimerStart(t, timeout, false, callback)
	set t = null
	return h
endfunction
// B1091: reversible acquisition floor; no timers, scans or issued orders.
function B1091AcquireBase takes unit acquireOwner1091 returns real
local integer acquireHandle1091=GetHandleId(acquireOwner1091)
local real acquireCurrent1091=GetUnitAcquireRange(acquireOwner1091)
if HaveSavedReal(L7,acquireHandle1091,'aqB1') and LoadInteger(L7,acquireHandle1091,'aqT1')==GetUnitTypeId(acquireOwner1091) and RAbsBJ(acquireCurrent1091-LoadReal(L7,acquireHandle1091,'aqL1'))<.5 then
return LoadReal(L7,acquireHandle1091,'aqB1')
endif
return acquireCurrent1091
endfunction
function B1091SetAcquireBase takes unit acquireOwner1091,real acquireBase1091 returns nothing
local integer acquireHandle1091=0
local real acquireRange1091=0.
local real acquireWanted1091=acquireBase1091
if acquireOwner1091==null or GetUnitTypeId(acquireOwner1091)==0 then
return
endif
set acquireHandle1091=GetHandleId(acquireOwner1091)
set acquireRange1091=GetUnitState(acquireOwner1091,UNIT_STATE_ATTACK1_RANGE)
// Preserve disabled acquisition and avoid Pike's target-only +90000 radius.
if acquireBase1091>0. and acquireRange1091<10000. then
set acquireWanted1091=RMaxBJ(acquireBase1091,acquireRange1091)
endif
if LoadReal(L7,acquireHandle1091,'aqB1')!=acquireBase1091 or HaveSavedReal(L7,acquireHandle1091,'aqB1')==false then
call SaveReal(L7,acquireHandle1091,'aqB1',acquireBase1091)
endif
if LoadInteger(L7,acquireHandle1091,'aqT1')!=GetUnitTypeId(acquireOwner1091) then
call SaveInteger(L7,acquireHandle1091,'aqT1',GetUnitTypeId(acquireOwner1091))
endif
if RAbsBJ(GetUnitAcquireRange(acquireOwner1091)-acquireWanted1091)>.5 then
call SetUnitAcquireRange(acquireOwner1091,acquireWanted1091)
endif
if LoadReal(L7,acquireHandle1091,'aqL1')!=acquireWanted1091 then
call SaveReal(L7,acquireHandle1091,'aqL1',acquireWanted1091)
endif
endfunction
function B1091SyncAcquire takes unit acquireOwner1091 returns nothing
if acquireOwner1091==null or GetUnitTypeId(acquireOwner1091)==0 then
return
endif
// Keep the finite floor throughout Pike's temporary unlimited attacks.
if GetUnitState(acquireOwner1091,UNIT_STATE_ATTACK1_RANGE)>=10000. then
return
endif
call B1091SetAcquireBase(acquireOwner1091,B1091AcquireBase(acquireOwner1091))
endfunction
//单位射程
function Unit_Setrange takes unit u, real r returns nothing
	call SetUnitState(u, UNIT_STATE_ATTACK1_RANGE, r)
call B1091SyncAcquire(u)
endfunction
