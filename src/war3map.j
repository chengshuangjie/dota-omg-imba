//星落
function XJCAX takes nothing returns nothing
local timer b1060GetExpiredTimer=GetExpiredTimer()
	local integer h = GetHandleId(b1060GetExpiredTimer)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer c = LoadInteger(TABLE_HY, h, 0)
	local group g
	local unit m5
	if u==null or GetUnitTypeId(u)==0 then
		if LoadTimerHandle(TABLE_HY, GetHandleId(u),'A3UF')==b1060GetExpiredTimer then
			call RemoveSavedHandle(TABLE_HY, GetHandleId(u),'A3UF')
		endif
		call FlushChildHashtable(TABLE_HY,h)
		call PauseTimer(b1060GetExpiredTimer)
		call DestroyTimer(b1060GetExpiredTimer)
		set u=null
		set b1060GetExpiredTimer=null
		return
	endif
	if LoadBoolean(TABLE_HY, h, 0) then
		call RemoveSavedBoolean(TABLE_HY, h, 0)
		call TimerStart(b1060GetExpiredTimer, 1., true, function XJCAX)
	endif
	if c > 0 then
		set c = c -1
		call SaveInteger(TABLE_HY, h, 0, c)
	endif
	if c == 0 and SuijiMode_ScepterRegistryIsActive(u,'A0KV') and B287_GetUnitAbilityLevel(u,'A0KV')> 0 and(GetWidgetLife(u)> 0.405 and not IsUnitType(u, UNIT_TYPE_DEAD)) then
		set g = WS7()
		set IN4 = u
		call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 650, Condition(function AX7))
		//如果英雄非隐身
		if not DXX(u) then
			set m5=FirstOfGroup(g)
			if m5!=null and UnitAlive(m5) then
				call LP9(u)
				if GetUnitAbilityLevel(u,'A2VW')>0 then
					call SaveInteger(TABLE_HY, h, 0, 6)
				else
					call SaveInteger(TABLE_HY, h, 0, 8)
				endif
			endif
		endif
		call WR7(g)
	endif
	set u = null
	set m5 = null
	set g = null
set b1060GetExpiredTimer=null
endfunction
function XJVXX takes nothing returns nothing
	local timer t = CreateTimer()
	local unit u = U22
	local integer h = GetHandleId(t)
	call TimerStart(t, 0, false, function XJCAX)
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	call SaveInteger(TABLE_HY, h, 0, 0)
	call SaveBoolean(TABLE_HY, h, 0, true)
	call SaveTimerHandle(TABLE_HY, GetHandleId(u),'A3UF', t)
	set u = null
	set t = null
endfunction
function Mirana_HasScepter takes unit miranaScepterUnit returns boolean
if miranaScepterUnit==null then
return false
endif
return SuijiMode_ScepterRegistryIsActive(miranaScepterUnit,'A0KV')
endfunction
function Mirana_EnsureStarfallScepter takes unit miranaStarfallUnit returns nothing
local player miranaStarfallOwner=null
if miranaStarfallUnit==null then
return
endif
set miranaStarfallOwner=GetOwningPlayer(miranaStarfallUnit)
// Random Starfall's Scepter effect is timer-owned.  These legacy companions
// rebuild or overlap the command card (A4F2 belongs to Leap), so keep them off
// the unit and let the saved timer drive the automatic Starfall directly.
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A3UF',false)
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A3UG',false)
call SetPlayerAbilityAvailable(miranaStarfallOwner,'A4F2',false)
call UnitRemoveAbility(miranaStarfallUnit,'A3UF')
call UnitRemoveAbility(miranaStarfallUnit,'A3UG')
call UnitRemoveAbility(miranaStarfallUnit,'A4F2')
if Mirana_HasScepter(miranaStarfallUnit) and B287_GetUnitAbilityLevel(miranaStarfallUnit,'A0KV')>0 then
if not HaveSavedHandle(TABLE_HY, GetHandleId(miranaStarfallUnit),'A3UF') then
set U22=miranaStarfallUnit
call ExecuteFunc("XJVXX")
endif
endif
set miranaStarfallOwner=null
endfunction
function uj takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false)!=null
endfunction
function uJ takes real uk,real uK,real iN,real io returns integer
local real in=SquareRoot((iN-uk)*(iN-uk)+(io-uK)*(io-uK))
return YG7(R2I(in/$96),$B)
endfunction
