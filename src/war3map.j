function Get_Bingnv_Huilan takes unit ZX7 returns real
	local integer id=GetUnitTypeId(ZX7)
local integer level=B287_GetUnitAbilityLevel(ZX7,'AHab')+GetUnitAbilityLevel(ZX7,'XHab')+GetUnitAbilityLevel(ZX7,'XHac')+GetUnitAbilityLevel(ZX7,'XHad')
	local real d=0
	if id=='Hjai' or id=='Zjai' or id=='Zjaj' or id=='Zjak' or (SUIJI_MODE and IsUnitIllusion(ZX7)==false and OO7(GetHandleId(ZX7),"SuijiDone") and B287_GetUnitAbilityLevel(ZX7,'AHab')>0) then
		if level==1 or level==2 then
			set d=(.5+.5*level)*.25
		elseif level==3 then
			set d=0.5
		elseif level==4 then
			set d=1
		endif
	endif
	return d
endfunction
function BrillianceOverflow_GetAuraLevel takes unit u returns integer
local integer level=0
if u!=null and GetUnitTypeId(u)!=0 then
set level=B287_GetUnitAbilityLevel(u,'AHab')+GetUnitAbilityLevel(u,'XHab')+GetUnitAbilityLevel(u,'XHac')+GetUnitAbilityLevel(u,'XHad')
if level>4 then
set level=4
endif
endif
return level
endfunction
function BrillianceOverflow_GetRate takes integer level returns real
if level==1 then
return 1.
elseif level==2 then
return 1.5
elseif level==3 then
return 2.
elseif level>=4 then
return 4.
endif
return 0.
endfunction
function BrillianceOverflow_GetBestAuraLevel takes unit u returns integer
local integer i=0
local integer level=0
local integer best=0
local unit source=null
loop
exitwhen i>11
set source=M7[i]
if source!=null and GetUnitTypeId(source)!=0 and UnitAlive(source) and IsUnitIllusion(source)==false and IsUnitAlly(u,GetOwningPlayer(source)) and IsUnitAlly(source,GetOwningPlayer(u)) then
set level=BrillianceOverflow_GetAuraLevel(source)
if level>best then
set best=level
endif
endif
set i=i+1
endloop
set source=null
return best
endfunction
function BrillianceOverflow_ShowText takes unit u,string message returns nothing
local texttag tt=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set tt=CreateTextTag()
call SetTextTagText(tt,message,.022)
call SetTextTagPosUnit(tt,u,90.)
call SetTextTagColor(tt,80,160,255,255)
call SetTextTagVelocity(tt,0.,.035)
call SetTextTagFadepoint(tt,.7)
call SetTextTagLifespan(tt,1.2)
call SetTextTagPermanent(tt,false)
if IsUnitVisible(u,GetLocalPlayer()) and (IsUnitAlly(u,GetLocalPlayer()) or WG7(GetLocalPlayer())) then
call SetTextTagVisibility(tt,true)
else
call SetTextTagVisibility(tt,false)
endif
set tt=null
endfunction
function BrillianceOverflow_Clear takes unit u returns nothing
local integer h=0
local effect e=null
if u==null then
return
endif
set h=GetHandleId(u)
set e=OG7(h,"BrillianceOverflowEffect")
if e!=null then
call DestroyEffect(e)
call NN7(h,"BrillianceOverflowEffect")
endif
call RemoveSavedReal(L7,h,StringHash("BrillianceOverflowShield"))
set e=null
endfunction
function BrillianceOverflow_OnTick takes nothing returns boolean
local integer i=0
local integer level=0
local integer ownLevel=0
local integer h=0
local unit u=null
local real maxMana=0.
local real shield=0.
local real oldShield=0.
local real cap=0.
local real gain=0.
loop
exitwhen i>11
set u=M7[i]
if u!=null and GetUnitTypeId(u)!=0 and IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false then
if UnitAlive(u)==false then
call BrillianceOverflow_Clear(u)
else
set h=GetHandleId(u)
set level=BrillianceOverflow_GetBestAuraLevel(u)
set maxMana=GetUnitState(u,UNIT_STATE_MAX_MANA)
if level>0 and maxMana>0. and GetUnitState(u,UNIT_STATE_MANA)>=maxMana-.5 then
set shield=ON7(h,"BrillianceOverflowShield")
set oldShield=shield
set cap=maxMana*(.04+.02*level)
set ownLevel=BrillianceOverflow_GetAuraLevel(u)
set gain=BrillianceOverflow_GetRate(level)*1.5
if ownLevel>0 then
set gain=gain+BrillianceOverflow_GetRate(ownLevel)*1.5
endif
set shield=RMinBJ(cap,shield+gain)
call NQ7(h,"BrillianceOverflowShield",shield)
if oldShield<cap-.5 and shield>=cap-.5 then
call BrillianceOverflow_ShowText(u,"法力盈溢：护盾已充满 "+I2S(R2I(shield+.5)))
endif
if shield>0. and OG7(h,"BrillianceOverflowEffect")==null then
call NU7(h,"BrillianceOverflowEffect",AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",u,"origin"))
endif
endif
endif
endif
set i=i+1
endloop
set u=null
return false
endfunction
function BrillianceOverflow_OnDamaging takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local integer h=0
local real damage=MHDamagingEvent_GetDamage()
local real shield=0.
local real absorbed=0.
local effect e=null
if target!=null and GetUnitTypeId(target)!=0 and UnitAlive(target) and IsUnitType(target,UNIT_TYPE_HERO) and IsUnitIllusion(target)==false and damage>0. then
set h=GetHandleId(target)
set shield=ON7(h,"BrillianceOverflowShield")
if shield>0. then
set absorbed=RMinBJ(shield,damage*.5)
set shield=shield-absorbed
call MHDamagingEvent_SetDamage(damage-absorbed)
if shield>.01 then
call NQ7(h,"BrillianceOverflowShield",shield)
call BrillianceOverflow_ShowText(target,"护盾吸收 "+I2S(R2I(absorbed+.5))+"（剩余 "+I2S(R2I(shield+.5))+"）")
else
set e=OG7(h,"BrillianceOverflowEffect")
if e!=null then
call DestroyEffect(e)
call NN7(h,"BrillianceOverflowEffect")
endif
call RemoveSavedReal(L7,h,StringHash("BrillianceOverflowShield"))
call BrillianceOverflow_ShowText(target,"法力盈溢：护盾破碎")
endif
endif
endif
set e=null
set target=null
return false
endfunction
function BrillianceOverflow_Init takes nothing returns nothing
local trigger t=null
if BrillianceOverflowInitialized then
return
endif
set BrillianceOverflowInitialized=true
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function BrillianceOverflow_OnTick))
set t=CreateTrigger()
call TriggerAddCondition(t,Condition(function BrillianceOverflow_OnDamaging))
call MHDamagingEvent_Register(t)
set t=null
endfunction
