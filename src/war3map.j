call CFD(u,true)
endif
elseif skill=='A06D' then
call SuijiMode_InitA06D(u)
elseif skill=='A0ES' then
if OO7(GetHandleId(u),"SuijiA0ESInit")==false then
call NS7(GetHandleId(u),"SuijiA0ESInit",true)
call JDE(u,true)
endif
