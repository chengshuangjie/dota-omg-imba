function ivv takes integer Cw,integer id returns boolean
//local integer Cw=GetUnitTypeId(GetTriggerUnit())
//local integer id=B287_GetSpellAbilityId()
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000Cw为|r"+I2S(Cw))
