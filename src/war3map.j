call IV(x962,y962,radius962,filter962,function OUF)
if B946DetectCount>0 then
set B962AvoidLogical=oldLogical962
endif
if B946DetectCount>0 then
set B962AvoidPhysical=oldPhysical962
endif
if B946DetectCount>0 then
set B962AvoidSource=oldSource962
endif
endfunction
