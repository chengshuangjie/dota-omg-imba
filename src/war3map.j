	return TXX
endfunction
function OHO takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local player p = LoadPlayerHandle(TABLE_HY, h, 0)
	local integer TME = GetPlayerId(p)
	local integer OJO = Get_Item_Price(LoadInteger(TABLE_HY, h, 1))/ 2
	if LoadBoolean(TABLE_HY,h,2) then
		set OJO=Get_Item_Price(LoadInteger(TABLE_HY,h,1))-OJO
	endif
	if OJO > 0 then
		if LoadBoolean(TABLE_HY,h,2) then
		call DisplayTimedTextToPlayer(p,0,0,5,"物品出售差价已返还："+I2S(OJO)+" 金币。")
		else
		call DisplayTimedTextToPlayer(p, 0, 0, 5, "出售10秒内购入的物品,返还  |cfffffa00" + I2S(OJO)+ "|r 金钱.")
		endif
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)+ OJO)
		// call SaveInteger(TABLE_P,'ITEM', TME, 0)
		// call SaveReal(TABLE_P,'ITEM', TME, .0)
		// call SaveInteger(TABLE_P,'ITEM', TME, 0)
		// call SaveReal(TABLE_P,'ITEM', TME, .0)
	endif
	call PauseTimer(t)
	call FlushChildHashtable(TABLE_HY,h)
	call DestroyTimer(t)
	set t = null
	set p = null
endfunction
function Alreay_Use takes item it returns boolean
local integer id=GetItemTypeId(it)
if id==ZU[TC] then
if GetItemCharges(it)!=4 then
return true
endif
endif
if id==ZU[CC] then
if GetItemCharges(it)!=2 then
return true
endif
endif
return false
endfunction
function Special_Item takes integer O5,integer i,item it returns boolean
local integer buy_id=LoadInteger(TABLE_BUY,O5,i)
local integer sell_id=GetItemTypeId(it)
if buy_id=='I0AY' and sell_id==ZU[F59(M7[O5])] then 
	return true
elseif buy_id=='I0JF' and sell_id=='I0KF' then
	return true
elseif buy_id=='I08K' and sell_id=='I08L' then
	return true
elseif buy_id=='I0BA' and sell_id=='I0LC' then
	return true
elseif buy_id=='I0M9' and sell_id=='I0ME' then
	return true
//信使版
elseif buy_id=='I06D' and sell_id=='I0NN' then
	return true
elseif buy_id=='I08T' and sell_id=='I08V' then
	return true
elseif buy_id=='I00Q' and sell_id=='I00R' then
	return true
elseif buy_id=='I00Z' and sell_id=='I010' then
	return true
endif
return false
endfunction
