function XUF takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer id=GetUnitTypeId(ZX7)
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A06W')
local real d
local effect fx
if level==1 then
    set d=0.66
elseif level==2 then
    set d=0.77
elseif level==3 then
    set d=0.88
else
    set d=1.
endif
if id=='Zkee' then
    set fx=AddSpecialEffect("model\\Hero_TormentedSoul_N4S_T_Target.mdl",x,y)
    call MHEffect_SetScale(fx,d)
    call DestroyEffect(fx)
    call DestroyEffect(AddSpecialEffect("model\\Hero_TormentedSoul_N4S_T_Target_Delay.mdl",x,y))
elseif id=='Zkef' then
    set fx=AddSpecialEffect("model\\Hero_TormentedSoul_N3S_T_Target.mdl",x,y)
    call MHEffect_SetScale(fx,d)
    call DestroyEffect(fx)
    call DestroyEffect(AddSpecialEffect("model\\Hero_TormentedSoul_N3S_T_Target_Delay.mdl",x,y))
elseif id=='Zkeg' then
    set fx=AddSpecialEffect("model\\Hero_TormentedSoul_N2S_T_Target.mdl",x,y)
    call MHEffect_SetScale(fx,d)
    call DestroyEffect(fx)
    call DestroyEffect(AddSpecialEffect("model\\Hero_TormentedSoul_N2S_T_Target_Delay.mdl",x,y))    
else
    call YT7_by_scale("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl",x,y,2,d)
endif
call TerrainDeformationRippleBJ(.3,false,l,0,300,100,.4,20)
call RemoveLocation(l)
set l=null
set fx=null
endfunction
