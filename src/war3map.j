set KK2026SummerEggAnnounced[pid]=true
call VV7(bj_FORCE_ALL_PLAYERS,10.,Q[pid]+KZ4[pid]+"|r 的 |cffffcc002026暑期彩蛋|r已激活（额外+1点回蓝，+3点回血）")
