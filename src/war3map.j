	if(M7[GetPlayerId(pl)]==null)then
		call DisplayTimedTextToPlayer(p,0,0,10.,Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r 没有英雄")
	else
		if LoadReal(TABLE_HY,GetHandleId(p),'AIUN')>GetGameTime() and SPEPLAYER[GetPlayerId(p)]!=1 then
			call DisplayTextToPlayer(p,0,0, "|cFF00FF00该指令有20秒使用间隔|r")
