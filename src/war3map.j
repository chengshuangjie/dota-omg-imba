			// 		call RemoveSavedBoolean(ExtraHT, AEAttackerId[AEI], HTKEY_UNIT_DRUNKEN_BRAWLER_CS)
			// 	endif
			// endif
			// 末日头狼(25) * (2.0)
			set level=B287_GetUnitAbilityLevel(ZX7, 'A1OY')
			if level > 0 and GetPrdRandom(ZX7 , 'A1OY' , IMinBJ(25*imbaMult,100)) then
				set Damagerate=2.0
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A1OY'
				endif
			endif
			// 致死打击(9 11 13 15) * (3.0)
			// 致死打击(9 11 13 15) * (3.0)
			// 致死打击(9 11 13 15) * (3.0)
			set level=B287_GetUnitAbilityLevel(ZX7, 'ABcr')
			if level > 0 and GetPrdRandom(ZX7 , 'ABcr' , IMinBJ((7+level*2)*imbaMult,100)) then
				set Damagerate=3.0
				if LoadBoolean(TABLE_HY,EOO,StringHash("B846StackHandled")) and ZX7==WXX and IH7==YXX and IsUnitType(IH7,UNIT_TYPE_HERO)==false and IsUnitIllusion(IH7)==false and GetUnitTypeId(IH7)!='n00L' and AS7(IH7)==false then
				set Damagerate=6.0
				endif
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='ABcr'
				endif
			endif
			// 恩赐解脱(17) * (2.5 3.5 4.5)
			// 恩赐解脱(17) * (2.5 3.5 4.5)
			// 恩赐解脱(17) * (2.5 3.5 4.5)
			set level=B287_GetUnitAbilityLevel(ZX7, 'A03Q')
			if level > 0 and GetPrdRandom(ZX7 , 'A03Q' , IMinBJ(17*imbaMult,100)) then
				set Damagerate=1.5 + level * 1.0
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A03Q'
				endif
			endif
			// 混沌一击(25) * [1.25-(1.6 1.9 2.2 2.5)]
			// 混沌一击(25) * [1.25-(1.6 1.9 2.2 2.5)]
			// 混沌一击(25) * [1.25-(1.6 1.9 2.2 2.5)]
			set level=B287_GetUnitAbilityLevel(ZX7, 'A03N')
			if level > 0 and GetPrdRandom(ZX7 , 'A03N' , IMinBJ(25*imbaMult,100)) then
				set Damagerate=GetRandomReal(1.25, 1.3 + level * 0.3)
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A03N'
				endif
			endif
		endif
		// 海象神拳
		// 海象神拳
		// 海象神拳
		if WalrusPunch_IsHeroTarget(IH7) and OT7(ZX7,"WalrusPunch|Active") and OE7(GetHandleId(ZX7),"WalrusPunch|Clear")!=null then
			if value<3.5 then
			set value=3.5
			set skill='A1YQ'
			endif
		endif
        //物品暴击
        //物品暴击
        //物品暴击
        if MRPH(ZX7)==false and YSBJ_HERO(ZX7)==false then
            //水晶剑/血棘(20) * (1.75)
            set rate=XJBJ_RATE(ZX7)*100.
            if rate>0 and GetPrdRandom(ZX7 , 'I0TE' , IMinBJ(R2I(rate)*imbaMult,100)) then
                set Damagerate=1.75
                if ( value < Damagerate ) then
                    set value=Damagerate
                    set skill='I0TE'
                endif
            endif
            //大炮(30) * (2.4)
            set rate=DPBJ_RATE(ZX7)*100.
            if rate>0 and GetPrdRandom(ZX7 , 'I0A3' , IMinBJ(R2I(rate)*imbaMult,100)) then
                set Damagerate=2.4
                if ( value < Damagerate ) then
                    set value=Damagerate
                    set skill='I0A3'
                endif
            endif   
        endif
	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
	// 	// 精灵狼 30% 1.7
	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
	// 		set Damagerate=1.7
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='A03B'
	// 		endif
	// 	endif
	// endif
	// 暴击数值 > 0. 则播放暴击动画
	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
	// 	// 精灵狼 30% 1.7
	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
	// 		set Damagerate=1.7
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='A03B'
	// 		endif
	// 	endif
	// endif
	// 暴击数值 > 0. 则播放暴击动画
	// elseif not (HaveSavedHandle(ExtraHT, GetHandleId((ZX7)), HTKEY_UNIT_BREAK)) then
	// 	// 头狼和巨狼 20% 2
	// 	set level=GetUnitAbilityLevel(ZX7, 'ACct')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'ACct' , 20) then
	// 		set Damagerate=2.
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='ACct'
	// 		endif
	// 	endif
	// 	// 精灵狼 30% 1.7
	// 	set level=GetUnitAbilityLevel(ZX7, 'A03B')
	// 	if level > 0 and GetPrdRandom(ZX7 , 'A03B' , 30) then
	// 		set Damagerate=1.7
	// 		if ( value < Damagerate ) then
	// 			set value=Damagerate
	// 			set skill='A03B'
	// 		endif
	// 	endif
	// endif
	// 暴击数值 > 0. 则播放暴击动画
	if value > 0. and isMelee then
		call SetUnitAnimation(ZX7, "Attack slam")
		call QueueUnitAnimation(ZX7, "Stand Ready")
	endif
	call SaveReal(ExtraHT, 'bjbs', GetHandleId(ZX7), value) //记录暴击倍数
	call SaveInteger(ExtraHT, 'bjsk', GetHandleId(ZX7), skill)  //记录暴击技能
	return value //返回暴击倍数
endfunction
function MNBJ takes unit ZX7,unit IH7,real YM7,boolean ISMNGJ returns nothing
    local real Damagerate=0.
local integer skill=0
        if IsUnitType(IH7, UNIT_TYPE_STRUCTURE) then
            return
        endif
        if B846_IsStackOwner(ZX7)==false and IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) and ISMNGJ==false then //如果是近战单位并且不是模拟攻击
            set Damagerate=LoadReal(ExtraHT, 'bjbs', GetHandleId(ZX7))  //读取暴击倍数
        else
            set Damagerate=SetUnitCriticalStrike(ZX7,IH7,false)  //否则判断是否暴击并获取倍数
        endif
        if Damagerate>0 then //如果暴击倍数大于0
if skill==0 then
            set skill=LoadInteger(ExtraHT, 'bjsk', GetHandleId(ZX7))
endif
            if skill=='ABcr' then
                call ZSDJBJ(ZX7, IH7, YM7, Damagerate)
            elseif skill=='A03Q' then
                call ECJTBJ(ZX7, IH7, YM7, ISMNGJ, Damagerate)
            elseif skill=='A03N' then
                call HDYJBJ(ZX7, IH7, YM7, Damagerate)
          elseif skill=='A1YQ' then
              if OE7(GetHandleId(ZX7),"WalrusPunch|Clear")!=null then
                  call TriggerEvaluate(OE7(GetHandleId(ZX7),"WalrusPunch|Clear"))
              endif
              call HXSQ(ZX7, IH7)
              call WalrusPunch_ApplyNoArmorCritical(ZX7,IH7,YM7,Damagerate,ISMNGJ)
elseif skill=='A0MX' then
call MNBJ_Normal(ZX7,IH7,YM7,Damagerate,ISMNGJ)
call YW7("醉拳!",5,IH7,.024,255,110,70,255)
            else
                call MNBJ_Normal(ZX7,IH7,YM7,Damagerate,ISMNGJ)
            endif
        endif
endfunction
function SuijiMode_HasRandomAttackCritical takes unit suijiCriticalUnit returns boolean
local integer suijiCriticalHandle=0
if SUIJI_MODE==false or suijiCriticalUnit==null or GetUnitTypeId(suijiCriticalUnit)==0 then
return false
endif
set suijiCriticalHandle=GetHandleId(suijiCriticalUnit)
if OO7(suijiCriticalHandle,"SuijiDone")==false and IsUnitIllusion(suijiCriticalUnit)==false then
return false
endif
return B287_GetUnitAbilityLevel(suijiCriticalUnit,'ABcr')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A03Q')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A03N')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A00K')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A2PX')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A1OY')>0 or B287_GetUnitAbilityLevel(suijiCriticalUnit,'A1YQ')>0
endfunction
function MNBJ_PD takes nothing returns nothing
	if LoadBoolean(TABLE_HY,EOO,StringHash("B846StackHandled")) then
		return
	endif
	//非建筑非守卫的敌对单位且是模拟暴击英雄
	if LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and (YSBJ_HERO(WXX)==false or SuijiMode_HasRandomAttackCritical(WXX)) and (IsUnitType(WXX, UNIT_TYPE_HERO) or IsUnitIllusion(WXX) or AS7(WXX) ) then
		call MNBJ(WXX,YXX,ZXX,false)
	endif
endfunction
function Get_HUIXUE takes unit u returns string
local integer D09=GetItemCharges(MV7(u,ZU[DI4]))
local real d
set d=MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN)
if D09>0 then
set d=d+D09*.5
endif
if GetUnitAbilityLevel(u,'B0I9')>0 then
set d=d+16
elseif GetUnitAbilityLevel(u,'B0I8')>0 then
set d=d+8
elseif GetUnitAbilityLevel(u,'B0I7')>0 then
set d=d+4
elseif GetUnitAbilityLevel(u,'B0HO')>0 then
set d=d+2
endif
if GetUnitTypeId(u)=='H00Q' or (SUIJI_MODE and IsUnitIllusion(u)==false and OO7(GetHandleId(u),"SuijiDone") and B287_GetUnitAbilityLevel(u,'A0QQ')>0) then
    set d=d+LoadReal(ExtraHT, 'A0QQ', GetHandleId(u))
endif
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0)+3)
endfunction
function Get_HUILAN takes unit u returns string
local integer D09=GetItemCharges(MV7(u,ZU[DI4]))
local real d
set d=MHUnit_GetData(u,UNIT_DATA_MANA_REGEN)
if D09>0 then
set d=d+D09
endif
if GetUnitAbilityLevel(u,'B0I9')>0 then
set d=d+8
elseif GetUnitAbilityLevel(u,'B0I8')>0 then
set d=d+4
elseif GetUnitAbilityLevel(u,'B0I7')>0 then
set d=d+2
elseif GetUnitAbilityLevel(u,'B0HO')>0 then
set d=d+1
endif
set d=d+Get_Bingnv_Huilan(u)*4
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0)+3)
endfunction
function Get_MNBJ_Rate takes unit ZX7 returns string
local real a=SKBJ_RATE(ZX7)
local real b=DPBJ_RATE(ZX7)
local real c=XJBJ_RATE(ZX7)
local string VH=R2S((c-a*c-b*c+a*b*c+a+b-a*b)*100.)
set VH=MHString_Sub(VH , 0 , MHString_Find(VH , "." , 0))
return VH
endfunction
function Get_WLXX takes unit ZX7 returns string
local string VH=R2S((B4R(ZX7)+B4R_XXGH(ZX7))*100)
return MHString_Sub(VH , 0 , MHString_Find(VH , "." , 0))
endfunction
function Get_FSXX takes unit ZX7 returns string
local real d=DGH_BUFF(ZX7)
if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
    set d=25.*d
else
    set d=0.
endif
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0))
endfunction
function Get_FSZQ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A4DJ')>0 or GetUnitAbilityLevel(ZX7,'A4DZ')>0 then
    set d=5*(GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ'))
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A4H2')>0 then
	set d=d+18
elseif GetUnitAbilityLevel(ZX7,'A2YK')>0 then
    set d=d+15
elseif GetUnitAbilityLevel(ZX7,'A4H0')>0 then
    set d=d+10
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
    set d=d+5
endif
return I2S(d)
endfunction
function Get_FJZJ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A4DJ')>0 or GetUnitAbilityLevel(ZX7,'A4DZ')>0 then
    set d=50*(GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ'))
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
    set d=d+200
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
    set d=d+150
endif
return I2S(d)
endfunction
function Get_LQSJ takes unit ZX7 returns string
local integer d
if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
    set d=25
else
    set d=0
endif
if GetUnitAbilityLevel(ZX7,'A2YR')>0 then
    set d=d+8
endif
if B287_GetUnitAbilityLevel(ZX7,'A10Q')>0 then
    set d=R2I(d+(100-d)*(0.125+0.125*B287_GetUnitAbilityLevel(ZX7,'A10Q')))
endif
return I2S(d)
endfunction
function Get_MFKX takes unit ZX7 returns string
local real d=0
local real d1=0
local real d2=0
if Have_Item(ZX7,ZU[EZB]) then
    set d1=.4
elseif Have_Item(ZX7,ZU[R06]) or Have_Item(ZX7,ZU[DJ4]) or Have_Item(ZX7,ZU[DV4]) then
    set d1=.3
elseif Have_Item(ZX7,ZU[RX]) or Have_Item(ZX7,ZU[R0A]) or Have_Item(ZX7,ZU[it_hzpf]) then
    set d1=.15
endif
if GetUnitAbilityLevel(ZX7,'ZAMR')>0 then
    set d2=(18+GetUnitAbilityLevel(ZX7,'ZAMR')*8)*.01
elseif B287_GetUnitAbilityLevel(ZX7,'A0VX')>0 then
    set d2=Get_LWDP_MK(ZX7)
elseif B287_GetUnitAbilityLevel(ZX7,'A0MM')>0 then
    set d2=(5+B287_GetUnitAbilityLevel(ZX7,'A0MM')*5)*.01
elseif B287_GetUnitAbilityLevel(ZX7,'A06D')>0 then
    set d2=(4+B287_GetUnitAbilityLevel(ZX7,'A06D')*2)*.01
endif
set d=(1-(1-.25)*(1-d1)*(1-d2))*100
return MHString_Sub(R2S(d) , 0 , MHString_Find(R2S(d) , "." , 0))
endfunction
function Get_Unit_State takes unit u,string s returns string
if s=="生命" then
return "|cFF00FF00"+I2S(R2I(GetUnitState(u,UNIT_STATE_LIFE)))+"|r/|cFF00FF00"+I2S(R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE)))+"|r (|cFF00FF00+"+Get_HUIXUE(u)+"|r)"
elseif s=="魔法" then
return "|cff87cefa"+I2S(R2I(GetUnitState(u,UNIT_STATE_MANA)))+"|r/|cff87cefa"+I2S(R2I(GetUnitState(u,UNIT_STATE_MAX_MANA)))+"|r (|cff87cefa+"+Get_HUILAN(u)+"|r)"
elseif s=="攻击速度" then
return "|c00fffc01"+I2S(R2I(GetUnitState(u, UNIT_STATE_ATTACK1_SPEED)*100))+"|r"
elseif s=="攻击间隔" then
return "|c00fffc01"+R2S(GetUnitState(u, UNIT_STATE_ATTACK1_COOL)/RMinBJ(GetUnitState(u, UNIT_STATE_ATTACK1_SPEED),MHUnit_GetAttackSpeedLimit(u)))+"|r 秒/次"
elseif s=="物理吸血" then
return "|c00fffc01"+Get_WLXX(u)+"|r%"
elseif s=="法术吸血" then
return "|c00fffc01"+Get_FSXX(u)+"|r%"
elseif s=="法术增强" then
return "|c00fffc01"+Get_FSZQ(u)+"|r%"
elseif s=="法距增加" then
return "|c00fffc01"+Get_FJZJ(u)+"|r"
elseif s=="冷却缩减" then
return "|c00fffc01"+Get_LQSJ(u)+"|r%"
elseif s=="魔法抗性" then
return "|c00fffc01"+Get_MFKX(u)+"|r%"
elseif s=="暴击率" then
return "|c00fffc01"+Get_MNBJ_Rate(u)+"|r%"
elseif s=="闪避率" then
return "|c00fffc01"+I2S(GetUnitMissProbability(u))+"|r%"
elseif s=="移动速度" then
return "|c00fffc01"+I2S(R2I(.5+U6V(u)))+"|r"
endif  
return ""
endfunction
function JSS takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)
local string HEROSTATE
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
// if MHAbility_GetCastpoint(u,'A4DV')!=.01 then
//     call MHAbility_SetCastpoint(u,'A4DV',.01)
// endif
set HEROSTATE="|cffff8000  ★【"+GetUnitName(u)+"】★|r"
set HEROSTATE=HEROSTATE+"\n生命:  "+Get_Unit_State(u,"生命")
set HEROSTATE=HEROSTATE+"\n魔法:  "+Get_Unit_State(u,"魔法")
set HEROSTATE=HEROSTATE+"\n攻击速度:  "+Get_Unit_State(u,"攻击速度")
set HEROSTATE=HEROSTATE+"\n攻击间隔:  "+Get_Unit_State(u,"攻击间隔")
set HEROSTATE=HEROSTATE+"\n物理吸血:  "+Get_Unit_State(u,"物理吸血")
set HEROSTATE=HEROSTATE+"\n法术吸血:  "+Get_Unit_State(u,"法术吸血")
set HEROSTATE=HEROSTATE+"\n法术增强:  "+Get_Unit_State(u,"法术增强")
set HEROSTATE=HEROSTATE+"\n法距增加:  "+Get_Unit_State(u,"法距增加")
set HEROSTATE=HEROSTATE+"\n冷却缩减:  "+Get_Unit_State(u,"冷却缩减")
set HEROSTATE=HEROSTATE+"\n魔法抗性:  "+Get_Unit_State(u,"魔法抗性")
set HEROSTATE=HEROSTATE+"\n暴击率:  "+Get_Unit_State(u,"暴击率")
set HEROSTATE=HEROSTATE+"\n闪避率:  "+Get_Unit_State(u,"闪避率")
set HEROSTATE=HEROSTATE+"\n移动速度:  "+Get_Unit_State(u,"移动速度")
call DisplayTimedTextToPlayer(p,0,0,10, HEROSTATE)
set p=null
set u=null
endfunction
function YCR takes nothing returns boolean
	local unit fu = GetEnumUnit()
	local real N5X = KE7(fu, YQAL)
	if N5X < YQCL then
		set YQCL = N5X
		set YQNL = fu
	endif
	set fu = null
	return false
endfunction
function YCR_PD2 takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local integer id=GetHandleId(fu)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) then
	set fu=null
	return true
	endif
	set fu=null
	return false
endfunction
function YCR_PD1 takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local integer id=GetHandleId(fu)
	local integer YRTS1=LoadInteger(TABLE_P,YQJBID,101)
	local integer YRTS2=LoadInteger(TABLE_P,YQJBID,102)
	local integer YRTS3=LoadInteger(TABLE_P,YQJBID,103)
	local integer YRTS4=LoadInteger(TABLE_P,YQJBID,104)
	local integer YRTS5=LoadInteger(TABLE_P,YQJBID,105)
	local integer YRTS6=LoadInteger(TABLE_P,YQJBID,106)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) and (id!=YRTS1 and id!=YRTS2 and id!=YRTS3 and id!=YRTS4 and id!=YRTS5 and id!=YRTS6) then
	set fu=null
	return true
	endif
	set fu=null
	return false
endfunction
function YBR takes nothing returns boolean
	local unit fu = GetFilterUnit()
	local real N5X = KE7(fu, YQAL)
	if fu != YQAL and IsUnitEnemy(fu, GetOwningPlayer(YQIL)) and UnitAlive(fu) and AE7(fu)==false and N5X < YQCL and(GetUnitAbilityLevel(fu,'A04R')== 0) and GetUnitAbilityLevel(fu,'Avul')== 0 and lWA(fu, GetOwningPlayer(YQIL)) and IsUnitInRangeXY(fu, GetUnitX(YQAL), GetUnitY(YQAL), 510) then
		set YQCL = N5X
		set YQNL = fu
	endif
	set fu = null
	return false
endfunction
function YDR takes nothing returns nothing
	local group g=null
	local trigger missileTrigger=GetTriggeringTrigger()
	local trigger t=null
	local timer chainTimer=LoadTimerHandle(TABLE_HY,GetHandleId(missileTrigger),StringHash("B582BounceChain"))
	local integer chainHandle=0
	local integer UYX=0
	local unit u=null
	local unit target = W22
	local real ZCE=0.
	local integer YR_unit
	local integer id=0
	local boolexpr firstFilter=null
	local boolexpr fallbackFilter=null
	if chainTimer==null then
		set target=null
		set missileTrigger=null
		return
	endif
	set chainHandle=GetHandleId(chainTimer)
	set u=LoadUnitHandle(TABLE_P,chainHandle,0)
	if u==null or GetUnitTypeId(u)==0 or target==null or GetUnitTypeId(target)==0 then
		call B582_DestroyBounceChain(chainTimer)
		set u=null
		set target=null
		set missileTrigger=null
		set chainTimer=null
		return
	endif
	set UYX=LoadInteger(TABLE_P,chainHandle,3)-1
	set ZCE=LoadReal(TABLE_P,chainHandle,6)
	set id=GetUnitTypeId(u)
	set YQJBID=chainHandle
	call B67(u, target, 2, ZCE)
	if UYX > 0 then
		set YQAL = target
		set YQIL = u
		set YQCL = 9999
		set YQNL = null
		set g = WS7()
		//优先选取没被弹射过的单位，否则选取最近的单位
		set firstFilter=Condition(function YCR_PD1)
		call GroupEnumUnitsInRange(g,GetUnitX(target),GetUnitY(target),500,firstFilter)
		call DestroyBoolExpr(firstFilter)
		set firstFilter=null
		if CountUnitsInGroup(g)==0 then
			set fallbackFilter=Condition(function YCR_PD2)
			call GroupEnumUnitsInRange(g,GetUnitX(target),GetUnitY(target),500,fallbackFilter)
			call DestroyBoolExpr(fallbackFilter)
			set fallbackFilter=null
		endif
		call ForGroup(g,function YCR)
		call WR7(g)
		set g = null
		if YQNL != null then
			if id=='Z005' then
				set YR_unit='h0GI'
			elseif id=='Z105' then
				set YR_unit='h0GJ'
			elseif id=='Z205' then
				set YR_unit='h0GK'
			else
				set YR_unit='h0GH'
			endif
			set t=NHX_TANSHE(u,target,YQNL,YR_unit,"YDR",880,true,"")
			call SaveTimerHandle(TABLE_HY,GetHandleId(t),StringHash("B582BounceChain"),chainTimer)
			call SaveInteger(TABLE_P,chainHandle,3,UYX)
			call SaveReal(TABLE_P,chainHandle,6,ZCE*.65)
			call SaveInteger(TABLE_P,chainHandle,107-UYX,GetHandleId(YQNL))
			set t = null
		else
			call B582_DestroyBounceChain(chainTimer)
		endif
	else
		call B582_DestroyBounceChain(chainTimer)
	endif
	set g = null
	set u = null
	set target = null
	set missileTrigger=null
	set chainTimer=null
	set firstFilter=null
	set fallbackFilter=null
endfunction
function YFR takes unit u, unit target, real d returns nothing
	local group g = WS7()
	local boolexpr initialFilter=null
	local trigger t = null
	local timer chainTimer=null
	local integer chainHandle=0
	local integer BC7=B287_GetUnitAbilityLevel(u,'A041')
	local integer id=GetUnitTypeId(u)
	local integer YR_unit
	if BC7==4 then
		set BC7=5
	endif
	if id=='Z005' then
		set YR_unit='h0GI'
	elseif id=='Z105' then
		set YR_unit='h0GJ'
	elseif id=='Z205' then
		set YR_unit='h0GK'
	else
		set YR_unit='h0GH'
	endif
	set YQAL = target
	set YQIL = u
	set YQCL = 9999
	set YQNL = null
	set initialFilter=Condition(function YBR)
	call GroupEnumUnitsInRange(g,GetUnitX(target),GetUnitY(target),500,initialFilter)
	call DestroyBoolExpr(initialFilter)
	set initialFilter=null
	call WR7(g)
	set g = null
	if YQNL != null then
		set chainTimer=CreateTimer()
		set chainHandle=GetHandleId(chainTimer)
		call SaveUnitHandle(TABLE_P,chainHandle,0,u)
		call SaveInteger(TABLE_P,chainHandle,3,BC7)
		call SaveInteger(TABLE_P,chainHandle,101,GetHandleId(target))
		call SaveInteger(TABLE_P,chainHandle,102,GetHandleId(YQNL))
		if not IsUnitIllusion(u) then
			set d=GetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BONUS)
		endif
		call SaveReal(TABLE_P,chainHandle,6,d*.65)
		call TimerStart(chainTimer,15.,false,function B582_BounceChainTimeout)
		set t = NHX_TANSHE(u, target, YQNL,YR_unit, "YDR", 880, true, "")
		call SaveTimerHandle(TABLE_HY,GetHandleId(t),StringHash("B582BounceChain"),chainTimer)
		set t = null
	endif
	set chainTimer=null
	set initialFilter=null
endfunction
function SBA takes nothing returns nothing	//月刃
	//任意敌对单位
	if B287_GetUnitAbilityLevel(WXX,'A041')>0 and LoadBoolean(TABLE_HY, EOO, 15) then
			call YFR(WXX, YXX, ZXX)
	endif
endfunction
function Get_Same_Item_Rate takes unit u,integer it,real rate returns real
local integer n=Have_Item_Quantity(u,it)
local integer i=1
local real d=1.
if n>0 then
loop
exitwhen i>n
set d=d * (1.-rate)
set i=i+1
endloop
endif
return  1. - d
endfunction
function Get_Dianchui_Skill takes unit ZX7 returns integer
	local real rate= 0.
	local integer skill= 0
	if MRPH(ZX7)==false then
		//漩涡 25
		set rate=Get_Same_Item_Rate(ZX7,LL,.25)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A0FK' , rate) then
			set skill='A0FK'
		endif
		//FLS 25
		set rate=Get_Same_Item_Rate(ZX7,it_fls,.25)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A4E8' , rate) then
			set skill='A4E8'
		endif   
		//大电 30
		set rate=Get_Same_Item_Rate(ZX7,it_dadianchui,.3)*100.
		if rate>0 and GetPrdRandom(ZX7 , 'A0JK' , rate) then
			set skill='A0JK'
		endif   
	endif
	return skill
endfunction
function B1O takes unit R8X, unit WLE returns nothing
	local unit W_V
    local integer skill=Get_Dianchui_Skill(R8X)
    if skill>0 then
		set W_V = CreateUnit(GetOwningPlayer(R8X),'e00E', GetUnitX(R8X), GetUnitY(R8X), 0)
		call UnitAddAbility(W_V, skill)
		call B947IssueTargetOrderById("B1O @ war3map.j:216117 (B968)",W_V,$D0097, WLE)
		call UnitApplyTimedLife(W_V,'BTLF',1.)
    endif
		set W_V = null
endfunction
function X8O takes nothing returns nothing	//雷神之锤、漩涡
	if IsUnitType(YXX, UNIT_TYPE_STRUCTURE)== false and IsUnitEnemy(YXX, GetOwningPlayer(WXX)) and(GetUnitAbilityLevel(WXX,'A0JH')> 0 or GetUnitAbilityLevel(WXX,'A0FJ')> 0 or GetUnitAbilityLevel(WXX,'A4E5')> 0) then
		call B1O(WXX, YXX)
	endif
endfunction
// B1114: port the 16 OMG debit-before-damage order without a persistent mana cache.
// Return the actual debit; native mana callbacks may invalidate either participant.
function B1114DebitMana takes unit burnSource1114,unit burnTarget1114,real burnRequest1114 returns real
    local real burnMana1114=0.
    local real burnAmount1114=0.
    if burnSource1114==null or burnTarget1114==null or not (burnRequest1114>0.) then
        return 0.
    endif
    if GetUnitTypeId(burnSource1114)==0 or GetUnitTypeId(burnTarget1114)==0 or not UnitAlive(burnTarget1114) then
        return 0.
    endif
    if IsMagicImmuneUnit(burnTarget1114) then
        return 0.
    endif
    set burnMana1114=GetUnitState(burnTarget1114,UNIT_STATE_MANA)
    if not (burnMana1114>0.) then
        return 0.
    endif
    set burnAmount1114=RMinBJ(burnMana1114,burnRequest1114)
    call SetUnitState(burnTarget1114,UNIT_STATE_MANA,RMaxBJ(0.,burnMana1114-burnAmount1114))
    return burnAmount1114
endfunction
function B2O takes unit ZX7, unit IH7, real d returns nothing
    local integer burnSourceType1082=0
    local string tx="Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl"
    // Debit while the hit target is still valid, before additional damage callbacks.
    // Keep the map's existing independent physical-damage routing and coefficients.
    set d=B1114DebitMana(ZX7,IH7,d)
    if not (d>0.) then
        return
    endif
    if GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(IH7) then
        return
    endif
    if IsMagicImmuneUnit(IH7) then
        return
    endif
    set burnSourceType1082=GetUnitTypeId(ZX7)
    if burnSourceType1082=='Zgem' then
        set tx="model\\Hero_Anti-Mage_N5S_R_Target.mdl"
    elseif burnSourceType1082=='Zhem' then
        set tx="model\\Hero_Anti-Mage_N11S_R_Target.mdl"
    endif
    call B67(ZX7,IH7,2,d)
    // Do not write mana after damage. Shield/nested-burn costs remain authoritative.
    if GetUnitTypeId(IH7)!=0 and UnitAlive(IH7) then
        call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"origin"))
    endif
endfunction
function FYR takes nothing returns nothing
	local real mana1
	local real mana2
	local unit burnAttacker1114=WXX
	local unit burnVictim1114=YXX
	local integer burnRank1114=0
	if burnAttacker1114!=null and burnVictim1114!=null and GetUnitTypeId(burnAttacker1114)!=0 and GetUnitTypeId(burnVictim1114)!=0 and UnitAlive(burnVictim1114) then
	set burnRank1114=B287_GetUnitAbilityLevel(burnAttacker1114,'A022')
	if ISPH(burnAttacker1114)==false and burnRank1114>0 and IsUnitEnemy(burnAttacker1114,GetOwningPlayer(burnVictim1114)) and GetUnitState(burnVictim1114,UNIT_STATE_MANA)>0 then
		set mana1=16 + 12 * burnRank1114
		set mana2=(0.005 + burnRank1114 * 0.005) * GetUnitState(burnVictim1114,UNIT_STATE_MAX_MANA)
		if MV7(burnAttacker1114,ZU[ANEW23])!=null or SuijiMode_ScepterRegistryIsActive(burnAttacker1114,'A022') then
			set mana2=mana2 * 1.2
		endif
		call B2O(burnAttacker1114,burnVictim1114,mana1 + mana2)
	endif
	endif
	set burnAttacker1114=null
	set burnVictim1114=null
endfunction
//破隐一击
function ODO takes nothing returns nothing
	if LoadBoolean(TABLE_HY, EOO, 20) then
		if IsMagicImmuneUnit(YXX) == false then
			if IsUnitType(YXX,UNIT_TYPE_HERO) or AS7(YXX) or IsUnitIllusion(YXX) then
				call Z57(YXX , 'A4G4' , 1 , 5. , 'B0JW')
			endif
			call ZAA8(YXX)
		endif
		call RemoveSavedBoolean(TABLE_HY, EOO, 20)
	endif
endfunction
function B4O takes unit ZX7, unit IH7, integer level returns nothing
	local real mana1
	local real mana2
	local real mana3
	if level==1 then
		set mana1=25.
		set mana2=15.
		set mana3=10.
    elseif level==2 then
		set mana1=40.
		set mana2=20.
		set mana3=10.
    elseif level==3 then
        set mana1=50.
        set mana2=25.
        set mana3=15.
	endif
	if IsUnitIllusion(ZX7)==false then	//非镜像
		call B2O(ZX7, IH7, mana1)
	elseif IsUnitIllusion(ZX7) and IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) then //近战幻象
		call B2O(ZX7, IH7, mana2)
	elseif IsUnitIllusion(ZX7) and IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER)==false then //远程幻象
		call B2O(ZX7, IH7, mana3)
	endif
endfunction
function OWO takes nothing returns nothing	//净魂之刃
	local unit diffusalAttacker1114=WXX
	local unit diffusalVictim1114=YXX
	if diffusalAttacker1114!=null and diffusalVictim1114!=null and GetUnitTypeId(diffusalAttacker1114)!=0 and GetUnitTypeId(diffusalVictim1114)!=0 and UnitAlive(diffusalVictim1114) then
	if IsUnitEnemy(diffusalAttacker1114,GetOwningPlayer(diffusalVictim1114)) and GetUnitState(diffusalVictim1114,UNIT_STATE_MANA)>0 then
        if GetUnitAbilityLevel(diffusalAttacker1114,'A4DU')> 0 then
            call B4O(diffusalAttacker1114,diffusalVictim1114,3)
        elseif GetUnitAbilityLevel(diffusalAttacker1114,'A4BO')> 0 then
			call B4O(diffusalAttacker1114,diffusalVictim1114,2)
		elseif GetUnitAbilityLevel(diffusalAttacker1114,'A4BN')> 0 then
			call B4O(diffusalAttacker1114,diffusalVictim1114,1)
		endif
	endif
	endif
	set diffusalAttacker1114=null
	set diffusalVictim1114=null
endfunction
function JJ_JM takes unit IH7 returns nothing	//寂灭
	call UnitRemoveAbility(IH7,'A3K4')
	call UnitRemoveAbility(IH7,'A3K5')
    call UnitRemoveAbility(IH7,'A4KH')
    call UnitRemoveAbility(IH7,'A4KI')
	call UnitRemoveAbility(IH7,'A3K2')
	call UnitRemoveAbility(IH7,'A3K3')
	call Z57(IH7,'A3K6', 1, 7, 0)
	call Z57(IH7,'A3K7', 1, 7,'B2XX')
endfunction
function JJ_AM takes unit IH7 returns nothing	//黯灭
		call UnitRemoveAbility(IH7,'A3K4')
		call UnitRemoveAbility(IH7,'A3K5')
		call UnitRemoveAbility(IH7,'A4KH')
		call UnitRemoveAbility(IH7,'A4KI')
	if GetUnitAbilityLevel(IH7,'B2XX')==0 then
		call Z57(IH7,'A3K2', 1, 7, 0)
		call Z57(IH7,'A3K3', 1, 7,'BIcb')
	endif
endfunction
function JJ_BFCJ takes unit IH7 returns nothing	//暴风长戟
    call UnitRemoveAbility(IH7,'A3K4')
    call UnitRemoveAbility(IH7,'A3K5')
if GetUnitAbilityLevel(IH7,'BIcb')==0 and GetUnitAbilityLevel(IH7,'B2XX')==0 then
    call Z57(IH7,'A4KH', 1, 7, 0)
    call Z57(IH7,'A4KI', 1, 7,'B0KK')
endif
endfunction
function JJ_KWZS takes unit IH7 returns nothing	//枯萎之石
	if GetUnitAbilityLevel(IH7,'BIcb')==0 and GetUnitAbilityLevel(IH7,'B2XX')==0 and GetUnitAbilityLevel(IH7,'B0KK')==0 then
		call Z57(IH7,'A3K4', 1, 5, 0)
		call Z57(IH7,'A3K5', 1, 5,'B0HI')
	endif
endfunction
function JJ_PD takes unit ZX7,unit IH7 returns nothing
	if GetUnitAbilityLevel(ZX7,'A2XX')> 0 then
		call JJ_JM(IH7)
	elseif GetUnitAbilityLevel(ZX7,'AIcb')> 0 then
		call JJ_AM(IH7)
	elseif GetUnitAbilityLevel(ZX7,'A4KG')> 0 then
		call JJ_BFCJ(IH7)
	elseif GetUnitAbilityLevel(ZX7,'A2XJ')> 0 then
		call JJ_KWZS(IH7)	
	endif
endfunction
function ORO takes nothing returns nothing	//黯灭
	if IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and (GetUnitAbilityLevel(WXX,'A2XX')>0 or GetUnitAbilityLevel(WXX,'AIcb')>0 or GetUnitAbilityLevel(WXX,'A2XJ')>0 or GetUnitAbilityLevel(WXX,'A4KG')>0) then
		call JJ_PD(WXX,YXX)
	endif
endfunction
function SuijiMode_IsBiteSourceIllusion takes unit u returns boolean
local unit ownerHero=null
local boolean result=false
if u!=null and GetUnitTypeId(u)!=0 and IsUnitIllusion(u) then
set ownerHero=M7[GetPlayerId(GetOwningPlayer(u))]
if ownerHero!=null and GetUnitTypeId(ownerHero)!=0 then
set result=SuijiMode_HasChosenBite(ownerHero)
endif
endif
set ownerHero=null
return result
endfunction
function SuijiMode_IsBiteOwnedSecondaryUnit takes unit u returns boolean
local unit ownerHero=null
local boolean result=false
if u!=null and GetUnitTypeId(u)!=0 then
set ownerHero=M7[GetPlayerId(GetOwningPlayer(u))]
if ownerHero!=null and GetUnitTypeId(ownerHero)!=0 and ownerHero!=u then
set result=SuijiMode_HasChosenBite(ownerHero)
endif
endif
set ownerHero=null
return result
endfunction
// Illusions reach attack tier 0 reliably, while tiers 1-4 are gated by the
// original damage pipeline.  Apply this attack-event passive here and repeat
// the tier-3 eligibility checks explicitly, so illusion inheritance does not
// depend on a later event tier being reached.
function SuijiMode_ApplyIllusionBiteDirect takes nothing returns nothing
local integer level=0
local integer h=0
local integer count=0
local string reason=""
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false or SuijiMode_IsBiteSourceIllusion(WXX)==false then
return
endif
set level=SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0BK')
if IsUnitType(YXX,UNIT_TYPE_STRUCTURE) then
set reason="structure"
elseif GetUnitAbilityLevel(YXX,'A04R')>0 then
set reason="ward"
elseif IsUnitEnemy(YXX,GetOwningPlayer(WXX))==false then
set reason="ally"
elseif ISPH(WXX) then
set reason="isph"
elseif level<=0 then
set reason="level0"
endif
if reason=="" then
call Z57(YXX,'A3PV'-1+level,1,4,'B01D')
call EnableAttackEffectByTime(9,4.5)
if SUIJI_LOG then
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteDirectLog")
if count<3 then
call NP7(h,"SuijiIllusionBiteDirectLog",count+1)
call SuijiTest_DebugAll("ILLBITE-DIRECT-APPLY","illusion="+GetUnitName(WXX)+" level="+I2S(level)+" physical="+I2S(B287_GetUnitAbilityLevel(WXX,'A0BK'))+" target="+GetUnitName(YXX))
endif
endif
elseif SUIJI_LOG then
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteDirectLog")
if count<3 then
call NP7(h,"SuijiIllusionBiteDirectLog",count+1)
call SuijiTest_DebugAll("ILLBITE-DIRECT-BLOCK","illusion="+GetUnitName(WXX)+" reason="+reason+" level="+I2S(level)+" target="+GetUnitName(YXX))
endif
endif
endfunction
function SuijiMode_ApplyIllusionGhoulFrenzyDirect takes nothing returns nothing
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
if ISPH(WXX)==false and LoadBoolean(TABLE_HY,EOO,11)==false and LoadBoolean(TABLE_HY,EOO,14) and LoadBoolean(TABLE_HY,EOO,15) and SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A4EU')>0 and WF7(YXX)==false then
call XGZN(WXX,YXX)
endif
endfunction
function SuijiMode_ApplyIllusionGreaterBashDirect takes nothing returns nothing
if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0G5')>0 and IsUnitType(YXX,UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(YXX,GetOwningPlayer(WXX)) and GetRandomInt(1,100)<=17 and OT7(WXX,"pIv")==false and ISPH(WXX)==false and GetUnitAbilityLevel(YXX,'A4IF')==0 then
call JIE(WXX,YXX,false,false)
endif
endfunction
function SuijiMode_IllusionPassiveAttackFallback takes nothing returns nothing
local unit source=null
local integer h=0
local integer attempts=0
if WXX==null or GetUnitTypeId(WXX)==0 or IsUnitIllusion(WXX)==false then
return
endif
set source=M7[GetPlayerId(GetOwningPlayer(WXX))]
if source==null or GetUnitTypeId(source)==0 or source==WXX or OO7(GetHandleId(source),"SuijiDone")==false then
set source=null
return
endif
set h=GetHandleId(WXX)
if OO7(h,"SuijiIllusionPassivesCopied")==false then
set attempts=OM7(h,"SuijiIllusionPassiveCopyAttempts")
if attempts<3 then
call NP7(h,"SuijiIllusionPassiveCopyAttempts",attempts+1)
call SuijiMode_CopyChosenPassivesToIllusion(source,WXX)
endif
endif
if SuijiMode_HasChosenBite(source) then
call SuijiMode_ApplyIllusionBiteDirect()
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A4EU')>0 then
call SuijiMode_ApplyIllusionGhoulFrenzyDirect()
endif
if SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0G5')>0 then
call SuijiMode_ApplyIllusionGreaterBashDirect()
endif
set source=null
endfunction
function SuijiMode_DebugIllusionBiteAttackEvent takes nothing returns nothing
local integer h=0
local integer count=0
if SUIJI_LOG==false or SuijiMode_IsBiteSourceIllusion(WXX)==false then
return
endif
set h=GetHandleId(WXX)
set count=OM7(h,"SuijiIllusionBiteEventLog")
if count>=3 then
return
endif
call NP7(h,"SuijiIllusionBiteEventLog",count+1)
call SuijiTest_DebugAll("ILLBITE-EVENT","illusion="+GetUnitName(WXX)+" y03q="+I2S(GetUnitAbilityLevel(WXX,'Y03Q'))+" logical="+I2S(B287_GetUnitAbilityLevel(WXX,'A0BK'))+" isph="+SuijiMode_DebugBoolText(ISPH(WXX))+" ward="+SuijiMode_DebugBoolText(GetUnitAbilityLevel(YXX,'A04R')>0))
endfunction
function HWI takes nothing returns nothing  //麻痹之咬
	local integer biteLevel=0
	if SuijiMode_IsBiteSourceIllusion(WXX) then
		return
	endif
	set biteLevel=SuijiMode_GetIllusionPassiveBridgeLevel(WXX,'A0BK')
	if WXX!=null and YXX!=null and GetUnitTypeId(WXX)!=0 and GetUnitTypeId(YXX)!=0 and ISPH(WXX)==false and biteLevel>0 and GetUnitAbilityLevel(YXX,'A04R')== 0 then
		call Z57(YXX,'A3PV'-1 + biteLevel, 1, 4,'B01D')
		call EnableAttackEffectByTime(9, 4.5)
	endif
endfunction
function MNGJ_Miss takes unit ZX7,unit IH7 returns boolean
	local integer probability = 0
	local integer TYA = 0
	if(IsAttackEffectEnabled[17]and GetUnitAbilityLevel(ZX7,'A1FO')== 1 and(not IsUnitType(IH7, UNIT_TYPE_STRUCTURE) or(GetOwningPlayer(IH7)!= A7[0]and GetOwningPlayer(IH7)!= Z7[0]))) and MRPH(ZX7)==false and LoadInteger(L7,(GetHandleId(IH7)),('A4IS'))==0 then
		return false
	endif
	// 攻击者不是近战单位 和 飞行单位
	if not IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) and not IsUnitType(ZX7, UNIT_TYPE_FLYING) then
		// 如果悬崖高就有 25% 几率丢失
		if GetTerrainCliffLevel(GetUnitX(ZX7), GetUnitY(ZX7))< GetTerrainCliffLevel(GetUnitX(IH7), GetUnitY(IH7)) then
			set TYA = 25
		endif
	endif
	// 查各种丢失 磁场 和 醉拳百分百闪避
	//if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	// 查各种丢失 磁场 和 醉拳百分百闪避
	//if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) then
		set probability = 100
	else
		set probability = GetUnitMissProbability(IH7)
	endif
    //风之障壁百分百闪避
    //风之障壁百分百闪避
    if GetUnitAbilityLevel(ZX7,'Aloc')==0 and IsUnitType(ZX7,UNIT_TYPE_RANGED_ATTACKER)and IsUnitType(ZX7,UNIT_TYPE_STRUCTURE)==false and(LoadInteger(L7,(GetHandleId(IH7)),('A4IS')))>0 then
    if Fc(IH7,ZX7)then
    // call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",IH7,"chest"))
    set probability=100
    endif
    endif
	// 获取单位致盲几率
	// 获取单位致盲几率
	// 获取单位致盲几率
	set TYA = UUEE(TYA, GetUnitBlind(ZX7))
	if(probability > 0 or TYA > 0) and(GetRandomInt(1, 100)< probability or GetRandomInt(1, 100)< TYA) then
		return true
	else
		return false
	endif
endfunction
function B964WSZR_ACTION takes nothing returns nothing
	local timer gear964t = GetExpiredTimer()
	local integer gear964h = GetHandleId(gear964t)
	local unit gear964ZX7 = LoadUnitHandle(TABLE_HY, gear964h, 0)
    local unit gear964IH7 = LoadUnitHandle(TABLE_HY, gear964h, 1)
    local real gear964n=LoadReal(TABLE_HY, gear964h, 2)
    local real gear964damage=0.
    set gear964n=gear964n+1
    call SaveReal(TABLE_HY, gear964h, 2, gear964n)
	if gear964ZX7==null or GetUnitTypeId(gear964ZX7)==0 or gear964IH7==null or GetUnitTypeId(gear964IH7)==0 or (not LoadBoolean(TABLE_HY,gear964h,4) and gear964n>30) or (LoadBoolean(TABLE_HY,gear964h,4) and GetGameTime()>LoadReal(TABLE_HY,gear964h,3)) or GetUnitAbilityLevel(gear964IH7,'B7B0')== 0 or UnitAlive(gear964IH7)==false then
		call UnitRemoveAbility(gear964IH7,'A7B3')
		call UnitRemoveAbility(gear964IH7,'B7B0')
		call RemoveSavedHandle(TABLE_HY, GetHandleId(gear964IH7),'A7B3')
		call FlushChildHashtable(TABLE_HY, gear964h)
		call PauseTimer(gear964t)
		call DestroyTimer(gear964t)
    elseif ModuloReal(gear964n,10.)==0 then
        set gear964damage=GetUnitState(gear964IH7,UNIT_STATE_MAX_LIFE)*0.02
		call B67(gear964ZX7, gear964IH7, 1, gear964damage)
	endif
    set gear964ZX7 = null
	set gear964IH7 = null
	set gear964t = null
endfunction

function B964WSZR_TRI takes unit gear964ZX7, unit gear964IH7 returns nothing
	local timer gear964t = LoadTimerHandle(TABLE_HY, GetHandleId(gear964IH7),'A7B3')
	local integer gear964h
	local integer gear964id='A7B3'
if gear964ZX7==null or gear964IH7==null or GetUnitTypeId(gear964ZX7)==0 or GetUnitTypeId(gear964IH7)==0 or not UnitAlive(gear964IH7) then
set gear964t=null
return
endif
	if gear964t != null then
		set gear964h = GetHandleId(gear964t)
	else
		set gear964t = CreateTimer()
		set gear964h = GetHandleId(gear964t)
		call XF7(gear964IH7, gear964id)
		call SaveUnitHandle(TABLE_HY, gear964h, 0, gear964ZX7)
		call SaveUnitHandle(TABLE_HY, gear964h, 1, gear964IH7)
		call SaveTimerHandle(TABLE_HY, GetHandleId(gear964IH7),'A7B3', gear964t)
        call TimerStart(gear964t, .1, true, function B964WSZR_ACTION)
	endif
	if LoadBoolean(TABLE_HY,gear964h,4) then
        call SaveUnitHandle(TABLE_HY,gear964h,0,gear964ZX7)
        call SaveReal(TABLE_HY,gear964h,3,GetGameTime()+3.)
    else
        call SaveReal(TABLE_HY, gear964h, 2, 0)
    endif
	set gear964t = null
endfunction

// V2 Saint Axe shares one poison instance with Witch Blade/Parasma.
// Refresh the expiry and source, without postponing the next damage tick.
function B1019SaintPoison takes unit gear1019Source,unit gear1019Target returns nothing
local timer gear1019Timer=LoadTimerHandle(TABLE_HY,GetHandleId(gear1019Target),'A7B3')
local integer gear1019Key=0
if gear1019Timer==null then
call B964WSZR_TRI(gear1019Source,gear1019Target)
set gear1019Timer=LoadTimerHandle(TABLE_HY,GetHandleId(gear1019Target),'A7B3')
endif
if gear1019Timer!=null then
set gear1019Key=GetHandleId(gear1019Timer)
call SaveBoolean(TABLE_HY,gear1019Key,4,true)
call SaveUnitHandle(TABLE_HY,gear1019Key,0,gear1019Source)
call SaveReal(TABLE_HY,gear1019Key,3,GetGameTime()+3.)
endif
set gear1019Timer=null
endfunction
function B1019EquipmentHit takes unit gear1019Source,unit gear1019Target returns nothing
if gear1019Source==null or gear1019Target==null or GetUnitTypeId(gear1019Source)==0 or GetUnitTypeId(gear1019Target)==0 then
return
endif
if not IsUnitType(gear1019Source,UNIT_TYPE_HERO) and not AS7(gear1019Source) then
return
endif
if WF7(gear1019Target) or not UnitAlive(gear1019Target) then
return
endif
if GetUnitAbilityLevel(gear1019Source,'A4O2')>0 then
call B1019SaintPoison(gear1019Source,gear1019Target)
endif
// V2 suppression excludes targets with zero current mana; poison does not.
if GetUnitState(gear1019Target,UNIT_STATE_MANA)==0 then
return
endif
if GetUnitAbilityLevel(gear1019Source,'A4O2')>0 then
call UnitRemoveAbility(gear1019Target,'A4NZ')
call UnitRemoveAbility(gear1019Target,'B0M1')
call Z57(gear1019Target,'A4O0',1,3.,'B0M2')
elseif GetUnitAbilityLevel(gear1019Source,'A4O1')>0 and GetUnitAbilityLevel(gear1019Target,'B0M2')==0 then
call Z57(gear1019Target,'A4NZ',1,3.,'B0M1')
endif
endfunction
function B1019EquipmentAttack takes nothing returns nothing
if B964Synthetic then
return
endif
if (GetUnitAbilityLevel(WXX,'A4O1')>0 or GetUnitAbilityLevel(WXX,'A4O2')>0) and not LoadBoolean(TABLE_HY,EOO,11) and LoadBoolean(TABLE_HY,EOO,14) and LoadBoolean(TABLE_HY,EOO,15) then
call B1019EquipmentHit(WXX,YXX)
endif
endfunction

function B964WSZRCD2 takes nothing returns nothing
	local timer gear964t = GetExpiredTimer()
	local integer gear964h = GetHandleId(gear964t)
	local unit gear964u = LoadUnitHandle(TABLE_HY, gear964h, 1)
	call SaveInteger(TABLE_HY, GetHandleId(gear964u), 'WSZR', 0)
	call FlushChildHashtable(TABLE_HY, gear964h)
	call PauseTimer(gear964t)
	call DestroyTimer(gear964t)
	set gear964t = null
	set gear964u = null
endfunction

function B964WSZRCD takes unit gear964u returns nothing
local timer gear964t=CreateTimer()
local real gear964factor=ReduceUnitAbilityCoolDownReal(gear964u)
local real gear964d=7.
if gear964factor>0. then
set gear964d=RMaxBJ(.1,gear964d*gear964factor)
endif
call YDWESetUnitAbilityState(gear964u,'A7B1',1,gear964d)
call SaveInteger(TABLE_HY,GetHandleId(gear964u),'WSZR',1)
call SaveUnitHandle(TABLE_HY,GetHandleId(gear964t),1,gear964u)
call TimerStart(gear964t,gear964d,false,function B964WSZRCD2)
set gear964t=null
endfunction

function B964WSZR_PDCD takes unit gear964ZX7, unit gear964IH7 returns nothing
    if GetUnitAbilityLevel(gear964ZX7,'A4O2')>0 then
        return
    endif
	if gear964ZX7==null or gear964IH7==null or GetUnitTypeId(gear964ZX7)==0 or GetUnitTypeId(gear964IH7)==0 or not UnitAlive(gear964IH7) or not IsUnitEnemy(gear964IH7,GetOwningPlayer(gear964ZX7)) or IsUnitType(gear964IH7,UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(gear964IH7,'A04R')>0 or ISHZHS(gear964ZX7) or IsUnitType(gear964ZX7, UNIT_TYPE_HERO)==false then
		return
	endif
	if GetUnitAbilityLevel(gear964ZX7,'A7B2')>0 then
		call B964WSZR_TRI(gear964ZX7,gear964IH7)
	elseif GetUnitAbilityLevel(gear964ZX7,'A7B1')>0 and LoadInteger(TABLE_HY, GetHandleId(gear964ZX7),'WSZR')== 0 then
		call B964WSZRCD(gear964ZX7)
		call B964WSZR_TRI(gear964ZX7,gear964IH7)
	endif
endfunction

function B964WSZR takes nothing returns nothing
    if B964Synthetic or ISHZHS(WXX) then
        return
    endif
	if(GetUnitAbilityLevel(WXX,'A7B1')>0 or GetUnitAbilityLevel(WXX,'A7B2')>0) and LoadBoolean(TABLE_HY, EOO, 11)==false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and IsUnitType(WXX, UNIT_TYPE_HERO) then
		call B964WSZR_PDCD(WXX, YXX)
	endif
endfunction

function B964HJZL_Actions takes nothing returns nothing
	local integer gear964h = GetHandleId(GetTriggeringTrigger())
	local unit gear964ZX7 = LoadUnitHandle(TABLE_HY, gear964h,'hjzl')
	local unit gear964IH7 = W22
	if gear964ZX7==null or gear964IH7==null or GetUnitTypeId(gear964ZX7)==0 or GetUnitTypeId(gear964IH7)==0 or not UnitAlive(gear964IH7) then
set gear964ZX7=null
set gear964IH7=null
return
endif
if MNGJ_Miss(gear964ZX7,gear964IH7) then
		call YW7("Miss",2,gear964IH7,0.024,255,0,0,255)
	else
		call B67_DPS(gear964ZX7, gear964IH7, 2, LoadReal(TABLE_HY, gear964h,'hjzl'))
		if LoadBoolean(TABLE_HY, gear964h,'hjzl') then
			call B964WSZR_TRI(gear964ZX7,gear964IH7)
		endif
	endif
	set gear964ZX7 = null
	set gear964IH7 = null
endfunction

function B964HJZL_tsw takes unit gear964ZX7, unit gear964IH7, real gear964damage, boolean gear964b returns nothing
	local trigger gear964t
	local integer gear964h
	local real gear964speed=MHUnit_GetDefDataReal(GetUnitTypeId(gear964ZX7),$79)
	local string gear964VH=MHUnit_GetDefDataStr(GetUnitTypeId(gear964ZX7),$89)
	if gear964speed<=0. then
set gear964speed=1250.
endif
set gear964t = NHX(gear964ZX7, gear964IH7,'h30C', "B964HJZL_Actions", gear964speed, true, gear964VH)
	set gear964h = GetHandleId(gear964t)
	call SaveReal(TABLE_HY, gear964h,'hjzl', gear964damage)
	call SaveUnitHandle(TABLE_HY, gear964h,'hjzl', gear964ZX7)
	call SaveBoolean(TABLE_HY, gear964h,'hjzl', gear964b)
	set gear964t = null
endfunction

function B964HJZL_Target_PD takes nothing returns boolean
	return(IsUnitEnemy(B964SplitSource, GetOwningPlayer(GetFilterUnit())) and AE7(GetFilterUnit())==false and KE7(B964SplitSource,GetFilterUnit())<B964SplitRange and IsAliveNotStrucNotWard(GetFilterUnit()) and lWA(GetFilterUnit(), GetOwningPlayer(B964SplitSource)) )
endfunction

function B964HJZL takes unit gear964ZX7, unit gear964IH7 returns nothing
	local unit gear964fu
	local group gear964g = WS7()
	local real gear964damage
	local integer gear964i = 1
    local real gear964attackrange=GetUnitState(gear964ZX7, UNIT_STATE_ATTACK1_RANGE)+150
    local integer gear964n=2
	local boolean gear964b=false
    if GetUnitAbilityLevel(gear964ZX7,'A7B2')>0 then
        set gear964n=gear964n+1
		set gear964b=true
    endif
	set B964SplitSource = gear964ZX7
    set B964SplitRange = gear964attackrange
	call GroupEnumUnitsInRange(gear964g, GetUnitX(gear964IH7), GetUnitY(gear964IH7), 400, B964SplitFilter)
	set gear964damage = ((GetUnitState(gear964ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(gear964ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )* 0.75)+20
	loop
		set gear964fu = GroupPickRandomUnit(gear964g)
	exitwhen(gear964fu == null or gear964i > gear964n)
		if gear964IH7 != gear964fu then
			call B964HJZL_tsw(gear964ZX7, gear964fu, gear964damage, gear964b)

			set gear964i = gear964i + 1
		endif
		call GroupRemoveUnit(gear964g, gear964fu)
	endloop
	call WR7(gear964g)
	set gear964fu = null
	set gear964g = null
endfunction

function B964HJZL_PD takes nothing returns boolean
    local unit gear964ZX7=MHEvent_GetUnit()
    local unit gear964IH7=MHUnitAttackLaunchEvent_GetTargetUnit()
	if gear964ZX7!=null and gear964IH7!=null and GetUnitTypeId(gear964ZX7)!=0 and GetUnitTypeId(gear964IH7)!=0 and UnitAlive(gear964IH7) and IsUnitType(gear964ZX7,UNIT_TYPE_HERO) and IsUnitType(gear964ZX7, UNIT_TYPE_MELEE_ATTACKER)==false and MRPH(gear964ZX7)==false and (GetUnitAbilityLevel(gear964ZX7,'A7B0')>0 or GetUnitAbilityLevel(gear964ZX7,'A7B2')>0) and IsUnitEnemy(gear964ZX7, GetOwningPlayer(gear964IH7)) then
		if GetPrdRandom(gear964ZX7, 'HJZL', 30) then
			call B964HJZL(gear964ZX7, gear964IH7)
		endif
	endif
    set gear964ZX7=null
    set gear964IH7=null
return false
endfunction
function B964ZCHJZL_TRI takes nothing returns nothing
    local trigger gear964t
	set B964SplitFilter=Condition(function B964HJZL_Target_PD)
set gear964t=CreateTrigger()
    call MHUnitAttackLaunchEvent_Register(gear964t)
    call TriggerAddCondition(gear964t,Condition(function B964HJZL_PD))
    set gear964t=null
endfunction
function MNGJTX takes unit ZX7, unit IH7 returns nothing
	local integer i
    call JJ_PD(ZX7, IH7) //减甲装备
    if IsUnitType(IH7, UNIT_TYPE_STRUCTURE) then
        return
    endif
	if GetUnitAbilityLevel(ZX7,'A061')== 1 then
		if GetPrdRandom(WXX,'A061', 35) then	//金箍棒
			call TGA(ZX7, IH7, 5)
		endif
	endif
    if MV7(ZX7, ZU[RLL])!= null then	//大隐刀
        if GetPrdRandom(ZX7, 'A2QG', IMinBJ(15*imbaMult,100)) and GetUnitAbilityLevel(IH7,'B0GT')==0 then
            call ZAA8(IH7)
        endif   
    elseif MV7(ZX7, ZU[U1])!= null or MV7(ZX7, ZU[it_sy])!= null then	//双刀、三元
		if GetPrdRandom(ZX7, 'A263', IMinBJ(30*imbaMult,100)) and GetUnitAbilityLevel(IH7,'B08N')==0 then
			call ZW8(IH7)
		endif
	elseif MV7(ZX7, ZU[RL])!= null or MV7(ZX7, ZU[R3])!= null or MV7(ZX7, ZU[it_dyms])!= null then
		if GetPrdRandom(ZX7, 'A264', IMinBJ(20*imbaMult,100)) and GetUnitAbilityLevel(IH7,'B02I')==0 then	//散华和天堂之戟和地狱面首
			call ZA8(IH7)
		endif
	endif
	if GetUnitAbilityLevel(ZX7,'A4C7')> 0 then	//深渊之刃和小晕锤
		if IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) then
			set i = 25
		else
			set i = 10
		endif
		if LoadInteger(TABLE_HY, GetHandleId(ZX7),'bash')!= 1 and GetPrdRandom(ZX7,'A4C7', i) then
			if GetUnitAbilityLevel(ZX7,'A4C6')==1 then
				call YDWESetUnitAbilityState(ZX7,'A4C6', 1, 2)
			endif
			call EPX(ZX7,'bash', 2)
			call TGA(ZX7, IH7, 4)
		endif
	endif
	if GetUnitAbilityLevel(ZX7,'A0JH')> 0 or GetUnitAbilityLevel(ZX7,'A0FJ')> 0 or GetUnitAbilityLevel(ZX7,'A4E5')> 0 then
		call B1O(ZX7, IH7)	//漩涡和雷神之锤
	endif
    if GetUnitAbilityLevel(ZX7,'A4DU')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then //散失
        call B4O(ZX7,IH7,3)
    elseif GetUnitAbilityLevel(ZX7,'A4BO')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then
        call B4O(ZX7,IH7,2)
    elseif GetUnitAbilityLevel(ZX7,'A4BN')> 0 and GetUnitState(IH7, UNIT_STATE_MANA)> 0 then
        call B4O(ZX7,IH7,1)
    endif
	if GetUnitAbilityLevel(ZX7,'A2KV')> 0 or GetUnitAbilityLevel(ZX7,'A4H8')>0 and WF7(IH7)==false then	//冰眼
		call QZA(ZX7, IH7, IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER))
	endif
	if GetUnitAbilityLevel(ZX7,'A1V7')> 0 then	//淬毒之珠
		call Q0A(IH7, ZX7, IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER))
	endif 
call B964WSZR_PDCD(ZX7,IH7)
call B1019EquipmentHit(ZX7,IH7)
endfunction
function MNGJ takes unit ZX7, unit IH7 returns nothing
local real d=GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS)
    local real sleightScale1097=1.
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
	//非存活 隐藏 虚无吹风守卫无敌 非可见 则返回
if UnitAlive(IH7)==false or IsHideUnit(IH7) or AE7(IH7) or GetUnitAbilityLevel(IH7,'A04R')!=0 or GetUnitAbilityLevel(IH7,'Avul')!=0 or IsUnitVisible(IH7,GetOwningPlayer(ZX7))==false then
		return
elseif MNGJ_Miss(ZX7,IH7) then
		call YW7("Miss",5,ZX7,0.024,255,0,0,255)
else
    // B1078: only our accepted synthetic hit dispatches skill orbs/passives.
    // Keep the shared equipment/critical/lifesteal implementation below intact.
    if ZX7==B1078AttackSource and IH7==B1078AttackTarget and not B1078AttackLanded then
        set B1078AttackLanded=true
        call ExecuteFunc("B1078AttackPassives")
        if GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(ZX7) or not UnitAlive(IH7) then
            return
        endif
    endif
    if MRPH(ZX7)==false then
	    //攻击特效
	    call MNGJTX(ZX7,IH7)
    endif
    if ZX7==B1078AttackSource and (GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(ZX7) or not UnitAlive(IH7)) then
        return
    endif
    if ZX7==B1097SleightAttackUnit and IH7==B1097SleightAttackTarget and ZX7==B1078AttackSource then
        if IsUnitType(IH7,UNIT_TYPE_HERO) or IsUnitIllusion(IH7) then
            if d>0. then
                set sleightScale1097=(d+20.*B1097SleightAttackLevel)/d
            endif
            set d=RMaxBJ(0.,d)+20.*B1097SleightAttackLevel
        else
            set sleightScale1097=.5
            set d=RMaxBJ(0.,d)*.5
        endif
    endif
    set damage=Attack_Damage(ZX7,IH7,1)*sleightScale1097
    if ZX7==B1097SleightAttackUnit and IH7==B1097SleightAttackTarget and ZX7==B1078AttackSource then
        if (IsUnitType(IH7,UNIT_TYPE_HERO) or IsUnitIllusion(IH7)) and sleightScale1097==1. then
            set damage=Attack_Damage(ZX7,IH7,20.*B1097SleightAttackLevel)
        endif
        set damage=RMaxBJ(0.,damage)
    endif
    if MRPH(ZX7)==false then
	    //分裂
	    call MNFL(ZX7, IH7,sleightScale1097,true)
	    //暴击
	    call MNBJ(ZX7,IH7,damage,true)
    endif
    if ZX7==B1078AttackSource and (GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(ZX7) or not UnitAlive(IH7)) then
        return
    endif
	if GetUnitTypeId(ZX7)=='E002' then //电棍抽攻特效
	    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraLightningMissile\\ChimaeraLightningMissile.mdl",IH7,"chest"))
    elseif GetUnitTypeId(ZX7)=='U00C' then //小狗攻击特效
        call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl",GetUnitX(IH7),GetUnitY(IH7)))
    elseif GetUnitTypeId(ZX7)=='Z00C' then //小狗皮肤攻击特效
        call DestroyEffect(AddSpecialEffect("model\\Hero_Lifestealer_N2S_T_Boom_1.mdl",GetUnitX(IH7),GetUnitY(IH7)))
	endif
	call B67_DPS(ZX7,IH7,2,d)
	if ZX7==B1078AttackSource and (GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(ZX7)) then
		return
	endif
	//压制之刃
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)) then	
		call Q5A(ZX7, IH7, damage)
	endif	
	//吸血
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 and MRPH(ZX7)==false then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
endif
endfunction
function Func_MNGJ takes nothing returns nothing
    call MNGJ(ZX7_tmp,IH7_tmp)
endfunction
function SuijiMode_TriggerFocusFireAttackEffects takes unit source,unit target returns nothing
local integer h=0
local boolean gear964previous=B964Synthetic
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return
endif
set B964Synthetic=true
set h=GetHandleId(source)
set WXX=source
set YXX=target
set PVV=false
set EOO=h
call SaveBoolean(TABLE_HY,h,10,IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source))
call SaveBoolean(TABLE_HY,h,11,IsUnitType(target,UNIT_TYPE_STRUCTURE))
call SaveBoolean(TABLE_HY,h,14,GetUnitAbilityLevel(target,'A04R')==0)
call SaveBoolean(TABLE_HY,h,15,IsUnitEnemy(source,GetOwningPlayer(target)))
if IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source) then
call ExecuteAttackEvent(0)
call ExecuteAttackEvent(1)
if LoadBoolean(TABLE_HY,h,11)==false and LoadBoolean(TABLE_HY,h,14) then
call ExecuteAttackEvent(2)
if LoadBoolean(TABLE_HY,h,15) then
call ExecuteAttackEvent(3)
if IsMagicImmuneUnit(target)==false then
call ExecuteAttackEvent(4)
endif
endif
endif
endif
set B964Synthetic=gear964previous
endfunction
function JZHLActions takes nothing returns nothing
    local integer h = GetHandleId(GetTriggeringTrigger())
    local unit ZX7=LoadUnitHandle(TABLE_HY, h,'jzhl')
	local unit IH7 = W22
	local real d=LoadReal(TABLE_HY, h,'jzhl')
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
	if MNGJ_Miss(ZX7,IH7) then
		call YW7("Miss",5,ZX7,0.024,255,0,0,255)
	else
	call SuijiMode_TriggerFocusFireAttackEffects(ZX7,IH7)
	if SuijiMode_HasRandomSkill(ZX7,'A0LZ') then
	call SuijiMode_UnifiedOrbApply(ZX7,IH7,'A0LZ')
	endif
    if MRPH(ZX7)==false then
	    call MNGJTX(ZX7,IH7)
    endif
    set damage=Attack_Damage(ZX7,IH7,d)
	call B67_DPS(ZX7,IH7,2,d)
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 and MRPH(ZX7)==false then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if MRPH(ZX7)==false then
	    call MNBJ(ZX7,IH7,damage,true)
    endif
	endif
endfunction
function JZHL takes unit u, unit target,real d returns nothing
	local trigger t
	local integer h
    local real damage = (GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) ) * d
    set t = NHX(u, target,'h30C', "JZHLActions", 1250, true, "")
    set h = GetHandleId(t)
	call SaveReal(TABLE_HY, h,'jzhl', damage)
	call SaveUnitHandle(TABLE_HY, h,'jzhl', u)
if not MRPH(u) and (GetUnitAbilityLevel(u,'A7B0')>0 or GetUnitAbilityLevel(u,'A7B2')>0) and GetPrdRandom(u,'HJZL',30) then
call B964HJZL(u,target)
endif
	set t = null
endfunction
function JZHLPD takes unit ZX7,unit IH7 returns boolean
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	//来源 射程内 非眩晕 非虚无吹风 非隐藏 非隐身 非变羊 非缴械
	//目标 非虚无吹风 非隐藏 非无敌 可见的
	return KE7(ZX7,IH7)<=GetUnitState(ZX7,UNIT_STATE_ATTACK1_RANGE)+25. and ISSTUN(ZX7)==false and AE7(ZX7)==false and IsHideUnit(ZX7)==false and AK7(ZX7)==false and ISBIANYANG(ZX7)==false and ISJIAOXIE(ZX7)==false and AE7(IH7)==false and IsHideUnit(IH7)==false and ISWUDI(IH7)==false and IsUnitVisible(IH7,GetOwningPlayer(ZX7))
endfunction
function B848_FocusInterval takes unit focusOwner returns real
if focusOwner==null or GetUnitTypeId(focusOwner)==0 then
return .3
endif
return RMaxBJ(.02,GetUnitState(focusOwner,UNIT_STATE_ATTACK1_COOL)/RMaxBJ(.2,RMinBJ(GetUnitState(focusOwner,UNIT_STATE_ATTACK1_SPEED),MHUnit_GetAttackSpeedLimit(focusOwner))))
endfunction
function JLG takes nothing returns boolean
local integer launchId1060=MHEvent_GetId()
local unit launchSource1060=null
local unit launchTarget1060=null
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local real J1G=ON7(OB7,"Rate")
local real time=ON7(OB7,"Time")
local boolean EWD=OO7(OB7,"Scepter")
local real focusInterval=B848_FocusInterval(p5)
if launchId1060==EVENT_ID_UNIT_ATTACK_LAUNCH then
set launchSource1060=MHEvent_GetUnit()
set launchTarget1060=MHUnitAttackLaunchEvent_GetTargetUnit()
endif
if GetTriggerEvalCount(t)==1 then
    call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
    if GetPlayerController(GetOwningPlayer(m5))==MAP_CONTROL_COMPUTER then
        call AI_ITEM_RENJIA(m5)
    endif
endif
if launchId1060==EVENT_ID_UNIT_ATTACK_LAUNCH then
    if launchSource1060==p5 then
        if launchTarget1060==m5 then
            call NQ7(OB7,"ATTACKTIME",GetGameTime()+focusInterval)
        else
            call NQ7(OB7,"ATTACKTIME",GetGameTime()+1.)
        endif
    endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if b1060B287_GetSpellAbilityId=='A12P' or b1060B287_GetSpellAbilityId=='A1D6' then
        call TP7(B07)
        call NM7(OB7)
        call OZ7(t)
    endif
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH or GetGameTime()>time then
call UnitRemoveAbility(p5,'A12R')
call UnitRemoveAbility(p5,'B09X')
    call TP7(B07)
    call NM7(OB7)
    call OZ7(t)
call UnitRemoveAbility(p5,'A1FK')
call UnitRemoveAbility(p5,'A1FL')
call UnitRemoveAbility(p5,'A1FJ')
call UnitRemoveAbility(p5,'A2PS')
call UnitRemoveAbility(p5,'A2PT')
call UnitRemoveAbility(p5,'A2PU')
elseif GetGameTime()>=ON7(OB7,"ATTACKTIME") and JZHLPD(p5,m5) then
        call NQ7(OB7,"ATTACKTIME",GetGameTime()+focusInterval)
        call JZHL(p5,m5,(1-J1G))
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set launchSource1060=null
set launchTarget1060=null
return b1060ReturnValue
endfunction
function J0G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A12P')
local real R9D=.6-V77*.1
local boolean TGD=false
call UnitRemoveAbility(ZX7,'A12R')
call UnitRemoveAbility(ZX7,'B09X')
if V77>0 then
call UnitRemoveAbility(ZX7,'A2PS')
call UnitRemoveAbility(ZX7,'A2PT')
call UnitRemoveAbility(ZX7,'A2PU')
if V77==1 then
call XF7(ZX7,'A1FK')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FK',false)
elseif V77==2 then
call XF7(ZX7,'A1FL')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FL',false)
elseif V77==3 then
call XF7(ZX7,'A1FJ')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FJ',false)
endif
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A12P') then
call UnitRemoveAbility(ZX7,'A1FK')
call UnitRemoveAbility(ZX7,'A1FL')
call UnitRemoveAbility(ZX7,'A1FJ')
set TGD=true
set R9D=.45-V77*.15
if V77==1 then
call XF7(ZX7,'A2PS')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PS',false)
elseif V77==2 then
call XF7(ZX7,'A2PT')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PT',false)
elseif V77==3 then
call XF7(ZX7,'A2PU')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PU',false)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A12R',false)
call XF7(ZX7,'A12R')
call Z57(ZX7,'A4I1',1,20,0)
call B947IssueTargetOrderById("J0G @ war3map.j:216900 (B968)",ZX7,$D000F,IH7)
call NT7(OB7,"Source",ZX7)
call NS7(OB7,"Scepter",TGD)
call NP7(OB7,"TargetIndex",TS7(IH7))
call NQ7(OB7,"Rate",R9D)
call NQ7(OB7,"Time",GetGameTime()+20.)
call NQ7(OB7,"ATTACKTIME",GetGameTime()+B848_FocusInterval(ZX7))
call NT7(GetHandleId(ZX7),"Target",IH7)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call MHUnitAttackLaunchEvent_Register(t)
call TriggerAddCondition(t,Condition(function JLG))
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
set t=null
endfunction
function J5G takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A12P' or B287_GetSpellAbilityId()=='A1D6') and WQ7(GetSpellTargetUnit())==false then
call J0G()
endif
return false
endfunction
function JZHLBUFF takes unit ZX7 returns nothing
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A12P')
if V77>0 then
if V77==1 then
call XF7(ZX7,'A1FK')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FK',false)
elseif V77==2 then
call XF7(ZX7,'A1FL')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FL',false)
elseif V77==3 then
call XF7(ZX7,'A1FJ')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1FJ',false)
endif
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A12P') then
if V77==1 then
call XF7(ZX7,'A2PS')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PS',false)
elseif V77==2 then
call XF7(ZX7,'A2PT')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PT',false)
elseif V77==3 then
call XF7(ZX7,'A2PU')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2PU',false)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A12R',false)
call XF7(ZX7,'A12R')
endfunction
function J2G takes unit ZX7 returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local unit IH7=O77(GetHandleId(ZX7),"Target")
if b1060GetTriggerUnit==IH7 then
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",ZX7,"hand,left"))
call DestroyEffect(AddSpecialEffectTarget("effects\\Tornado.mdx",ZX7,"hand,right"))
if GetUnitAbilityLevel(ZX7,'A12R')==0 then
        call JZHLBUFF(ZX7)
    endif
elseif b1060GetTriggerUnit!=IH7 then
call UnitRemoveAbility(ZX7,'A12R')
call UnitRemoveAbility(ZX7,'B09X')
call UnitRemoveAbility(ZX7,'A1FK')
call UnitRemoveAbility(ZX7,'A1FL')
call UnitRemoveAbility(ZX7,'A1FJ')
call UnitRemoveAbility(ZX7,'A2PS')
call UnitRemoveAbility(ZX7,'A2PT')
call UnitRemoveAbility(ZX7,'A2PU')
endif
set IH7=null
set b1060GetTriggerUnit=null
endfunction
function J_G takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'A4I1')>0 then
call J2G(GetAttacker())
endif
return false
endfunction
function ND8 takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger t2=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function J5G))
call YB7(t2,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t2,Condition(function J_G))
set t=null
set t2=null
endfunction
function SuijiMode_DogInfestAddHostLife takes integer suijiInfestLifeController,unit suijiInfestLifeCaster,unit suijiInfestLifeHost returns nothing
local real suijiInfestLifeBonus=0.
local real suijiInfestLifeOldMax=0.
local real suijiInfestLifeOldCurrent=0.
if suijiInfestLifeCaster==null or suijiInfestLifeHost==null or suijiInfestLifeCaster==suijiInfestLifeHost then
return
endif
if GetUnitTypeId(suijiInfestLifeCaster)==0 or GetUnitTypeId(suijiInfestLifeHost)==0 or UnitAlive(suijiInfestLifeCaster)==false or UnitAlive(suijiInfestLifeHost)==false then
return
endif
if IsUnitAlly(suijiInfestLifeHost,GetOwningPlayer(suijiInfestLifeCaster))==false or HaveSavedReal(L7,suijiInfestLifeController,StringHash("SuijiDogInfestHostLifeBonus")) then
return
endif
// Snapshot once per controller; never heal or grow maximum life on a tick.
set suijiInfestLifeBonus=GetUnitState(suijiInfestLifeCaster,UNIT_STATE_MAX_LIFE)*.5
if suijiInfestLifeBonus<=0. then
return
endif
set suijiInfestLifeOldMax=GetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE)
set suijiInfestLifeOldCurrent=GetWidgetLife(suijiInfestLifeHost)
call SaveReal(L7,suijiInfestLifeController,StringHash("SuijiDogInfestHostLifeBonus"),suijiInfestLifeBonus)
call SetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE,suijiInfestLifeOldMax+suijiInfestLifeBonus)
// Own the actual applied delta, not a stale total or an unsupported write.
set suijiInfestLifeBonus=RMaxBJ(0.,GetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE)-suijiInfestLifeOldMax)
call SaveReal(L7,suijiInfestLifeController,StringHash("SuijiDogInfestHostLifeBonus"),suijiInfestLifeBonus)
call SetUnitState(suijiInfestLifeHost,UNIT_STATE_LIFE,RMinBJ(GetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE),suijiInfestLifeOldCurrent+suijiInfestLifeBonus))
endfunction
function SuijiMode_DogInfestRemoveHostLife takes integer suijiInfestLifeController,unit suijiInfestLifeHost returns nothing
local real suijiInfestLifeBonus=LoadReal(L7,suijiInfestLifeController,StringHash("SuijiDogInfestHostLifeBonus"))
local real suijiInfestLifeOldCurrent=0.
// Clear ownership before any engine write so repeated cleanup cannot subtract twice.
call RemoveSavedReal(L7,suijiInfestLifeController,StringHash("SuijiDogInfestHostLifeBonus"))
if suijiInfestLifeBonus<=0. or suijiInfestLifeHost==null then
return
endif
if GetUnitTypeId(suijiInfestLifeHost)==0 then
return
endif
set suijiInfestLifeOldCurrent=GetWidgetLife(suijiInfestLifeHost)
call SetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE,RMaxBJ(1.,GetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE)-suijiInfestLifeBonus))
// Keep current life, clamped to the new maximum. Do not inflict exit damage,
// heal a wounded host, resurrect a dead host, or restore its old equipment total.
call SetUnitState(suijiInfestLifeHost,UNIT_STATE_LIFE,RMinBJ(suijiInfestLifeOldCurrent,GetUnitState(suijiInfestLifeHost,UNIT_STATE_MAX_LIFE)))
endfunction
function SuijiMode_DogInfestLockMovement takes unit suijiDogInfestHero returns nothing
local integer suijiDogInfestMoveHandle=0
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
set suijiDogInfestMoveHandle=GetHandleId(suijiDogInfestHero)
if LoadBoolean(L7,suijiDogInfestMoveHandle,StringHash("SuijiDogInfestMoveOwned"))==false then
call SaveBoolean(L7,suijiDogInfestMoveHandle,StringHash("SuijiDogInfestMoveOwned"),true)
call MHUnit_DisableMoveEx(suijiDogInfestHero,true)
endif
endfunction
function SuijiMode_DogInfestHideAllyBars takes unit suijiDogInfestHero returns nothing
local integer suijiDogInfestBarHandle=0
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
set suijiDogInfestBarHandle=GetHandleId(suijiDogInfestHero)
// Save the live per-unit anchor, including zero; never use the type cache in
// Hide_HP, which can restore another instance's height after a skin change.
if HaveSavedReal(L7,suijiDogInfestBarHandle,StringHash("SuijiDogInfestRestoreBarHeight"))==false then
call SaveReal(L7,suijiDogInfestBarHandle,StringHash("SuijiDogInfestRestoreBarHeight"),MHUnit_GetData(suijiDogInfestHero,UNIT_DATA_HPBAR_HEIGHT))
call MHUnit_SetData(suijiDogInfestHero,UNIT_DATA_HPBAR_HEIGHT,9999.)
endif
endfunction
function SuijiMode_DogInfestEnableInsideCasting takes unit suijiDogInfestHero returns nothing
local integer suijiDogInfestHeroHandle=0
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
set suijiDogInfestHeroHandle=GetHandleId(suijiDogInfestHero)
call SaveReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreScale"),XX7(suijiDogInfestHero))
call ShowDogSkill(suijiDogInfestHero)
call UnitCancelHide(suijiDogInfestHero)
call SetUnitScale(suijiDogInfestHero,0.,0.,0.)
call SetUnitVertexColor(suijiDogInfestHero,$FF,$FF,$FF,0)
// Infest keeps the original hero handle and command card alive, but the
// contained hero must leave Warcraft's pathing and collision systems fully.
// The ownership flag prevents Infest from restoring pathing that another
// phase or movement mechanic had already disabled before entry.
if LoadBoolean(UnitDataHashTable,suijiDogInfestHeroHandle,UNIT_PATHING)==false then
call SetUnitPathingEx(suijiDogInfestHero,false)
call NS7(suijiDogInfestHeroHandle,"SuijiDogInfestPathingOwned",true)
else
call NS7(suijiDogInfestHeroHandle,"SuijiDogInfestPathingOwned",false)
endif
endfunction
function SuijiMode_DogInfestDisableInsideCasting takes unit suijiDogInfestHero returns nothing
local integer suijiDogInfestHeroHandle=0
local real suijiDogInfestRestoreScale=0.
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
set suijiDogInfestHeroHandle=GetHandleId(suijiDogInfestHero)
if LoadBoolean(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestMoveOwned")) then
call RemoveSavedBoolean(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestMoveOwned"))
call MHUnit_DisableMoveEx(suijiDogInfestHero,false)
endif
if HaveSavedReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreBarHeight")) then
call MHUnit_SetData(suijiDogInfestHero,UNIT_DATA_HPBAR_HEIGHT,LoadReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreBarHeight")))
call RemoveSavedReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreBarHeight"))
endif
if OO7(suijiDogInfestHeroHandle,"SuijiDogInfestPathingOwned") then
call NS7(suijiDogInfestHeroHandle,"SuijiDogInfestPathingOwned",false)
if LoadBoolean(UnitDataHashTable,suijiDogInfestHeroHandle,UNIT_PATHING) and GetUnitAbilityLevel(suijiDogInfestHero,'B09Y')==0 and HaveSavedHandle(TABLE_HY,suijiDogInfestHeroHandle,'A05C')==false and HaveSavedHandle(TABLE_HY,suijiDogInfestHeroHandle,'A4HS')==false and HaveSavedHandle(TABLE_HY,suijiDogInfestHeroHandle,'A4IE')==false and LoadInteger(L7,suijiDogInfestHeroHandle,'BFLY')<=0 and LoadInteger(L7,suijiDogInfestHeroHandle,'B0KV')<=0 then
call SetUnitPathingEx(suijiDogInfestHero,true)
endif
endif
set suijiDogInfestRestoreScale=LoadReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreScale"))
if suijiDogInfestRestoreScale<=0. then
set suijiDogInfestRestoreScale=XX7(suijiDogInfestHero)
endif
call ShowDogSkill(suijiDogInfestHero)
call SetUnitScale(suijiDogInfestHero,suijiDogInfestRestoreScale,suijiDogInfestRestoreScale,suijiDogInfestRestoreScale)
call ResetUnitVertexColor(suijiDogInfestHero,GetUnitTypeId(suijiDogInfestHero))
call UnitCancelHide(suijiDogInfestHero)
call RemoveSavedReal(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestRestoreScale"))
endfunction
function SuijiMode_DogInfestRestoreHero takes unit suijiDogInfestHero returns nothing
local integer suijiDogInfestHeroHandle=0
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return
endif
set suijiDogInfestHeroHandle=GetHandleId(suijiDogInfestHero)
// Detach the active state before restoring buttons can issue another event.
call SaveInteger(L7,suijiDogInfestHeroHandle,4310,2)
call RemoveSavedHandle(L7,suijiDogInfestHeroHandle,StringHash("SuijiDogInfestTrigger"))
call UnitRemoveAbility(suijiDogInfestHero,'A0SX')
call UnitRemoveAbility(suijiDogInfestHero,'A4FM')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiDogInfestHero),'A0SW',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiDogInfestHero),'A4FR',true)
call SuijiMode_DogInfestDisableInsideCasting(suijiDogInfestHero)
call SetUnitInvulnerable(suijiDogInfestHero,false)
endfunction
function SuijiMode_DogInfestRestoreHostAfterAbort takes integer suijiDogInfestHandle,unit suijiDogInfestHero,unit suijiDogInfestHost returns nothing
local player suijiDogInfestOriginalOwner=null
if suijiDogInfestHost==null or GetUnitTypeId(suijiDogInfestHost)==0 or OO7(suijiDogInfestHandle,"SuijiDogInfestTemporaryHost")==false then
set suijiDogInfestOriginalOwner=null
return
endif
if OO7(suijiDogInfestHandle,"SuijiDogInfestHostHadExit")==false then
call UnitRemoveAbility(suijiDogInfestHost,'A0SX')
endif
if OO7(suijiDogInfestHandle,"SuijiDogInfestHostHadCargo")==false then
call UnitRemoveAbility(suijiDogInfestHost,'ACmi')
endif
set suijiDogInfestOriginalOwner=LoadPlayerHandle(L7,suijiDogInfestHandle,StringHash("SuijiDogInfestHostOwner"))
if OO7(suijiDogInfestHandle,"SuijiDogInfestHostControlled") then
if suijiDogInfestOriginalOwner!=null and GetOwningPlayer(suijiDogInfestHost)==LoadPlayerHandle(L7,suijiDogInfestHandle,StringHash("SuijiDogInfestCasterOwner")) and GetOwningPlayer(suijiDogInfestHost)!=suijiDogInfestOriginalOwner then
call SetUnitOwner(suijiDogInfestHost,suijiDogInfestOriginalOwner,false)
endif
if GetUnitTypeId(suijiDogInfestHost)!=0 then
call SetUnitMoveSpeed(suijiDogInfestHost,ON7(suijiDogInfestHandle,"SuijiDogInfestHostMoveSpeed"))
endif
endif
set suijiDogInfestOriginalOwner=null
endfunction
function SuijiMode_DogInfestEmergencyCleanup takes integer suijiDogInfestHandle,trigger suijiDogInfestTrigger,unit suijiDogInfestHero returns nothing
local unit suijiDogInfestHost=O77(suijiDogInfestHandle,"Target")
if suijiDogInfestTrigger!=null and IsTriggerEnabled(suijiDogInfestTrigger)==false then
set suijiDogInfestHost=null
return
endif
// Retire before ownership/button restoration can synchronously re-enter.
call OZ7(suijiDogInfestTrigger)
call SuijiMode_DogInfestRemoveHostLife(suijiDogInfestHandle,suijiDogInfestHost)
call SuijiMode_DogInfestRestoreHostAfterAbort(suijiDogInfestHandle,suijiDogInfestHero,suijiDogInfestHost)
call SuijiMode_DogInfestRestoreHero(suijiDogInfestHero)
call DestroyEffect(OG7(suijiDogInfestHandle,"FX"))
call DestroyEffect(OG7(suijiDogInfestHandle,"FX3"))
call NM7(suijiDogInfestHandle)
set suijiDogInfestHost=null
endfunction
function SuijiMode_DogInfestForceCleanup takes unit suijiDogInfestHero returns nothing
local trigger suijiDogInfestTrigger=null
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 or LoadInteger(L7,GetHandleId(suijiDogInfestHero),4310)!=1 then
return
endif
set suijiDogInfestTrigger=LoadTriggerHandle(L7,GetHandleId(suijiDogInfestHero),StringHash("SuijiDogInfestTrigger"))
if suijiDogInfestTrigger!=null then
call SuijiMode_DogInfestEmergencyCleanup(GetHandleId(suijiDogInfestTrigger),suijiDogInfestTrigger,suijiDogInfestHero)
else
call SuijiMode_DogInfestRestoreHero(suijiDogInfestHero)
endif
set suijiDogInfestTrigger=null
endfunction
function SEF takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local unit WX7=O77(I97,"Hero")
local integer BC7=OM7(I97,"Level")
local real dur=ON7(I97,"Time")
local integer ISAI=OM7(I97,"ISAI")
local real now=GetGameTime()
local real last_attack=ON7(I97,"Last_Attack")
local string boom1=OP7(I97,"boom1")
local string boom2=OP7(I97,"boom2")
local string boom3=OP7(I97,"boom3")
if IsTriggerEnabled(t)==false or OO7(I97,"B1028InfestBusy") then
set t=null
set IH7=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
call NS7(I97,"B1028InfestBusy",true)
if WX7==null or IH7==null then
call SuijiMode_DogInfestEmergencyCleanup(I97,t,WX7)
set t=null
set IH7=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if GetUnitTypeId(WX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(WX7)==false then
call SuijiMode_DogInfestEmergencyCleanup(I97,t,WX7)
set t=null
set IH7=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_WIDGET_DEATH or UnitAlive(IH7)==false then
    call OZ7(t)
    call SuijiMode_DogInfestRemoveHostLife(I97,IH7)
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call SuijiMode_DogInfestRestoreHero(WX7)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
elseif(IsUnitType(IH7,UNIT_TYPE_HERO) or (ASA(IH7) and not B1055IsLaneBoss(IH7)))and IsUnitEnemy(IH7,GetOwningPlayer(WX7)) and now-dur>3. then
    call OZ7(t)
    call SuijiMode_DogInfestRemoveHostLife(I97,IH7)
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call SuijiMode_DogInfestRestoreHero(WX7)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
    if GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(WX7) and UnitAlive(IH7) then
        call B947IssueTargetOrderById("SEF @ war3map.j:217228 (B968)",WX7,$D000F,IH7)
    endif
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER and b1060GetIssuedOrderId==852544 and GetUnitAbilityLevel(b1060GetTriggerUnit,'A4FM')>0 then
    call NS7(I97,"SuijiDogInfestHostControlled",true)
    call XGKZ(WX7,IH7)
elseif (b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER and b1060GetIssuedOrderId==852543 and GetUnitAbilityLevel(b1060GetTriggerUnit,'A0SX')>0) or (ISAI==1 and now-dur>30.) then
    call OZ7(t)
    call SuijiMode_DogInfestRemoveHostLife(I97,IH7)
    call DestroyEffect(AddSpecialEffect(boom1,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom2,GetUnitX(IH7),GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffect(boom3,GetUnitX(IH7),GetUnitY(IH7)))
    if IsUnitType(IH7,UNIT_TYPE_HERO)==false and (ASA(IH7) and not B1055IsLaneBoss(IH7))==false then
        call SetUnitState(WX7,UNIT_STATE_LIFE,GetUnitState(WX7,UNIT_STATE_LIFE)+GetUnitState(IH7,UNIT_STATE_LIFE))
    endif
    call SetUnitX(WX7,GetUnitX(IH7))
    call SetUnitY(WX7,GetUnitY(IH7))
    call SuijiMode_DogInfestRestoreHero(WX7)
    call SetUnitAnimation(WX7,"Stand Victory")
    call ZP7(WX7,1.5)
    call ClearSelectionForPlayer(GetOwningPlayer(WX7))
    call SelectUnitForPlayerSingle(WX7,GetOwningPlayer(WX7))
    call DestroyEffect(OG7(I97,"FX"))
    call DestroyEffect(OG7(I97,"FX3"))
    call NM7(I97)
    call OZ7(t)
    call S8F(WX7,IH7,BC7)
    if GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and IsUnitType(IH7,UNIT_TYPE_HERO)==false and (ASA(IH7) and not B1055IsLaneBoss(IH7))==false then
        if GetOwningPlayer(IH7)==GetOwningPlayer(WX7) or IsUnitAlly(IH7,GetOwningPlayer(WX7)) then
            if TV7(GetOwningPlayer(IH7))then
                call SetUnitOwner(IH7,A7[0],false)
            else
                call SetUnitOwner(IH7,Z7[0],false)
            endif
        endif
        if GetUnitTypeId(IH7)!=0 then
        call UnitRemoveBuffs(IH7,true,true)
        call YW8(IH7,0,0)
        endif
        if GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(IH7) then
        call B67(WX7,IH7,1,100000)
        endif
        if GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(IH7) then
        call B67(WX7,IH7,2,100000)
        endif
        if GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(IH7) then
        call B67(WX7,IH7,3,100000)
        endif
    endif
elseif (b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER) and b1060GetTriggerUnit==WX7 and b1060GetIssuedOrderId<852000 then
    call KR7(WX7)
else
    // Only the existing Infest controller maintains the friendly-host visual.
    // Do not re-hide on an exit branch, poll ability objects, or add a timer.
    // Morphs and displacement cleanup can overwrite native collision while
    // the cached UNIT_PATHING bit is unchanged. Reassert before host follow.
    call MHUnit_SetPathType(WX7,UNIT_PATH_TYPE_FLY)
    call MHUnit_SetCollisionType(WX7,UNIT_COLLISION_TYPE_AIR,UNIT_COLLISION_TYPE_NONE)
    call SaveBoolean(UnitDataHashTable,GetHandleId(WX7),UNIT_PATHING,true)
    call SetUnitPathing(WX7,false)
    if HaveSavedReal(L7,GetHandleId(WX7),StringHash("SuijiDogInfestRestoreBarHeight")) then
        call SetUnitScale(WX7,0.,0.,0.)
        call SetUnitVertexColor(WX7,$FF,$FF,$FF,0)
    endif
    if GetUnitX(WX7)!=GetUnitX(IH7) or GetUnitY(WX7)!=GetUnitY(IH7) then
        call SetUnitX(WX7,GetUnitX(IH7))
        call SetUnitY(WX7,GetUnitY(IH7))
    endif
endif
if IsTriggerEnabled(t) and GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(WX7) and UnitAlive(IH7) and IsUnitType(IH7,UNIT_TYPE_HERO) and IsUnitEnemy(IH7,GetOwningPlayer(WX7)) and now-last_attack>=1. then
    call NQ7(I97,"Last_Attack",now)
    call MNGJ(WX7,IH7)
    if IsTriggerEnabled(t) and GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(WX7) and UnitAlive(IH7) then
    call XGZN(WX7,IH7)
    endif
    if IsTriggerEnabled(t) and GetUnitTypeId(WX7)!=0 and GetUnitTypeId(IH7)!=0 and UnitAlive(WX7) and UnitAlive(IH7) then
    call XGSY(WX7,IH7)
    endif
endif
if IsTriggerEnabled(t) then
call RemoveSavedBoolean(L7,I97,StringHash("B1028InfestBusy"))
endif
set t=null
set IH7=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiMode_DogInfestHelpBlocked takes unit suijiInfestHelpCaster,unit suijiInfestHelpTarget returns boolean
if suijiInfestHelpCaster==null or suijiInfestHelpTarget==null or GetUnitTypeId(suijiInfestHelpCaster)==0 or GetUnitTypeId(suijiInfestHelpTarget)==0 then
return false
endif
return IsUnitType(suijiInfestHelpTarget,UNIT_TYPE_HERO) and GetOwningPlayer(suijiInfestHelpCaster)!=GetOwningPlayer(suijiInfestHelpTarget) and IsUnitAlly(suijiInfestHelpTarget,GetOwningPlayer(suijiInfestHelpCaster)) and OO7(GetHandleId(GetOwningPlayer(suijiInfestHelpTarget)),"DisableHelp")
endfunction
function SuijiMode_DogInfestHelpNotice takes unit suijiInfestNoticeCaster,unit suijiInfestNoticeTarget returns nothing
if suijiInfestNoticeCaster==null or suijiInfestNoticeTarget==null or GetUnitTypeId(suijiInfestNoticeCaster)==0 or GetUnitTypeId(suijiInfestNoticeTarget)==0 then
return
endif
if IsUnitType(suijiInfestNoticeTarget,UNIT_TYPE_HERO)==false or GetOwningPlayer(suijiInfestNoticeCaster)==GetOwningPlayer(suijiInfestNoticeTarget) or IsUnitAlly(suijiInfestNoticeTarget,GetOwningPlayer(suijiInfestNoticeCaster))==false then
return
endif
// The spell event is already synchronized. Only chat rendering is local;
// do not send another sync event or change gameplay in this branch.
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(suijiInfestNoticeCaster)) then
call EXDisplayChat(GetOwningPlayer(suijiInfestNoticeCaster),1,"|cFFFFCC00感染提示：|r可以使用 -disablehelp：拒绝队友对自己释放感染，-enablehelp：恢复接受。")
endif
endfunction
function SFF takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=null
local integer OB7=0
local trigger SGF=null
local integer level=0
local string SHF
local string SIF
local string SJF
local string boom1
local string boom2
local string boom3
local integer id=GetUnitTypeId(WI7)
if WI7==null or m5==null or WI7==m5 or id==0 or GetUnitTypeId(m5)==0 or UnitAlive(WI7)==false or UnitAlive(m5)==false or LoadInteger(L7,GetHandleId(WI7),4310)==1 then
set WI7=null
set m5=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set level=SuijiMode_GetPairCastLevel(WI7,B287_GetSpellAbilityId(),'A0SW','A4FR')
if id=='Z00C' then
    set SHF="model\\Hero_Lifestealer_N2S_T_Target.mdl"
    set SIF="model\\Hero_Lifestealer_N2S_T_Tip_1.mdl"
    set SJF="model\\Hero_Lifestealer_N2S_T_Tip_2.mdl"
    set boom1="model\\Hero_Lifestealer_N2S_T_Boom_1.mdl"
    set boom2="model\\Hero_Lifestealer_N2S_T_Boom_2.mdl"
    set boom3="model\\Hero_Lifestealer_N2S_T_Boom_3.mdl"
else
    set SHF="Objects\\Spawnmodels\\Naga\\NagaBlood\\NagaBloodWindserpent.mdl"
    set SIF="Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBase.mdl"
    set SJF="Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl"
    set boom1="Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl"
    set boom2="tx\\dog\\N'aix_T.mdl"
    set boom3="tx\\dog\\N'aix_T1.mdl"
endif
if IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(WI7))and WG7(GetLocalPlayer())==false then
set SHF=""
set SIF=""
set SJF=""
endif
call UnitRemoveBuffs(WI7,true,true)
call YW8(WI7,0,0)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A0SW',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A4FR',false)
call XF7(WI7,'A0SX')
call SetUnitInvulnerable(WI7,true)
call SaveInteger(L7,GetHandleId(WI7),4310,1)
call SaveTriggerHandle(L7,GetHandleId(WI7),StringHash("SuijiDogInfestTrigger"),t)
call SuijiMode_DogInfestEnableInsideCasting(WI7)
call NT7(OB7,"Target",m5)
call NT7(OB7,"Hero",WI7)
call SavePlayerHandle(L7,OB7,StringHash("SuijiDogInfestCasterOwner"),GetOwningPlayer(WI7))
if id=='Z00C' then
    call DestroyEffect(AddSpecialEffectTarget(SHF,m5,"chest"))
    call NU7(OB7,"FX",AddSpecialEffectTarget(SIF,m5,"origin"))
    call NU7(OB7,"FX3",AddSpecialEffectTarget(SJF,m5,"chest"))
else
    call DestroyEffect(AddSpecialEffectTarget(SHF,m5,"overhead"))
    call NU7(OB7,"FX",AddSpecialEffectTarget(SIF,m5,"overhead"))
    call NU7(OB7,"FX3",AddSpecialEffectTarget(SJF,m5,"overhead"))
endif
call NP7(OB7,"Level",level)
call NQ7(OB7,"Time",GetGameTime())
call NQ7(OB7,"Last_Attack",0.)
call NR7(OB7,"boom1",boom1)
call NR7(OB7,"boom2",boom2)
call NR7(OB7,"boom3",boom3)
if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER then
call NP7(OB7,"ISAI",1)
endif
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t, WI7, EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function SEF))
// Disable locomotion for the occupant, not all commands or the host. The
// existing controller can still position it and accept spells/Consume.
call SuijiMode_DogInfestLockMovement(WI7)
// Register cleanup before touching the presentation-only bar anchor. Keep
// the hero selectable/castable and leave the host and global MP-bar option alone.
if IsUnitAlly(m5,GetOwningPlayer(WI7)) then
call SuijiMode_DogInfestHideAllyBars(WI7)
call SuijiMode_DogInfestAddHostLife(OB7,WI7,m5)
call SuijiMode_DogInfestHelpNotice(WI7,m5)
endif
if IsUnitType(m5,UNIT_TYPE_HERO) and IsUnitEnemy(m5,GetOwningPlayer(WI7)) then
    call Z57(m5,'A4ES', 1, 3,0)
    call YS7_by_scale("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl",m5,"overhead",3,2)
endif
if IsUnitType(m5,UNIT_TYPE_HERO)==false and IsUnitIllusion(m5)==false and (ASA(m5) and not B1055IsLaneBoss(m5))==false then
    call NS7(OB7,"SuijiDogInfestTemporaryHost",true)
    call NS7(OB7,"SuijiDogInfestHostHadExit",GetUnitAbilityLevel(m5,'A0SX')>0)
    call NS7(OB7,"SuijiDogInfestHostHadCargo",GetUnitAbilityLevel(m5,'ACmi')>0)
    call SavePlayerHandle(L7,OB7,StringHash("SuijiDogInfestHostOwner"),GetOwningPlayer(m5))
    call NQ7(OB7,"SuijiDogInfestHostMoveSpeed",GetUnitMoveSpeed(m5))
    call XF7(m5,'A0SX')
    call UnitAddAbility(m5,'ACmi')
    call TriggerRegisterUnitEvent(t, m5, EVENT_UNIT_ISSUED_ORDER)
    if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_USER then
        call XF7(WI7,'A4FM')
    else
        call NS7(OB7,"SuijiDogInfestHostControlled",true)
        call XGKZ(WI7,m5)
    endif
endif
set t=null
set SGF=null
set WI7=null
set m5=null
endfunction
//感染
function SuijiMode_DogInfestIsInsideHost takes unit suijiDogInfestHero returns boolean
if suijiDogInfestHero==null or GetUnitTypeId(suijiDogInfestHero)==0 then
return false
endif
return LoadInteger(L7,GetHandleId(suijiDogInfestHero),4310)==1
endfunction
function SKF takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if (B287_GetSpellAbilityId()=='A0SW' or B287_GetSpellAbilityId()=='A4FR') and SuijiMode_DogInfestIsInsideHost(b1060GetTriggerUnit)==false and ((IsUnitEnemy(GetSpellTargetUnit(),GetOwningPlayer(b1060GetTriggerUnit)))==false or WQ7(GetSpellTargetUnit())==false) then
// Recheck at effect time: the target can toggle help during cast windup.
if SuijiMode_DogInfestHelpBlocked(b1060GetTriggerUnit,GetSpellTargetUnit()) then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),"该队友已使用 -disablehelp，拒绝感染。")
else
call SFF()
endif
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SMF takes nothing returns boolean
local unit infestCaster1056=GetTriggerUnit()
local unit infestTarget1056=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A0SW' or B287_GetSpellAbilityId()=='A4FR' then
    if SuijiMode_DogInfestIsInsideHost(infestCaster1056) then
        call KR7(infestCaster1056)
        call X37(GetOwningPlayer(infestCaster1056),"无法感染此目标：当前已在宿主体内。")
    elseif SuijiMode_DogInfestHelpBlocked(infestCaster1056,infestTarget1056) then
        call KR7(infestCaster1056)
        call X37(GetOwningPlayer(infestCaster1056),"该队友已使用 -disablehelp，拒绝感染。")
    elseif B1055IsLaneBoss(infestTarget1056) then
        set infestCaster1056=null
        set infestTarget1056=null
        return false
    elseif IsUnitEnemy(infestTarget1056,GetOwningPlayer(infestCaster1056))and(IsUnitIllusion(infestTarget1056) or (ASA(infestTarget1056) and not B1055IsLaneBoss(infestTarget1056))) then
        call KR7(infestCaster1056)
        call X37(GetOwningPlayer(infestCaster1056),"无法感染此目标：目标被识别为幻象或禁止感染单位（类型="+I2S(GetUnitTypeId(infestTarget1056))+"）。")
    elseif IsUnitEnemy(infestTarget1056,GetOwningPlayer(infestCaster1056)) and IsUnitType(infestTarget1056,UNIT_TYPE_HERO) and SuijiMode_ScepterRegistryIsActive(infestCaster1056,'A0SW')==false then
        call KR7(infestCaster1056)
        call X37(GetOwningPlayer(infestCaster1056),"无法感染此目标：感染敌方英雄需要神杖。")
    elseif KW7(infestTarget1056) then
        call KR7(infestCaster1056)
        call X37(GetOwningPlayer(infestCaster1056),"无法感染此目标：目标是信使。")
    endif
endif
set infestCaster1056=null
set infestTarget1056=null
return false
endfunction
function ZCDogSkill takes nothing returns nothing
    local integer i=1
    loop
    exitwhen i>11
    if i==6 then
        set i=7
    endif
    call ShowDogSkill(KU4[i])
    set i=i+1
    endloop
endfunction
function MO8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SKF))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function SMF))
set t=null
call MHAbility_SetHookOrder('A0SX',852543)
call MHAbility_SetHookOrder('A4FM',852544)
call ZCDogSkill()
endfunction
//窒息之刃
function XQF takes nothing returns nothing
	local integer h=GetHandleId(GetTriggeringTrigger())
	local unit ZX7=U22
	local unit IH7=W22
    local integer BC7 = LoadInteger(TABLE_HY, h, 10)
	local real VW9=BC7*75
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer MQQ=B287_GetUnitAbilityLevel(ZX7,'A03Q')
	local integer id=GetPlayerId(GetOwningPlayer(ZX7))
call XF7(BB7,'A0YL')
call SetUnitAbilityLevel(BB7,'A0YL',BC7)
	call B947IssueTargetOrderById("XQF @ war3map.j:217492 (B968)",BB7,$D006B,IH7)
	if SuijiMode_ScepterRegistryIsActive(ZX7,'A0YM') then
	call MNGJ(ZX7,IH7)
	endif
	if UnitAlive(IH7) then
		if IsUnitType(IH7,UNIT_TYPE_HERO) or IsUnitIllusion(IH7) or AS7(IH7) then
			set VW9=VW9/3
		endif
		if MQQ>0 and GetPrdRandom(ZX7, 'A0YM', 16+3*MQQ) then
			set VW9=VW9*(1.5+MQQ)
			call YW7(I2S(R2I(VW9))+"!",3,IH7,0.02,255,0,0,255)
			call CreateUnit(GetOwningPlayer(IH7),'e050',GetUnitX(IH7),GetUnitY(IH7),Face_zxzr[id])
		endif
		call B67(ZX7,IH7,3,VW9)
        call LINGXIA(ZX7,IH7)
	endif
	set ZX7=null
	set IH7=null
	set BB7=null
	endfunction
function B846_CaptureAttackDamage takes nothing returns boolean
local unit stackSource=MHDamagingEvent_GetSource()
local unit stackTarget=MHEvent_GetUnit()
local trigger stackPair=null
local integer stackPairHandle=0
local real stackRaw=MHDamagingEvent_GetDamage()
// Read the actual pre-armor roll, before Totem's post-damage cleanup. Reuse
// the existing bounded attacker/target listener; never scan units or abilities.
if FKK and Fe==false and stackRaw>0. and stackTarget!=null and MHDamagingEvent_IsPhysical() and MHDamagingEvent_GetDmgType()==DAMAGE_TYPE_NORMAL and B846_IsStackOwner(stackSource) then
set stackPair=LoadTriggerHandle(TABLE_P,GetHandleId(stackSource),GetHandleId(stackTarget))
if stackPair!=null and IsTriggerEnabled(stackPair) then
set stackPairHandle=GetHandleId(stackPair)
if LoadInteger(TABLE_HY,stackPairHandle,0)>0 and OO7(GetHandleId(stackSource),"SuijiFlakSideGunnerAttacking")==false and OO7(GetHandleId(stackSource),"B845FlakSecondaryHit")==false then
call SaveReal(TABLE_HY,stackPairHandle,StringHash("B846StackRaw"),stackRaw)
call SaveReal(TABLE_HY,stackPairHandle,StringHash("B846StackAt"),TimerGetElapsed(W))
call SaveBoolean(TABLE_HY,stackPairHandle,StringHash("B846StackCaptured"),true)
endif
endif
endif
set stackSource=null
set stackTarget=null
set stackPair=null
return false
endfunction
function B846_InitCapture takes nothing returns nothing
local trigger stackCaptureTrigger=CreateTrigger()
call MHDamagingEvent_Register(stackCaptureTrigger)
call TriggerAddCondition(stackCaptureTrigger,Condition(function B846_CaptureAttackDamage))
set stackCaptureTrigger=null
endfunction
function B846_ResolveStackAttack takes unit stackSource,unit stackTarget,real stackEventDamage,integer stackPairHandle returns nothing
local real stackRaw=LoadReal(TABLE_HY,stackPairHandle,StringHash("B846StackRaw"))
local real stackRate=1.
local real stackExtra=0.
local real stackTotal=stackEventDamage
local integer stackCritSkill=0
local integer stackTideLevel=B287_GetUnitAbilityLevel(stackSource,'A13T')
local boolean stackPunch=false
local boolean stackTide=false
local boolean stackOldFKK=FKK
if B846_IsStackOwner(stackSource)==false or LoadBoolean(TABLE_HY,stackPairHandle,StringHash("B846StackCaptured"))==false then
return
endif
call SaveBoolean(TABLE_HY,stackPairHandle,StringHash("B846StackCaptured"),false)
if stackRaw<=0. or TimerGetElapsed(W)-LoadReal(TABLE_HY,stackPairHandle,StringHash("B846StackAt"))>.01 then
return
endif
call B846_ConsumeTotem(stackSource,stackTarget)
if IsUnitEnemy(stackTarget,GetOwningPlayer(stackSource))==false or IsUnitType(stackTarget,UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(stackTarget,'A04R')>0 then
return
endif
call SaveBoolean(TABLE_HY,stackPairHandle,StringHash("B846StackHandled"),true)
set stackPunch=OT7(stackSource,"WalrusPunch|Active") and OE7(GetHandleId(stackSource),"WalrusPunch|Clear")!=null
set stackTide=stackTideLevel>0 and OO7(GetHandleId(stackSource),"WaterSword|Active") and ISPH(stackSource)==false
set stackRate=RMaxBJ(1.,SetUnitCriticalStrike(stackSource,stackTarget,false))
set stackCritSkill=LoadInteger(ExtraHT,'bjsk',GetHandleId(stackSource))
// The ready punch owns its effect even when a higher crit wins the number.
if stackPunch then
if stackRate<3.5 then
set stackCritSkill='A1YQ'
endif
set stackRate=RMaxBJ(stackRate,3.5)
endif
if BrewmasterBrawler_GetLevel(stackSource)>0 and BrewmasterBrawler_TryCrit(stackSource) then
if stackRate<2. then
set stackCritSkill='A0MX'
endif
set stackRate=RMaxBJ(stackRate,2.)
endif
set stackTotal=stackEventDamage*stackRate
// Retain this map's existing armor-ignoring punch rule; only unify its
// attack snapshot and max-crit selection, not an unrelated balance nerf.
if stackPunch then
set stackTotal=stackRaw*stackRate
if LoadUnitHandle(L7,GetHandleId(stackSource),StringHash("B1010GuiseTarget"))==stackTarget then
call SaveBoolean(L7,GetHandleId(stackSource),StringHash("B1010GuiseArmorIgnored"),true)
endif
endif
set stackExtra=RMaxBJ(0.,stackTotal-stackEventDamage)
// Modify the original hit once: do not send already-armored damage through
// armor a second time and do not multiply independently rolled crits.
if stackRate>1. then
call YDWESetEventDamage(stackTotal)
call YW7(I2S(R2I(stackRaw*stackRate))+"!",5,stackSource,.024,255,0,0,255)
if stackCritSkill=='A03N' and IsUnitIllusion(stackTarget)==false then
call SetWidgetLife(stackSource,GetWidgetLife(stackSource)+stackEventDamage*stackRate*(.2+.1*B287_GetUnitAbilityLevel(stackSource,'A03N'))*DGH_BUFF(stackSource))
elseif stackCritSkill=='A03Q' then
call CreateUnit(GetOwningPlayer(stackTarget),'e050',GetUnitX(stackTarget),GetUnitY(stackTarget),GetUnitFacing(stackSource)+180.)
elseif stackCritSkill=='ABcr' then
call YS7("tx\\snk\\SNK_ZSDJ.mdx",stackTarget,"origin",2.)
elseif stackCritSkill=='A0MX' then
call YW7("醉拳!",5,stackTarget,.024,255,110,70,255)
endif
endif
// Clear ready-state ownership before any secondary damage can re-enter.
if stackPunch then
call TriggerEvaluate(OE7(GetHandleId(stackSource),"WalrusPunch|Clear"))
call HXSQ(stackSource,stackTarget)
endif
if stackTide then
call NS7(GetHandleId(stackSource),"WaterSword|Active",false)
call NQ7(GetHandleId(stackSource),"WaterSword|LastUsed",KQ7())
call UnitRemoveAbility(stackSource,'A11O')
call UnitRemoveAbility(stackSource,'A11R')
endif
set FKK=false
if stackExtra>0. then
call BJ_EXTRA(stackSource,stackTarget,stackExtra)
call MNFL(stackSource,stackTarget,stackRate-1.,false)
endif
if stackTide then
call UnitCleave(stackSource,stackTarget,400.+50.*stackTideLevel,stackRaw*stackRate,"Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl","chest",false)
endif
set FKK=stackOldFKK
endfunction
function TTA takes unit u, unit target, real damage returns nothing
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
	// Confirmed real primary-hit path, not ATTACKED windup or synthetic effects.
	call SuijiMode_FlakRandomOnAttack(u,target)
	set WXX = u
	set YXX = target
	set ZXX = damage
	set EOO = GetHandleId(b1060GetTriggeringTrigger)
	call SaveBoolean(TABLE_HY,EOO,StringHash("B846StackHandled"),false)
    if MRPH(u) then
        set b1060GetTriggeringTrigger=null
        return
    endif
	call B846_ResolveStackAttack(u,target,damage,EOO)
	call ExecuteAttackEvent(0)
	if not LoadBoolean(TABLE_HY, EOO, 10) then	//攻击者非英雄，非熊灵则返回，不包含镜像
		set b1060GetTriggeringTrigger=null
		return
	endif
	//攻击者是英雄或熊灵，非镜像
	call ExecuteAttackEvent(1)	
	//攻击目标非建筑，非守卫
	if not LoadBoolean(TABLE_HY, EOO, 11) and LoadBoolean(TABLE_HY, EOO, 14) then
		call ExecuteAttackEvent(2)	//攻击目标非建筑，非守卫
		if LoadBoolean(TABLE_HY, EOO, 15) then	//攻击目标是敌对单位
			call ExecuteAttackEvent(3)	//攻击目标非建筑，非守卫，非友军
			if IsMagicImmuneUnit(target)== false then	//攻击目标非魔免
				call ExecuteAttackEvent(4)	//攻击目标非建筑，非守卫，非友军，非魔免
			endif
		endif
	endif
set b1060GetTriggeringTrigger=null
endfunction
//电棍抽攻
function SuijiMode_TriggerSyntheticAttackEffects takes unit source,unit target returns nothing
local integer h=0
local boolean gear964previous=B964Synthetic
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return
endif
set B964Synthetic=true
set h=GetHandleId(source)
set WXX=source
set YXX=target
set PVV=false
set EOO=h
call SaveBoolean(TABLE_HY,h,10,IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source))
call SaveBoolean(TABLE_HY,h,11,IsUnitType(target,UNIT_TYPE_STRUCTURE))
call SaveBoolean(TABLE_HY,h,14,GetUnitAbilityLevel(target,'A04R')==0)
call SaveBoolean(TABLE_HY,h,15,IsUnitEnemy(source,GetOwningPlayer(target)))
if IsUnitType(source,UNIT_TYPE_HERO) or AS7(source) or IsUnitIllusion(source) then
call ExecuteAttackEvent(0)
call ExecuteAttackEvent(1)
if LoadBoolean(TABLE_HY,h,11)==false and LoadBoolean(TABLE_HY,h,14) then
call ExecuteAttackEvent(2)
if LoadBoolean(TABLE_HY,h,15) then
call ExecuteAttackEvent(3)
if IsMagicImmuneUnit(target)==false then
call ExecuteAttackEvent(4)
endif
endif
endif
endif
set B964Synthetic=gear964previous
endfunction
// B1078: bounded, synchronous Scepter attacks; never issue an attack order.
function B1078Live takes unit bonusUnit1078 returns boolean
return bonusUnit1078!=null and GetUnitTypeId(bonusUnit1078)!=0 and UnitAlive(bonusUnit1078)
endfunction
function B1078Target takes unit bonusSource1078,unit bonusTarget1078 returns boolean
return B1078Live(bonusSource1078) and B1078Live(bonusTarget1078) and IsUnitEnemy(bonusTarget1078,GetOwningPlayer(bonusSource1078)) and not IsHideUnit(bonusTarget1078) and not AE7(bonusTarget1078) and GetUnitAbilityLevel(bonusTarget1078,'A04R')==0 and GetUnitAbilityLevel(bonusTarget1078,'Avul')==0 and IsUnitVisible(bonusTarget1078,GetOwningPlayer(bonusSource1078))
endfunction
function B1078Orb takes unit bonusSource1078,unit bonusTarget1078,integer bonusSkill1078 returns nothing
if B1078Target(bonusSource1078,bonusTarget1078) and SuijiMode_UnifiedOrbEnabled(bonusSource1078,bonusSkill1078) then
call SuijiMode_UnifiedOrbApply(bonusSource1078,bonusTarget1078,bonusSkill1078)
endif
endfunction
function B1078AttackPassives takes nothing returns nothing
local unit bonusSource1078=B1078AttackSource
local unit bonusTarget1078=B1078AttackTarget
if not MRPH(bonusSource1078) then
// MNGJ already owns equipment, criticals, cleave and lifesteal. Do not dispatch
// the ordinary attack callback list too: it would roll those effects twice.
call B1078Orb(bonusSource1078,bonusTarget1078,'A026')
call B1078Orb(bonusSource1078,bonusTarget1078,'A09V')
call B1078Orb(bonusSource1078,bonusTarget1078,'A0DY')
call B1078Orb(bonusSource1078,bonusTarget1078,'AHfa')
call B1078Orb(bonusSource1078,bonusTarget1078,'A0LZ')
call B1078Orb(bonusSource1078,bonusTarget1078,'A0OI')
call B1078Orb(bonusSource1078,bonusTarget1078,'A0QN')
endif
set bonusSource1078=null
set bonusTarget1078=null
endfunction
function B1078Attack takes unit bonusSource1078,unit bonusTarget1078 returns nothing
local unit savedSource1078=WXX
local unit savedTarget1078=YXX
local integer savedHandle1078=EOO
local boolean savedPV1078=PVV
local boolean savedSynthetic1078=B964Synthetic
local boolean savedFKK1078=FKK
local integer bonusHandle1078=GetHandleId(bonusSource1078)
local boolean savedOrb1078=OO7(bonusHandle1078,"SuijiUnifiedOrbRunning")
local boolean saved10_1078=LoadBoolean(TABLE_HY,bonusHandle1078,10)
local boolean saved11_1078=LoadBoolean(TABLE_HY,bonusHandle1078,11)
local boolean saved14_1078=LoadBoolean(TABLE_HY,bonusHandle1078,14)
local boolean saved15_1078=LoadBoolean(TABLE_HY,bonusHandle1078,15)
if B1078AttackSource==null and B1078Target(bonusSource1078,bonusTarget1078) and not IsUnitIllusion(bonusSource1078) then
set B1078AttackSource=bonusSource1078
set B1078AttackTarget=bonusTarget1078
set B1078AttackLanded=false
set B964Synthetic=true
set FKK=false
set WXX=bonusSource1078
set YXX=bonusTarget1078
set EOO=bonusHandle1078
set PVV=false
// Do not consume an unrelated native attack's pending orb sequence.
call NS7(bonusHandle1078,"SuijiUnifiedOrbRunning",true)
call MNGJ(bonusSource1078,bonusTarget1078)
call NS7(bonusHandle1078,"SuijiUnifiedOrbRunning",savedOrb1078)
call SaveBoolean(TABLE_HY,bonusHandle1078,10,saved10_1078)
call SaveBoolean(TABLE_HY,bonusHandle1078,11,saved11_1078)
call SaveBoolean(TABLE_HY,bonusHandle1078,14,saved14_1078)
call SaveBoolean(TABLE_HY,bonusHandle1078,15,saved15_1078)
set B1078AttackSource=null
set B1078AttackTarget=null
set B1078AttackLanded=false
set B964Synthetic=savedSynthetic1078
set FKK=savedFKK1078
set WXX=savedSource1078
set YXX=savedTarget1078
set EOO=savedHandle1078
set PVV=savedPV1078
endif
set savedSource1078=null
set savedTarget1078=null
endfunction
// B1097: scoped attack context, restored even when an item callback kills a unit.
function B1097SleightAttack takes nothing returns nothing
local unit sleightPreviousUnit1097=B1097SleightAttackUnit
local unit sleightPreviousTarget1097=B1097SleightAttackTarget
local integer sleightPreviousLevel1097=B1097SleightAttackLevel
set B1097SleightAttackUnit=B1097SleightEntryUnit
set B1097SleightAttackTarget=B1097SleightEntryTarget
set B1097SleightAttackLevel=B1097SleightEntryLevel
call B1078Attack(B1097SleightAttackUnit,B1097SleightAttackTarget)
set B1097SleightAttackUnit=sleightPreviousUnit1097
set B1097SleightAttackTarget=sleightPreviousTarget1097
set B1097SleightAttackLevel=sleightPreviousLevel1097
set sleightPreviousUnit1097=null
set sleightPreviousTarget1097=null
endfunction
function B1079AttackHit takes nothing returns nothing
local integer missileHandle1079=GetHandleId(GetTriggeringTrigger())
local unit missileSource1079=LoadUnitHandle(TABLE_HY,missileHandle1079,43)
local unit missileTarget1079=LoadUnitHandle(TABLE_HY,missileHandle1079,30)
// NHX owns flight, disjoint and cleanup; resolve the existing attack once.
call B1078Attack(missileSource1079,missileTarget1079)
set missileSource1079=null
set missileTarget1079=null
endfunction
function B1079LaunchAttack takes unit missileSource1079,unit missileTarget1079 returns nothing
local trigger missileTrigger1079=null
local real missileSpeed1079=0.
local string missileModel1079=null
if B1078Target(missileSource1079,missileTarget1079) and not IsUnitIllusion(missileSource1079) then
if IsUnitType(missileSource1079,UNIT_TYPE_MELEE_ATTACKER) then
call B1078Attack(missileSource1079,missileTarget1079)
else
// Reuse B964's audited unit-definition projectile model/speed fields.
set missileSpeed1079=MHUnit_GetDefDataReal(GetUnitTypeId(missileSource1079),$79)
set missileModel1079=MHUnit_GetDefDataStr(GetUnitTypeId(missileSource1079),$89)
if missileSpeed1079<=0. then
set missileSpeed1079=1250.
endif
if missileModel1079==null or missileModel1079=="" or missileModel1079=="_" then
set missileModel1079="Abilities\\Weapons\\FaerieDragonMissile\\FaerieDragonMissile.mdl"
endif
set missileTrigger1079=NHX(missileSource1079,missileTarget1079,'h30C',"B1079AttackHit",missileSpeed1079,true,missileModel1079)
call SaveReal(TABLE_HY,GetHandleId(missileTrigger1079),'B179',TimerGetElapsed(W)+10.)
endif
endif
set missileTrigger1079=null
set missileModel1079=null
endfunction
function B1078Phase takes nothing returns nothing
local unit phaseSource1078=GetTriggerUnit()
local unit phaseTarget1078=null
local group phaseGroup1078=null
local real phaseRange1078=0.
if B287_GetSpellAbilityId()=='A0SB' and B1078Live(phaseSource1078) and not IsUnitIllusion(phaseSource1078) and SuijiMode_ScepterRegistryIsActive(phaseSource1078,'A0SB') then
set phaseRange1078=GetUnitState(phaseSource1078,UNIT_STATE_ATTACK1_RANGE)
if phaseRange1078>0. then
set phaseGroup1078=CreateGroup()
call GroupEnumUnitsInRange(phaseGroup1078,GetUnitX(phaseSource1078),GetUnitY(phaseSource1078),phaseRange1078,null)
loop
set phaseTarget1078=FirstOfGroup(phaseGroup1078)
exitwhen phaseTarget1078==null
call GroupRemoveUnit(phaseGroup1078,phaseTarget1078)
call B1079LaunchAttack(phaseSource1078,phaseTarget1078)
endloop
call DestroyGroup(phaseGroup1078)
endif
endif
set phaseSource1078=null
set phaseTarget1078=null
set phaseGroup1078=null
endfunction
function B1078DamageObserve takes nothing returns boolean
if B1078DamageSource!=null and MHDamageEvent_GetSource()==B1078DamageSource and MHEvent_GetUnit()==B1078DamageTarget and MHDamageEvent_GetDmgTypeInt()==GetHandleId(DAMAGE_TYPE_FIRE) and MHDamageEvent_GetDamage()>0. then
set B1078DamageLanded=true
endif
return false
endfunction
function B1078ShukDestroy takes timer shukTimer1078 returns nothing
local integer shukHandle1078=GetHandleId(shukTimer1078)
local unit shukSource1078=LoadUnitHandle(B1078Store,shukHandle1078,0)
local group shukHit1078=LoadGroupHandle(B1078Store,shukHandle1078,1)
local group shukMarks1078=LoadGroupHandle(B1078Store,shukHandle1078,2)
local group shukScan1078=LoadGroupHandle(B1078Store,shukHandle1078,8)
if LoadTimerHandle(B1078Store,GetHandleId(shukSource1078),0)==shukTimer1078 then
call RemoveSavedHandle(B1078Store,GetHandleId(shukSource1078),0)
endif
call PauseTimer(shukTimer1078)
call DestroyGroup(shukHit1078)
call DestroyGroup(shukMarks1078)
call DestroyGroup(shukScan1078)
call FlushChildHashtable(B1078Store,shukHandle1078)
call DestroyTimer(shukTimer1078)
set shukSource1078=null
set shukHit1078=null
set shukMarks1078=null
set shukScan1078=null
endfunction
function B1078ShukVolley takes nothing returns nothing
local timer shukTimer1078=GetExpiredTimer()
local integer shukHandle1078=GetHandleId(shukTimer1078)
local unit shukSource1078=LoadUnitHandle(B1078Store,shukHandle1078,0)
local unit shukTarget1078=null
local group shukMarks1078=LoadGroupHandle(B1078Store,shukHandle1078,2)
local real shukNow1078=TimerGetElapsed(W)
if B1078Live(shukSource1078) and B287_GetUnitAbilityLevel(shukSource1078,'A0CA')>0 and SuijiMode_ScepterRegistryIsActive(shukSource1078,'A0CA') and GetUnitAbilityLevel(shukSource1078,'BHfs')==0 then
loop
set shukTarget1078=FirstOfGroup(shukMarks1078)
exitwhen shukTarget1078==null
call GroupRemoveUnit(shukMarks1078,shukTarget1078)
if LoadReal(B1078Store,shukHandle1078,GetHandleId(shukTarget1078))>shukNow1078 and B1078Target(shukSource1078,shukTarget1078) and IsUnitInRange(shukSource1078,shukTarget1078,1200.) then
call B1079LaunchAttack(shukSource1078,shukTarget1078)
endif
endloop
endif
call B1078ShukDestroy(shukTimer1078)
set shukTimer1078=null
set shukSource1078=null
set shukTarget1078=null
set shukMarks1078=null
endfunction
function B1078ShukTick takes nothing returns nothing
local timer shukTimer1078=GetExpiredTimer()
local integer shukHandle1078=GetHandleId(shukTimer1078)
local unit shukSource1078=LoadUnitHandle(B1078Store,shukHandle1078,0)
local unit shukTarget1078=null
local group shukHit1078=LoadGroupHandle(B1078Store,shukHandle1078,1)
local group shukMarks1078=LoadGroupHandle(B1078Store,shukHandle1078,2)
local group shukScan1078=LoadGroupHandle(B1078Store,shukHandle1078,8)
local real shukNow1078=TimerGetElapsed(W)
local boolean shukBuff1078=false
local unit savedDamageSource1078=B1078DamageSource
local unit savedDamageTarget1078=B1078DamageTarget
local boolean savedDamageLanded1078=B1078DamageLanded
if not B1078Live(shukSource1078) or B287_GetUnitAbilityLevel(shukSource1078,'A0CA')<=0 then
call B1078ShukDestroy(shukTimer1078)
else
set shukBuff1078=GetUnitAbilityLevel(shukSource1078,'BHfs')>0
if shukBuff1078 then
call SaveBoolean(B1078Store,shukHandle1078,5,true)
endif
if shukNow1078>=LoadReal(B1078Store,shukHandle1078,4) or (not shukBuff1078 and (LoadBoolean(B1078Store,shukHandle1078,5) or shukNow1078>=LoadReal(B1078Store,shukHandle1078,7))) then
// One terminal callback: attacks occur 0.2 seconds after observed exit.
call TimerStart(shukTimer1078,.2,false,function B1078ShukVolley)
elseif shukBuff1078 then
call GroupClear(shukScan1078)
call GroupEnumUnitsInRange(shukScan1078,GetUnitX(shukSource1078),GetUnitY(shukSource1078),175.,null)
loop
set shukTarget1078=FirstOfGroup(shukScan1078)
exitwhen shukTarget1078==null or not B1078Live(shukSource1078)
call GroupRemoveUnit(shukScan1078,shukTarget1078)
if B1078Live(shukTarget1078) and not IsUnitInGroup(shukTarget1078,shukHit1078) and IsUnitEnemy(shukTarget1078,GetOwningPlayer(shukSource1078)) and not IsUnitType(shukTarget1078,UNIT_TYPE_STRUCTURE) and not IsUnitType(shukTarget1078,UNIT_TYPE_MECHANICAL) and not IsMagicImmuneUnit(shukTarget1078) and GetUnitAbilityLevel(shukTarget1078,'Avul')==0 and GetUnitAbilityLevel(shukTarget1078,'A04R')==0 and not IsHideUnit(shukTarget1078) then
call GroupAddUnit(shukHit1078,shukTarget1078)
set B1078DamageSource=shukSource1078
set B1078DamageTarget=shukTarget1078
set B1078DamageLanded=false
call B67(shukSource1078,shukTarget1078,1,60.+30.*LoadInteger(B1078Store,shukHandle1078,3))
if B1078DamageLanded and B1078Live(shukTarget1078) and SuijiMode_ScepterRegistryIsActive(shukSource1078,'A0CA') then
call GroupAddUnit(shukMarks1078,shukTarget1078)
call SaveReal(B1078Store,shukHandle1078,GetHandleId(shukTarget1078),shukNow1078+4.6)
endif
set B1078DamageSource=savedDamageSource1078
set B1078DamageTarget=savedDamageTarget1078
set B1078DamageLanded=savedDamageLanded1078
endif
endloop
endif
endif
set shukTimer1078=null
set shukSource1078=null
set shukTarget1078=null
set shukHit1078=null
set shukMarks1078=null
set shukScan1078=null
set savedDamageSource1078=null
set savedDamageTarget1078=null
endfunction
function B1078ShukStart takes nothing returns nothing
local unit shukSource1078=B1078EntryUnit
local timer shukTimer1078=null
local integer shukHandle1078=0
local real shukNow1078=TimerGetElapsed(W)
set B1078ShukHandled=false
if B1078Live(shukSource1078) and B1078Store!=null then
set shukTimer1078=LoadTimerHandle(B1078Store,GetHandleId(shukSource1078),0)
if not IsUnitIllusion(shukSource1078) and SuijiMode_ScepterRegistryIsActive(shukSource1078,'A0CA') then
if shukTimer1078==null then
set shukTimer1078=CreateTimer()
set shukHandle1078=GetHandleId(shukTimer1078)
call SaveUnitHandle(B1078Store,shukHandle1078,0,shukSource1078)
call SaveGroupHandle(B1078Store,shukHandle1078,1,CreateGroup())
call SaveGroupHandle(B1078Store,shukHandle1078,2,CreateGroup())
call SaveGroupHandle(B1078Store,shukHandle1078,8,CreateGroup())
call SaveTimerHandle(B1078Store,GetHandleId(shukSource1078),0,shukTimer1078)
else
set shukHandle1078=GetHandleId(shukTimer1078)
call GroupClear(LoadGroupHandle(B1078Store,shukHandle1078,1))
endif
// Do not run native Phoenix Fire and scripted Shukuchi damage together.
call UnitRemoveAbility(shukSource1078,'A0C9')
call SaveInteger(B1078Store,shukHandle1078,3,IMinBJ(4,IMaxBJ(1,B287_GetUnitAbilityLevel(shukSource1078,'A0CA'))))
call SaveReal(B1078Store,shukHandle1078,4,shukNow1078+4.6)
call SaveReal(B1078Store,shukHandle1078,7,shukNow1078+.4)
call SaveBoolean(B1078Store,shukHandle1078,5,false)
call TimerStart(shukTimer1078,.04,true,function B1078ShukTick)
set B1078ShukHandled=true
elseif shukTimer1078!=null then
call B1078ShukDestroy(shukTimer1078)
endif
endif
set shukSource1078=null
set shukTimer1078=null
endfunction
// B1081: native and OMG shields share one pre-mitigation damage owner.
// Only the converted A0MP/Y05U carriers participate; the boss ATBM toggle is separate.
function B1081ShieldLevel takes unit shieldUnit1081 returns integer
local integer shieldRank1081=0
if shieldUnit1081==null or GetUnitTypeId(shieldUnit1081)==0 then
return 0
endif
set shieldRank1081=IMaxBJ(GetUnitAbilityLevel(shieldUnit1081,'A0MP'),GetUnitAbilityLevel(shieldUnit1081,'Y05U'))
if shieldRank1081==0 and IsUnitIllusion(shieldUnit1081) then
set shieldRank1081=SuijiMode_GetIllusionPassiveBridgeLevel(shieldUnit1081,'A0MP')
endif
return IMinBJ(5,shieldRank1081)
endfunction
function B1081ShieldEfficiency takes integer shieldRank1081,boolean shieldIllusion1081 returns real
if shieldIllusion1081 then
return .8+.2*shieldRank1081
endif
return 1.4+.2*shieldRank1081
endfunction
function B1081ShieldOnDamaging takes nothing returns boolean
local unit shieldUnit1081=MHEvent_GetUnit()
local integer shieldRank1081=0
local real shieldDamage1081=MHDamagingEvent_GetDamage()
local real shieldMana1081=0.
local real shieldEfficiency1081=0.
local real shieldAbsorbed1081=0.
if shieldDamage1081>0. and shieldUnit1081!=null and GetUnitTypeId(shieldUnit1081)!=0 and UnitAlive(shieldUnit1081) and GetUnitAbilityLevel(shieldUnit1081,'Avul')==0 then
set shieldRank1081=B1081ShieldLevel(shieldUnit1081)
if shieldRank1081>0 then
set shieldMana1081=GetUnitState(shieldUnit1081,UNIT_STATE_MANA)
if shieldMana1081>0. then
set shieldEfficiency1081=B1081ShieldEfficiency(shieldRank1081,IsUnitIllusion(shieldUnit1081))
set shieldAbsorbed1081=RMinBJ(shieldDamage1081*.98,shieldMana1081*shieldEfficiency1081)
if MHDamagingEvent_SetDamage(shieldDamage1081-shieldAbsorbed1081) then
call SetUnitState(shieldUnit1081,UNIT_STATE_MANA,RMaxBJ(0.,shieldMana1081-shieldAbsorbed1081/shieldEfficiency1081))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",shieldUnit1081,"origin"))
endif
endif
endif
endif
set shieldUnit1081=null
return false
endfunction
function B1081ShieldInit takes nothing returns nothing
local trigger shieldTrigger1081=CreateTrigger()
call MHDamagingEvent_Register(shieldTrigger1081)
call TriggerAddCondition(shieldTrigger1081,Condition(function B1081ShieldOnDamaging))
set shieldTrigger1081=null
endfunction
function B1078Init takes nothing returns nothing
local trigger bonusTrigger1078=CreateTrigger()
set B1078Store=InitHashtable()
call YB7(bonusTrigger1078,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(bonusTrigger1078,function B1078Phase)
set bonusTrigger1078=CreateTrigger()
call MHDamageEvent_Register(bonusTrigger1078)
call TriggerAddCondition(bonusTrigger1078,Condition(function B1078DamageObserve))
set bonusTrigger1078=null
endfunction
function G4E takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local unit IH7=O77(I97,"Target")
local lightning G7E=OH7(I97,"Light")
local integer BC7=OM7(I97,"Level")
local real Cool=ON7(I97,"Cool")
local integer WF8=GetTriggerEvalCount(t)
local unit BB7=O77(I97,"Caster")
local real d=GetGameTime()
call MoveLightning(G7E,true,GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))
call SetUnitX(BB7,GetUnitX(IH7))
call SetUnitY(BB7,GetUnitY(IH7))
if KF7(GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))>800 or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call DestroyLightning(G7E)
call KillUnit(BB7)
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call F_E(ZX7,IH7,b1060GetTriggerUnit)
else
call F_E(ZX7,IH7,null)
endif
call UnitRemoveAbility(ZX7,'A4C2')
call NM7(I97)
call OZ7(t)
elseif WF8>80+BC7*20 then
call DestroyLightning(G7E)
call KillUnit(BB7)
call F_E(ZX7,IH7,null)
call UnitRemoveAbility(ZX7,'A4C2')
call NM7(I97)
call OZ7(t)
else
if ModuloInteger(WF8,20)==0 or WF8==1 then
call F0E(ZX7,(BC7*7)*R2I(WF8/ 20))
call F5E(IH7,(BC7*7)*R2I(WF8/ 20))
endif
if (WF8==1 or d>Cool) and AK7(ZX7)==false and IsUnitVisible(IH7,GetOwningPlayer(ZX7)) then
	call SuijiMode_TriggerSyntheticAttackEffects(ZX7,IH7)
	call MNGJ(ZX7,IH7)
if not MRPH(ZX7) and (GetUnitAbilityLevel(ZX7,'A7B0')>0 or GetUnitAbilityLevel(ZX7,'A7B2')>0) and GetPrdRandom(ZX7,'HJZL',30) then
call B964HJZL(ZX7,IH7)
endif
	call NQ7(I97,"Cool",d+Attack_Speed(ZX7))
endif
if WF8==1 then
    call LINGXIA(ZX7,IH7)
endif
endif
set t=null
set ZX7=null
set IH7=null
set G7E=null
set BB7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
//锚击
function CXMAOJI_BJ takes unit ZX7 returns real
    local real a
    local real b
    local real d
    local real BJ1
    local real BJ2
    set a=DPBJ_RATE(ZX7)
    set b=XJBJ_RATE(ZX7)
    set d=GetRandomReal(0,100)
    set BJ1=a*100.
    set BJ2=(b-a*b+a)*100.
    if a>0 and d<=BJ1 then
        return 2.4
    elseif b>0 and BJ1<d and d<=BJ2 then
        return 1.75
    endif
        return 1.
endfunction
function Get_Target_Attacked_Damge takes real damage, unit targetUnit returns real
	local real targetUnitArmor = GetUnitState(targetUnit, UNIT_STATE_ARMOR)
	local real reduceRatio = 1
	if IsFortDefenseTypeUnit(targetUnit) then
		set damage = damage * .5
	endif
	if targetUnitArmor >= 0 then
		set reduceRatio = 0.06 * targetUnitArmor / (0.06 * targetUnitArmor + 1)
		set reduceRatio = 1 - reduceRatio
	elseif targetUnitArmor < 0 then
		set reduceRatio = 2 - Pow(1 -0.06, -targetUnitArmor)
	endif
	set damage = damage * reduceRatio
	if IsUnitIllusion(targetUnit) then
		set damage = damage * GetIllusionUnitData(targetUnit)
	endif
	return damage
endfunction
function Get_Target_Attacked_Damge_Reduce_Arror takes real damage, unit targetUnit,real d returns real
	local real targetUnitArmor = GetUnitState(targetUnit, UNIT_STATE_ARMOR) * (1. - d )
	local real reduceRatio = 1
	if IsFortDefenseTypeUnit(targetUnit) then
		set damage = damage * .5
	endif
	if targetUnitArmor >= 0 then
		set reduceRatio = 0.06 * targetUnitArmor / (0.06 * targetUnitArmor + 1)
		set reduceRatio = 1 - reduceRatio
	elseif targetUnitArmor < 0 then
		set reduceRatio = 2 - Pow(1 -0.06, -targetUnitArmor)
	endif
	set damage = damage * reduceRatio
	if IsUnitIllusion(targetUnit) then
		set damage = damage * GetIllusionUnitData(targetUnit)
	endif
	return damage
endfunction
function Reduce_Unit_Attack takes unit ZX7,unit IH7 returns nothing
    local integer level=GetUnitAbilityLevel(ZX7,'A226')
    local integer skill
    local integer skillbuff
    if level==1 then
        set skill='A228'
        set skillbuff='B0E8'
    elseif level==2 then
        set skill='A2UI'
        set skillbuff='B0H2'
    elseif level==3 then
        set skill='A2UJ'
        set skillbuff='B0H3'
    elseif level==4 then
        set skill='A2UK'
        set skillbuff='B0H4'
    endif
    if UnitAlive(IH7) and YS8(IH7)==false then
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A228',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UI',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UJ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2UK',false)
call UnitRemoveAbility(IH7,'A228')
call UnitRemoveAbility(IH7,'A2UI')
call UnitRemoveAbility(IH7,'A2UJ')
call UnitRemoveAbility(IH7,'A2UK')
call UnitRemoveAbility(IH7,'B0E8')
call UnitRemoveAbility(IH7,'B0H2')
call UnitRemoveAbility(IH7,'B0H3')
call UnitRemoveAbility(IH7,'B0H4')
        call Z57(IH7,skill,1,4,skillbuff)
    endif
endfunction
function CXMAOJI takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
    local unit ZX7=Y24
    local unit IH7=(b1060GetEnumUnit)
    local real CXATTACK=ON7(GetHandleId(ZX7),"attack")
	local real d
    local real xishu=1.
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
    local real level
    local real FL_rate=0.
    local real BJ_rate=ON7(GetHandleId(ZX7),"BJ_rate")
    call MNGJTX(ZX7,IH7)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl",(b1060GetEnumUnit),"chest"))
	set d=CXATTACK*xishu+50*Y_4
	set damage=Get_Target_Attacked_Damge(d,IH7)
	call B67_DPS(ZX7,IH7,2,d*BJ_rate)
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)==false) then	
		call Q5A(ZX7, IH7, damage)
	endif
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*BJ_rate*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if BJ_rate>1 then
        call YW7(I2S(R2I(damage*BJ_rate))+"!",5,IH7,0.024,255,0,128,255)
    endif
	//分裂(狂战和授予力量)
    if (GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (MR7(ZX7,ZU[X1]) or MR7(ZX7,ZU[it_xh]))  then
	    set FL_rate=.45*(Have_Item_Quantity(ZX7,X1)+Have_Item_Quantity(ZX7,it_xh))
    endif
    if Have_SYLL(ZX7) then
        set level=LoadInteger(ExtraHT, 'A037', GetHandleId(ZX7))
        set FL_rate=(0.1 + level * 0.1)+FL_rate
    endif
    if FL_rate>0 and Y_5>0 then
        call B67_DPS(ZX7 , IH7 , 10 , CXATTACK*BJ_rate*FL_rate)
    endif
    call Reduce_Unit_Attack(ZX7,IH7)
set ZX7=null
set IH7=null
set b1060GetEnumUnit=null
endfunction
function CXMAOJI_PD takes nothing returns nothing
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local group g=WS7()
local unit ZX7=(b1061SavedGetTriggerUnit)
local integer BC7=GetUnitAbilityLevel(ZX7,'A226')
local real BJ_rate
local real d=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
local integer n
set BJ_rate=CXMAOJI_BJ(ZX7)
call NQ7(GetHandleId(ZX7),"BJ_rate",BJ_rate)
call NQ7(GetHandleId(ZX7),"attack",d)
set IN4=ZX7
set Y_4=BC7
set Y24=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),425,Condition(function AJ7_Visible))
set n=CountUnitsInGroup(g)
if n>1 then
set Y_5=1
else
set Y_5=0
endif
call NP7(GetHandleId(ZX7),"number",n)
call ForGroup(g,function CXMAOJI)
call WR7(g)
set g=null
set ZX7=null
set b1061SavedGetTriggerUnit=null
endfunction
function XPF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A226' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call CXMAOJI_PD()
else
call XOF()
endif
endif
return false
endfunction
