// Only true removal retires the manager. Dead heroes keep their revive lifecycle.
function KKAIManagerRetire takes integer managerIndex returns nothing
local unit managerOwner=KKAIManagerOwners[managerIndex]
local integer managerOwnerKey=GetHandleId(managerOwner)
local timer managerTimer=LoadTimerHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("DefendTimer"))
local group managerDefenders=LoadGroupHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("Defenders"))
local trigger managerOrderTrigger=LoadTriggerHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("B820AIOrderTrigger"))
local trigger managerAttackTrigger=LoadTriggerHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("B820AIAttackedTrigger"))
local unit managerDefender=null
set KKAIManagerOwners[managerIndex]=null
set SS4[managerIndex]=null
call RemoveSavedBoolean(L7,managerOwnerKey,StringHash("HeroAIManager"))
call RemoveSavedInteger(L7,managerOwnerKey,StringHash("Attacker"))
call NN7(managerOwnerKey,"DefendTimer")
call NN7(managerOwnerKey,"Defenders")
call NN7(managerOwnerKey,"B820AIOrderTrigger")
call NN7(managerOwnerKey,"B820AIAttackedTrigger")
call RemoveSavedHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("DefendTimer"))
call RemoveSavedHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("Defenders"))
call RemoveSavedHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("B820AIOrderTrigger"))
call RemoveSavedHandle(KKControllerOwnerTable,managerOwnerKey,StringHash("B820AIAttackedTrigger"))
if managerTimer!=null then
call PauseTimer(managerTimer)
call NM7(GetHandleId(managerTimer))
call DestroyTimer(managerTimer)
endif
if managerDefenders!=null then
loop
set managerDefender=FirstOfGroup(managerDefenders)
exitwhen managerDefender==null
call GroupRemoveUnit(managerDefenders,managerDefender)
// A defender may already have been claimed by another hero; do not steal its order.
if GetUnitTypeId(managerDefender)!=0 and GetUnitUserData(managerDefender)==managerIndex then
call SetUnitUserData(managerDefender,0)
if UnitAlive(managerDefender) then
call B947IssuePointOrderByIdLoc("KKAIManagerRetire @ war3map.j:50522 (B968)",managerDefender,$D000F,G49(managerDefender))
endif
endif
endloop
call DestroyGroup(managerDefenders)
endif
call OZ7(managerOrderTrigger)
call OZ7(managerAttackTrigger)
set managerOwner=null
set managerTimer=null
set managerDefenders=null
set managerOrderTrigger=null
set managerAttackTrigger=null
set managerDefender=null
endfunction
function KKAIManagerSweep takes nothing returns nothing
local integer managerChecks=0
local integer managerLimit=IMinBJ(l2,32)
loop
exitwhen managerChecks>=managerLimit
if KKAIManagerSweepCursor>l2 then
set KKAIManagerSweepCursor=1
endif
if KKAIManagerOwners[KKAIManagerSweepCursor]!=null and GetUnitTypeId(KKAIManagerOwners[KKAIManagerSweepCursor])==0 then
call KKAIManagerRetire(KKAIManagerSweepCursor)
endif
set KKAIManagerSweepCursor=KKAIManagerSweepCursor+1
set managerChecks=managerChecks+1
endloop
endfunction
