function YTD takes nothing returns boolean
local real x
local real y
if IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetFilterUnit())) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and GetUnitAbilityLevel(GetFilterUnit(),'Bcyc')>0==false) and IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit()) then
set x=A2+GetRandomReal(20,70)*Cos(GetUnitFacing(GetTriggerUnit())*bj_DEGTORAD)
set y=N2+GetRandomReal(20,70)*Sin(GetUnitFacing(GetTriggerUnit())*bj_DEGTORAD)
call SetUnitPosition(GetFilterUnit(),x,y)
endif
return false
endfunction
function YUD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x=0.
local real y=0.
local group g=null
local unit BB7=null
local integer BC7=0
local integer id=0
local string tx
local string tx2
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set x=GetUnitX(p5)
set y=GetUnitY(p5)
set g=WS7()
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
set BC7=B287_GetUnitAbilityLevel(p5,'A29L')
set id=GetUnitTypeId(p5)
if id=='ZC11' then
    set tx="model\\Hero_Magnataur_N4S_V_Target_1.mdl"
    set tx2="model\\Hero_Magnataur_N4S_V_Source.mdl"
    call DestroyEffect(AddSpecialEffect(tx,x,y))
    call DestroyEffect(AddSpecialEffect(tx2,x,y))
elseif id=='ZC12' then
    set tx="model\\Hero_Magnataur_N1S_V_Target_1.mdl"
    set tx2="model\\Hero_Magnataur_N1S_V_Source.mdl"
    call DestroyEffect(AddSpecialEffect(tx,x,y))
    call DestroyEffect(AddSpecialEffect(tx2,x,y))
else
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
    set tx="tx\\mengma\\Magnus_V.mdl"
    set tx2="tx\\mengma\\Magnus_V1.mdl"
    call DestroyEffect(AddSpecialEffect(tx,x,y))
    call DestroyEffect(AddSpecialEffect(tx2,x,y))
endif
set A2=GetUnitX(p5)+100*Cos(GetUnitFacing(p5)*bj_DEGTORAD)
set N2=GetUnitY(p5)+100*Sin(GetUnitFacing(p5)*bj_DEGTORAD)
call GroupEnumUnitsInRange(g,x,y,410+25,Condition(function YTD))
call WR7(g)
call XF7(BB7,'A06F')
call SetUnitAbilityLevel(BB7,'A06F',BC7)
call B947IssueImmediateOrderById("YUD @ war3map.j:98033 (B968)",BB7,$D009F)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set p5=null
set g=null
set BB7=null
endfunction
