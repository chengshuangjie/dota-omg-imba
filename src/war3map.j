function CO7 takes integer V77 returns integer
// local real CP7=KQ7()-M_4
// local real CQ7=(R2I(CP7)/ 60)-(1/ 2)
// local real CR7=100+V77*V77*1.5+CQ7*$F
// local real CP7=KQ7()-M_4
// local real CQ7=(R2I(CP7)/ 60)-(1/ 2)
// local real CR7=100+V77*V77*1.5+CQ7*$F
// local real CP7=KQ7()-M_4
// local real CQ7=(R2I(CP7)/ 60)-(1/ 2)
// local real CR7=100+V77*V77*1.5+CQ7*$F
local real CR7=50+V77*V77*1.5
local integer CS7
set CS7=R2I(CR7/50)
set CS7=IMinBJ(CS7,59)
set CS7=IMaxBJ(CS7,0)
return CS7
endfunction
function CT7 takes player p returns nothing
local integer id=GetPlayerId(p)
local unit CU7=KU4[id]
local unit CV7=M7[id]
local integer CW7=GetHeroLevel(CV7)
if D4 then
set CV7=null
set CU7=null
return
endif
if X14==false then
set CV7=null
set CU7=null
return
endif
if W9[id]=='h0D4' then
set CV7=null
set CU7=null
return
endif
if W9[id]!=0 then
call RemoveUnitFromStock(CU7,W9[id])
endif
if B287_GetUnitAbilityLevel(CV7,'A0O3')>0 and SuijiMode_EarlyScepterRegistryIsActive(CV7,'A0O3') then
call AddUnitToStock(CU7,V9[0],1,1)
set W9[id]=V9[0]
else
call AddUnitToStock(CU7,V9[CO7(CW7)],1,1)
set W9[id]=V9[CO7(CW7)]
endif
set CV7=null
set CU7=null
endfunction
