function CND takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local real d
    local real YM7 = LoadReal(TABLE_HY, h, 11)
	local real life = LoadReal(TABLE_HY, h, 12)
    if IsUnitAlly(IH7,GetOwningPlayer(ZX7))then
        set d=DGH_BUFF(IH7)
        call B907SkillHeal(ZX7,IH7,life*d)
    else
        call B67(ZX7,IH7,1,YM7)
    endif
	set ZX7 = null
	set IH7 = null
endfunction
