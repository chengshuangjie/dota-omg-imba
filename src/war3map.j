// Inventory and dedicated TP controllers hold the same per-unit settlement lock.
// Release uses the saved unit key even when the hero was removed during cleanup.
function TpSlot_AcquireController takes trigger tp1120Controller,unit tp1120Hero returns nothing
local integer tp1120Key=GetHandleId(tp1120Controller)
local integer tp1120UnitKey=GetHandleId(tp1120Hero)
call SaveInteger(L7,tp1120Key,StringHash("B1120TPUnitKey"),tp1120UnitKey)
call SaveBoolean(L7,tp1120Key,StringHash("B1120TPOpen"),true)
call SaveInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"),LoadInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"))+1)
call SaveInteger(L7,tp1120Key,StringHash("B1120TPSkill"),B287_GetSpellAbilityId())
call SaveInteger(L7,tp1120Key,StringHash("B1120TPRequest"),TpSlotActiveRequestSerial[GetPlayerId(GetOwningPlayer(tp1120Hero))])
call B1120OrderTrace(tp1120Hero,B287_GetSpellAbilityId(),852122,"tp-acquire c="+I2S(tp1120Key)+" req="+I2S(TpSlotActiveRequestSerial[GetPlayerId(GetOwningPlayer(tp1120Hero))])+" count="+I2S(LoadInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"))))
endfunction
function TpSlot_ReleaseController takes trigger tp1120Controller returns nothing
local integer tp1120Key=GetHandleId(tp1120Controller)
local integer tp1120UnitKey=LoadInteger(L7,tp1120Key,StringHash("B1120TPUnitKey"))
local integer tp1120Count=0
if LoadBoolean(L7,tp1120Key,StringHash("B1120TPOpen")) then
call RemoveSavedBoolean(L7,tp1120Key,StringHash("B1120TPOpen"))
set tp1120Count=LoadInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"))
if tp1120Count>0 then
call SaveInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"),tp1120Count-1)
endif
// Let the current native ENDCAST/order stack unwind before another UI cast.
call SaveReal(L7,tp1120UnitKey,StringHash("B1120TPSettledAt"),TimerGetElapsed(W)+.05)
call B1120OrderTrace(LoadUnitHandle(L7,tp1120Key,14),LoadInteger(L7,tp1120Key,StringHash("B1120TPSkill")),852122,"tp-release c="+I2S(tp1120Key)+" req="+I2S(LoadInteger(L7,tp1120Key,StringHash("B1120TPRequest")))+" count="+I2S(LoadInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"))))
endif
endfunction
function TpSlot_TraceController takes trigger tp1120Controller,unit tp1120Hero,string tp1120Phase returns nothing
local integer tp1120Key=GetHandleId(tp1120Controller)
call B1120OrderTrace(tp1120Hero,LoadInteger(L7,tp1120Key,StringHash("B1120TPSkill")),852122,tp1120Phase+" c="+I2S(tp1120Key)+" req="+I2S(LoadInteger(L7,tp1120Key,StringHash("B1120TPRequest"))))
endfunction
function TpSlot_ControllerBusy takes unit tp1120Hero returns boolean
local integer tp1120UnitKey=GetHandleId(tp1120Hero)
return LoadInteger(L7,tp1120UnitKey,StringHash("B1120TPCount"))>0 or LoadReal(L7,tp1120UnitKey,StringHash("B1120TPSettledAt"))>TimerGetElapsed(W)
endfunction
