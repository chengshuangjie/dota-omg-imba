local real io=GetUnitY(p5)
local real hN=GetUnitX(m5)
local real ho=GetUnitY(m5)
if p5==null or m5==null then
return I2R($540BE3FF)
else
return SquareRoot((iN-hN)*(iN-hN)+(io-ho)*(io-ho))
endif
return 1.
endfunction
