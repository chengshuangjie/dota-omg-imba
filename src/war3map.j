call SetUnitAnimation(IH7,"stand")
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(IH7),GetUnitY(IH7)))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",GetUnitX(IH7),GetUnitY(IH7)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(IH7),GetUnitY(IH7)))
call DestroyEffect(AddSpecialEffect("tx\\mengma\\Magnus_V1.mdl",GetUnitX(IH7),GetUnitY(IH7)))
set IH7=null
endfunction
