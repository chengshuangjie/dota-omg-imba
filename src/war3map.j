function ChaosObserver_EnsureStaticSkillHandlers takes nothing returns nothing
if LOADSKILL[8]==0 then
call ExecuteFunc("EC8")
call ExecuteFunc("ZCQHTT")
call ExecuteFunc("ZCSZQHTT")
call ExecuteFunc("E38")
call ExecuteFunc("E68")
call ExecuteFunc("E18")
set LOADSKILL[8]=1
endif
if LOADSKILL[16]==0 then
call ExecuteFunc("FK8")
call ExecuteFunc("FM8")
call ExecuteFunc("FN8")
call ExecuteFunc("FO8")
call ExecuteFunc("FP8")
set LOADSKILL[16]=1
endif
if LOADSKILL[19]==0 then
call ExecuteFunc("GM8")
call ExecuteFunc("GN8")
call ExecuteFunc("GO8")
call ExecuteFunc("JE1")
set LOADSKILL[19]=1
endif
if LOADSKILL[90]==0 then
call ExecuteFunc("KE8")
call ExecuteFunc("KF8")
call ExecuteFunc("KG8")
call ExecuteFunc("KH8")
call RegisterUnitAttackEvent("ZCJDZC",1)
set LOADSKILL[90]=1
endif
if SUIJI_LOG then
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFF66CCFFBoss技能日志[模块]：|r牛头="+I2S(LOADSKILL[8])+" 光法="+I2S(LOADSKILL[16])+" 修补匠="+I2S(LOADSKILL[19])+" 暗牧="+I2S(LOADSKILL[90]))
endif
endfunction
function ChaosObserver_InitStaticSkills takes unit u returns nothing
local integer level=1
if u==null or GetUnitTypeId(u)!='NB0S' then
return
endif
call MHUnit_SetAttackSpeedLimit(u,6.)
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,.9)
call SetUnitState(u,UNIT_STATE_ATTACK1_SPEED,6.)
set ChaosObserverStaticLogCount=0
set ChaosObserverStaticLogNext[0]=0.
call SetUnitAbilityLevel(u,'A4LZ',4)
call SetUnitAbilityLevel(u,'A9BM',3)
call SetUnitAbilityLevel(u,'A2US',4)
call SetUnitAbilityLevel(u,'A2UR',4)
call SetUnitAbilityLevel(u,'A10X',4)
call SetUnitAbilityLevel(u,'A4K0',4)
call SetUnitAbilityLevel(u,'A330',1)
call B1000TotemLeapCastpoint(u)
loop
exitwhen level>4
call MHAbility_SetCustomLevelDataReal(u,'A2US',level,ABILITY_LEVEL_DEF_DATA_COOLDOWN,7.)
call MHAbility_SetCustomLevelDataReal(u,'A2UR',level,ABILITY_LEVEL_DEF_DATA_COOLDOWN,7.)
set ChaosObserverStaticLogNext[level]=0.
set level=level+1
endloop
set ChaosObserverStaticLogNext[5]=0.
endfunction
function ChaosObserver_LogStaticSkillSummary takes unit target,real distance returns nothing
local real now=GetGameTime()
if SUIJI_LOG==false or ChaosObserverStaticLogCount>=40 or now<ChaosObserverStaticLogNext[0] then
return
endif
set ChaosObserverStaticLogNext[0]=now+3.
set ChaosObserverStaticLogCount=ChaosObserverStaticLogCount+1
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFF66CCFFBoss技能日志[状态]：|r目标="+GetUnitName(target)+" 距离="+I2S(R2I(distance))+" 目标法力%="+I2S(R2I(GetUnitManaPercent(target)))+" 当前命令="+I2S(GetUnitCurrentOrder(ChaosObserverBoss))+" 飞弹="+I2S(GetUnitAbilityLevel(ChaosObserverBoss,'A2US'))+"/"+R2S(B582_GetAbilityCooldown(ChaosObserverBoss,'A2US'))+" 激光="+I2S(GetUnitAbilityLevel(ChaosObserverBoss,'A2UR'))+"/"+R2S(B582_GetAbilityCooldown(ChaosObserverBoss,'A2UR'))+" 法力流失="+I2S(GetUnitAbilityLevel(ChaosObserverBoss,'A10X'))+"/"+R2S(B582_GetAbilityCooldown(ChaosObserverBoss,'A10X'))+" 图腾="+I2S(GetUnitAbilityLevel(ChaosObserverBoss,'A4LZ'))+"/"+R2S(B582_GetAbilityCooldown(ChaosObserverBoss,'A4LZ')))
endfunction
function ChaosObserver_LogStaticSkillOrder takes integer slot,integer skill,integer orderId,real distance,boolean issued returns nothing
local real now=GetGameTime()
local string result="失败"
if SUIJI_LOG==false or slot<1 or slot>5 or ChaosObserverStaticLogCount>=40 or now<ChaosObserverStaticLogNext[slot] then
return
endif
if issued then
set result="成功"
endif
set ChaosObserverStaticLogNext[slot]=now+2.
set ChaosObserverStaticLogCount=ChaosObserverStaticLogCount+1
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFF66CCFFBoss技能日志[下令]：|r槽="+I2S(slot)+" 技能="+GetAbilityName(skill)+" 等级="+I2S(GetUnitAbilityLevel(ChaosObserverBoss,skill))+" 冷却="+R2S(B582_GetAbilityCooldown(ChaosObserverBoss,skill))+" 距离="+I2S(R2I(distance))+" order="+I2S(orderId)+" 结果="+result+" 当前命令="+I2S(GetUnitCurrentOrder(ChaosObserverBoss)))
endfunction
function ChaosObserver_OnStaticSkillEffect takes nothing returns boolean
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local integer skill=B287_GetSpellAbilityId()
local unit target=GetSpellTargetUnit()
if SUIJI_LOG and GetTriggerUnit()==ChaosObserverBoss and ChaosObserverStaticLogCount<40 and (skill=='A2US' or skill=='A2UR' or skill=='A10X' or skill=='A4K0' or skill=='A4LZ') then
set ChaosObserverStaticLogCount=ChaosObserverStaticLogCount+1
if target!=null then
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFF66CCFFBoss技能日志[效果事件]：|r技能="+GetAbilityName(skill)+" raw="+I2S(skill)+" 目标="+GetUnitName(target)+" 当前命令="+I2S(GetUnitCurrentOrder(ChaosObserverBoss)))
else
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFF66CCFFBoss技能日志[效果事件]：|r技能="+GetAbilityName(skill)+" raw="+I2S(skill)+" 目标点="+I2S(R2I(b1060GetSpellTargetX))+","+I2S(R2I(b1060GetSpellTargetY))+" 当前命令="+I2S(GetUnitCurrentOrder(ChaosObserverBoss)))
endif
endif
set target=null
return false
endfunction
function ChaosObserver_RunStaticSkillAI takes unit target returns boolean
local integer tries=0
local real now=GetGameTime()
local real dx=0.
local real dy=0.
local real distance=0.
local boolean done=false
if target==null or ChaosObserverBoss==null or GetUnitTypeId(ChaosObserverBoss)!='NB0S' or now<ChaosObserverStaticCastCooldown then
return false
endif
if IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) or IsUnitEnemy(target,GetOwningPlayer(ChaosObserverBoss))==false or IsUnitVisible(target,GetOwningPlayer(ChaosObserverBoss))==false then
return false
endif
set dx=GetUnitX(target)-GetUnitX(ChaosObserverBoss)
set dy=GetUnitY(target)-GetUnitY(ChaosObserverBoss)
set distance=SquareRoot(dx*dx+dy*dy)
call ChaosObserver_LogStaticSkillSummary(target,distance)
loop
exitwhen tries>=5 or done
set ChaosObserverStaticSkillCursor=ChaosObserverStaticSkillCursor+1
if ChaosObserverStaticSkillCursor>5 then
set ChaosObserverStaticSkillCursor=1
endif
if ChaosObserverStaticSkillCursor==1 then
if distance<=2500. and AI_SKILL_OK(ChaosObserverBoss,'A2US') then
set done=B947IssueImmediateOrderById("ChaosObserver_RunStaticSkillAI @ war3map.j:121516 (B968)",ChaosObserverBoss,852526)
call ChaosObserver_LogStaticSkillOrder(1,'A2US',852526,distance,done)
endif
elseif ChaosObserverStaticSkillCursor==2 then
if distance<=700. and AI_SKILL_OK(ChaosObserverBoss,'A2UR') then
set done=B947IssueTargetOrderById("ChaosObserver_RunStaticSkillAI @ war3map.j:121521 (B968)",ChaosObserverBoss,852585,target)
call ChaosObserver_LogStaticSkillOrder(2,'A2UR',852585,distance,done)
endif
elseif ChaosObserverStaticSkillCursor==3 then
if distance<=1000. and GetUnitManaPercent(target)>20. and GetUnitAbilityLevel(target,'B03V')==0 and AI_SKILL_OK(ChaosObserverBoss,'A10X') then
set done=B947IssueTargetOrderById("ChaosObserver_RunStaticSkillAI @ war3map.j:121526 (B968)",ChaosObserverBoss,852662,target)
call ChaosObserver_LogStaticSkillOrder(3,'A10X',852662,distance,done)
endif
elseif ChaosObserverStaticSkillCursor==4 then
if distance<=800. and AI_SKILL_OK(ChaosObserverBoss,'A4K0') then
set done=B947IssueTargetOrderById("ChaosObserver_RunStaticSkillAI @ war3map.j:121531 (B968)",ChaosObserverBoss,$D0105,target)
call ChaosObserver_LogStaticSkillOrder(4,'A4K0',$D0105,distance,done)
endif
elseif distance<=1000. and GetUnitLifePercent(ChaosObserverBoss)>50. and AI_SKILL_OK(ChaosObserverBoss,'A4LZ') then
set done=B947IssuePointOrderById("ChaosObserver_RunStaticSkillAI @ war3map.j:121535 (B968)",ChaosObserverBoss,$D02B8,GetUnitX(target),GetUnitY(target))
call ChaosObserver_LogStaticSkillOrder(5,'A4LZ',$D02B8,distance,done)
if done then
set h4[GetPlayerId(GetOwningPlayer(ChaosObserverBoss))]=target
endif
endif
set tries=tries+1
endloop
if done then
// Leave enough room for the Scepter Multicast repeat controller to finish
// before the boss AI issues the next unrelated order.
set ChaosObserverStaticCastCooldown=now+1.6
else
set ChaosObserverStaticCastCooldown=now+.2
endif
return done
endfunction
function ChaosObserver_Heartbeat takes nothing returns nothing
local real now=GetGameTime()
local integer nextIndex=0
local unit hero=null
local real dx=0.
local real dy=0.
local integer guardCap=0
local integer guardCount=0
if ChaosObserverActive==false or ChaosObserverBoss==null or GetUnitTypeId(ChaosObserverBoss)==0 then
call ChaosObserver_Shutdown()
return
endif
if XH7(ChaosObserverBoss) then
call ChaosObserver_Shutdown()
return
endif
if ChaosObserverSpawnProtection>0. then
set ChaosObserverSpawnProtection=ChaosObserverSpawnProtection-.2
if ChaosObserverSpawnProtection<=0. then
set ChaosObserverSpawnProtection=0.
call SetUnitInvulnerable(ChaosObserverBoss,false)
call ChaosObserver_Message("观测开始，Boss的出场保护已经结束。")
else
return
endif
endif
set nextIndex=ChaosObserverBucketIndex+1
if nextIndex>=40 then
set nextIndex=0
endif
set ChaosObserverPhysicalTotal=ChaosObserverPhysicalTotal-ChaosObserverPhysicalBucket[nextIndex]
set ChaosObserverMagicTotal=ChaosObserverMagicTotal-ChaosObserverMagicBucket[nextIndex]
set ChaosObserverPureTotal=ChaosObserverPureTotal-ChaosObserverPureBucket[nextIndex]
if ChaosObserverPhysicalTotal<0. then
set ChaosObserverPhysicalTotal=0.
endif
if ChaosObserverMagicTotal<0. then
set ChaosObserverMagicTotal=0.
endif
if ChaosObserverPureTotal<0. then
set ChaosObserverPureTotal=0.
endif
set ChaosObserverPhysicalBucket[nextIndex]=0.
set ChaosObserverMagicBucket[nextIndex]=0.
set ChaosObserverPureBucket[nextIndex]=0.
set ChaosObserverBucketIndex=nextIndex
if ChaosObserverOverloadEffect!=null and now>=ChaosObserverOverloadUntil then
call DestroyEffect(ChaosObserverOverloadEffect)
set ChaosObserverOverloadEffect=null
endif
call ChaosObserver_ClearStun()
if now-ChaosObserverLastLongRangeTime>1. then
set ChaosObserverThreat=ChaosObserverThreat-1.6
if ChaosObserverThreat<0. then
set ChaosObserverThreat=0.
endif
endif
set ChaosObserverDesiredSpeed=320.+ChaosObserverThreat*1.8
if ChaosObserverDesiredSpeed>500. then
set ChaosObserverDesiredSpeed=500.
endif
if ChaosObserverOwnPause==false and ChaosObserverUnstoppable<=0. then
call SetUnitMoveSpeed(ChaosObserverBoss,ChaosObserverDesiredSpeed)
endif
if ChaosObserverWarpRemaining>0. then
set ChaosObserverWarpRemaining=ChaosObserverWarpRemaining-.2
if ChaosObserverWarpRemaining<=0. then
if ChaosObserverWarpTarget!=null and XH7(ChaosObserverWarpTarget)==false then
set ChaosObserverWarpAngle=Atan2(GetUnitY(ChaosObserverWarpTarget)-GetUnitY(ChaosObserverBoss),GetUnitX(ChaosObserverWarpTarget)-GetUnitX(ChaosObserverBoss))
set dx=GetUnitX(ChaosObserverWarpTarget)-250.*Cos(ChaosObserverWarpAngle)
set dy=GetUnitY(ChaosObserverWarpTarget)-250.*Sin(ChaosObserverWarpAngle)
call SetUnitPosition(ChaosObserverBoss,dx,dy)
call SetUnitFacing(ChaosObserverBoss,ChaosObserverWarpAngle*bj_RADTODEG)
if ChaosObserverWarpEffect!=null then
call DestroyEffect(ChaosObserverWarpEffect)
endif
set ChaosObserverWarpEffect=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",ChaosObserverBoss,"origin")
set ChaosObserverWarpStrikeRemaining=.8
set ChaosObserverWarpCooldown=now+10.
else
if ChaosObserverWarpEffect!=null then
call DestroyEffect(ChaosObserverWarpEffect)
set ChaosObserverWarpEffect=null
endif
endif
endif
endif
if ChaosObserverWarpStrikeRemaining>0. then
set ChaosObserverWarpStrikeRemaining=ChaosObserverWarpStrikeRemaining-.2
if ChaosObserverWarpStrikeRemaining<=0. then
call ChaosObserver_DoConeStrike()
endif
endif
if ChaosObserverBoltRemaining>0. then
set ChaosObserverBoltRemaining=ChaosObserverBoltRemaining-.2
if ChaosObserverBoltRemaining<=0. then
call ChaosObserver_DoBoltStrike()
endif
endif
if ChaosObserverMeteorRemaining>0. then
set ChaosObserverMeteorRemaining=ChaosObserverMeteorRemaining-.2
if ChaosObserverMeteorRemaining<=0. then
call ChaosObserver_DoMeteor()
endif
endif
if ChaosObserverSweepRemaining>0. then
set ChaosObserverSweepRemaining=ChaosObserverSweepRemaining-.2
if ChaosObserverSweepRemaining<=0. then
call ChaosObserver_DoSweep()
endif
endif
if ChaosObserverCollapseRemaining>0. then
set ChaosObserverCollapseRemaining=ChaosObserverCollapseRemaining-.2
if ChaosObserverCollapseRemaining<=0. then
call ChaosObserver_DoCollapse()
endif
endif
if ChaosObserverEngaged and ChaosObserver_CanAct() and ChaosObserverMeteorRemaining<=0. and ChaosObserverSweepRemaining<=0. and ChaosObserverCollapseRemaining<=0. then
if now>=ChaosObserverMeteorCooldown then
set hero=ChaosObserver_SelectMeteorTarget()
if hero!=null then
set ChaosObserverMeteorX=GetUnitX(hero)
set ChaosObserverMeteorY=GetUnitY(hero)
set ChaosObserverMeteorRemaining=1.2
set ChaosObserverMeteorEffect=AddSpecialEffect("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl",ChaosObserverMeteorX,ChaosObserverMeteorY)
set ChaosObserverMeteorCooldown=now+7.
else
set ChaosObserverMeteorCooldown=now+1.
endif
elseif now>=ChaosObserverSweepCooldown then
set hero=ChaosObserver_FindNearestHero(650.)
if hero!=null then
set ChaosObserverSweepAngle=Atan2(GetUnitY(hero)-GetUnitY(ChaosObserverBoss),GetUnitX(hero)-GetUnitX(ChaosObserverBoss))
call SetUnitFacing(ChaosObserverBoss,ChaosObserverSweepAngle*bj_RADTODEG)
set ChaosObserverSweepRemaining=.8
set dx=GetUnitX(ChaosObserverBoss)+275.*Cos(ChaosObserverSweepAngle)
set dy=GetUnitY(ChaosObserverBoss)+275.*Sin(ChaosObserverSweepAngle)
set ChaosObserverSweepEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl",dx,dy)
set ChaosObserverSweepCooldown=now+10.
else
set ChaosObserverSweepCooldown=now+1.
endif
endif
endif
if ChaosObserverEngaged and now>=ChaosObserverGuardCooldown then
set guardCap=2
set guardCount=ChaosObserver_CountGuards()
if guardCount<guardCap and ChaosObserver_CanAct() then
call ChaosObserver_SpawnGuard()
if guardCount+1<guardCap then
set ChaosObserverGuardCooldown=now+5.
else
set ChaosObserverGuardCooldown=now+18.
endif
else
set ChaosObserverGuardCooldown=now+2.
endif
endif
if ChaosObserverEngaged and ChaosObserver_CanAct() and ChaosObserverWarpRemaining<=0. and ChaosObserverWarpStrikeRemaining<=0. and ChaosObserverBoltRemaining<=0. and ChaosObserverMeteorRemaining<=0. and ChaosObserverSweepRemaining<=0. and ChaosObserverCollapseRemaining<=0. then
set hero=ChaosObserver_FindNearestHero(2500.)
if hero!=null then
call ChaosObserver_RunStaticSkillAI(hero)
endif
endif
set hero=null
endfunction
function ChaosObserver_StartTimer takes nothing returns nothing
if ChaosObserverTimer==null and ChaosObserverActive then
set ChaosObserverTimer=CreateTimer()
call TimerStart(ChaosObserverTimer,.2,true,function ChaosObserver_Heartbeat)
endif
endfunction
function ChaosObserver_OnDamaging takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local unit source=MHDamagingEvent_GetSource()
local unit hero=null
local integer damageType=0
local real damage=MHDamagingEvent_GetDamage()
local real adjusted=damage
local real factor=1.
local real threshold=0.
local real distance=0.
local real dx=0.
local real dy=0.
local real now=GetGameTime()
local integer kind=2
local integer ownerId=-1
local boolean overloadActive=false
if ChaosObserverActive==false or target!=ChaosObserverBoss or damage<=0. then
set target=null
set source=null
return false
endif
// Blade Mail and Thorn Mail share the scripted reflection controller, which
// raises p3 only while it applies reflected damage. Ignore that narrow damage
// class without changing ordinary attacks, spells, or unrelated damage.
if p3 then
call MHDamagingEvent_SetDamage(0.)
set target=null
set source=null
return false
endif
if ChaosObserverSpawnProtection>0. then
call MHDamagingEvent_SetDamage(0.)
set target=null
set source=null
return false
endif
if source==null or source==ChaosObserverBoss or IsUnitAlly(source,GetOwningPlayer(ChaosObserverBoss)) then
set target=null
set source=null
return false
endif
call ChaosObserver_StartTimer()
if ChaosObserverEngaged==false then
set ChaosObserverMeteorCooldown=now+3.
set ChaosObserverSweepCooldown=now+6.
set ChaosObserverGuardCooldown=now+4.
endif
set ChaosObserverEngaged=true
set ownerId=GetPlayerId(GetOwningPlayer(source))
set damageType=MHDamagingEvent_GetDmgTypeInt()
if MHDamagingEvent_IsPhysical() then
set kind=1
elseif damageType==GetHandleId(DAMAGE_TYPE_UNIVERSAL) or damageType==GetHandleId(DAMAGE_TYPE_DIVINE) or damageType==GetHandleId(DAMAGE_TYPE_ENHANCED) then
set kind=3
endif
if kind==1 then
set ChaosObserverPhysicalBucket[ChaosObserverBucketIndex]=ChaosObserverPhysicalBucket[ChaosObserverBucketIndex]+damage
set ChaosObserverPhysicalTotal=ChaosObserverPhysicalTotal+damage
elseif kind==2 then
set ChaosObserverMagicBucket[ChaosObserverBucketIndex]=ChaosObserverMagicBucket[ChaosObserverBucketIndex]+damage
set ChaosObserverMagicTotal=ChaosObserverMagicTotal+damage
else
set ChaosObserverPureBucket[ChaosObserverBucketIndex]=ChaosObserverPureBucket[ChaosObserverBucketIndex]+damage
set ChaosObserverPureTotal=ChaosObserverPureTotal+damage
endif
set overloadActive=kind!=1 and now<ChaosObserverOverloadUntil
if kind!=1 then
set threshold=ChaosObserverMaxLife*.04
if adjusted>threshold then
set adjusted=threshold+(adjusted-threshold)*.40
endif
if ChaosObserver_GetSpellBurst()>=ChaosObserverMaxLife*.08 and now>=ChaosObserverOverloadCooldown then
set ChaosObserverOverloadUntil=now+5.
set ChaosObserverOverloadCooldown=now+10.
if ChaosObserverOverloadEffect!=null then
call DestroyEffect(ChaosObserverOverloadEffect)
endif
set ChaosObserverOverloadEffect=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AntiMagicShell\\AntiMagicShell.mdl",ChaosObserverBoss,"origin")
if ChaosObserverCollapseRemaining<=0. and ChaosObserver_CanAct() then
if ownerId>=1 and ownerId<=5 and M7[ownerId]!=null and GetUnitTypeId(M7[ownerId])!=0 then
set hero=M7[ownerId]
set ChaosObserverCollapseX=GetUnitX(hero)
set ChaosObserverCollapseY=GetUnitY(hero)
else
set ChaosObserverCollapseX=GetUnitX(source)
set ChaosObserverCollapseY=GetUnitY(source)
endif
set ChaosObserverCollapseRemaining=1.3
set ChaosObserverCollapseEffect=AddSpecialEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",ChaosObserverCollapseX,ChaosObserverCollapseY)
endif
call ChaosObserver_Message("检测到超高法系爆发：5秒内额外降低45%法术伤害，并在施法者附近发动奥术坍缩。")
endif
endif
if overloadActive then
set factor=factor*.55
endif
if factor<.40 then
set factor=.40
endif
set adjusted=adjusted*factor
call MHDamagingEvent_SetDamage(adjusted)
if ownerId>=1 and ownerId<=5 and M7[ownerId]!=null and GetUnitTypeId(M7[ownerId])!=0 then
set hero=M7[ownerId]
set dx=GetUnitX(source)-GetUnitX(ChaosObserverBoss)
set dy=GetUnitY(source)-GetUnitY(ChaosObserverBoss)
set distance=SquareRoot(dx*dx+dy*dy)
if kind==1 and distance>750. then
set ChaosObserverThreat=ChaosObserverThreat+25.
set ChaosObserverLastLongRangeTime=now
elseif distance>1000. then
set ChaosObserverThreat=ChaosObserverThreat+35.
set ChaosObserverLastLongRangeTime=now
endif
if ChaosObserverThreat>=100. and now>=ChaosObserverWarpCooldown and ChaosObserverWarpRemaining<=0. and ChaosObserverWarpStrikeRemaining<=0. and ChaosObserverRitual==false and ChaosObserverRebuildState==0 then
set ChaosObserverThreat=ChaosObserverThreat-100.
set ChaosObserverWarpTarget=hero
set ChaosObserverWarpRemaining=.7
if ChaosObserverWarpEffect!=null then
call DestroyEffect(ChaosObserverWarpEffect)
endif
set ChaosObserverWarpEffect=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl",hero,"overhead")
call ChaosObserver_Message("已锁定超远程放风筝行为：0.7秒后发动跃迁重击。")
elseif distance>1000. and now<ChaosObserverWarpCooldown and now>=ChaosObserverBoltCooldown and ChaosObserverBoltRemaining<=0. and ChaosObserverRitual==false and ChaosObserverRebuildState==0 then
set ChaosObserverBoltX=GetUnitX(hero)
set ChaosObserverBoltY=GetUnitY(hero)
set ChaosObserverBoltRemaining=1.2
set ChaosObserverBoltCooldown=now+4.
if ChaosObserverBoltEffect!=null then
call DestroyEffect(ChaosObserverBoltEffect)
endif
set ChaosObserverBoltEffect=AddSpecialEffect("Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl",ChaosObserverBoltX,ChaosObserverBoltY)
endif
endif
set target=null
set source=null
set hero=null
return false
endfunction
function ChaosObserver_AddEquipmentItem takes unit u,integer itemId returns nothing
local item it=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set it=CreateItem(itemId,GetUnitX(u),GetUnitY(u))
call SetItemPlayer(it,GetOwningPlayer(u),false)
if UnitAddItem(u,it)==false then
call RemoveItem(it)
endif
set it=null
endfunction
function ChaosObserver_SetAllPlayerGold takes nothing returns nothing
local integer i=1
loop
exitwhen i>5
if Z7[i]!=null and GetPlayerSlotState(Z7[i])==PLAYER_SLOT_STATE_PLAYING then
call SetPlayerState(Z7[i],PLAYER_STATE_RESOURCE_GOLD,200000)
endif
if A7[i]!=null and GetPlayerSlotState(A7[i])==PLAYER_SLOT_STATE_PLAYING then
call SetPlayerState(A7[i],PLAYER_STATE_RESOURCE_GOLD,200000)
endif
set i=i+1
endloop
endfunction
function ChaosObserver_Spawn takes unit fountain returns nothing
local player owner=null
if ChaosObserverSpawned or fountain==null then
return
endif
set ChaosObserverSpawned=true
call ChaosObserver_SetAllPlayerGold()
if JS!=null then
call DisableTrigger(JS)
endif
set ChaosObserverHomeX=GetUnitX(fountain)
set ChaosObserverHomeY=GetUnitY(fountain)
set owner=Player(7)
set ChaosObserverPlayerCount=ChaosObserver_CountPlayers()
set ChaosObserverBoss=CreateUnit(owner,'NB0S',ChaosObserverHomeX,ChaosObserverHomeY,270.)
set ChaosObserverDefeated=false
call SetHeroLevel(ChaosObserverBoss,30,false)
call UnitRemoveAbility(ChaosObserverBoss,'ACmi')
call UnitRemoveAbility(ChaosObserverBoss,'ACrk')
set ChaosObserverMaxLife=GetUnitState(ChaosObserverBoss,UNIT_STATE_MAX_LIFE)
set ChaosObserverActive=true
set ChaosObserverEngaged=false
set ChaosObserverSpawnProtection=3.
set ChaosObserverDesiredSpeed=320.
set ChaosObserverMeteorRemaining=0.
set ChaosObserverSweepRemaining=0.
set ChaosObserverCollapseRemaining=0.
set ChaosObserverGuardCooldown=0.
set ChaosObserverGuardSerial=0
set ChaosObserverStaticSkillCursor=0
set ChaosObserverStaticCastCooldown=0.
call ChaosObserver_ResetBuckets()
call ChaosObserver_EnsureStaticSkillHandlers()
call ChaosObserver_InitStaticSkills(ChaosObserverBoss)
call ChaosObserver_AddEquipmentItem(ChaosObserverBoss,'I0AB')
call ChaosObserver_AddEquipmentItem(ChaosObserverBoss,'I0A3')
call ChaosObserver_AddEquipmentItem(ChaosObserverBoss,'I0SD')
call ChaosObserver_AddEquipmentItem(ChaosObserverBoss,'I0Y7')
call SetUnitInvulnerable(ChaosObserverBoss,true)
set ChaosObserverDeathTrigger=CreateTrigger()
call TriggerRegisterUnitEvent(ChaosObserverDeathTrigger,ChaosObserverBoss,EVENT_UNIT_DEATH)
call TriggerAddAction(ChaosObserverDeathTrigger,function ChaosObserver_OnBossDeath)
set ChaosObserverKillTrigger=CreateTrigger()
call YB7(ChaosObserverKillTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(ChaosObserverKillTrigger,function ChaosObserver_OnHeroKill)
set ChaosObserverDamageTrigger=CreateTrigger()
call TriggerAddCondition(ChaosObserverDamageTrigger,Condition(function ChaosObserver_OnDamaging))
call MHDamagingEvent_Register(ChaosObserverDamageTrigger)
set ChaosObserverEffectTrigger=CreateTrigger()
call TriggerRegisterUnitEvent(ChaosObserverEffectTrigger,ChaosObserverBoss,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(ChaosObserverEffectTrigger,Condition(function ChaosObserver_OnStaticSkillEffect))
call ChaosObserver_StartTimer()
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",ChaosObserverHomeX,ChaosObserverHomeY))
call ChaosObserver_Message("黑暗方泉水已被摧毁！混沌观测者降临，生命值"+I2S(R2I(ChaosObserverMaxLife))+"，获得3秒出场保护。")
set owner=null
endfunction
function WIE takes nothing returns nothing
local unit b1060GetDyingUnit=GetDyingUnit()
call YF8()
call YH8()
if b1060GetDyingUnit==JA4_MJ then
call ChaosObserver_Spawn(b1060GetDyingUnit)
endif
set b1060GetDyingUnit=null
endfunction
function J69 takes nothing returns nothing
local string VH=GetEventPlayerChatString()
local player pl=K27(S2I(SubString(VH,3,StringLength(VH))))
if((pl!=null)and(TA7(pl))and(IsPlayerInForce(pl,QX4)))then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r creepstats:   K: "+I2S(T7[GetPlayerId(pl)])+"   D: "+I2S(U7[GetPlayerId(pl)]))
endif
set pl=null
endfunction
function JL9 takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local player pl=K27(S2I(SubString(VH,3,StringLength(VH))))
if((pl!=null)and(TA7(pl))and(IsPlayerInForce(pl,QX4)))then
if(M7[GetPlayerId(pl)]==null)then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r 没有英雄")
else
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r 移动速度为 "+I2S(R2I(GetUnitMoveSpeed(M7[GetPlayerId(pl)]))))
endif
endif
set pl=null
set b1060GetTriggerPlayer=null
endfunction
function WJE takes nothing returns boolean
return((IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO))and(IsUnitAlly(GetFilterUnit(),GetTriggerPlayer()))and(not IsUnitIllusion(GetFilterUnit()))and(GetPlayerController(GetOwningPlayer(GetFilterUnit()))==MAP_CONTROL_COMPUTER)and(not ME7(GetFilterUnit()))and(K57(GetFilterUnit())))!=null
endfunction
function WKE takes unit j5,unit m5 returns boolean
if UnitAlive(m5)==false then
return false
elseif AI_SKILL_OK(j5,'A06I') or AI_SKILL_OK(j5,'A2S1') then
set LD4=1200
return((WA7(j5,m5,40/.03,0,LD4)!=null)and(WW7(j5,m5,GetLocationX(DH7),GetLocationY(DH7),150,Condition(function B47)))and(B947IssuePointOrderByIdLoc("WKE @ war3map.j:121979 (B968)",j5,$D02BB,DH7)))
endif
return false
endfunction
function WME takes unit j5,unit m5 returns boolean
if AI_SKILL_OK(j5,'A0L8') then
return((WA7(j5,m5,30/.035,0,3000.)!=null)and(WW7(j5,m5,GetLocationX(DH7),GetLocationY(DH7),155,Condition(function uj)))and(B947IssuePointOrderByIdLoc("WME @ war3map.j:121985 (B968)",j5,$D02B6,DH7)))
endif
return false
endfunction
function SuijiMode_OgreShouldKeepVisible takes unit suijiOgreUnit,integer suijiOgreSkill returns boolean
local integer suijiOgreHandle=GetHandleId(suijiOgreUnit)
// Engineering Upgrade can advance A088 before Warcraft has finished replacing
// the three native command-card buttons.  Keep the previous base face visible
// until its requested replacement is actually owned; otherwise one interrupted
// refresh hides all three Ogre spells until a later unrelated repair event.
if suijiOgreSkill=='A04W' and GetUnitAbilityLevel(suijiOgreUnit,QI7(suijiOgreUnit))==0 then
return true
elseif suijiOgreSkill=='A011' and GetUnitAbilityLevel(suijiOgreUnit,QJ7(suijiOgreUnit))==0 then
return true
elseif suijiOgreSkill=='A083' and GetUnitAbilityLevel(suijiOgreUnit,QK7(suijiOgreUnit))==0 then
return true
endif
if suijiOgreSkill==QI7(suijiOgreUnit) or suijiOgreSkill==QJ7(suijiOgreUnit) or suijiOgreSkill==QK7(suijiOgreUnit) then
return true
endif
if suijiOgreSkill==OM7(suijiOgreHandle,"SuijiSmallSkill") or suijiOgreSkill==OM7(suijiOgreHandle,"SuijiUltSkill") then
return true
endif
return false
endfunction
function SuijiMode_FixOgreNativeSkillVisibility takes unit suijiOgreUnit returns nothing
local integer suijiOgreHandle=0
local player suijiOgreOwner=null
if SUIJI_MODE==false or suijiOgreUnit==null or GetUnitTypeId(suijiOgreUnit)!='Hmkg' then
return
endif
set suijiOgreHandle=GetHandleId(suijiOgreUnit)
if OO7(suijiOgreHandle,"SuijiDone")==false then
return
endif
set suijiOgreOwner=GetOwningPlayer(suijiOgreUnit)
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A088',true)
call SetPlayerAbilityAvailable(suijiOgreOwner,'A04W',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A04W'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A089',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A089'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08A',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08A'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A08D',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08D'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A011',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A011'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A007',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A007'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A01T',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A01T'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A00F',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A00F'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A083',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A083'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08F',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08F'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A08G',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08G'))
call B287_SetPlayerAbilityAvailable(suijiOgreOwner,'A08I',SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A08I'))
call SetPlayerAbilityAvailable(suijiOgreOwner,'A2KQ',(OO7(suijiOgreHandle,"AI|Magi2Blast") and GetUnitAbilityLevel(suijiOgreUnit,'A2KQ')>0) or SuijiMode_OgreShouldKeepVisible(suijiOgreUnit,'A2KQ'))
set suijiOgreOwner=null
endfunction
function SuijiMode_IsInvokerUnit takes unit suijiInvokerUnit returns boolean
local integer suijiInvokerUnitId=0
if suijiInvokerUnit==null then
return false
endif
set suijiInvokerUnitId=GetUnitTypeId(suijiInvokerUnit)
return GetUnitPointValue(suijiInvokerUnit)==94 or suijiInvokerUnitId=='H00U' or suijiInvokerUnitId=='Z00U' or suijiInvokerUnitId=='Z10U' or suijiInvokerUnitId=='Z20U' or suijiInvokerUnitId=='Z02X'
endfunction
function SuijiMode_IsInvokerInvokedSkill takes integer suijiInvokerSkill returns boolean
return suijiInvokerSkill=='A0VS' or suijiInvokerSkill=='A0VK' or suijiInvokerSkill=='A0VQ' or suijiInvokerSkill=='A0XL' or suijiInvokerSkill=='A0VM' or suijiInvokerSkill=='A0VN' or suijiInvokerSkill=='A0VO' or suijiInvokerSkill=='A0VP' or suijiInvokerSkill=='A0VG' or suijiInvokerSkill=='A0VZ'
endfunction
function SuijiMode_InvokerSpellScepterIsActive takes unit suijiInvokerUnit,integer suijiInvokerSkill returns boolean
if suijiInvokerUnit==null or GetUnitTypeId(suijiInvokerUnit)==0 then
return false
endif
// Native Invoker's authoritative Scepter owner remains Invoke. A copied spell
// is registered under its own logical ID; an unregistered stolen spell keeps
// the established inventory/permanent-Scepter fallback.
if SuijiMode_IsInvokerUnit(suijiInvokerUnit) then
return SuijiMode_ScepterRegistryIsActive(suijiInvokerUnit,'A21Y')
elseif SuijiMode_ScepterRegistryIsRegistered(suijiInvokerUnit,suijiInvokerSkill) then
return SuijiMode_ScepterRegistryIsActive(suijiInvokerUnit,suijiInvokerSkill)
endif
return SuijiMode_HasAghanimState(suijiInvokerUnit)
endfunction
function SuijiMode_SetCopiedInvokerLevels takes unit suijiInvokerUnit,integer suijiInvokerSkillLevel returns nothing
local integer suijiInvokerOrbLevel=1
local integer suijiInvokerHandle=0
if SUIJI_MODE==false or suijiInvokerUnit==null or GetUnitTypeId(suijiInvokerUnit)==0 or SuijiMode_IsInvokerUnit(suijiInvokerUnit) then
return
endif
if suijiInvokerSkillLevel<1 then
set suijiInvokerSkillLevel=1
elseif suijiInvokerSkillLevel>3 then
set suijiInvokerSkillLevel=3
endif
// Three random levels use the last three native element data rows: 5/6/7.
set suijiInvokerOrbLevel=suijiInvokerSkillLevel+4
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
if OM7(suijiInvokerHandle,"WexLevel")==suijiInvokerOrbLevel and OM7(suijiInvokerHandle,"QuasLevel")==suijiInvokerOrbLevel and OM7(suijiInvokerHandle,"ExortLevel")==suijiInvokerOrbLevel then
return
endif
call NP7(suijiInvokerHandle,"WexLevel",suijiInvokerOrbLevel)
call NP7(suijiInvokerHandle,"QuasLevel",suijiInvokerOrbLevel)
call NP7(suijiInvokerHandle,"ExortLevel",suijiInvokerOrbLevel)
endfunction
function SuijiMode_InitCopiedInvokerSkill takes unit suijiInvokerUnit,integer suijiInvokerSkill,integer suijiInvokerSkillLevel returns nothing
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill)==false then
return
endif
if suijiInvokerSkillLevel<1 and suijiInvokerUnit!=null and GetUnitTypeId(suijiInvokerUnit)!=0 then
set suijiInvokerSkillLevel=B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
call SuijiMode_SetCopiedInvokerLevels(suijiInvokerUnit,suijiInvokerSkillLevel)
endfunction
function SuijiMode_UpdateCopiedInvokerLevels takes unit suijiInvokerUnit returns nothing
local integer suijiInvokerHandle=0
local integer suijiInvokerSkill=0
local integer suijiInvokerSkillLevel=0
if SUIJI_MODE==false or suijiInvokerUnit==null or GetUnitTypeId(suijiInvokerUnit)==0 or SuijiMode_IsInvokerUnit(suijiInvokerUnit) then
return
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
set suijiInvokerSkill=OM7(suijiInvokerHandle,"SuijiSmallSkill")
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill) then
set suijiInvokerSkillLevel=GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
set suijiInvokerSkill=OM7(suijiInvokerHandle,"SuijiUltSkill")
if SuijiMode_IsInvokerInvokedSkill(suijiInvokerSkill) and B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)>suijiInvokerSkillLevel then
set suijiInvokerSkillLevel=B287_GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)
endif
if suijiInvokerSkillLevel>0 then
call SuijiMode_SetCopiedInvokerLevels(suijiInvokerUnit,suijiInvokerSkillLevel)
endif
endfunction
function SuijiMode_InvokerShouldKeepVisible takes unit suijiInvokerUnit,integer suijiInvokerSkill returns boolean
local integer suijiInvokerHandle=0
if suijiInvokerUnit==null or suijiInvokerSkill==0 then
return false
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
return suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current1") or suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current2") or suijiInvokerSkill==OM7(suijiInvokerHandle,"Invoker|Current3") or suijiInvokerSkill==OM7(suijiInvokerHandle,"SuijiSmallSkill") or suijiInvokerSkill==OM7(suijiInvokerHandle,"SuijiUltSkill")
endfunction
function SuijiMode_FixInvokerNativeSkillVisibility takes unit suijiInvokerUnit returns nothing
local integer suijiInvokerHandle=0
local integer suijiInvokerIndex=1
local integer suijiInvokerSkill=0
local integer suijiInvokerCurrent1=0
local integer suijiInvokerCurrent2=0
local integer suijiInvokerCurrent3=0
local player suijiInvokerOwner=null
if SUIJI_MODE==false or SuijiMode_IsInvokerUnit(suijiInvokerUnit)==false then
return
endif
set suijiInvokerHandle=GetHandleId(suijiInvokerUnit)
if OO7(suijiInvokerHandle,"SuijiDone")==false then
return
endif
set suijiInvokerCurrent1=OM7(suijiInvokerHandle,"Invoker|Current1")
set suijiInvokerCurrent2=OM7(suijiInvokerHandle,"Invoker|Current2")
set suijiInvokerCurrent3=OM7(suijiInvokerHandle,"Invoker|Current3")
if (suijiInvokerCurrent1==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent1)==0) and (suijiInvokerCurrent2==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent2)==0) and (suijiInvokerCurrent3==0 or GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerCurrent3)==0) then
return
endif
set suijiInvokerOwner=GetOwningPlayer(suijiInvokerUnit)
loop
exitwhen suijiInvokerIndex>10
set suijiInvokerSkill=BS[suijiInvokerIndex]
if suijiInvokerSkill!=0 then
call SetPlayerAbilityAvailable(suijiInvokerOwner,suijiInvokerSkill,SuijiMode_InvokerShouldKeepVisible(suijiInvokerUnit,suijiInvokerSkill) and GetUnitAbilityLevel(suijiInvokerUnit,suijiInvokerSkill)>0)
endif
set suijiInvokerIndex=suijiInvokerIndex+1
endloop
set suijiInvokerOwner=null
endfunction
function SuijiMode_ShouldRestoreVisibleAbility takes unit u,integer skill returns boolean
local integer tetherLogCount=0
local integer logicalSkill=skill
local integer mappedSkill=0
local trigger tetherController=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if skill=='AMdR' and MiaoStarted and LoadTimerHandle(MiaoTable,GetHandleId(u),101)!=null then
return false
endif
// Restore callers may hold either the logical rawcode or its fixed physical
// clone.  Temporary-state ownership is keyed by the logical skill.
set mappedSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
if mappedSkill!=0 then
set logicalSkill=mappedSkill
endif
// Native Hoof Stomp A00S is owned by the original Centaur/AI command-card
// controller and must never enter generic OMG visibility maintenance. Do not
// depend on a stable hero index here: transformed/newly registered heroes can
// be between identities. Random Hoof Stomp is physical clone Y00E, so it still
// passes this guard and keeps normal random-skill maintenance.
if logicalSkill=='A00S' and B287_GetPhysicalAbilityId(u,logicalSkill)=='A00S' then
return false
endif
// Scepter turns Bristleback into a single active command-card owner. The
// passive script remains enabled while its original or fixed-clone face is
// hidden, so generic AI/OMG repair must not expose both buttons.
if logicalSkill=='A0M3' and SuijiMode_ScepterRegistryIsActive(u,'A0M3') and GetUnitAbilityLevel(u,'ZBBA')>0 then
return false
endif
if B287_IsStateReplaceBaseSkill(logicalSkill) and LoadBoolean(L7,GetHandleId(u),StringHash("B289StateReplaceBase")+logicalSkill) then
if logicalSkill=='A1TA' and SUIJI_LOG then
set tetherLogCount=LoadInteger(L7,GetHandleId(u),StringHash("SuijiTetherRestoreBlockLogCount"))
if tetherLogCount<16 then
set tetherController=LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiTetherController"))
call SaveInteger(L7,GetHandleId(u),StringHash("SuijiTetherRestoreBlockLogCount"),tetherLogCount+1)
call BJDebugMsg("[TETHER-RESTORE-BLOCK] caster="+GetUnitName(u)+"#"+I2S(GetHandleId(u))+" reason=replaced active="+I2S(B287_BoolToInt(LoadBoolean(L7,GetHandleId(u),StringHash("SuijiTetherActive"))))+" controller="+I2S(GetHandleId(tetherController)))
set tetherController=null
endif
endif
return false
endif
if logicalSkill=='A1TA' and LoadBoolean(L7,GetHandleId(u),StringHash("SuijiTetherActive")) then
if SUIJI_LOG then
set tetherLogCount=LoadInteger(L7,GetHandleId(u),StringHash("SuijiTetherRestoreBlockLogCount"))
if tetherLogCount<16 then
set tetherController=LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiTetherController"))
call SaveInteger(L7,GetHandleId(u),StringHash("SuijiTetherRestoreBlockLogCount"),tetherLogCount+1)
call BJDebugMsg("[TETHER-RESTORE-BLOCK] caster="+GetUnitName(u)+"#"+I2S(GetHandleId(u))+" reason=active replaced="+I2S(B287_BoolToInt(LoadBoolean(L7,GetHandleId(u),StringHash("B289StateReplaceBase")+'A1TA')))+" controller="+I2S(GetHandleId(tetherController)))
set tetherController=null
endif
endif
return false
endif
// Telekinesis Land owns the original button slot while any lift controller is
// active. Generic OMG integrity repair must not expose A27F beside A27X.
if logicalSkill=='A27F' and LoadInteger(L7,GetHandleId(u),StringHash("SuijiRubickTelekinesisActive"))>0 then
return false
endif
// Release Snowball temporarily replaces Snowball in the same command-card
// slot. Do not let periodic OMG integrity repair expose both buttons.
if logicalSkill=='A1S7' and LoadInteger(L7,GetHandleId(u),StringHash("SuijiTuskSnowballActive"))>0 then
return false
endif
return true
endfunction
function SuijiAI_RestoreVisibleAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_RestoreVisibleLogicalAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call B287_SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_RestoreOwnedAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and GetUnitAbilityLevel(u,skill)>0 and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,skill,true)
endif
endfunction
function SuijiAI_HideOwnedAbility takes unit u,player p,integer skill returns nothing
// Keep native A00S entirely outside generic visibility writes. Y00E is a
// different rawcode and remains eligible for helper/clone visibility control.
if skill!=0 and skill!='A00S' and GetUnitAbilityLevel(u,skill)>0 then
call SetPlayerAbilityAvailable(p,skill,false)
endif
endfunction
function SuijiAI_RestoreVisibleSkills takes unit u returns nothing
local integer idx=0
local integer h=0
local integer i=KL4
local integer skill=0
local player p=null
// B515: this is an event repair routine, not an AI cast/tick primitive.
// Running its hide-all/restore pass from the 0.70-second random AI pulse made
// selected computer heroes visibly rebuild their command cards.
if u==null or SUIJI_AI_CASTING then
return
endif
set idx=SuijiMode_GetStableHeroIndex(u)
set h=GetHandleId(u)
set p=GetOwningPlayer(u)
loop
exitwhen i>K54
call SuijiAI_HideOwnedAbility(u,p,HR4[i])
call SuijiAI_HideOwnedAbility(u,p,HS4[i])
call SuijiAI_HideOwnedAbility(u,p,HT4[i])
call SuijiAI_HideOwnedAbility(u,p,HU4[i])
call SuijiAI_HideOwnedAbility(u,p,HV4[i])
set i=i+1
endloop
if idx>=KL4 and idx<=K54 then
call SuijiAI_RestoreVisibleAbility(u,p,HM4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HN4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HO4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HP4[idx])
call SuijiAI_RestoreVisibleAbility(u,p,HQ4[idx])
endif
if SuijiMode_IsInvokerUnit(u)==false then
set i=1
loop
exitwhen i>10
set skill=LoadInteger(MSK,idx,i)
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and GetUnitAbilityLevel(u,skill)>0 and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,skill,true)
endif
set i=i+1
endloop
endif
call SuijiAI_RestoreVisibleLogicalAbility(u,p,OM7(h,"SuijiSmallSkill"))
call SuijiAI_RestoreVisibleLogicalAbility(u,p,OM7(h,"SuijiUltSkill"))
call SuijiMode_FixOgreNativeSkillVisibility(u)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
set p=null
endfunction
function SuijiAI_IsImmediateOrder takes string order returns boolean
return order=="stomp" or order=="thunderclap" or order=="fanofknives" or order=="roar" or order=="battleroar" or order=="divineshield" or order=="howlofterror" or order=="berserk" or order=="metamorphosis" or order=="chemicalrage" or order=="bearform" or order=="windwalk" or order=="immolation" or order=="locustswarm" or order=="mirrorimage" or order=="voodoo" or order=="manashield" or order=="phaseshift" or order=="elementalfury" or order=="selfdestruct" or order=="corporealform" or order=="reincarnation" or order=="carrionscarabs" or order=="carrionscarabsoff" or order=="cannibalize" or order=="ancestralspirit" or order=="spiritwolf" or order=="summongrizzly" or order=="itemchangetime" or order=="resurrection" or order=="magicdefense" or order=="recharge" or order=="dispel" or order=="frenzy" or order=="polymorph" or order=="invisibility" or order=="web" or order=="creepanimatedead" or order=="creepdevour" or order=="replenish" or order=="controlmagic"
endfunction
function SuijiAI_IsPointOrder takes string order returns boolean
return order=="blizzard" or order=="flamestrike" or order=="rainoffire" or order=="shockwave" or order=="carrionswarm" or order=="breathoffire" or order=="impale" or order=="clusterrockets" or order=="volcano" or order=="tornado" or order=="inferno" or order=="forceofnature" or order=="summonward" or order=="healingward" or order=="landmine" or order=="stasistrap" or order=="darkportal" or order=="whirlwind" or order=="blink" or order=="earthquake" or order=="disenchant"
endfunction
function SuijiAI_IsSelfTargetOrder takes string order returns boolean
return order=="bloodlust" or order=="innerfire" or order=="frostarmor" or order=="antimagicshell" or order=="invisibility" or order=="replenishmana" or order=="creepheal" or order=="itemareaheal" or order=="holybolt"
endfunction
