if (b1061SavedGetSpellTargetUnit)==null then
set l=GetSpellTargetLoc()
else
set l=GetUnitLoc((b1061SavedGetSpellTargetUnit))
endif
call B99(bj_RADTODEG*Atan2(GetLocationY(l)-y,GetLocationX(l)-x),x,y)
call GroupEnumUnitsInRange(g,x,y,$7D0,Condition(function A09))
call ForGroup(g,function BH9)
call WR7(g)
set BB7=CreateUnit(GetOwningPlayer(WI7),'e00E',x,y,0)
call XF7(BB7,'A0OB')
call SetUnitAbilityLevel(BB7,'A0OB',V77)
call B947IssuePointOrderById("BK9 @ war3map.j:72912 (B968)",BB7,$D0264,GetLocationX(l),GetLocationY(l))
call UnitApplyTimedLife(BB7,'BTLF',1.)
call BJ9(WI7,GetOwningPlayer(WI7),V77,l,x+50*Cos(Atan2(GetLocationY(l)-y,GetLocationX(l)-x)),y+50*Sin(Atan2(GetLocationY(l)-y,GetLocationX(l)-x)))
call RemoveLocation(l)
set WI7=null
set l=null
set g=null
set BB7=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
