return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')!=1 and GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>1)!=null
endfunction
function D39 takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
call SetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE,GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)+F8)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodstoneHealTarget.mdx",(b1060GetEnumUnit),"origin"))
set b1060GetEnumUnit=null
endfunction
function D69 takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local group g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit),1700,Condition(function DC9))
set F8=500+30*GetItemCharges(MV7(b1060GetTriggerUnit,ZU[DI4]))
call ForGroup(g,function D39)
call WR7(g)
set g=null
set b1060GetTriggerUnit=null
endfunction
function DL9 takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit BB7=CreateUnit(GetOwningPlayer(WI7),'H00M',GetUnitX(WI7),GetUnitY(WI7),GetUnitFacing(WI7))
set OA4[GetPlayerId(GetOwningPlayer(WI7))]=BB7
call D69()
set BB7=null
set WI7=null
endfunction
//血精回血回蓝
function D19 takes unit u,integer bloodCharges939 returns nothing
if bloodCharges939>0 then
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+(bloodCharges939*0.5)/5)
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+(bloodCharges939/5))
endif
endfunction
//龙心回血
function LXHX takes unit u returns nothing
local real LIFE_NOW=GetUnitState(u,UNIT_STATE_LIFE)
local real LIFE_MAX=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real recover=LIFE_MAX*0.06*0.2
call SetUnitState(u,UNIT_STATE_LIFE,LIFE_NOW+recover)
endfunction
//防御光环
function FYGH takes unit u returns nothing
local real LIFE_NOW=0.
local real MANA_NOW=0.
local real recover1=0
local real recover2=0
if GetUnitAbilityLevel(u,'B0I9')>0 then
set recover1=16.
set recover2=8.
elseif GetUnitAbilityLevel(u,'B0I8')>0 then
set recover1=8.
set recover2=4.
elseif GetUnitAbilityLevel(u,'B0I7')>0 then
set recover1=4.
set recover2=2.
elseif GetUnitAbilityLevel(u,'B0HO')>0 then
set recover1=2.
set recover2=1.
endif
if recover1>0 then
set LIFE_NOW=GetUnitState(u,UNIT_STATE_LIFE)
set MANA_NOW=GetUnitState(u,UNIT_STATE_MANA)
call SetUnitState(u,UNIT_STATE_LIFE,LIFE_NOW+(recover1*0.2))
call SetUnitState(u,UNIT_STATE_MANA,MANA_NOW+(recover2*0.2))
endif
endfunction
