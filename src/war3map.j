if SUIJI_FIXED_CLONE_READY then
return
endif
set SUIJI_FIXED_CLONE_READY=true
call SuijiMode_FixedCloneMapInit1()
call SuijiMode_FixedCloneMapInit2()
call SuijiMode_FixedCloneMapInit3()
call SuijiMode_FixedCloneMapInit4()
call SuijiMode_FixedCloneMapInit5()
call SuijiMode_FixedCloneMapInit6()
call SuijiMode_FixedCloneMapInit7()
call SuijiMode_FixedCloneMapInit8()
call SuijiMode_FixedCloneMapInit9()
call SuijiMode_FixedCloneMapInit10()
call SuijiMode_FixedCloneMapInit11()
call SuijiMode_FixedCloneMapInit12()
call SuijiMode_FixedCloneMapInit13()
call SuijiMode_FixedCloneMapInitChakramReturn()
call SuijiMode_FixedCloneMapInitInvokerRandom()
call SuijiMode_AlternateCarrierMapInit()
call SuijiMode_CommonOrderAlternateCarrierMapInit()
call SuijiMode_MinimumRandomOrderAlternateCarrierMapInit()
call B287_MHAbility_SetHookOrder('A05G',852128)
call B287_MHAbility_SetHookOrder('A1P9',852599)
call B287_MHAbility_SetHookOrder('A0LC',856196)
call B287_MHAbility_SetHookOrder('A4CB',856196)
