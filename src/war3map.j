if IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_HERO) and VPG(i1)==false and VH!="Split Shot Spell Book" and VH!="Default string" then
call SaveInteger(L7,(GetHandleId(b1060GetTriggerUnit)),(705),(i1))
call SaveInteger(L7,(GetHandleId(b1060GetTriggerUnit)),(712),(B287_GetUnitAbilityLevel(b1060GetTriggerUnit,i1)))
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
