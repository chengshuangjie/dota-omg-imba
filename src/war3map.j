call SuijiTest_DebugAll("TETHER-START","caster="+GetUnitName(ZX7)+"#"+I2S(GetHandleId(ZX7))+" target="+GetUnitName(IH7)+"#"+I2S(GetHandleId(IH7))+" controller="+I2S(GetHandleId(LoadTriggerHandle(L7,GetHandleId(ZX7),StringHash("SuijiTetherController"))))+" lightning="+I2S(GetHandleId(TNG))+" level="+I2S(BC7)+" distance="+R2S(d))
