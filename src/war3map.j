function YJHY3 takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(GetOwningPlayer(u))
local unit DA8=O77(OB7,"Kobold1")
local unit DB8=O77(OB7,"Kobold2")
