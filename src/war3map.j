function Q4D takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WX7=GetTriggerUnit()
local integer spellId=B287_GetSpellAbilityId()
local integer BC7=0
local integer BZ7=0
local boolean QXD=false
local boolean manualCast=false
local boolean autoCast=false
local real cooltime=60
local real d=ReduceUnitAbilityCoolDownReal(WX7)
local integer O5=GetPlayerId(GetOwningPlayer(WX7))
local real remaining=B287_MHAbility_GetCooldown(WX7,'A0NS')
local real aghRemaining=B287_MHAbility_GetCooldown(WX7,'A1DA')
if aghRemaining>remaining then
set remaining=aghRemaining
endif
if SuijiMode_ScepterRegistryIsActive(WX7,'A0NS') then
set BC7=SuijiMode_GetPairCastLevel(WX7,spellId,'A0NS','A1DA')
set cooltime=40
set QXD=true
else
set BC7=SuijiMode_GetPairCastLevel(WX7,spellId,'A0NS','A1DA')
endif
set BZ7=4+BC7
if d>0 then
set cooltime=cooltime*d
endif
if GetGameTime()>HGFZ[O5] and OT7(WX7,"BorrowedTime|Active") then
	call OX7(WX7,"BorrowedTime|Active")
endif
set manualCast=b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and (spellId=='A0NS' or spellId=='A1DA')
set autoCast=b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and remaining<=.01 and GetUnitState(WX7,UNIT_STATE_LIFE)<300+BC7*100 and b1060GetEventDamage<9999 and MRPH(WX7)==false
if BC7>0 and OT7(WX7,"BorrowedTime|Active")==false and (manualCast or autoCast) then
call TimerStart(N84[GetPlayerId(GetOwningPlayer(WX7))],cooltime,false,null)
if B287_GetUnitAbilityLevel(WX7,'A0NS')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A0NS', 1, cooltime)
call B287_MHAbility_SetCooldown(WX7,'A0NS',cooltime)
endif
if B287_GetUnitAbilityLevel(WX7,'A1DA')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A1DA', 1, cooltime)
call B287_MHAbility_SetCooldown(WX7,'A1DA',cooltime)
endif
call SuijiMode_StartPairCooldownSync(WX7,'A0NS','A0NS','A1DA',"SuijiBorrowedTimeCooldown",60.,60.,60.,40.,40.,40.)
call HG_O37(WX7,"BorrowedTime|Active",BZ7)
set HGFZ[O5]=GetGameTime()+BZ7
call UnitRemoveBuffs(WX7,false,true)
call YW8(WX7,0,0)
// if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
// call DisableTrigger(t)
// set DE7=true
// if IssueImmediateOrderById(WX7,$D00A1)==false then
// call P_D(WX7)
// endif
// set DE7=false
// call EnableTrigger(t)
// endif
// if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
// call DisableTrigger(t)
// set DE7=true
// if IssueImmediateOrderById(WX7,$D00A1)==false then
// call P_D(WX7)
// endif
// set DE7=false
// call EnableTrigger(t)
// endif
// if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
// call DisableTrigger(t)
// set DE7=true
// if IssueImmediateOrderById(WX7,$D00A1)==false then
// call P_D(WX7)
// endif
// set DE7=false
// call EnableTrigger(t)
// endif
call YS7("Abilities\\Spells\\Undead\\Unsummon\\UnsummonTarget.mdl",WX7,"origin",BZ7)
elseif manualCast and remaining>0 then
if B287_GetUnitAbilityLevel(WX7,'A0NS')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A0NS', 1, remaining)
endif
if B287_GetUnitAbilityLevel(WX7,'A1DA')>0 then
call B287_YDWESetUnitAbilityState(WX7, 'A1DA', 1, remaining)
endif
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and OT7(WX7,"BorrowedTime|Active")and(b1060GetEventDamage<9999)then
call YN7(WX7,b1060GetEventDamage)
call YN7(WX7,b1060GetEventDamage)
// elseif QXD and Ma(WX7,IH7)<900 and IsUnitAlly(IH7,GetOwningPlayer(WX7))then
// call YN7(WX7,GetEventDamage()*.5)
// call YN7(IH7,GetEventDamage()*.5)
// elseif QXD and Ma(WX7,IH7)<900 and IsUnitAlly(IH7,GetOwningPlayer(WX7))then
// call YN7(WX7,GetEventDamage()*.5)
// call YN7(IH7,GetEventDamage()*.5)
// elseif QXD and Ma(WX7,IH7)<900 and IsUnitAlly(IH7,GetOwningPlayer(WX7))then
// call YN7(WX7,GetEventDamage()*.5)
// call YN7(IH7,GetEventDamage()*.5)
endif
set t=null
set WX7=null
set spellId=0
//set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
