function Surge_Apply takes unit target,real duration,string tx returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,duration,false)
call TriggerAddCondition(t,Condition(function Xq))
call NT7(GetHandleId(t),"Target",target)
call Y17(bR,GetUnitX(target),GetUnitY(target))
call DestroyEffect(AddSpecialEffectTarget(tx,target,"origin"))
call Z57(target,'A4LW',1,duration,'B07W')
call MHUnit_SetMoveSpeedLimit(target,600)
set t=null
endfunction
function XQ takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local unit target
local group g
local integer id=0
local string tx
local real d=0.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set id=GetUnitTypeId(ZX7)
set d=(1.5+B287_GetUnitAbilityLevel(ZX7,'A0R7'))*SuijiMode_GetDurationMulticastCount(ZX7,'A0R7')
if id=='Z00N' then
    set tx="model\\Hero_DarkSeer_N1S_R_Target.mdl"
else
    set tx="effects\\Surge.mdx"
endif
call Surge_Apply(IH7,d,tx)
if SuijiMode_ScepterRegistryIsActive(ZX7,'A0R7') and SuijiMode_DetectAghanimSourceState(ZX7) then
    set g=WS7()
    call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),450.,null)
    loop
        set target=FirstOfGroup(g)
        exitwhen target==null
        call GroupRemoveUnit(g,target)
        if target!=IH7 and UnitAlive(target) and IsUnitAlly(target,GetOwningPlayer(ZX7)) and IsUnitType(target,UNIT_TYPE_STRUCTURE)==false then
            call Surge_Apply(target,d,tx)
        endif
    endloop
    call WR7(g)
    set g=null
endif
set target=null
set ZX7=null
set IH7=null
endfunction
function TED takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0R7' then
call XQ()
endif
return false
endfunction
