set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9S4|r\n- 现在AI聊天系统只有在FUN模式下才会开启\n- 略微降低满级所需经验值\n- 霜之印记和瘟疫守卫可以双击施法\n- 修复传送到冰封王座时传送特效被遮挡的问题\n- [剧毒]受到瘴气的单位都会产生蛇棒，并且毒蛇棒寄生的目标死亡后，蛇棒也会死亡\n- [电狗]增加神杖效果，磁场对范围内所有友方单位生效\n- [发条]玩法大改，史诗级加强\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000近两日英雄改动|r\n- [剧毒]神杖后瘟疫守卫可对友方英雄释放，改为携带蛇棒；瘴气相关蛇棒机制调整\n- [凯哥]埋布地雷改为粘性炸弹，自杀攻击改为爆破起飞\n- [熊猫酒仙]醉酒云雾改为余烬佳酿，醉拳改为姿态切换；大招改为土熊猫核心分身机制\n- [娜迦海妖]神杖后镜像冷却减少，激流改为攻击概率触发的被动效果\n- [血魔]同步新版血魔技能改动，调整血祭等技能逻辑\n- [先知]发芽改为降低护甲；自然之怒命中英雄会施加缠绕并减少冷却\n- [圣骑士]赎罪、忠诚考验、神圣劝化、上帝之手加强，劝化单位更易操作且更耐打\n- [宙斯]神杖新增雷云；静电场改为主动神圣一跳，同时保留原静电场效果\n"
