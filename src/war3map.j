function RME takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
local integer V77=OM7(OB7,"Level")
local integer RNE=0
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(p5) or not B1023HitLive(m5)) then
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set RNE=OM7(GetHandleId(p5),"ChillingCounter")
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==p5 and b1060GetEventDamage>1 then
call DisableTrigger(t)
if RNE>0 then
call NP7(GetHandleId(p5),"ChillingCounter",RNE-1)
call YW7("+"+I2S(10+$A*V77),1,p5,.024,100,$C8,$FF,$FF)
call B67(p5,m5,1,10+$A*V77)
endif
call NM7(OB7)
call OZ7(t)
endif
else
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ROE takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=X3
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED and (not B1023HitLive(GetAttacker()) or not B1023HitLive(b1060GetTriggerUnit)) then
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED then
set p5=GetAttacker()
endif
if p5==null or GetUnitTypeId(p5)==0 then
call NM7(OB7)
if b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ATTACKED then
call OZ7(t)
endif
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ATTACKED or (OM7(GetHandleId(p5),"ChillingCounter")==0 and GetUnitAbilityLevel(p5,'A1HN')>0) then
call DestroyEffect(OG7(GetHandleId(p5),"fx1"))
call DestroyEffect(OG7(GetHandleId(p5),"fx2"))
call NP7(GetHandleId(p5),"ChillingCounter",0)
call NM7(OB7)
if b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ATTACKED then
call OZ7(t)
endif
call UnitRemoveAbility(p5,'A1HN')
call UnitRemoveAbility(p5,'B0CJ')
elseif GetUnitAbilityLevel(p5,'A1HN')>0 and IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_STRUCTURE)==false and OT7(p5,"ChillingTouchState")==false then
call O37(p5,"ChillingTouchState",.4)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call B1023RegisterDamage(t,b1060GetTriggerUnit)
call TriggerRegisterTimerEvent(t,2.,false)
call TriggerAddCondition(t,Condition(function RME))
call NT7(OB7,"Target",b1060GetTriggerUnit)
call NT7(OB7,"Source",p5)
call NP7(OB7,"Level",V77)
endif
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function RPE takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetEnumUnit()
local trigger t=CreateTrigger()
