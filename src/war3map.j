endfunction
function B1012ChainsSilenceEnd takes nothing returns nothing
local timer b1012Timer=GetExpiredTimer()
local integer b1012Key=GetHandleId(b1012Timer)
local unit b1012Target=LoadUnitHandle(L7,b1012Key,0)
if b1012Target!=null and GetUnitTypeId(b1012Target)!=0 then
call MHUnit_Silence(b1012Target,false)
endif
call DestroyEffect(LoadEffectHandle(L7,b1012Key,1))
call FlushChildHashtable(L7,b1012Key)
call PauseTimer(b1012Timer)
call DestroyTimer(b1012Timer)
set b1012Timer=null
set b1012Target=null
endfunction
function B1012ChainsSilence takes unit b1012Victim returns nothing
local timer b1012SilenceTimer=null
if b1012Victim==null or GetUnitTypeId(b1012Victim)==0 or not UnitAlive(b1012Victim) or IsMagicImmuneUnit(b1012Victim) then
return
endif
set b1012SilenceTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b1012SilenceTimer),0,b1012Victim)
call SaveEffectHandle(L7,GetHandleId(b1012SilenceTimer),1,AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",b1012Victim,"overhead"))
// IMBA: silence duration x2 cap 5s.
if XOMG_IMBA_ENABLED then
call TimerStart(b1012SilenceTimer,RMinBJ(2.*IMBA_POWER,5.),false,function B1012ChainsSilenceEnd)
else
call TimerStart(b1012SilenceTimer,2.,false,function B1012ChainsSilenceEnd)
endif
call MHUnit_Silence(b1012Victim,true)
set b1012SilenceTimer=null
endfunction
function WXG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=LoadInteger(L7,I97,5)
local integer Z49=1
local real VW9=0.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(IH7) then
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if BC7==1 then
set Z49=1
set VW9=80
endif
if BC7==2 then
set Z49=2
set VW9=60
endif
if BC7==3 then
set Z49=2
set VW9=120
endif
if BC7==4 then
set Z49=3
set VW9=100
endif
if GetTriggerEvalCount(t)==Z49 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
call B67(ZX7,IH7,1,VW9)
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function WYG takes nothing returns nothing
local unit ZX7=IN4
local unit IH7=IP4
local unit BB7=null
local trigger t=null
local integer I97=0
local integer BC7=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or not UnitAlive(IH7) or IsMagicImmuneUnit(IH7) then
set ZX7=null
set IH7=null
return
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A2H3')
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
set t=CreateTrigger()
set I97=GetHandleId(t)
call UnitAddAbility(BB7,'A2H4')
call SetUnitAbilityLevel(BB7,'A2H4',BC7)
call B947IssueTargetOrderById("WYG @ war3map.j:209233 (B968)",BB7,$D008A,IH7)
call UnitApplyTimedLife(BB7,'BTLF',4.)
call B1012ChainsSilence(IH7)
call TriggerAddCondition(t,Condition(function WXG))
call SaveInteger(L7,I97,5,BC7)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
set BB7=null
set ZX7=null
set IH7=null
set t=null
endfunction
function WZG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local group g=WS7()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit u
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,425,Condition(function A17))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
call ZF7(ZX7,u,'h0E0',"WYG",9000)
endloop
call WR7(g)
set g=null
set ZX7=null
set u=null
endfunction
