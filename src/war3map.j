function B1111SeasonApply takes nothing returns nothing
local trigger seasonTrigger1111=null
// 改世界树模型 
if CurrentMonth > 10 then
    call MHUnit_SetModel(JW_JD,"effects\\TreeOfLifeNewYear.mdx",false)
    call SetUnitScale(JW_JD,5.,5.,5.)
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PATH, "effects\\TreeOfLifeNewYear.mdx")
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PORTRAIT_PATH, "effects\\TreeOfLifeNewYear_portrait.mdx")
    // call EXSetUnitReal('etol', UNIT_REAL_MODEL_SCALE, 5.)
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PATH, "effects\\TreeOfLifeNewYear.mdx")
	// call EXSetUnitString('etol', UNIT_STRING_MODEL_PORTRAIT_PATH, "effects\\TreeOfLifeNewYear_portrait.mdx")
    // call EXSetUnitReal('etol', UNIT_REAL_MODEL_SCALE, 5.)
endif
if CurrentMonth > 10 and not B1111SeasonWeatherSuppressed and not B1111SeasonWeatherTouched[GetPlayerId(GetLocalPlayer())] then
    call EnableWeatherEffect(bo,true)
    call EnableWeatherEffect(Bo,false)
    call EnableWeatherEffect(fL,false)
    call EnableWeatherEffect(FL,false)
endif
if CurrentMonth==12 or CurrentMonth==2 then
    set seasonTrigger1111=CreateTrigger()
    call YB7(seasonTrigger1111,EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(seasonTrigger1111,Condition(function Bingo))
endif
if CurrentMonth==12 then
    call AddSpecialEffectTarget("effects\\santahat.mdl", V4, "head")
endif
set seasonTrigger1111=null
endfunction
function B1111SeasonSyncReceive takes nothing returns nothing
local string syncMonthData1111=DzGetTriggerSyncData()
local integer syncMonth1111=S2I(syncMonthData1111)
if B1111SeasonDone or B1111SeasonReceived or B1111SeasonSender<0 then
return
endif
if GetPlayerId(DzGetTriggerSyncPlayer())!=B1111SeasonSender then
return
endif
if syncMonth1111<1 or syncMonth1111>12 or I2S(syncMonth1111)!=syncMonthData1111 then
return
endif
set CurrentMonth=syncMonth1111
set B1111SeasonReceived=true
endfunction
function B1111SeasonFinalize takes nothing returns nothing
// The common timeout owns cleanup and seasonal handle creation on every client.
set B1111SeasonDone=true
call PauseTimer(B1111SeasonTimer)
call DestroyTimer(B1111SeasonTimer)
set B1111SeasonTimer=null
call DestroyTrigger(B1111SeasonSync)
set B1111SeasonSync=null
call B1111SeasonApply()
endfunction
function InitDate takes nothing returns nothing
local integer syncMonthPid1111=0
local integer syncLocalMonth1111=0
if B1111SeasonStarted then
return
endif
set B1111SeasonStarted=true
set CurrentMonth=0
if Le!=null and TY7(Le) and GetPlayerId(Le)>=0 and GetPlayerId(Le)<=11 then
set B1111SeasonSender=GetPlayerId(Le)
else
loop
exitwhen syncMonthPid1111>11 or B1111SeasonSender>=0
if TY7(Player(syncMonthPid1111)) then
set B1111SeasonSender=syncMonthPid1111
endif
set syncMonthPid1111=syncMonthPid1111+1
endloop
endif
set B1111SeasonSync=CreateTrigger()
call DzTriggerRegisterSyncData(B1111SeasonSync,"B1111MONTH",false)
call TriggerAddAction(B1111SeasonSync,function B1111SeasonSyncReceive)
set B1111SeasonTimer=CreateTimer()
call TimerStart(B1111SeasonTimer,3.,false,function B1111SeasonFinalize)
if B1111SeasonSender>=0 and GetPlayerId(GetLocalPlayer())==B1111SeasonSender then
set syncLocalMonth1111=MHTool_GetLocalTime(SYSTEM_TIME_MONTH)
call DzSyncData("B1111MONTH",I2S(syncLocalMonth1111))
endif
// No valid packet means month 0: the common non-seasonal appearance.
endfunction
function Init_Lock_Camera2 takes nothing returns nothing
local player p=GetLocalPlayer()
local integer I97=GetHandleId(p) 
local real r=LoadReal(TABLE_Z, I97, 100)
if r>0 then
    call SetCameraFieldForPlayer(p, CAMERA_FIELD_TARGET_DISTANCE, r, 0)
endif
set p=null
endfunction
function Init_Lock_Camera takes nothing returns nothing
    local timer t=CreateTimer()
    call TimerStart(t,.1,true,function Init_Lock_Camera2)
    set t=null
endfunction
// KK editor DzAPI_Map_GetPlayerUserName uses the real platform native type 81.
// Never replace this with a local nickname, parsed suffix, hash-only match or stub.
function B894MatchIdentity takes string b894Full returns integer
local integer b894Row=1
if b894Full==null or b894Full=="" then
return 0
endif
loop
exitwhen b894Row>27
if b894Full==B894AllowedIdentity[b894Row] then
return b894Row
endif
set b894Row=b894Row+1
endloop
return 0
endfunction
function B1132ContainsXiaoSheng takes string fuzzyText1132 returns boolean
local integer fuzzyPos1132=0
local integer fuzzyNeedleLength1132=StringLength("小生")
local integer fuzzyTextLength1132=StringLength(fuzzyText1132)
if fuzzyText1132==null or fuzzyText1132=="" then
return false
endif
loop
exitwhen fuzzyPos1132+fuzzyNeedleLength1132>fuzzyTextLength1132
if SubString(fuzzyText1132,fuzzyPos1132,fuzzyPos1132+fuzzyNeedleLength1132)=="小生" then
return true
endif
set fuzzyPos1132=fuzzyPos1132+1
endloop
return false
endfunction
function B1132IsXiaoSheng takes integer fuzzyPid1132 returns boolean
if fuzzyPid1132<0 or fuzzyPid1132>=12 then
return false
endif
if B1132ContainsXiaoSheng(B894PlayerIdentity[fuzzyPid1132]) then
return true
endif
return B1132ContainsXiaoSheng(GetPlayerName(Player(fuzzyPid1132)))
endfunction
function B1133LogWriteFile takes nothing returns nothing
local integer logOffset1133=0
local integer logIndex1133=0
if GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER then
return
endif
call PreloadGenClear()
call PreloadStart()
call Preload("DOTA OMG IMBA recharge/archive diagnostic; local_slot="+I2S(GetPlayerId(GetLocalPlayer()))+" serial="+I2S(B1133LogSerial))
loop
exitwhen logOffset1133>=B1133LogCount
set logIndex1133=ModuloInteger(B1133LogSerial-B1133LogCount+logOffset1133,24)
call Preload(B1133LogRows[logIndex1133])
set logOffset1133=logOffset1133+1
endloop
call PreloadGenEnd("1-miao-error\recharge-p"+I2S(GetPlayerId(GetLocalPlayer()))+".text")
call PreloadGenClear()
endfunction
function B1133LogAppend takes string logText1133 returns nothing
local integer logIndex1133=ModuloInteger(B1133LogSerial,24)
set B1133LogSerial=B1133LogSerial+1
if B1063FaultNote!="" then
set logText1133=logText1133+" | XOMG1-FAULT: "+B1063FaultNote
set B1063FaultNote=""
endif
set B1133LogRows[logIndex1133]="#"+I2S(B1133LogSerial)+" t="+R2S(TimerGetElapsed(W))+" "+logText1133
if B1133LogCount<24 then
set B1133LogCount=B1133LogCount+1
endif
call B1133LogWriteFile()
endfunction
function B1133LogSync takes nothing returns nothing
local integer logPid1133=GetPlayerId(DzGetTriggerSyncPlayer())
call XOMG_LogEvent("LOCAL pid="+I2S(logPid1133)+" "+DzGetTriggerSyncData())
endfunction
function B1133LogShow takes nothing returns nothing
local player logPlayer1133=GetTriggerPlayer()
local integer logOffset1133=0
local integer logIndex1133=0
if not B1132IsXiaoSheng(GetPlayerId(logPlayer1133)) then
call X37(logPlayer1133,"你没有查看充值诊断日志的权限。")
set logPlayer1133=null
return
endif
call DisplayTimedTextToPlayer(logPlayer1133,0,0,30.,"|cffffff00[充值诊断] 最近"+I2S(B1133LogCount)+"条；本地文件：1-miao-error\recharge-p"+I2S(GetPlayerId(logPlayer1133))+".text|r")
loop
exitwhen logOffset1133>=B1133LogCount
set logIndex1133=ModuloInteger(B1133LogSerial-B1133LogCount+logOffset1133,24)
call DisplayTimedTextToPlayer(logPlayer1133,0,0,30.,B1133LogRows[logIndex1133])
set logOffset1133=logOffset1133+1
endloop
set logPlayer1133=null
endfunction
function B1133LogInit takes nothing returns nothing
local trigger logSyncTrigger1133=CreateTrigger()
call DzTriggerRegisterSyncData(logSyncTrigger1133,"B1133LG",false)
call TriggerAddAction(logSyncTrigger1133,function B1133LogSync)
set logSyncTrigger1133=null
call XOMG_LogEvent("INIT logger=ready ver="+XOMG_VERSION+" imba="+I2S(B287_BoolToInt(XOMG_IMBA_ENABLED))+" mult="+I2S(imbaMult)+" legacyXM="+I2S(B287_BoolToInt(XM_MODE)))
endfunction
function B894IdentityInfo takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local integer b894Pid=GetPlayerId(b1060GetTriggerPlayer)
if B894PlayerIdentity[b894Pid]==null or B894PlayerIdentity[b894Pid]=="" then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"平台完整身份未读取；当前玩家名："+GetPlayerName(b1060GetTriggerPlayer)+"。包含‘小生’仍可启用专属福利。")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"平台身份："+B894PlayerIdentity[b894Pid])
if B894PlayerIdentityRow[b894Pid]>0 then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"身份在专属白名单内，沿用原有称号和绑定权益。")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"身份不在专属白名单内；普通玩法和正常存档权益不受影响。")
endif
endif
set b1060GetTriggerPlayer=null
endfunction
