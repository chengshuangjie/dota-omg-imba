call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function BJBH))
loop
exitwhen i>5
set p=Z7[i]
call SetPlayerAbilityAvailable(p,'A1LD',false)
set p=A7[i]
