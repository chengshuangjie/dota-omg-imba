function B1013TeleportCooldownEnd takes nothing returns nothing
local timer b1013Timer=GetExpiredTimer()
local integer b1013TimerKey=GetHandleId(b1013Timer)
local unit b1013Caster=LoadUnitHandle(L7,b1013TimerKey,0)
local integer b1013Physical=0
local ability b1013Ability=null
// The engine starts cooldown after EFFECT. Correct only this completed cast,
// and never clear a later ordinary cooldown after the Scepter was dropped.
if b1013Caster!=null and GetUnitTypeId(b1013Caster)!=0 and SuijiMode_ScepterRegistryIsActive(b1013Caster,'A01O') then
set b1013Physical=B287_GetPhysicalAbilityId(b1013Caster,'A01O')
set b1013Ability=EXGetUnitAbility(b1013Caster,b1013Physical)
if b1013Ability!=null then
call EXSetAbilityState(b1013Ability,1,0.)
endif
endif
call FlushChildHashtable(L7,b1013TimerKey)
call PauseTimer(b1013Timer)
call DestroyTimer(b1013Timer)
set b1013Ability=null
set b1013Caster=null
set b1013Timer=null
endfunction
function B1013TeleportEffect takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local timer b1013CooldownTimer=null
if B287_GetSpellAbilityId()=='A01O' and SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A01O') then
if SUIJI_AGH_DEBUG[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))] and OO7(GetHandleId(b1060GetTriggerUnit),"B1047TeleportPending") then
call DisplayTextToPlayer(GetOwningPlayer(b1060GetTriggerUnit),0,0,"[传送完成] 实际施法耗时="+R2S(GetGameTime()-ON7(GetHandleId(b1060GetTriggerUnit),"B1047TeleportStarted"))+" 秒")
endif
set b1013CooldownTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b1013CooldownTimer),0,b1060GetTriggerUnit)
call TimerStart(b1013CooldownTimer,0.,false,function B1013TeleportCooldownEnd)
endif
set b1013CooldownTimer=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function ZX9 takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local location Mk=GetSpellTargetLoc()
local real x=GetLocationX(Mk)
local real y=GetLocationY(Mk)
local effect furionCastFx1047=null
local real furionFxSpeed1047=1.
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(b1060GetTriggerUnit))then
call PingMinimapEx(x,y,3,$FF,$FF,$FF,false)
endif
if SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A01O') then
// The imported Birth animation is 1500 ms; play it within the one-second cast.
set furionFxSpeed1047=1.5
endif
set furionCastFx1047=AddSpecialEffect("war3mapImported\\FurionTeleportTarget.mdx",x,y)
call EXSetEffectSpeed(furionCastFx1047,furionFxSpeed1047)
call DestroyEffect(furionCastFx1047)
set furionCastFx1047=AddSpecialEffect("war3mapImported\\FurionTeleportTarget.mdx",GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit))
call EXSetEffectSpeed(furionCastFx1047,furionFxSpeed1047)
call DestroyEffect(furionCastFx1047)
set furionCastFx1047=null
call RemoveLocation(Mk)
set Mk=null
set b1060GetTriggerUnit=null
