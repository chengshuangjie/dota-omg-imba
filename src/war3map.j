if id=='N01V' or id=='Z01V' or id=='Z11V' or id=='Z21V' or id=='Z31V' or id=='Z41V' then
	call XF7(u,'A3UG')
	call SetPlayerAbilityAvailable(p,'A3UG',false)
	call XF7(u,'A3UF')
	call XF7(u,'A4F2')
    call SetPlayerAbilityAvailable(p,'A4F2',false)
	if not HaveSavedHandle(TABLE_HY, GetHandleId(u),'A3UF') then
		set U22 = u
		call ExecuteFunc("XJVXX")
	endif
endif
//小黑分裂箭
if id=='Nbrn' then
	call XF7(u,'S3UR')
endif
//小狗
if id=='U00C' or id=='Z00C' then
	call XF7(u,'A194')
    call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A194',true)
    if id=='U00C' then
        call XF7(u,'A4EV')
        call XF7(u,'A4EW')
    endif
endif
//刚背兽刺针扫射：原生英雄和皮肤也走随机技能已使用的即时载体前摇。
