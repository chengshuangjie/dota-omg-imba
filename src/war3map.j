function Give_JJ takes nothing returns nothing
local unit EK9
local real x
local real y
local player p
local integer i
set i=1
loop
exitwhen i>5
set p=Player(i)
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
//set x=GetRandomReal(-7056.,-6700.)
//set y=GetRandomReal(-6700.,-6480.)
//set x=-7100.+100*i
//set x=GetRandomReal(-7056.,-6700.)
//set y=GetRandomReal(-6700.,-6480.)
//set x=-7100.+100*i
set x=-6950.+100*i
set y=-6500.
set EK9=CreateUnit(p,EH9(p),x,y,bj_UNIT_FACING)
call YE8(EK9)
call SaveUnitHandle(TABLE_K, GetHandleId(p),'COUR', EK9)
call SuijiMode_AddCourierWardSkills(EK9)
if OT[i]==false then
call UnitRemoveType(EK9,UNIT_TYPE_PEON)
else
call UnitAddType(EK9,UNIT_TYPE_PEON)
endif
endif
set i=i+1
endloop
set i=7
loop
exitwhen i>11
set p=Player(i)
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
set x=GetRandomReal(6234.,6543.)
set y=GetRandomReal(5740.,6000.)
set EK9=CreateUnit(p,EH9(p),x,y,bj_UNIT_FACING)
call YE8(EK9)
call SaveUnitHandle(TABLE_K, GetHandleId(p),'COUR', EK9)
call SuijiMode_AddCourierWardSkills(EK9)
if OT[i]==false then
call UnitRemoveType(EK9,UNIT_TYPE_PEON)
else
call UnitAddType(EK9,UNIT_TYPE_PEON)
endif
endif
set i=i+1
endloop
call BANPICKSF()
set EK9=null
set p=null
endfunction
