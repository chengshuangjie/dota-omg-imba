	call DzFrameSetTexture(MapSettingsShortcutIcon,"ui\\gaijiananniui1.tga",0)
	set MapSettingsShortcutButton=DzCreateFrameByTagName("TEXTBUTTON","MapSettingsShortcutButton",GameUI,"Glyph_Button",320)
