function XGA takes unit ZX7, unit SZX, integer level, boolean XHA returns nothing
	local group g = WS7()
	local real ZCE = 50 + 40 * level
    local integer id=GetUnitTypeId(ZX7)
    local string tx
    if id=='Z00K' then
        set tx="model\\hero_sandking_n11s_l_boom.mdl"
    elseif id=='Z10K' then
        set tx="AZModel\\AZ_SKcrystal_L2_blast.mdl"
    else
        set tx="Abilities\\Spells\\Undead\\PlagueCloud\\PlagueCloudCaster.mdl"
    endif
	if level == 4 or ISLABIKE(ZX7) then
		set ZCE = 220
	endif
	if XHA then
		set ZCE = ZCE / 2
	endif
    call YS7(tx,SZX,"chest",1)
	set IN4 = ZX7
	set IJ4 = ZCE
	call GroupEnumUnitsInRange(g, GetUnitX(SZX), GetUnitY(SZX), 425, Condition(function XCA))
	call WR7(g)
	set g = null
endfunction
function XJA takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit SZX = LoadUnitHandle(TABLE_HY, h, 1)
	local unit ZX7 = LoadUnitHandle(TABLE_HY, h, 0)
	local integer level = LoadInteger(TABLE_HY, h, 0)
	if ZX7==null or SZX==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(SZX)==0 then
		if SZX!=null and GetUnitTypeId(SZX)!=0 then
			call UnitRemoveAbility(SZX,'A4I3')
			call UnitRemoveAbility(SZX,'B03F')
			call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
			call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
		endif
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		set t = null
		set ZX7 = null
		set SZX = null
		set b1060GetTriggerEventId=null
		return
	endif
	if b1060GetTriggerEventId== EVENT_WIDGET_DEATH then
		call XGA(ZX7, SZX, level, false)
        call UnitRemoveAbility(SZX,'A4I3')
        call UnitRemoveAbility(SZX,'B03F')
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
		call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
	elseif b1060GetTriggerEventId== EVENT_GAME_TIMER_EXPIRED then
		if GetGameTime()>=LoadReal(TABLE_HY, h, 0) or GetUnitAbilityLevel(SZX,'B03F')==0 then
            if GetUnitAbilityLevel(SZX,'B03F')>0 then
			    call XGA(ZX7, SZX, level, true)
            endif
			call UnitRemoveAbility(SZX,'A4I3')
			call UnitRemoveAbility(SZX,'B03F')
			call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
			call RemoveSavedHandle(TABLE_HY, GetHandleId(SZX),'CFNL')
			call RemoveSavedBoolean(TABLE_HY, GetHandleId(SZX),'CFNL')
		endif
	endif
	set t = null
	set ZX7 = null
	set SZX = null
set b1060GetTriggerEventId=null
endfunction
function XKA takes unit ZX7, unit WLE returns nothing
	local trigger t
	local integer h
	local integer ht = GetHandleId(WLE)
    local integer id = GetUnitTypeId(ZX7)
    local string tx
    if id=='Z00K' then
        set tx="model\\hero_sandking_n11s_l_target.mdl"
    elseif id=='Z10K' then
        set tx="AZModel\\AZ_SKcrystal_L1_BUFF.mdl"
    else
        set tx="Abilities\\Spells\\Other\\AcidBomb\\BottleImpact.mdl"
    endif
	if LoadBoolean(TABLE_HY, ht,'CFNL')==false then
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, WLE)
		call TriggerRegisterTimerEvent(t, 1, true)
		call TriggerAddCondition(t, Condition(function XJA))
		call SaveBoolean(TABLE_HY, ht,'CFNL', true)
		call SaveTriggerHandle(TABLE_HY, ht,'CFNL', t)
		call SaveUnitHandle(TABLE_HY, h, 1, WLE)
		call SaveEffectHandle(TABLE_HY, h, 10, AddSpecialEffectTarget(tx, WLE, "chest"))
		call XF7(WLE,'A4I3')
        call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 6)
        call SaveInteger(TABLE_HY, h, 0, B287_GetUnitAbilityLevel(ZX7,'A0FA'))
        call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
	endif
	set t = null
endfunction
function SJA takes nothing returns nothing
	if B287_GetUnitAbilityLevel(WXX,'A0FA')> 0 and ISPH(WXX)==false then
		call XKA(WXX, YXX)
	endif
endfunction
function SJA_JDCC takes nothing returns nothing
