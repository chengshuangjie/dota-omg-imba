			call SaveTimerHandle(TABLE_HY,GetHandleId(nextMissile),StringHash("B582BounceChain"),chainTimer)
            call SaveInteger(TABLE_P,h,3,times-1)
		else
			call B582_DestroyBounceChain(chainTimer)
		endif
		call WR7(g2)
		set g2 = null
	else
		call B582_DestroyBounceChain(chainTimer)
    endif
	set ZX7 = null
	set IH7 = null
	set u = null
	set missileTrigger=null
	set nextMissile=null
	set chainTimer=null
	set bounceFilter=null
endfunction
