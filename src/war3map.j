if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER and (B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A1G7')>0 and GetIssuedOrderId()==$D02AC) then
	if IsDestructableInRange(GetOrderPointX(),GetOrderPointY(),125)==false then
        call KR7(b1060GetTriggerUnit)
        call X377(GetOwningPlayer(b1060GetTriggerUnit),"附近没有树木")
	endif
