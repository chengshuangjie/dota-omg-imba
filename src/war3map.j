set pending955=LoadTimerHandle(B955ArcticPairs,GetHandleId(source955),GetHandleId(target955))
if pending955!=null then
// Consume before ZBD: nested damage must not process the same attack twice.
call B955ArcticClear(pending955)
if GetUnitTypeId(source955)!=0 and GetUnitTypeId(target955)!=0 and UnitAlive(source955) and UnitAlive(target955) then
call ZBD(source955,target955)
endif
endif
endif
set pending955=null
set source955=null
set target955=null
return false
endfunction
