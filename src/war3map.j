function S2D takes unit u returns boolean
return GetUnitAbilityLevel(u,'B02J')>0 or GetUnitAbilityLevel(u,'BUsp')>0 or GetUnitAbilityLevel(u,'Bust')>0 or CHUIFENG(u)
endfunction
function S_D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local integer V77
local unit p5
local unit m5
local real x1
local real y1
local real d
local real a
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call NM7(OB7)
call OZ7(t)
else
set m5=O77(OB7,"Target")
set d=ON7(OB7,"d")
set x=ON7(OB7,"x")
set y=ON7(OB7,"y")
set a=ON7(OB7,"a")
set x1=GetUnitX(m5)+d/ $F*Cos(a)
set y1=GetUnitY(m5)+d/ $F*Sin(a)
if IsUnitType(m5,UNIT_TYPE_HERO) then
call SetUnitPosition(m5,x1,y1)
else
call SetUnitX(m5,x1)
call SetUnitY(m5,y1)
endif
if GetTriggerEvalCount(t)>19 then
set p5=O77(OB7,"Source")
set V77=OM7(OB7,"Level")
call NM7(OB7)
call OZ7(t)
call B67(p5,m5,1,25+V77*50)
set p5=null
endif
set m5=null
endif
set t=null
return false
endfunction
function T4D takes nothing returns nothing
local trigger t
local integer OB7
local unit p5=GetTriggerUnit()
local unit m5=GetEnumUnit()
if S2D(m5)==false and GetUnitTypeId(m5)!='n00L' then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function S_D))
call NQ7(OB7,"x",(j0)*1.)
call NQ7(OB7,"y",(K0)*1.)
call NQ7(OB7,"d",(KF7(j0,K0,GetUnitX(m5),GetUnitY(m5)))*1.)
call NQ7(OB7,"a",(Atan2(K0-GetUnitY(m5),j0-GetUnitX(m5)))*1.)
call NP7(OB7,"Level",l0)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
endif
set t=null
set p5=null
set m5=null
endfunction
function T7D takes nothing returns nothing
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local group g=WS7()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local unit u=(b1061SavedGetTriggerUnit)
local integer id=GetUnitTypeId(u)
local integer V77=B287_GetUnitAbilityLevel(u,'A0QE')
local real r=400+50*V77+25
local effect fx
local string tx
if id=='Z00N' then
    set tx="model\\Hero_DarkSeer_N1S_C_Target_1.mdl"
else
    set tx="war3mapImported\\Star Aura.mdx"
endif
call Y17(DP,x,y)
set fx=AddSpecialEffect(tx,x,y)
call MHEffect_SetScale(fx,2)
call DestroyEffect(fx)
set IN4=u
call GroupEnumUnitsInRange(g,x,y,r,Condition(function AY7_gai))
set j0=x
set K0=y
set l0=V77
call ForGroup(g,function T4D)
call Y67(x,y,200)
call RemoveLocation(l)
call WR7(g)
set l=null
set g=null
set fx=null
set b1061SavedGetTriggerUnit=null
endfunction
