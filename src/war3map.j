set B1057_TEST_ENEMY_BOSS[bossPlayer1057]=null
endfunction
function SuijiTest_CreateEnemyHero takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer playerIndex=GetPlayerId(p)
local unit hero=M7[playerIndex]
local unit dummy=SUIJI_TEST_ENEMY_HERO[playerIndex]
local trigger damageTrigger=SUIJI_TEST_ENEMY_DAMAGE_TRIGGER[playerIndex]
local trigger castTrigger=SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]
local trigger playerDamageTrigger=SUIJI_TEST_PLAYER_DAMAGE_TRIGGER[playerIndex]
if Test_NoOtherHumanPlayer(p)==false then
call DisplayTimedTextToPlayer(p,0,0,5.,"有其他真人玩家时不能使用 -jiaren。")
elseif dummy!=null and GetUnitTypeId(dummy)!=0 then
call B1057ClearTestBosses(playerIndex)
if damageTrigger!=null then
call OZ7(damageTrigger)
endif
if castTrigger!=null then
call NM7(GetHandleId(castTrigger))
call OZ7(castTrigger)
endif
if playerDamageTrigger!=null then
call OZ7(playerDamageTrigger)
endif
call RemoveUnit(dummy)
set SUIJI_TEST_ENEMY_HERO[playerIndex]=null
set SUIJI_TEST_ENEMY_DAMAGE_TRIGGER[playerIndex]=null
set SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]=null
set SUIJI_TEST_PLAYER_DAMAGE_TRIGGER[playerIndex]=null
call DisplayTimedTextToPlayer(p,0,0,5.,"已移除测试英雄、双方测试大怪，并关闭伤害显示与自动测试技能。")
elseif hero==null or GetUnitTypeId(hero)==0 then
call DisplayTimedTextToPlayer(p,0,0,5.,"未找到当前测试英雄，无法生成测试目标。")
else
if damageTrigger!=null then
call OZ7(damageTrigger)
set SUIJI_TEST_ENEMY_DAMAGE_TRIGGER[playerIndex]=null
endif
if castTrigger!=null then
call NM7(GetHandleId(castTrigger))
call OZ7(castTrigger)
set SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]=null
endif
if playerDamageTrigger!=null then
call OZ7(playerDamageTrigger)
set SUIJI_TEST_PLAYER_DAMAGE_TRIGGER[playerIndex]=null
endif
set dummy=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'H9T0',GetUnitX(hero),GetUnitY(hero),GetUnitFacing(hero)+180.)
if dummy!=null then
call SetHeroStr(dummy,0,true)
call SetHeroAgi(dummy,0,true)
call SetHeroInt(dummy,0,true)
call MHUnit_SetData(dummy,UNIT_DATA_LIFE_REGEN,0.)
call SetWidgetLife(dummy,99999.)
call SetUnitAcquireRange(dummy,600.)
call MHUnit_DisableMove(dummy,true)
call B947IssueImmediateOrderById("SuijiTest_CreateEnemyHero @ war3map.j:46824 (B968)",dummy,851972)
call UnitAddAbility(dummy,'XH20')
set damageTrigger=CreateTrigger()
call B1023RegisterDamage(damageTrigger,dummy)
call TriggerAddAction(damageTrigger,function SuijiTest_EnemyHeroDamageDisplay)
set playerDamageTrigger=CreateTrigger()
call B1023RegisterDamage(playerDamageTrigger,hero)
call TriggerAddAction(playerDamageTrigger,function SuijiTest_EnemyHeroDamageDisplay)
set castTrigger=CreateTrigger()
call NP7(GetHandleId(castTrigger),"PlayerIndex",playerIndex)
call NP7(GetHandleId(castTrigger),"CastCooldownTicks",0)
call TriggerRegisterTimerEvent(castTrigger,.25,true)
call TriggerAddCondition(castTrigger,Condition(function SuijiTest_EnemyHeroAutoCast))
set SUIJI_TEST_ENEMY_HERO[playerIndex]=dummy
set SUIJI_TEST_ENEMY_DAMAGE_TRIGGER[playerIndex]=damageTrigger
set SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]=castTrigger
set SUIJI_TEST_PLAYER_DAMAGE_TRIGGER[playerIndex]=playerDamageTrigger
call B1057ClearTestBosses(playerIndex)
set B1057_TEST_ALLY_BOSS[playerIndex]=CreateUnit(p,'n003',GetUnitX(hero)+300.,GetUnitY(hero)+250.,0.)
set B1057_TEST_ENEMY_BOSS[playerIndex]=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'n003',GetUnitX(hero)+300.,GetUnitY(hero)-250.,180.)
call DisplayTimedTextToPlayer(p,0,0,8.,"另已生成我方、敌方攻城傀儡各一只，可测试感染与神杖神圣劝化；再次 -jiaren 一并移除。")
call DisplayTimedTextToPlayer(p,0,0,8.,"已生成敌对测试英雄：双方受到伤害时显示数值；进入525范围后每8秒自动施放一次250点魔法伤害的风暴之锤。")
else
call DisplayTimedTextToPlayer(p,0,0,5.,"测试英雄生成失败。")
endif
endif
set playerDamageTrigger=null
set castTrigger=null
set damageTrigger=null
set dummy=null
set hero=null
set p=null
endfunction
function CM8 takes nothing returns nothing
local string b1060GetEventPlayerChatString=GetEventPlayerChatString()
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=b1060GetEventPlayerChatString
local integer UP
local integer O5
local player pl
local group g
if(VH=="-testhelp")then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"Commands (XX = 2-digit Player Number, ##### = Amount): -jiaren, -jiajineng, -wawj, -gold #####, -goldall #####, -goldforXX #####, -lvlup ##, -lvlupall ##, -lvlupforXX, -spawncreeps, -powerup, -neutrals, -refresh, -refreshall, -kill, -kill XX, -killsent, -killscourge, -killall, -rechoose, -fog, -pm, -time ##, -noherolimit, -trees, -killwards, -spawnoff, -spawnon, -control, -controloff")
elseif(VH=="-rechoose")then
if ISTEST and SUIJI_MODE then
call SavePlayerHandle(L7,StringHash("SuijiTestRechoosePlayer"),0,b1060GetTriggerPlayer)
call ExecuteFunc("SuijiTest_PrepareUnlimitedRechoose")
elseif((not A8)and(not D4)and(not RZ4)and(not O04)and(not W8)and(not O9)and(not H34))then
set G9=true
set I[GetPlayerId(b1060GetTriggerPlayer)]=false
set T9=false
set F9=true
set W4[GetPlayerId(b1060GetTriggerPlayer)]=false
set oo[GetPlayerId(b1060GetTriggerPlayer)]=false
set P9[GetPlayerId(b1060GetTriggerPlayer)]=false
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"一些重选/随机的限制已经移除。 你现在可以使用 -repick/-random")
else
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"不能启用重选/随机。")
endif
elseif(SubString(VH,0,9)=="-goldall ")then
set UP=S2I(SubString(VH,9,StringLength(VH)))
set O5=1
loop
call SetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD)+UP)
set O5=O5+1
exitwhen O5>$B
endloop
elseif(SubString(VH,0,8)=="-goldfor")then
set pl=K27(S2I(SubString(VH,8,StringLength(VH))))
if((pl!=null)and(TA7(pl)))then
set UP=S2I(SubString(VH,$A,StringLength(VH)))
call SetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+UP)
endif
elseif(SubString(VH,0,9)=="-lvlupall")then
set O5=S2I(SubString(b1060GetEventPlayerChatString,9,StringLength(b1060GetEventPlayerChatString)))
if O5<1 then
set O5=1
endif
set IH4=O5
set g=WS7()
call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,Condition(function B08))
call WR7(g)
elseif(SubString(VH,0,9)=="-lvlupfor")then
set pl=K27(S2I(SubString(VH,9,StringLength(VH))))
if((pl!=null)and(TA7(pl)))then
call SetHeroLevel(M7[GetPlayerId(pl)],GetHeroLevel(M7[GetPlayerId(pl)])+1,true)
endif
elseif(VH=="-refreshall")then
set g=WS7()
call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,Condition(function C78))
call WR7(g)
elseif(SubString(VH,0,6)=="-kill ")then
set pl=K27(S2I(SubString(VH,6,StringLength(VH))))
if((pl!=null)and(TA7(pl)))then
call KillUnit(M7[GetPlayerId(pl)])
endif
//elseif(VH=="-fog")then
//call FogEnable(not IsFogEnabled())
//call FogMaskEnable(not IsFogMaskEnabled())
//elseif(VH=="-fog")then
//call FogEnable(not IsFogEnabled())
//call FogMaskEnable(not IsFogMaskEnabled())
//elseif(VH=="-fog")then
//call FogEnable(not IsFogEnabled())
//call FogMaskEnable(not IsFogMaskEnabled())
endif
set g=null
set pl=null
set b1060GetTriggerPlayer=null
endfunction
function CN8 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer O5=1
if false then
set O5=0
endif
loop
if(TY7(Player(O5)))then
call TriggerRegisterPlayerChatEvent(t,Player(O5),"-",false)
endif
set O5=O5+1
exitwhen O5>$B
endloop
call TriggerAddAction(t,function CM8)
set t=null
endfunction
