call DzFrameShow(TpSlotButton,GetPlayerController(p)==MAP_CONTROL_USER)
call DzFrameShow(TpSlotCountText,GetPlayerController(p)==MAP_CONTROL_USER)
call DzFrameShow(TpSlotTargetText,GetPlayerController(p)==MAP_CONTROL_USER)
