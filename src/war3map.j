call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerAddCondition(t,Condition(function WukongsCommand_Move))
set t=null
endfunction
function WukongsCommand_Main takes nothing returns nothing
local unit W4I=GetTriggerUnit()
local real x0=GetSpellTargetX()
local real y0=GetSpellTargetY()
local unit N4I
local integer V6I=0
local trigger t=null
local integer HEI=0
local integer ZXI
local integer ZYI
local real r=650
local real d
local real x
local real y
local unit u
local integer HaveA=0
if W4I==null or GetUnitTypeId(W4I)==0 then
set W4I=null
return
endif
set V6I=SuijiMode_GetPairCastLevel(W4I,B287_GetSpellAbilityId(),'A4CR','A4DA')
if V6I<=0 then
set W4I=null
return
endif
set t=CreateTrigger()
set HEI=GetHandleId(t)
if V6I==1 then
call XF7(W4I,'A4D6')
elseif V6I==2 then
call XF7(W4I,'A4D7')
elseif V6I==3 then
call XF7(W4I,'A4D8')
endif
set u=CreateUnit(GetOwningPlayer(W4I),'h0GP',x0,y0,270)
call XF7(u,'Aloc')
call XF7(u,'A04R')
call SetUnitPathing(u,false)
set ZXI=1
set ZYI=5
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(5)*360.0
set x=x0+300*Cos(d*bj_DEGTORAD)
set y=y0+300*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(200+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
set ZXI=1
set ZYI=9
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(9)*360.0
set x=x0+650*Cos(d*bj_DEGTORAD)
set y=y0+650*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(205+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
if SuijiMode_ScepterRegistryIsActive(W4I,'A4CR') then
set HaveA=1
set r=1100
call SetUnitScale(u,1.46,1.46,1.46)
set ZXI=1
set ZYI=7
loop
exitwhen ZXI>ZYI
set d=ZXI/I2R(7)*360.0
set x=x0+1100*Cos(d*bj_DEGTORAD)
set y=y0+1100*Sin(d*bj_DEGTORAD)
set N4I=GetIllusionPhysicalDamageUnit(W4I,x0,y0,AngleBetweenXY(x0,y0,x,y))
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(6),(x)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(7),(y)*1.0)
call SaveReal(TABLE_XJ,(GetHandleId(N4I)),(13),(AngleBetweenXY(x0,y0,x,y)*1.0))
call SaveUnitHandle(TABLE_XJ,(HEI),(214+ZXI),(N4I))
call WukongsCommand_Summon(N4I)
set ZXI=ZXI+1
endloop
endif
if GetUnitTypeId(W4I)=='Z052' then
call SetUnitAnimationByIndex(W4I,3)
endif
set N4I=CreateUnit(GetOwningPlayer(W4I),'Z053',x0,y0,GetUnitFacing(W4I))
call SetUnitAnimationByIndex(N4I,3)
call SaveEffectHandle(TABLE_XJ,(HEI),(233),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_R3_Gather.mdl",N4I,"origin")))
call XF7(N4I,'Aloc')
call XF7(N4I,'A04R')
call PauseUnit(N4I,true)
call SetUnitPathing(N4I,false)
call SetUnitX(N4I,x0)
call SetUnitY(N4I,y0)
call DestroyEffect((AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(W4I),GetUnitY(W4I))))
call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(222),(N4I))
call SaveUnitHandle(TABLE_XJ,(HEI),(232),(u))
call SaveReal(TABLE_XJ,(HEI),(6),((x0)*1.0))
call SaveReal(TABLE_XJ,(HEI),(7),((y0)*1.0))
call SaveReal(TABLE_XJ,(HEI),(193),((r)*1.0))
call SaveInteger(TABLE_XJ,(HEI),(111),((HaveA)))
call TriggerRegisterTimerEvent(t,0.5,true)
call TriggerRegisterUnitEvent(t,W4I,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function WukongsCommand_Remove))
set W4I=null
set N4I=null
set t=null
set u=null
endfunction
