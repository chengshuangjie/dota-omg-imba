// B821: event listeners stay immediate; only periodic work is batched.
// Registry keys are controller handles, never the non-recycling TS7 index.
function KKTombstoneZombieStop takes trigger tombZombieController,boolean tombKillZombie returns nothing
local integer tombZombieKey=GetHandleId(tombZombieController)
local unit tombZombie=O77(tombZombieKey,"Zombie")
local integer tombOwnerKey=OM7(tombZombieKey,"TombOwner")
local group tombOwned=LoadGroupHandle(KKTombstoneTable,tombOwnerKey,0)
local timer tombBatch=OD7(tombZombieKey,"Batch")
local integer tombBatchKey=GetHandleId(tombBatch)
if tombZombieController==null or tombZombie==null then
set tombOwned=null
set tombBatch=null
return
endif
// Detach every owner before synchronous death/order callbacks can re-enter.
call DisableTrigger(tombZombieController)
if tombOwned!=null then
call GroupRemoveUnit(tombOwned,tombZombie)
endif
call RemoveSavedHandle(KKTombstoneTable,GetHandleId(tombZombie),1)
if tombBatch!=null then
call RemoveSavedHandle(KKTombstoneTable,tombBatchKey,OM7(tombZombieKey,"BatchSlot"))
call NP7(tombBatchKey,"Remaining",OM7(tombBatchKey,"Remaining")-1)
endif
call NM7(tombZombieKey)
call OZ7(tombZombieController)
if GetUnitTypeId(tombZombie)!=0 and UnitAlive(tombZombie) then
if tombKillZombie then
call KillUnit(tombZombie)
elseif D9 then
call PauseUnit(tombZombie,true)
endif
endif
set tombZombie=null
set tombOwned=null
set tombBatch=null
endfunction
function KKTombstoneZombieCheck takes trigger tombCheckController returns nothing
local integer tombCheckKey=GetHandleId(tombCheckController)
local unit tombCheckZombie=O77(tombCheckKey,"Zombie")
local unit tombCheckTarget=O77(tombCheckKey,"Target")
local unit tombCheckSource=O77(tombCheckKey,"TombSource")
local integer tombCheckLevel=OM7(tombCheckKey,"Level")
local integer tombInvisibleTicks=0
local real tombTargetLife=0.
local real tombTargetMaxLife=1.
if tombCheckZombie==null then
set tombCheckTarget=null
set tombCheckSource=null
return
endif
if tombCheckTarget==null or GetUnitTypeId(tombCheckTarget)==0 or not UnitAlive(tombCheckTarget) or GetUnitTypeId(tombCheckZombie)==0 or not UnitAlive(tombCheckZombie) or tombCheckSource==null or GetUnitTypeId(tombCheckSource)==0 or not UnitAlive(tombCheckSource) then
call KKTombstoneZombieStop(tombCheckController,true)
elseif D9 then
call KKTombstoneZombieStop(tombCheckController,false)
else
// Visibility retirement must not be blocked by the low-health haste branch.
if not IsUnitVisible(tombCheckTarget,GetOwningPlayer(tombCheckZombie)) then
set tombInvisibleTicks=OM7(tombCheckKey,"InvisibleTicks")+1
call NP7(tombCheckKey,"InvisibleTicks",tombInvisibleTicks)
else
call NP7(tombCheckKey,"InvisibleTicks",0)
endif
if tombInvisibleTicks>=4 then
call KKTombstoneZombieStop(tombCheckController,true)
elseif GetUnitAbilityLevel(tombCheckZombie,'B0AN')==0 then
set tombTargetLife=GetUnitState(tombCheckTarget,UNIT_STATE_LIFE)
set tombTargetMaxLife=GetUnitState(tombCheckTarget,UNIT_STATE_MAX_LIFE)
if tombTargetMaxLife>0. and (tombTargetLife<100*tombCheckLevel or tombTargetLife/tombTargetMaxLife<.05*tombCheckLevel+.15) then
call SetPlayerAbilityAvailable(GetOwningPlayer(tombCheckZombie),'A176',true)
call B947IssueTargetOrderById("KKTombstoneZombieCheck @ war3map.j:101267 (B968)",wZ[GetPlayerId(GetOwningPlayer(tombCheckZombie))],$D0085,tombCheckZombie)
call SetPlayerAbilityAvailable(GetOwningPlayer(tombCheckZombie),'A176',false)
endif
endif
endif
set tombCheckZombie=null
set tombCheckTarget=null
set tombCheckSource=null
endfunction
function KKTombstoneBatchTick takes nothing returns nothing
local timer tombTickTimer=GetExpiredTimer()
local integer tombTickKey=GetHandleId(tombTickTimer)
local integer tombTickSlot=1
local integer tombTickSize=OM7(tombTickKey,"Size")
local trigger tombTickController=null
loop
exitwhen tombTickSlot>tombTickSize or tombTickSlot>64
set tombTickController=LoadTriggerHandle(KKTombstoneTable,tombTickKey,tombTickSlot)
if tombTickController!=null then
call KKTombstoneZombieCheck(tombTickController)
endif
set tombTickSlot=tombTickSlot+1
endloop
if OM7(tombTickKey,"Remaining")==0 then
call PauseTimer(tombTickTimer)
call FlushChildHashtable(KKTombstoneTable,tombTickKey)
call NM7(tombTickKey)
call DestroyTimer(tombTickTimer)
endif
set tombTickTimer=null
set tombTickController=null
endfunction
function KKTombstoneBatchAdd takes trigger tombAddController,integer tombAddOwnerKey returns nothing
local timer tombAddTimer=LoadTimerHandle(KKTombstoneTable,tombAddOwnerKey,-1)
local integer tombAddKey=GetHandleId(tombAddTimer)
local integer tombAddSlot=OM7(tombAddKey,"Size")+1
if tombAddTimer==null or tombAddSlot>64 then
set tombAddTimer=CreateTimer()
set tombAddKey=GetHandleId(tombAddTimer)
set tombAddSlot=1
call SaveTimerHandle(KKTombstoneTable,tombAddOwnerKey,-1,tombAddTimer)
call TimerStart(tombAddTimer,.5,true,function KKTombstoneBatchTick)
endif
call NP7(tombAddKey,"Size",tombAddSlot)
call NP7(tombAddKey,"Remaining",OM7(tombAddKey,"Remaining")+1)
call SaveTriggerHandle(KKTombstoneTable,tombAddKey,tombAddSlot,tombAddController)
call NC7(GetHandleId(tombAddController),"Batch",tombAddTimer)
call NP7(GetHandleId(tombAddController),"BatchSlot",tombAddSlot)
set tombAddTimer=null
endfunction
function BOD takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit BPD=O77(OB7,"Zombie")
if m5==null or BPD==null or GetUnitTypeId(m5)==0 or GetUnitTypeId(BPD)==0 or not UnitAlive(m5) or not UnitAlive(BPD) then
call KKTombstoneZombieStop(t,true)
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call KKTombstoneZombieStop(t,true)
elseif D9 then
call KKTombstoneZombieStop(t,false)
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER then
// The intended attack already reached the engine; do not send it twice.
if b1060GetIssuedOrderId!=$D000F or b1060GetOrderTargetUnit!=m5 then
call DisableTrigger(t)
call B947IssueTargetOrderById("BOD @ war3map.j:101332 (B968)",BPD,$D000F,m5)
if O77(OB7,"Zombie")!=null then
call EnableTrigger(t)
endif
endif
endif
set t=null
set m5=null
set BPD=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function BRD takes nothing returns boolean
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit m5=GetEnumUnit()
local unit BPD
local integer skillmj
local integer tombSpawnOwnerKey=GetHandleId(KKTombstoneSpawnOwner)
local unit tombSpawnSource=O77(tombSpawnOwnerKey,"Source")
local unit tombSpawnHero=O77(tombSpawnOwnerKey,"Hero")
local integer tombSpawnType=GetUnitTypeId(tombSpawnSource)
local real d=GetHeroStr(tombSpawnHero,true)*.1
if tombSpawnSource==null or GetUnitTypeId(tombSpawnSource)==0 or not UnitAlive(tombSpawnSource) or m5==null or GetUnitTypeId(m5)==0 or not UnitAlive(m5) or LoadGroupHandle(KKTombstoneTable,tombSpawnOwnerKey,0)==null then
call OZ7(t)
set t=null
set m5=null
set tombSpawnSource=null
set tombSpawnHero=null
return false
endif
if tombSpawnType=='n1FJ' or tombSpawnType=='n1FI' or tombSpawnType=='n1F6' or tombSpawnType=='n1FH' then
set skillmj='n1F5'
else
set skillmj='n0F5'
endif
set BPD=CreateUnit(GetOwningPlayer(tombSpawnSource),skillmj,GetUnitX(m5),GetUnitY(m5),0)
// CreateUnit dispatches entry callbacks synchronously; revalidate ownership.
if BPD==null or GetUnitTypeId(BPD)==0 or not UnitAlive(BPD) or not UnitAlive(tombSpawnSource) or not UnitAlive(m5) or LoadGroupHandle(KKTombstoneTable,tombSpawnOwnerKey,0)==null then
call OZ7(t)
if BPD!=null and GetUnitTypeId(BPD)!=0 and UnitAlive(BPD) then
call KillUnit(BPD)
endif
set t=null
set m5=null
set BPD=null
set tombSpawnSource=null
set tombSpawnHero=null
return false
endif
call NT7(OB7,"Target",m5)
call NT7(OB7,"Zombie",BPD)
call NT7(OB7,"TombSource",tombSpawnSource)
call NP7(OB7,"TombOwner",tombSpawnOwnerKey)
call NP7(OB7,"Level",OM7(tombSpawnOwnerKey,"Level"))
call SaveTriggerHandle(KKTombstoneTable,GetHandleId(BPD),1,t)
call GroupAddUnit(LoadGroupHandle(KKTombstoneTable,tombSpawnOwnerKey,0),BPD)
call KKTombstoneBatchAdd(t,tombSpawnOwnerKey)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,BPD,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,BPD,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,BPD,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,BPD,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function BOD))
call YLG2(BPD,R2I(d))
call B947IssueTargetOrderById("BRD @ war3map.j:101396 (B968)",BPD,$D000F,m5)
set t=null
set m5=null
set BPD=null
set tombSpawnSource=null
set tombSpawnHero=null
return false
endfunction
