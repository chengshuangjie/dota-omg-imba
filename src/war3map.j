function GetPrdRandom takes unit u,integer id,real probability returns boolean
    local integer h= GetHandleId(u)
    local real c
    local real random
    local real last
    set c=PseudoRandomDistribution___C[R2I(probability)]
    set random=GetRandomReal(0., 100.)
    set last=LoadReal(TABLE_T, h, id)
    if random < ( last + c ) then
        call SaveReal(TABLE_T, h, id, 0)
        return true
    endif
    call SaveReal(TABLE_T, h, id, last + c)
    return false
endfunction
function TV7 takes player hd returns boolean
return((hd==Z7[0])or(hd==Z7[1])or(hd==Z7[2])or(hd==Z7[3])or(hd==Z7[4])or(hd==Z7[5]))
endfunction
function TW7 takes player hd returns boolean
return((hd==A7[0])or(hd==A7[1])or(hd==A7[2])or(hd==A7[3])or(hd==A7[4])or(hd==A7[5]))
endfunction
function TX7 takes player p returns boolean
return p==Z7[1]or p==Z7[2]or p==Z7[3]or p==Z7[4]or p==Z7[5]or p==A7[1]or p==A7[2]or p==A7[3]or p==A7[4]or p==A7[5]
endfunction
function TY7 takes player j8 returns boolean
return((GetPlayerSlotState(j8)==PLAYER_SLOT_STATE_PLAYING)and(GetPlayerController(j8)==MAP_CONTROL_USER))
endfunction
function TZ7 takes player j8 returns boolean
return(GetPlayerController(j8)==MAP_CONTROL_COMPUTER)and((GetPlayerSlotState(j8)==PLAYER_SLOT_STATE_PLAYING)or QY4[GetPlayerId(j8)])
endfunction
function TA7 takes player j8 returns boolean
return((GetPlayerSlotState(j8)==PLAYER_SLOT_STATE_PLAYING)and((GetPlayerController(j8)==MAP_CONTROL_USER)or(GetPlayerController(j8)==MAP_CONTROL_COMPUTER)))or(QY4[GetPlayerId(j8)]and GetPlayerController(j8)==MAP_CONTROL_COMPUTER)
endfunction
function TB7 takes player j8 returns boolean
return((GetPlayerSlotState(j8)==PLAYER_SLOT_STATE_PLAYING)and GetPlayerController(j8)==MAP_CONTROL_USER)or QY4[GetPlayerId(j8)]
endfunction
function IS_HUMAN takes unit u returns boolean
return((GetPlayerSlotState(GetOwningPlayer(u))==PLAYER_SLOT_STATE_PLAYING)and(GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_USER))
endfunction
function IS_AI takes unit u returns boolean
return(GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER)and((GetPlayerSlotState(GetOwningPlayer(u))==PLAYER_SLOT_STATE_PLAYING)or QY4[GetPlayerId(GetOwningPlayer(u))])
endfunction
function Refresh_AI_Text_Skill_Cooldown takes player p returns nothing
	if not FUN then
		set AI_Text_Skill_Cooldown[GetPlayerId(p)]=GetGameTime()-1
	endif
endfunction
function Send_Chat_Text takes player p,string VH returns nothing
	if TZ7(p)==false or VH=="" then
		return
	endif
	if AICHAT[GetPlayerId(GetLocalPlayer())] then
		call MHUI_SendPlayerChat(p , VH , 10. , CHAT_CHANNEL_ALL)
	endif
endfunction
function Get_Skill_Text takes player p,string VH returns string
	local integer O5=GetPlayerId(p)
	local integer n
	local string s=""
	if TZ7(p)==false then
		return s
	endif
	if FUN==false and VH!="TIANHUOBB" then
		return s
	endif
	if AI_Text_Skill_Cooldown[O5]<=GetGameTime() then
		set AI_Text_Skill_Cooldown[O5]=GetGameTime()+10.
	else
		return s
	endif
	if VH=="BaiNiuC" then
		set n=GetRandomInt(1,41)
		if n==1 then
			set s="冲冲冲！脸给你冲歪！"
		elseif n==2 then
			set s="勇敢牛牛，不怕困难，冲！"
		elseif n==3 then
			set s="随机冲一个幸运儿"
		elseif n==4 then
			set s="我看哪个不买眼的被我冲死"
