function KKServerScore_OnLeave takes player p returns nothing
local integer pid=GetPlayerId(p)
local integer team=0
if pid<0 or pid>$B or KKServerScore_InitialHuman[pid]==false or KKServerScore_Left[pid] then
set p=null
return
endif
// B836: before the grace boundary no coin debit was uploaded; release the reservation.
if not B836ArcStarted or TimerGetElapsed(W)-M_4<=300. then
set B836ArcHeld[pid]=0
endif
set KKServerScore_Left[pid]=true
// Freeze every not-yet-submitted archive reward before leave AI takes over.
set B836ArcTicket[pid]=false
set B836ArcSequence[pid]=B836ArcSequence[pid]+1
set B836ArcOperation[pid]=0
set B839ArcReadPending[pid]=false
call KKServerScore_LeaveDebug(p,"left=1; pending archive rewards cancelled; multiplayer="+I2S(B287_BoolToInt(KKServerScore_Multiplayer))+" started="+I2S(B287_BoolToInt(N54))+" elapsed="+R2S(TimerGetElapsed(W)-M_4)+" ended="+I2S(B287_BoolToInt(D9 or KKServerScore_VictorySettled)))
if KKServerScore_Multiplayer and D9==false and KKServerScore_VictorySettled==false then
set team=KKServerScore_PlayerTeam(p)
if team==1 or team==2 then
set KKServerScore_TeamHadLeaver[team]=true
endif
// B898: the online journal owns counting. Never also increment on leave.
endif
set p=null
endfunction
function KKServerScore_OnVictory takes integer winningTeam returns nothing
local integer i=0
local integer score=0
local integer highest=-1
local player p=null
if KKServerScore_VictorySettled or (winningTeam!=1 and winningTeam!=2)then
return
endif
set KKServerScore_VictorySettled=true
set B1036VictoryTeam=winningTeam
call ExecuteFunc("B1036NormalVictory")
call ExecuteFunc("B1031Settle")
call ExecuteFunc("B1031Pump")
loop
exitwhen i>$B
if KKServerScore_InitialHuman[i] and KKServerScore_Left[i]==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and KKServerScore_PlayerTeam(Player(i))==winningTeam then
set score=T[i]*2+IU[i]
if score>highest then
set highest=score
endif
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>$B
set p=Player(i)
if KKServerScore_InitialHuman[i] and KKServerScore_Left[i]==false and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and KKServerScore_PlayerTeam(p)==winningTeam then
if KK_GAME_DIFFICULTY!=1 and KKServerScore_Multiplayer and KKServerScore_TeamHadLeaver[winningTeam] then
call KKServerScore_Add(p,"XOMG1_WINS")
endif
if KK_GAME_DIFFICULTY!=1 and KKServerScore_Multiplayer and highest>=0 and T[i]*2+IU[i]==highest then
call KKServerScore_Add(p,"XOMG1_MVP")
endif
endif
set i=i+1
endloop
set p=null
endfunction
