elseif GetUnitAbilityLevel(m5,o6)==0 and GetTriggerEvalCount(t)>1 then
    if Have_Item(m5, ZU[ANEW39]) and GetRandomInt(1,100)<=50 then
        call YZ8(m5)
        call YW8(m5,0,0)
