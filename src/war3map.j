function B1093ReleaseEggAlly takes trigger eggFinish1093,boolean eggSuccess1093 returns unit
local integer eggHandle1093=GetHandleId(eggFinish1093)
local unit eggAlly1093=LoadUnitHandle(L7,eggHandle1093,3)
call RemoveSavedHandle(L7,eggHandle1093,3)
if eggAlly1093!=null and GetUnitTypeId(eggAlly1093)!=0 then
call OX7(eggAlly1093,"HideUnit")
call OX7(eggAlly1093,"EGG")
call SetUnitInvulnerable(eggAlly1093,LoadBoolean(L7,eggHandle1093,'egI1'))
call UnitCancelHide(eggAlly1093)
call PauseUnitEx(eggAlly1093,false)
if GetLocalPlayer()==GetOwningPlayer(eggAlly1093) then
call ClearSelection()
call SelectUnit(eggAlly1093,true)
endif
if eggSuccess1093 and UnitAlive(eggAlly1093) then
call SetUnitState(eggAlly1093,UNIT_STATE_LIFE,GetUnitState(eggAlly1093,UNIT_STATE_MAX_LIFE))
call SetUnitState(eggAlly1093,UNIT_STATE_MANA,GetUnitState(eggAlly1093,UNIT_STATE_MAX_MANA))
set B1094_EGG_REFRESH_UNIT=eggAlly1093
call ExecuteFunc("B1094RefreshEggSmallSkillsEvent")
set B1094_EGG_REFRESH_UNIT=null
endif
endif
return eggAlly1093
endfunction
