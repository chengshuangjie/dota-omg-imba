function YV8 takes real x,real y returns location
local real Z97
local real ZD7
local integer i=0
loop
exitwhen i>40
set Z97=x+i*20
set ZD7=y+i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set Z97=x+i*20
set ZD7=y-i*20
if IsPointInRegion(IU4,Z97,ZD7)==false then
return Location(Z97,ZD7)
endif
set Z97=x-i*20
set ZD7=y+i*20
