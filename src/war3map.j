if WF8==i then
call XF7(ZX7,EM7[i])
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),EM7[i],false)
else
call UnitRemoveAbility(ZX7,EM7[i])
endif
set i=i+1
endloop
endfunction
function BJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer WF8=(LoadInteger(L7,(GetHandleId(ZX7)),(728)))-1
call SaveInteger(L7,(GetHandleId(ZX7)),(728),(WF8))
call BIG(ZX7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
function BKG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer WF8=(LoadInteger(L7,(GetHandleId(ZX7)),(728)))+1
if IsUnitEnemy(GetAttacker(),GetOwningPlayer(ZX7)) and ISPH(ZX7)==false then
call SaveInteger(L7,(GetHandleId(ZX7)),(728),(WF8))
call BIG(ZX7)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,12+2*GetUnitAbilityLevel(ZX7,'A2E4'),false)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerAddCondition(t,Condition(function BJG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
endif
set t=null
set ZX7=null
return false
endfunction
function SuijiMode_ReactiveArmorInitUnit takes unit ZX7 returns nothing
local trigger t=null
local integer I97=0
local integer h=0
if ZX7==null or GetUnitTypeId(ZX7)==0 or GetUnitAbilityLevel(ZX7,'A2E4')<=0 or IsUnitIllusion(ZX7) then
return
endif
set h=GetHandleId(ZX7)
if LoadBoolean(L7,h,StringHash("SuijiReactiveArmorInit")) then
return
endif
call SaveBoolean(L7,h,StringHash("SuijiReactiveArmorInit"),true)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function BKG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
set t=null
set ZX7=null
endfunction
