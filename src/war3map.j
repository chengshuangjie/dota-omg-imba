function SuijiMode_ScriptedFlightActive takes integer h,integer status returns boolean
if status==1 then
return OO7(h,"SuijiScriptedDarkFlight")
elseif status==2 then
return OO7(h,"SuijiScriptedFireFlight")
elseif status==4 then
return OO7(h,"SuijiScriptedArcticFlight")
endif
return OO7(h,"SuijiScriptedDragonFlight")
endfunction
function SuijiMode_ScriptedFlightRefresh takes unit u returns nothing
local integer h=0
local integer currentType=0
local real height=220.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDarkFlight")==false and OO7(h,"SuijiScriptedFireFlight")==false and OO7(h,"SuijiScriptedDragonFlight")==false and OO7(h,"SuijiScriptedArcticFlight")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedFlightUnitType") then
call NP7(h,"SuijiScriptedFlightUnitType",currentType)
call NP7(h,"SuijiScriptedFlightBaseMoveType",MHUnit_GetMoveType(u))
call NQ7(h,"SuijiScriptedFlightBaseHeight",GetUnitFlyHeight(u))
endif
if OO7(h,"SuijiScriptedDragonFlight") then
set height=250.
endif
if OO7(h,"SuijiScriptedDarkFlight") then
set height=300.
endif
// B969: both halves must select flight. $2000004 retained the ground movement
// class in its high bits, so a flying height/path mask still used ground motion.
call MHUnit_SetMoveType(u,UNIT_MOVE_TYPE_FLY)
// All four scripted flight owners share terrain traversal, including Firefly.
// Release it only after the last owner ends; retain external pathing requests.
if not LoadBoolean(L7,h,StringHash("B968FlightPath")) then
call SaveBoolean(L7,h,StringHash("B968FlightResumePathing"),not LoadBoolean(UnitDataHashTable,h,UNIT_PATHING))
call SaveBoolean(L7,h,StringHash("B968FlightPath"),true)
call SetUnitPathingEx(u,LoadBoolean(L7,h,StringHash("B968FlightResumePathing")))
endif
call SetUnitFlyHeight(u,height,0.)
endfunction
function SuijiMode_EndScriptedFlight takes unit u,integer status returns nothing
local integer h=0
if u==null then
return
endif
set h=GetHandleId(u)
if SuijiMode_ScriptedFlightActive(h,status)==false then
return
endif
if status==1 then
call NS7(h,"SuijiScriptedDarkFlight",false)
call UnitRemoveAbility(u,'ZNSD')
elseif status==2 then
call NS7(h,"SuijiScriptedFireFlight",false)
call UnitRemoveAbility(u,'ZFFM')
// Defensive cleanup for B571 and earlier direct-child states.
call UnitRemoveAbility(u,'ZFFS')
call SuijiMode_EndVisualForm(u,2)
elseif status==4 then
call NS7(h,"SuijiScriptedArcticFlight",false)
else
call NS7(h,"SuijiScriptedDragonFlight",false)
endif
if GetUnitTypeId(u)!=0 then
if OO7(h,"SuijiScriptedDarkFlight") or OO7(h,"SuijiScriptedFireFlight") or OO7(h,"SuijiScriptedDragonFlight") or OO7(h,"SuijiScriptedArcticFlight") then
call SuijiMode_ScriptedFlightRefresh(u)
else
call MHUnit_SetMoveType(u,OM7(h,"SuijiScriptedFlightBaseMoveType"))
if LoadBoolean(L7,h,StringHash("B968FlightPath")) then
call RemoveSavedBoolean(L7,h,StringHash("B968FlightPath"))
call SetUnitPathingEx(u,LoadBoolean(L7,h,StringHash("B968FlightResumePathing")))
call RemoveSavedBoolean(L7,h,StringHash("B968FlightResumePathing"))
endif
call SetUnitFlyHeight(u,ON7(h,"SuijiScriptedFlightBaseHeight"),0.)
call NP7(h,"SuijiScriptedFlightUnitType",0)
endif
endif
endfunction
function SuijiMode_ScriptedFlightTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer status=LoadInteger(L7,timerHandle,1)
local integer serial=LoadInteger(L7,timerHandle,2)
local integer h=0
local integer currentSerial=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if status==1 then
set currentSerial=OM7(h,"SuijiScriptedDarkFlightSerial")
elseif status==2 then
set currentSerial=OM7(h,"SuijiScriptedFireFlightSerial")
elseif status==4 then
set currentSerial=OM7(h,"SuijiScriptedArcticFlightSerial")
else
set currentSerial=OM7(h,"SuijiScriptedDragonFlightSerial")
endif
if serial!=currentSerial then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,3) then
call SuijiMode_EndScriptedFlight(u,status)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ScriptedFlightRefresh(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedFlight takes unit u,integer status,real duration returns nothing
local integer h=0
local integer serial=0
local timer t=null
if u==null or GetUnitTypeId(u)==0 or duration<=0. then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDarkFlight")==false and OO7(h,"SuijiScriptedFireFlight")==false and OO7(h,"SuijiScriptedDragonFlight")==false and OO7(h,"SuijiScriptedArcticFlight")==false then
call NP7(h,"SuijiScriptedFlightUnitType",0)
endif
if status==1 then
set serial=OM7(h,"SuijiScriptedDarkFlightSerial")+1
call NP7(h,"SuijiScriptedDarkFlightSerial",serial)
call NS7(h,"SuijiScriptedDarkFlight",true)
call XF7(u,'ZNSD')
call UnitMakeAbilityPermanent(u,true,'ZNSD')
elseif status==2 then
set serial=OM7(h,"SuijiScriptedFireFlightSerial")+1
call NP7(h,"SuijiScriptedFireFlightSerial",serial)
call NS7(h,"SuijiScriptedFireFlight",true)
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZFFM',1)
// Native Firefly gets flight from the O016 -> O017 UnitID transform. Random
// ANcl casts need the standard one-shot Crow Form unlock before height writes.
if GetUnitAbilityLevel(u,'Amrf')==0 then
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
endif
call SuijiMode_SetVisualForm(u,2,EXGetUnitString('O017',UNIT_STRING_MODEL_PATH))
elseif status==4 then
set serial=OM7(h,"SuijiScriptedArcticFlightSerial")+1
call NP7(h,"SuijiScriptedArcticFlightSerial",serial)
call NS7(h,"SuijiScriptedArcticFlight",true)
if GetUnitAbilityLevel(u,'Amrf')==0 then
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
endif
else
set serial=OM7(h,"SuijiScriptedDragonFlightSerial")+1
call NP7(h,"SuijiScriptedDragonFlightSerial",serial)
call NS7(h,"SuijiScriptedDragonFlight",true)
// Ground-based random heroes need the standard one-shot Crow Form unlock
// before SetUnitFlyHeight can raise them.  Preserve heroes that already own it.
if GetUnitAbilityLevel(u,'Amrf')==0 then
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
endif
endif
call SuijiMode_ScriptedFlightRefresh(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,status)
call SaveInteger(L7,GetHandleId(t),2,serial)
call SaveReal(L7,GetHandleId(t),3,TimerGetElapsed(W)+duration)
call TimerStart(t,.10,true,function SuijiMode_ScriptedFlightTick)
set t=null
endfunction
// Random Arctic Burn cannot use A2NE/A3NE's Wyvern-only UnitID transforms.
// Its single synchronized lifecycle owns range, flight, visual FX and Scepter
// mana drain; it never scans units or rewrites command metadata periodically.
function SuijiMode_RestoreScriptedArcticBurn takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedArcticBurn")==false then
return
endif
if SuijiMode_ScriptedFlightActive(h,4) then
call SuijiMode_EndScriptedFlight(u,4)
endif
if GetUnitTypeId(u)!=0 then
call B848_SetFormRange(u,ON7(h,"SuijiScriptedArcticBaseRange"))
call B1091SetAcquireBase(u,ON7(h,"SuijiScriptedArcticBaseAcquire"))
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedArcticEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedArcticEffect"))
endif
call NS7(h,"SuijiScriptedArcticBurn",false)
call NS7(h,"SuijiScriptedArcticScepter",false)
set fx=null
endfunction
function SuijiMode_ApplyScriptedArcticBurn takes unit u returns nothing
local integer h=0
local integer level=0
local real range=700.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedArcticBurn")==false then
return
endif
set level=B287_GetUnitAbilityLevel(u,'A2NE')
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
set range=600.+100.*level
call B848_SetFormRange(u,range)
if ON7(h,"SuijiScriptedArcticBaseAcquire")<range then
call B1091SetAcquireBase(u,range)
else
call B1091SetAcquireBase(u,ON7(h,"SuijiScriptedArcticBaseAcquire"))
endif
call SuijiMode_ScriptedFlightRefresh(u)
endfunction
function SuijiMode_UpdateScriptedArcticMulticastDuration takes unit u returns nothing
local integer h=0
local integer count=1
local real wanted=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedArcticBurn")==false or OO7(h,"SuijiScriptedArcticScepter") then
return
endif
set count=SuijiMode_GetDurationMulticastCount(u,'A2NE')
if count<1 then
set count=1
endif
set wanted=ON7(h,"SuijiScriptedArcticStart")+6.*count
if wanted>ON7(h,"SuijiScriptedArcticEnd") then
call NQ7(h,"SuijiScriptedArcticEnd",wanted)
endif
endfunction
function SuijiMode_ScriptedArcticBurnTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
local real mana=0.
local boolean activeScepter=false
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedArcticSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set activeScepter=SuijiMode_ScepterRegistryIsActive(u,'A2NE')
if UnitAlive(u)==false or B287_GetUnitAbilityLevel(u,'A2NE')<=0 or activeScepter!=OO7(h,"SuijiScriptedArcticScepter") or (activeScepter==false and TimerGetElapsed(W)>=ON7(h,"SuijiScriptedArcticEnd")) then
call SuijiMode_RestoreScriptedArcticBurn(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
elseif activeScepter then
set mana=GetUnitState(u,UNIT_STATE_MANA)
if mana<=5. then
call SetUnitState(u,UNIT_STATE_MANA,0.)
call SuijiMode_RestoreScriptedArcticBurn(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SetUnitState(u,UNIT_STATE_MANA,mana-5.)
call SuijiMode_ApplyScriptedArcticBurn(u)
endif
else
call SuijiMode_ApplyScriptedArcticBurn(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedArcticBurn takes unit u returns nothing
local integer h=0
local integer serial=0
local integer count=1
local real now=0.
local timer t=null
local effect fx=null
local boolean activeScepter=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedArcticBurn") then
return
endif
set now=TimerGetElapsed(W)
set activeScepter=SuijiMode_ScepterRegistryIsActive(u,'A2NE')
if activeScepter==false then
set count=SuijiMode_GetDurationMulticastCount(u,'A2NE')
if count<1 then
set count=1
endif
endif
set serial=OM7(h,"SuijiScriptedArcticSerial")+1
call NP7(h,"SuijiScriptedArcticSerial",serial)
call NQ7(h,"SuijiScriptedArcticStart",now)
call NQ7(h,"SuijiScriptedArcticEnd",now+6.*count)
call NQ7(h,"SuijiScriptedArcticBaseRange",B848_FormBaseRange(u))
call NQ7(h,"SuijiScriptedArcticBaseAcquire",B1091AcquireBase(u))
call NS7(h,"SuijiScriptedArcticScepter",activeScepter)
call NS7(h,"SuijiScriptedArcticBurn",true)
if OO7(h,"SuijiScriptedDarkFlight")==false and OO7(h,"SuijiScriptedFireFlight")==false and OO7(h,"SuijiScriptedDragonFlight")==false and OO7(h,"SuijiScriptedArcticFlight")==false then
call NP7(h,"SuijiScriptedFlightUnitType",0)
endif
call NS7(h,"SuijiScriptedArcticFlight",true)
if GetUnitAbilityLevel(u,'Amrf')==0 then
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
endif
set fx=AddSpecialEffectTarget("war3mapImported\\ArcticSiege.mdx",u,"chest")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedArcticEffect"),fx)
call SuijiMode_ApplyScriptedArcticBurn(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call TimerStart(t,.10,true,function SuijiMode_ScriptedArcticBurnTick)
set fx=null
set t=null
endfunction
function HASJ_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(0)))
local integer level=B287_GetUnitAbilityLevel(ZX7,'A03K')
if GetTriggerEventId()==EVENT_UNIT_DEATH then
    call B_7(ZX7,0)
    call FlushChildHashtable(L7,(OB7))
    call OZ7(t)
elseif GetTriggerEvalCount(t)==1 then
    call B_7(ZX7,40*level)
else
    call B_7(ZX7,0)
    call FlushChildHashtable(L7,(OB7))
    call OZ7(t)
endif
set t=null
set ZX7=null
return false
endfunction
function HASJ_START takes nothing returns nothing
local integer b1061SavedGetSpellAbilityId=GetSpellAbilityId()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit ZX7=(b1061SavedGetTriggerUnit)
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real duration=30.
if (b1061SavedGetSpellAbilityId)=='Y0BF' then
set duration=30.*SuijiMode_GetDurationMulticastCount(ZX7,'A03K')
call SuijiMode_StartScriptedFlight(ZX7,1,duration)
endif
call UnitApplyTimedLife(BB7,'BTLF',2.)
call Sky_View_MJ(ZX7,30.)
call StartSound(Sound_DarkTime)
call XF7(BB7,'A4G5')
call B947IssueImmediateOrderById("HASJ_START @ war3map.j:103662 (B968)",BB7,$D028D)
call SaveUnitHandle(L7,OB7,0,ZX7)
call TriggerRegisterTimerEvent(t,0.1,false)
call TriggerRegisterTimerEvent(t,duration,false)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function HASJ_Damage))
call YS7("tx\\yemo\\portaleffect.mdl",ZX7,"origin",1)
set ZX7=null
set BB7=null
set b1061SavedGetTriggerUnit=null
endfunction
function HASJ2 takes nothing returns boolean
local unit u=GetTriggerUnit()
if B287_GetSpellAbilityId()=='A03K'then
    if GetUnitTypeId(u)=='Udre' or (SUIJI_MODE and OO7(GetHandleId(u),"SuijiDone") and B287_GetUnitAbilityLevel(u,'A03K')>0) then
        call HASJ_START()
    elseif GetUnitTypeId(u)=='Udrf' then
        call Fix_unit_high(u)
    endif
endif
set u=null
return false
endfunction
function HASJ takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function HASJ2)
set t=null
endfunction
function HASJ_REMOVE_BUFF takes unit ZX7 returns boolean
return X67() or SuijiMode_ScepterRegistryIsActive(ZX7,'A03K')==false or ISPH(ZX7)
endfunction
function LRD takes nothing returns boolean
local trigger nightStalkerVisionTrigger=GetTriggeringTrigger()
local integer I97=GetHandleId(nightStalkerVisionTrigger)
local unit LSD=O77(I97,"NightStalker")
local unit LTD=O77(I97,"VisionUnit")
if LSD==null or GetUnitTypeId(LSD)==0 or LTD==null then
if LTD!=null then
call RemoveUnit(LTD)
endif
call FlushChildHashtable(L7,I97)
call OZ7(nightStalkerVisionTrigger)
set LSD=null
set LTD=null
set nightStalkerVisionTrigger=null
return false
endif
if XH7(LSD) or HASJ_REMOVE_BUFF(LSD) then
call ShowUnit(LTD,false)
else
call ShowUnit(LTD,true)
call SetUnitX(LTD,GetUnitX(LSD))
call SetUnitY(LTD,GetUnitY(LSD))
endif
if GetOwningPlayer(LTD)!=GetOwningPlayer(LSD)then
call SetUnitOwner(LTD,GetOwningPlayer(LSD),true)
endif
set LSD=null
set LTD=null
set nightStalkerVisionTrigger=null
return false
endfunction
function LUD takes nothing returns nothing
local trigger nightStalkerBuffTrigger=GetTriggeringTrigger()
local integer OB7=GetHandleId(nightStalkerBuffTrigger)
local unit LSD=O77(OB7,"NightStalker")
if LSD==null or GetUnitTypeId(LSD)==0 then
call FlushChildHashtable(L7,OB7)
call OZ7(nightStalkerBuffTrigger)
set LSD=null
set nightStalkerBuffTrigger=null
return
endif
call B925NightHunterSync(LSD)
set LSD=null
set nightStalkerBuffTrigger=null
endfunction
function LVD takes unit LSD,integer LWD returns nothing
local integer I97=GetHandleId(LSD)
local trigger t
if LSD==null or GetUnitTypeId(LSD)==0 then
return
endif
call B925NightHunterSync(LSD)
if B287_GetUnitAbilityLevel(LSD,'A086')<=0 then
return
endif
if OO7(I97,"NightStalkerAlreadyLearned")==false then
call NS7(I97,"NightStalkerAlreadyLearned",true)
set t=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(t,.5)
call TriggerRegisterUnitEvent(t,LSD,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,LSD,EVENT_UNIT_HERO_REVIVE_FINISH)
call TriggerRegisterGameStateEventTimeOfDay(t,LESS_THAN,6.)
call TriggerRegisterGameStateEventTimeOfDay(t,GREATER_THAN,18.)
call TriggerAddAction(t,function LUD)
call NT7(GetHandleId(t),"NightStalker",LSD)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function LRD))
call NT7(I97,"NightStalker",LSD)
call NT7(I97,"VisionUnit",CreateUnit(GetOwningPlayer(LSD),'o01A',GetUnitX(LSD),GetUnitY(LSD),0))
endif
set t=null
endfunction
function LXD takes nothing returns boolean
if B287_GetLearnedSkill()=='A086' and IsUnitIllusion(GetTriggerUnit())==false then
call LVD(GetTriggerUnit(),B287_GetLearnedSkill())
endif
return false
endfunction
function B925NightHunterCanConsume takes unit hunterCaster925,unit hunterTarget925 returns boolean
local integer hunterMaxLevel925=5
if hunterCaster925==null or GetUnitTypeId(hunterCaster925)==0 or XH7(hunterCaster925) then
return false
endif
if B287_GetUnitAbilityLevel(hunterCaster925,'A086')<=0 or SuijiMode_IsSacrificeProtectedTarget(hunterTarget925) then
return false
endif
if IsUnitType(hunterTarget925,UNIT_TYPE_STRUCTURE) or IsUnitType(hunterTarget925,UNIT_TYPE_ANCIENT) then
return false
endif
if SuijiMode_ScepterRegistryIsActive(hunterCaster925,'A086') then
set hunterMaxLevel925=6
endif
return GetUnitLevel(hunterTarget925)<=hunterMaxLevel925
endfunction
function AYLS_EXPD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
if not B925NightHunterCanConsume(WI7,m5) then
    call KR7(WI7)
call X37(GetOwningPlayer(WI7),GetObjectName('n0CX'))
endif
set WI7=null
set m5=null
endfunction
function AYLS_ACTION takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer level=B287_GetUnitAbilityLevel(p5,'A086')
if not B925NightHunterCanConsume(p5,m5) then
set p5=null
set m5=null
return
endif
call SetUnitState(p5,UNIT_STATE_LIFE,GetUnitState(p5,UNIT_STATE_LIFE)+GetUnitState(p5,UNIT_STATE_MAX_LIFE)*.05*level)
call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+GetUnitState(p5,UNIT_STATE_MAX_MANA)*.05*level)
if IsUnitAlly(m5,GetOwningPlayer(p5)) then
set Ovv=true
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",m5,"origin"))
call B67(p5,m5,1,99999)
call B67(p5,m5,2,99999)
call B67(p5,m5,3,99999)
set p5=null
set m5=null
endfunction
function AYLS takes nothing returns boolean
if B287_GetSpellAbilityId()=='A086' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call AYLS_ACTION()
else
call AYLS_EXPD()
endif
endif
return false
endfunction
