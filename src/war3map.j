function ELQX2 takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local real damage = LoadReal(TABLE_HY, h, 10)
    local real d=0.
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        set ZX7 = null
        set IH7 = null
        return
    endif
    set d=Attack_Damage(ZX7,IH7,damage)
    call B67(ZX7, IH7, 2, damage)
    if IsUnitIllusion(IH7) == false then
        call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+ d * 0.5)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
    endif
	set ZX7 = null
	set IH7 = null
endfunction
function ELQX takes unit ZX7,unit IH7 returns nothing
	local trigger t
	local integer h
    local real damage
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    set damage = (GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )* 0.8
    set t=NHX(ZX7, IH7,'h0HS', "ELQX2",800, true, "")
    set h=GetHandleId(t)
	call SaveReal(TABLE_HY, h, 10, damage)
	set t = null
endfunction
