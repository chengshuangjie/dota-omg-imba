local integer h=0
local integer r=1
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
return 1
endif
set h=GetHandleId(u)
if B287_GetUnitAbilityLevel(u,'A088')<=0 then
return 1
endif
if GetUnitTypeId(u)!='Hmkg' and SuijiMode_GetStableHeroIndex(u)!=18 and (OO7(h,"SuijiDone")==false or OO7(h,"SuijiMulticast")==false) then
return 1
endif
if OO7(h,"SuijiMulticastCasting") or ON7(h,"SuijiMulticastBlockUntil")>TimerGetElapsed(W) then
return 1
endif
set r=EUD(u)
if r<1 then
set r=1
elseif r>5 then
set r=5
endif
return r
endfunction
function SuijiMode_TideRavageMulticastText takes unit u,integer r returns nothing
if r==2 then
call YW7(GetObjectName('n0K7'),5,u,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,u,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,u,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,u,.03,255,0,0,255)
endif
endfunction
function B978RavageTick takes nothing returns boolean
local trigger wave978=GetTriggeringTrigger()
local integer key978=GetHandleId(wave978)
local unit caster978=O77(key978,"Source")
local unit target978=null
local group scan978=OF7(key978,"Scan")
local group hit978=OF7(key978,"Hits")
local real x978=ON7(key978,"X")
local real y978=ON7(key978,"Y")
local real limit978=ON7(key978,"Range")
local real radius978=RMinBJ(limit978,GetTriggerEvalCount(wave978)*48.4375)
local real dx978=0.
local real dy978=0.
local real angle978=0.
local integer ray978=0
local boolexpr filter978=Condition(function AJ7_gai)
// One broad phase, followed by the exact nearest of the sixteen legacy ray disks.
set IN4=caster978
call GroupEnumUnitsInRange(scan978,x978,y978,radius978+250.,filter978)
call DestroyBoolExpr(filter978)
loop
set target978=FirstOfGroup(scan978)
exitwhen target978==null
call GroupRemoveUnit(scan978,target978)
if not IsUnitInGroup(target978,hit978) then
set dx978=GetUnitX(target978)-x978
set dy978=GetUnitY(target978)-y978
set angle978=Atan2(dy978,dx978)
if angle978<0. then
set angle978=angle978+2.*bj_PI
endif
set ray978=R2I(angle978/(bj_PI/8.)+.5)
set angle978=ray978*(bj_PI/8.)
set dx978=dx978-radius978*Cos(angle978)
set dy978=dy978-radius978*Sin(angle978)
if dx978*dx978+dy978*dy978<=62500. and not WF7(target978) and not CHUIFENG(target978) and not OT7(target978,"Omnislashing") then
call GroupAddUnit(hit978,target978)
call GZE(target978,caster978,ON7(key978,"Duration"),ON7(key978,"Damage"),.75)
endif
endif
endloop
if radius978-ON7(key978,"LastFX")>=ON7(key978,"FXInterval") then
call NQ7(key978,"LastFX",radius978)
set ray978=1
loop
exitwhen ray978>16
set angle978=ray978*22.5*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect(LoadStr(L7,key978,StringHash("B978FX")),x978+radius978*Cos(angle978),y978+radius978*Sin(angle978)))
set ray978=ray978+1
endloop
endif
if radius978>=limit978 then
call DestroyGroup(scan978)
call NM7(key978)
call OZ7(wave978)
endif
set filter978=null
set wave978=null
set caster978=null
set target978=null
set scan978=null
set hit978=null
return false
endfunction
function B978StartRavage takes unit caster978,real damage978,real duration978,real range978,group hits978 returns nothing
local trigger wave978=CreateTrigger()
local integer key978=GetHandleId(wave978)
local integer type978=GetUnitTypeId(caster978)
local real spacing978=150.
local string model978="Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl"
if type978=='Z00K' or type978=='Z10K' then
set spacing978=75.
endif
if type978=='Z00K' then
set model978="model\\hero_sandking_n11s_e_misslie.mdl"
elseif type978=='Z10K' then
set model978="AZModel\\AZ_SKcrystal_E_Misslie.mdl"
elseif type978=='ZC18' then
set model978="model\\hero_demonwitch_n5s_e_stab.mdl"
endif
call SaveInteger(ExtraHT,'A4I2',GetHandleId(caster978),0)
if GetPlayerController(GetOwningPlayer(caster978))==MAP_CONTROL_COMPUTER then
call SaveInteger(ExtraHT,'HMRS',GetHandleId(caster978),1)
endif
call NT7(key978,"Source",caster978)
call NB7(key978,"Scan",CreateGroup())
call NB7(key978,"Hits",hits978)
call NQ7(key978,"X",GetUnitX(caster978))
call NQ7(key978,"Y",GetUnitY(caster978))
call NQ7(key978,"Range",range978)
call NQ7(key978,"Damage",damage978)
call NQ7(key978,"Duration",duration978)
call NQ7(key978,"FXInterval",range978/G_E(range978,spacing978))
call SaveStr(L7,key978,StringHash("B978FX"),model978)
call TriggerRegisterTimerEvent(wave978,.0625,true)
call TriggerAddCondition(wave978,Condition(function B978RavageTick))
set wave978=null
endfunction
function XGF takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit oA
local integer i=1
local integer suijiRavageCastSkill=B287_GetSpellAbilityId()
local integer suijiRavageCasterHandle=GetHandleId(WI7)
local real suijiRavageNow=TimerGetElapsed(W)
local real x1=GetUnitX(WI7)
local real y1=GetUnitY(WI7)
local real x2
local real y2
local real YM7
local real Hk
local integer V77=SuijiMode_GetPairCastLevel(WI7,suijiRavageCastSkill,'A29I','A2UL')
local integer suijiRavageMulticastCount=SuijiMode_TideRavageMulticastCount(WI7)
local group g=null
local integer range=500+V77*100
// A29I/A2UL are two physical faces of one Ravage.  Some native/random AI
// transitions can emit the effect event twice for the same order; merge them
// before damage, stun, multicast and AI-combo work are created.
if ON7(suijiRavageCasterHandle,"SuijiTideRavageEffectBlockUntil")>suijiRavageNow then
set WI7=null
return
endif
call NQ7(suijiRavageCasterHandle,"SuijiTideRavageEffectBlockUntil",suijiRavageNow+.20)
// The engine may clear the cooldown after a paired ability transition.  Reapply
// the normal 90/60-second Ravage cooldown briefly after the spell-effect event.
call SuijiMode_StartPairCooldownSync(WI7,suijiRavageCastSkill,'A29I','A2UL',"SuijiTideRavageCooldown",90.,90.,90.,60.,60.,60.)
if V77<1 then
set V77=1
elseif V77>3 then
set V77=3
endif
set range=500+V77*100
set g=CreateGroup()
set B661_TIDE_RAVAGE_ACTIVE=B661_TIDE_RAVAGE_ACTIVE+1
if SPEPLAYER[GetPlayerId(GetOwningPlayer(WI7))]==1 and ISLABIKE(WI7) then
    call YW7("我才是潮汐！",5,WI7,.03,$FF,$FF,0,$FF)
endif
if V77==1 then
set Hk=2.5
set YM7=200
elseif V77==2 then
set Hk=2.75
set YM7=300
elseif V77==3 then
set Hk=3.
set YM7=400
endif
if suijiRavageMulticastCount>1 then
call SuijiMode_TideRavageMulticastText(WI7,suijiRavageMulticastCount)
set YM7=YM7*suijiRavageMulticastCount
set Hk=Hk+.30*(suijiRavageMulticastCount-1)
endif
if GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER then
    call SaveInteger(ExtraHT,'HMRC',GetHandleId(WI7),0)
    call AI_USE_TH(WI7)
endif
call B978StartRavage(WI7,YM7,Hk,I2R(range),g)
call XFF(g)
set WI7=null
set oA=null
set g=null
endfunction
