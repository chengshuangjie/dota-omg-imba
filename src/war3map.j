if not DGFS(WI7) then
set aj[GetPlayerId(GetOwningPlayer(WI7))]=t
endif
if not DGFS(WI7) then
set Rj[GetPlayerId(GetOwningPlayer(WI7))]=t2
endif
endif
set WI7=null
set t=null
set t2=null
endfunction
