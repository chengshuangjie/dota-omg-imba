if GetUnitCurrentOrder((b1060GetEnumUnit))!=851983then
call GroupRemoveUnit(KU,(b1060GetEnumUnit))
call B947IssuePointOrderByIdLoc("SL8 @ war3map.j:39772 (B968)",(b1060GetEnumUnit),$D000F,O8[GetUnitAbilityLevel((b1060GetEnumUnit),N8)])
endif
set b1060GetEnumUnit=null
endfunction
