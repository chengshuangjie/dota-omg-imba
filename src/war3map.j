//无影拳
function WSG takes unit ZX7,unit IH7 returns nothing
local real a=GetRandomReal(0,360)
local real x=GetUnitX(IH7)+50*Cos(a*bj_DEGTORAD)
local real y=GetUnitY(IH7)+50*Sin(a*bj_DEGTORAD)
call SetUnitPosition(ZX7,x,y)
call SetUnitFacing(ZX7,bj_RADTODEG*Atan2(GetUnitY(IH7)-GetUnitY(ZX7),GetUnitX(IH7)-GetUnitX(ZX7)))
call SetUnitAnimation(ZX7,"Attack")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Fire_Blink_2.mdx",ZX7,"chest"))
call WPG(ZX7)
if IsUnitType(IH7,UNIT_TYPE_HERO) or IsUnitIllusion(IH7) then
call WRG(ZX7)
call UnitRemoveAbility(ZX7,'A2JF')
else
call XF7(ZX7,'A2JF')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2JF',false)
endif
call B947IssueTargetOrderById("WSG @ war3map.j:209025 (B968)",ZX7,$D000F,IH7)
endfunction
function SuijiMode_RestoreWarpathBonus takes unit u returns nothing
local integer h=0
local integer stacks=0
local integer level=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set stacks=LoadInteger(TABLE_P,h,'A0FV')
set level=LoadInteger(TABLE_P,h,'WARL')
if stacks>0 and B287_GetUnitAbilityLevel(u,'A0FV')>0 then
call B_7(u,(15+5*level)*stacks)
endif
endfunction
function WTG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real x=(LoadReal(L7,(I97),(6)))
local real y=(LoadReal(L7,(I97),(7)))
local real AQ9=(LoadReal(L7,(I97),($BD)))
local real AR9=(LoadReal(L7,(I97),($BE)))
local group BQ9=(LoadGroupHandle(L7,(I97),($BB)))
local group g=(LoadGroupHandle(L7,(I97),(22)))
local unit IH7=null
local boolean D8G=false
local fogmodifier Q0D=(LoadFogModifierHandle(L7,(I97),(42)))
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A2H0')
loop
exitwhen FirstOfGroup(g)==null or D8G
set IH7=FirstOfGroup(g)
call GroupRemoveUnit(g,IH7)
if IsUnitInGroup(IH7,BQ9)and IH7!=null then
set IH7=null
set D8G=false
else
set D8G=true
endif
endloop
call SetUnitPathing(ZX7,false)
call SetUnitInvulnerable(ZX7,true)
call AG7(ZX7)
if D8G==false or((LoadInteger(L7,(GetHandleId((ZX7))),((4319))))==1) then
call SaveInteger(L7,(GetHandleId((ZX7))),((4318)),(2))
call WOG(ZX7)
call UnitRemoveAbility(ZX7,'A2JF')
call WPG(ZX7)
call AG7(ZX7)
call WNG(ZX7)
call UnitAddAbility(ZX7,'A2H2')
call UnitRemoveAbility(ZX7,'A2H2')
call AG7(ZX7)
call SuijiMode_RestoreWarpathBonus(ZX7)
if((LoadInteger(L7,(GetHandleId((ZX7))),((4319))))==1)==false then
call SetUnitX(ZX7,AQ9)
call SetUnitY(ZX7,AR9)
endif
if LoadInteger(L7,GetHandleId(ZX7),4360)>1 then
call SaveInteger(L7,GetHandleId(ZX7),4360,LoadInteger(L7,GetHandleId(ZX7),4360)-1)
else
call SaveInteger(L7,GetHandleId(ZX7),4360,0)
endif
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,$FF)
call SetUnitPathing(ZX7,true)
call SetUnitInvulnerable(ZX7,false)
call UnitRemoveAbility(ZX7,'A04R')
call SetUnitTimeScale(ZX7,1)
call WR7(BQ9)
call WR7(g)
call RemoveUnit((LoadUnitHandle(L7,(I97),(19))))
call FogModifierStop(Q0D)
call DestroyFogModifier(Q0D)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
call GroupAddUnit(BQ9,IH7)
call WSG(ZX7,IH7)
endif
set t=null
set ZX7=null
set IH7=null
set g=null
set BQ9=null
set Q0D=null
return false
endfunction
// B1097: foreign Sleight keeps its own hero definition and one attack owner.
function B1097SleightTarget takes unit sleightUnit1097,unit sleightTarget1097 returns boolean
return sleightTarget1097!=null and GetUnitTypeId(sleightTarget1097)!=0 and UnitAlive(sleightTarget1097) and IsUnitEnemy(sleightTarget1097,GetOwningPlayer(sleightUnit1097)) and not IsHideUnit(sleightTarget1097) and not AE7(sleightTarget1097) and not IsUnitType(sleightTarget1097,UNIT_TYPE_STRUCTURE) and not XH7(sleightTarget1097) and GetUnitAbilityLevel(sleightTarget1097,'A04R')==0 and not MHUnit_IsInvulnerable(sleightTarget1097) and IsUnitVisible(sleightTarget1097,GetOwningPlayer(sleightUnit1097))
endfunction
