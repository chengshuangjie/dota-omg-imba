function U4R takes nothing returns boolean
return GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(IN4)and IsUnitIllusion(GetFilterUnit()) and IsHideUnit(GetFilterUnit())==false and GetUnitTypeId(GetFilterUnit())==GetUnitTypeId(IN4) and XH7(GetFilterUnit())==false
endfunction
function U5R takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u
local unit u2
local integer i=1
local real x=LoadReal(L7,I97,$A)
local real y=LoadReal(L7,I97,$B)
local real x2
local real y2
local real R2X
local integer c=LoadInteger(L7,I97,0)+1
local real U7R
local unit U8R
local unit U9R
local string fx
if c==50 then
// call ClearSelectionForPlayer(GetOwningPlayer(LoadUnitHandle(L7,I97,0)))
set U8R=null
set U9R=null
loop
exitwhen HaveSavedHandle(L7,I97,i)==false
set u=LoadUnitHandle(L7,I97,i)
// call ShowUnit(u,true)
// call PauseUnit(u,false)
// call ShowUnit(u,true)
// call PauseUnit(u,false)
// call ShowUnit(u,true)
// call PauseUnit(u,false)
call PauseUnitEx(u, false)
// call SetUnitScale(u,XX7(u),XX7(u),XX7(u))
call UnitCancelHide(u)
call OX7(u,"HideUnit")
call B947IssueImmediateOrderById("U5R @ war3map.j:84771 (B968)",u,$D0004)
call UnitRemoveAbility(u,'Avul')
if IsUnitSelected(u,GetOwningPlayer(u)) then
    call SelectUnitForPlayerSingle(u,GetOwningPlayer(u))
endif
set x2=LoadReal(L7,I97,100*i)
set y2=LoadReal(L7,I97,100*i+1)
call Y67(x2,y2,$C8)
call SetUnitPosition(u,x2,y2)
if IsUnitIllusion(u)==false or GetUnitAbilityLevel(u,'B0HA')>0 or GetUnitAbilityLevel(u,'B0HB')>0 then
call SetUnitFacing(u,LoadReal(L7,I97,0))
if IsUnitIllusion(u)==false then
// call SelectUnitAddForPlayer(u,GetOwningPlayer(u))
elseif U8R==null then
set U8R=u
elseif U9R==null then
set U9R=u
endif
if GetUnitAbilityLevel(u,'B0HB')>0 then
set fx=""
if IsUnitAlly(u,GetLocalPlayer())or(WG7(GetLocalPlayer()))then
set fx="Abilities\\Spells\\Items\\AIda\\AIdaTarget.mdl"
endif
call YS7(fx,u,"head",8)
endif
if GetUnitAbilityLevel(u,'B0HA')>0 then
set fx=""
if IsUnitAlly(u,GetLocalPlayer())or(WG7(GetLocalPlayer()))then
set fx="war3mapImported\\PLPower.mdx"
endif
call YS7(fx,u,"overhead",8)
endif
endif
call KillUnit(LoadUnitHandle(L7,I97,300+i))
set i=i+1
endloop
if Ab[GetPlayerId(GetOwningPlayer(u))] then
    call SelectUnitAddForPlayer(U8R,GetOwningPlayer(u))
    call SelectUnitAddForPlayer(U9R,GetOwningPlayer(u))
endif
set U8R=null
set U9R=null
call RemoveUnit(LoadUnitHandle(L7,I97,-100))
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
else
loop
exitwhen HaveSavedHandle(L7,I97,i)==false
set u=LoadUnitHandle(L7,I97,300+i)
set U7R=LoadReal(L7,I97,100*i+2)
set R2X=LoadReal(L7,I97,100*i+3)
set x2=X17(GetUnitX(u)+U7R*Cos(R2X))
set y2=X07(GetUnitY(u)+U7R*Sin(R2X))
call SetUnitAnimation(u,"walk")
call SetUnitX(u,x2)
call SetUnitY(u,y2)
set i=i+1
endloop
call SaveInteger(L7,I97,0,c)
endif
set u=null
set u2=null
set t=null
endfunction
function WVR takes nothing returns nothing
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local timer t=CreateTimer()
local integer I97=GetHandleId(t)
local unit u=(b1061SavedGetTriggerUnit)
local group g=WS7()
local boolexpr phantomLancerDoppelwalkFilter=null
local integer i=0
local unit u2
local real OXO=GetUnitFacing(u)
local real x=(b1061SavedGetSpellTargetX)
local real y=(b1061SavedGetSpellTargetY)
local unit BB7=CreateUnit(GetOwningPlayer(u),'e00E',GetUnitX(u),GetUnitY(u),0)
local real R2X
local real UFe
local real x2
local real y2
call UnitAddAbility(BB7,'A2W6')
call B947IssueTargetOrderById("WVR @ war3map.j:84852 (B968)",BB7,$D0132,u)
call SetUnitAbilityLevel(BB7,'A2W6',2)
call B947IssueTargetOrderById("WVR @ war3map.j:84854 (B968)",BB7,$D0132,u)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
set IN4=u
set phantomLancerDoppelwalkFilter=Condition(function U4R)
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),925,phantomLancerDoppelwalkFilter)
call DestroyBoolExpr(phantomLancerDoppelwalkFilter)
call GroupAddUnit(g,u)
loop
set u2=FirstOfGroup(g)
exitwhen u2==null
set i=i+1
call SaveUnitHandle(L7,I97,i,u2)
call XF7(u2,'Avul')
call PauseUnitEx(u2, true)
call UnitEnterHide(u2)
call OV7(u2,"HideUnit")
set BB7=CreateUnit(GetOwningPlayer(u2),'h06L',GetUnitX(u2),GetUnitY(u2),GetUnitFacing(u2))
call SaveUnitHandle(L7,I97,300+i,BB7)
set R2X=GetRandomReal(0,360)*bj_DEGTORAD
set UFe=GetRandomReal($A,325)
set x2=X17(x+UFe*Cos(R2X))
set y2=X07(y+UFe*Sin(R2X))
call SaveReal(L7,I97,100*i+0,x2)
call SaveReal(L7,I97,100*i+1,y2)
call SaveReal(L7,I97,100*i+2,KF7(GetUnitX(BB7),GetUnitY(BB7),x2,y2)*.02)
call SaveReal(L7,I97,100*i+3,J77(GetUnitX(BB7),GetUnitY(BB7),x2,y2)*bj_DEGTORAD)
call GroupRemoveUnit(g,u2)
endloop
set BB7=null
call SaveUnitHandle(L7,I97,-100,CreateUnit(GetOwningPlayer(u),'o020',GetUnitX(u),GetUnitY(u),0))
call SaveReal(L7,I97,0,OXO)
call SaveUnitHandle(L7,I97,0,u)
call TimerStart(t,.02,true,function U5R)
call SaveReal(L7,I97,$A,x)
call SaveReal(L7,I97,$B,y)
call WR7(g)
set t=null
set u=null
set g=null
set phantomLancerDoppelwalkFilter=null
set b1061SavedGetTriggerUnit=null
endfunction
