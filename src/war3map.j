function rp4 takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local unit u=GetAttacker()
local integer id
if IsUnitType(u,UNIT_TYPE_HERO) then
    call SaveReal(L7,GetHandleId(u),'ZGSX',GetUnitX(b1060GetTriggerUnit))
    call SaveReal(L7,GetHandleId(u),'ZGSY',GetUnitY(b1060GetTriggerUnit))
endif
if GetUnitTypeId(u)=='Z060' then
    set id=(LoadInteger(L7,(GetHandleId(u)),(2038257011)))+1
    call SetUnitAnimationByIndex(u,JH_ACTION[id])
    if id==4 then
        set id=0
    endif
    call SaveInteger(L7,(GetHandleId(u)),(2038257011),(id))
endif
set u=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
