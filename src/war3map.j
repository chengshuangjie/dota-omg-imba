function SCCB takes unit u returns nothing
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer tx
if HaveSavedInteger(TABLE_Z, id,0) then
set tx=LoadInteger(TABLE_Z, id,0)
call UnitRemoveAbility(u,tx)
call FlushChildHashtable(TABLE_Z, id)
endif
endfunction
function JCB takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local integer id=GetPlayerId(b1060GetTriggerPlayer)
local unit u=M7[id]
local integer tx
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer i=S2I(SubString(VH,3,StringLength(VH)))
if u==null then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,GetObjectName('n08A'))
set b1060GetTriggerPlayer=null
return
elseif not IsUnitAliveBJ(u) then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "请等待英雄复活")
set u=null
set b1060GetTriggerPlayer=null
return
endif
if VH=="-cb" then
	call SCCB(u)
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"|cffff00ff已删除翅膀|r")
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"(提醒：使用翅膀需下载翅膀补丁，点击皮肤商店问号获取下载地址)")
	set u=null
	set b1060GetTriggerPlayer=null
	return
endif
if i > 0 and i < 10 then
set tx='AC00'
set tx=tx+i
elseif i >= 10 and i < 36 then
set tx='AC07'
set tx=tx+i
elseif i >= 36 and i < 45 then
set tx=1094922509
set tx=tx+i
elseif i >= 45 and i < 59 then
set tx=1094922516
set tx=tx+i
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "添加翅膀方法：|cFF00FF00-cb 1~50|r (一共50种)")
set u=null
set b1060GetTriggerPlayer=null
return
endif
call SCCB(u)
call XF7(u,tx)
call SaveInteger(TABLE_Z, id,0, tx)
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"|cffff00ff已添加【翅膀"+I2S(i)+"】，输入-cb可删除翅膀|r")
set u=null
set b1060GetTriggerPlayer=null
endfunction
