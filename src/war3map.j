function RWE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1IM' then
call RVE()
endif
return false
endfunction
function NX8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RWE))
set t=null
endfunction
function SuijiNightcrawler_IsVisibleToEnemy takes unit u returns boolean
local integer i=0
local player owner=null
local player observer=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set owner=GetOwningPlayer(u)
// The original Shadow Dance passive uses the opposing faction's shared
// vision owner.  Checking only active player slots misses tower/AI/shared
// vision and leaves the regeneration enabled while the hero is revealed.
if TV7(owner) then
set observer=A7[1]
else
set observer=Z7[1]
endif
if observer!=null and IsUnitVisible(u,observer) then
set owner=null
set observer=null
return true
endif
loop
exitwhen i>11
set observer=Player(i)
if GetPlayerSlotState(observer)==PLAYER_SLOT_STATE_PLAYING and IsPlayerEnemy(observer,owner) and IsUnitVisible(u,observer) then
set owner=null
set observer=null
return true
endif
set i=i+1
endloop
set owner=null
set observer=null
return false
endfunction
function RXE takes nothing returns boolean
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=0
local real CP7=0.
local real RZE=0.
local real RAE=0.
local integer passivetx=0
local real mana=0.
if p5==null or GetUnitTypeId(p5)==0 or LoadTriggerHandle(ExtraHT,'A1IN',GetHandleId(p5))!=t then
if p5!=null and LoadTriggerHandle(ExtraHT,'A1IN',GetHandleId(p5))==t then
call RemoveSavedHandle(ExtraHT,'A1IN',GetHandleId(p5))
endif
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
// Death is not removal: keep this unit's single passive owner for revival.
// Clear the spellbook-owned bonuses once, then do no aura/mana work while dead.
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or UnitAlive(p5)==false or XH7(p5) then
if OO7(OB7,"NightcrawlerDead")==false then
call NS7(OB7,"NightcrawlerDead",true)
call NQ7(OB7,"Buffer1",0.)
call NQ7(OB7,"Buffer2",0.)
call NQ7(OB7,"NightcrawlerTime",0.)
call SaveInteger(L7,GetHandleId(p5),4421,2)
set passivetx=OM7(OB7,"TX")
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
endif
if GetUnitAbilityLevel(p5,'A1IG')>0 then
call UnitRemoveAbility(p5,'A1IG')
endif
if passivetx!=0 and GetUnitAbilityLevel(p5,passivetx)>0 then
call UnitRemoveAbility(p5,passivetx)
endif
endif
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if OO7(OB7,"NightcrawlerDead") then
call NS7(OB7,"NightcrawlerDead",false)
endif
set V77=B287_GetUnitAbilityLevel(p5,'A1IN')
set CP7=TimerGetElapsed(W)
set RZE=ON7(OB7,"Buffer1")
set RAE=ON7(OB7,"Buffer2")
set passivetx=OM7(OB7,"TX")
set mana=GetUnitState(p5,UNIT_STATE_MAX_MANA)/1000
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and GetOwningPlayer(b1060GetEventDamageSource)==B7 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IG')>0 then
call UnitRemoveAbility(p5,'A1IG')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
call NQ7(OB7,"NightcrawlerTime",(CP7+2)*1.)
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if ON7(OB7,"NightcrawlerTime")>CP7 then
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
// Only Shadow Dance's own active state may override enemy visibility here.
// BM1 also includes Smoke of Deceit, which AI uses automatically and could
// otherwise keep Nightcrawler regeneration active while the AI is revealed.
if(SuijiNightcrawler_IsVisibleToEnemy(p5) and LoadInteger(L7,GetHandleId(p5),4421)!=1) or ISPH(p5) or V77==0 then
set RAE=0
if GetUnitAbilityLevel(p5,'A1IE')>0 or GetUnitAbilityLevel(p5,'A1IF')>0 or GetUnitAbilityLevel(p5,'A1IG')>0 then
set RZE=RZE+.1
if RZE>.4 then
set RZE=0
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
if GetUnitAbilityLevel(p5,'A1IG')>0 then
call UnitRemoveAbility(p5,'A1IG')
call UnitRemoveAbility(p5,'B0C9')
call UnitRemoveAbility(p5,passivetx)
endif
endif
endif
call NQ7(OB7,"Buffer1",RZE*1.)
call NQ7(OB7,"Buffer2",RAE*1.)
elseif SuijiNightcrawler_IsVisibleToEnemy(p5)==false or LoadInteger(L7,GetHandleId(p5),4421)==1 then
if GetUnitState(p5,UNIT_STATE_MANA)!=GetUnitState(p5,UNIT_STATE_MAX_MANA) then
call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+mana)
endif
set RZE=0
if (V77==1 and GetUnitAbilityLevel(p5,'A1IE')==0) or (V77==2 and GetUnitAbilityLevel(p5,'A1IF')==0) or (V77==3 and GetUnitAbilityLevel(p5,'A1IG')==0) then
set RAE=RAE+.1
if RAE>.4 then
set RAE=0
if V77==1 then
if GetUnitAbilityLevel(p5,'A1IE')==0 then
call XF7(p5,'A1IE')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I8')
call UnitMakeAbilityPermanent(p5,true,'A1IC')
endif
endif
if V77==2 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IF')==0 then
call XF7(p5,'A1IF')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I9')
call UnitMakeAbilityPermanent(p5,true,'A1ID')
endif
endif
if V77==3 then
if GetUnitAbilityLevel(p5,'A1IE')>0 then
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IF')>0 then
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'B0C9')
endif
if GetUnitAbilityLevel(p5,'A1IG')==0 then
call XF7(p5,'A1IG')
call XF7(p5,passivetx)
call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1IA')
call UnitMakeAbilityPermanent(p5,true,'A1IB')
endif
endif
endif
endif
call NQ7(OB7,"Buffer1",RZE*1.)
call NQ7(OB7,"Buffer2",RAE*1.)
endif
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function RBE takes unit WI7 returns nothing
local trigger t=null
local integer OB7=0
local integer id=0
local integer passivetx
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
// Learn, OMG restore and active casts all converge on one unit-scoped owner.
if LoadTriggerHandle(ExtraHT,'A1IN',GetHandleId(WI7))!=null then
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set id=GetUnitTypeId(WI7)
if id=='Z071' then
    set passivetx='X1I7'
else
    set passivetx='A1I7'
endif
call NQ7(OB7,"Buffer1",0*1.)
call NQ7(OB7,"Buffer2",0*1.)
call NQ7(OB7,"NightcrawlerTime",TimerGetElapsed(W)*1.)
call NT7(OB7,"Source",WI7)
call NP7(OB7,"TX",passivetx)
call SaveTriggerHandle(ExtraHT, 'A1IN', GetHandleId(WI7), t)
call TriggerRegisterTimerEvent(t,.1,true)
call B1023RegisterDamage(t,WI7)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function RXE))
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1IE',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1IF',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A1IG',false)
set t=null
endfunction
function RCE takes nothing returns boolean
