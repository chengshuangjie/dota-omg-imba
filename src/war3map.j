function B946DetectInit takes nothing returns nothing
local trigger detectChat946=CreateTrigger()
local trigger detectLeave946=CreateTrigger()
local integer detectPlayer946=0
set B946DetectOrders=CreateTrigger()
loop
exitwhen detectPlayer946>=16
call TriggerRegisterPlayerChatEvent(detectChat946,Player(detectPlayer946),"-detect",true)
call TriggerRegisterPlayerEvent(detectLeave946,Player(detectPlayer946),EVENT_PLAYER_LEAVE)
call TriggerRegisterPlayerUnitEvent(B946DetectOrders,Player(detectPlayer946),EVENT_PLAYER_UNIT_ISSUED_ORDER,null)
call TriggerRegisterPlayerUnitEvent(B946DetectOrders,Player(detectPlayer946),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(B946DetectOrders,Player(detectPlayer946),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
set detectPlayer946=detectPlayer946+1
endloop
call TriggerAddAction(detectChat946,function B946DetectCommand)
call TriggerAddAction(detectLeave946,function B946DetectLeave)
call TriggerAddCondition(B946DetectOrders,Condition(function B946DetectOrder))
call DisableTrigger(B946DetectOrders)
set detectChat946=null
set detectLeave946=null
endfunction
function B1014EnsnareGoldHit takes nothing returns boolean
local unit b1014Attacker=MHDamageEvent_GetSource()
local unit b1014Target=MHEvent_GetUnit()
local player b1014Winner=null
local player b1014Loser=null
local integer b1014Gold=0
if b1014Attacker==null or b1014Target==null or GetUnitTypeId(b1014Attacker)==0 or GetUnitTypeId(b1014Target)==0 then
set b1014Attacker=null
set b1014Target=null
return false
endif
// Only a landed primary attack transfers gold; spell/secondary damage never does.
// Dedicated native buffs expire and dispel with the actual net, including flying targets.
if FKK and not Fe and MHDamageEvent_IsPhysical() and MHDamageEvent_GetDmgType()==DAMAGE_TYPE_NORMAL and MHDamageEvent_GetDamage()>0. and IsUnitType(b1014Attacker,UNIT_TYPE_HERO) and IsUnitType(b1014Target,UNIT_TYPE_HERO) and not IsUnitIllusion(b1014Attacker) and not IsUnitIllusion(b1014Target) and IsUnitEnemy(b1014Target,GetOwningPlayer(b1014Attacker)) and (GetUnitAbilityLevel(b1014Target,'B4NA')>0 or GetUnitAbilityLevel(b1014Target,'B4NG')>0) then
set b1014Winner=GetOwningPlayer(b1014Attacker)
set b1014Loser=GetOwningPlayer(b1014Target)
set b1014Gold=GetPlayerState(b1014Loser,PLAYER_STATE_RESOURCE_GOLD)
if b1014Gold>20 then
set b1014Gold=20
endif
if b1014Gold>0 then
call SetPlayerState(b1014Loser,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(b1014Loser,PLAYER_STATE_RESOURCE_GOLD)-b1014Gold)
call SetPlayerState(b1014Winner,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(b1014Winner,PLAYER_STATE_RESOURCE_GOLD)+b1014Gold)
endif
endif
set b1014Attacker=null
set b1014Target=null
set b1014Winner=null
set b1014Loser=null
return false
endfunction
// Matching source/target only; retain each family's original damage threshold.
function B1023HitDamage takes nothing returns boolean
local unit hitSource1023=MHDamageEvent_GetSource()
local unit hitTarget1023=MHEvent_GetUnit()
local real hitDamage1023=MHDamageEvent_GetDamage()
local timer hitNode1023=null
local timer hitNext1023=null
local integer hitKind1023=0
local real hitMana1023=0.
local boolean hitReady1023=false
if hitSource1023!=null and hitTarget1023!=null then
set hitNode1023=LoadTimerHandle(B1023HitPairs,GetHandleId(hitSource1023),GetHandleId(hitTarget1023))
if hitNode1023!=null then
// Detach the event snapshot before any effect: nested damage cannot consume it twice.
call RemoveSavedHandle(B1023HitPairs,GetHandleId(hitSource1023),GetHandleId(hitTarget1023))
loop
exitwhen hitNode1023==null
set hitNext1023=LoadTimerHandle(L7,GetHandleId(hitNode1023),18)
set hitKind1023=LoadInteger(L7,GetHandleId(hitNode1023),19)
set hitReady1023=hitDamage1023>0.
if hitKind1023==6 then
set hitReady1023=true
elseif hitKind1023==7 then
set hitReady1023=B1023HitLive(hitSource1023) and OT7(hitSource1023,"OverloadActive")
endif
if not B1023HitLive(hitSource1023) or not B1023HitLive(hitTarget1023) then
call B1023HitDestroy(hitNode1023)
elseif not hitReady1023 then
// Keep the original deadline, never extend it on unrelated/zero damage.
call B1023HitAppend(hitNode1023)
else
call B1023HitDestroy(hitNode1023)
if hitKind1023==1 then
if not YS8(hitTarget1023) then
call ZW8(hitTarget1023)
endif
elseif hitKind1023==2 then
if not YS8(hitTarget1023) then
call ZA8(hitTarget1023)
endif
elseif hitKind1023==3 then
if not YS8(hitTarget1023) then
call ZAA8(hitTarget1023)
endif
elseif hitKind1023==4 or hitKind1023==5 then
if IsUnitIllusion(hitSource1023) then
if not IsUnitType(hitSource1023,UNIT_TYPE_MELEE_ATTACKER) then
set hitMana1023=10.
elseif hitKind1023==4 then
set hitMana1023=15.
else
set hitMana1023=20.
endif
elseif hitKind1023==4 then
set hitMana1023=25.
else
set hitMana1023=40.
endif
set hitMana1023=RMinBJ(hitMana1023,GetUnitState(hitTarget1023,UNIT_STATE_MANA))
call SetUnitState(hitTarget1023,UNIT_STATE_MANA,GetUnitState(hitTarget1023,UNIT_STATE_MANA)-hitMana1023)
call B67(hitSource1023,hitTarget1023,2,hitMana1023)
if B1023HitLive(hitTarget1023) then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",hitTarget1023,"origin"))
endif
elseif hitKind1023==6 then
call AG3(hitSource1023,hitTarget1023)
elseif hitKind1023==7 then
call IUD(hitSource1023,hitTarget1023)
elseif hitKind1023==8 then
if not YS8(hitTarget1023) then
call B6G(hitSource1023,hitTarget1023)
endif
elseif hitKind1023==9 then
call S33(hitSource1023,hitTarget1023)
endif
endif
set hitNode1023=hitNext1023
endloop
endif
endif
set hitSource1023=null
set hitTarget1023=null
set hitNode1023=null
set hitNext1023=null
return false
endfunction
function B1023HitInit takes nothing returns nothing
if B1023HitDamageTrigger==null then
set B1023HitPairs=InitHashtable()
set B1023HitDamageTrigger=CreateTrigger()
call TriggerAddCondition(B1023HitDamageTrigger,Condition(function B1023HitDamage))
call MHDamageEvent_Register(B1023HitDamageTrigger)
endif
endfunction
