function MNCF2 takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local real b1060GetOrderPointX=GetOrderPointX()
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit IH7=(LoadUnitHandle(L7,(OB7),(1)))
local unit BB7=(LoadUnitHandle(L7,(OB7),(2)))
local unit oA=(LoadUnitHandle(L7,(OB7),(3)))
local boolean expired1116=KQ7()>=LoadReal(L7,OB7,StringHash("B1116CycloneUntil"))
local real Face=(LoadReal(L7,(OB7),(4)))
local real x
local real y
local integer cbtx
local boolean USE_TD=LoadBoolean(L7,OB7,10)
local real TD_X=LoadReal(L7,(OB7),(11))
local real TD_Y=LoadReal(L7,(OB7),(12))
// B1116: selection callbacks only update the local selection; shared retirement waits for its synchronized event.
if b1060GetTriggerEventId==EVENT_UNIT_SELECTED then
    if IsUnitSelected(BB7,GetLocalPlayer()) then
        call SelectUnitForPlayerSingle(IH7,GetLocalPlayer())
    endif
set t=null
set IH7=null
set BB7=null
set oA=null
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return
endif
if not expired1116 and UnitAlive(IH7) and CF_BE_JINGHUA(b1060GetTriggerEventId,b1060GetTriggerUnit,IH7,BB7,b1060B287_GetSpellAbilityId) and WQ7(IH7) then
    call PLK(IH7)
elseif expired1116 or UnitAlive(IH7)==false or (CF_BE_JINGHUA(b1060GetTriggerEventId,b1060GetTriggerUnit,IH7,BB7,b1060B287_GetSpellAbilityId) and WQ7(IH7)==false)then
    // Retire before cleanup natives can synchronously re-enter this owner.
    call DisableTrigger(t)
    call RemoveUnit(BB7)
    call RemoveUnit(oA)
    // call SetUnitScale(IH7,XX7(IH7),XX7(IH7),XX7(IH7))
    // call UnitRemoveAbility(IH7,'A04R')
    // call SetUnitScale(IH7,XX7(IH7),XX7(IH7),XX7(IH7))
    // call UnitRemoveAbility(IH7,'A04R')
    // call SetUnitScale(IH7,XX7(IH7),XX7(IH7),XX7(IH7))
    // call UnitRemoveAbility(IH7,'A04R')
    call UnitCancelHide(IH7)
	call OX7(IH7,"HideUnit")
    call UnitRemoveAbility(IH7,'A4DE')
    call UnitRemoveAbility(IH7,'A4DF')
    call UnitRemoveAbility(IH7,'B0J5')
    call SetUnitInvulnerable(IH7,false)
    // call MHUnit_Silence(IH7,false)
    call FixUnitSilence(IH7)
    call SetUnitPathingEx(IH7,true)
    call SetUnitFlyHeight(IH7,GetUnitDefaultFlyHeight(IH7),0)
    set cbtx=LoadInteger(TABLE_Z, GetPlayerId(GetOwningPlayer(IH7)),0)
    if cbtx!=0 then
        call XF7(IH7,cbtx)
    endif
    if expired1116 or UnitAlive(IH7)==false then
    else
        if BB7==b1060GetSpellTargetUnit and (WF7(IH7)==false or GetUnitAbilityLevel(IH7,'B014')==1) then
            call JINGHUA(b1060GetTriggerUnit,IH7,b1060B287_GetSpellAbilityId)
        endif
    endif
    if IsUnitSelected(IH7,GetLocalPlayer()) then
        call SelectUnitForPlayerSingle(IH7,GetLocalPlayer())
    endif
    call RemoveSavedHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))
    call FlushChildHashtable(L7,(OB7))
    call OZ7(t)
    if USE_TD then
        call UnitUseItemPoint(IH7,UnitItemInSlot(IH7,Get_Tiaodao(IH7)),TD_X,TD_Y) 
    endif
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER then
	if b1060GetIssuedOrderId >= 852008 and b1060GetIssuedOrderId <= 852013 then
        if Is_Use_TD(IH7,b1060GetIssuedOrderId) then
            call SaveBoolean(L7,(OB7),(10),true)
            call SaveReal(L7,(OB7),(11),(b1060GetOrderPointX))
            call SaveReal(L7,(OB7),(12),(b1060GetOrderPointY))
        endif
		// call EXStopUnit(IH7)
        call KR7(IH7)
	endif
    if b1060GetIssuedOrderId==$D0003 and b1060GetTriggerUnit==BB7 then
        call SelectUnitForPlayerSingle(IH7,GetOwningPlayer(IH7))
    endif
else
// call SetUnitScale(IH7,0,0,0)
call SetUnitX(BB7,GetUnitX(IH7))
call SetUnitY(BB7,GetUnitY(IH7))
set Face=Face+10.8
if Face>=360 then
set Face=Face-360
endif
call SaveReal(L7,(OB7),(4),(Face))
set x=GetUnitX(IH7)-75*Cos(Face*bj_DEGTORAD)
set y=GetUnitY(IH7)-75*Sin(Face*bj_DEGTORAD)
call MHUnit_SetFacing(oA,Face,true)
call SetUnitX(oA,x)
call SetUnitY(oA,y)
endif
set t=null
set IH7=null
set BB7=null
set oA=null
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
endfunction
function MNCF takes unit ZX7, unit IH7 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'h0GQ',GetUnitX(IH7),GetUnitY(IH7),0)
local real Face=GetUnitFacing(IH7)
local real x=GetUnitX(IH7)-75*Cos(Face*bj_DEGTORAD)
local real y=GetUnitY(IH7)-75*Sin(Face*bj_DEGTORAD)
local unit oA=CreateUnit(GetOwningPlayer(IH7),'h0GR',x,y,0)
local real d
local integer cbtx
if ZX7!=IH7 then
    call B947IssueImmediateOrderById("MNCF @ war3map.j:161752 (B968)",IH7,$D0004)
endif
call SetUnitInvulnerable(IH7,true)
call YZ8(IH7)
call YW8(IH7,0,0)
// call XF7(IH7,'A04R')
call XF7(IH7,'A4DE')
call XF7(IH7,'A4DF')
call MHUnit_Silence(IH7,true)
call SetUnitPathingEx(IH7,false)
// call SetUnitScale(IH7,0,0,0)
call UnitEnterHide(IH7)
call OV7(IH7,"HideUnit")
if KCD(IH7)==false then
call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
endif
call SetUnitFlyHeight(IH7,600,0)
call MHUnit_SetModel(oA,EXGetUnitString(GetUnitTypeId(IH7), UNIT_STRING_MODEL_PATH),false)
call ResetUnitVertexColor(oA,GetUnitTypeId(IH7))
call MHUnit_SetTeamColor(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
call MHUnit_SetTeamGlow(oA,ConvertPlayerColor(GetPlayerId(GetOwningPlayer(IH7))))
set d=XX7(IH7)
call SetUnitScale(oA,d,d,d)
call SetUnitPathing(oA,false)
call SetUnitPathing(BB7,false)
call MHUnit_SetFacing(oA,Face,true)
call SetUnitFlyHeight(oA,500,3000)
if GetUnitTypeId(IH7)=='U00P' then
call SetUnitAnimation(oA,"stand alternate")
endif
// B1116: 125 timer ticks at .02 seconds; selection/order events must not shorten the lifecycle.
call SaveReal(L7,OB7,StringHash("B1116CycloneUntil"),KQ7()+2.5)
call TriggerRegisterTimerEvent(t,0.02,true)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t, IH7, EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,BB7,EVENT_UNIT_SELECTED)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MNCF2))
call SaveUnitHandle(L7,(OB7),(1),(IH7))
call SaveUnitHandle(L7,(OB7),(2),(BB7))
call SaveUnitHandle(L7,(OB7),(3),(oA))
call SaveReal(L7,(OB7),(4),(Face))
call SaveUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7), BB7)
set cbtx=LoadInteger(TABLE_Z, GetPlayerId(GetOwningPlayer(IH7)),0)
if cbtx!=0 then
call UnitRemoveAbility(IH7,cbtx)
endif
set t=null
set ZX7=null
set IH7=null
set BB7=null
set oA=null
endfunction
function Get_MNCF_UNIT takes unit ZX7 returns unit
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local group g=WS7()
local real x=(b1061SavedGetSpellTargetX)
local real y=(b1061SavedGetSpellTargetY)
    set U22=ZX7
    call GroupEnumUnitsInRange(g,x,y,300,Condition(function BGX))
    set VJ4=Get_LowHP_Friend_PD(g)
    call WR7(g)
    set g=null
    return VJ4
endfunction
function MNCF_PD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer skill=B287_GetSpellAbilityId()
if IH7==null then
    if GetSpellTargetItem()!=null then
        set IH7=ZX7
    else
        set IH7=Get_MNCF_UNIT(ZX7)
    endif
endif
if IH7==null then
    call KR7(ZX7)
    call X37(GetOwningPlayer(ZX7),"附近没有友方英雄")
    call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,0.)
    set ZX7=null
    return
endif
if UnitAlive(IH7)==false or (skill!='A1T7' and skill!='A4DG') then
    set ZX7=null
    set IH7=null
    return
endif
if (IsUnitEnemy(IH7,GetOwningPlayer(ZX7)))==false then
    if skill=='A1T7' then
