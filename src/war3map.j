function ChaosObserver_FindNearestHero takes real maxRange returns unit
local integer i=1
local unit hero=null
local unit nearest=null
local real dx=0.
local real dy=0.
local real distance=0.
local real nearestDistance=maxRange*maxRange
if ChaosObserverBoss==null or GetUnitTypeId(ChaosObserverBoss)==0 then
return null
endif
loop
exitwhen i>5
set hero=M7[i]
if ChaosObserver_IsDalaranHero(hero) and XH7(hero)==false then
set dx=GetUnitX(hero)-GetUnitX(ChaosObserverBoss)
set dy=GetUnitY(hero)-GetUnitY(ChaosObserverBoss)
set distance=dx*dx+dy*dy
if distance<=nearestDistance then
set nearest=hero
set nearestDistance=distance
endif
endif
set i=i+1
endloop
set hero=null
return nearest
endfunction
function ChaosObserver_SelectMeteorTarget takes nothing returns unit
local integer i=1
local integer j=1
local integer count=0
local integer bestCount=0
local unit candidate=null
local unit hero=null
local unit best=null
local real dx=0.
local real dy=0.
loop
exitwhen i>5
set candidate=M7[i]
if ChaosObserver_IsDalaranHero(candidate) and XH7(candidate)==false then
set dx=GetUnitX(candidate)-ChaosObserverHomeX
set dy=GetUnitY(candidate)-ChaosObserverHomeY
if dx*dx+dy*dy<=3240000. then
set count=0
set j=1
loop
exitwhen j>5
set hero=M7[j]
if ChaosObserver_IsDalaranHero(hero) and XH7(hero)==false then
set dx=GetUnitX(hero)-GetUnitX(candidate)
set dy=GetUnitY(hero)-GetUnitY(candidate)
if dx*dx+dy*dy<=122500. then
set count=count+1
endif
endif
set j=j+1
endloop
if count>bestCount then
set bestCount=count
set best=candidate
endif
endif
endif
set i=i+1
endloop
set candidate=null
set hero=null
return best
endfunction
function ChaosObserver_SpawnGuard takes nothing returns nothing
local integer i=1
local integer slot=0
local real angle=0.
local real x=0.
local real y=0.
local unit target=null
local player owner=null
if ChaosObserver_CanAct()==false then
return
endif
loop
exitwhen i>4
if ChaosObserverGuard[i]==null or XH7(ChaosObserverGuard[i]) then
set ChaosObserverGuard[i]=null
set slot=i
set i=5
endif
set i=i+1
endloop
if slot==0 then
return
endif
set ChaosObserverGuardSerial=ChaosObserverGuardSerial+1
set angle=I2R(ChaosObserverGuardSerial*97)
set x=GetUnitX(ChaosObserverBoss)+260.*Cos(angle*bj_DEGTORAD)
set y=GetUnitY(ChaosObserverBoss)+260.*Sin(angle*bj_DEGTORAD)
set owner=GetOwningPlayer(ChaosObserverBoss)
set ChaosObserverGuard[slot]=CreateUnit(owner,'nC0G',x,y,angle+180.)
call ChaosObserver_ApplyPlayerScaling(ChaosObserverGuard[slot],'A9BG')
set target=ChaosObserver_FindNearestHero(2000.)
if target!=null then
call B947IssueTargetOrder("ChaosObserver_SpawnGuard @ war3map.j:121293 (B968)",ChaosObserverGuard[slot],"attack",target)
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y))
set target=null
set owner=null
endfunction
