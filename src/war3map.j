local trigger t
local integer OB7
local real HaveA=0.
local real DUR
if SuijiMode_ScepterRegistryIsActive(p5,'A1MG') then
set HaveA=.03
endif
if V77>0 and IsUnitType(m5,UNIT_TYPE_HERO) and IsUnitIllusion(m5)==false and (not DGFS(m5) and LB7(GetUnitTypeId(m5))==false) then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call B1023RegisterDamage(t,m5)
call TriggerAddCondition(t,Condition(function QAE))
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NP7(OB7,"Level",V77)
call NQ7(OB7,"HaveA",HaveA)
call XF7(m5,'A1JA')
call XF7(m5,'A1LD')
if SuijiMode_ScepterRegistryIsActive(p5,'A1MG')==false then
set DUR=(TimerGetElapsed(W))+7+V77 //持续时间
else
set DUR=(TimerGetElapsed(W))+15
endif
call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("DUR"),DUR)
call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE"),GetUnitState(m5,UNIT_STATE_LIFE))
call SaveUnitHandle(TABLE_HY, GetHandleId(m5),StringHash("SOURCE"),p5)
call SaveInteger(TABLE_HY, GetHandleId(m5),StringHash("LEVEL"),V77)
endif
set t=null
endfunction
function NS8 takes nothing returns nothing
local trigger t=CreateTrigger()
