function ZCJSMJ takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function TradeTricks_Cast))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
