call QAF(false,"Scrg",HB4)
endfunction
function Q5F takes player pl returns nothing
if((LT or BT))then
if(Y74[GetPlayerId(pl)]==1)then
if(not BT)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+25.))
else
