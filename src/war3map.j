function JDZC_SLOW_REMOVE takes unit IH7 returns nothing
    call UnitRemoveAbility(IH7,'A4JW')
    call UnitRemoveAbility(IH7,'A4JX')
    call UnitRemoveAbility(IH7,'A4JY')
    call UnitRemoveAbility(IH7,'A4JZ')
    call UnitRemoveAbility(IH7,'B07I')
    call UnitRemoveAbility(IH7,'B07E')
endfunction
function M8E takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 1)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 0)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real d=LoadReal(ExtraHT, OB7, 10)
    local integer MAX=LoadInteger(ExtraHT, OB7, 0)
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        if IH7!=null then
            call JDZC_SLOW_REMOVE(IH7)
            call RemoveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
            call RemoveSavedHandle(ExtraHT, 'jdzc'+1, GetHandleId(IH7))
        endif
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        set b1060ReturnValue=false
        set b1060GetTriggerEventId=null
        return b1060ReturnValue
    endif
    if n>MAX or (GetUnitAbilityLevel(IH7,'B07I')==0 and n>1) or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
        call JDZC_SLOW_REMOVE(IH7)
        call RemoveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
        call RemoveSavedHandle(ExtraHT, 'jdzc'+1, GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
    elseif ModuloReal(n,10.)==0 then
        call B67(ZX7,IH7,2,d)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set ZX7=null
    set IH7=null
    set b1060ReturnValue=false
    set b1060GetTriggerEventId=null
    return b1060ReturnValue
endfunction
function MDE takes nothing returns nothing
local boolean b = LoadBoolean(TABLE_HY, GetHandleId(GetTriggeringTrigger()), 100)
local unit ZX7 = U22
local unit IH7 = W22
local trigger t
local integer OB7
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0NQ')
local integer slow_skill='A4JV'+level
local real d=8.+12*level
local integer durationCount=LoadInteger(TABLE_HY,GetHandleId(GetTriggeringTrigger()),101)
if durationCount<=0 then
set durationCount=1
endif
if HaveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7)) then
    set t=LoadTriggerHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
    set OB7=GetHandleId(t)
    call SaveReal(ExtraHT, OB7, 0, 0)
    call SaveReal(ExtraHT, OB7, 10, d)
    call SaveInteger(ExtraHT, OB7, 0, (20+level*10)*durationCount)
else
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call SaveUnitHandle(ExtraHT, OB7, 1, ZX7)
    call SaveUnitHandle(ExtraHT, OB7, 0, IH7)
    call SaveReal(ExtraHT, OB7, 0, 0)
    call SaveReal(ExtraHT, OB7, 10, d)
    call SaveInteger(ExtraHT, OB7, 0, (30+level*10)*durationCount)
    call SaveTriggerHandle(ExtraHT, 'jdzc', GetHandleId(IH7), t)
    call TriggerRegisterTimerEvent(t,.1,true)
    call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
    call TriggerAddCondition(t,Condition(function M8E))
    call XF7(IH7,slow_skill)
endif
if b then
    call LINGXIA(ZX7,IH7)
endif
set t=null
set ZX7=null
set IH7=null
endfunction
function JDZC takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local group g=WS7()
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0NQ')
local integer MAX=level*2
local integer i=1
local trigger t
set U22=ZX7
call GroupEnumUnitsInRange(g, GetUnitX(IH7), GetUnitY(IH7), 400+50*level, Condition(function DJX))
set t=NHX(ZX7, IH7,'h0HH', "MDE",1300, true, "Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl")
call SaveBoolean(TABLE_HY, GetHandleId(t), 100, true)
call SaveInteger(TABLE_HY, GetHandleId(t), 101, SuijiMode_GetDurationMulticastCount(ZX7,'A0NQ'))
call GroupRemoveUnit(g,IH7)
loop
exitwhen FirstOfGroup(g)==null or i>=MAX
set IH7=M59(g,GetUnitX(IH7),GetUnitY(IH7))
call GroupRemoveUnit(g,IH7)
if WQ7(IH7) then
    call PLK(IH7)
else
    set t=NHX(ZX7, IH7,'h0HH', "MDE",1300, true, "Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl")
    call SaveInteger(TABLE_HY, GetHandleId(t), 101, SuijiMode_GetDurationMulticastCount(ZX7,'A0NQ'))
endif
set i=i+1
endloop
call WR7(g)
set g=null
set ZX7=null
set IH7=null
set t=null
endfunction
