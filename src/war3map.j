set g=null
set ML9=null
return false
endfunction
function IOG_SZ takes unit WI7,real x,real y,integer V77,string s,real d returns nothing
// local unit WI7=GetTriggerUnit()
// local location l=GetSpellTargetLoc()
// local real x=GetLocationX(l)
// local real y=GetLocationY(l)
