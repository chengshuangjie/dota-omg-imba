local real RK=ON7(OB7,"Angle")
local integer u3=OM7(OB7,"Remaining")
local group Ro=OF7(OB7,"AlreadyDamaged")
local real u4=GetUnitX(WI7)
local real u5=GetUnitY(WI7)
