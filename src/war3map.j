function SuijiMode_GetTossOrderId takes unit WI7 returns integer
if B287_GetPhysicalAbilityId(WI7,'A0BZ')=='Y03T' then
return 852089
endif
return 852600
endfunction
function SuijiMode_IsValidTossDestination takes unit tossCaster,unit tossTarget returns boolean
return tossCaster!=null and tossTarget!=null and GetUnitTypeId(tossCaster)!=0 and GetUnitTypeId(tossTarget)!=0 and tossTarget!=tossCaster and XH7(tossTarget)==false and IsHideUnit(tossTarget)==false and CHUIFENG(tossTarget)==false and IsUnitVisible(tossTarget,GetOwningPlayer(tossCaster)) and IsUnitType(tossTarget,UNIT_TYPE_FLYING)==false and IsUnitType(tossTarget,UNIT_TYPE_ANCIENT)==false
endfunction
function SuijiMode_PickTossDestination takes unit tossCaster,real tossX,real tossY returns unit
local group tossGroup=WS7()
local unit tossCandidate=null
local unit tossEnemyHero=null
local unit tossEnemyOther=null
local unit tossAllyHero=null
local unit tossAllyOther=null
local unit tossResult=null
local real tossCandidateLife=0.
local real tossEnemyHeroLife=1000000000.
local real tossEnemyOtherLife=1000000000.
local real tossAllyHeroLife=1000000000.
local real tossAllyOtherLife=1000000000.
call GroupEnumUnitsInRange(tossGroup,tossX,tossY,300.,null)
loop
set tossCandidate=FirstOfGroup(tossGroup)
exitwhen tossCandidate==null
call GroupRemoveUnit(tossGroup,tossCandidate)
if SuijiMode_IsValidTossDestination(tossCaster,tossCandidate) then
set tossCandidateLife=GetUnitState(tossCandidate,UNIT_STATE_LIFE)
if IsUnitEnemy(tossCandidate,GetOwningPlayer(tossCaster)) then
if IsUnitType(tossCandidate,UNIT_TYPE_HERO) then
if tossCandidateLife<tossEnemyHeroLife or (tossCandidateLife==tossEnemyHeroLife and GetHandleId(tossCandidate)<GetHandleId(tossEnemyHero)) then
set tossEnemyHero=tossCandidate
set tossEnemyHeroLife=tossCandidateLife
endif
elseif tossCandidateLife<tossEnemyOtherLife or (tossCandidateLife==tossEnemyOtherLife and GetHandleId(tossCandidate)<GetHandleId(tossEnemyOther)) then
set tossEnemyOther=tossCandidate
set tossEnemyOtherLife=tossCandidateLife
endif
elseif IsUnitType(tossCandidate,UNIT_TYPE_HERO) then
if tossCandidateLife<tossAllyHeroLife or (tossCandidateLife==tossAllyHeroLife and GetHandleId(tossCandidate)<GetHandleId(tossAllyHero)) then
set tossAllyHero=tossCandidate
set tossAllyHeroLife=tossCandidateLife
endif
elseif tossCandidateLife<tossAllyOtherLife or (tossCandidateLife==tossAllyOtherLife and GetHandleId(tossCandidate)<GetHandleId(tossAllyOther)) then
set tossAllyOther=tossCandidate
set tossAllyOtherLife=tossCandidateLife
endif
endif
endloop
call WR7(tossGroup)
set tossGroup=null
set tossCandidate=null
if tossEnemyHero!=null then
set tossResult=tossEnemyHero
elseif tossEnemyOther!=null then
set tossResult=tossEnemyOther
elseif tossAllyHero!=null then
set tossResult=tossAllyHero
else
set tossResult=tossAllyOther
endif
set tossEnemyHero=null
set tossEnemyOther=null
set tossAllyHero=null
set tossAllyOther=null
return tossResult
endfunction
function KLD takes nothing returns boolean
//return(AV7()and KW7(GetFilterUnit())==false and(IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit())))!=null
return((AU7()and KW7(GetFilterUnit())==false)and (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) or OO7(GetHandleId(GetOwningPlayer(GetFilterUnit())),"DisableHelp")==false))!=null
endfunction
function K1D takes unit WI7 returns unit
local unit p5=null
local group g=WS7()
set IN4=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),275+25,Condition(function KLD))
call GroupRemoveUnit(g,WI7)
// set p5=GroupPickRandomUnit(g)
set p5=M59(g,GetUnitX(WI7),GetUnitY(WI7))
call WR7(g)
set IN4=p5
set p5=null
set g=null
return IN4
endfunction
function K0D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer iX=GetTriggerEvalCount(t)
local unit WI7=O77(OB7,"Hero")
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real K5D=ON7(OB7,"Tossx0")
local real K2D=ON7(OB7,"Tossy0")
local integer id=OM7(OB7,"id")
local integer level=OM7(OB7,"level")
local boolean HaveA=OO7(OB7,"HaveA")
local real x1=0.
local real y1=0.
local real x2=0.
local real y2=0.
local real RK
local real K_D
local real M4D
local real M7D
local real Il
local real IL
local location l
if WI7==null or p5==null or m5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
if p5!=null and GetUnitTypeId(p5)!=0 then
call PauseUnitEx(p5,false)
call SetUnitPathing(p5,true)
call OX7(p5,"Tossed")
endif
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set p5=null
set m5=null
return false
endif
set x1=GetUnitX(p5)
set y1=GetUnitY(p5)
set x2=GetUnitX(m5)
set y2=GetUnitY(m5)
if KF7(K5D,K2D,x2,y2)>$3E8 then
set x2=K5D
set y2=K2D
endif
set RK=J77(x1,y1,x2,y2)
set K_D=KF7(x1,y1,x2,y2)
set M4D=K_D/(51-iX)
set M7D=(iX-25)*(iX-25)
set Il=x1+M4D*Cos(RK*bj_DEGTORAD)
set IL=y1+M4D*Sin(RK*bj_DEGTORAD)
if iX<51 then
if KCD(p5)==false then
call SetUnitFlyHeight(p5,775-M7D,0)
endif
call SetUnitPosition(p5,Il,IL)
else
if KCD(p5)==false then
call SetUnitFlyHeight(p5,GetUnitDefaultFlyHeight(p5),0)
endif
//call PauseUnit(p5,false)
call PauseUnitEx(p5,false)
call SetUnitPathing(p5,true)
call SetUnitPosition(p5,x2,y2)
call OX7(p5,"Tossed")
set l=Location(x2,y2)
call TerrainDeformationRippleBJ(.2,true,l,1.,300.,96.,1,64.)
call RemoveLocation(l)
call DestroyEffect(OG7(OB7,"FX"))
//落地特效
if id=='Zcrl' or id=='Z01X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n9s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif id=='Zdrl' or id=='Z11X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n3s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif id=='Zerl' or id=='Z21X' then
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n6s_t_ground.mdl",GetUnitX(p5),GetUnitY(p5)))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(p5),GetUnitY(p5)))
endif
if IsUnitAlly(p5,GetOwningPlayer(WI7))then
else
if HaveA then
call B67(WI7,p5,1,(.2+.2*(B287_GetUnitAbilityLevel(WI7,'A0CY')+1))*75*level)
else
call B67(WI7,p5,1,(.2+.15*B287_GetUnitAbilityLevel(WI7,'A0CY'))*75*level)
endif
endif
call Y67(x2,y2,300)
call K6D(WI7,x2,y2,300,75*level)
call LINGXIA(WI7,m5)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set p5=null
set m5=null
set l=null
return false
endfunction
function SBMQ takes unit ZX7,unit p5 returns boolean
    local integer id1=GetPlayerId(GetOwningPlayer(ZX7))
    local integer id2=GetPlayerId(GetOwningPlayer(p5))
    if IsUnitAlly(p5,GetOwningPlayer(ZX7)) and SPEPLAYER[id2]==1 and id1!=id2 then
        return true
    endif
    return false
endfunction
function M8D takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local integer tossCasterId=GetHandleId(WI7)
local unit p5=LoadUnitHandle(L7,tossCasterId,StringHash("SuijiTossPendingSource"))
local unit m5=LoadUnitHandle(L7,tossCasterId,StringHash("SuijiTossPendingTarget"))
local unit tossReflector=null
local trigger t=null
local integer OB7=0
local integer id=0
local integer level=0
local boolean HaveA=false
call RemoveSavedHandle(L7,tossCasterId,StringHash("SuijiTossPendingSource"))
call RemoveSavedHandle(L7,tossCasterId,StringHash("SuijiTossPendingTarget"))
if WI7==null or p5==null or m5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set WI7=null
set p5=null
set m5=null
set tossReflector=null
return
endif
if SBMQ(WI7,p5) then
    set tossReflector=p5
    set p5=WI7
    set WI7=tossReflector
endif
if WI7==null or p5==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(p5)==0 then
set WI7=null
set p5=null
set m5=null
set tossReflector=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set id=GetUnitTypeId(WI7)
set level=B287_GetUnitAbilityLevel(WI7,'A0BZ')
if SuijiMode_ScepterRegistryIsActive(WI7,'A0BZ') then
    set HaveA=true
endif
call SetUnitAnimationByIndex(WI7,4)
//call PauseUnit(p5,true)
call PauseUnitEx(p5,true)
call SetUnitPathing(p5,false)
if KCD(p5)==false then
call XF7(p5,'Amrf')
call UnitRemoveAbility(p5,'Amrf')
endif
call OV7(p5,"Tossed")
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NS7(OB7,"HaveA",HaveA)
if id=='Zcrl' or id=='Z01X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n9s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n9s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n9s_t_smoke_self.mdl",WI7,"origin"))
elseif id=='Zdrl' or id=='Z11X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n3s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n3s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n3s_t_smoke_self.mdl",WI7,"origin"))
elseif id=='Zerl' or id=='Z21X' then
call NU7(OB7,"FX",AddSpecialEffectTarget("model\\hero_giantstone_n6s_t_ribbon.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n6s_t_smoke_target.mdx",GetUnitX(p5),GetUnitY(p5)))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_giantstone_n6s_t_smoke_self.mdl",WI7,"origin"))
else
call NU7(OB7,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",p5,"origin"))
endif
call NQ7(OB7,"Tossx0",GetUnitX(m5))
call NQ7(OB7,"Tossy0",GetUnitY(m5))
call NP7(OB7,"id",id)
call NP7(OB7,"level",level)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function K0D))
if IsUnitEnemy(p5,GetOwningPlayer(WI7))then
call B947IssueTargetOrderById("M8D @ war3map.j:86632 (B968)",WI7,$D000F,p5)
endif
set WI7=null
set p5=null
set m5=null
set tossReflector=null
set t=null
endfunction
function M9D takes nothing returns nothing
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit WI7=(b1061SavedGetTriggerUnit)
local unit p5=K1D(WI7)
local unit m5=SuijiMode_PickTossDestination(WI7,(b1061SavedGetSpellTargetX),(b1061SavedGetSpellTargetY))
local integer tossCasterId=GetHandleId(WI7)
call RemoveSavedHandle(L7,tossCasterId,StringHash("SuijiTossPendingSource"))
call RemoveSavedHandle(L7,tossCasterId,StringHash("SuijiTossPendingTarget"))
if p5==null then
call KR7(WI7)
call X37(GetOwningPlayer(WI7),VU7('n0DA'))
elseif m5==null then
call KR7(WI7)
call X37(GetOwningPlayer(WI7),"目标圆圈内没有有效单位")
else
call SaveUnitHandle(L7,tossCasterId,StringHash("SuijiTossPendingSource"),p5)
call SaveUnitHandle(L7,tossCasterId,StringHash("SuijiTossPendingTarget"),m5)
endif
set WI7=null
set p5=null
set m5=null
set b1061SavedGetTriggerUnit=null
endfunction
function MDD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0BZ' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
call M9D()
else
call M8D()
endif
endif
return false
endfunction
function GR8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MDD))
set t=null
endfunction
function MED takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
call M_9('A2KK')
endfunction
function MFD takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer WF8
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(ZX7) or not B1023HitLive(GetTriggerUnit())) then
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==ZX7 and b1060GetEventDamage>20. then
set WF8=OM7(GetHandleId(ZX7),"WarClub_Count")
if OT7(ZX7,"WarClubState")==false then
call O37(ZX7,"WarClubState",.1)
call NP7(GetHandleId(ZX7),"WarClub_Count",(WF8+1))
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
else
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function MGD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer T_7=GetHandleId(t)
local unit CV7=O77(T_7,"Source")
local integer MHD=OM7(GetHandleId(CV7),"WarClub_Count")
call NP7(T_7,"WarClub_Cooldown",1)
call UnitRemoveAbility(CV7,'A1VG')
if(MV7(CV7,ZU[GB4])!=null)then
call XF7(CV7,'A1VH')
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(CV7),'A1VH',true)
if MHD>5 then
call FlushChildHashtable(L7,T_7)
call OZ7(t)
endif
set CV7=null
set t=null
return false
endfunction
function MID takes nothing returns nothing
local trigger t
local unit CV7=GetAttacker()
local integer T_7=GetHandleId(CV7)
local integer MHD=OM7(T_7,"WarClub_Count")
if not B1023HitLive(GetAttacker()) or not B1023HitLive(GetTriggerUnit()) then
set t=null
set CV7=null
return
endif
if MHD<6 then
if not OT7(CV7,"WarClubState")then
set t=CreateTrigger()
call B1023RegisterDamage(t,GetTriggerUnit())
call TriggerRegisterTimerEvent(t,1.,false)
call TriggerAddCondition(t,Condition(function MFD))
call NT7(GetHandleId(t),"Source",CV7)
endif
else
call NP7(T_7,"WarClub_Count",(0))
call UnitRemoveAbility(CV7,'A1W1')
if(OM7(T_7,"WarClub_Cooldown"))==1 then
set t=OE7(T_7,"WarClub_EndTrig")
call FlushChildHashtable(L7,GetHandleId(t))
call OZ7(t)
endif
endif
set CV7=null
set t=null
endfunction
function MJD takes nothing returns boolean
if GetUnitAbilityLevel(GetAttacker(),'A1W1')>0 then
call MID()
endif
return false
endfunction
function MKD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)==1 then
call SetUnitTimeScalePercent(ZX7,$FA)
else
call SetUnitTimeScalePercent(ZX7,100)
call SetUnitAnimationByIndex(ZX7,$C)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
return false
endfunction
function MMD takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local destructable b1060GetSpellTargetDestructable=GetSpellTargetDestructable()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t
if b1060B287_GetSpellAbilityId=='A1VH' then
call O37(b1060GetTriggerUnit,"WarClubCastState",29.9)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(b1060GetTriggerUnit),'A1VH',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(b1060GetTriggerUnit),'A1VG',true)
call XF7(b1060GetTriggerUnit,'A1VG')
call SetPlayerAbilityAvailable(GetOwningPlayer(b1060GetTriggerUnit),'A1W1',false)
call XF7(b1060GetTriggerUnit,'A1W1')
call B947IssueTargetOrderById("MMD @ war3map.j:86780 (B968)",b1060GetTriggerUnit,$D021F,b1060GetSpellTargetDestructable)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,30,false)
call TriggerAddCondition(t,Condition(function MGD))
call NT7(GetHandleId(t),"Source",b1060GetTriggerUnit)
call NV7(GetHandleId(b1060GetTriggerUnit),"WarClub_EndTrig",t)
call NP7(GetHandleId(b1060GetTriggerUnit),"WarClub_Cooldown",(0))
call NP7(GetHandleId(b1060GetTriggerUnit),"WarClub_Count",(0))
set t=null
elseif b1060B287_GetSpellAbilityId=='A2KA' then
call RemoveDestructable(b1060GetSpellTargetDestructable)
call ShowUnit(b1060GetTriggerUnit,false)
call ShowUnit(b1060GetTriggerUnit,true)
call UnitRemoveAbility(b1060GetTriggerUnit,'Aloc')
call UnitAddAbility(b1060GetTriggerUnit,'A2KB')
call UnitRemoveAbility(b1060GetTriggerUnit,'A2KB')
call UnitAddAbility(b1060GetTriggerUnit,'A2KC')
call UnitRemoveAbility(b1060GetTriggerUnit,'A2KC')
call AddUnitAnimationProperties(b1060GetTriggerUnit,"upgrade",false)
endif
set b1060ReturnValue=false
set b1060GetSpellTargetDestructable=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function MND takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if(MV7((ZX7),ZU[GB4])!=null)then
if OT7(ZX7,"WarClubCastState")==false then
if B287_GetUnitAbilityLevel(ZX7,'A1VH')==0 and GetUnitAbilityLevel(ZX7,'A1VG')==0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A1VH',true)
call XF7(ZX7,'A1VH')
endif
endif
else
call B287_UnitRemoveAbility(ZX7,'A1VH')
call UnitRemoveAbility(ZX7,'A1VG')
endif
set t=null
set ZX7=null
return false
endfunction
function KW9 takes nothing returns nothing
local unit p5=B2
local unit m5=C2
local unit BB7=O77(GetHandleId(p5),"GrowCaster")
call NT7(GetHandleId(m5),"GrowCaster",BB7)
call SetUnitOwner(BB7,GetOwningPlayer(m5),true)
set p5=null
set m5=null
set BB7=null
endfunction
function XG8 takes nothing returns nothing
local unit WI7=IT4
local unit BB7=O77(GetHandleId(WI7),"GrowCaster")
if BB7!=null and GetUnitTypeId(BB7)=='e01V' then
call RemoveUnit(BB7)
endif
if WI7!=null then
call RemoveSavedHandle(L7,GetHandleId(WI7),StringHash("GrowCaster"))
endif
set WI7=null
set BB7=null
endfunction
function MOD takes nothing returns boolean
return B287_GetLearnedSkill()=='A0CY' and IsUnitIllusion(GetTriggerUnit())==false
endfunction
function TinyGrow_IsNativeType takes integer id returns boolean
return id=='Ucrl' or id=='U01X' or id=='Zcrl' or id=='Z01X' or id=='Zdrl' or id=='Z11X' or id=='Zerl' or id=='Z21X'
endfunction
function TinyGrow_GetScale takes unit u,integer level returns real
local integer id=GetUnitTypeId(u)
if id=='Zcrl' or id=='Z01X' then
return .5+.2*level
endif
if id=='Ucrl' or id=='U01X' or id=='Zdrl' or id=='Z11X' or id=='Zerl' or id=='Z21X' then
return .5+.25*level
endif
return Get_Unit_Scale(u)*(1.+.30*level)
endfunction
function B984GrowMoveSync takes unit growUnit984,integer growLevel984 returns nothing
local integer growHandle985=GetHandleId(growUnit984)
local integer growType985=GetUnitTypeId(growUnit984)
if growType985==0 or growLevel984<1 or growLevel984>3 then
return
endif
if GetUnitAbilityLevel(growUnit984,'A4L8')>0 then
call UnitRemoveAbility(growUnit984,'A4L8')
endif
// Change only the unit's base speed. Footwear remains wholly engine-owned.
// Use the type's default, never the current speed including items/buffs.
if OM7(growHandle985,"B985GrowLevel")!=growLevel984 or OM7(growHandle985,"B985GrowType")!=growType985 then
call SetUnitMoveSpeed(growUnit984,GetUnitDefaultMoveSpeed(growUnit984)+30.+10.*growLevel984)
call NP7(growHandle985,"B985GrowLevel",growLevel984)
call NP7(growHandle985,"B985GrowType",growType985)
endif
endfunction
function MPD takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit MQD=O77(GetHandleId(GetTriggeringTrigger()),"Tiny")
local integer V77=B287_GetUnitAbilityLevel(MQD,'A0CY')
local integer id=GetUnitTypeId(MQD)
local unit BB7=null
local real scale=0.
if GetTriggerEventId()==EVENT_UNIT_HERO_REVIVE_FINISH then
call RemoveSavedInteger(L7,GetHandleId(MQD),StringHash("B985GrowLevel"))
endif
if MQD==null or GetUnitTypeId(MQD)==0 or V77<=0 then
if MQD!=null then
call UnitRemoveAbility(MQD,'A4L8')
if GetUnitTypeId(MQD)!=0 and OM7(GetHandleId(MQD),"B985GrowLevel")>0 then
call SetUnitMoveSpeed(MQD,GetUnitDefaultMoveSpeed(MQD))
endif
call RemoveSavedInteger(L7,GetHandleId(MQD),StringHash("B985GrowLevel"))
call RemoveSavedInteger(L7,GetHandleId(MQD),StringHash("B985GrowType"))
set BB7=O77(GetHandleId(MQD),"GrowCaster")
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call RemoveUnit(BB7)
endif
call RemoveSavedHandle(L7,GetHandleId(MQD),StringHash("GrowCaster"))
call RemoveSavedHandle(L7,GetHandleId(MQD),StringHash("TinyGrowScaleTimer"))
endif
call NM7(I97)
call OZ7(t)
elseif GetUnitState(MQD,UNIT_STATE_LIFE)>1 and GetUnitAbilityLevel(MQD,'B0J5')==0 then
if TinyGrow_IsNativeType(id)==false then
call B984GrowMoveSync(MQD,V77)
endif
set scale=TinyGrow_GetScale(MQD,V77)
call SetUnitScale(MQD,scale,scale,scale)
endif
set t=null
set MQD=null
set BB7=null
endfunction
function MRD takes nothing returns boolean
local integer V77
local unit u=GetTriggerUnit()
local real scale=0.
if IsUnitIllusion(u) and B287_GetUnitAbilityLevel(u,'A0CY')>0 then
set V77=B287_GetUnitAbilityLevel(u,'A0CY')
if TinyGrow_IsNativeType(GetUnitTypeId(u))==false then
call B984GrowMoveSync(u,V77)
endif
set scale=TinyGrow_GetScale(u,V77)
call SetUnitScale(u,scale,scale,scale)
endif
set u=null
return false
endfunction
function TinyGrow_SyncUnit takes unit MTD returns nothing
local trigger t
local integer BC7=B287_GetUnitAbilityLevel(MTD,'A0CY')
local unit BB7
local region MUD
local integer i=0
local integer id=GetUnitTypeId(MTD)
local real scale=0.
if MTD==null or GetUnitTypeId(MTD)==0 or BC7<=0 then
set MTD=null
return
endif
set i=GetPlayerId(GetOwningPlayer(MTD))
set BB7=O77(GetHandleId(MTD),"GrowCaster")
if BB7==null or GetUnitTypeId(BB7)==0 then
set BB7=CreateUnit(GetOwningPlayer(MTD),'e01V',0,0,0)
set xxzd[i]=BB7
call NT7(GetHandleId(MTD),"GrowCaster",BB7)
else
call SetUnitOwner(BB7,GetOwningPlayer(MTD),true)
endif
call UnitRemoveAbility(BB7,'A10B')
call UnitRemoveAbility(BB7,'A10A')
call UnitRemoveAbility(BB7,'A0ZS')
if BC7==1 then
call XF7(BB7,'A10B')
elseif BC7==2 then
call XF7(BB7,'A10A')
else
call XF7(BB7,'A0ZS')
endif
if TinyGrow_IsNativeType(id) then
call UnitRemoveAbility(MTD,'A4L8')
call SetPlayerTechResearched(GetOwningPlayer(MTD),'R00E',BC7)
else
call B984GrowMoveSync(MTD,BC7)
endif
set scale=TinyGrow_GetScale(MTD,BC7)
call SetUnitScale(MTD,scale,scale,scale)
set t=OE7(GetHandleId(MTD),"TinyGrowScaleTimer")
if t==null then
set t=CreateTrigger()
call TriggerAddAction(t,function MPD)
call TriggerRegisterTimerEvent(t,2.,true)
call TriggerRegisterUnitEvent(t,MTD,EVENT_UNIT_HERO_REVIVE_FINISH)
call NT7(GetHandleId(t),"Tiny",MTD)
call NV7(GetHandleId(MTD),"TinyGrowScaleTimer",t)
endif
