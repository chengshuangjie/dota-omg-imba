set j=3
else
set j=JA7-1
endif
if LU4[JZ7+8+j]>0 then
if LU4[JZ7+$C+j]==0 then
set i=j
exitwhen true
elseif LU4[JZ7+8+j]>k or(LU4[JZ7+8+j]==k and GetRandomInt(1,5-JA7)==1)then
set i=j
set k=LU4[JZ7+8+j]
endif
endif
