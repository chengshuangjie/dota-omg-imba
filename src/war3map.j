function Q89 takes nothing returns boolean
local unit b1060GetSellingUnit=GetSellingUnit()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local unit Q99=GetSoldUnit()
local player p=GetOwningPlayer(Q99)
local integer i
local real x
local real y
local real a
if GetUnitTypeId(Q99)=='h06N' and IsPlayerAlly(GetOwningPlayer(Q99),GetOwningPlayer(b1060GetSellingUnit)) then
if M7[GetPlayerId(p)]!=null then
call X37(p,GetObjectName('n0F3'))
call KillUnit(Q99)
set Q99=null
set p=null
set b1060ReturnValue=false
set b1060GetSellingUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endif
set x=GetUnitX(b1060GetSellingUnit)
set y=GetUnitY(b1060GetSellingUnit)
set i=KJ7(GetUnitTypeId(b1060GetSellingUnit))
set a=GetUnitFacing(b1060GetSellingUnit)
call RemoveUnit(b1060GetSellingUnit)
call CreateUnit(p,i,x,y,a)
endif
if GetUnitTypeId(Q99)=='h06N' then
call KillUnit(Q99)
endif
if M7[GetPlayerId(Z7[1])]!=null and M7[GetPlayerId(Z7[2])]!=null and M7[GetPlayerId(Z7[3])]!=null and M7[GetPlayerId(Z7[4])]!=null and M7[GetPlayerId(Z7[5])]!=null and M7[GetPlayerId(A7[1])]!=null and M7[GetPlayerId(A7[2])]!=null and M7[GetPlayerId(A7[3])]!=null and M7[GetPlayerId(A7[4])]!=null and M7[GetPlayerId(A7[5])]!=null then
call OZ7(b1060GetTriggeringTrigger)
endif
set Q99=null
set p=null
set b1060ReturnValue=false
set b1060GetSellingUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function QD9 takes player pl,boolean J4 returns nothing
