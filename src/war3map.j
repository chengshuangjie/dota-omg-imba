// 该单位是否能注册事件
function UnitIsCanRegisterUnitEvent takes unit whichUnit returns boolean
    local integer id= GetUnitTypeId(whichUnit)
       // 不是能量圈(ncop) 不是巨石(o01X o01Y) 不是区域指示器(n00C)   不是冰晶爆轰 不是蓝猫马甲 不是大圣马甲 不是中立被动单位 不是信使
    //    return id != 'ncop' and id != 'o01X' and id != 'o01Y'  and id != 'n00C'  and id != 'H0B8' and id != 'H07G' and id != 'Z053' and GetOwningPlayer(whichUnit) != C7 and KW7(whichUnit)==false
    // 不是能量圈(ncop) 不是巨石(o01X o01Y) 不是区域指示器(n00C)   不是冰晶爆轰 不是蓝猫马甲 不是大圣马甲 不是中立被动单位
       // 不是能量圈(ncop) 不是巨石(o01X o01Y) 不是区域指示器(n00C)   不是冰晶爆轰 不是蓝猫马甲 不是大圣马甲 不是中立被动单位 不是信使
    //    return id != 'ncop' and id != 'o01X' and id != 'o01Y'  and id != 'n00C'  and id != 'H0B8' and id != 'H07G' and id != 'Z053' and GetOwningPlayer(whichUnit) != C7 and KW7(whichUnit)==false
    // 不是能量圈(ncop) 不是巨石(o01X o01Y) 不是区域指示器(n00C)   不是冰晶爆轰 不是蓝猫马甲 不是大圣马甲 不是中立被动单位
    return id != 'ncop' and id != 'o01X' and id != 'o01Y' and id != 'n00C' and id != 'H0B8' and id != 'H07G' and id != 'Z053' and id != 'hhoo' and GetOwningPlayer(whichUnit) != C7 and KW7(whichUnit)==false
endfunction
function PlayerUnitGroup_IsEligible takes unit playerGroupUnit returns boolean
    return playerGroupUnit!=null and GetUnitTypeId(playerGroupUnit)!=0 and UnitAlive(playerGroupUnit) and GetUnitAbilityLevel(playerGroupUnit,'Aloc')==0 and IsUnitType(playerGroupUnit,UNIT_TYPE_STRUCTURE)==false and UnitIsCanRegisterUnitEvent(playerGroupUnit)
endfunction
function KKPeriodicHeroItemEligible takes unit kkPeriodicUnit returns boolean
    return PlayerUnitGroup_IsEligible(kkPeriodicUnit) and (IsUnitType(kkPeriodicUnit,UNIT_TYPE_HERO) or AS7(kkPeriodicUnit)) and IsUnitIllusion(kkPeriodicUnit)==false
endfunction
function KKLinkenCarrierEligible takes unit kkLinkenUnit returns boolean
    return KKPeriodicHeroItemEligible(kkLinkenUnit) and GetUnitTypeId(kkLinkenUnit)!='H00J' and GetUnitAbilityLevel(kkLinkenUnit,'A2RV')>0
endfunction
function B937ClassifyKnownUnit takes unit kkPeriodicUnit,boolean eligible937 returns nothing
    // The existing 1-second pass also catches lingering buffs after teleport.
if GetUnitAbilityLevel(kkPeriodicUnit,'B0KL')>0 then
call GroupAddUnit(B935FountainActive,kkPeriodicUnit)
endif
if B935HasDefenseRegen(kkPeriodicUnit) then
call GroupAddUnit(B935DefenseActive,kkPeriodicUnit)
endif
if eligible937 and (IsUnitType(kkPeriodicUnit,UNIT_TYPE_HERO) or AS7(kkPeriodicUnit)) and IsUnitIllusion(kkPeriodicUnit)==false then
        call GroupAddUnit(KKPeriodicHeroItemGroup,kkPeriodicUnit)
        if GetUnitTypeId(kkPeriodicUnit)!='H00J' and GetUnitAbilityLevel(kkPeriodicUnit,'A2RV')>0 then
            call GroupAddUnit(KKLinkenCarrierGroup,kkPeriodicUnit)
        endif
    endif
endfunction
function KKPeriodicClassifyUnit takes unit kkPeriodicUnit returns nothing
call B937ClassifyKnownUnit(kkPeriodicUnit,PlayerUnitGroup_IsEligible(kkPeriodicUnit))
endfunction
function KKPeriodicClassifyEnum takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
    call GroupAddUnit(PlayerUnitGroup,(b1060GetEnumUnit))
    // Only units accepted by PlayerUnitGroup_PD reach this enumerator.
call B937ClassifyKnownUnit((b1060GetEnumUnit),true)
    call B832WardTrack((b1060GetEnumUnit))
set b1060GetEnumUnit=null
endfunction
//存活 非蝗虫 非建筑 有效单位
function PlayerUnitGroup_PD takes nothing returns boolean
local unit b1060GetFilterUnit=GetFilterUnit()
local boolean b1060EnumReturn
    call B935TrackRegenSource((b1060GetFilterUnit))
set b1060EnumReturn=PlayerUnitGroup_IsEligible((b1060GetFilterUnit))
set b1060GetFilterUnit=null
return b1060EnumReturn
endfunction
function PlayerUnitGroup_OnEnter takes nothing returns boolean
local unit b1060GetEnteringUnit=GetEnteringUnit()
local boolean b1060ReturnValue
    call B935TrackRegenSource(b1060GetEnteringUnit)
call B832WardTrack(b1060GetEnteringUnit)
    if PlayerUnitGroup_IsEligible(b1060GetEnteringUnit) then
        call GroupAddUnit(PlayerUnitGroup,b1060GetEnteringUnit)
    endif
    call KKPeriodicClassifyUnit(b1060GetEnteringUnit)
    set b1060ReturnValue=false
    set b1060GetEnteringUnit=null
    return b1060ReturnValue
endfunction
function PlayerUnitGroup_OnDeath takes nothing returns boolean
local unit b1060GetDyingUnit=GetDyingUnit()
local boolean b1060ReturnValue
    call GroupRemoveUnit(PlayerUnitGroup,b1060GetDyingUnit)
    call GroupRemoveUnit(KKPeriodicHeroItemGroup,b1060GetDyingUnit)
    call GroupRemoveUnit(KKLinkenCarrierGroup,b1060GetDyingUnit)
    call GroupRemoveUnit(B935FountainActive,b1060GetDyingUnit)
call GroupRemoveUnit(B935DefenseActive,b1060GetDyingUnit)
set b1060ReturnValue=false
set b1060GetDyingUnit=null
return b1060ReturnValue
endfunction
function PlayerUnitGroup_OnRevive takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
    call B935TrackRegenSource(b1060GetTriggerUnit)
if PlayerUnitGroup_IsEligible(b1060GetTriggerUnit) then
        call GroupAddUnit(PlayerUnitGroup,b1060GetTriggerUnit)
    endif
    call KKPeriodicClassifyUnit(b1060GetTriggerUnit)
    set b1060ReturnValue=false
    set b1060GetTriggerUnit=null
    return b1060ReturnValue
endfunction
function PlayerUnitGroup_TRI takes nothing returns boolean
    local player p
    local integer i=0
    local group g=WS7()
    call B832WardPrune()
if B939DamageUnits!=null then
call ForGroup(B939DamageUnits,function B939PruneDamageOwner)
endif
    call GroupClear(PlayerUnitGroup)
    call GroupClear(KKPeriodicHeroItemGroup)
    call GroupClear(KKLinkenCarrierGroup)
    loop
    exitwhen i>12
    set p=Player(i)
    call GroupEnumUnitsOfPlayer(g, p, Condition(function PlayerUnitGroup_PD))
    if FirstOfGroup(g)!=null then
        call ForGroup(g,function KKPeriodicClassifyEnum)
    endif
    set i=i+1
    endloop
    call WR7(g)
    set p=null
    set g=null
    return false
endfunction
