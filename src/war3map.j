function OL9 takes nothing returns nothing
local string modeCmd=GetEventPlayerChatString()
if YJ4=="omg" and (modeCmd=="-1" or modeCmd=="-2" or modeCmd=="-3" or modeCmd=="-4" or modeCmd=="-5") then
return
endif
call NP9(modeCmd,1)
endfunction
function OmgNengCommand_Action takes nothing returns boolean
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local boolean b1060ReturnValue
local string s=StringCase(GetEventPlayerChatString(),false)
if s=="-neng" or s=="neng" then
if XM_MODE then
set XM_MODE=false
set XM_EXP=0
set XM_GOLD=0
set XM_CG=false
set CT=false
set WT=false
set DG0=false
call X37(b1060GetTriggerPlayer,"|c00FFCC00已关闭默认 OMG 中的 XM 难度，当前为普通 OMG 难度。|r")
else
call X37(b1060GetTriggerPlayer,"|c00FFCC00当前已是普通 OMG 难度。|r")
endif
endif
set b1060ReturnValue=false
set b1060GetTriggerPlayer=null
return b1060ReturnValue
endfunction
function OmgNengCommand_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>=12
call TriggerRegisterPlayerChatEvent(t,Player(i),"-neng",true)
call TriggerRegisterPlayerChatEvent(t,Player(i),"neng",true)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function OmgNengCommand_Action))
set t=null
endfunction
// B899: Aspb recursively rebuilds upgrades when adding its passive children.
// A researched HP bonus can be subtracted twice and kill the recipient.
// Materialize the old QDHP multiplier once at creation without an HP upgrade;
// every existing/future timed spellbook can then keep its native lifecycle.
function B836ArcHuman takes integer arcPid returns boolean
return arcPid>=0 and arcPid<12 and KKServerScore_InitialHuman[arcPid] and not KKServerScore_Left[arcPid] and GetPlayerController(Player(arcPid))==MAP_CONTROL_USER and GetPlayerSlotState(Player(arcPid))==PLAYER_SLOT_STATE_PLAYING
endfunction
function KKDifficulty_ApplyNewbieSpeedCap takes nothing returns nothing
local integer i=0
local unit u=null
if KK_GAME_DIFFICULTY!=1 then
return
endif
loop
exitwhen i>$B
if GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER then
set u=M7[i]
if u!=null and GetUnitTypeId(u)!=0 then
call MHUnit_SetMoveSpeedLimit(u,350.)
call MHUnit_SetAttackSpeedLimit(u,3.5)
endif
endif
set i=i+1
endloop
set u=null
endfunction
function KKDifficulty_StartNewbieSpeedCap takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddAction(t,function KKDifficulty_ApplyNewbieSpeedCap)
call KKDifficulty_ApplyNewbieSpeedCap()
set t=null
endfunction
function B979FinishChoice takes boolean hard979 returns nothing
if not B979ChoiceStarted or B979Mode!=0 then
return
endif
if hard979 then
call ExecuteFunc("B979InitData")
set B979Mode=2
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cffffcc00已选择 AI高难技能组合：普通AI从对应英雄的5套搭配中整套抽取；超级AI机制保留。|r")
else
set B979Mode=1
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cff80ff80已选择 AI普通技能组合：沿用原有随机组合与超级AI机制。|r")
endif
call DialogDisplay(Le,B979Dialog,false)
call DialogClear(B979Dialog)
call DialogDestroy(B979Dialog)
set B979Dialog=null
set B979NormalButton=null
set B979HardButton=null
call PauseTimer(B979ChoiceTimer)
call DestroyTimer(B979ChoiceTimer)
set B979ChoiceTimer=null
call OZ7(B979ChoiceTrigger)
set B979ChoiceTrigger=null
// Deferred heroes now use the final shared choice; no previously assigned pair is rerolled.
call ExecuteFunc("SuijiMode_ApplyExisting")
call ExecuteFunc("SuijiMode_ApplyMissingHeroes")
endfunction
function B979ChoiceClick takes nothing returns nothing
local button b1060GetClickedButton=GetClickedButton()
if GetTriggerPlayer()!=Le then
set b1060GetClickedButton=null
return
endif
if b1060GetClickedButton==B979HardButton then
call B979FinishChoice(true)
elseif b1060GetClickedButton==B979NormalButton then
call B979FinishChoice(false)
endif
set b1060GetClickedButton=null
endfunction
function B979ChoiceTimeout takes nothing returns nothing
if B979Mode==0 then
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cffffff80主机未在15秒内选择技能组合，默认采用AI普通技能组合。|r")
call B979FinishChoice(false)
endif
endfunction
function B979ShowChoice takes nothing returns nothing
if B979ChoiceStarted then
return
endif
if not SUIJI_MODE then
set B979Mode=1
return
endif
set B979Mode=0
set B979ChoiceStarted=true
set B979Dialog=DialogCreate()
call DialogSetMessage(B979Dialog,"请选择AI技能组合（仅主机选择，15秒后默认普通）")
set B979NormalButton=DialogAddButton(B979Dialog,"AI普通技能组合",0)
set B979HardButton=DialogAddButton(B979Dialog,"AI高强度技能组合",0)
set B979ChoiceTrigger=CreateTrigger()
call TriggerRegisterDialogEvent(B979ChoiceTrigger,B979Dialog)
call TriggerAddAction(B979ChoiceTrigger,function B979ChoiceClick)
set B979ChoiceTimer=CreateTimer()
call TimerStart(B979ChoiceTimer,15.,false,function B979ChoiceTimeout)
call DialogDisplay(Le,B979Dialog,true)
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cffffcc00请等待主机选择AI普通技能组合或AI高难技能组合。|r")
endfunction

function KKDifficulty_Apply takes integer difficulty returns nothing
if KK_GAME_DIFFICULTY!=0 then
return
endif
set KK_GAME_DIFFICULTY=difficulty
if difficulty==1 then
set XM_MODE=false
set XM_EXP=0
set XM_GOLD=0
set XM_CG=false
set CT=false
set WT=true
set DG0=false
set EU=false
set FU=false
set FUCK=false
set Gw=true
set Gv=true
call KKDifficulty_StartNewbieSpeedCap()
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cFF80FF80已选择新手难度：普通OMG，AI无额外经验和金钱，电脑英雄移速上限350，MVP与背水一战不增加积分。|r")
elseif difficulty==3 then
set XM_EXP=5
set XM_GOLD=5
set XM_CG=true
set FUCK=true
set Gw=false
set Gv=false
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cFFFF8080已选择困难难度：默认OMG并启用 -cg 5 与法克模式，积分正常。|r")
else
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cFFFFFF80已选择正常难度：使用默认OMG难度，积分正常。|r")
endif
if KK_DIFFICULTY_DIALOG!=null then
call DialogDisplay(Le,KK_DIFFICULTY_DIALOG,false)
endif
call B979ShowChoice()
endfunction
function KKDifficulty_OnClick takes nothing returns nothing
local button b=GetClickedButton()
if b==KK_DIFFICULTY_NEWBIE then
call KKDifficulty_Apply(1)
elseif b==KK_DIFFICULTY_HARD then
call KKDifficulty_Apply(3)
else
call KKDifficulty_Apply(2)
endif
set b=null
endfunction
function KKDifficulty_OnTimeout takes nothing returns nothing
if KK_GAME_DIFFICULTY==0 then
call KKDifficulty_Apply(2)
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFFFFFF80主机未在15秒内选择，已自动采用正常难度。|r")
endif
endfunction
function KKDifficulty_Init takes nothing returns nothing
local trigger clickTrigger=CreateTrigger()
local trigger timeoutTrigger=CreateTrigger()
set KK_DIFFICULTY_DIALOG=DialogCreate()
call DialogSetMessage(KK_DIFFICULTY_DIALOG,"请选择难度（仅主机选择，15秒后默认正常）")
set KK_DIFFICULTY_NEWBIE=DialogAddButton(KK_DIFFICULTY_DIALOG,"新手：AI无资源加成，攻速移速受限，MVP/背水不计分",0)
set KK_DIFFICULTY_NORMAL=DialogAddButton(KK_DIFFICULTY_DIALOG,"正常：默认OMG难度；积分正常",0)
set KK_DIFFICULTY_HARD=DialogAddButton(KK_DIFFICULTY_DIALOG,"困难：默认OMG + CG5 + FUCK；积分正常",0)
call TriggerRegisterDialogEvent(clickTrigger,KK_DIFFICULTY_DIALOG)
call TriggerAddAction(clickTrigger,function KKDifficulty_OnClick)
call TriggerRegisterTimerEvent(timeoutTrigger,15.,false)
call TriggerAddAction(timeoutTrigger,function KKDifficulty_OnTimeout)
call DialogDisplay(Le,KK_DIFFICULTY_DIALOG,true)
call VV7(bj_FORCE_ALL_PLAYERS,15.,"|cFFFFCC00请等待主机选择本局难度。|r")
set clickTrigger=null
set timeoutTrigger=null
endfunction
function KKGameTips_GetTip takes integer gameTipIndex returns string
if gameTipIndex==1 then
return "游戏最重要的是抱团防守，抱团杀人的经验和经济，要远比你单独打野和带线的受益高！"
elseif gameTipIndex==2 then
return "不要单独带线，AI会抓人，同时会对多路同时推进，难以在同一时间防守多路！"
elseif gameTipIndex==3 then
return "预购装备：Shift+左键商店物品可加入或移出预购栏；双击预购图标会购买缺少的配件并尝试合成。"
elseif gameTipIndex==4 then
return "游戏内，按住Alt + 左键技能，向队友提示技能冷却信息，或显示塔攻击范围和野怪范围！"
elseif gameTipIndex==5 then
return "开局时，输入 -re + 指定楼层，可以让AI重新选择英雄；"
elseif gameTipIndex==6 then
return "开局时，输入 -sr，可以加速英雄阵亡的复活，输入 -sl + 数字，可以指定游戏结束的人头数量；"
elseif gameTipIndex==7 then
return "AI会从15分钟开始，大幅度提高进攻的欲望、提高经验和装备强度；"
elseif gameTipIndex==8 then
return "单独带线时要注意安全，AI会组队开雾抓单，把握时机可以用来拉扯AI，缓解AI的集体推进！"
elseif gameTipIndex==9 then
return "游戏有官方QQ群：1070032670、913554805，打不过AI的玩家建议加群看教程，B站平时也有主播直播。"
elseif gameTipIndex==10 then
return "单机模式时（仅有一个真实玩家），可开启 -test 模式，内置很多测试指令，也可使用群文件夹里的 -omgtest 指令。"
elseif gameTipIndex==11 then
return "如果发现技能快捷键冲突，可以试一试地图自带的改键，入口在F10的设置里或物品栏左边的按钮。"
elseif gameTipIndex==12 then
return "一些可以对自己释放的技能，双击后会直接对自己施法。"
endif
return "地图的官网是 https://dotaaiomg.cn，有大量的工具，也可以提交反馈建议，觉得还不错的，可以在官网打赏作者。"
endfunction
function KKGameTips_GetFloatingTip takes integer gameTipIndex returns string
if gameTipIndex==1 then
return "游戏最重要的是抱团防守，抱团杀人的经验和经济，\n要远比你单独打野和带线的受益高！"
elseif gameTipIndex==2 then
return "不要单独带线，AI会抓人，同时会对多路同时推进，\n难以在同一时间防守多路！"
elseif gameTipIndex==3 then
return "预购装备：Shift+左键商店物品可加入或移出预购栏；\n双击预购图标会购买缺少的配件并尝试合成。"
elseif gameTipIndex==4 then
return "按住Alt + 左键技能，可向队友提示技能冷却信息，\n或显示塔攻击范围和野怪范围！"
elseif gameTipIndex==5 then
