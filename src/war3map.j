function EnterKey___PushOther takes nothing returns nothing
	local integer key = DzGetTriggerKey()
	if key == 13 then
		set TpSlotLocalChatOpen=not TpSlotLocalChatOpen
	elseif key == 27 then
		set TpSlotLocalChatOpen=false
		// 按下ESC
		if TpSlotLocalTargeting then
			call TpSlot_SetTargetingLocal(false)
			call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,2.,"|cFFFFCC00已取消独立TP选点。|r")
		elseif IsSetUpUIEnable then
			// 退出选择面板
			call ClickMapSetUpReturnButton()
		elseif bMenuMainPanelIsEnable then
			// 退出菜单
			set bMenuMainPanelIsEnable = false
		elseif UpdateLogIsShow then
			// 退出更新日志
			call DzClickFrame(UIButton__UpdateLogOK)
		endif
	// elseif key == 115 then
	// 	// 如果按下F4 的同时还按着Alt
	// 	if DzIsKeyDown(18) then
	// 		call DzFrameShow( UIFrame__SetUp, false )
	// 		call DzFrameShow( UIFrame__OrderSetUp, false )
	// 		set IsSetUpUIEnable = false
	// 		set bMenuGameplayPanelIsEnable = false
	// 	endif
	// elseif key == 115 then
	// 	// 如果按下F4 的同时还按着Alt
	// 	if DzIsKeyDown(18) then
	// 		call DzFrameShow( UIFrame__SetUp, false )
	// 		call DzFrameShow( UIFrame__OrderSetUp, false )
	// 		set IsSetUpUIEnable = false
	// 		set bMenuGameplayPanelIsEnable = false
	// 	endif
	elseif key == 121 then
		// 按F10
		set bMenuMainPanelIsEnable = true
	endif
endfunction
function OmgHoldPositionHotkey_OnSync takes nothing returns nothing
	local player p = DzGetTriggerSyncPlayer()
	local integer id = GetPlayerId(p)
	local unit u = M7[id]
	if u != null and GetWidgetLife(u) > .405 and GetOwningPlayer(u) == p then
		call B947IssueImmediateOrderById("OmgHoldPositionHotkey_OnSync @ war3map.j:222236 (B968)",u,$D0004)
		call B947IssueImmediateOrderById("OmgHoldPositionHotkey_OnSync @ war3map.j:222237 (B968)",u,$D0019)
	endif
	set u = null
	set p = null
endfunction
function OmgHoldPositionHotkey_OnKeyDown takes nothing returns nothing
	if MHUI_IsChatEditBarOn() or MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) then
		return
	endif
	call MHMsg_SendImmediateOrder($D0004,0x6)
	call MHMsg_SendImmediateOrder($D0019,0x6)
	call DzSyncData("omghold","1")
endfunction
