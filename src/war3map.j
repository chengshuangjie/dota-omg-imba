set B894AllowedTitle[13]=27
set B894AllowedIdentity[14]="狂扁大帅比#2254"
set B894AllowedTitle[14]=1
set B894AllowedIdentity[15]="小生我怕怕#7351"
set B894AllowedTitle[15]=2
set B894AllowedIdentity[16]="都是要#8707"
set B894AllowedTitle[16]=0
set B894AllowedIdentity[17]="AAEAD#5577"
set B894AllowedTitle[17]=58
set B894AllowedIdentity[18]="吉达#9704"
set B894AllowedTitle[18]=59
set B894AllowedIdentity[19]="寒秋思雨#1956"
set B894AllowedTitle[19]=0
set B894AllowedIdentity[20]="此生俱一梦#3006"
set B894AllowedTitle[20]=50
set B894AllowedIdentity[21]="你那还疼吗#8574"
set B894AllowedTitle[21]=43
set B894AllowedIdentity[22]="小生我怕怕#7351"
set B894AllowedTitle[22]=0
set B894AllowedIdentity[23]="踏入红尘#9666"
set B894AllowedTitle[23]=0
set B894AllowedIdentity[24]="小生我怕怕#7997"
set B894AllowedTitle[24]=0
set B894AllowedIdentity[25]="郭靖#5413"
set B894AllowedTitle[25]=0
set B894AllowedIdentity[26]="小生我看破#3129"
set B894AllowedTitle[26]=0
set B894AllowedIdentity[27]="小生不怕#1701"
set B894AllowedTitle[27]=0
set KBAI=false
set KBAIID=0
loop
exitwhen b894Pid>11
set b894Player=Player(b894Pid)
// Default-deny every named privilege. No legacy nickname/alias fallback.
set SPEPLAYER[b894Pid]=0
set ThreeSkill[b894Pid]=0
set B892MiaoPermanent[b894Pid]=false
set B892BoundMulticast[b894Pid]=false
set B893BoundDuel[b894Pid]=false
set B894PlayerIdentity[b894Pid]=""
set B894PlayerIdentityRow[b894Pid]=0
if GetPlayerController(b894Player)==MAP_CONTROL_USER and GetPlayerSlotState(b894Player)==PLAYER_SLOT_STATE_PLAYING then
// Call for each player in the shared initialization path, not under GetLocalPlayer.
// Snapshot platform identity before SetSpecialName or hero display-name changes.
set B894PlayerIdentity[b894Pid]=RequestExtraStringData(81,b894Player,null,null,false,0,0,0)
set b894Row=B894MatchIdentity(B894PlayerIdentity[b894Pid])
set B894PlayerIdentityRow[b894Pid]=b894Row
call XOMG_LogEvent("IDENTITY pid="+I2S(b894Pid)+" empty="+I2S(B287_BoolToInt(B894PlayerIdentity[b894Pid]==null or B894PlayerIdentity[b894Pid]==""))+" row="+I2S(b894Row)+" fuzzy="+I2S(B287_BoolToInt(B1132IsXiaoSheng(b894Pid)))+" name_hash="+I2S(StringHash(GetPlayerName(b894Player))))
if B1132IsXiaoSheng(b894Pid) then
call DisplayTimedTextToPlayer(b894Player,0,0,20.,"已模糊识别‘小生’账号。KK存档读取成功后将发放15币、15天知识之书和15天寒铁钢爪，并开放 -recharge。")
endif
if b894Row>0 then
set SPEPLAYER[b894Pid]=B894AllowedTitle[b894Row]
set B892MiaoPermanent[b894Pid]=b894Row==15 or b894Row==17 or b894Row==18
set B892BoundMulticast[b894Pid]=b894Row==16
set B893BoundDuel[b894Pid]=b894Row==19
if b894Row==14 then
// Retain this account's former display alias and existing author utilities.
set KZ4[b894Pid]="狂扁AI"
call SetPlayerName(b894Player,"狂扁AI")
set KBAI=true
set KBAIID=b894Pid
endif
if b894Row==14 or b894Row==5 then
set ThreeSkill[b894Pid]=1
endif
if SPEPLAYER[b894Pid]>0 then
call SetSpecialName(b894Player)
endif
endif
call TriggerRegisterPlayerChatEvent(b894InfoTrigger,b894Player,"-whoami",true)
endif
// This is a public per-match feature, not a named entitlement.
set CHOUJIANGSTATE[b894Pid]=1
set b894Pid=b894Pid+1
endloop
call TriggerAddAction(b894InfoTrigger,function B894IdentityInfo)
set b894InfoTrigger=null
set b894Player=null
endfunction
function InitUpdateLog takes nothing returns nothing
local integer n=0
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9P、P2|r\n- 重做大部分净化技能效果，对友方驱散负面buff，对敌方驱散正面buff\n- 袁加凯和发条的钩子不会再钩到佣兽和战鹰\n- 分身继承吞食银月的攻速加成\n- 修复龙骑火焰呼吸有时没伤害的问题\n- 修复火猫T和冰龙R会导致智慧之光的属性丢失的问题\n- 修复部分技能不会被林肯抵挡的问题\n- 修复蓝猫会滚到地图外的问题\n- 修复目标闪避普攻时仍然会受到装备减甲的问题"
set n=n+1
set UpdateLog[n]="\n- 增加新装备：王冠、灵匣、绝刃、暴风长戟\n- 寂灭减甲调整为-10\n- 三跳刀统一价为6250，且冷却时间各不相同\n- 将秘奥闪光主动效果调整为被动效果\n- 大隐刀破被动的特效现在更加明显\n- BKB魔法免疫时间降低为8秒\n- 降低信使复活时间，增加无敌倒计时"
set n=n+1
set UpdateLog[n]="\n- [水人]复制可以对自身使用\n- [神谕]气运之末增加伤害，增加神杖效果\n- [圣堂]增加神杖效果\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9P3|r\n- 重做了泉水回复效果\n- 新增一个飞行信使\n- 更换了复活十字架的特效\n- 不朽盾和骷髅王重生期间可以正常获得经验和金钱\n- 移除林肯主动效果，增加林肯生效特效\n- 修复AI无法正常携带林肯的问题\n- 修复不朽盾在某些情况会无限复活的问题\n- 修复隐身无法躲避锤子类技能的问题\n- 修复缚灵索属性消失的问题\n- 修复美杜莎魔法盾无法关闭的问题\n- 修复分身技能会破自身林肯的问题\n- 修复洪流会多次触发叠油伤害的问题\n- 修复束缚击杀死英雄后会显示自杀的问题\n- 修复潮汐毁灭作用范围与实际描述不一致的问题"
set n=n+1
set UpdateLog[n]="\n- XM难度AI的两次换装，增加了一定程度上的随机出装\n- XM难度AI吃宝石条件改为满级且20分钟后，每8到12分钟会吃宝石\n- 增加了AI潮汐大接某些全屏技能小连招\n- AI全能和沙王更加智能\n- [蓝猫]略微增加球形闪电的魔法消耗\n- [地精修补匠]再装填可刷新灵匣、绝刃、林肯\n- [伐木机]伐木锯链伤害增加，施法距离降低，增加一个神杖效果"
set n=n+1
set UpdateLog[n]="\n- [大牛]增加神杖效果\n- [骷髅王]增加神杖效果\n- [凤凰]超新星略微降低冷却时间，增加神杖效果\n- [光法]灵魂形态取消神杖效果，3级大招即可持续永久，查克拉魔法增加神杖效果，\n致盲之光具有伤害和打断效果，修复召回会被目标自身伤害打断的问题\n- [小小]投掷将选取最近的单位而不是随机单位\n- [圣堂]隐匿减甲效果会在攻击伤害结算前生效，重做了灵能之刃，攻击时会显示其作用范围，灵能之刃增加神杖效果\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9P4|r\n- [伐木机]伐木锯链不会再被眩晕打断移动\n- [帕克]一二技能伤害略微增加，修复相位转移失效的问题，右键可开启自动释放\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9Q|r\n- 修复凤凰蛋不能解除血魔大的问题\n- 修复先知框对林肯无效的问题\n- 修复指向性充能技能对林肯释放不会正确破林肯的问题\n- 修复神牛强化图腾和魔免不能共存的问题\n- 风之杖点击地面使用时将自动选取目标点附近300范围内血量最低的友方英雄\n- [凤凰]装备神杖浴火重生期间可以进行普攻\n- [圣堂刺客]灵能之刃宽度增加，攻击距离略微增加，增加了折光加攻击和抵挡的特效，并修复折光一系列问题\n例如无法抵挡致死伤害，效果未消失前再次使用技能持续时间不会重置，次数耗尽后状态不会立即消失，S取消攻击会消耗次数等问题\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9Q2|r\n- 新增功能：显示队友头像，默认关闭，可在地图设置中开启\n- 新增装备虚影斧\n- 灵匣和绝刃可以主动使用\n- 白银之锋被动虚弱可破坏目标被动，效果不再无视魔免\n- 蝴蝶使用后可获得100%闪避和20%移速提升以及相位效果\n- 缚灵锁主动效果无视林肯\n- 分身斧分身最多同时存在4个\n- 小熊使用装备后可以丢弃物品\n- 九头蛇和攻城傀儡模型缩小三分之一\n- 薄葬和大吹风对地选取目标不会选取电狗分身\n- 修复双倍神符和魔免不能共存的问题\n- 修复狂战士的怒吼不能被驱散的问题\n- 修复吹风不会打断凤凰烈日炙烤的问题\n- 修复大药小净化重复使用不会重置时间的问题\n- 修复寒冬诅咒作用范围和特效范围不一致的问题"
set n=n+1
set UpdateLog[n]="\n- [土猫]残岩魔咒可对自己和魔免队友使用\n- [暗牧]薄葬倒计时对所有人可见\n- [亚巴顿]回光返照期间刃甲不会被驱散\n- [巫妖]略微增加连环霜冻弹射速度，无法弹跳时会停留在上个目标身上2秒，装备神杖时自身可以作为弹射目标\n- [伐木机]神杖飞轮改了个颜色和原始飞轮区分\n"
set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9Q3|r\n- 调整AI针对某些英雄买宝石真眼粉的逻辑，猴子或大树将不会再被反隐针对\n- 增加非死亡模式XM难度下AI等级保底机制，达到特定时间AI没有经验也会自动升级\n- 冰晶爆轰和剧毒新星使用吹风散失或驱散技能不再可驱散，但是分身技能和分身斧目前仍然可以驱散\n- 使用相位鞋后施法不会中断相位移动状态\n- 三种大跳刀被打断的禁用时间由2.5秒增加至3秒\n- 优化了使用跳刀时会取消技能选取的问题\n- 优化了风之杖期间使用一次跳刀，落地后会自动跳走，无需重复点跳刀"
set n=n+1
set UpdateLog[n]="\n- 尝试修复英雄视野异常问题\n- 修复冰龙极寒之拥期间可以移动的问题\n- 修复冰女隐身大招没减速的问题\n- 修复白牛会把肉山推到不可移动地形的问题\n- 修复AI虚空和AI水人不会使用一技能逃跑的问题\n- 修复兽王豪猪跟随英雄时不会自动攻击敌方的问题\n- 修复金箍棒会让减甲效果失效的问题\n- 修复某个伤害类型会让薄葬失效的问题\n- 修复巫妖大隐刀时仍然可以弹大招的问题\n- 修复火猫使用分身斧后无法使用火之余烬的问题\n- 修复重生过程中买活但无效的问题"
set n=n+1
set UpdateLog[n]="\n- 修复装备玲珑心使用物品后重新拾取冷却时间会延长的问题\n- [土猫]石头不会再封野\n- [灵魂守卫]和[敌法师]的力量成长提升0.2\n- [灵魂守卫]基础力量提升2，灵魂守卫变身后不会降低攻击间隔\n- [冰魂]释放冰晶爆轰后冰雹的飞行速度加快\n- [人马]双刃剑增加特效和声音\n- [拉比克]偷取再装填时，将变为有冷却时间的再装填-改\n- [大圣]优化丛林之舞，在树下使用丛林之舞会自动寻路\n"
