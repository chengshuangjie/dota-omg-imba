if IsUnitInGroup((b1060GetEnumUnit),EP7)==false then
call GroupAddUnit(EP7,(b1060GetEnumUnit))
call B67(EQ7,(b1060GetEnumUnit),3,60+40*ER7)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",(b1060GetEnumUnit),"origin"))
call BPG(EQ7,(b1060GetEnumUnit))
endif
set b1060GetEnumUnit=null
endfunction
function BSG takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit Y27=(LoadUnitHandle(L7,(I97),(45)))
local real Y_7=(LoadReal(L7,(I97),(6)))
local real Z47=(LoadReal(L7,(I97),(7)))
local real x
local real y
local real a
local integer BTG=(LoadInteger(L7,(I97),(33)))
local group BQ9=(LoadGroupHandle(L7,(I97),(187)))
local group g
local integer WF8=(LoadInteger(L7,(I97),(34)))
local real BUG
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if SuijiMode_IsChakramReturnButton(B287_GetSpellPhysicalAbilityId()) then
call SuijiMode_ChakramDebugSnapshot(ZX7,4)
call SaveInteger(L7,(I97),(33),(2))
call GroupClear(BQ9)
call SuijiMode_HideFixedTransientButtons(ZX7,'A2FX','ZT07','ZT08',false)
call SuijiMode_ChakramDebugSchedule(ZX7,5,.05)
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function BOG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
endif
elseif b1060GetTriggerEventId==EVENT_WIDGET_DEATH or(LoadInteger(L7,(GetHandleId(ZX7)),(704)))==-1 or OT7(ZX7,"LUNZ") then
call BP1(ZX7)
call SuijiMode_ChakramReturnButtonEnd(ZX7)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2E5',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2SH',true)
call UnitRemoveAbility(ZX7,'Bpig')
call UnitRemoveAbility(ZX7,'BEia')
call KillUnit(Y27)
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif BTG==0 then
set a=J77(GetUnitX(Y27),GetUnitY(Y27),Y_7,Z47)*bj_DEGTORAD
set x=GetUnitX(Y27)+18*Cos(a)
set y=GetUnitY(Y27)+18*Sin(a)
call Y67(x,y,175)
if KF7(x,y,Y_7,Z47)<40 then
set x=Y_7
set y=Z47
endif
call SetUnitX(Y27,x)
call SetUnitY(Y27,y)
set IN4=ZX7
set EQ7=ZX7
if GetUnitAbilityLevel(ZX7,'A2E5')>0 then
set ER7=GetUnitAbilityLevel(ZX7,'A2E5')
else
set ER7=GetUnitAbilityLevel(ZX7,'A2SH')
endif
set EP7=BQ9
set g=WS7()
call GroupEnumUnitsInRange(g,x,y,200+25,Condition(function AJ7_gai))
call ForGroup(g,function BRG)
call WR7(g)
if x==Y_7 and y==Z47 then
call SaveInteger(L7,(I97),(33),(1))
call GroupClear(BQ9)
endif
elseif BTG==1 then
set WF8=WF8+1
if WF8==25 then
set x=GetUnitX(Y27)
set y=GetUnitY(Y27)
call Y67(x,y,175)
set WF8=0
set IN4=ZX7
set EQ7=ZX7
if GetUnitAbilityLevel(ZX7,'A2E5')>0 then
set ER7=GetUnitAbilityLevel(ZX7,'A2E5')
else
set ER7=GetUnitAbilityLevel(ZX7,'A2SH')
endif
set g=WS7()
call GroupEnumUnitsInRange(g,x,y,200+25,Condition(function AJ7_gai))
call ForGroup(g,function BQG)
call WR7(g)
set BUG=(15+5*ER7)/2
if GetUnitState(ZX7,UNIT_STATE_MANA)<BUG or KE7(ZX7,Y27)>2000 then
call SaveInteger(L7,(I97),(33),(2))
call GroupClear(BQ9)
call SuijiMode_ChakramReturnButtonEnd(ZX7)
call UnitRemoveAbility(ZX7,'Bpig')
call UnitRemoveAbility(ZX7,'BEia')
else
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)-BUG)
endif
endif
call SaveInteger(L7,(I97),(34),(WF8))
elseif BTG==2 then
set a=J77(GetUnitX(Y27),GetUnitY(Y27),GetUnitX(ZX7),GetUnitY(ZX7))*bj_DEGTORAD
set x=GetUnitX(Y27)+16*Cos(a)
set y=GetUnitY(Y27)+16*Sin(a)
call Y67(x,y,175)
call SetUnitX(Y27,x)
call SetUnitY(Y27,y)
set IN4=ZX7
set EQ7=ZX7
if GetUnitAbilityLevel(ZX7,'A2E5')>0 then
set ER7=GetUnitAbilityLevel(ZX7,'A2E5')
else
set ER7=GetUnitAbilityLevel(ZX7,'A2SH')
endif
set EP7=BQ9
set g=WS7()
call GroupEnumUnitsInRange(g,x,y,200+25,Condition(function AJ7_gai))
call ForGroup(g,function BRG)
call WR7(g)
if KF7(x,y,GetUnitX(ZX7),GetUnitY(ZX7))<40 then
call BP1(ZX7)
call KillUnit(Y27)
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SuijiMode_ChakramReturnButtonEnd(ZX7)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2E5',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2SH',true)
endif
endif
set t=null
set ZX7=null
set Y27=null
set BQ9=null
set g=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function BVG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real a=J77(GetUnitX(ZX7),GetUnitY(ZX7),x,y)*bj_DEGTORAD
local unit Y27=CreateUnit(GetOwningPlayer(ZX7),'h0DS',GetUnitX(ZX7),GetUnitY(ZX7),a*bj_RADTODEG)
local trigger t=CreateTrigger()
