function SuijiMode_ToOriginalSkill takes integer skill returns integer
local integer original=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
if skill=='Y0GP' then
return 'A026'
elseif skill=='Y0GQ' then
return 'A2ZJ'
elseif skill=='Y0GR' then
return 'A09V'
elseif skill=='Y0GW' then
return 'A4HO'
elseif skill=='Y0GS' then
return 'AHfa'
elseif skill=='Y0GT' then
return 'A0LZ'
elseif skill=='Y0GU' then
return 'A0OI'
elseif skill=='Y0GV' then
return 'A0QN'
elseif skill=='Y0GI' then
return 'A0DY'
elseif skill=='Y0GN' then
return 'A1WB'
endif
if original!=0 then
return original
endif
return skill
endfunction
function SuijiMode_ToFixedClone takes integer skill returns integer
local integer clone=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,skill)
if skill=='A026' then
return 'Y0GP'
elseif skill=='A2ZJ' then
return 'Y0GQ'
elseif skill=='A09V' then
return 'Y0GR'
elseif skill=='A4HO' then
return 'Y0GW'
elseif skill=='AHfa' then
return 'Y0GS'
elseif skill=='A0LZ' then
return 'Y0GT'
elseif skill=='A0OI' or skill=='X0OI' then
return 'Y0GU'
elseif skill=='A0QN' then
return 'Y0GV'
elseif skill=='A0DY' then
return 'Y0GI'
elseif skill=='A1WB' then
return 'Y0GN'
endif
if clone!=0 then
return clone
endif
return skill
endfunction
function SuijiMode_IsFixedClone takes integer skill returns boolean
return LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)!=0
endfunction
function SuijiMode_GetGrantSkill takes integer logicalSkill returns integer
// Scripted orbs always use non-clickable passive physical abilities.  Do this
// before the generated-clone policy so no initialization-order path can expose
// the original autocast button.
if logicalSkill=='A026' or logicalSkill=='A2ZJ' or logicalSkill=='A09V' or logicalSkill=='A4HO' or logicalSkill=='AHfa' or logicalSkill=='A0LZ' or logicalSkill=='A0OI' or logicalSkill=='X0OI' or logicalSkill=='A0QN' or logicalSkill=='A0DY' or logicalSkill=='A1WB' then
return SuijiMode_ToFixedClone(logicalSkill)
endif
if logicalSkill=='A2NE' then
return SuijiMode_ToFixedClone(logicalSkill)
endif
if B287_ShouldUseFixedClone(logicalSkill) then
return SuijiMode_ToFixedClone(logicalSkill)
endif
return logicalSkill
endfunction
function SuijiMode_GetPhysicalSkill takes unit u,integer logicalSkill returns integer
local integer cloneSkill=SuijiMode_ToFixedClone(logicalSkill)
if u!=null and GetUnitTypeId(u)!=0 then
if LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)!=0 and GetUnitAbilityLevel(u,LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill))>0 then
return LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)
endif
if logicalSkill=='A0SW' and GetUnitAbilityLevel(u,'YIF1')>0 then
return 'YIF1'
elseif logicalSkill=='A4FR' and GetUnitAbilityLevel(u,'YIF2')>0 then
return 'YIF2'
endif
endif
if u!=null and GetUnitTypeId(u)!=0 and cloneSkill!=logicalSkill and GetUnitAbilityLevel(u,cloneSkill)>0 then
return cloneSkill
endif
return logicalSkill
endfunction
function SuijiMode_IsInstantOrderCarrier takes integer logicalSkill returns boolean
set logicalSkill=SuijiMode_ToOriginalSkill(logicalSkill)
if logicalSkill=='A14I' then
return true
endif
if logicalSkill=='A020' or logicalSkill=='A06V' or logicalSkill=='A06W' then
return true
endif
return logicalSkill=='A0DH' or logicalSkill=='A1OB' or logicalSkill=='A0GP' or logicalSkill=='A14P' or logicalSkill=='A2KU' or logicalSkill=='A00J' or logicalSkill=='A4K2' or logicalSkill=='A2FK' or logicalSkill=='A6L1' or logicalSkill=='A6L2' or logicalSkill=='A6L3'
endfunction
function SuijiMode_IsEngineInstantOrderCarrier takes integer logicalSkill returns boolean
set logicalSkill=SuijiMode_ToOriginalSkill(logicalSkill)
if logicalSkill=='A14I' then
return true
endif
if logicalSkill=='A020' or logicalSkill=='A06V' or logicalSkill=='A06W' then
return true
endif
return logicalSkill=='A0DH' or logicalSkill=='A1OB' or logicalSkill=='A0GP' or logicalSkill=='A14P' or logicalSkill=='A2KU' or logicalSkill=='A00J' or logicalSkill=='A4K2' or logicalSkill=='A2FK'
endfunction
function SuijiMode_ClearInstantResumeOrder takes unit resumeUnit returns nothing
local integer resumeUnitHandle=0
if resumeUnit==null then
return
endif
set resumeUnitHandle=GetHandleId(resumeUnit)
call SaveInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderType"),0)
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),false)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),0.)
call RemoveSavedHandle(L7,resumeUnitHandle,StringHash("SuijiInstantResumeTarget"))
set resumeUnit=null
endfunction
function SuijiMode_InstantResumeOnTrackedOrder takes nothing returns boolean
local real b1060GetOrderPointX=GetOrderPointX()
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local unit resumeUnit=GetTriggerUnit()
local unit resumeTarget=null
local integer resumeUnitHandle=0
local integer resumeOrder=GetIssuedOrderId()
local integer resumeType=0
local real resumeX=0.
local real resumeY=0.
local real resumeDX=0.
local real resumeDY=0.
if resumeUnit==null or GetUnitTypeId(resumeUnit)==0 then
set resumeUnit=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set resumeUnitHandle=GetHandleId(resumeUnit)
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER and (resumeOrder==851971 or resumeOrder==851986) then
call SaveInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderType"),1)
call SaveInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderId"),resumeOrder)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeX"),b1060GetOrderPointX)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeY"),b1060GetOrderPointY)
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),false)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),0.)
call RemoveSavedHandle(L7,resumeUnitHandle,StringHash("SuijiInstantResumeTarget"))
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER and (resumeOrder==851971 or resumeOrder==851983) then
set resumeTarget=b1060GetOrderTargetUnit
if resumeTarget!=null and GetUnitTypeId(resumeTarget)!=0 then
call SaveInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderType"),2)
call SaveInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderId"),resumeOrder)
call SaveUnitHandle(L7,resumeUnitHandle,StringHash("SuijiInstantResumeTarget"),resumeTarget)
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),false)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),0.)
else
call SuijiMode_ClearInstantResumeOrder(resumeUnit)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER and (resumeOrder==OrderId("creepdevour") or resumeOrder==OrderId("web")) then
if OO7(resumeUnitHandle,"SuijiMulticastCasting") or OO7(resumeUnitHandle,"LotusReflecting") then
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),false)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),0.)
else
set resumeType=LoadInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderType"))
if resumeType==1 then
set resumeX=LoadReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeX"))
set resumeY=LoadReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeY"))
set resumeDX=resumeX-GetUnitX(resumeUnit)
set resumeDY=resumeY-GetUnitY(resumeUnit)
if resumeDX*resumeDX+resumeDY*resumeDY>4096. then
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),true)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),TimerGetElapsed(W)+.50)
else
call SuijiMode_ClearInstantResumeOrder(resumeUnit)
endif
elseif resumeType==2 then
set resumeTarget=LoadUnitHandle(L7,resumeUnitHandle,StringHash("SuijiInstantResumeTarget"))
if resumeTarget!=null and GetUnitTypeId(resumeTarget)!=0 and UnitAlive(resumeTarget) then
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),true)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),TimerGetElapsed(W)+.50)
else
call SuijiMode_ClearInstantResumeOrder(resumeUnit)
endif
else
call SuijiMode_ClearInstantResumeOrder(resumeUnit)
endif
endif
else
call SuijiMode_ClearInstantResumeOrder(resumeUnit)
endif
set resumeTarget=null
set resumeUnit=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SuijiMode_RegisterInstantResumeOrderTracking takes unit resumeUnit returns nothing
local integer resumePlayerId=0
local trigger resumeOrderTrigger=null
if resumeUnit==null or GetUnitTypeId(resumeUnit)==0 or GetPlayerController(GetOwningPlayer(resumeUnit))!=MAP_CONTROL_USER then
set resumeUnit=null
return
endif
set resumePlayerId=GetPlayerId(GetOwningPlayer(resumeUnit))
if SUIJI_INSTANT_RESUME_ORDER_UNIT[resumePlayerId]==resumeUnit and SUIJI_INSTANT_RESUME_ORDER_TRIGGER[resumePlayerId]!=null then
set resumeUnit=null
return
endif
if SUIJI_INSTANT_RESUME_ORDER_TRIGGER[resumePlayerId]!=null then
call OZ7(SUIJI_INSTANT_RESUME_ORDER_TRIGGER[resumePlayerId])
endif
set resumeOrderTrigger=CreateTrigger()
call TriggerRegisterUnitEvent(resumeOrderTrigger,resumeUnit,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(resumeOrderTrigger,resumeUnit,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(resumeOrderTrigger,resumeUnit,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(resumeOrderTrigger,Condition(function SuijiMode_InstantResumeOnTrackedOrder))
set SUIJI_INSTANT_RESUME_ORDER_TRIGGER[resumePlayerId]=resumeOrderTrigger
set SUIJI_INSTANT_RESUME_ORDER_UNIT[resumePlayerId]=resumeUnit
set resumeOrderTrigger=null
set resumeUnit=null
endfunction
function SuijiMode_InstantResumeDelayed takes nothing returns nothing
local timer resumeTimer=GetExpiredTimer()
local integer resumeTimerHandle=GetHandleId(resumeTimer)
local unit resumeUnit=LoadUnitHandle(L7,resumeTimerHandle,0)
local unit resumeTarget=null
local integer resumeUnitHandle=0
local integer resumeExpectedOrder=LoadInteger(L7,resumeTimerHandle,1)
local integer resumeCurrentOrder=0
local integer resumeType=0
local integer resumeOrder=0
local real resumeX=0.
local real resumeY=0.
local real resumeDX=0.
local real resumeDY=0.
if resumeUnit!=null and GetUnitTypeId(resumeUnit)!=0 and UnitAlive(resumeUnit) and IsUnitPaused(resumeUnit)==false and GetPlayerController(GetOwningPlayer(resumeUnit))==MAP_CONTROL_USER then
set resumeUnitHandle=GetHandleId(resumeUnit)
if OO7(resumeUnitHandle,"SuijiMulticastCasting")==false and OO7(resumeUnitHandle,"LotusReflecting")==false then
set resumeCurrentOrder=GetUnitCurrentOrder(resumeUnit)
if resumeCurrentOrder==0 or resumeCurrentOrder==resumeExpectedOrder then
set resumeType=LoadInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderType"))
set resumeOrder=LoadInteger(L7,resumeUnitHandle,StringHash("SuijiInstantResumeOrderId"))
if resumeType==1 and (resumeOrder==851971 or resumeOrder==851986) then
set resumeX=LoadReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeX"))
set resumeY=LoadReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumeY"))
set resumeDX=resumeX-GetUnitX(resumeUnit)
set resumeDY=resumeY-GetUnitY(resumeUnit)
if resumeDX*resumeDX+resumeDY*resumeDY>4096. then
call B947IssuePointOrderById("SuijiMode_InstantResumeDelayed @ war3map.j:191595 (B968)",resumeUnit,resumeOrder,resumeX,resumeY)
endif
elseif resumeType==2 and (resumeOrder==851971 or resumeOrder==851983) then
set resumeTarget=LoadUnitHandle(L7,resumeUnitHandle,StringHash("SuijiInstantResumeTarget"))
if resumeTarget!=null and GetUnitTypeId(resumeTarget)!=0 and UnitAlive(resumeTarget) then
call B947IssueTargetOrderById("SuijiMode_InstantResumeDelayed @ war3map.j:191600 (B968)",resumeUnit,resumeOrder,resumeTarget)
endif
endif
endif
endif
endif
call FlushChildHashtable(L7,resumeTimerHandle)
call PauseTimer(resumeTimer)
call DestroyTimer(resumeTimer)
set resumeTarget=null
set resumeUnit=null
set resumeTimer=null
endfunction
function SuijiMode_InstantResumeOnEffect takes nothing returns boolean
local unit resumeUnit=GetTriggerUnit()
local timer resumeTimer=null
local integer resumeTimerHandle=0
local integer resumeUnitHandle=0
local integer resumeSkill=B287_GetSpellAbilityId()
if resumeUnit==null or (resumeSkill!='A0GP' and resumeSkill!='A2FK') or GetUnitTypeId(resumeUnit)==0 or GetPlayerController(GetOwningPlayer(resumeUnit))!=MAP_CONTROL_USER then
set resumeUnit=null
return false
endif
set resumeUnitHandle=GetHandleId(resumeUnit)
if OO7(resumeUnitHandle,"SuijiInstantResumePending") and ON7(resumeUnitHandle,"SuijiInstantResumePendingUntil")>=TimerGetElapsed(W) and OO7(resumeUnitHandle,"SuijiMulticastCasting")==false and OO7(resumeUnitHandle,"LotusReflecting")==false then
call SaveBoolean(L7,resumeUnitHandle,StringHash("SuijiInstantResumePending"),false)
call SaveReal(L7,resumeUnitHandle,StringHash("SuijiInstantResumePendingUntil"),0.)
set resumeTimer=CreateTimer()
set resumeTimerHandle=GetHandleId(resumeTimer)
call SaveUnitHandle(L7,resumeTimerHandle,0,resumeUnit)
call SaveInteger(L7,resumeTimerHandle,1,GetUnitCurrentOrder(resumeUnit))
call TimerStart(resumeTimer,0.,false,function SuijiMode_InstantResumeDelayed)
set resumeTimer=null
endif
set resumeUnit=null
return false
endfunction
function SuijiMode_EngineInstantCastpointDelayed takes nothing returns nothing
local timer instantCastTimer=GetExpiredTimer()
local integer instantCastHandle=GetHandleId(instantCastTimer)
local unit instantCastUnit=LoadUnitHandle(L7,instantCastHandle,0)
local integer instantCastLogical=LoadInteger(L7,instantCastHandle,1)
local integer instantCastPhysical=0
local ability instantCastAbility=null
if instantCastUnit!=null and GetUnitTypeId(instantCastUnit)!=0 and SuijiMode_IsEngineInstantOrderCarrier(instantCastLogical) then
set instantCastPhysical=SuijiMode_GetPhysicalSkill(instantCastUnit,instantCastLogical)
if instantCastPhysical!=0 and GetUnitAbilityLevel(instantCastUnit,instantCastPhysical)>0 and (instantCastLogical!='A14I' or instantCastPhysical=='YE1I') then
set instantCastAbility=EXGetUnitAbility(instantCastUnit,instantCastPhysical)
if instantCastAbility!=null then
if instantCastLogical=='A0DH' or instantCastLogical=='A1OB' or instantCastLogical=='A0GP' or instantCastLogical=='A14P' or instantCastLogical=='A020' or instantCastLogical=='A06V' or instantCastLogical=='A06W' or instantCastPhysical=='YE1I' then
call SuijiMode_SetExactLiveAbilityCastpoint(instantCastUnit,instantCastPhysical,0.)
call MHAbility_SetCastpoint(instantCastUnit,instantCastPhysical,0.)
else
call SuijiMode_SetExactLiveAbilityCastpoint(instantCastUnit,instantCastPhysical,.01)
endif
endif
endif
endif
call FlushChildHashtable(L7,instantCastHandle)
call PauseTimer(instantCastTimer)
call DestroyTimer(instantCastTimer)
set instantCastAbility=null
set instantCastUnit=null
set instantCastTimer=null
endfunction
function SuijiMode_ScheduleEngineInstantCastpoint takes unit instantCastSource,integer instantCastSkill returns nothing
local timer instantCastTimer=null
local integer instantCastHandle=0
local integer instantCastPhysical=0
if instantCastSource==null or GetUnitTypeId(instantCastSource)==0 then
return
endif
set instantCastSkill=SuijiMode_ToOriginalSkill(instantCastSkill)
if SuijiMode_IsEngineInstantOrderCarrier(instantCastSkill)==false then
return
endif
set instantCastPhysical=SuijiMode_GetPhysicalSkill(instantCastSource,instantCastSkill)
if instantCastPhysical==0 or GetUnitAbilityLevel(instantCastSource,instantCastPhysical)<=0 then
return
endif
if instantCastSkill=='A14I' and instantCastPhysical!='YE1I' then
return
endif
set instantCastTimer=CreateTimer()
set instantCastHandle=GetHandleId(instantCastTimer)
call SaveUnitHandle(L7,instantCastHandle,0,instantCastSource)
call SaveInteger(L7,instantCastHandle,1,instantCastSkill)
call TimerStart(instantCastTimer,.05,false,function SuijiMode_EngineInstantCastpointDelayed)
set instantCastTimer=null
endfunction
function SuijiMode_ApplyInstantOrderCarrierCastpoint takes unit u,integer logicalSkill returns nothing
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set logicalSkill=SuijiMode_ToOriginalSkill(logicalSkill)
if SuijiMode_IsInstantOrderCarrier(logicalSkill)==false then
return
endif
set physicalSkill=SuijiMode_GetPhysicalSkill(u,logicalSkill)
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return
endif
if logicalSkill=='A14I' and physicalSkill!='YE1I' then
return
endif
if logicalSkill=='A0DH' or logicalSkill=='A1OB' or logicalSkill=='A0GP' or logicalSkill=='A14P' or logicalSkill=='A020' or logicalSkill=='A06V' or logicalSkill=='A06W' or physicalSkill=='YE1I' then
call SuijiMode_SetExactLiveAbilityCastpoint(u,physicalSkill,0.)
call MHAbility_SetCastpoint(u,physicalSkill,0.)
else
call SuijiMode_SetExactLiveAbilityCastpoint(u,physicalSkill,.01)
endif
call SuijiMode_ScheduleEngineInstantCastpoint(u,logicalSkill)
if logicalSkill=='A0GP' or logicalSkill=='A2FK' then
call SuijiMode_RegisterInstantResumeOrderTracking(u)
endif
endfunction
function SuijiMode_ApplyAllInstantOrderCarrierCastpoints takes unit u returns nothing
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A14I')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A020')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A06V')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A06W')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A0DH')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A1OB')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A0GP')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A14P')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A2KU')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A00J')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A4K2')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A2FK')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A6L1')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A6L2')
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,'A6L3')
endfunction
function SuijiMode_InstantOrderCarrierOnLearn takes nothing returns boolean
call SuijiMode_ApplyInstantOrderCarrierCastpoint(GetTriggerUnit(),B287_GetLearnedSkill())
return false
endfunction
function SuijiMode_InstantOrderCarrierInit takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function SuijiMode_InstantOrderCarrierOnLearn))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiMode_InstantResumeOnEffect))
set t=null
endfunction
function SuijiMode_DebugBoolText takes boolean value returns string
if value then
return "1"
endif
return "0"
endfunction
function SuijiMode_HasChosenBite takes unit u returns boolean
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if SUIJI_UNIFIED_ORB_PASSIVE then
return true
endif
set h=GetHandleId(u)
return OM7(h,"SuijiSmallSkill")=='A0BK' or OM7(h,"SuijiUltSkill")=='A0BK'
endfunction
function SuijiMode_DebugIllusionBiteState takes unit source,unit illusion,string tag returns nothing
local unit ownerHero=null
if SUIJI_LOG==false or illusion==null or GetUnitTypeId(illusion)==0 then
return
endif
if source==null or GetUnitTypeId(source)==0 then
set ownerHero=M7[GetPlayerId(GetOwningPlayer(illusion))]
set source=ownerHero
endif
if source!=null and GetUnitTypeId(source)!=0 and SuijiMode_HasChosenBite(source) then
call SuijiTest_DebugAll(tag,"illu="+GetUnitName(illusion)+" ill="+SuijiMode_DebugBoolText(IsUnitIllusion(illusion))+" src="+GetUnitName(source)+" srcA0BK="+I2S(B287_GetUnitAbilityLevel(source,'A0BK'))+" y03q="+I2S(GetUnitAbilityLevel(illusion,'Y03Q'))+" logical="+I2S(B287_GetUnitAbilityLevel(illusion,'A0BK'))+" copied="+SuijiMode_DebugBoolText(OO7(GetHandleId(illusion),"SuijiIllusionPassivesCopied")))
endif
set ownerHero=null
endfunction
function SuijiMode_IsIllusionPassiveCopyExcluded takes integer skill returns boolean
set skill=SuijiMode_ToOriginalSkill(skill)
return skill=='A01Y' or skill=='A4KM'
endfunction
function SuijiMode_RemoveIllusionReincarnation takes unit target returns nothing
local integer targetHandle=0
local trigger deathTrigger=null
local trigger legacyTrigger=null
local timer cooldownGuard=null
if target==null or GetUnitTypeId(target)==0 or IsUnitIllusion(target)==false then
return
endif
set targetHandle=GetHandleId(target)
set deathTrigger=LoadTriggerHandle(L7,targetHandle,StringHash("SuijiReincarnationDeathTrigger"))
set legacyTrigger=LoadTriggerHandle(L7,targetHandle,'A01Y')
call RemoveSavedHandle(L7,targetHandle,StringHash("SuijiReincarnationDeathTrigger"))
call RemoveSavedHandle(L7,targetHandle,'A01Y')
if deathTrigger!=null then
call NM7(GetHandleId(deathTrigger))
call OZ7(deathTrigger)
endif
if legacyTrigger!=null and legacyTrigger!=deathTrigger then
call NM7(GetHandleId(legacyTrigger))
call OZ7(legacyTrigger)
endif
set cooldownGuard=LoadTimerHandle(L7,targetHandle,StringHash("SuijiReincarnationCooldownGuard"))
call RemoveSavedHandle(L7,targetHandle,StringHash("SuijiReincarnationCooldownGuard"))
if cooldownGuard!=null then
call FlushChildHashtable(L7,GetHandleId(cooldownGuard))
call PauseTimer(cooldownGuard)
call DestroyTimer(cooldownGuard)
endif
call RemoveSavedBoolean(L7,targetHandle,StringHash("SuijiA01YInit"))
call RemoveSavedReal(L7,targetHandle,StringHash("SuijiReincarnationReadyAt"))
call RemoveSavedReal(L7,targetHandle,StringHash("SuijiReincarnationCooldownDuration"))
call UnitRemoveAbility(target,'A01Y')
call UnitRemoveAbility(target,'A4KM')
call UnitRemoveAbility(target,'Y0BA')
call UnitRemoveAbility(target,'Y0FQ')
set deathTrigger=null
set legacyTrigger=null
set cooldownGuard=null
endfunction
function SuijiMode_CopyChosenPassiveSkill takes unit source,unit target,string mark returns nothing
local integer sourceHandle=0
local integer targetHandle=0
local integer skill=0
local integer abilityId=0
local integer helper=0
local integer skillSource=0
local integer level=0
local string order=""
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return
endif
set sourceHandle=GetHandleId(source)
set targetHandle=GetHandleId(target)
set skill=OM7(sourceHandle,mark+"Skill")
set abilityId=OM7(sourceHandle,mark+"Ability")
set helper=OM7(sourceHandle,mark+"Helper")
set skillSource=OM7(sourceHandle,mark+"Source")
set order=OP7(sourceHandle,mark+"Order")
if skill==0 then
return
endif
if SuijiMode_IsIllusionPassiveCopyExcluded(skill) then
call SuijiMode_RemoveIllusionReincarnation(target)
return
endif
if abilityId==0 then
set abilityId=SuijiMode_GetPhysicalSkill(source,skill)
endif
if abilityId==0 or SuijiMode_HasNativeAbility(source,abilityId)==false then
return
endif
if B287_MHAbility_IsPassive(source,abilityId)==false then
return
endif
set level=GetUnitAbilityLevel(source,abilityId)
if SuijiMode_EnsureExactLiveAbilityLevel(target,abilityId,level,true)==false then
return
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(target),abilityId,true)
// Illusions are separate unit handles.  The ability rawcode and level can be
// copied while the MH per-unit command-card data is still left behind.
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_BUTTON_X,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_BUTTON_X))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_BUTTON_Y,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_BUTTON_Y))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_UNBUTTON_X,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_UNBUTTON_X))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_UNBUTTON_Y,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_UNBUTTON_Y))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_HOTKEY,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_HOTKEY))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_UNHOTKEY,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_UNHOTKEY))
call MHAbility_SetCustomDataInt(target,abilityId,ABILITY_DEF_DATA_RESEARCH_HOTKEY,B287_MHAbility_GetCustomDataInt(source,abilityId,ABILITY_DEF_DATA_RESEARCH_HOTKEY))
call SuijiMode_InitCopiedSkill(target,skill,level)
call NP7(targetHandle,mark+"Skill",skill)
call NP7(targetHandle,mark+"Ability",abilityId)
call NP7(targetHandle,mark+"Helper",helper)
call NP7(targetHandle,mark+"Source",skillSource)
call NP7(targetHandle,mark+"SourceType",K34[skillSource])
call NR7(targetHandle,mark+"Order",order)
if skill=='A0BK' and IsUnitIllusion(target) then
call SuijiMode_DebugIllusionBiteState(source,target,"ILLBITE-COPY")
endif
endfunction
function SuijiMode_IsChosenPassiveSkillCopied takes unit source,unit target,string mark returns boolean
local integer sourceHandle=0
local integer skill=0
local integer abilityId=0
local integer level=0
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return false
endif
set sourceHandle=GetHandleId(source)
set skill=OM7(sourceHandle,mark+"Skill")
if skill==0 then
return true
endif
if SuijiMode_IsIllusionPassiveCopyExcluded(skill) then
call SuijiMode_RemoveIllusionReincarnation(target)
return true
endif
set abilityId=OM7(sourceHandle,mark+"Ability")
if abilityId==0 then
set abilityId=SuijiMode_GetPhysicalSkill(source,skill)
endif
if abilityId==0 or SuijiMode_HasNativeAbility(source,abilityId)==false then
return false
endif
if B287_MHAbility_IsPassive(source,abilityId)==false then
return true
endif
set level=GetUnitAbilityLevel(source,abilityId)
if SuijiMode_HasNativeAbility(target,abilityId)==false or GetUnitAbilityLevel(target,abilityId)!=level then
return false
endif
return true
endfunction
function SuijiMode_CopyChosenPassivesToUnit takes unit source,unit target returns nothing
call SuijiMode_CopyChosenPassiveSkill(source,target,"SuijiSmall")
call SuijiMode_CopyChosenPassiveSkill(source,target,"SuijiUlt")
endfunction
function SuijiMode_IsDruidBearSharedPassive takes integer skill returns boolean
return skill=='A03P' or skill=='A0O0' or skill=='A0SS' or skill=='A1CD' or skill=='A081' or skill=='A03N' or skill=='ANic' or skill=='A2EY' or skill=='A0MG' or skill=='A022'
endfunction
function SuijiMode_ClearDruidBearSharedPassive takes unit bear,integer skill returns nothing
local integer cloneSkill=0
if bear==null or GetUnitTypeId(bear)==0 or skill==0 then
return
endif
set cloneSkill=SuijiMode_ToFixedClone(skill)
call UnitRemoveAbility(bear,skill)
if cloneSkill!=skill then
call UnitRemoveAbility(bear,cloneSkill)
endif
endfunction
function SuijiMode_CopyDruidPassivesToBear takes unit source returns nothing
local unit bear=null
local integer sourceHandle=0
local integer smallSkill=0
local integer ultSkill=0
if source==null or GetUnitTypeId(source)==0 then
return
endif
set bear=O77(GetHandleId(GetOwningPlayer(source)),"MyBear")
set sourceHandle=GetHandleId(source)
set smallSkill=OM7(sourceHandle,"SuijiSmallSkill")
set ultSkill=OM7(sourceHandle,"SuijiUltSkill")
call SuijiMode_ClearDruidBearSharedPassive(bear,'A03P')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A0O0')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A0SS')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A1CD')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A081')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A03N')
call SuijiMode_ClearDruidBearSharedPassive(bear,'ANic')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A2EY')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A0MG')
call SuijiMode_ClearDruidBearSharedPassive(bear,'A022')
if SuijiMode_IsDruidBearSharedPassive(smallSkill) then
call SuijiMode_CopyChosenPassiveSkill(source,bear,"SuijiSmall")
endif
if SuijiMode_IsDruidBearSharedPassive(ultSkill) then
call SuijiMode_CopyChosenPassiveSkill(source,bear,"SuijiUlt")
endif
set bear=null
endfunction
function SuijiMode_RefreshDruidBearPassives takes nothing returns nothing
local integer playerId=0
local unit hero=null
loop
exitwhen playerId>11
set hero=M7[playerId]
if hero!=null and GetUnitTypeId(hero)!=0 and SUIJI_MODE and OO7(GetHandleId(hero),"SuijiDone") then
call SuijiMode_CopyDruidPassivesToBear(hero)
endif
set hero=null
set playerId=playerId+1
endloop
endfunction
function SuijiMode_CopyChosenPassivesToIllusion takes unit source,unit illusion returns boolean
local unit heroSource=null
local boolean smallCopied=false
local boolean ultCopied=false
if illusion==null or GetUnitTypeId(illusion)==0 or IsUnitIllusion(illusion)==false then
return false
endif
if OO7(GetHandleId(illusion),"SuijiIllusionPassivesCopied") then
return true
endif
// Dummy casters frequently create Dota illusions.  The summoning unit is not
// a reliable skill source; the owning player's stable hero is.
set heroSource=M7[GetPlayerId(GetOwningPlayer(illusion))]
if heroSource!=null and GetUnitTypeId(heroSource)!=0 and OO7(GetHandleId(heroSource),"SuijiDone") then
set source=heroSource
endif
if SUIJI_MODE and source!=null and GetUnitTypeId(source)!=0 and OO7(GetHandleId(source),"SuijiDone") then
call SuijiMode_DebugIllusionBiteState(source,illusion,"ILLBITE-START")
call SuijiMode_CopyChosenPassivesToUnit(source,illusion)
set smallCopied=SuijiMode_IsChosenPassiveSkillCopied(source,illusion,"SuijiSmall")
set ultCopied=SuijiMode_IsChosenPassiveSkillCopied(source,illusion,"SuijiUlt")
if smallCopied and ultCopied then
call NS7(GetHandleId(illusion),"SuijiIllusionPassivesCopied",true)
call SuijiMode_DebugIllusionBiteState(source,illusion,"ILLBITE-DONE")
set heroSource=null
return true
endif
endif
set heroSource=null
return false
endfunction
function B1111SyncLogIllusion takes unit syncSource1111,unit syncIllusion1111,integer syncAttempt1111,boolean syncFinished1111 returns nothing
if not B1111SyncLogEnabled or GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER or B1111SyncLogIllusionCount>=24 then
return
endif
set B1111SyncLogIllusionCount=B1111SyncLogIllusionCount+1
call B1111SyncLogAppend("ILLUSION t="+R2S(TimerGetElapsed(W))+" source="+I2S(GetHandleId(syncSource1111))+" source_type="+I2S(GetUnitTypeId(syncSource1111))+" illusion="+I2S(GetHandleId(syncIllusion1111))+" illusion_type="+I2S(GetUnitTypeId(syncIllusion1111))+" attempt="+I2S(syncAttempt1111)+" finished="+I2S(B287_BoolToInt(syncFinished1111))+" copied="+I2S(B287_BoolToInt(OO7(GetHandleId(syncIllusion1111),"SuijiIllusionPassivesCopied"))))
endfunction
function SuijiMode_InheritIllusionPassivesDelayed takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit source=LoadUnitHandle(L7,h,0)
local unit illusion=LoadUnitHandle(L7,h,1)
local integer attempt=LoadInteger(L7,h,2)
local boolean finished=false
if illusion==null or GetUnitTypeId(illusion)==0 then
set finished=true
elseif IsUnitIllusion(illusion) then
set finished=SuijiMode_CopyChosenPassivesToIllusion(source,illusion)
call SuijiMode_DebugIllusionBiteState(source,illusion,"ILLBITE-TICK"+I2S(attempt))
endif
if B1111SyncLogEnabled then
call B1111SyncLogIllusion(source,illusion,attempt,finished)
endif
if finished==false and attempt<8 then
call SaveInteger(L7,h,2,attempt+1)
call TimerStart(t,0.10,false,function SuijiMode_InheritIllusionPassivesDelayed)
set source=null
set illusion=null
set t=null
return
endif
if illusion!=null and GetUnitTypeId(illusion)!=0 then
call NS7(GetHandleId(illusion),"SuijiIllusionInheritanceQueued",false)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set source=null
set illusion=null
set t=null
endfunction
function SuijiMode_QueueIllusionPassiveInheritance takes unit source,unit illusion returns nothing
local timer t=null
local integer h=0
if illusion==null or GetUnitTypeId(illusion)==0 or IsUnitType(illusion,UNIT_TYPE_HERO)==false then
return
endif
if OO7(GetHandleId(illusion),"SuijiIllusionPassivesCopied") or OO7(GetHandleId(illusion),"SuijiIllusionInheritanceQueued") then
return
endif
call NS7(GetHandleId(illusion),"SuijiIllusionInheritanceQueued",true)
call SuijiMode_DebugIllusionBiteState(source,illusion,"ILLBITE-QUEUE")
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,source)
call SaveUnitHandle(L7,h,1,illusion)
call SaveInteger(L7,h,2,0)
call TimerStart(t,0.10,false,function SuijiMode_InheritIllusionPassivesDelayed)
set t=null
endfunction
function SuijiMode_InheritIllusionPassives takes nothing returns boolean
local unit summoner=GetSummoningUnit()
local unit illusion=GetSummonedUnit()
local unit source=summoner
local unit linkedSource=null
if summoner!=null then
set linkedSource=O77(GetHandleId(summoner),"SuijiIllusionSource")
if linkedSource!=null and GetUnitTypeId(linkedSource)!=0 then
set source=linkedSource
endif
endif
if source==null and illusion!=null and GetUnitTypeId(illusion)!=0 then
set source=M7[GetPlayerId(GetOwningPlayer(illusion))]
endif
call SuijiMode_QueueIllusionPassiveInheritance(source,illusion)
set linkedSource=null
set source=null
set summoner=null
set illusion=null
return false
endfunction
function SuijiMode_InheritIllusionPassivesOnEnter takes nothing returns boolean
local unit illusion=GetEnteringUnit()
local unit source=null
local integer playerId=0
if SUIJI_MODE and illusion!=null and GetUnitTypeId(illusion)!=0 and IsUnitType(illusion,UNIT_TYPE_HERO) then
set playerId=GetPlayerId(GetOwningPlayer(illusion))
if playerId>=0 and playerId<=11 then
set source=M7[playerId]
if source!=null and GetUnitTypeId(source)!=0 and source!=illusion and OO7(GetHandleId(source),"SuijiDone") then
call SuijiMode_QueueIllusionPassiveInheritance(source,illusion)
call SuijiMode_DebugIllusionBiteState(source,illusion,"ILLBITE-ENTER")
endif
endif
endif
set source=null
set illusion=null
return false
endfunction
function SuijiMode_IllusionPassiveInit takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger enterTrigger=CreateTrigger()
// Fixed common initialization, independent of live ability classification.
call RegisterUnitAttackEvent("SuijiMode_IllusionPassiveAttackFallback",0)
call YB7(t,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddCondition(t,Condition(function SuijiMode_InheritIllusionPassives))
call TriggerRegisterEnterRectSimple(enterTrigger,GetWorldBounds())
call TriggerAddCondition(enterTrigger,Condition(function SuijiMode_InheritIllusionPassivesOnEnter))
set t=null
set enterTrigger=null
endfunction
function SuijiMode_HasLogicalAbility takes unit u,integer logicalSkill returns boolean
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return false
endif
return GetUnitAbilityLevel(u,SuijiMode_GetPhysicalSkill(u,logicalSkill))>0
endfunction
function SuijiMode_GetLogicalAbilityLevel takes unit u,integer logicalSkill returns integer
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return 0
endif
return GetUnitAbilityLevel(u,SuijiMode_GetPhysicalSkill(u,logicalSkill))
endfunction
function SuijiMode_SetLogicalAbilityLevel takes unit u,integer logicalSkill,integer level returns nothing
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 or level<=0 then
return
endif
set physicalSkill=SuijiMode_GetPhysicalSkill(u,logicalSkill)
if SuijiMode_HasNativeAbility(u,physicalSkill) and GetUnitAbilityLevel(u,physicalSkill)!=level and SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,level) then
if logicalSkill=='A4DJ' or logicalSkill=='A4DZ' then
call Reset_Skill_range(u)
endif
endif
endfunction
function SuijiMode_GetLogicalCooldown takes unit u,integer logicalSkill returns real
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return 0.
endif
return B582_GetAbilityCooldown(u,SuijiMode_GetPhysicalSkill(u,logicalSkill))
endfunction
function SuijiMode_SetLogicalCooldown takes unit u,integer logicalSkill,real cooldown returns boolean
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return false
endif
return MHAbility_SetCooldown(u,SuijiMode_GetPhysicalSkill(u,logicalSkill),cooldown)
endfunction
function SuijiMode_GetStoredPhysicalSkill takes unit u,string mark returns integer
local integer h=0
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set physicalSkill=OM7(h,mark+"Ability")
if physicalSkill==0 then
set physicalSkill=SuijiMode_GetPhysicalSkill(u,OM7(h,mark+"Skill"))
endif
return physicalSkill
endfunction
function SuijiMode_RandomOrder takes integer skill,string sourceOrder returns string
set skill=SuijiMode_ToOriginalSkill(skill)
if skill=='A035' then
return "fanofknives"
endif
if skill=='A14I' or skill=='A21F' or skill=='A21G' then
return "berserk"
endif
if skill=='A0MP' then
return "passive"
endif
// The unified random-orb physical faces are non-clickable passive carriers.
// Compare that final carrier class instead of their historical autocast orders.
if skill=='A026' or skill=='A2ZJ' or skill=='A09V' or skill=='A4HO' or skill=='A0DY' or skill=='A1WB' or skill=='AHfa' or skill=='A0LZ' or skill=='A0OI' or skill=='X0OI' or skill=='A0QN' then
return "passive"
elseif skill=='A004' then
return "fingerofdeath"
elseif skill=='A0MT' then
return "disenchant"
elseif skill=='A29L' then
return "resurrection"
elseif skill=='A0WQ' then
return "divineshield"
elseif skill=='A1YQ' then
return "magicdefense"
elseif skill=='A2O6' or skill=='A2ZG' then
return "recharge"
elseif skill=='A4HK' then
return "dispel"
elseif skill=='A2BG' or skill=='A2SA' then
return "earthquake"
elseif skill=='A2IS' then
return "frenzy"
elseif skill=='A2H3' then
return "polymorph"
elseif skill=='A2H0' then
// Row 124 says berserk, but the live ACbz command is clusterrockets.
return "clusterrockets"
elseif skill=='A2IT' then
return "invisibility"
elseif skill=='A2FK' then
return "web"
elseif skill=='A0DH' or skill=='A1OB' then
return "creepanimatedead"
elseif skill=='A0GP' then
return "creepdevour"
elseif skill=='A14P' then
return "replenish"
elseif skill=='A2KU' then
return "controlmagic"
elseif skill=='A2NE' then
return "berserk"
elseif skill=='A0QE' then
return "unholyfrenzy"
elseif skill=='A01F' or skill=='A02S' or skill=='A4FJ' then
return "carrionswarm"
endif
// These generated fixed clones deliberately use a different command carrier
// from their logical source ability.  Tavern compatibility must compare the
// live carrier order, not the historical pool order, or it both rejects safe
// combinations and permits real command collisions.
if skill=='A0IL' or skill=='A0LL' or skill=='A0NB' or skill=='A0NO' or skill=='A0OK' or skill=='A0S8' or skill=='A0Z6' or skill=='A14L' or skill=='A15S' or skill=='A1E9' or skill=='A1HS' or skill=='A1QP' or skill=='A1SB' or skill=='A1SU' or skill=='A1T5' or skill=='A1VW' or skill=='A235' then
return "flare"
elseif skill=='A0KV' then
return "carrionswarm"
elseif skill=='A0BZ' then
return "flare"
elseif skill=='A1J7' then
return "tornado"
elseif skill=='A1P9' then
// The established one-shot hook makes the Absk carrier use battleroar.
return "battleroar"
elseif skill=='A064' then
// The hidden random bridge is Channel, but the one visible charge owner is the
// existing Blizzard-class charge face. Preserve the B456/B541 lifecycle.
return "blizzard"
elseif skill=='A0M1' or skill=='A1AX' then
// Omnislash and its Scepter form both use the Heal-class command carrier.
return "heal"
elseif skill=='A01P' or skill=='A09Z' then
// Laguna Blade's visible Order metadata says charm, but both physical AIcl
// objects issue chainlightning. Compare the command Warcraft actually routes.
return "chainlightning"
elseif skill=='A21L' or skill=='A2HS' then
return "frenzy"
elseif skill=='A2AI' then
return "hex"
elseif skill=='A2LL' then
return "impale"
elseif skill=='A1WH' then
return "metamorphosis"
endif
if skill=='A2QB' or skill=='A078' then
return "carrionswarm"
endif
return sourceOrder
endfunction
function SuijiMode_NativeConflictOrder takes integer skill,string sourceOrder returns string
set skill=SuijiMode_ToOriginalSkill(skill)
if skill=='A035' then
return "fanofknives"
endif
if skill=='A14I' or skill=='A21F' or skill=='A21G' then
return "berserk"
endif
// Keep native command checks narrow. These skills have an established live
// command that differs from their historical pool metadata.
if skill=='A2QB' or skill=='A078' then
return "carrionswarm"
elseif skill=='A0KV' then
return "carrionswarm"
elseif skill=='A1J7' then
return "tornado"
elseif skill=='A1P9' then
return "battleroar"
elseif skill=='A064' then
return "blizzard"
elseif skill=='A0M1' or skill=='A1AX' then
return "heal"
elseif skill=='A01P' or skill=='A09Z' then
return "chainlightning"
elseif skill=='A0LL' or skill=='A2H0' then
// Native Avalanche/Sleight inherit ACbz even though their pool rows contain
// blizzard/berserk. Compare the command Warcraft actually dispatches.
return "clusterrockets"
elseif skill=='A01F' or skill=='A02S' or skill=='A4FJ' then
return "carrionswarm"
endif
return sourceOrder
endfunction
function SuijiMode_GetNativePoolIndex takes unit u returns integer
local integer stableIndex=0
local integer poolIndex=KL4
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set stableIndex=SuijiMode_GetStableHeroIndex(u)
// Miao Dao is native-only; random pool row 117 belongs to an older hero.
if stableIndex==117 or GetUnitTypeId(u)=='HMD0' then
return 0
endif
if stableIndex<KL4 or stableIndex>K54 then
return stableIndex
endif
// Guardian Wisp is stable hero 29, but its registered native skill row is 50.
// Returning 29 here identifies Bristleback's abilities as Wisp's native set.
if stableIndex==29 or GetUnitTypeId(u)=='O01F' or GetUnitTypeId(u)=='Z01F' then
return 50
endif
// Pool rows were historically reused by later heroes.  Resolve the first row
// whose declared source is the stable hero instead of assuming row==hero.
loop
exitwhen poolIndex>SUIJI_POOL_MAX
if (SUIJI_POOL_SOURCE[poolIndex]==0 and poolIndex==stableIndex) or SUIJI_POOL_SOURCE[poolIndex]==stableIndex then
return poolIndex
endif
set poolIndex=poolIndex+1
endloop
return stableIndex
endfunction
function SuijiMode_HasOrderConflict takes unit u,integer skill,string order returns boolean
local integer i=KL4
local integer h=0
local integer nativePoolIndex=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
set nativePoolIndex=SuijiMode_GetNativePoolIndex(u)
if order=="" or order=="passive" then
return false
endif
// Reserve learned/unlearned native skills and temporary second-stage orders.
if GetUnitPointValue(u)==117 and (order=="stomp" or order=="berserk" or order=="shockwave" or order=="thunderclap" or order=="fanofknives" or order=="doom" or order=="earthquake") then
return true
endif
if OP7(h,"SuijiSmallOrder")==order or OP7(h,"SuijiUltOrder")==order then
return true
endif
if nativePoolIndex>=KL4 and nativePoolIndex<=SUIJI_POOL_MAX then
if SuijiMode_NativeConflictOrder(HM4[nativePoolIndex],HW4[nativePoolIndex])==order or SuijiMode_NativeConflictOrder(HN4[nativePoolIndex],HX4[nativePoolIndex])==order or SuijiMode_NativeConflictOrder(HO4[nativePoolIndex],HY4[nativePoolIndex])==order or SuijiMode_NativeConflictOrder(HP4[nativePoolIndex],HZ4[nativePoolIndex])==order then
return true
endif
endif
loop
exitwhen i>K54
if HM4[i]!=0 and GetUnitAbilityLevel(u,HM4[i])>0 and SuijiMode_NativeConflictOrder(HM4[i],HW4[i])==order then
return true
endif
if HN4[i]!=0 and GetUnitAbilityLevel(u,HN4[i])>0 and SuijiMode_NativeConflictOrder(HN4[i],HX4[i])==order then
return true
endif
if HO4[i]!=0 and GetUnitAbilityLevel(u,HO4[i])>0 and SuijiMode_NativeConflictOrder(HO4[i],HY4[i])==order then
return true
endif
if HP4[i]!=0 and GetUnitAbilityLevel(u,HP4[i])>0 and SuijiMode_NativeConflictOrder(HP4[i],HZ4[i])==order then
return true
endif
if HQ4[i]!=0 and GetUnitAbilityLevel(u,HQ4[i])>0 and SuijiMode_NativeConflictOrder(HQ4[i],HZ4[i])==order then
return true
endif
set i=i+1
endloop
return false
endfunction
function B1099EarthChooseStoneFamily takes nothing returns nothing
local unit earthUnit1099=B1099EarthEntryUnit
local integer earthFamily1099=0
if GetUnitTypeId(earthUnit1099)!='N0MU' and GetUnitTypeId(earthUnit1099)!='N0MV' then
// Metadata-only conflict checks run once at acquisition, not on recharge ticks.
if not SuijiMode_HasOrderConflict(earthUnit1099,'A2V8',"ancestralspirit") then
set earthFamily1099=1
elseif not SuijiMode_HasOrderConflict(earthUnit1099,'A2V8',"summonfactory") then
set earthFamily1099=2
elseif not SuijiMode_HasOrderConflict(earthUnit1099,'A2V8',"sentinel") then
set earthFamily1099=3
endif
endif
call SaveInteger(L7,GetHandleId(earthUnit1099),StringHash("B1099EarthStoneFamily"),earthFamily1099)
set earthUnit1099=null
endfunction
function B1099EarthReconcileStoneOrder takes unit earthUnit1099 returns nothing
local integer earthOldFamily1099=0
local integer earthOwner1099=GetHandleId(earthUnit1099)
if earthUnit1099==null or GetUnitTypeId(earthUnit1099)==0 or LoadTriggerHandle(L7,earthOwner1099,StringHash("B1099EarthChargeOwner"))==null then
return
endif
set earthOldFamily1099=LoadInteger(L7,earthOwner1099,StringHash("B1099EarthStoneFamily"))
set B1099EarthEntryUnit=earthUnit1099
call B1099EarthChooseStoneFamily()
set B1099EarthEntryUnit=null
if earthOldFamily1099!=LoadInteger(L7,earthOwner1099,StringHash("B1099EarthStoneFamily")) then
call B1099EarthSyncStone(earthUnit1099,LoadInteger(L7,earthOwner1099,800))
endif
endfunction
function SuijiMode_GetAlternateCarrierOrder takes integer skill returns string
set skill=SuijiMode_ToOriginalSkill(skill)
return LoadStr(SUIJI_FIXED_CLONE_TABLE,3,skill)
endfunction
function SuijiMode_ResolveAlternateCarrierOrder takes unit u,integer skill,string order returns string
local string alternateOrder=null
set skill=SuijiMode_ToOriginalSkill(skill)
set alternateOrder=SuijiMode_GetAlternateCarrierOrder(skill)
if alternateOrder!=null and alternateOrder!="" and order!=alternateOrder and SuijiMode_HasOrderConflict(u,skill,order) and SuijiMode_HasOrderConflict(u,skill,alternateOrder)==false then
return alternateOrder
endif
set alternateOrder=null
return order
endfunction
function SuijiMode_GetCarrierGrantSkill takes integer logicalSkill,string order returns integer
local integer alternateSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)
local string alternateOrder=SuijiMode_GetAlternateCarrierOrder(logicalSkill)
if alternateSkill!=0 and alternateOrder!=null and alternateOrder==order then
set alternateOrder=null
return alternateSkill
endif
set alternateOrder=null
return SuijiMode_GetGrantSkill(logicalSkill)
endfunction
function SuijiMode_CanSkipHelper takes integer skill returns boolean
if skill=='A10R' or skill=='A0T2' or skill=='A1P8' or skill=='A0EY' or skill=='A2KZ' or skill=='A06W' or skill=='A01K' or skill=='A041' or skill=='A0BR' or skill=='A1RI' or skill=='A035' or skill=='A03U' or skill=='A0RO' or skill=='A02C' or skill=='A4L1' then
return true
endif
if skill=='A1RD' or skill=='A044' or skill=='A226' or skill=='A0FU' or skill=='A19Z' or skill=='A0H4' or skill=='A06V' or skill=='A0CY' or skill=='A03G' or skill=='ANcr' or skill=='A15J' or skill=='A07Q' or skill=='A093' or skill=='A0WQ' or skill=='A1YQ' then
return true
endif
return skill=='A088' or skill=='A0BE' or skill=='A13T' or skill=='A1SU' or skill=='A1NA' or skill=='A0VX' or skill=='A2V6' or skill=='A2V4' or skill=='A2V5' or skill=='A2V7' or skill=='A2Z3' or skill=='A2VM' or skill=='A2V0' or skill=='A2V1' or skill=='A2V2' or skill=='A2V3' or skill=='A2XP' or skill=='A11T' or skill=='A4AS' or skill=='A0SW' or skill=='A4FR' or skill=='A29J' or skill=='A1MP' or skill=='A0MW' or skill=='A27C' or skill=='A21F' or skill=='A21G' or skill=='A0Z0'
endfunction
function SuijiMode_IsNativeRegisteredSkill takes unit u,integer skill returns boolean
local integer idx=0
local integer poolIdx=0
local integer i=1
if u==null or skill==0 then
return false
endif
set idx=SuijiMode_GetStableHeroIndex(u)
set poolIdx=SuijiMode_GetNativePoolIndex(u)
if idx<=0 then
return false
endif
if poolIdx>=KL4 and poolIdx<=SUIJI_POOL_MAX and (skill==HM4[poolIdx] or skill==HN4[poolIdx] or skill==HO4[poolIdx] or skill==HP4[poolIdx] or skill==HQ4[poolIdx]) then
return true
endif
loop
exitwhen i>10
if LoadInteger(MSK,idx,i)==skill then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_GetPoolSource takes integer poolIndex returns integer
if poolIndex>=KL4 and poolIndex<=SUIJI_POOL_MAX and SUIJI_POOL_SOURCE[poolIndex]!=0 then
return SUIJI_POOL_SOURCE[poolIndex]
endif
return poolIndex
endfunction
function SuijiMode_GetAIOriginalUltimate takes integer heroIndex returns integer
local integer poolIndex=KL4
if heroIndex==117 then
return 'AMdR'
endif
// Later heroes reuse historical pool rows. Resolve the row by its real owner
// instead of treating the hero index as an unchanged pool index.
// These native learn buttons are not represented by their source HP4 row.
if heroIndex==50 then
return 'A1YQ'
elseif heroIndex==54 then
return 'A2JK'
elseif heroIndex==57 then
return 'A2E5'
elseif heroIndex==103 then
return 'A073'
endif
loop
exitwhen poolIndex>SUIJI_POOL_MAX
if SuijiMode_GetPoolSource(poolIndex)==heroIndex and HP4[poolIndex]!=0 then
return HP4[poolIndex]
endif
set poolIndex=poolIndex+1
endloop
return 0
endfunction
function SuijiMode_GetPoolSkillSource takes integer poolIndex,integer skill returns integer
// Walrus Punch is an extra synthetic ultimate that borrows row 50 only as a
// selection sentinel. Its source must remain Tusk even though the real row-50
// Wisp skills now point back to their own native AI template.
if skill=='A1YQ' then
return 50
elseif skill=='A0VQ' or skill=='A0VG' or skill=='A0VN' or skill=='A0VM' then
return 94
endif
return SuijiMode_GetPoolSource(poolIndex)
endfunction
function SuijiMode_IsRandomPoolExcludedSkill takes integer skill returns boolean
return skill=='ANic' or skill=='A0O8' or skill=='A0P6' or skill=='A11N' or skill=='A1MI' or skill=='A2SE' or skill=='A00E'
endfunction
function SuijiMode_IsRandomRollExcludedSkill takes integer skill returns boolean
return SuijiMode_IsRandomPoolExcludedSkill(skill) or skill=='A6L3'
endfunction
function SuijiMode_IsAIRandomSkillBlocked takes unit u,integer skill returns boolean
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
return GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and GetUnitTypeId(u)=='Ofar' and SuijiMode_ToOriginalSkill(skill)=='A088'
endfunction
function SuijiMode_IsUltimateOnlySkill takes integer skill returns boolean
set skill=SuijiMode_ToOriginalSkill(skill)
return skill=='A067' or skill=='A08P' or skill=='A0FL' or skill=='A1CX'
endfunction
function SuijiMode_CanUseSkill takes unit u,integer skill,integer helper,string order returns boolean
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
if SuijiMode_IsAIRandomSkillBlocked(u,skill) then
return false
endif
set order=SuijiMode_RandomOrder(skill,order)
set order=SuijiMode_ResolveAlternateCarrierOrder(u,skill,order)
if helper==0 and SuijiMode_CanSkipHelper(skill)==false then
return false
endif
if order=="" then
return false
endif
if SuijiMode_HasLogicalAbility(u,skill) then
return false
endif
if SuijiMode_IsNativeRegisteredSkill(u,skill) or SuijiMode_IsNativeRegisteredSkill(u,helper) then
return false
endif
if helper!=0 and GetUnitAbilityLevel(u,helper)>0 then
return false
endif
if SuijiMode_HasOrderConflict(u,skill,order) then
return false
endif
return true
endfunction
function SuijiMode_NormalizeHotkey takes integer hotkey returns integer
if hotkey>=97 and hotkey<=122 then
return hotkey-32
endif
return hotkey
endfunction
function SuijiMode_GetSkillHotkey takes unit u,integer skill returns integer
local integer hotkey=0
if skill==0 then
return 0
endif
if u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,skill)>0 then
set hotkey=MHAbility_GetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY)
endif
if hotkey<=0 then
set hotkey=MHAbility_GetDefDataInt(skill,ABILITY_DEF_DATA_HOTKEY)
endif
return SuijiMode_NormalizeHotkey(hotkey)
endfunction
function SuijiMode_IsHotkeyUsedBySkill takes unit u,integer hotkey,integer skill,integer ignoreSkill returns boolean
return hotkey>0 and skill!=0 and skill!=ignoreSkill and SuijiMode_GetSkillHotkey(u,skill)==hotkey
endfunction
function SuijiMode_HotkeyCandidate takes integer i returns integer
if i==1 then
return 68
elseif i==2 then
return 70
elseif i==3 then
return 84
elseif i==4 then
return 71
elseif i==5 then
return 67
elseif i==6 then
return 86
elseif i==7 then
return 66
elseif i==8 then
return 78
elseif i==9 then
return 90
elseif i==10 then
return 88
elseif i==11 then
return 81
elseif i==12 then
return 87
elseif i==13 then
return 69
elseif i==14 then
return 82
elseif i==15 then
return 85
elseif i==16 then
return 89
endif
return 0
endfunction
function SuijiMode_IsHotkeyUsed takes unit u,integer hotkey,integer ignoreSkill returns boolean
local integer h=0
local integer heroIndex=0
local integer i=1
local integer skill=0
if u==null or GetUnitTypeId(u)==0 or hotkey<=0 then
return false
endif
// F does not exist until R starts; reserve it before random hotkey allocation.
if GetUnitPointValue(u)==117 and ((hotkey==81 and ignoreSkill!='AMdQ') or (hotkey==87 and ignoreSkill!='AMdW') or (hotkey==69 and ignoreSkill!='AMdE') or (hotkey==82 and ignoreSkill!='AMdR' and ignoreSkill!='AMdT') or (hotkey==68 and ignoreSkill!='AMdD') or (hotkey==70 and ignoreSkill!='AMdF')) then
return true
endif
set h=GetHandleId(u)
set skill=OM7(h,"SuijiSmallSkill")
if skill!=0 and skill!=ignoreSkill and OM7(h,"SuijiSmallHotkey")==hotkey then
return true
endif
set skill=OM7(h,"SuijiUltSkill")
if skill!=0 and skill!=ignoreSkill and OM7(h,"SuijiUltHotkey")==hotkey then
return true
endif
set heroIndex=SuijiMode_GetStableHeroIndex(u)
if heroIndex>=KL4 and heroIndex<=K54 then
loop
exitwhen i>10
set skill=LoadInteger(MSK,heroIndex,i)
if SuijiMode_IsHotkeyUsedBySkill(u,hotkey,skill,ignoreSkill) then
return true
endif
set i=i+1
endloop
endif
return false
endfunction
function SuijiMode_FindFreeHotkey takes unit u,integer skill returns integer
local integer i=1
local integer hotkey=0
loop
exitwhen i>16
set hotkey=SuijiMode_HotkeyCandidate(i)
if hotkey>0 and SuijiMode_IsHotkeyUsed(u,hotkey,skill)==false then
return hotkey
endif
set i=i+1
endloop
return SuijiMode_GetSkillHotkey(u,skill)
endfunction
function SuijiMode_MarkCommandCardDirty takes nothing returns nothing
set SUIJI_UI_CARD_REVISION=SUIJI_UI_CARD_REVISION+1
if SUIJI_UI_CARD_REVISION>2000000000 then
set SUIJI_UI_CARD_REVISION=1
set SUIJI_UI_APPLIED_REVISION=-1
endif
endfunction
function SuijiMode_MarkUnitVisibilityDirty takes unit u returns nothing
if u!=null and GetUnitTypeId(u)!=0 then
call NS7(GetHandleId(u),"SuijiVisibilityRepairClean",false)
endif
call SuijiMode_MarkCommandCardDirty()
endfunction
function SuijiMode_NeedsVisibilityRepair takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return OO7(GetHandleId(u),"SuijiVisibilityRepairClean")==false
endfunction
function SuijiMode_CommitVisibilityRepair takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call NS7(GetHandleId(u),"SuijiVisibilityRepairClean",true)
endfunction
function SuijiMode_SetOwnedAbilityButtonSlot takes unit suijiButtonUnit,integer suijiButtonSkill,integer suijiButtonX,integer suijiButtonY returns nothing
local ability suijiButtonAbility=null
if suijiButtonUnit==null or GetUnitTypeId(suijiButtonUnit)==0 or suijiButtonSkill==0 or GetUnitAbilityLevel(suijiButtonUnit,suijiButtonSkill)<=0 then
return
endif
set suijiButtonAbility=EXGetUnitAbility(suijiButtonUnit,suijiButtonSkill)
if suijiButtonAbility==null then
set suijiButtonAbility=null
return
endif
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_BUTTON_X,suijiButtonX)
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_BUTTON_Y,suijiButtonY)
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_UNBUTTON_X,suijiButtonX)
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_UNBUTTON_Y,suijiButtonY)
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_X,suijiButtonX)
call MHAbility_SetCustomDataInt(suijiButtonUnit,suijiButtonSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_Y,suijiButtonY)
set suijiButtonAbility=null
endfunction
function SuijiMode_GetNativeBaseButtonX takes unit suijiNativeUnit,integer suijiNativeSkill returns integer
local integer suijiNativeSource=0
if suijiNativeUnit==null or GetUnitTypeId(suijiNativeUnit)==0 or suijiNativeSkill==0 then
return -1
endif
set suijiNativeSource=SuijiMode_GetNativePoolIndex(suijiNativeUnit)
if suijiNativeSource<KL4 or suijiNativeSource>SUIJI_POOL_MAX then
return -1
endif
if suijiNativeSkill==HM4[suijiNativeSource] then
return 0
elseif suijiNativeSkill==HN4[suijiNativeSource] then
return 1
elseif suijiNativeSkill==HO4[suijiNativeSource] then
return 2
elseif suijiNativeSkill==HP4[suijiNativeSource] or suijiNativeSkill==HQ4[suijiNativeSource] then
return 3
endif
return -1
endfunction
function BristlebackAghActive_SyncButton takes unit bristlebackAghButtonUnit returns nothing
local integer bristlebackAghButtonHandle=0
local integer bristlebackAghButtonClone=0
local integer bristlebackAghButtonPhysical=0
local integer bristlebackAghButtonPrevious=0
local integer bristlebackAghButtonX=2
local integer bristlebackAghButtonY=1
local boolean bristlebackAghButtonActive=false
local player bristlebackAghButtonOwner=null
if bristlebackAghButtonUnit==null or GetUnitTypeId(bristlebackAghButtonUnit)==0 then
return
endif
set bristlebackAghButtonHandle=GetHandleId(bristlebackAghButtonUnit)
set bristlebackAghButtonOwner=GetOwningPlayer(bristlebackAghButtonUnit)
set bristlebackAghButtonClone=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,'A0M3')
set bristlebackAghButtonPhysical=B287_GetPhysicalAbilityId(bristlebackAghButtonUnit,'A0M3')
if bristlebackAghButtonPhysical!=0 and GetUnitAbilityLevel(bristlebackAghButtonUnit,bristlebackAghButtonPhysical)>0 and IsUnitIllusion(bristlebackAghButtonUnit)==false then
// Native and either OMG random owner share one idempotent damage listener.
// This closes restore/selection paths that did not pass the old learn event.
call VP9(bristlebackAghButtonUnit,false)
endif
if SuijiMode_HasRandomSkill(bristlebackAghButtonUnit,'A0M3') then
if OM7(bristlebackAghButtonHandle,"SuijiUltSkill")=='A0M3' then
set bristlebackAghButtonX=2
else
set bristlebackAghButtonX=0
endif
set bristlebackAghButtonY=0
elseif SuijiMode_GetNativeBaseButtonX(bristlebackAghButtonUnit,'A0M3')>=0 then
set bristlebackAghButtonX=SuijiMode_GetNativeBaseButtonX(bristlebackAghButtonUnit,'A0M3')
set bristlebackAghButtonY=2
endif
set bristlebackAghButtonActive=SuijiMode_ScepterRegistryIsRegistered(bristlebackAghButtonUnit,'A0M3') and SuijiMode_ScepterRegistryIsActive(bristlebackAghButtonUnit,'A0M3') and GetUnitAbilityLevel(bristlebackAghButtonUnit,'ZBBA')>0 and bristlebackAghButtonPhysical!=0 and GetUnitAbilityLevel(bristlebackAghButtonUnit,bristlebackAghButtonPhysical)>0
if bristlebackAghButtonActive then
call SuijiMode_SetOwnedAbilityButtonSlot(bristlebackAghButtonUnit,'ZBBA',bristlebackAghButtonX,bristlebackAghButtonY)
set bristlebackAghButtonPrevious=LoadInteger(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghHiddenPhysical"))
if bristlebackAghButtonPrevious!=0 and bristlebackAghButtonPrevious!=bristlebackAghButtonPhysical and GetUnitAbilityLevel(bristlebackAghButtonUnit,bristlebackAghButtonPrevious)>0 then
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,bristlebackAghButtonPrevious,false)
endif
call SaveInteger(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghHiddenPhysical"),bristlebackAghButtonPhysical)
call SaveBoolean(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghPassiveHidden"),true)
// Player-wide availability can be rewritten by legacy AI and OMG visibility
// repair. Move the owned passive instance off-card as the authoritative
// single-unit state; its passive script and level remain intact.
call SuijiMode_SetOwnedAbilityButtonSlot(bristlebackAghButtonUnit,bristlebackAghButtonPhysical,0,-11)
if GetUnitAbilityLevel(bristlebackAghButtonUnit,'A0M3')>0 then
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,'A0M3',false)
endif
if bristlebackAghButtonClone!=0 and GetUnitAbilityLevel(bristlebackAghButtonUnit,bristlebackAghButtonClone)>0 then
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,bristlebackAghButtonClone,false)
endif
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,bristlebackAghButtonPhysical,false)
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,'ZBBA',true)
elseif LoadBoolean(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghPassiveHidden")) then
set bristlebackAghButtonPrevious=LoadInteger(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghHiddenPhysical"))
if bristlebackAghButtonPrevious!=0 then
call SuijiMode_SetOwnedAbilityButtonSlot(bristlebackAghButtonUnit,bristlebackAghButtonPrevious,bristlebackAghButtonX,bristlebackAghButtonY)
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,bristlebackAghButtonPrevious,true)
endif
if bristlebackAghButtonPhysical!=0 and GetUnitAbilityLevel(bristlebackAghButtonUnit,bristlebackAghButtonPhysical)>0 then
call SuijiMode_SetOwnedAbilityButtonSlot(bristlebackAghButtonUnit,bristlebackAghButtonPhysical,bristlebackAghButtonX,bristlebackAghButtonY)
call SetPlayerAbilityAvailable(bristlebackAghButtonOwner,bristlebackAghButtonPhysical,true)
endif
call RemoveSavedInteger(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghHiddenPhysical"))
call RemoveSavedBoolean(L7,bristlebackAghButtonHandle,StringHash("BristlebackAghPassiveHidden"))
endif
set bristlebackAghButtonOwner=null
endfunction
function SuijiMode_ApplyNativeVariantButtonSlot takes unit suijiNativeUnit,integer suijiNativeBaseSkill,integer suijiNativeVisibleSkill returns nothing
local integer suijiNativeButtonX=SuijiMode_GetNativeBaseButtonX(suijiNativeUnit,suijiNativeBaseSkill)
if suijiNativeButtonX>=0 then
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,suijiNativeVisibleSkill,suijiNativeButtonX,2)
endif
endfunction
function SuijiMode_SyncNativeButtonSlots takes unit suijiNativeUnit returns nothing
local integer suijiNativeSource=0
if suijiNativeUnit==null or GetUnitTypeId(suijiNativeUnit)==0 then
return
endif
set suijiNativeSource=SuijiMode_GetNativePoolIndex(suijiNativeUnit)
if suijiNativeSource<KL4 or suijiNativeSource>SUIJI_POOL_MAX then
return
endif
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HM4[suijiNativeSource],0,2)
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HN4[suijiNativeSource],1,2)
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HO4[suijiNativeSource],2,2)
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HP4[suijiNativeSource],3,2)
// Timbersaw's A2SI is a simultaneous Scepter companion, not an alternate
// fourth skill.  Keep it away from both the native ultimate at (3,2) and the
// hero learn command at (3,1); its A2E6 return face inherits this same slot.
if HQ4[suijiNativeSource]=='A2SI' then
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HQ4[suijiNativeSource],2,1)
else
call SuijiMode_SetOwnedAbilityButtonSlot(suijiNativeUnit,HQ4[suijiNativeSource],3,2)
endif
endfunction
function SuijiMode_ApplyButtonSlot takes unit suijiButtonUnit,integer suijiButtonSkill,string suijiButtonMark returns nothing
local integer suijiButtonX=0
local integer suijiButtonY=0
if suijiButtonUnit==null or GetUnitTypeId(suijiButtonUnit)==0 or suijiButtonSkill==0 or GetUnitAbilityLevel(suijiButtonUnit,suijiButtonSkill)<=0 then
return
endif
if suijiButtonMark=="SuijiSmall" then
set suijiButtonX=0
set suijiButtonY=0
elseif suijiButtonMark=="SuijiUlt" then
set suijiButtonX=2
set suijiButtonY=0
else
return
endif
call SuijiMode_SetOwnedAbilityButtonSlot(suijiButtonUnit,suijiButtonSkill,suijiButtonX,suijiButtonY)
endfunction
function SuijiMode_ApplyHotkey takes unit u,integer skill,string mark,string order returns nothing
local integer h=0
local integer hotkey=0
if u==null or GetUnitTypeId(u)==0 or skill==0 or SuijiMode_HasExactLiveAbility(u,skill)==false then
return
endif
if SuijiMode_IsFixedClone(skill) then
set h=GetHandleId(u)
call SuijiMode_ApplyButtonSlot(u,skill,mark)
if mark=="SuijiSmall" then
call NP7(h,mark+"Hotkey",75)
elseif mark=="SuijiUlt" then
call NP7(h,mark+"Hotkey",76)
endif
return
endif
call SuijiMode_ApplyButtonSlot(u,skill,mark)
if order=="passive" then
return
endif
set h=GetHandleId(u)
if mark=="SuijiSmall" then
set hotkey=75
elseif mark=="SuijiUlt" then
set hotkey=76
else
set hotkey=OM7(h,mark+"Hotkey")
if hotkey<=0 or SuijiMode_IsHotkeyUsed(u,hotkey,skill) then
set hotkey=SuijiMode_FindFreeHotkey(u,skill)
endif
endif
call NP7(h,mark+"Hotkey",hotkey)
if hotkey>0 then
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY,hotkey)
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNHOTKEY,hotkey)
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_RESEARCH_HOTKEY,hotkey)
endif
endfunction
function SuijiMode_SyncOwnedChargeButtonSlot takes unit u,integer logicalSkill,string mark returns nothing
local integer h=0
local integer pointer=0
local integer key=0
local integer charges=0
local integer currentSkill=0
local integer bridgeSkill=0
local player p=null
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return
endif
set pointer=Get_Multiple_Skill_Pointer(u,logicalSkill)
if pointer==0 then
return
endif
set h=GetHandleId(u)
set bridgeSkill=OM7(h,mark+"Ability")
if bridgeSkill==0 or GetUnitAbilityLevel(u,bridgeSkill)<=0 then
return
endif
set key=Get_Multiple_Skill_Key(u,logicalSkill)
set charges=LoadInteger(MSK,key,30)
set currentSkill=LoadInteger(MSK,key,charges)
if currentSkill==0 or GetUnitAbilityLevel(u,currentSkill)<=0 then
return
endif
// The fixed clone only bridges the random logical level. The live charge
// ability owns the visible command-card slot and changes as charges change.
call SuijiMode_ApplyButtonSlot(u,bridgeSkill,mark)
call Multiple_Skill_CaptureButton(u,logicalSkill,bridgeSkill)
call SuijiMode_ApplyButtonSlot(u,currentSkill,mark)
call Multiple_Skill_SyncButton(u,currentSkill)
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,currentSkill,true)
if bridgeSkill!=currentSkill then
call SetPlayerAbilityAvailable(p,bridgeSkill,false)
endif
set p=null
endfunction
function SuijiMode_InitUnitSource takes unit u,integer source returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
if source==58 and SuijiMode_GetStableHeroIndex(u)!=58 then
call SuijiMode_InitEarthSpiritCopiedUnit(u)
endif
endfunction
function SuijiMode_HasScepter takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if GetUnitTypeId(u)=='Hmkg' then
return SuijiMode_DetectAghanimSourceState(u)
endif
return SuijiMode_DetectAghanimSourceState(u)
endfunction
function SuijiMode_UnifiedOrbCanonical takes integer skill returns integer
if skill=='A1WB' then
return 'A0DY'
elseif skill=='A2ZJ' then
return 'A026'
elseif skill=='A4HO' then
return 'A09V'
elseif skill=='X0OI' then
return 'A0OI'
endif
return skill
endfunction
function SuijiMode_IsUnifiedOrbSkill takes integer skill returns boolean
set skill=SuijiMode_UnifiedOrbCanonical(skill)
return skill=='A026' or skill=='A09V' or skill=='A0DY' or skill=='AHfa' or skill=='A0LZ' or skill=='A0OI' or skill=='A0QN'
endfunction
function SuijiMode_UnifiedOrbFamily takes integer skill returns integer
set skill=SuijiMode_UnifiedOrbCanonical(skill)
if skill=='A026' then
return 1
elseif skill=='AHfa' then
return 2
endif
return 3
endfunction
function SuijiMode_UnifiedOrbEnabled takes unit u,integer skill returns boolean
local integer h=0
local integer family=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
set family=SuijiMode_UnifiedOrbFamily(skill)
if OO7(h,"SuijiUnifiedOrbKnown"+I2S(family))==false then
return true
endif
return OO7(h,"SuijiUnifiedOrbOn"+I2S(family))
endfunction
function SuijiMode_UnifiedOrbMasterEnabled takes unit orbMasterUnit returns boolean
if orbMasterUnit==null or GetUnitTypeId(orbMasterUnit)==0 then
return false
endif
return not UnifiedOrbMasterDisabled[GetPlayerId(GetOwningPlayer(orbMasterUnit))]
endfunction
function SuijiMode_SetUnifiedOrbFamilyEnabled takes unit u,integer family,boolean enabled returns nothing
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
call NS7(h,"SuijiUnifiedOrbKnown"+I2S(family),true)
call NS7(h,"SuijiUnifiedOrbOn"+I2S(family),enabled)
endfunction
function SuijiMode_UnifiedOrbLevel takes unit u,integer skill returns integer
local integer physical=0
local integer level=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set physical=B287_GetPhysicalAbilityId(u,skill)
set level=GetUnitAbilityLevel(u,physical)
if level<=0 then
if skill=='A0DY' then
set physical=B287_GetPhysicalAbilityId(u,'A1WB')
set level=GetUnitAbilityLevel(u,physical)
elseif skill=='A026' then
set physical=B287_GetPhysicalAbilityId(u,'A2ZJ')
set level=GetUnitAbilityLevel(u,physical)
elseif skill=='A09V' then
set physical=B287_GetPhysicalAbilityId(u,'A4HO')
set level=GetUnitAbilityLevel(u,physical)
elseif skill=='A0OI' then
set physical=B287_GetPhysicalAbilityId(u,'X0OI')
set level=GetUnitAbilityLevel(u,physical)
endif
endif
return level
endfunction
function SuijiMode_UnifiedOrbPhysical takes unit u,integer skill returns integer
local integer physical=B287_GetPhysicalAbilityId(u,skill)
if u==null or GetUnitTypeId(u)==0 then
return physical
endif
if GetUnitAbilityLevel(u,physical)>0 then
return physical
endif
if skill=='A026' and GetUnitAbilityLevel(u,'A2ZJ')>0 then
return 'A2ZJ'
elseif skill=='A0DY' and GetUnitAbilityLevel(u,'A1WB')>0 then
return 'A1WB'
elseif skill=='A09V' and GetUnitAbilityLevel(u,'A4HO')>0 then
return 'A4HO'
elseif skill=='A0OI' and GetUnitAbilityLevel(u,'X0OI')>0 then
return 'X0OI'
endif
return physical
endfunction
function SuijiMode_ForcePassiveOrbs takes unit u returns nothing
// Random-orb fixed clones are zero-effect passive object abilities.
// Never hide their icons or issue native autocast orders at runtime.
endfunction
function SuijiMode_UnifiedOrbCount takes unit u returns integer
local integer count=0
if u==null or GetUnitTypeId(u)==0 or not SuijiMode_UnifiedOrbMasterEnabled(u) then
return 0
endif
if SuijiMode_UnifiedOrbLevel(u,'A026')>0 and SuijiMode_UnifiedOrbEnabled(u,'A026') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'A09V')>0 and SuijiMode_UnifiedOrbEnabled(u,'A09V') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'A0DY')>0 and SuijiMode_UnifiedOrbEnabled(u,'A0DY') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'AHfa')>0 and SuijiMode_UnifiedOrbEnabled(u,'AHfa') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'A0LZ')>0 and SuijiMode_UnifiedOrbEnabled(u,'A0LZ') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'A0OI')>0 and SuijiMode_UnifiedOrbEnabled(u,'A0OI') then
set count=count+1
endif
if SuijiMode_UnifiedOrbLevel(u,'A0QN')>0 and SuijiMode_UnifiedOrbEnabled(u,'A0QN') then
set count=count+1
endif
return count
endfunction
function SuijiMode_UnifiedOrbDebug takes unit u,string tag,string text returns nothing
local integer h=0
local integer count=0
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set count=OM7(h,"SuijiUnifiedOrbLogCount")
if count>=24 then
return
endif
call NP7(h,"SuijiUnifiedOrbLogCount",count+1)
call SuijiTest_DebugAll(tag,"hero="+GetUnitName(u)+" "+text)
endfunction
// Direct passive slow helpers: apply their attribute to the struck unit and
// use one refreshable timer per unit/ability.  This deliberately has no dummy
// caster and issues no order, which avoids both rejected dummy casts and order
// event recursion.
function SuijiMode_UnifiedOrbTimedPassiveExpire takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit target=LoadUnitHandle(L7,h,0)
local integer abilityId=LoadInteger(L7,h,1)
local integer targetHandle=0
if target!=null and GetUnitTypeId(target)!=0 then
set targetHandle=GetHandleId(target)
call UnitRemoveAbility(target,abilityId)
call RemoveSavedHandle(L7,targetHandle,abilityId)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set target=null
set t=null
endfunction
function SuijiMode_UnifiedOrbAddTimedPassive takes unit target,integer abilityId,real duration returns boolean
local integer targetHandle=0
local timer oldTimer=null
local timer t=null
local integer h=0
if target==null or GetUnitTypeId(target)==0 or UnitAlive(target)==false or abilityId==0 or duration<=0. then
return false
endif
set targetHandle=GetHandleId(target)
set oldTimer=LoadTimerHandle(L7,targetHandle,abilityId)
if oldTimer!=null then
call PauseTimer(oldTimer)
call FlushChildHashtable(L7,GetHandleId(oldTimer))
call DestroyTimer(oldTimer)
endif
call UnitRemoveAbility(target,abilityId)
if UnitAddAbility(target,abilityId)==false then
set oldTimer=null
return false
endif
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,target)
call SaveInteger(L7,h,1,abilityId)
call SaveTimerHandle(L7,targetHandle,abilityId,t)
call TimerStart(t,duration,false,function SuijiMode_UnifiedOrbTimedPassiveExpire)
set oldTimer=null
set t=null
return true
endfunction
function SuijiMode_UnifiedOrbFrostSlowAbility takes integer level returns integer
if level==1 then
return 'Y0GX'
elseif level==2 then
return 'Y0GY'
elseif level==3 then
return 'Y0GZ'
endif
return 'Y0H0'
endfunction
function SuijiMode_UnifiedOrbPoisonMoveSlowAbility takes integer level returns integer
if level==1 then
return 'Y0H1'
elseif level==2 then
return 'Y0H2'
elseif level==3 then
return 'Y0H3'
endif
return 'Y0H4'
endfunction
function SuijiMode_UnifiedOrbPoisonAttackSlowAbility takes integer level returns integer
if level==1 then
return 'Y0H5'
elseif level==2 then
return 'Y0H6'
elseif level==3 then
return 'Y0H7'
endif
return 'Y0H8'
endfunction
// Poison Attack used to rely on AEpa's native autocast payload. Keep its
// periodic damage in the controller; movement and attack speed use the direct
// passive helpers above.
function SuijiMode_UnifiedOrbPoisonTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit source=LoadUnitHandle(L7,h,0)
local unit target=LoadUnitHandle(L7,h,1)
local integer ticks=LoadInteger(L7,h,2)
local real damage=LoadReal(L7,h,3)
if source!=null and target!=null and GetUnitTypeId(source)!=0 and GetUnitTypeId(target)!=0 and UnitAlive(source) and UnitAlive(target) then
call B67(source,target,3,damage)
endif
set ticks=ticks-1
if ticks>0 and target!=null and GetUnitTypeId(target)!=0 and UnitAlive(target) then
call SaveInteger(L7,h,2,ticks)
call TimerStart(t,1.,false,function SuijiMode_UnifiedOrbPoisonTick)
else
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
endif
set source=null
set target=null
set t=null
endfunction
function SuijiMode_UnifiedOrbStartPoison takes unit source,unit target,integer level returns nothing
local timer t=null
local integer h=0
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 or UnitAlive(source)==false or UnitAlive(target)==false then
return
endif
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,source)
call SaveUnitHandle(L7,h,1,target)
call SaveInteger(L7,h,2,2)
call SaveReal(L7,h,3,4.+6.*level)
call TimerStart(t,1.,false,function SuijiMode_UnifiedOrbPoisonTick)
set t=null
endfunction
function SuijiMode_UnifiedOrbApply takes unit source,unit target,integer skill returns nothing
local integer level=0
local real cost=0.
local real damage=0.
local real distance=0.
set skill=SuijiMode_UnifiedOrbCanonical(skill)
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 or UnitAlive(source)==false or UnitAlive(target)==false or GetUnitAbilityLevel(target,'Avul')>0 or not SuijiMode_UnifiedOrbMasterEnabled(source) then
return
endif
if skill!='AHfa' and IsUnitType(target,UNIT_TYPE_STRUCTURE) then
return
endif
set level=SuijiMode_UnifiedOrbLevel(source,skill)
if level<=0 then
return
endif
if skill=='A0QN' then
set cost=15.
if GetUnitState(source,UNIT_STATE_LIFE)<=cost then
call SuijiMode_UnifiedOrbDebug(source,"ORB-SKIP","skill="+GetAbilityName(skill)+" reason=life")
return
endif
call SetUnitState(source,UNIT_STATE_LIFE,GetUnitState(source,UNIT_STATE_LIFE)-cost)
else
if skill=='A026' then
if SuijiMode_ScepterRegistryIsActive(source,'A026')==false then
set cost=12.
endif
elseif skill=='A09V' then
if SuijiMode_ScepterRegistryIsActive(source,'A09V')==false then
set cost=20.
endif
elseif skill=='A0DY' then
set cost=10.+5.*level
elseif skill=='AHfa' then
set cost=10.
elseif skill=='A0LZ' then
set cost=15.
elseif skill=='A0OI' then
set cost=80.+20.*level
endif
if GetUnitState(source,UNIT_STATE_MANA)<cost then
call SuijiMode_UnifiedOrbDebug(source,"ORB-SKIP","skill="+GetAbilityName(skill)+" reason=mana cost="+I2S(R2I(cost)))
return
endif
call SetUnitState(source,UNIT_STATE_MANA,GetUnitState(source,UNIT_STATE_MANA)-cost)
endif
call SuijiMode_UnifiedOrbDebug(source,"ORB-APPLY","skill="+GetAbilityName(skill)+" level="+I2S(level)+" target="+GetUnitName(target))
if skill=='A026' then
call SuijiMode_UnifiedOrbAddTimedPassive(target,SuijiMode_UnifiedOrbFrostSlowAbility(level),7.)
call SuijiMode_UnifiedOrbDebug(source,"ORB-CAST","skill=A026 direct-passive=1")
elseif skill=='A09V' then
call SuijiMode_UnifiedOrbAddTimedPassive(target,SuijiMode_UnifiedOrbPoisonMoveSlowAbility(level),2.)
call SuijiMode_UnifiedOrbAddTimedPassive(target,SuijiMode_UnifiedOrbPoisonAttackSlowAbility(level),2.)
call SuijiMode_UnifiedOrbDebug(source,"ORB-CAST","skill=A09V direct-passive=1")
call SuijiMode_UnifiedOrbStartPoison(source,target,level)
elseif skill=='A0DY' then
set distance=RMinBJ(X29(GetUnitX(target),GetUnitY(target),GetUnitX(source),GetUnitY(source)),3000.)
// A copied Impetus uses the stable physical button's real attack/order range.
// Do not let temporary infinite-range item effects amplify it beyond that
// logical range; native Enchantress retains the original 3000 distance cap.
if OO7(GetHandleId(source),"SuijiHeartstopper") then
if SuijiMode_ScepterRegistryIsActive(source,'A0DY') then
set distance=RMinBJ(distance,740.)
else
set distance=RMinBJ(distance,550.)
endif
endif
set damage=(.1+.05*level)*distance
call YW7("+"+I2S(R2I(damage)),1,target,.023,3,$D8,$D8,$D8)
call B67(source,target,11,damage)
elseif skill=='AHfa' then
call B67(source,target,3,20.+10.*level)
elseif skill=='A0LZ' then
set damage=(.15+.15*level)*GetHeroInt(source,true)
call YW7("+"+I2S(R2I(damage)),1,target,.023,3,$D8,$D8,$D8)
call B67(source,target,3,damage)
elseif skill=='A0OI' then
call XB(source,target)
elseif skill=='A0QN' then
call Z29(source,target)
endif
endfunction
function SuijiMode_UnifiedOrbObserveAttack takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local unit source=GetAttacker()
local integer h=0
local integer count=0
if source!=null and GetUnitTypeId(source)!=0 and IsUnitType(source,UNIT_TYPE_HERO) then
set h=GetHandleId(source)
set count=SuijiMode_UnifiedOrbCount(source)
if count>0 or OM7(h,"SuijiUnifiedOrbAttackCount")>0 then
call NP7(h,"SuijiUnifiedOrbAttackCount",count)
endif
if SUIJI_LOG and IsUnitType(source,UNIT_TYPE_HERO) then
call SuijiMode_UnifiedOrbDebug(source,"ORB-PROBE","count="+I2S(count)+" A026="+I2S(SuijiMode_UnifiedOrbLevel(source,'A026'))+" A09V="+I2S(SuijiMode_UnifiedOrbLevel(source,'A09V'))+" A0DY="+I2S(SuijiMode_UnifiedOrbLevel(source,'A0DY'))+" AHfa="+I2S(SuijiMode_UnifiedOrbLevel(source,'AHfa'))+" A0LZ="+I2S(SuijiMode_UnifiedOrbLevel(source,'A0LZ'))+" A0OI="+I2S(SuijiMode_UnifiedOrbLevel(source,'A0OI'))+" A0QN="+I2S(SuijiMode_UnifiedOrbLevel(source,'A0QN')))
endif
if count>0 then
call NP7(h,"SuijiUnifiedOrbAttackSeq",OM7(h,"SuijiUnifiedOrbAttackSeq")+1)
call NP7(h,"SuijiUnifiedOrbMasterRevision",UnifiedOrbMasterRevision[GetPlayerId(GetOwningPlayer(source))])
call NT7(h,"SuijiUnifiedOrbAttackTarget",b1060GetTriggerUnit)
call NQ7(h,"SuijiUnifiedOrbAttackTime",TimerGetElapsed(W))
call SuijiMode_UnifiedOrbDebug(source,"ORB-ATTACK","seq="+I2S(OM7(h,"SuijiUnifiedOrbAttackSeq"))+" target="+GetUnitName(b1060GetTriggerUnit)+" active="+I2S(count))
endif
endif
set source=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiMode_UnifiedOrbObserveNative takes nothing returns boolean
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
local unit source=GetTriggerUnit()
local integer skill=SuijiMode_UnifiedOrbCanonical(B287_GetSpellAbilityId())
local integer h=0
if source!=null and SuijiMode_IsUnifiedOrbSkill(skill) and SuijiMode_UnifiedOrbCount(source)>0 then
set h=GetHandleId(source)
call NP7(h,"SuijiUnifiedOrbNativeSkill",skill)
call NP7(h,"SuijiUnifiedOrbNativeSeq",OM7(h,"SuijiUnifiedOrbAttackSeq"))
call NT7(h,"SuijiUnifiedOrbNativeTarget",b1060GetSpellTargetUnit)
call SuijiMode_UnifiedOrbDebug(source,"ORB-NATIVE","seq="+I2S(OM7(h,"SuijiUnifiedOrbAttackSeq"))+" skill="+GetAbilityName(skill)+" target="+GetUnitName(b1060GetSpellTargetUnit))
endif
set source=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function SuijiMode_UnifiedOrbObserveOrder takes nothing returns boolean
local unit source=GetTriggerUnit()
local integer order=GetIssuedOrderId()
if SUIJI_UNIFIED_ORB_PASSIVE and source!=null and IsUnitType(source,UNIT_TYPE_HERO) and SuijiMode_UnifiedOrbCount(source)>0 then
call SuijiMode_ForcePassiveOrbs(source)
elseif order==$D011F or order==$D00CE or order==$D0114 then
call SuijiMode_SetUnifiedOrbFamilyEnabled(source,1,true)
call SuijiMode_SetUnifiedOrbFamilyEnabled(source,2,true)
call SuijiMode_SetUnifiedOrbFamilyEnabled(source,3,true)
endif
set source=null
return false
endfunction
function SuijiMode_UnifiedOrbDamage takes nothing returns boolean
local real orbDamage1060=MHDamageEvent_GetDamage()
local unit source=MHDamageEvent_GetSource()
local unit target=MHEvent_GetUnit()
local integer h=0
local integer nativeSkill=0
local integer attackSeq=0
if source==null or target==null or GetUnitTypeId(source)==0 or IsUnitType(source,UNIT_TYPE_HERO)==false or orbDamage1060<=0. then
set source=null
set target=null
return false
endif
if OO7(GetHandleId(source),"SuijiUnifiedOrbRunning") then
set source=null
set target=null
return false
endif
set h=GetHandleId(source)
if not SuijiMode_UnifiedOrbMasterEnabled(source) or OM7(h,"SuijiUnifiedOrbAttackCount")<1 or OM7(h,"SuijiUnifiedOrbMasterRevision")!=UnifiedOrbMasterRevision[GetPlayerId(GetOwningPlayer(source))] then
set source=null
set target=null
return false
endif
set attackSeq=OM7(h,"SuijiUnifiedOrbAttackSeq")
if attackSeq==0 or O77(h,"SuijiUnifiedOrbAttackTarget")!=target or OM7(h,"SuijiUnifiedOrbProcessedSeq")==attackSeq or TimerGetElapsed(W)-ON7(h,"SuijiUnifiedOrbAttackTime")>5. then
set source=null
set target=null
return false
endif
call NP7(h,"SuijiUnifiedOrbProcessedSeq",attackSeq)
if SUIJI_UNIFIED_ORB_PASSIVE==false and OM7(h,"SuijiUnifiedOrbNativeSeq")==attackSeq and O77(h,"SuijiUnifiedOrbNativeTarget")==target then
set nativeSkill=OM7(h,"SuijiUnifiedOrbNativeSkill")
endif
call SuijiMode_UnifiedOrbDebug(source,"ORB-HIT","seq="+I2S(attackSeq)+" target="+GetUnitName(target)+" native="+GetAbilityName(nativeSkill)+" dmg="+I2S(R2I(orbDamage1060)))
call NS7(h,"SuijiUnifiedOrbRunning",true)
if SuijiMode_UnifiedOrbEnabled(source,'A026') and SuijiMode_UnifiedOrbLevel(source,'A026')>0 and nativeSkill!='A026' then
call SuijiMode_UnifiedOrbApply(source,target,'A026')
endif
if SuijiMode_UnifiedOrbEnabled(source,'A09V') and SuijiMode_UnifiedOrbLevel(source,'A09V')>0 and nativeSkill!='A09V' then
call SuijiMode_UnifiedOrbApply(source,target,'A09V')
endif
if SuijiMode_UnifiedOrbEnabled(source,'A0DY') and SuijiMode_UnifiedOrbLevel(source,'A0DY')>0 and nativeSkill!='A0DY' then
call SuijiMode_UnifiedOrbApply(source,target,'A0DY')
endif
if SuijiMode_UnifiedOrbEnabled(source,'AHfa') and SuijiMode_UnifiedOrbLevel(source,'AHfa')>0 and nativeSkill!='AHfa' then
call SuijiMode_UnifiedOrbApply(source,target,'AHfa')
endif
if SuijiMode_UnifiedOrbEnabled(source,'A0LZ') and SuijiMode_UnifiedOrbLevel(source,'A0LZ')>0 and nativeSkill!='A0LZ' then
call SuijiMode_UnifiedOrbApply(source,target,'A0LZ')
endif
if SuijiMode_UnifiedOrbEnabled(source,'A0OI') and SuijiMode_UnifiedOrbLevel(source,'A0OI')>0 and nativeSkill!='A0OI' then
call SuijiMode_UnifiedOrbApply(source,target,'A0OI')
endif
if SuijiMode_UnifiedOrbEnabled(source,'A0QN') and SuijiMode_UnifiedOrbLevel(source,'A0QN')>0 and nativeSkill!='A0QN' then
call SuijiMode_UnifiedOrbApply(source,target,'A0QN')
endif
call NS7(h,"SuijiUnifiedOrbRunning",false)
set source=null
set target=null
return false
endfunction
function SuijiMode_InitUnifiedOrbController takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function SuijiMode_UnifiedOrbObserveAttack))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiMode_UnifiedOrbObserveNative))
if SUIJI_UNIFIED_ORB_PASSIVE==false then
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function SuijiMode_UnifiedOrbObserveOrder))
endif
set t=CreateTrigger()
call MHDamageEvent_Register(t)
call TriggerAddCondition(t,Condition(function SuijiMode_UnifiedOrbDamage))
set SUIJI_UNIFIED_ORB_READY=true
set t=null
endfunction
function SuijiMode_ClearRandomTinyGrowAghRange takes unit u returns boolean
local integer h=0
local integer previousLevel=0
local real currentRange=0.
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
if OO7(h,"SuijiTinyGrowAghRangeApplied")==false then
return false
endif
set previousLevel=OM7(h,"SuijiTinyGrowAghRangeLevel")
if previousLevel>0 then
set currentRange=GetUnitState(u,UNIT_STATE_ATTACK1_RANGE)
call Unit_Setrange(u,currentRange-50.*previousLevel)
endif
call NS7(h,"SuijiTinyGrowAghRangeApplied",false)
call NP7(h,"SuijiTinyGrowAghRangeLevel",0)
call NQ7(h,"SuijiTinyGrowAghRangeBase",0.)
return true
endfunction
function SuijiMode_SyncRandomTinyGrowAghRange takes unit u,integer level returns boolean
local integer h=0
local integer previousLevel=0
local real currentRange=0.
local real baseRange=0.
if u==null or GetUnitTypeId(u)==0 or level<=0 then
return false
endif
set h=GetHandleId(u)
set currentRange=GetUnitState(u,UNIT_STATE_ATTACK1_RANGE)
if OO7(h,"SuijiTinyGrowAghRangeApplied") then
set previousLevel=OM7(h,"SuijiTinyGrowAghRangeLevel")
set baseRange=ON7(h,"SuijiTinyGrowAghRangeBase")
if RAbsBJ(currentRange-(baseRange+50.*previousLevel))>.5 then
set baseRange=currentRange-50.*previousLevel
call NQ7(h,"SuijiTinyGrowAghRangeBase",baseRange)
endif
else
set baseRange=currentRange
call NS7(h,"SuijiTinyGrowAghRangeApplied",true)
call NQ7(h,"SuijiTinyGrowAghRangeBase",baseRange)
endif
call Unit_Setrange(u,baseRange+50.*level)
call NP7(h,"SuijiTinyGrowAghRangeLevel",level)
return true
endfunction
function SuijiMode_SyncRandomTinyGrow takes unit u returns boolean
local integer level=0
local integer cloneTree=0
local boolean changed=false
if u==null or GetUnitTypeId(u)==0 or SuijiMode_HasRandomSkill(u,'A0CY')==false then
return false
endif
set level=B287_GetUnitAbilityLevel(u,'A0CY')
if level<=0 then
return false
elseif level>3 then
set level=3
endif
call TinyGrow_SyncUnit(u)
if SuijiMode_ScepterRegistryIsActive(u,'A0CY') then
if SuijiMode_SyncRandomTinyGrowAghRange(u,level) then
set changed=true
endif
else
if SuijiMode_ClearRandomTinyGrowAghRange(u) then
set changed=true
endif
endif
if GetUnitAbilityLevel(u,'A4T3')!=level then
if SuijiMode_EnsureExactLiveAbilityLevel(u,'A4T3',level,true) then
set changed=true
else
call NS7(GetHandleId(u),"SuijiAghForceUpdate",true)
endif
endif
set cloneTree=SuijiMode_ToFixedClone('A1VH')
if GetUnitAbilityLevel(u,'A1VH')>0 then
call UnitRemoveAbility(u,'A1VH')
set changed=true
endif
if cloneTree!=0 and GetUnitAbilityLevel(u,cloneTree)>0 then
call UnitRemoveAbility(u,cloneTree)
set changed=true
endif
if GetUnitAbilityLevel(u,'A1VG')>0 then
call UnitRemoveAbility(u,'A1VG')
set changed=true
endif
if GetUnitAbilityLevel(u,'A1W1')>0 then
call UnitRemoveAbility(u,'A1W1')
set changed=true
endif
return changed
endfunction
function SuijiMode_UpdateRandomExtraAghAbilities takes unit u returns nothing
local player p=null
local boolean changed=false
local boolean agh=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set p=GetOwningPlayer(u)
set agh=SuijiMode_HasScepter(u)
if SuijiMode_HasRandomSkill(u,'A0CY') then
if SuijiMode_SyncRandomTinyGrow(u) then
set changed=true
endif
elseif SuijiMode_ClearRandomTinyGrowAghRange(u) then
set changed=true
endif
if SuijiMode_HasRandomSkill(u,'A1YQ') then
if SuijiMode_ScepterRegistryIsActive(u,'A1YQ') then
if GetUnitAbilityLevel(u,'A4HI')<=0 and SuijiMode_EnsureExactLiveAbilityLevel(u,'A4HI',1,true) then
set changed=true
endif
if GetUnitAbilityLevel(u,'A4HI')>0 then
call SetPlayerAbilityAvailable(p,'A4HI',true)
else
call NS7(GetHandleId(u),"SuijiAghForceUpdate",true)
endif
else
if GetUnitAbilityLevel(u,'A4HI')>0 then
call UnitRemoveAbility(u,'A4HI')
set changed=true
endif
call SetPlayerAbilityAvailable(p,'A4HI',false)
endif
endif
if changed then
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
set p=null
endfunction
function SuijiMode_RandomTinyGrowAghSplash takes nothing returns boolean
local unit source=MHDamageEvent_GetSource()
local unit primary=MHEvent_GetUnit()
local unit target=null
local group g=null
local integer h=0
local real damage=MHDamageEvent_GetDamage()
local real factor=.50
if source==null or primary==null or damage<=0. or MHDamageEvent_IsPhysical()==false then
set source=null
set primary=null
return false
endif
if GetUnitTypeId(source)==0 or GetUnitTypeId(primary)==0 then
set source=null
set primary=null
return false
endif
set h=GetHandleId(source)
if SuijiMode_HasRandomSkill(source,'A0CY')==false or SuijiMode_ScepterRegistryIsActive(source,'A0CY')==false or OO7(h,"SuijiTinyGrowAghSplashRunning") then
set source=null
set primary=null
return false
endif
call NS7(h,"SuijiTinyGrowAghSplashRunning",true)
if IsUnitType(primary,UNIT_TYPE_STRUCTURE) then
call MHDamageEvent_SetDamage(damage*1.5)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(primary),GetUnitY(primary),400.,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if target!=primary and UnitAlive(target) and IsUnitEnemy(target,GetOwningPlayer(source)) and GetUnitAbilityLevel(target,'Avul')==0 then
set factor=.50
if IsUnitType(target,UNIT_TYPE_STRUCTURE) then
set factor=.75
endif
call UnitDamageTarget(source,target,damage*factor,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
endif
endloop
call DestroyGroup(g)
call NS7(h,"SuijiTinyGrowAghSplashRunning",false)
set target=null
set g=null
set source=null
set primary=null
return false
endfunction
function SuijiMode_InitRandomTinyGrowAghEffects takes nothing returns nothing
local trigger t=CreateTrigger()
call MHDamageEvent_Register(t)
call TriggerAddCondition(t,Condition(function SuijiMode_RandomTinyGrowAghSplash))
set t=null
endfunction
function SuijiMode_HasRandomSource takes unit u,integer source returns boolean
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
return source!=0 and (OM7(h,"SuijiSmallSource")==source or OM7(h,"SuijiUltSource")==source)
endfunction
function SuijiMode_RemoveRandomInfestAlias takes unit suijiInfestAliasUnit,integer suijiInfestAliasSkill,integer suijiInfestKeepSkill returns boolean
if suijiInfestAliasSkill==suijiInfestKeepSkill or GetUnitAbilityLevel(suijiInfestAliasUnit,suijiInfestAliasSkill)<=0 then
return false
endif
call UnitRemoveAbility(suijiInfestAliasUnit,suijiInfestAliasSkill)
return true
endfunction
function SuijiMode_SyncRandomInfestSingleButton takes unit suijiInfestUnit returns boolean
local integer suijiInfestHandle=0
local integer suijiInfestLogical=0
local integer suijiInfestKeep=0
local boolean suijiInfestChanged=false
if suijiInfestUnit==null or GetUnitTypeId(suijiInfestUnit)==0 then
return false
endif
set suijiInfestHandle=GetHandleId(suijiInfestUnit)
set suijiInfestLogical=OM7(suijiInfestHandle,"SuijiUltSkill")
if suijiInfestLogical!='A0SW' and suijiInfestLogical!='A4FR' then
return false
endif
// Native Lifestealer keeps its engine-owned learnable pair. A foreign OMG
// owner must have exactly one Infest command-card owner even when -omgtest
// grants Scepter before the random slots and an old pair alias materializes.
if SuijiMode_IsNativeRegisteredSkill(suijiInfestUnit,'A0SW') or SuijiMode_IsNativeRegisteredSkill(suijiInfestUnit,'A4FR') then
return false
endif
set suijiInfestKeep=OM7(suijiInfestHandle,"SuijiUltAbility")
if suijiInfestKeep==0 or GetUnitAbilityLevel(suijiInfestUnit,suijiInfestKeep)<=0 then
return false
endif
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'A0SW',suijiInfestKeep) or suijiInfestChanged
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'A4FR',suijiInfestKeep) or suijiInfestChanged
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'Y0D8',suijiInfestKeep) or suijiInfestChanged
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'Y0FN',suijiInfestKeep) or suijiInfestChanged
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'YIF1',suijiInfestKeep) or suijiInfestChanged
set suijiInfestChanged=SuijiMode_RemoveRandomInfestAlias(suijiInfestUnit,'YIF2',suijiInfestKeep) or suijiInfestChanged
if LoadInteger(L7,suijiInfestHandle,4310)==0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiInfestUnit),suijiInfestKeep,true)
endif
return suijiInfestChanged
endfunction
function SuijiMode_HasEarthshakerEnchantTotem takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if SuijiMode_HasRandomSkill(u,'A0DL') then
return true
endif
return SuijiMode_IsNativeEarthshaker(u) and B287_GetUnitAbilityLevel(u,'A0DL')>0
endfunction
function SuijiMode_UpdateEarthSpiritPetrify takes unit suijiEarthSpiritUnit returns nothing
local player suijiEarthSpiritPlayer=null
local boolean suijiEarthSpiritEnable=false
if suijiEarthSpiritUnit==null or GetUnitTypeId(suijiEarthSpiritUnit)==0 or SuijiMode_HasRandomSource(suijiEarthSpiritUnit,58)==false then
return
endif
set suijiEarthSpiritPlayer=GetOwningPlayer(suijiEarthSpiritUnit)
if SuijiMode_EnsureExactLiveAbility(suijiEarthSpiritUnit,'A2VM',true)==false then
set suijiEarthSpiritPlayer=null
return
endif
set suijiEarthSpiritEnable=SuijiMode_ScepterRegistryIsActive(suijiEarthSpiritUnit,'A2V7') and (SuijiMode_HasRandomSkill(suijiEarthSpiritUnit,'A2V7') or SuijiMode_HasRandomSkill(suijiEarthSpiritUnit,'A2Z3'))
call SetPlayerAbilityAvailable(suijiEarthSpiritPlayer,'A2VM',suijiEarthSpiritEnable)
if suijiEarthSpiritEnable then
call SuijiMode_SetExactLiveAbilityLevel(suijiEarthSpiritUnit,'A2VM',1)
endif
set suijiEarthSpiritPlayer=null
endfunction
function B287_ToggleSkillFamily takes integer logicalSkill returns integer
if logicalSkill=='AHfa' then
return 1
elseif logicalSkill=='A06K' or logicalSkill=='A0NE' then
return 2
elseif logicalSkill=='A026' or logicalSkill=='A2ZJ' then
return 3
elseif logicalSkill=='A09V' or logicalSkill=='A4HO' or logicalSkill=='A0OI' or logicalSkill=='A0QN' then
return 4
elseif logicalSkill=='A0SB' then
return 5
elseif logicalSkill=='A28Q' then
return 6
endif
return 0
endfunction
function B287_ToggleCanonicalSkill takes integer logicalSkill returns integer
if logicalSkill=='A2ZJ' then
return 'A026'
elseif logicalSkill=='A4HO' then
return 'A09V'
endif
return logicalSkill
endfunction
function B287_ToggleOrderFamily takes integer orderId returns integer
if orderId==852174 or orderId==852175 then
return 1
elseif orderId==852177 or orderId==852178 then
return 2
elseif orderId==852244 or orderId==852245 then
return 3
elseif orderId==852255 or orderId==852256 then
return 4
elseif orderId==852515 or orderId==852516 then
return 5
elseif orderId==852589 or orderId==852590 then
return 6
endif
return 0
endfunction
function B287_SaveToggleOrder takes unit u,integer logicalSkill,integer orderId,integer orderFamily returns nothing
if logicalSkill!=0 and B287_ToggleSkillFamily(logicalSkill)==orderFamily then
call SaveInteger(SUIJI_FIXED_TOGGLE_TABLE,GetHandleId(u),B287_ToggleCanonicalSkill(logicalSkill),orderId)
endif
endfunction
function B287_TrackToggleOrder takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer orderId=GetIssuedOrderId()
local integer orderFamily=B287_ToggleOrderFamily(orderId)
local integer h=0
if SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 and orderFamily!=0 then
set h=GetHandleId(u)
if OO7(h,"SuijiDone") then
call B287_SaveToggleOrder(u,OM7(h,"SuijiSmallSkill"),orderId,orderFamily)
call B287_SaveToggleOrder(u,OM7(h,"SuijiUltSkill"),orderId,orderFamily)
endif
endif
set u=null
return false
endfunction
function B287_RestoreToggleState takes unit u,integer logicalSkill returns nothing
local integer orderId=0
if u==null or GetUnitTypeId(u)==0 or B287_ToggleSkillFamily(logicalSkill)==0 then
return
endif
set orderId=LoadInteger(SUIJI_FIXED_TOGGLE_TABLE,GetHandleId(u),B287_ToggleCanonicalSkill(logicalSkill))
if orderId!=0 then
call B947IssueImmediateOrderById("B287_RestoreToggleState @ war3map.j:193650 (B968)",u,orderId)
endif
endfunction
function B287_ToggleStateInit takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function B287_TrackToggleOrder))
set t=null
endfunction
function SuijiMode_FindAghPair takes integer skill returns integer
local integer i=0
loop
exitwhen i==YPI
if skill==YTI[i] or skill==YRI[i] then
return i
endif
set i=i+1
endloop
return-1
endfunction
function SuijiMode_GetCooldownMaxAtLevel takes unit u,integer skill,integer level returns real
local real suijiCooldownMax=0.
local real suijiCooldownFactor=0.
if u==null or GetUnitTypeId(u)==0 or skill==0 or level<1 then
return 0.
endif
set suijiCooldownMax=MHAbility_GetLevelDefDataReal(skill,level,ABILITY_LEVEL_DEF_DATA_COOLDOWN)
set suijiCooldownFactor=ReduceUnitAbilityCoolDownReal(u)
if suijiCooldownFactor>0. and suijiCooldownMax>0. then
set suijiCooldownMax=suijiCooldownMax*suijiCooldownFactor
endif
return suijiCooldownMax
endfunction
function SuijiMode_RestoreAbilityCooldown takes unit u,integer skill,integer level,real cooldown returns nothing
local real suijiCooldownMax=0.
if u==null or GetUnitTypeId(u)==0 or skill==0 or level<1 or cooldown<=0. then
return
endif
set suijiCooldownMax=SuijiMode_GetCooldownMaxAtLevel(u,skill,level)
if suijiCooldownMax>0. and cooldown>suijiCooldownMax then
set cooldown=suijiCooldownMax
endif
// EX/JAPI owns the synchronized remaining cooldown.  The MemHack write is a
// best-effort command-card mirror and its client-local validation cannot skip
// the gameplay state restoration.
call YDWESetUnitAbilityState(u,skill,1,cooldown)
if SuijiMode_HasExactLiveAbility(u,skill) then
call MHAbility_SetCooldown(u,skill,cooldown)
endif
endfunction
function SuijiMode_SyncOwnedNativeAghSmallPair takes unit u,integer normalSkill returns nothing
local integer h=0
local integer pair=0
local integer aghSkill=0
local integer desiredSkill=0
local integer removedSkill=0
local integer level=0
local integer normalLevel=0
local integer aghLevel=0
local real cooldown=0.
local real otherCooldown=0.
local player p=null
if u==null or GetUnitTypeId(u)==0 or normalSkill==0 then
return
endif
set h=GetHandleId(u)
set pair=SuijiMode_FindAghPair(normalSkill)
if pair<0 then
return
endif
set aghSkill=YRI[pair]
if aghSkill==0 or OM7(h,"SuijiSmallSkill")==normalSkill or OM7(h,"SuijiSmallSkill")==aghSkill then
return
endif
if SuijiMode_IsFixedPersistentAghPair(normalSkill,aghSkill) then
return
endif
// Native learnable abilities must keep their base rawcode.  Removing it and
// adding the scepter rawcode makes the hero learn menu offer level 1 again;
// the five-second integrity pass then removes that newly learned button.
// These pairs already read the current scepter state in their scripted logic.
if (normalSkill=='A28T' and aghSkill=='A2S2') or (normalSkill=='A026' and aghSkill=='A2ZJ') or (normalSkill=='A09V' and aghSkill=='A4HO') or (normalSkill=='A0DY' and aghSkill=='A1WB') then
return
endif
set normalLevel=GetUnitAbilityLevel(u,normalSkill)
set aghLevel=GetUnitAbilityLevel(u,aghSkill)
if normalLevel<1 and aghLevel<1 then
return
endif
set level=IMaxBJ(normalLevel,aghLevel)
if normalLevel>0 and SuijiMode_HasExactLiveAbility(u,normalSkill) then
set cooldown=B582_GetAbilityCooldown(u,normalSkill)
endif
if aghLevel>0 and SuijiMode_HasExactLiveAbility(u,aghSkill) then
set otherCooldown=B582_GetAbilityCooldown(u,aghSkill)
endif
if otherCooldown>cooldown then
set cooldown=otherCooldown
endif
if SuijiMode_HasScepter(u) then
set desiredSkill=aghSkill
set removedSkill=normalSkill
else
set desiredSkill=normalSkill
set removedSkill=aghSkill
endif
set p=GetOwningPlayer(u)
if SuijiMode_EnsureExactLiveAbilityLevel(u,desiredSkill,level,true)==false then
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
call SuijiMode_RestoreAbilityCooldown(u,desiredSkill,level,cooldown)
call SuijiMode_ApplyNativeVariantButtonSlot(u,normalSkill,desiredSkill)
if SuijiMode_ShouldRestoreVisibleAbility(u,desiredSkill) then
call SetPlayerAbilityAvailable(p,desiredSkill,true)
endif
if GetUnitAbilityLevel(u,removedSkill)>0 then
call SetPlayerAbilityAvailable(p,removedSkill,false)
call UnitRemoveAbility(u,removedSkill)
endif
set p=null
endfunction
function SuijiMode_SyncOwnedNativeAghSmallSkills takes unit u returns nothing
local integer source=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set source=SuijiMode_GetStableHeroIndex(u)
if source<KL4 or source>K54 then
return
endif
call SuijiMode_SyncOwnedNativeAghSmallPair(u,HM4[source])
call SuijiMode_SyncOwnedNativeAghSmallPair(u,HN4[source])
call SuijiMode_SyncOwnedNativeAghSmallPair(u,HO4[source])
endfunction
function SuijiMode_SyncAghSmall takes unit u returns nothing
local integer h=0
local integer currentSkill=0
local integer currentAbility=0
local integer helper=0
local integer pair=0
local integer desiredSkill=0
local integer desiredAbility=0
local integer level=0
local player p=null
local real switchCooldown=0.
local boolean desiredWasPresent=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set currentSkill=OM7(h,"SuijiSmallSkill")
set currentAbility=OM7(h,"SuijiSmallAbility")
set helper=OM7(h,"SuijiSmallHelper")
if currentSkill==0 then
return
endif
if currentAbility==0 then
set currentAbility=SuijiMode_GetPhysicalSkill(u,currentSkill)
call NP7(h,"SuijiSmallAbility",currentAbility)
endif
if helper==0 and SuijiMode_CanSkipHelper(currentSkill)==false then
return
endif
set pair=SuijiMode_FindAghPair(currentSkill)
if pair<0 then
return
endif
if SuijiMode_IsFixedPersistentAghPair(YTI[pair],YRI[pair]) then
set desiredSkill=YTI[pair]
elseif SuijiMode_HasScepter(u) then
set desiredSkill=YRI[pair]
else
set desiredSkill=YTI[pair]
endif
if desiredSkill==0 or desiredSkill==currentSkill then
return
endif
set desiredAbility=SuijiMode_GetGrantSkill(desiredSkill)
if SuijiMode_HasNativeAbility(u,currentAbility)==false then
call NS7(h,"SuijiAghForceUpdate",true)
return
endif
set level=GetUnitAbilityLevel(u,currentAbility)
if level<1 then
set level=SuijiMode_SmallLevel(u)
endif
set p=GetOwningPlayer(u)
if SuijiMode_HasExactLiveAbility(u,currentAbility) then
set switchCooldown=B582_GetAbilityCooldown(u,currentAbility)
endif
set desiredWasPresent=SuijiMode_HasNativeAbility(u,desiredAbility)
if SuijiMode_EnsureExactLiveAbilityLevel(u,desiredAbility,level,true)==false then
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
call NP7(h,"SuijiSmallSkill",desiredSkill)
call NP7(h,"SuijiSmallAbility",desiredAbility)
call SuijiMode_InitCopiedSkill(u,desiredSkill,level)
if SuijiMode_HasNativeAbility(u,desiredAbility)==false then
call NP7(h,"SuijiSmallSkill",currentSkill)
call NP7(h,"SuijiSmallAbility",currentAbility)
if desiredWasPresent==false then
call UnitRemoveAbility(u,desiredAbility)
endif
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
call SuijiMode_RestoreAbilityCooldown(u,desiredAbility,level,switchCooldown)
if currentAbility!=desiredAbility then
call SetPlayerAbilityAvailable(p,currentAbility,false)
call UnitRemoveAbility(u,currentAbility)
endif
if SuijiMode_ShouldRestoreVisibleAbility(u,desiredSkill) then
call SetPlayerAbilityAvailable(p,desiredAbility,true)
endif
call B287_RestoreToggleState(u,desiredSkill)
call SuijiMode_ApplyHotkey(u,desiredAbility,"SuijiSmall",OP7(h,"SuijiSmallOrder"))
set p=null
endfunction
function SuijiMode_SyncAghUltimate takes unit u returns nothing
local integer h=0
local integer source=0
local integer poolIndex=KL4
local integer normalSkill=0
local integer normalHelper=0
local integer aghSkill=0
local integer aghHelper=0
local integer currentSkill=0
local integer currentAbility=0
local integer currentHelper=0
local integer desiredSkill=0
local integer desiredAbility=0
local integer desiredHelper=0
local integer level=0
local player p=null
local real switchCooldown=0.
local boolean suijiAghUltimateChanged=false
local boolean desiredAbilityWasPresent=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set source=OM7(h,"SuijiUltSource")
set currentSkill=OM7(h,"SuijiUltSkill")
set currentAbility=OM7(h,"SuijiUltAbility")
set currentHelper=OM7(h,"SuijiUltHelper")
if source<KL4 or source>K54 then
return
endif
if currentSkill!=0 and currentAbility==0 then
set currentAbility=SuijiMode_GetPhysicalSkill(u,currentSkill)
call NP7(h,"SuijiUltAbility",currentAbility)
endif
loop
exitwhen poolIndex>SUIJI_POOL_MAX or normalSkill!=0
if SuijiMode_GetPoolSkillSource(poolIndex,currentSkill)==source and (HP4[poolIndex]==currentSkill or HQ4[poolIndex]==currentSkill) then
set normalSkill=HP4[poolIndex]
set normalHelper=HU4[poolIndex]
set aghSkill=HQ4[poolIndex]
set aghHelper=HV4[poolIndex]
endif
set poolIndex=poolIndex+1
endloop
if aghSkill==0 or (aghHelper==0 and SuijiMode_CanSkipHelper(aghSkill)==false) then
return
endif
if source==81 or source==90 or SuijiMode_IsFixedPersistentAghPair(normalSkill,aghSkill) then
set desiredSkill=normalSkill
set desiredHelper=normalHelper
elseif SuijiMode_HasScepter(u) then
set desiredSkill=aghSkill
set desiredHelper=aghHelper
else
set desiredSkill=normalSkill
set desiredHelper=normalHelper
endif
if desiredSkill==0 or (desiredHelper==0 and SuijiMode_CanSkipHelper(desiredSkill)==false) then
return
endif
set desiredAbility=SuijiMode_GetCarrierGrantSkill(desiredSkill,OP7(h,"SuijiUltOrder"))
set level=SuijiMode_UltLevel(u)
if level<1 then
set level=1
endif
set p=GetOwningPlayer(u)
if currentSkill!=desiredSkill then
if currentAbility!=0 and SuijiMode_HasExactLiveAbility(u,currentAbility) then
set switchCooldown=B582_GetAbilityCooldown(u,currentAbility)
endif
set desiredAbilityWasPresent=SuijiMode_HasNativeAbility(u,desiredAbility)
if SuijiMode_EnsureExactLiveAbilityLevel(u,desiredAbility,level,true)==false then
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
call NP7(h,"SuijiUltSkill",desiredSkill)
call NP7(h,"SuijiUltAbility",desiredAbility)
call NP7(h,"SuijiUltHelper",desiredHelper)
call SuijiMode_InitCopiedSkill(u,desiredSkill,level)
if SuijiMode_HasNativeAbility(u,desiredAbility)==false then
call NP7(h,"SuijiUltSkill",currentSkill)
call NP7(h,"SuijiUltAbility",currentAbility)
call NP7(h,"SuijiUltHelper",currentHelper)
if desiredAbilityWasPresent==false then
call UnitRemoveAbility(u,desiredAbility)
endif
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
if switchCooldown>0. then
call SuijiMode_RestoreAbilityCooldown(u,desiredAbility,level,switchCooldown)
endif
if currentAbility!=0 and currentAbility!=desiredAbility then
call SetPlayerAbilityAvailable(p,currentAbility,false)
call UnitRemoveAbility(u,currentAbility)
endif
set suijiAghUltimateChanged=true
endif
if SuijiMode_HasNativeAbility(u,desiredAbility)==false then
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
if SuijiMode_ShouldRestoreVisibleAbility(u,desiredSkill) then
call SetPlayerAbilityAvailable(p,desiredAbility,true)
endif
if GetUnitAbilityLevel(u,desiredAbility)!=level then
if SuijiMode_SetExactLiveAbilityLevel(u,desiredAbility,level)==false then
call NS7(h,"SuijiAghForceUpdate",true)
set p=null
return
endif
set suijiAghUltimateChanged=true
endif
if suijiAghUltimateChanged and switchCooldown>0. then
call SuijiMode_RestoreAbilityCooldown(u,desiredAbility,level,switchCooldown)
endif
if suijiAghUltimateChanged then
call B287_RestoreToggleState(u,desiredSkill)
endif
call SuijiMode_ApplyHotkey(u,desiredAbility,"SuijiUlt",OP7(h,"SuijiUltOrder"))
call SuijiMode_SyncOwnedChargeButtonSlot(u,desiredSkill,"SuijiUlt")
set p=null
endfunction
function SuijiMode_NormalizeA190WithoutAgh takes unit suijiA190Unit,player suijiA190Player returns nothing
local integer suijiA190Handle=0
local integer suijiA190Level=0
local integer suijiA190Ability=0
local string suijiA190Mark=""
local string suijiA190Order=""
if suijiA190Unit==null or GetUnitTypeId(suijiA190Unit)==0 then
return
endif
set suijiA190Handle=GetHandleId(suijiA190Unit)
if OM7(suijiA190Handle,"SuijiSmallSkill")=='A4IL' then
set suijiA190Mark="SuijiSmall"
set suijiA190Order=OP7(suijiA190Handle,"SuijiSmallOrder")
set suijiA190Level=GetUnitAbilityLevel(suijiA190Unit,'A4IL')
if suijiA190Level<1 then
set suijiA190Level=SuijiMode_SmallLevel(suijiA190Unit)
endif
elseif OM7(suijiA190Handle,"SuijiUltSkill")=='A4IL' then
set suijiA190Mark="SuijiUlt"
set suijiA190Order=OP7(suijiA190Handle,"SuijiUltOrder")
set suijiA190Level=GetUnitAbilityLevel(suijiA190Unit,'A4IL')
if suijiA190Level<1 then
set suijiA190Level=SuijiMode_UltLevel(suijiA190Unit)
endif
endif
if suijiA190Mark!="" then
if suijiA190Level<1 then
set suijiA190Level=1
endif
set suijiA190Ability=SuijiMode_GetGrantSkill('A190')
if SuijiMode_EnsureExactLiveAbilityLevel(suijiA190Unit,suijiA190Ability,suijiA190Level,true)==false then
set suijiA190Mark=""
set suijiA190Order=""
return
endif
call SetPlayerAbilityAvailable(suijiA190Player,suijiA190Ability,true)
call SetPlayerAbilityAvailable(suijiA190Player,'A4IL',false)
if GetUnitAbilityLevel(suijiA190Unit,'A4IL')>0 then
call UnitRemoveAbility(suijiA190Unit,'A4IL')
endif
call NP7(suijiA190Handle,suijiA190Mark+"Skill",'A190')
call NP7(suijiA190Handle,suijiA190Mark+"Ability",suijiA190Ability)
call SuijiMode_InitCopiedSkill(suijiA190Unit,'A190',suijiA190Level)
call SuijiMode_ApplyHotkey(suijiA190Unit,suijiA190Ability,suijiA190Mark,suijiA190Order)
else
call SetPlayerAbilityAvailable(suijiA190Player,'A4IL',false)
if GetUnitAbilityLevel(suijiA190Unit,'A4IL')>0 then
call UnitRemoveAbility(suijiA190Unit,'A4IL')
endif
endif
set suijiA190Mark=""
set suijiA190Order=""
endfunction
function SuijiMode_UpdateAghCompanion takes unit u,integer skill1,integer skill2,integer skill3,integer skill4,integer companion,boolean visible returns nothing
local integer h=0
local integer key=0
local player p=null
local boolean owns=false
local boolean active=false
if u==null or GetUnitTypeId(u)==0 or companion==0 then
return
endif
set h=GetHandleId(u)
set key=StringHash("SuijiAghCompanion"+I2S(companion))
set p=GetOwningPlayer(u)
set owns=SuijiMode_HasRandomSkill(u,skill1) or SuijiMode_HasRandomSkill(u,skill2) or SuijiMode_HasRandomSkill(u,skill3) or SuijiMode_HasRandomSkill(u,skill4)
set active=SuijiMode_HasScepter(u)
if SuijiMode_ScepterRegistryIsRegistered(u,skill1) then
set active=SuijiMode_ScepterRegistryIsActive(u,skill1)
elseif SuijiMode_ScepterRegistryIsRegistered(u,skill2) then
set active=SuijiMode_ScepterRegistryIsActive(u,skill2)
elseif SuijiMode_ScepterRegistryIsRegistered(u,skill3) then
set active=SuijiMode_ScepterRegistryIsActive(u,skill3)
elseif SuijiMode_ScepterRegistryIsRegistered(u,skill4) then
set active=SuijiMode_ScepterRegistryIsActive(u,skill4)
endif
if owns and active then
if SuijiMode_EnsureExactLiveAbilityLevel(u,companion,1,true) then
call SuijiMode_SyncStateReplaceBaseSlot(u,companion)
call SaveBoolean(L7,h,key,true)
call SetPlayerAbilityAvailable(p,companion,visible)
else
call NS7(h,"SuijiAghForceUpdate",true)
endif
elseif LoadBoolean(L7,h,key) then
call SetPlayerAbilityAvailable(p,companion,false)
call UnitRemoveAbility(u,companion)
call RemoveSavedBoolean(L7,h,key)
endif
set p=null
endfunction
// Random Multicast keeps only its probability upgrade.  Unrefined Fireblast
// remains an Ogre Magi native Scepter companion and is never granted by an OMG
// copy of Multicast.
function SuijiMode_DisableRandomMulticastCompanion takes unit u returns nothing
local integer h=0
local player p=null
if u==null or GetUnitTypeId(u)==0 or GetUnitTypeId(u)=='Hmkg' or SuijiMode_HasRandomSkill(u,'A088')==false then
return
endif
set h=GetHandleId(u)
set p=GetOwningPlayer(u)
call NS7(h,"AI|Magi2Blast",false)
call SetPlayerAbilityAvailable(p,'A2KQ',false)
if GetUnitAbilityLevel(u,'A2KQ')>0 and SuijiMode_HasRandomSkill(u,'A2KQ')==false then
call UnitRemoveAbility(u,'A2KQ')
endif
call RemoveSavedBoolean(L7,h,StringHash("SuijiAghCompanion"+I2S('A2KQ')))
set p=null
endfunction
function SuijiMode_UpdateRegisteredAghCompanion takes unit u,integer logicalSkill,integer companion,boolean visible returns nothing
local integer h=0
local integer key=0
local player p=null
local boolean active=false
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 or companion==0 or SuijiMode_ScepterRegistryIsRegistered(u,logicalSkill)==false then
return
endif
// A companion that was independently rolled as a random skill belongs to that
// slot and must never be removed by the scepter state synchronizer.
if SuijiMode_HasRandomSkill(u,companion) then
return
endif
set h=GetHandleId(u)
set key=StringHash("SuijiRegisteredAghCompanion"+I2S(companion))
set p=GetOwningPlayer(u)
set active=SuijiMode_ScepterRegistryIsActive(u,logicalSkill)
if active then
if SuijiMode_EnsureExactLiveAbilityLevel(u,companion,1,true) then
call SuijiMode_SyncStateReplaceBaseSlot(u,companion)
call SaveBoolean(L7,h,key,true)
call SetPlayerAbilityAvailable(p,companion,visible)
else
call NS7(h,"SuijiAghForceUpdate",true)
endif
elseif LoadBoolean(L7,h,key) then
call SetPlayerAbilityAvailable(p,companion,false)
if GetUnitAbilityLevel(u,companion)>0 then
call UnitRemoveAbility(u,companion)
endif
call RemoveSavedBoolean(L7,h,key)
endif
set p=null
endfunction
function SuijiMode_SyncRegisteredFervorAgh takes unit u returns nothing
local integer h=0
if u==null or GetUnitTypeId(u)==0 or SuijiMode_ScepterRegistryIsRegistered(u,'A0O0')==false then
return
endif
set h=GetHandleId(u)
if SuijiMode_ScepterRegistryIsActive(u,'A0O0') then
call MHUnit_SetAttackSpeedLimit(u,8.)
call NS7(h,"SuijiFervorAghSpeedLimit",true)
elseif OO7(h,"SuijiFervorAghSpeedLimit") then
call MHUnit_ResetAttackSpeedLimit(u)
call NS7(h,"SuijiFervorAghSpeedLimit",false)
endif
endfunction
function SuijiMode_UpdateFixedAghTooltipPair takes unit u,integer normalSkill,integer aghSkill,boolean hasAgh returns nothing
local integer level=1
local integer maxLevel=0
local string tip=null
local string ubertip=null
if u==null or GetUnitTypeId(u)==0 or normalSkill==0 or aghSkill==0 or B287_GetUnitAbilityLevel(u,normalSkill)==0 then
return
endif
set maxLevel=IMaxBJ(MHAbility_GetDefDataInt(normalSkill,ABILITY_DEF_DATA_MAX_LEVEL),MHAbility_GetDefDataInt(aghSkill,ABILITY_DEF_DATA_MAX_LEVEL))
if maxLevel<1 then
set maxLevel=1
endif
loop
exitwhen level>maxLevel
if hasAgh then
set tip=MHAbility_GetLevelDefDataStr(aghSkill,level,ABILITY_LEVEL_DEF_DATA_TIP)
set ubertip=MHAbility_GetLevelDefDataStr(aghSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
if tip==null or tip=="" then
set tip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP)
endif
if ubertip==null or ubertip=="" then
set ubertip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
endif
call B287_MHAbility_SetCustomLevelDataStr(u,normalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP,tip+" |cffffcc00[神杖]|r")
call B287_MHAbility_SetCustomLevelDataStr(u,normalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,ubertip+"|n|n|cffffcc00当前：神杖效果已启用|r")
else
set tip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP)
set ubertip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
call B287_MHAbility_SetCustomLevelDataStr(u,normalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP,tip)
call B287_MHAbility_SetCustomLevelDataStr(u,normalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,ubertip)
endif
set level=level+1
endloop
set tip=null
set ubertip=null
endfunction
function SuijiMode_UpdateFixedAghTooltips takes unit u,boolean hasAgh returns nothing
local integer i=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
loop
exitwhen i>=YPI
if SuijiMode_IsFixedPersistentAghPair(YTI[i],YRI[i]) then
call SuijiMode_UpdateFixedAghTooltipPair(u,YTI[i],YRI[i],hasAgh)
endif
set i=i+1
endloop
endfunction
function SuijiMode_SyncOgreNativeAghState takes unit u,boolean hasAgh returns nothing
local integer h=0
local integer state=0
local integer aiFlag=0
local player p=null
if u==null or GetUnitTypeId(u)!='Hmkg' then
return
endif
set h=GetHandleId(u)
set p=GetOwningPlayer(u)
if hasAgh then
set state=1
if GetUnitAbilityLevel(u,'A2KT')==0 then
call XF7(u,'A2KT')
call UnitMakeAbilityPermanent(u,true,'A2KT')
endif
call SetPlayerAbilityAvailable(p,'A2KT',false)
if GetUnitAbilityLevel(u,'A2KQ')==0 then
call XF7(u,'A2KQ')
endif
call SetPlayerAbilityAvailable(p,'A2KQ',true)
call NS7(h,"AI|Magi2Blast",true)
else
call NS7(h,"AI|Magi2Blast",false)
call SetPlayerAbilityAvailable(p,'A2KQ',false)
if GetUnitAbilityLevel(u,'A2KQ')>0 then
call UnitRemoveAbility(u,'A2KQ')
endif
if GetUnitAbilityLevel(u,'A2KT')>0 then
call UnitRemoveAbility(u,'A2KT')
endif
endif
call SuijiMode_FixOgreNativeSkillVisibility(u)
if OO7(h,"AI|Magi2Blast") then
set aiFlag=1
endif
call SuijiTest_DebugUnit(u,"OGREAGH","B408 source="+I2S(state)+" A2KT="+I2S(GetUnitAbilityLevel(u,'A2KT'))+" A2KQ="+I2S(GetUnitAbilityLevel(u,'A2KQ'))+" AI="+I2S(aiFlag)+" multicast="+I2S(B287_GetUnitAbilityLevel(u,'A088')))
if SuijiTest_HasPreset(GetPlayerId(p)) then
call DisplayTimedTextToPlayer(p,0,0,20.,"|cFFFFCC00[B408 OgreAgh]|r source="+I2S(state)+" A2KT="+I2S(GetUnitAbilityLevel(u,'A2KT'))+" A2KQ="+I2S(GetUnitAbilityLevel(u,'A2KQ'))+" AI="+I2S(aiFlag)+" multicast="+I2S(B287_GetUnitAbilityLevel(u,'A088')))
endif
set p=null
endfunction
function SuijiMode_UpdateAghSkills takes unit u returns nothing
local integer h=0
local boolean agh=false
local boolean aghKnown=false
local boolean aghChanged=false
local boolean aghForce=false
local boolean registryChanged=false
local player p=null
local integer level=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if SUIJI_MODE==false or OO7(h,"SuijiDone")==false then
return
endif
set agh=SuijiMode_HasScepter(u)
set aghKnown=OO7(h,"SuijiAghStateKnown")
set aghChanged=aghKnown==false or OO7(h,"SuijiHasScepter")!=agh
set aghForce=OO7(h,"SuijiAghForceUpdate")
if aghKnown==false then
call NS7(h,"SuijiAghStateKnown",true)
endif
if aghChanged then
call NS7(h,"SuijiHasScepter",agh)
endif
if aghForce then
call NS7(h,"SuijiAghForceUpdate",false)
endif
call SuijiMode_SyncRandomAttackRange(u)
call SuijiMode_NormalizeNativePudgeAgh(u)
call SuijiMode_NormalizeNativePersistentAgh(u)
call SuijiMode_NormalizePersistentPairAbility(u,'A0MQ','A1B6')
call SuijiMode_NormalizePersistentPairAbility(u,'A0MW','A27C')
call SuijiMode_NormalizePersistentPairAbility(u,'A0OR','A4K0')
call SuijiMode_NormalizePersistentPairAbility(u,'A11T','A4AS')
set registryChanged=SuijiMode_ScepterRegistryRefreshBatch(u,agh)
if SuijiMode_SyncRandomInfestSingleButton(u) then
set registryChanged=true
endif
call SuijiMode_DisableRandomMulticastCompanion(u)
call SuijiMode_SyncRegisteredFervorAgh(u)
call SuijiMode_SyncDividedWeStandAgh(u)
if registryChanged then
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
if aghChanged or aghForce or registryChanged then
call B1099EarthReconcileStoneOrder(u)
endif
if aghChanged==false and aghForce==false and registryChanged==false then
call SuijiMode_UpdateCopiedInvokerLevels(u)
call BristlebackAghActive_SyncButton(u)
return
endif
set p=GetOwningPlayer(u)
call SuijiMode_SyncOgreNativeAghState(u,SuijiMode_ScepterRegistryIsActive(u,'A088'))
call SuijiMode_NormalizeNativeEarthshakerAgh(u)
call SuijiMode_NormalizeNativeSandKingAgh(u)
call SuijiMode_NormalizeNativeNevermoreAgh(u)
call SuijiMode_NormalizeNativePersistentAgh(u)
call SuijiMode_NormalizeNativePudgeAgh(u)
call SuijiMode_NormalizePersistentPairAbility(u,'A0MQ','A1B6')
call SuijiMode_NormalizePersistentPairAbility(u,'A0MW','A27C')
call SuijiMode_NormalizePersistentPairAbility(u,'A0OR','A4K0')
call SuijiMode_NormalizePersistentPairAbility(u,'A11T','A4AS')
call SuijiMode_UpdateRandomExtraAghAbilities(u)
call SuijiMode_SyncOwnedNativeAghSmallSkills(u)
if agh==false then
call SuijiMode_NormalizeA190WithoutAgh(u,p)
endif
call SuijiMode_SyncAghUltimate(u)
call SuijiMode_SyncAghSmall(u)
call SuijiMode_NormalizeNativeSandKingAgh(u)
call SuijiMode_NormalizeNativeNevermoreAgh(u)
call SuijiMode_NormalizeNativePersistentAgh(u)
call SuijiMode_NormalizeNativePudgeAgh(u)
call SuijiMode_UpdateCopiedInvokerLevels(u)
if SuijiMode_HasRandomSource(u,58) then
call SuijiMode_UpdateEarthSpiritPetrify(u)
endif
if SuijiMode_HasRandomSkill(u,'A0KV') then
call Mirana_EnsureStarfallScepter(u)
endif
if SuijiMode_HasRandomSkill(u,'A0RP') then
call TemplarAssassin_EnsureTrapScepter(u)
endif
if SuijiMode_HasRandomSkill(u,'A0VC') or GetUnitTypeId(u)=='Nbrn' then
call Marksmanship_UpdateScepterState(u)
endif
// Nimbus is the Scepter companion of Lightning Bolt itself. A source-wide
// Zeus check incorrectly granted a useless extra cloud to Arc Lightning-only
// rolls, even though the cloud effect reads A2QB's level for every strike.
if SuijiMode_HasRandomSkill(u,'A2QB') then
call NS7(h,"SuijiZeusNimbus",true)
call ZeusNimbus_Update(u)
elseif GetUnitTypeId(u)=='Hmbr' then
call NS7(h,"SuijiZeusNimbus",false)
call ZeusNimbus_Update(u)
else
call NS7(h,"SuijiZeusNimbus",false)
if GetUnitAbilityLevel(u,'A3NB')>0 then
call SuijiMode_SyncNativeAghCompanion(u,'A3NB',0,false,true)
endif
endif
if SuijiMode_HasRandomSource(u,7) then
call NS7(h,"SuijiNagaScepter",true)
call NagaSirenAghMirror_Update(u)
call NagaSirenRipTide_Update(u)
else
call NS7(h,"SuijiNagaScepter",false)
endif
call SuijiMode_UpdateAghCompanion(u,'A2E5','A2SH',0,0,'A2SI',true)
if SuijiMode_HasNativeAbility(u,'A2SI') then
set level=IMaxBJ(GetUnitAbilityLevel(u,'A2E5'),GetUnitAbilityLevel(u,'A2SH'))
if level<1 then
set level=1
endif
call SuijiMode_SetExactLiveAbilityLevel(u,'A2SI',level)
endif
call SuijiMode_UpdateAghCompanion(u,'A0H9',0,0,0,'A4B6',true)
call SuijiMode_UpdateAghCompanion(u,'A07Z',0,0,0,'A1G7',true)
call SuijiMode_UpdateAghCompanion(u,'A1AA','A1A8','A1A1',0,'A4KK',true)
call SuijiMode_UpdateAghCompanion(u,'A0MG','A0NS','A1DA',0,'A4LQ',true)
call SuijiMode_UpdateAghCompanion(u,'A2W1',0,0,0,'A0D7',true)
call SuijiMode_SyncNativeAghCompanion(u,'ZBBA',1,SuijiMode_ScepterRegistryIsRegistered(u,'A0M3') and SuijiMode_ScepterRegistryIsActive(u,'A0M3'),true)
// Keep legacy native Scepter books on their original heroes, but never attach
// their Aspb/ANeg controllers to an arbitrary OMG owner. A02S and A11T are
// registry/script-owned; Ravage is the only random path that still owns A4GC.
call SuijiMode_UpdateAghCompanion(u,0,0,0,0,'A4FL',false)
call SuijiMode_UpdateAghCompanion(u,'A29I','A2UL',0,0,'A4GC',false)
call SuijiMode_UpdateRegisteredAghCompanion(u,'A4EU','A194',true)
// Astral charges own their visible button; the legacy A4A4 ANeg book creates
// a second command owner and must not be attached to an OMG copy.
call SuijiMode_UpdateAghCompanion(u,0,0,0,0,'A4A4',false)
call SuijiMode_UpdateAghCompanion(u,'A0SW','A4FR',0,0,'A4EV',false)
call SuijiMode_UpdateAghCompanion(u,'A0SW','A4FR',0,0,'A4EW',false)
if SuijiMode_HasEarthshakerEnchantTotem(u) then
if SuijiMode_ScepterRegistryIsActive(u,'A0DL') then
set level=B287_GetUnitAbilityLevel(u,'A0DL')
if level<1 then
set level=1
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,'A4LZ',level,true) then
call SetPlayerAbilityAvailable(p,'A4LZ',true)
call B1000TotemLeapCastpoint(u)
else
call NS7(h,"SuijiAghForceUpdate",true)
endif
else
call SetPlayerAbilityAvailable(p,'A4LZ',false)
endif
endif
if SuijiMode_HasRandomSkill(u,'A190') then
if agh then
set level=B287_GetUnitAbilityLevel(u,'A190')
if level<1 then
set level=SuijiMode_SmallLevel(u)
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,'A4IL',level,true) then
call SetPlayerAbilityAvailable(p,'A4IL',true)
else
call NS7(h,"SuijiAghForceUpdate",true)
endif
else
call SetPlayerAbilityAvailable(p,'A4IL',false)
if GetUnitAbilityLevel(u,'A4IL')>0 then
call UnitRemoveAbility(u,'A4IL')
endif
endif
endif
if aghChanged or aghForce then
// Do not rewrite live ability tooltips during command-card rebuilds. The static
// tooltip still documents the upgrade, while the actual scepter state remains
// synchronized by the ability-pair and companion logic above.
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
// Companion and spellbook changes above rebuild the command card.  Restore the
// two OMG fixed-clone slots afterward so passive Multicast cannot overlap the
// active small-skill button.
call SuijiMode_SyncRandomInfestSingleButton(u)
call SuijiMode_ApplyButtonSlot(u,OM7(h,"SuijiSmallAbility"),"SuijiSmall")
call SuijiMode_ApplyButtonSlot(u,OM7(h,"SuijiUltAbility"),"SuijiUlt")
call SuijiMode_SyncOwnedChargeButtonSlot(u,OM7(h,"SuijiSmallSkill"),"SuijiSmall")
call SuijiMode_SyncOwnedChargeButtonSlot(u,OM7(h,"SuijiUltSkill"),"SuijiUlt")
// Generic slot repair above must finish first. Bristleback's Scepter active
// then becomes the sole visible owner of this logical command-card slot.
call BristlebackAghActive_SyncButton(u)
set p=null
endfunction
function SuijiMode_UpdateAghSkillsAfterBlessing takes nothing returns nothing
call SuijiMode_UpdateAghSkills(SUIJI_AGH_UPDATE_UNIT)
set SUIJI_AGH_UPDATE_UNIT=null
endfunction
function SuijiMode_FixCommandButton takes integer skill,integer x,integer y returns nothing
local integer i=1
local integer b=0
if skill==0 then
return
endif
loop
exitwhen i>12
set b=MHUI_GetSkillBarButton(i)
if b!=0 and MHUIData_GetCommandButtonAbility(b)==skill then
call MHUIData_SetCommandButtonXY(b,x,y)
endif
set i=i+1
endloop
endfunction
function SuijiMode_FixCommandOrderButton takes integer suijiCommandOrder,integer x,integer y returns nothing
local integer suijiCommandOrderIndex=1
local integer suijiCommandOrderButton=0
loop
exitwhen suijiCommandOrderIndex>12
set suijiCommandOrderButton=MHUI_GetSkillBarButton(suijiCommandOrderIndex)
if suijiCommandOrderButton!=0 and MHUIData_GetCommandButtonOrderId(suijiCommandOrderButton)==suijiCommandOrder then
call MHUIData_SetCommandButtonXY(suijiCommandOrderButton,x,y)
endif
set suijiCommandOrderIndex=suijiCommandOrderIndex+1
endloop
endfunction
function SuijiMode_HideEmptyCommandSlot takes integer x,integer y returns nothing
local integer suijiCommandSlotIndex=1
local integer suijiCommandSlotButton=0
loop
exitwhen suijiCommandSlotIndex>12
set suijiCommandSlotButton=MHUI_GetSkillBarButton(suijiCommandSlotIndex)
if suijiCommandSlotButton!=0 and MHUIData_GetCommandButtonX(suijiCommandSlotButton)==x and MHUIData_GetCommandButtonY(suijiCommandSlotButton)==y and MHUIData_GetCommandButtonAbility(suijiCommandSlotButton)==0 then
call MHUIData_SetCommandButtonXY(suijiCommandSlotButton,0,-11)
endif
set suijiCommandSlotIndex=suijiCommandSlotIndex+1
endloop
endfunction
function SuijiMode_FixCommandCardSpace takes nothing returns nothing
call SuijiMode_HideEmptyCommandSlot(0,0)
call SuijiMode_FixCommandOrderButton(851990,0,-11)
call SuijiMode_FixCommandOrderButton(851993,0,-11)
call SuijiMode_FixCommandButton('AHer',0,-11)
call SuijiMode_FixCommandButton('Aamk',0,-11)
call SuijiMode_FixCommandButton('A0NR',0,-11)
endfunction
function SuijiMode_FixSelectedButtons takes nothing returns boolean
local unit u=null
local integer h=0
local integer selectedHandle=0
if SUIJI_FIXED_CLONE_ALL then
return false
endif
set u=MHPlayer_GetSelectUnit()
if SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 then
set h=GetHandleId(u)
if OO7(h,"SuijiDone") then
set selectedHandle=h
if SUIJI_UI_PENDING_UNIT!=selectedHandle or SUIJI_UI_PENDING_REVISION!=SUIJI_UI_CARD_REVISION then
set SUIJI_UI_PENDING_UNIT=selectedHandle
set SUIJI_UI_PENDING_REVISION=SUIJI_UI_CARD_REVISION
set u=null
return false
endif
if SUIJI_UI_APPLIED_UNIT==selectedHandle and SUIJI_UI_APPLIED_REVISION==SUIJI_UI_CARD_REVISION then
set u=null
return false
endif
call SuijiMode_FixCommandCardSpace()
call SuijiMode_FixCommandButton(OM7(h,"SuijiSmallSkill"),0,0)
call SuijiMode_FixCommandButton(OM7(h,"SuijiUltSkill"),2,0)
if SuijiMode_HasEarthshakerEnchantTotem(u) then
call SuijiMode_FixCommandButton('A4LZ',1,1)
endif
if SuijiMode_HasRandomSource(u,2) then
call SuijiMode_FixCommandButton('A3NB',2,1)
endif
set SUIJI_UI_APPLIED_UNIT=selectedHandle
set SUIJI_UI_APPLIED_REVISION=SUIJI_UI_CARD_REVISION
else
set SUIJI_UI_PENDING_UNIT=0
set SUIJI_UI_APPLIED_UNIT=0
endif
else
set SUIJI_UI_PENDING_UNIT=0
set SUIJI_UI_APPLIED_UNIT=0
endif
set u=null
return false
endfunction
function SuijiMode_PositionInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.50,true)
call TriggerAddCondition(t,Condition(function SuijiMode_FixSelectedButtons))
set t=null
endfunction
function SuijiMode_IsYellowBonusSkill takes integer suijiYellowSkill returns boolean
return suijiYellowSkill=='Aamk' or suijiYellowSkill=='A0NR'
endfunction
function SuijiMode_RemoveYellowBonusIcons takes unit suijiYellowUnit returns nothing
local player suijiYellowOwner=null
local integer suijiYellowHandle=0
local boolean suijiYellowChanged=false
if suijiYellowUnit==null then
return
endif
set suijiYellowHandle=GetHandleId(suijiYellowUnit)
set suijiYellowOwner=GetOwningPlayer(suijiYellowUnit)
if GetUnitAbilityLevel(suijiYellowUnit,'Aamk')>0 then
call UnitRemoveAbility(suijiYellowUnit,'Aamk')
set suijiYellowChanged=true
endif
if GetUnitAbilityLevel(suijiYellowUnit,'A0NR')>0 then
call UnitRemoveAbility(suijiYellowUnit,'A0NR')
set suijiYellowChanged=true
endif
if OO7(suijiYellowHandle,"SuijiYellowButtonsHidden")==false then
call SetPlayerAbilityAvailable(suijiYellowOwner,'Aamk',false)
call SetPlayerAbilityAvailable(suijiYellowOwner,'A0NR',false)
call NS7(suijiYellowHandle,"SuijiYellowButtonsHidden",true)
set suijiYellowChanged=true
endif
if suijiYellowChanged then
call SuijiMode_MarkUnitVisibilityDirty(suijiYellowUnit)
endif
set suijiYellowOwner=null
endfunction
function SuijiMode_GrantYellowBonusOnce takes unit suijiYellowUnit returns boolean
local integer suijiYellowHandle=0
if SUIJI_MODE==false or suijiYellowUnit==null then
return false
endif
set suijiYellowHandle=GetHandleId(suijiYellowUnit)
if OO7(suijiYellowHandle,"SuijiDone")==false then
return false
endif
if OO7(suijiYellowHandle,"SuijiYellowBonusGranted") then
call SuijiMode_RemoveYellowBonusIcons(suijiYellowUnit)
return true
endif
call SuijiMode_RemoveYellowBonusIcons(suijiYellowUnit)
call NS7(suijiYellowHandle,"SuijiYellowBonusGranted",true)
return true
endfunction
function SuijiMode_GetHeroSkillSlot takes unit suijiYellowUnit,integer suijiYellowSlot returns integer
local integer suijiYellowPlayerId=GetPlayerId(GetOwningPlayer(suijiYellowUnit))
if suijiYellowSlot==1 then
return eY[$80+suijiYellowPlayerId]
elseif suijiYellowSlot==2 then
return eY[$90+suijiYellowPlayerId]
elseif suijiYellowSlot==3 then
return eY[$A0+suijiYellowPlayerId]
elseif suijiYellowSlot==4 then
return eY[$AC+suijiYellowPlayerId]
elseif suijiYellowSlot==5 then
return eY[$BC+suijiYellowPlayerId]
endif
return 0
endfunction
function SuijiMode_GetCurrentYellowBonusSkill takes unit suijiYellowUnit returns integer
local integer suijiYellowSlot=1
local integer suijiYellowSkill=0
loop
exitwhen suijiYellowSlot>5
set suijiYellowSkill=SuijiMode_GetHeroSkillSlot(suijiYellowUnit,suijiYellowSlot)
if SuijiMode_IsYellowBonusSkill(suijiYellowSkill) then
return suijiYellowSkill
endif
set suijiYellowSlot=suijiYellowSlot+1
endloop
if GetUnitAbilityLevel(suijiYellowUnit,'A0NR')>0 then
return 'A0NR'
endif
return 'Aamk'
endfunction
function SuijiMode_AreBaseHeroSkillsMaxed takes unit suijiYellowUnit returns boolean
local integer suijiYellowSlot=1
local integer suijiYellowSkill=0
local integer suijiYellowMaxLevel=0
local boolean suijiYellowChecked=false
if GetUnitTypeId(suijiYellowUnit)=='Hmkg' then
set suijiYellowSkill=QI7(suijiYellowUnit)
set suijiYellowMaxLevel=MHAbility_GetDefDataInt(suijiYellowSkill,ABILITY_DEF_DATA_MAX_LEVEL)
if suijiYellowMaxLevel<=0 or GetUnitAbilityLevel(suijiYellowUnit,suijiYellowSkill)<suijiYellowMaxLevel then
return false
endif
set suijiYellowSkill=QJ7(suijiYellowUnit)
set suijiYellowMaxLevel=MHAbility_GetDefDataInt(suijiYellowSkill,ABILITY_DEF_DATA_MAX_LEVEL)
if suijiYellowMaxLevel<=0 or GetUnitAbilityLevel(suijiYellowUnit,suijiYellowSkill)<suijiYellowMaxLevel then
return false
endif
set suijiYellowSkill=QK7(suijiYellowUnit)
set suijiYellowMaxLevel=MHAbility_GetDefDataInt(suijiYellowSkill,ABILITY_DEF_DATA_MAX_LEVEL)
if suijiYellowMaxLevel<=0 or GetUnitAbilityLevel(suijiYellowUnit,suijiYellowSkill)<suijiYellowMaxLevel then
return false
endif
set suijiYellowMaxLevel=MHAbility_GetDefDataInt('A088',ABILITY_DEF_DATA_MAX_LEVEL)
return suijiYellowMaxLevel>0 and B287_GetUnitAbilityLevel(suijiYellowUnit,'A088')>=suijiYellowMaxLevel
elseif GetUnitTypeId(suijiYellowUnit)=='Usyl' then
if B287_GetUnitAbilityLevel(suijiYellowUnit,'A064')<MHAbility_GetDefDataInt('A064',ABILITY_DEF_DATA_MAX_LEVEL) then
return false
endif
if B287_GetUnitAbilityLevel(suijiYellowUnit,'A2RA')<MHAbility_GetDefDataInt('A2RA',ABILITY_DEF_DATA_MAX_LEVEL) then
return false
endif
if B287_GetUnitAbilityLevel(suijiYellowUnit,'A03U')<MHAbility_GetDefDataInt('A03U',ABILITY_DEF_DATA_MAX_LEVEL) then
return false
endif
set suijiYellowMaxLevel=MHAbility_GetDefDataInt('A04P',ABILITY_DEF_DATA_MAX_LEVEL)
return suijiYellowMaxLevel>0 and B287_GetUnitAbilityLevel(suijiYellowUnit,'A04P')+B287_GetUnitAbilityLevel(suijiYellowUnit,'A1AU')>=suijiYellowMaxLevel
endif
loop
exitwhen suijiYellowSlot>5
set suijiYellowSkill=SuijiMode_GetHeroSkillSlot(suijiYellowUnit,suijiYellowSlot)
if suijiYellowSkill!=0 and SuijiMode_IsYellowBonusSkill(suijiYellowSkill)==false then
set suijiYellowMaxLevel=MHAbility_GetDefDataInt(suijiYellowSkill,ABILITY_DEF_DATA_MAX_LEVEL)
if suijiYellowMaxLevel>0 then
set suijiYellowChecked=true
if GetUnitAbilityLevel(suijiYellowUnit,suijiYellowSkill)<suijiYellowMaxLevel then
return false
endif
endif
endif
set suijiYellowSlot=suijiYellowSlot+1
endloop
return suijiYellowChecked
endfunction
function SuijiMode_AutoLearnYellowBonus takes unit suijiYellowUnit returns nothing
local integer suijiYellowSkillPoints=0
if suijiYellowUnit==null then
return
endif
if SuijiMode_AreBaseHeroSkillsMaxed(suijiYellowUnit)==false then
call SuijiMode_RemoveYellowBonusIcons(suijiYellowUnit)
return
endif
if OO7(GetHandleId(suijiYellowUnit),"SuijiYellowBonusGranted") then
set suijiYellowSkillPoints=GetHeroSkillPoints(suijiYellowUnit)
if suijiYellowSkillPoints>0 then
call UnitModifySkillPoints(suijiYellowUnit,0-suijiYellowSkillPoints)
endif
call SuijiMode_RemoveYellowBonusIcons(suijiYellowUnit)
return
endif
if GetHeroSkillPoints(suijiYellowUnit)<=0 and GetUnitAbilityLevel(suijiYellowUnit,'Aamk')<=0 and GetUnitAbilityLevel(suijiYellowUnit,'A0NR')<=0 then
return
endif
set suijiYellowSkillPoints=GetHeroSkillPoints(suijiYellowUnit)
if suijiYellowSkillPoints>0 then
call UnitModifySkillPoints(suijiYellowUnit,0-suijiYellowSkillPoints)
endif
call SuijiMode_GrantYellowBonusOnce(suijiYellowUnit)
endfunction
function SuijiMode_OnYellowBonusLearn takes nothing returns boolean
local unit suijiYellowUnit=GetTriggerUnit()
if SUIJI_MODE and suijiYellowUnit!=null and GetUnitTypeId(suijiYellowUnit)!=0 and IsUnitIllusion(suijiYellowUnit)==false and OO7(GetHandleId(suijiYellowUnit),"SuijiDone") then
if SuijiMode_IsYellowBonusSkill(B287_GetLearnedSkill()) then
call SuijiMode_GrantYellowBonusOnce(suijiYellowUnit)
endif
endif
set suijiYellowUnit=null
return false
endfunction
function SuijiMode_YellowBonusInit takes nothing returns nothing
local trigger suijiYellowTrigger=CreateTrigger()
call YB7(suijiYellowTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(suijiYellowTrigger,Condition(function SuijiMode_OnYellowBonusLearn))
set suijiYellowTrigger=null
endfunction
function SuijiMode_AghDebugFlag takes boolean value returns string
if value then
return "1"
endif
return "0"
endfunction
function SuijiMode_AghDebugRegistry takes unit u,integer skill returns string
return SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,skill))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,skill))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,skill))
endfunction
function SuijiMode_AghDebugReport takes unit u,string reason returns nothing
local player p=null
local integer pid=0
local integer h=0
local integer ownIndex=0
local integer ownRaw=0
local integer smallSkill=0
local integer ultSkill=0
local integer pair=-1
local integer i=0
local integer itemRaw=0
local item it=null
local string slots=""
if u==null or GetUnitTypeId(u)==0 then
return
endif
set p=GetOwningPlayer(u)
set pid=GetPlayerId(p)
set h=GetHandleId(u)
set ownIndex=F59(u)
if ownIndex>0 then
set ownRaw=ZU[ownIndex]
endif
set smallSkill=OM7(h,"SuijiSmallSkill")
set ultSkill=OM7(h,"SuijiUltSkill")
set pair=SuijiMode_FindAghPair(smallSkill)
loop
exitwhen i>5
set it=UnitItemInSlot(u,i)
if it!=null then
set itemRaw=GetItemTypeId(it)
set slots=slots+" "+I2S(i)+":"+GetObjectName(itemRaw)+"("+I2S(itemRaw)+")"
endif
set i=i+1
endloop
call DisplayTextToPlayer(p,0,0,"|cFFFFCC00[A杖诊断:"+reason+"]|r 英雄="+GetUnitName(u)+" type="+I2S(GetUnitTypeId(u)))
call DisplayTextToPlayer(p,0,0,"模式="+SuijiMode_AghDebugFlag(SUIJI_MODE)+" done="+SuijiMode_AghDebugFlag(OO7(h,"SuijiDone"))+" state="+SuijiMode_AghDebugFlag(SuijiMode_HasAghanimState(u))+" syncState="+SuijiMode_AghDebugFlag(SuijiMode_HasScepter(u)))
call DisplayTextToPlayer(p,0,0,"CHIA="+I2S(CHIA[pid])+" A330="+I2S(GetUnitAbilityLevel(u,'A330'))+" FIND_SLOT="+I2S(FIND_SLOT(u,1))+" ownIndex="+I2S(ownIndex)+" ownRaw="+I2S(ownRaw)+" ownHeld="+SuijiMode_AghDebugFlag(ownRaw!=0 and MV7(u,ownRaw)!=null))
call DisplayTextToPlayer(p,0,0,"随机小="+I2S(smallSkill)+" lv="+I2S(B287_GetUnitAbilityLevel(u,smallSkill))+" pair="+I2S(pair)+" 随机大="+I2S(ultSkill)+" lv="+I2S(B287_GetUnitAbilityLevel(u,ultSkill)))
call DisplayTextToPlayer(p,0,0,"风暴之眼控制器 registered="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A1AO'))+" active="+SuijiMode_AghDebugFlag(SuijiMode_RazorScepterIsActive(u))+" tooltip="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A1AO'))+" physical="+I2S(SuijiMode_ScepterRegistryPhysical(u,'A1AO')))
call DisplayTextToPlayer(p,0,0,"月蚀控制器 registered="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A054'))+" active="+SuijiMode_AghDebugFlag(SuijiMode_LunaScepterIsActive(u))+" tooltip="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A054'))+" physical="+I2S(SuijiMode_ScepterRegistryPhysical(u,'A054')))
call DisplayTextToPlayer(p,0,0,"纯脚本批次 registered/active/tooltip：雷神="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A29G'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,'A29G'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A29G'))+" 极寒="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A03R'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,'A03R'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A03R')))
call DisplayTextToPlayer(p,0,0,"纯脚本批次 registered/active/tooltip：自然="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A1W8'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,'A1W8'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A1W8'))+" 海妖="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A07U'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,'A07U'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A07U'))+" 剧毒="+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsRegistered(u,'A013'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryIsActive(u,'A013'))+"/"+SuijiMode_AghDebugFlag(SuijiMode_ScepterRegistryTooltipValid(u,'A013')))
call DisplayTextToPlayer(p,0,0,"成对大招1 R/A/T：奔袭="+SuijiMode_AghDebugRegistry(u,'A2O6')+" 上帝="+SuijiMode_AghDebugRegistry(u,'A0LT')+" 黑洞="+SuijiMode_AghDebugRegistry(u,'A1BX')+" 梦境="+SuijiMode_AghDebugRegistry(u,'A0S8'))
call DisplayTextToPlayer(p,0,0,"成对大招2 R/A/T：静默="+SuijiMode_AghDebugRegistry(u,'A0L3')+" 回光="+SuijiMode_AghDebugRegistry(u,'A0NS')+" 掌握="+SuijiMode_AghDebugRegistry(u,'A02Q')+" 结界="+SuijiMode_AghDebugRegistry(u,'A0J1'))
call DisplayTextToPlayer(p,0,0,"成对大招3 R/A/T：末日="+SuijiMode_AghDebugRegistry(u,'A0MU')+" 汲取="+SuijiMode_AghDebugRegistry(u,'A0CC')+" 幽冥="+SuijiMode_AghDebugRegistry(u,'A0G4')+" 火雨="+SuijiMode_AghDebugRegistry(u,'S008'))
call DisplayTextToPlayer(p,0,0,"成对大招4 R/A/T：核弹="+SuijiMode_AghDebugRegistry(u,'A1T5')+" 风暴="+SuijiMode_AghDebugRegistry(u,'A1U6')+" 决斗="+SuijiMode_AghDebugRegistry(u,'A2CI')+" 神秘="+SuijiMode_AghDebugRegistry(u,'A2BG'))
call DisplayTextToPlayer(p,0,0,"沙王 A06O/A4I2="+I2S(B287_GetUnitAbilityLevel(u,'A06O'))+"/"+I2S(B287_GetUnitAbilityLevel(u,'A4I2'))+" A06R/A1B4/A1BC="+I2S(B287_GetUnitAbilityLevel(u,'A06R'))+"/"+I2S(B287_GetUnitAbilityLevel(u,'A1B4'))+"/"+I2S(GetUnitAbilityLevel(u,'A1BC')))
call DisplayTextToPlayer(p,0,0,"程双杰 A29J/A1MP/A1MU="+I2S(B287_GetUnitAbilityLevel(u,'A29J'))+"/"+I2S(B287_GetUnitAbilityLevel(u,'A1MP'))+"/"+I2S(GetUnitAbilityLevel(u,'A1MU')))
call DisplayTextToPlayer(p,0,0,"物品栏:"+slots)
set it=null
set p=null
endfunction
function SuijiMode_AghDebugChat takes nothing returns boolean
local player p=GetTriggerPlayer()
local integer pid=GetPlayerId(p)
local unit u=M7[pid]
set SUIJI_AGH_DEBUG[pid]=not SUIJI_AGH_DEBUG[pid]
if SUIJI_AGH_DEBUG[pid] then
call DisplayTextToPlayer(p,0,0,"|cFF00FF00A杖诊断已开启|r；再次输入 -aghdebug 关闭。")
call SuijiMode_AghDebugReport(u,"手动")
else
call DisplayTextToPlayer(p,0,0,"|cFFFFCC00A杖诊断已关闭|r")
endif
set u=null
set p=null
return false
endfunction
function SuijiMode_AghDebugSpell takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer pid=0
local integer h=0
local integer skill=B287_GetSpellAbilityId()
if u!=null and GetUnitTypeId(u)!=0 then
set pid=GetPlayerId(GetOwningPlayer(u))
set h=GetHandleId(u)
if SUIJI_AGH_DEBUG[pid] and (skill==OM7(h,"SuijiSmallSkill") or skill==OM7(h,"SuijiUltSkill") or skill=='A06O' or skill=='A4I2' or skill=='A06R' or skill=='A1B4' or skill=='A29J' or skill=='A1MP' or skill=='A0EY' or skill=='A0FH' or skill=='A0F0') then
call DisplayTextToPlayer(GetOwningPlayer(u),0,0,"|cFFFF8080[A杖诊断:施法]|r skill="+GetAbilityName(skill)+"("+I2S(skill)+") state="+SuijiMode_AghDebugFlag(SuijiMode_HasAghanimState(u)))
call SuijiMode_AghDebugReport(u,"施法")
endif
endif
set u=null
return false
endfunction
// Arcane Blink states that cast point is reduced by 50%.  Random OMG abilities
// are physical clone abilities, so apply it to the clone after it has finished
// its per-skill initialization and retain the unmodified cast point for drops.
function SuijiMode_ApplyArcaneBlinkCastpoint takes unit u,integer logicalSkill returns nothing
local integer h=0
local integer physicalSkill=0
local integer level=0
local string saveKey=""
local real baseCastpoint=0.
local real currentCastpoint=0.
local real targetCastpoint=0.
// Teleport's authored 3/1-second channel belongs to its Scepter transition,
// not the cached hero-animation cast-point reduction used by Arcane Blink.
if logicalSkill=='A01O' then
call B1045TeleportSchedule(u)
return
endif
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
set level=GetUnitAbilityLevel(u,physicalSkill)
if physicalSkill==0 or level<=0 then
return
endif
set h=GetHandleId(u)
set saveKey="SuijiArcaneBlinkCastpoint"+I2S(physicalSkill)+"L"+I2S(level)
if OO7(h,saveKey)==false then
set baseCastpoint=SuijiMode_GetExactLiveAbilityCastpoint(u,physicalSkill)
call NQ7(h,saveKey,baseCastpoint)
call NS7(h,saveKey,true)
else
set baseCastpoint=ON7(h,saveKey)
endif
if GetUnitAbilityLevel(u,'A2YR')>0 then
set targetCastpoint=baseCastpoint*.5
else
set targetCastpoint=baseCastpoint
endif
set currentCastpoint=SuijiMode_GetExactLiveAbilityCastpoint(u,physicalSkill)
if RAbsBJ(currentCastpoint-targetCastpoint)>.001 then
call SuijiMode_SetExactLiveAbilityCastpoint(u,physicalSkill,targetCastpoint)
endif
set saveKey=""
endfunction
function SuijiMode_UpdateArcaneBlinkRandomCastpoints takes unit u returns nothing
local integer h=0
local boolean active=false
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or IsUnitIllusion(u) then
return
endif
set h=GetHandleId(u)
set active=GetUnitAbilityLevel(u,'A2YR')>0
call SuijiMode_ApplyArcaneBlinkCastpoint(u,OM7(h,"SuijiSmallSkill"))
call SuijiMode_ApplyArcaneBlinkCastpoint(u,OM7(h,"SuijiUltSkill"))
call NS7(h,"SuijiArcaneBlinkStateKnown",true)
call NS7(h,"SuijiArcaneBlinkActive",active)
endfunction
function SuijiMode_NativeFixedAghDelayedUpdate takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit u=LoadUnitHandle(L7,h,0)
local integer serial=LoadInteger(L7,h,1)
local integer unitHandle=0
local boolean agh=false
local boolean aghChanged=false
local boolean aghForce=false
local boolean arcaneActive=false
local boolean arcaneChanged=false
local integer itemId=LoadInteger(L7,h,2)
if u!=null and GetUnitTypeId(u)!=0 and serial==LoadInteger(L7,GetHandleId(u),StringHash("SuijiAghUpdateSerial")) then
set unitHandle=GetHandleId(u)
set agh=SuijiMode_HasScepter(u)
set aghChanged=OO7(unitHandle,"SuijiAghStateKnown")==false or OO7(unitHandle,"SuijiHasScepter")!=agh
set aghForce=OO7(unitHandle,"SuijiAghForceUpdate")
set arcaneActive=GetUnitAbilityLevel(u,'A2YR')>0
set arcaneChanged=OO7(unitHandle,"SuijiArcaneBlinkStateKnown")==false or OO7(unitHandle,"SuijiArcaneBlinkActive")!=arcaneActive
// Item changes that do not alter Scepter/Arcane Blink state must not rebuild or
// rewrite unrelated live abilities.  Aegis pickup is one such independent path.
if aghChanged or aghForce then
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_ReconcileNativeAghCompanions(u,null)
call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(u,'A29J',arcaneActive)
call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(u,'A1MP',arcaneActive)
endif
if arcaneChanged then
call SuijiMode_UpdateArcaneBlinkRandomCastpoints(u)
endif
if SUIJI_AGH_DEBUG[GetPlayerId(GetOwningPlayer(u))] then
call SuijiMode_AghDebugReport(u,"物品变化后")
endif
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function SuijiMode_OnItemChange takes nothing returns boolean
local unit u=GetManipulatingUnit()
local timer t=null
local integer unitHandle=0
local integer serial=0
local integer itemId=0
if u==null then
set u=GetTriggerUnit()
endif
if GetManipulatedItem()!=null then
set itemId=GetItemTypeId(GetManipulatedItem())
endif
if SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 and IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false then
set unitHandle=GetHandleId(u)
set serial=LoadInteger(L7,unitHandle,StringHash("SuijiAghUpdateSerial"))+1
call SaveInteger(L7,unitHandle,StringHash("SuijiAghUpdateSerial"),serial)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveInteger(L7,GetHandleId(t),2,itemId)
call TimerStart(t,.10,false,function SuijiMode_NativeFixedAghDelayedUpdate)
endif
set t=null
set u=null
return false
endfunction
function SuijiMode_AghItemInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
call YB7(t,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call YB7(t,EVENT_PLAYER_UNIT_DROP_ITEM)
call YB7(t,EVENT_PLAYER_UNIT_PAWN_ITEM)
call TriggerAddCondition(t,Condition(function SuijiMode_OnItemChange))
set t=CreateTrigger()
loop
exitwhen i>11
call TriggerRegisterPlayerChatEvent(t,Player(i),"-aghdebug",true)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function SuijiMode_AghDebugChat))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiMode_AghDebugSpell))
set t=null
endfunction
function SuijiMode_MulticastText takes unit u,integer r returns nothing
