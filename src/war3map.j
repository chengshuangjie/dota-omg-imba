function SuijiMode_SkillClass takes integer skill returns integer
if skill==0 then
return 0
endif
if SuijiMode_IsPhysicalSkill(skill) then
return 1
endif
return 2
endfunction
function SuijiMode_IsAIPhysicalHeroType takes integer unitId returns boolean
local integer i=1
loop
exitwhen i>K_4
if K24[i]==unitId then
return true
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>M74
if M44[i]==unitId then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_IsAISpellHeroType takes integer unitId returns boolean
local integer i=1
loop
exitwhen i>M94
if M84[i]==unitId then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_AIHeroSkillBias takes unit u returns integer
local integer unitId=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set unitId=GetUnitTypeId(u)
if SuijiMode_IsAISpellHeroType(unitId) then
return 2
endif
if SuijiMode_IsAIPhysicalHeroType(unitId) then
return 1
endif
if GetHeroInt(u,false)>GetHeroStr(u,false) and GetHeroInt(u,false)>GetHeroAgi(u,false) then
return 2
endif
return 1
endfunction
function SuijiMode_AISkillWeight takes unit u,integer skill returns integer
local integer bias=SuijiMode_AIHeroSkillBias(u)
local integer kind=SuijiMode_SkillClass(skill)
if bias==0 or kind==0 then
return 1
endif
if bias==kind then
return 4
endif
return 1
endfunction
function SuijiMode_AddRandomSmall takes unit u returns integer
local integer tries=0
local integer idx=0
local integer slot=0
local integer skill=0
local integer helper=0
local integer level=0
local integer weight=0
local integer total=0
local integer chosenSkill=0
local integer chosenHelper=0
local integer chosenSource=0
local integer available=0
local integer fallbackSkill=0
local integer fallbackHelper=0
local integer fallbackSource=0
local string fallbackOrder=""
local string chosenOrder=""
local string order=""
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if GetUnitTypeId(u)=='HMD0' and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
return SuijiTest_AddPresetSkill(u,B990MiaoSmall(GetPlayerId(GetOwningPlayer(u))),SuijiMode_SmallLevel(u),"SuijiSmall")
endif
if B979Mode==2 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and not SuijiMode_HasForcedPreset(GetPlayerId(GetOwningPlayer(u))) then
if B979ChoosePair(u)>0 then
return B979GrantPairSlot(u,SuijiMode_SmallLevel(u),false)
endif
endif
set level=SuijiMode_SmallLevel(u)
loop
exitwhen tries>=120 or chosenSkill!=0
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
if SuijiMode_IsRandomRollExcludedSkill(skill)==false and SuijiMode_IsUltimateOnlySkill(skill)==false and SuijiMode_CanUseSkill(u,skill,helper,order) then
set available=available+1
set weight=SuijiMode_AISkillWeight(u,skill)
set total=total+weight
if fallbackSkill==0 or GetRandomInt(1,total)<=weight then
set fallbackSkill=skill
set fallbackHelper=helper
set fallbackSource=SuijiMode_GetPoolSkillSource(idx,skill)
set fallbackOrder=order
endif
if GetRandomInt(1,4)<=weight then
set chosenSkill=skill
set chosenHelper=helper
set chosenSource=SuijiMode_GetPoolSkillSource(idx,skill)
set chosenOrder=order
endif
endif
endloop
if chosenSkill==0 and fallbackSkill!=0 then
set chosenSkill=fallbackSkill
set chosenHelper=fallbackHelper
set chosenSource=fallbackSource
set chosenOrder=fallbackOrder
endif
if chosenSkill!=0 then
call SuijiTest_DebugUnit(u,"SMALL1","小技能样本候选="+I2S(available)+" 权重="+I2S(total)+" 选中="+GetAbilityName(chosenSkill)+" source="+I2S(chosenSource))
return SuijiMode_AddSkill(u,chosenSkill,chosenHelper,chosenOrder,level,chosenSource,"SuijiSmall")
endif
call SuijiTest_DebugUnit(u,"SMALL0","没有可用小技能，样本候选="+I2S(available)+" 权重="+I2S(total))
return 0
endfunction
function SuijiMode_HumanMulticastQuota takes nothing returns integer
local integer i=0
local integer h=0
local integer quota=0
local unit hero=null
local player p=null
loop
exitwhen i>$B
set p=Player(i)
if GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
if OM7(h,"SuijiUltSkill")=='A088' or OM7(h,"SuijiTavernUltPendingSkill")=='A088' then
set quota=quota+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set p=null
return quota
endfunction
function SuijiMode_AIMulticastQuotaUsed takes nothing returns integer
local integer i=0
local integer h=0
local integer idx=0
local integer used=0
local unit hero=null
local player p=null
loop
exitwhen i>$B
set p=Player(i)
if IsPlayerInForce(p,QX4) and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 then
set h=GetHandleId(hero)
set idx=SuijiMode_GetStableHeroIndex(hero)
if OM7(h,"SuijiUltSkill")=='A088' or OO7(h,"SuijiAIMulticastReserved") or (idx>=KL4 and idx<=K54 and HP4[idx]=='A088') then
set used=used+1
endif
endif
endif
set i=i+1
endloop
set hero=null
set p=null
return used
endfunction
function SuijiMode_ShouldForceAIMulticast takes unit u returns boolean
local integer h=0
local integer idx=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return false
endif
if SuijiMode_IsAIRandomSkillBlocked(u,'A088') then
return false
endif
set h=GetHandleId(u)
set idx=SuijiMode_GetStableHeroIndex(u)
if OM7(h,"SuijiUltSkill")=='A088' or (idx>=KL4 and idx<=K54 and HP4[idx]=='A088') then
return false
endif
if OO7(h,"SuijiAIMulticastReserved") then
return true
endif
if SuijiMode_AIMulticastQuotaUsed()<SuijiMode_HumanMulticastQuota() then
call NS7(h,"SuijiAIMulticastReserved",true)
return true
endif
return false
endfunction
// Relative ultimate-pool weights: keep positive weights, including Scepter Infest.
function SuijiMode_UltimateRollWeight takes integer skill returns integer
set skill=SuijiMode_ToOriginalSkill(skill)
if skill=='A088' or skill=='A0SW' or skill=='A4FR' then
return 1
endif
return 2
endfunction
function SuijiMode_PassesUltimateRoll takes integer skill returns boolean
if SuijiMode_UltimateRollWeight(skill)==1 then
return GetRandomInt(1,2)==1
endif
return true
endfunction
function SuijiMode_AddRandomUltimate takes unit u,integer level returns integer
local integer tries=0
local integer idx=0
local integer skill=0
local integer helper=0
local integer weight=0
local integer total=0
local integer chosenSkill=0
local integer chosenHelper=0
local integer chosenSource=0
local integer available=0
local integer fallbackSkill=0
local integer fallbackHelper=0
local integer fallbackSource=0
local string fallbackOrder=""
local string chosenOrder=""
local string order=""
if u==null or GetUnitTypeId(u)==0 or level<=0 then
return 0
endif
if GetUnitTypeId(u)=='HMD0' and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
return SuijiTest_AddPresetSkill(u,B990MiaoUlt(GetPlayerId(GetOwningPlayer(u))),level,"SuijiUlt")
endif
if B979Mode==2 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and not SuijiMode_HasForcedPreset(GetPlayerId(GetOwningPlayer(u))) then
if OM7(GetHandleId(u),"B979Pair")>0 then
return B979GrantPairSlot(u,level,true)
endif
endif
if SuijiMode_ShouldForceAIMulticast(u) then
set chosenSkill=SuijiMode_AddSkill(u,'A088',0,"passive",level,18,"SuijiUlt")
if chosenSkill!=0 then
call NS7(GetHandleId(u),"SuijiAIMulticastReserved",false)
call SuijiTest_DebugUnit(u,"ULTQ","按玩家多重施法选择数量补足AI配额")
return chosenSkill
endif
call NS7(GetHandleId(u),"SuijiAIMulticastReserved",false)
endif
// Juxtapose gets one independent 1% AI roll. Excluding it from the ordinary
// retry loop below prevents the 120 candidate attempts from inflating the rate.
if GetRandomInt(1,100)==1 and SuijiMode_IsRandomRollExcludedSkill('A0DB')==false and SuijiMode_CanUseSkill(u,'A0DB',HU4[21],HZ4[21]) then
call SuijiTest_DebugUnit(u,"ULT1","命中1%并列独立概率")
return SuijiMode_AddSkill(u,'A0DB',HU4[21],HZ4[21],level,SuijiMode_GetPoolSkillSource(21,'A0DB'),"SuijiUlt")
endif
loop
exitwhen tries>=120 or chosenSkill!=0
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="magicdefense"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
if SuijiMode_HasScepter(u) and HQ4[idx]!=0 and (HV4[idx]!=0 or SuijiMode_CanSkipHelper(HQ4[idx])) then
set skill=HQ4[idx]
set helper=HV4[idx]
endif
endif
if skill!='A0DB' and SuijiMode_IsRandomRollExcludedSkill(skill)==false and SuijiMode_CanUseSkill(u,skill,helper,order) then
set available=available+1
set weight=SuijiMode_AISkillWeight(u,skill)*SuijiMode_UltimateRollWeight(skill)
set total=total+weight
if fallbackSkill==0 or GetRandomInt(1,total)<=weight then
set fallbackSkill=skill
set fallbackHelper=helper
set fallbackSource=SuijiMode_GetPoolSkillSource(idx,skill)
set fallbackOrder=order
endif
if GetRandomInt(1,8)<=weight then
set chosenSkill=skill
set chosenHelper=helper
set chosenSource=SuijiMode_GetPoolSkillSource(idx,skill)
set chosenOrder=order
endif
endif
endloop
if chosenSkill==0 and fallbackSkill!=0 then
set chosenSkill=fallbackSkill
set chosenHelper=fallbackHelper
set chosenSource=fallbackSource
set chosenOrder=fallbackOrder
endif
if chosenSkill!=0 then
call SuijiTest_DebugUnit(u,"ULT1","大招样本候选="+I2S(available)+" 权重="+I2S(total)+" 选中="+GetAbilityName(chosenSkill)+" source="+I2S(chosenSource))
return SuijiMode_AddSkill(u,chosenSkill,chosenHelper,chosenOrder,level,chosenSource,"SuijiUlt")
endif
call SuijiTest_DebugUnit(u,"ULT0","没有可用大招，样本候选="+I2S(available)+" 权重="+I2S(total))
return 0
endfunction
function SuijiMode_IsChoiceDuplicate takes integer h,string mark,integer skill returns boolean
local integer i=1
local integer count=OM7(h,mark+"ChoiceCount")
loop
exitwhen i>count
if OM7(h,mark+"Choice"+I2S(i)+"Skill")==skill then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiMode_SaveChoice takes integer h,string mark,integer pos,integer skill,integer helper,string order,integer source returns nothing
local string key=mark+"Choice"+I2S(pos)
set order=SuijiMode_RandomOrder(skill,order)
call NP7(h,key+"Skill",skill)
call NP7(h,key+"Helper",helper)
call NP7(h,key+"Source",source)
call NR7(h,key+"Order",order)
set key=""
endfunction
function SuijiTavern_PendingConflict takes unit u,integer skill,integer helper,string order returns boolean
local integer h=0
local integer pendingSkill=0
local integer pendingHelper=0
local string pendingOrder=""
local string alternateOrder=""
local string pendingAlternateOrder=""
local string resolvedOrder=""
local string resolvedPendingOrder=""
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
set pendingSkill=OM7(h,"SuijiTavernUltPendingSkill")
set pendingHelper=OM7(h,"SuijiTavernUltPendingHelper")
set pendingOrder=OP7(h,"SuijiTavernUltPendingOrder")
set order=SuijiMode_RandomOrder(skill,order)
set pendingOrder=SuijiMode_RandomOrder(pendingSkill,pendingOrder)
if pendingSkill==0 then
set pendingOrder=""
return false
endif
// Passive carriers do not own a cast command. Keep duplicate/helper checks,
// but allow different scripted passive orbs to coexist.
if pendingSkill==skill or (helper!=0 and pendingHelper==helper) then
set pendingOrder=""
return true
endif
set resolvedOrder=SuijiMode_ResolveAlternateCarrierOrder(u,skill,order)
set resolvedPendingOrder=SuijiMode_ResolveAlternateCarrierOrder(u,pendingSkill,pendingOrder)
if resolvedOrder!="" and resolvedOrder!="passive" and resolvedPendingOrder==resolvedOrder then
// Both pending choices can initially see the same free default command. Permit
// the pair when either one has a distinct free fallback; the second actual
// grant will then observe the first button and select that fallback normally.
set alternateOrder=SuijiMode_GetAlternateCarrierOrder(skill)
if alternateOrder!=null and alternateOrder!="" and alternateOrder!=resolvedPendingOrder and SuijiMode_HasOrderConflict(u,skill,alternateOrder)==false then
set pendingOrder=""
set alternateOrder=null
set pendingAlternateOrder=null
set resolvedOrder=null
set resolvedPendingOrder=null
return false
endif
set pendingAlternateOrder=SuijiMode_GetAlternateCarrierOrder(pendingSkill)
if pendingAlternateOrder!=null and pendingAlternateOrder!="" and pendingAlternateOrder!=resolvedOrder and SuijiMode_HasOrderConflict(u,pendingSkill,pendingAlternateOrder)==false then
set pendingOrder=""
set alternateOrder=null
set pendingAlternateOrder=null
set resolvedOrder=null
set resolvedPendingOrder=null
return false
endif
set pendingOrder=""
set alternateOrder=null
set pendingAlternateOrder=null
set resolvedOrder=null
set resolvedPendingOrder=null
return true
endif
set pendingOrder=""
set alternateOrder=null
set pendingAlternateOrder=null
set resolvedOrder=null
set resolvedPendingOrder=null
return false
endfunction
function SuijiMode_PrepareSmallChoices takes unit u returns integer
local integer h=0
local integer tries=0
local integer idx=0
local integer slot=0
local integer skill=0
local integer helper=0
local integer boundSkill=0
local integer boundHelper=0
local integer boundSource=0
local integer count=0
local string order=""
local string boundOrder=""
local boolean titled=false
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set boundSkill=SpecialTitle_GetBoundRandomSmall(GetOwningPlayer(u))
set boundHelper=SpecialTitle_GetBoundRandomSmallHelper(boundSkill)
set boundSource=SpecialTitle_GetBoundRandomSmallSource(boundSkill)
set boundOrder=SpecialTitle_GetBoundRandomSmallOrder(boundSkill)
set titled=boundSkill!=0 and SuijiMode_IsRandomRollExcludedSkill(boundSkill)==false and SuijiMode_CanUseSkill(u,boundSkill,boundHelper,boundOrder) and SuijiTavern_PendingConflict(u,boundSkill,boundHelper,boundOrder)==false
call NP7(h,"SuijiSmallChoiceCount",0)
loop
exitwhen tries>=720 or (titled and count>=3) or (titled==false and count>=8)
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
if SuijiMode_IsRandomRollExcludedSkill(skill)==false and SuijiMode_IsUltimateOnlySkill(skill)==false and (titled==false or skill!=boundSkill) and SuijiMode_CanUseSkill(u,skill,helper,order) and SuijiTavern_PendingConflict(u,skill,helper,order)==false and SuijiMode_IsChoiceDuplicate(h,"SuijiSmall",skill)==false then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiSmall",count,skill,helper,order,SuijiMode_GetPoolSkillSource(idx,skill))
call NP7(h,"SuijiSmallChoiceCount",count)
endif
endloop
if titled then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiSmall",count,boundSkill,boundHelper,boundOrder,boundSource)
call NP7(h,"SuijiSmallChoiceCount",count)
endif
set boundOrder=""
return count
endfunction
function SuijiMode_PrepareUltChoices takes unit u returns integer
local boolean b895Extra=false
local integer b895RandomLimit=3
local integer h=0
local integer tries=0
local integer idx=0
local integer skill=0
local integer helper=0
local integer boundSkill=0
local integer boundHelper=0
local integer boundSource=0
local integer count=0
local string order=""
local string boundOrder=""
local boolean titled=false
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set boundSkill=SpecialTitle_GetBoundRandomUltimate(GetOwningPlayer(u))
set boundHelper=SpecialTitle_GetBoundRandomUltimateHelper(boundSkill)
set boundSource=SpecialTitle_GetBoundRandomUltimateSource(boundSkill)
set boundOrder=SpecialTitle_GetBoundRandomUltimateOrder(boundSkill)
set titled=boundSkill!=0 and SuijiMode_IsRandomRollExcludedSkill(boundSkill)==false and SuijiMode_CanUseSkill(u,boundSkill,boundHelper,boundOrder)
set b895Extra=B895HasExtraBoundMulticast(GetOwningPlayer(u)) and SuijiMode_CanUseSkill(u,'A088',0,"passive")
if b895Extra then
if titled then
set b895RandomLimit=2
else
set b895RandomLimit=3
endif
endif
call NP7(h,"SuijiUltChoiceCount",0)
loop
exitwhen tries>=720 or ((titled or b895Extra) and count>=b895RandomLimit) or (titled==false and b895Extra==false and count>=8)
set tries=tries+1
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="berserk"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
endif
if SuijiMode_IsRandomRollExcludedSkill(skill)==false and (titled==false or skill!=boundSkill) and (b895Extra==false or skill!='A088') and SuijiMode_CanUseSkill(u,skill,helper,order) and SuijiMode_IsChoiceDuplicate(h,"SuijiUlt",skill)==false and SuijiMode_PassesUltimateRoll(skill) then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiUlt",count,skill,helper,order,SuijiMode_GetPoolSkillSource(idx,skill))
call NP7(h,"SuijiUltChoiceCount",count)
endif
endloop
if b895Extra then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiUlt",count,'A088',0,"passive",18)
call NP7(h,"SuijiUltChoiceCount",count)
endif
if titled then
set count=count+1
call SuijiMode_SaveChoice(h,"SuijiUlt",count,boundSkill,boundHelper,boundOrder,boundSource)
call NP7(h,"SuijiUltChoiceCount",count)
endif
set boundOrder=""
return count
endfunction
function SuijiMode_ApplyChoice takes unit u,string mark,integer choice,integer level returns integer
local integer h=0
local string key=mark+"Choice"+I2S(choice)
local integer skill=0
local integer helper=0
local integer source=0
local string order=""
if u==null or GetUnitTypeId(u)==0 then
set key=""
return 0
endif
set h=GetHandleId(u)
set skill=OM7(h,key+"Skill")
set helper=OM7(h,key+"Helper")
set source=OM7(h,key+"Source")
set order=OP7(h,key+"Order")
if skill==0 or (helper==0 and SuijiMode_CanSkipHelper(skill)==false) then
set key=""
set order=""
return 0
endif
if level<1 then
set level=1
endif
set key=""
return SuijiMode_AddSkill(u,skill,helper,order,level,source,mark)
endfunction
function SuijiMode_EnsureChoiceDialog takes integer pid returns dialog
if SUIJI_CHOICE_TRIGGER==null then
return null
endif
if SUIJI_CHOICE_DIALOG[pid]==null then
set SUIJI_CHOICE_DIALOG[pid]=DialogCreate()
call TriggerRegisterDialogEvent(SUIJI_CHOICE_TRIGGER,SUIJI_CHOICE_DIALOG[pid])
endif
return SUIJI_CHOICE_DIALOG[pid]
endfunction
function SuijiMode_FirstIcon takes string icon returns string
local integer i=0
if icon==null or icon=="" then
return""
endif
loop
exitwhen i>=StringLength(icon)
if SubString(icon,i,i+1)=="," then
return SubString(icon,0,i)
endif
set i=i+1
endloop
return icon
endfunction
function SuijiMode_ChoiceIconText takes integer skill returns string
local string icon=null
if skill==0 then
return""
endif
set icon=SuijiMode_FirstIcon(MHAbility_GetDefDataStr(skill,ABILITY_DEF_DATA_ART))
if icon==null or icon=="" then
return""
endif
return""
endfunction
function SuijiMode_ChoicePreviewIcon takes integer suijiChoicePreviewSkill returns string
local string suijiChoicePreviewIconPath=null
if suijiChoicePreviewSkill==0 then
return"UI\\Widgets\\Console\\Undead\\undead-inventory-slotfiller.blp"
endif
set suijiChoicePreviewIconPath=SuijiT4_NormalizeAbilityIcon(SuijiMode_FirstIcon(MHAbility_GetDefDataStr(suijiChoicePreviewSkill,ABILITY_DEF_DATA_ART)))
if suijiChoicePreviewIconPath==null or suijiChoicePreviewIconPath=="" then
return"ReplaceableTextures\\CommandButtons\\BTNCancel.blp"
endif
return suijiChoicePreviewIconPath
endfunction
function SuijiMode_ChoicePreviewLevel takes unit suijiChoicePreviewUnit,integer suijiChoicePreviewType,integer suijiChoicePreviewSkill returns integer
local integer suijiChoicePreviewLevel=1
local integer suijiChoicePreviewMaxLevel=0
if suijiChoicePreviewSkill!=0 then
set suijiChoicePreviewMaxLevel=MHAbility_GetDefDataInt(suijiChoicePreviewSkill,ABILITY_DEF_DATA_MAX_LEVEL)
endif
if suijiChoicePreviewType==2 then
set suijiChoicePreviewLevel=SuijiMode_UltLevel(suijiChoicePreviewUnit)
else
set suijiChoicePreviewLevel=SuijiMode_SmallLevel(suijiChoicePreviewUnit)
endif
if suijiChoicePreviewLevel<1 then
set suijiChoicePreviewLevel=1
endif
if suijiChoicePreviewMaxLevel>0 and suijiChoicePreviewLevel>suijiChoicePreviewMaxLevel then
set suijiChoicePreviewLevel=suijiChoicePreviewMaxLevel
endif
return suijiChoicePreviewLevel
endfunction
function SuijiMode_ChoiceButtonSummary takes integer suijiChoiceButtonSkill,integer suijiChoiceButtonLevel returns string
local string suijiChoiceButtonText=MHAbility_GetLevelDefDataStr(suijiChoiceButtonSkill,suijiChoiceButtonLevel,ABILITY_LEVEL_DEF_DATA_UBERTIP)
if suijiChoiceButtonText==null or suijiChoiceButtonText=="" then
set suijiChoiceButtonText=MHAbility_GetLevelDefDataStr(suijiChoiceButtonSkill,suijiChoiceButtonLevel,ABILITY_LEVEL_DEF_DATA_TIP)
endif
if suijiChoiceButtonText==null then
return""
endif
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|n"," ")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|r","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|R","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cff99ccff","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffffcc00","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffff0303","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|c00fffc01","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|c00ffff00","")
set suijiChoiceButtonText=MHString_Replace(suijiChoiceButtonText,"|cffffff00","")
if StringLength(suijiChoiceButtonText)>44 then
return SubString(suijiChoiceButtonText,0,44)+"..."
endif
return suijiChoiceButtonText
endfunction
function SuijiMode_ChoiceButtonText takes unit suijiChoiceButtonUnit,integer suijiChoiceButtonType,integer suijiChoiceButtonNumber,integer suijiChoiceButtonSkill returns string
local integer suijiChoiceButtonLevel=SuijiMode_ChoicePreviewLevel(suijiChoiceButtonUnit,suijiChoiceButtonType,suijiChoiceButtonSkill)
local string suijiChoiceButtonInfo=SuijiMode_ChoiceButtonSummary(suijiChoiceButtonSkill,suijiChoiceButtonLevel)
if suijiChoiceButtonInfo==null or suijiChoiceButtonInfo=="" then
return I2S(suijiChoiceButtonNumber)+". "+GetAbilityName(suijiChoiceButtonSkill)
endif
return I2S(suijiChoiceButtonNumber)+". "+GetAbilityName(suijiChoiceButtonSkill)+" - "+suijiChoiceButtonInfo
endfunction
function SuijiMode_DialogIconIndex takes integer suijiDialogIconPid,integer suijiDialogIconSlot returns integer
return suijiDialogIconPid*4+suijiDialogIconSlot
endfunction
function SuijiMode_DialogIconsEnsure takes nothing returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
local integer suijiDialogIconParent=GameUI
local real suijiDialogIconY=0.
if SUIJI_CHOICE_DIALOG_ICON_READY then
return
endif
if suijiDialogIconParent==0 then
set suijiDialogIconParent=DzGetGameUI()
endif
loop
exitwhen suijiDialogIconPid>15
set suijiDialogIconSlot=1
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
set SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex]=DzCreateFrameByTagName("BACKDROP",null,suijiDialogIconParent,"template",suijiDialogIconIndex)
set suijiDialogIconY=0.414-I2R(suijiDialogIconSlot-1)*0.036
call DzFrameSetSize(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],0.023,0.023)
call DzFrameClearAllPoints(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex])
call DzFrameSetAbsolutePoint(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],4,0.545,suijiDialogIconY)
call DzFrameSetPriority(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],98)
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],false)
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
set suijiDialogIconPid=suijiDialogIconPid+1
endloop
set SUIJI_CHOICE_DIALOG_ICON_READY=true
endfunction
function SuijiMode_ChoicePreviewHide takes player suijiChoicePreviewPlayer returns nothing
local integer suijiChoicePreviewPid=0
if suijiChoicePreviewPlayer!=null then
set suijiChoicePreviewPid=GetPlayerId(suijiChoicePreviewPlayer)
endif
if SUIJI_CHOICE_PREVIEW_BOARD[suijiChoicePreviewPid]!=null then
call MultiboardDisplay(SUIJI_CHOICE_PREVIEW_BOARD[suijiChoicePreviewPid],false)
endif
endfunction
function SuijiMode_DialogIconsHide takes player suijiDialogIconPlayer returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
if suijiDialogIconPlayer==null then
return
endif
call SuijiMode_DialogIconsEnsure()
set suijiDialogIconPid=GetPlayerId(suijiDialogIconPlayer)
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
if GetLocalPlayer()==suijiDialogIconPlayer then
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],false)
endif
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
endfunction
function SuijiMode_DialogIconsShow takes player suijiDialogIconPlayer,unit suijiDialogIconUnit,string suijiDialogIconMark,integer suijiDialogIconCount returns nothing
local integer suijiDialogIconPid=0
local integer suijiDialogIconSlot=1
local integer suijiDialogIconIndex=0
local integer suijiDialogIconHandle=0
local integer suijiDialogIconSkill=0
local real suijiDialogIconY=0.
if suijiDialogIconPlayer==null or suijiDialogIconUnit==null or GetUnitTypeId(suijiDialogIconUnit)==0 then
return
endif
call SuijiMode_DialogIconsEnsure()
call SuijiMode_DialogIconsHide(suijiDialogIconPlayer)
set suijiDialogIconPid=GetPlayerId(suijiDialogIconPlayer)
set suijiDialogIconHandle=GetHandleId(suijiDialogIconUnit)
loop
exitwhen suijiDialogIconSlot>4
set suijiDialogIconIndex=SuijiMode_DialogIconIndex(suijiDialogIconPid,suijiDialogIconSlot)
if suijiDialogIconSlot<=suijiDialogIconCount then
set suijiDialogIconSkill=OM7(suijiDialogIconHandle,suijiDialogIconMark+"Choice"+I2S(suijiDialogIconSlot)+"Skill")
set suijiDialogIconY=0.414-I2R(suijiDialogIconSlot-1)*0.036
if GetLocalPlayer()==suijiDialogIconPlayer then
call DzFrameSetTexture(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],SuijiMode_ChoicePreviewIcon(suijiDialogIconSkill),0)
call DzFrameSetSize(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],0.023,0.023)
call DzFrameClearAllPoints(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex])
call DzFrameSetAbsolutePoint(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],4,0.545,suijiDialogIconY)
call DzFrameSetPriority(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],98)
call DzFrameShow(SUIJI_CHOICE_DIALOG_ICON[suijiDialogIconIndex],true)
endif
endif
set suijiDialogIconSlot=suijiDialogIconSlot+1
endloop
endfunction
function SuijiMode_ShowChoiceDialog takes unit u,string mark,integer count,string title,integer choiceType returns nothing
local player p=null
local integer pid=0
local integer h=0
local dialog d=null
local integer shuffleLeft=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set p=GetOwningPlayer(u)
set pid=GetPlayerId(p)
set h=GetHandleId(u)
set d=SuijiMode_EnsureChoiceDialog(pid)
set shuffleLeft=OM7(h,mark+"ShuffleLeft")
if d==null or count<=0 then
set p=null
set d=null
return
endif
call DialogClear(d)
call DialogSetMessage(d,title)
set SUIJI_CHOICE_BUTTON1[pid]=null
set SUIJI_CHOICE_BUTTON2[pid]=null
set SUIJI_CHOICE_BUTTON3[pid]=null
set SUIJI_CHOICE_BUTTON4[pid]=null
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=null
if count>=1 then
set SUIJI_CHOICE_BUTTON1[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,1,OM7(h,mark+"Choice1Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice1Skill")),0)
endif
if count>=2 then
set SUIJI_CHOICE_BUTTON2[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,2,OM7(h,mark+"Choice2Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice2Skill")),0)
endif
if count>=3 then
set SUIJI_CHOICE_BUTTON3[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,3,OM7(h,mark+"Choice3Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice3Skill")),0)
endif
if count>=4 then
if (choiceType==1 and OM7(h,mark+"Choice4Skill")==SpecialTitle_GetBoundRandomSmall(p) and SpecialTitle_GetBoundRandomSmall(p)!=0) or (choiceType==2 and OM7(h,mark+"Choice4Skill")==SpecialTitle_GetBoundRandomUltimate(p) and SpecialTitle_GetBoundRandomUltimate(p)!=0) then
set SUIJI_CHOICE_BUTTON4[pid]=DialogAddButton(d,"|cFFFFCC00固定：|r"+SuijiMode_ChoiceButtonText(u,choiceType,4,OM7(h,mark+"Choice4Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice4Skill")),0)
else
set SUIJI_CHOICE_BUTTON4[pid]=DialogAddButton(d,SuijiMode_ChoiceButtonText(u,choiceType,4,OM7(h,mark+"Choice4Skill"))+SuijiMode_ChoiceIconText(OM7(h,mark+"Choice4Skill")),0)
endif
endif
if ISTEST then
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=DialogAddButton(d,"洗牌(测试无限)",0)
elseif shuffleLeft>0 then
if SpecialTitle_HasFreeRandom(p) then
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=DialogAddButton(d,"洗牌免费(剩余"+I2S(shuffleLeft)+"次)",0)
else
set SUIJI_CHOICE_SHUFFLE_BUTTON[pid]=DialogAddButton(d,"洗牌50金(剩余"+I2S(shuffleLeft)+"次)",0)
endif
endif
call SaveUnitHandle(L7,StringHash("SuijiChoiceUnit"),pid,u)
call SaveInteger(L7,StringHash("SuijiChoiceType"),pid,choiceType)
call DialogDisplay(p,d,true)
call SuijiMode_ChoicePreviewHide(p)
call SuijiMode_DialogIconsShow(p,u,mark,count)
set p=null
set d=null
endfunction
function SuijiMode_ShowSmallChoices takes unit u returns integer
local integer h=0
local integer count=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_USER then
return 0
endif
if SUIJI_CHOICE_TRIGGER==null then
return 0
endif
set h=GetHandleId(u)
if OO7(h,"SuijiSmallShuffleInit")==false then
call NS7(h,"SuijiSmallShuffleInit",true)
call NP7(h,"SuijiSmallShuffleLeft",3)
endif
if OM7(h,"SuijiSmallSkill")!=0 or OO7(h,"SuijiSmallChoosing") then
return 0
endif
set count=SuijiMode_PrepareSmallChoices(u)
if count>0 then
call NS7(h,"SuijiSmallChoosing",true)
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",count,"请选择额外小技能",1)
endif
return count
endfunction
function SuijiMode_ShowUltChoices takes unit u returns integer
local integer h=0
local integer count=0
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_USER then
return 0
endif
if SUIJI_CHOICE_TRIGGER==null then
return 0
endif
set h=GetHandleId(u)
if OO7(h,"SuijiUltShuffleInit")==false then
call NS7(h,"SuijiUltShuffleInit",true)
call NP7(h,"SuijiUltShuffleLeft",3)
endif
if OM7(h,"SuijiUltSkill")!=0 or OO7(h,"SuijiUltChoosing") then
return 0
endif
set count=SuijiMode_PrepareUltChoices(u)
if count>0 then
call NS7(h,"SuijiUltChoosing",true)
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",count,"请选择额外大招",2)
endif
return count
endfunction
function SuijiMode_OnChoice takes nothing returns boolean
local button b=GetClickedButton()
local integer pid=0
local integer choice=0
local integer choiceType=0
local unit u=null
local player p=null
local integer h=0
local integer skill=0
local boolean keepChoice=false
local integer shuffleLeft=0
local integer count=0
loop
exitwhen pid>15 or choice!=0
if b==SUIJI_CHOICE_BUTTON1[pid] then
set choice=1
elseif b==SUIJI_CHOICE_BUTTON2[pid] then
set choice=2
elseif b==SUIJI_CHOICE_BUTTON3[pid] then
set choice=3
elseif b==SUIJI_CHOICE_BUTTON4[pid] then
set choice=4
elseif b==SUIJI_CHOICE_SHUFFLE_BUTTON[pid] then
set choice=-1
else
set pid=pid+1
endif
endloop
if choice==0 then
set b=null
return false
endif
set p=Player(pid)
set u=LoadUnitHandle(L7,StringHash("SuijiChoiceUnit"),pid)
set choiceType=LoadInteger(L7,StringHash("SuijiChoiceType"),pid)
call DialogDisplay(p,SUIJI_CHOICE_DIALOG[pid],false)
call SuijiMode_ChoicePreviewHide(p)
call SuijiMode_DialogIconsHide(p)
if u!=null and GetUnitTypeId(u)!=0 and SUIJI_MODE and OO7(GetHandleId(u),"SuijiDone") then
set h=GetHandleId(u)
if choice==-1 then
if choiceType==1 and OM7(h,"SuijiSmallSkill")==0 then
set shuffleLeft=OM7(h,"SuijiSmallShuffleLeft")
if shuffleLeft>0 or ISTEST then
if ISTEST==false and SpecialTitle_HasFreeRandom(p)==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<50 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：洗牌需要50金币|r")
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",OM7(h,"SuijiSmallChoiceCount"),"请选择额外小技能",1)
set keepChoice=true
else
if ISTEST==false then
if SpecialTitle_HasFreeRandom(p)==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-50)
endif
call NP7(h,"SuijiSmallShuffleLeft",shuffleLeft-1)
endif
set count=SuijiMode_PrepareSmallChoices(u)
if count>0 then
call SuijiMode_ShowChoiceDialog(u,"SuijiSmall",count,"请选择额外小技能",1)
set keepChoice=true
else
call NS7(h,"SuijiSmallChoosing",false)
endif
endif
endif
elseif choiceType==2 and OM7(h,"SuijiUltSkill")==0 and OM7(h,"SuijiUltSelectedChoice")==0 then
set shuffleLeft=OM7(h,"SuijiUltShuffleLeft")
if shuffleLeft>0 or ISTEST then
if ISTEST==false and SpecialTitle_HasFreeRandom(p)==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<50 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：洗牌需要50金币|r")
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",OM7(h,"SuijiUltChoiceCount"),"请选择额外大招",2)
set keepChoice=true
else
if ISTEST==false then
if SpecialTitle_HasFreeRandom(p)==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-50)
endif
call NP7(h,"SuijiUltShuffleLeft",shuffleLeft-1)
endif
set count=SuijiMode_PrepareUltChoices(u)
if count>0 then
call SuijiMode_ShowChoiceDialog(u,"SuijiUlt",count,"请选择额外大招",2)
set keepChoice=true
else
call NS7(h,"SuijiUltChoosing",false)
endif
endif
endif
endif
elseif choiceType==1 then
if OM7(h,"SuijiSmallSkill")==0 then
set skill=SuijiMode_ApplyChoice(u,"SuijiSmall",choice,SuijiMode_SmallLevel(u))
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外小技能","选择了")
endif
endif
call NS7(h,"SuijiSmallChoosing",false)
if skill!=0 and OM7(h,"SuijiUltSkill")==0 and OM7(h,"SuijiUltSelectedChoice")==0 then
if SuijiMode_ShowUltChoices(u)>0 then
set keepChoice=true
endif
endif
elseif choiceType==2 then
if OM7(h,"SuijiUltSkill")==0 then
if SuijiMode_UltLevel(u)>0 then
set skill=SuijiMode_ApplyChoice(u,"SuijiUlt",choice,SuijiMode_UltLevel(u))
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外大招","选择了")
endif
else
call NP7(h,"SuijiUltSelectedChoice",choice)
set skill=OM7(h,"SuijiUltChoice"+I2S(choice)+"Skill")
if skill!=0 then
call SuijiMode_NotifyPickedSkill(u,skill,"额外大招","预选了")
endif
endif
endif
call NS7(h,"SuijiUltChoosing",false)
endif
call SuijiMode_UpdateAghSkills(u)
endif
if keepChoice==false then
call RemoveSavedHandle(L7,StringHash("SuijiChoiceUnit"),pid)
call SaveInteger(L7,StringHash("SuijiChoiceType"),pid,0)
endif
set b=null
set u=null
set p=null
return false
endfunction
function SuijiMode_ChoiceInit takes nothing returns nothing
if SUIJI_CHOICE_TRIGGER==null then
set SUIJI_CHOICE_TRIGGER=CreateTrigger()
call TriggerAddCondition(SUIJI_CHOICE_TRIGGER,Condition(function SuijiMode_OnChoice))
endif
endfunction
function SuijiTavern_ClearStock takes unit tavern returns nothing
local integer i=1
local integer h=0
local integer skill=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
loop
exitwhen i>8
set skill=LoadInteger(L7,h,i)
if skill!=0 then
call RemoveUnitFromStock(tavern,skill)
call SaveInteger(L7,h,i,0)
endif
set i=i+1
endloop
call NP7(h,"SuijiTavernCount",0)
endfunction
function SuijiTavern_Fill takes unit tavern,unit hero,integer kind returns integer
local integer i=1
local integer count=0
local integer skill=0
local integer th=0
local integer heroHandle=0
local string mark="SuijiSmall"
if tavern==null or hero==null or GetUnitTypeId(tavern)==0 or GetUnitTypeId(hero)==0 then
set mark=""
return 0
endif
call SuijiTavern_ClearStock(tavern)
set th=GetHandleId(tavern)
set heroHandle=GetHandleId(hero)
if kind==2 then
set mark="SuijiUlt"
set count=SuijiMode_PrepareUltChoices(hero)
else
set count=SuijiMode_PrepareSmallChoices(hero)
endif
loop
exitwhen i>count or i>8
set skill=OM7(heroHandle,mark+"Choice"+I2S(i)+"Skill")
if skill!=0 then
call SaveInteger(L7,th,i,skill)
call AddUnitToStock(tavern,skill,1,1)
endif
set i=i+1
endloop
call NP7(th,"SuijiTavernCount",count)
set mark=""
return count
endfunction
function SuijiTavern_HasStock takes unit tavern,integer skill returns boolean
local integer i=1
local integer h=0
if tavern==null or GetUnitTypeId(tavern)==0 or skill==0 then
return false
endif
set h=GetHandleId(tavern)
loop
exitwhen i>8
if LoadInteger(L7,h,i)==skill then
return true
endif
set i=i+1
endloop
return false
endfunction
function SuijiTavern_Remove takes integer pid,integer kind returns nothing
local unit tavern=null
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
set SUIJI_TAVERN_ULT[pid]=null
else
set tavern=SUIJI_TAVERN_SMALL[pid]
set SUIJI_TAVERN_SMALL[pid]=null
endif
if tavern!=null and GetUnitTypeId(tavern)!=0 then
call SuijiTavern_ClearStock(tavern)
call FlushChildHashtable(L7,GetHandleId(tavern))
call RemoveUnit(tavern)
endif
set tavern=null
endfunction
function SuijiTavern_StopTimeout takes integer pid returns nothing
local timer t=SUIJI_TAVERN_TIMEOUT[pid]
set SUIJI_TAVERN_TIMEOUT[pid]=null
if t!=null then
call PauseTimer(t)
call FlushChildHashtable(L7,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
endfunction
function SuijiTavern_IsComplete takes unit hero returns boolean
local integer h=0
if hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set h=GetHandleId(hero)
return OM7(h,"SuijiSmallSkill")!=0 and (OM7(h,"SuijiUltSkill")!=0 or OM7(h,"SuijiTavernUltPendingSkill")!=0)
endfunction
function SuijiTavern_FocusNext takes unit hero returns nothing
local player p=null
local integer pid=0
local unit next=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 then
set next=SUIJI_TAVERN_SMALL[pid]
elseif OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 then
set next=SUIJI_TAVERN_ULT[pid]
endif
call ClearSelectionForPlayer(p)
if next!=null and GetUnitTypeId(next)!=0 then
call SelectUnitAddForPlayer(next,p)
call PanCameraToTimedForPlayer(p,GetUnitX(next),GetUnitY(next),.30)
else
call SuijiTavern_StopTimeout(pid)
call SelectUnitAddForPlayer(hero,p)
call PanCameraToTimedForPlayer(p,GetUnitX(hero),GetUnitY(hero),.30)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFF00FF00随机OMG：英雄、小技能和大招均已选择完成|r")
endif
set next=null
set p=null
endfunction
function SuijiTavern_FindChoice takes unit hero,string mark,integer skill returns integer
local integer i=1
local integer h=0
local integer count=0
if hero==null or GetUnitTypeId(hero)==0 then
return 0
endif
set h=GetHandleId(hero)
set count=OM7(h,mark+"ChoiceCount")
loop
exitwhen i>count or i>8
if OM7(h,mark+"Choice"+I2S(i)+"Skill")==skill then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavern_Choose takes unit hero,integer kind,integer skill returns integer
local player p=null
local integer pid=0
local integer h=0
local integer choice=0
local integer helper=0
local integer source=0
local integer result=0
local string mark="SuijiSmall"
local string order=""
local unit tavern=null
if hero==null or GetUnitTypeId(hero)==0 or skill==0 then
set mark=""
return 0
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set h=GetHandleId(hero)
if kind==2 then
set mark="SuijiUlt"
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if SuijiTavern_HasStock(tavern,skill)==false then
set mark=""
set tavern=null
set p=null
return 0
endif
set choice=SuijiTavern_FindChoice(hero,mark,skill)
if choice<=0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：本次选择无效，当前酒馆候选保持不变|r")
set mark=""
set tavern=null
set p=null
return 0
endif
set helper=OM7(h,mark+"Choice"+I2S(choice)+"Helper")
set source=OM7(h,mark+"Choice"+I2S(choice)+"Source")
set order=OP7(h,mark+"Choice"+I2S(choice)+"Order")
if SuijiMode_CanUseSkill(hero,skill,helper,order)==false or (kind==1 and SuijiTavern_PendingConflict(hero,skill,helper,order)) then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：该技能与当前英雄或另一项选择冲突，本次选择无效，酒馆不刷新|r")
set mark=""
set order=""
set tavern=null
set p=null
return 0
endif
if kind==2 and SuijiMode_UltLevel(hero)<=0 then
call NP7(h,"SuijiTavernUltPendingSkill",skill)
call NP7(h,"SuijiTavernUltPendingHelper",helper)
call NP7(h,"SuijiTavernUltPendingSource",source)
call NR7(h,"SuijiTavernUltPendingOrder",order)
set result=skill
call SuijiMode_NotifyPickedSkill(hero,skill,"额外大招","预选了")
else
if kind==2 then
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,"SuijiUlt")
else
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_SmallLevel(hero),source,"SuijiSmall")
endif
if result!=0 then
if kind==2 then
call SuijiMode_NotifyPickedSkill(hero,result,"额外大招","选择了")
else
call SuijiMode_NotifyPickedSkill(hero,result,"额外小技能","选择了")
endif
endif
endif
if result!=0 then
call SuijiTavern_Remove(pid,kind)
call SuijiTavern_FocusNext(hero)
endif
set mark=""
set order=""
set tavern=null
set p=null
return result
endfunction
function SuijiTavern_ApplyPendingUlt takes unit hero returns integer
local integer h=0
local integer skill=0
local integer helper=0
local integer source=0
local integer result=0
local string order=""
if hero==null or GetUnitTypeId(hero)==0 or SuijiMode_UltLevel(hero)<=0 then
return 0
endif
set h=GetHandleId(hero)
set skill=OM7(h,"SuijiTavernUltPendingSkill")
if skill==0 then
return 0
endif
set helper=OM7(h,"SuijiTavernUltPendingHelper")
set source=OM7(h,"SuijiTavernUltPendingSource")
set order=OP7(h,"SuijiTavernUltPendingOrder")
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,"SuijiUlt")
if result!=0 then
call NP7(h,"SuijiTavernUltPendingSkill",0)
call NP7(h,"SuijiTavernUltPendingHelper",0)
call NP7(h,"SuijiTavernUltPendingSource",0)
call NR7(h,"SuijiTavernUltPendingOrder","")
call SuijiMode_NotifyPickedSkill(hero,result,"预选大招","5级获得了")
endif
set order=""
return result
endfunction
function SuijiTavern_Timeout takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit hero=LoadUnitHandle(L7,th,0)
local integer pid=LoadInteger(L7,th,1)
local integer skill=0
set SUIJI_TAVERN_TIMEOUT[pid]=null
if hero!=null and GetUnitTypeId(hero)!=0 then
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 and SUIJI_TAVERN_SMALL[pid]!=null then
set skill=LoadInteger(L7,GetHandleId(SUIJI_TAVERN_SMALL[pid]),1)
call SuijiTavern_Choose(hero,1,skill)
endif
if OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 and SUIJI_TAVERN_ULT[pid]!=null then
set skill=LoadInteger(L7,GetHandleId(SUIJI_TAVERN_ULT[pid]),1)
call SuijiTavern_Choose(hero,2,skill)
endif
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：选择时间结束，未选项目已自动采用第一个候选|r")
endif
call FlushChildHashtable(L7,th)
call PauseTimer(t)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function SuijiTavern_Start takes unit hero returns nothing
local player p=null
local integer pid=0
local real x=0.
local real y=0.
local boolean created=false
local timer t=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if GetPlayerController(p)!=MAP_CONTROL_USER then
set p=null
return
endif
set x=GetUnitX(hero)
set y=GetUnitY(hero)
if KU4[pid]!=null and GetUnitTypeId(KU4[pid])!=0 then
set x=GetUnitX(KU4[pid])
set y=GetUnitY(KU4[pid])
endif
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 and (SUIJI_TAVERN_SMALL[pid]==null or GetUnitTypeId(SUIJI_TAVERN_SMALL[pid])==0) then
set SUIJI_TAVERN_SMALL[pid]=CreateUnit(p,'nT91',x-180.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_SMALL[pid],false)
call NP7(GetHandleId(SUIJI_TAVERN_SMALL[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavern_Fill(SUIJI_TAVERN_SMALL[pid],hero,1)
set created=true
endif
if OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 and (SUIJI_TAVERN_ULT[pid]==null or GetUnitTypeId(SUIJI_TAVERN_ULT[pid])==0) then
set SUIJI_TAVERN_ULT[pid]=CreateUnit(p,'nT92',x+180.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_ULT[pid],false)
call NP7(GetHandleId(SUIJI_TAVERN_ULT[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavern_Fill(SUIJI_TAVERN_ULT[pid],hero,2)
set created=true
endif
if created and SUIJI_TAVERN_TIMEOUT[pid]==null then
set t=CreateTimer()
set SUIJI_TAVERN_TIMEOUT[pid]=t
call SaveUnitHandle(L7,GetHandleId(t),0,hero)
call SaveInteger(L7,GetHandleId(t),1,pid)
call TimerStart(t,240.,false,function SuijiTavern_Timeout)
endif
if created then
call ClearSelectionForPlayer(p)
if SUIJI_TAVERN_SMALL[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
call PanCameraToTimedForPlayer(p,GetUnitX(SUIJI_TAVERN_SMALL[pid]),GetUnitY(SUIJI_TAVERN_SMALL[pid]),.30)
else
call SelectUnitAddForPlayer(SUIJI_TAVERN_ULT[pid],p)
call PanCameraToTimedForPlayer(p,GetUnitX(SUIJI_TAVERN_ULT[pid]),GetUnitY(SUIJI_TAVERN_ULT[pid]),.30)
endif
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：请在小技能酒馆和大招酒馆各选择1项；每馆可花25金币无限刷新|r")
endif
set t=null
set p=null
endfunction
function SuijiTavern_Refresh takes unit tavern,unit hero,integer kind returns nothing
local player p=null
local integer h=0
local integer left=0
local boolean freeRandom=false
if tavern==null or hero==null or GetUnitTypeId(tavern)==0 or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set h=GetHandleId(tavern)
set freeRandom=SpecialTitle_HasFreeRandom(p)
if freeRandom==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<25 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：刷新需要25金币|r")
set p=null
return
endif
if freeRandom==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-25)
endif
call SuijiTavern_Fill(tavern,hero,kind)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(tavern,p)
if freeRandom then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：称号特权免费刷新候选，可无限刷新|r")
else
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已花费25金币刷新候选，可无限刷新|r")
endif
set p=null
endfunction
function SuijiTavern_OnEvent takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local unit sold=null
local unit tavern=null
local unit hero=null
local integer pid=0
local integer skill=0
local integer spell=0
if SUIJI_MODE==false then
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SELL then
set sold=GetSoldUnit()
set tavern=GetSellingUnit()
if sold!=null then
set pid=GetPlayerId(GetOwningPlayer(sold))
set skill=GetUnitTypeId(sold)
if tavern==SUIJI_TAVERN_SMALL[pid] then
call RemoveUnit(sold)
set hero=M7[pid]
call SuijiTavern_Choose(hero,1,skill)
elseif tavern==SUIJI_TAVERN_ULT[pid] then
call RemoveUnit(sold)
set hero=M7[pid]
call SuijiTavern_Choose(hero,2,skill)
endif
endif
else
set tavern=b1060GetTriggerUnit
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
set spell=b1060B287_GetSpellAbilityId
if tavern==SUIJI_TAVERN_SMALL[pid] and spell=='A4T1' then
call SuijiTavern_Refresh(tavern,hero,1)
elseif tavern==SUIJI_TAVERN_ULT[pid] and spell=='A4T2' then
call SuijiTavern_Refresh(tavern,hero,2)
endif
endif
set sold=null
set tavern=null
set hero=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiTavernB295_ClearStock takes unit tavern returns nothing
local integer i=1
local integer h=0
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
loop
exitwhen i>9
set proxy=LoadInteger(L7,h,80+i)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
endif
call SaveInteger(L7,h,i,0)
call SaveInteger(L7,h,20+i,0)
call SaveInteger(L7,h,40+i,0)
call SaveStr(L7,h,60+i,"")
call SaveInteger(L7,h,80+i,0)
set i=i+1
endloop
call NP7(h,"SuijiTavernCount",0)
endfunction
function SuijiTavernB302_ProxyId takes integer kind,integer source,integer slot,integer skill returns integer
local integer proxyNumber=0
if skill=='A1S7' then
set proxyNumber=365
elseif skill=='A2CI' then
// Duel is pool row 125 (v625); its native hero source 55 would display Reverse Polarity.
set proxyNumber=625
elseif skill=='A0DL' then
// Enchant Totem is row 8 slot 2 (v026); bound choices otherwise pass slot 1 (Fissure).
set proxyNumber=26
elseif skill=='A1RD' then
// Skewer uses pool row 55 slot 3 (v168), not native hero source 106.
set proxyNumber=168
elseif skill=='A13T' then
// Bound choices pass slot 1; Tidebringer is row 46 slot 2 (v140), not Torrent (v139).
set proxyNumber=140
elseif skill=='A1YQ' then
set proxyNumber=990
elseif skill=='A0VQ' then
set proxyNumber=616
elseif skill=='A0VG' then
set proxyNumber=617
elseif skill=='A0VN' then
set proxyNumber=618
elseif skill=='A0VM' then
set proxyNumber=619
elseif kind==2 then
set proxyNumber=500+source
else
set proxyNumber=source*3+slot
endif
return 'v000'+(proxyNumber/100)*65536+((proxyNumber/10)-((proxyNumber/100)*10))*256+proxyNumber-((proxyNumber/10)*10)
endfunction
function SuijiTavernB749_HasProxy takes unit tavern,integer proxy returns boolean
local integer tavernLogIndex=1
local integer tavernLogCount=0
if tavern==null or GetUnitTypeId(tavern)==0 or proxy==0 then
return false
endif
set tavernLogCount=OM7(GetHandleId(tavern),"SuijiTavernCount")
if tavernLogCount<8 then
set tavernLogCount=8
endif
loop
exitwhen tavernLogIndex>tavernLogCount or tavernLogIndex>9
if LoadInteger(L7,GetHandleId(tavern),80+tavernLogIndex)==proxy then
return true
endif
set tavernLogIndex=tavernLogIndex+1
endloop
return false
endfunction
function SuijiTavernB750_RawChar takes integer rawCharValue returns string
if rawCharValue>=48 and rawCharValue<=57 then
return SubString("0123456789",rawCharValue-48,rawCharValue-47)
elseif rawCharValue>=65 and rawCharValue<=90 then
return SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",rawCharValue-65,rawCharValue-64)
elseif rawCharValue>=97 and rawCharValue<=122 then
return SubString("abcdefghijklmnopqrstuvwxyz",rawCharValue-97,rawCharValue-96)
endif
return "?"
endfunction
function SuijiTavernB750_RawId takes integer rawObjectId returns string
return SuijiTavernB750_RawChar(rawObjectId/16777216)+SuijiTavernB750_RawChar(ModuloInteger(rawObjectId/65536,256))+SuijiTavernB750_RawChar(ModuloInteger(rawObjectId/256,256))+SuijiTavernB750_RawChar(ModuloInteger(rawObjectId,256))
endfunction
function SuijiTavernB749_LogStock takes unit tavern,integer kind returns nothing
local player tavernLogPlayer=null
local integer tavernLogIndex=1
local integer tavernLogCount=0
local integer tavernLogSkill=0
local integer tavernLogProxy=0
if SUIJI_LOG==false or tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set tavernLogPlayer=GetOwningPlayer(tavern)
set tavernLogCount=OM7(GetHandleId(tavern),"SuijiTavernCount")
if kind==2 then
call DisplayTimedTextToPlayer(tavernLogPlayer,0,0,12.,"|cFF66CCFF随机OMG日志[TAVERN-ULT]：|r实际候选="+I2S(tavernLogCount)+"（应为8）")
else
call DisplayTimedTextToPlayer(tavernLogPlayer,0,0,12.,"|cFF66CCFF随机OMG日志[TAVERN-SMALL]：|r实际候选="+I2S(tavernLogCount)+"（应为8）")
endif
loop
exitwhen tavernLogIndex>tavernLogCount or tavernLogIndex>9
set tavernLogSkill=LoadInteger(L7,GetHandleId(tavern),tavernLogIndex)
set tavernLogProxy=LoadInteger(L7,GetHandleId(tavern),80+tavernLogIndex)
call DisplayTimedTextToPlayer(tavernLogPlayer,0,0,12.,"  "+I2S(tavernLogIndex)+". ["+SuijiTavernB750_RawId(tavernLogSkill)+"] "+GetAbilityName(tavernLogSkill)+"  proxy=["+SuijiTavernB750_RawId(tavernLogProxy)+"]")
set tavernLogIndex=tavernLogIndex+1
endloop
set tavernLogPlayer=null
endfunction
function SuijiTavernB295_Lock takes unit tavern,integer kind returns nothing
local integer h=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set h=GetHandleId(tavern)
call SuijiTavernB295_ClearStock(tavern)
call NP7(h,"SuijiTavernLocked",1)
call NP7(h,"SuijiTavernRefreshLeft",0)
if kind==2 then
call UnitRemoveAbility(tavern,'A4T2')
call MHUnit_SetInfoName(tavern,"随机大招酒馆（已选择）")
else
call UnitRemoveAbility(tavern,'A4T1')
call MHUnit_SetInfoName(tavern,"随机小技能酒馆（已选择）")
endif
endfunction
function SuijiTavernB295_HasChosen takes unit hero,integer kind returns boolean
local integer h=0
if hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set h=GetHandleId(hero)
if kind==2 then
return OM7(h,"SuijiUltSkill")!=0 or OM7(h,"SuijiTavernUltPendingSkill")!=0
endif
return OM7(h,"SuijiSmallSkill")!=0
endfunction
function SuijiTavernB295_SyncLock takes unit hero,unit tavern,integer kind returns boolean
if SuijiTavernB295_HasChosen(hero,kind) then
call SuijiTavernB295_Lock(tavern,kind)
return true
endif
return false
endfunction
function SuijiTavernB295_Fill takes unit tavern,integer kind returns integer
local boolean b895Extra=false
local integer b895ExtraProxy=0
local integer tries=0
local integer idx=0
local integer slot=0
local integer count=0
local integer skill=0
local integer helper=0
local integer boundSkill=0
local integer boundHelper=0
local integer boundSource=0
local integer proxy=0
local integer boundProxy=0
local integer tavernTargetCount=8
local integer th=0
local integer pid=0
local boolean titled=false
local string order=""
local string boundOrder=""
local unit hero=null
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
if OM7(GetHandleId(tavern),"SuijiTavernLocked")!=0 then
return 0
endif
call SuijiTavernB295_ClearStock(tavern)
set th=GetHandleId(tavern)
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
if kind==1 then
set boundSkill=SpecialTitle_GetBoundRandomSmall(Player(pid))
set boundHelper=SpecialTitle_GetBoundRandomSmallHelper(boundSkill)
set boundSource=SpecialTitle_GetBoundRandomSmallSource(boundSkill)
set boundOrder=SpecialTitle_GetBoundRandomSmallOrder(boundSkill)
elseif kind==2 then
set boundSkill=SpecialTitle_GetBoundRandomUltimate(Player(pid))
set boundHelper=SpecialTitle_GetBoundRandomUltimateHelper(boundSkill)
set boundSource=SpecialTitle_GetBoundRandomUltimateSource(boundSkill)
set boundOrder=SpecialTitle_GetBoundRandomUltimateOrder(boundSkill)
endif
set titled=boundSkill!=0 and SuijiMode_IsRandomRollExcludedSkill(boundSkill)==false and (hero==null or GetUnitTypeId(hero)==0 or SuijiMode_CanUseSkill(hero,boundSkill,boundHelper,boundOrder)) and (kind!=1 or hero==null or GetUnitTypeId(hero)==0 or SuijiTavern_PendingConflict(hero,boundSkill,boundHelper,boundOrder)==false)
if titled then
set boundProxy=SuijiTavernB302_ProxyId(kind,boundSource,1,boundSkill)
set tavernTargetCount=7
endif
if kind==2 and B895HasExtraBoundMulticast(Player(pid)) and (hero==null or GetUnitTypeId(hero)==0 or SuijiMode_CanUseSkill(hero,'A088',0,"passive")) then
set b895ExtraProxy=SuijiTavernB302_ProxyId(2,18,1,'A088')
set b895Extra=b895ExtraProxy!=0 and b895ExtraProxy!=boundProxy
if b895Extra then
set tavernTargetCount=tavernTargetCount-1
endif
endif
loop
exitwhen tries>=1200 or count>=tavernTargetCount
set tries=tries+1
if kind==2 then
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX+1)
if idx==SUIJI_POOL_MAX+1 then
set idx=50
set skill='A1YQ'
set helper=0
set order="berserk"
else
set skill=HP4[idx]
set helper=HU4[idx]
set order=HZ4[idx]
endif
else
set idx=GetRandomInt(KL4,SUIJI_POOL_MAX)
set slot=GetRandomInt(1,3)
if slot==1 then
set skill=HM4[idx]
set helper=HR4[idx]
set order=HW4[idx]
elseif slot==2 then
set skill=HN4[idx]
set helper=HS4[idx]
set order=HX4[idx]
else
set skill=HO4[idx]
set helper=HT4[idx]
set order=HY4[idx]
endif
endif
set order=SuijiMode_RandomOrder(skill,order)
if SuijiMode_IsRandomRollExcludedSkill(skill)==false and skill!=0 and order!="" and (helper!=0 or SuijiMode_CanSkipHelper(skill)) and SuijiTavern_HasStock(tavern,skill)==false and (titled==false or skill!=boundSkill) and (hero==null or GetUnitTypeId(hero)==0 or SuijiMode_CanUseSkill(hero,skill,helper,order)) and (kind!=1 or hero==null or GetUnitTypeId(hero)==0 or SuijiTavern_PendingConflict(hero,skill,helper,order)==false) then
set proxy=SuijiTavernB302_ProxyId(kind,idx,slot,skill)
if proxy!=0 and SuijiTavernB749_HasProxy(tavern,proxy)==false and (titled==false or proxy!=boundProxy) and (b895Extra==false or (skill!='A088' and proxy!=b895ExtraProxy)) and (kind!=2 or SuijiMode_PassesUltimateRoll(skill)) then
set count=count+1
call SaveInteger(L7,th,count,skill)
call SaveInteger(L7,th,20+count,helper)
call SaveInteger(L7,th,40+count,SuijiMode_GetPoolSkillSource(idx,skill))
call SaveStr(L7,th,60+count,order)
call SaveInteger(L7,th,80+count,proxy)
call AddUnitToStock(tavern,proxy,1,1)
endif
endif
endloop
if titled and SuijiTavern_HasStock(tavern,boundSkill)==false and boundProxy!=0 and SuijiTavernB749_HasProxy(tavern,boundProxy)==false then
set count=count+1
call SaveInteger(L7,th,count,boundSkill)
call SaveInteger(L7,th,20+count,boundHelper)
call SaveInteger(L7,th,40+count,boundSource)
call SaveStr(L7,th,60+count,boundOrder)
call SaveInteger(L7,th,80+count,boundProxy)
call AddUnitToStock(tavern,boundProxy,1,1)
endif
if b895Extra and SuijiTavern_HasStock(tavern,'A088')==false and SuijiTavernB749_HasProxy(tavern,b895ExtraProxy)==false then
set count=count+1
call SaveInteger(L7,th,count,'A088')
call SaveInteger(L7,th,20+count,0)
call SaveInteger(L7,th,40+count,18)
call SaveStr(L7,th,60+count,"passive")
call SaveInteger(L7,th,80+count,b895ExtraProxy)
call AddUnitToStock(tavern,b895ExtraProxy,1,1)
endif
call NP7(th,"SuijiTavernCount",count)
if SUIJI_LOG then
call DisplayTimedTextToPlayer(Player(pid),0,0,12.,"|cFF66CCFF随机OMG日志[TAVERN-FILL]：|r尝试="+I2S(tries)+"，随机目标="+I2S(tavernTargetCount)+"，最终="+I2S(count))
endif
call SuijiTavernB749_LogStock(tavern,kind)
if hero!=null and GetUnitTypeId(hero)!=0 then
call SaveInteger(L7,th,100,GetHandleId(hero))
call SaveInteger(L7,th,101,OM7(GetHandleId(hero),"SuijiSmallSkill"))
call SaveInteger(L7,th,102,OM7(GetHandleId(hero),"SuijiUltSkill"))
call SaveInteger(L7,th,103,OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill"))
else
call SaveInteger(L7,th,100,0)
call SaveInteger(L7,th,101,0)
call SaveInteger(L7,th,102,0)
call SaveInteger(L7,th,103,0)
endif
set order=""
set boundOrder=""
set hero=null
return count
endfunction
function SuijiTavernB295_FindChoice takes unit tavern,integer skill returns integer
local integer i=1
local integer h=0
local integer count=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
set h=GetHandleId(tavern)
set count=OM7(h,"SuijiTavernCount")
loop
exitwhen i>count or i>9
if LoadInteger(L7,h,i)==skill then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_FindChoiceByProxy takes unit tavern,integer proxy returns integer
local integer i=1
local integer h=0
local integer count=0
if tavern==null or GetUnitTypeId(tavern)==0 or proxy==0 then
return 0
endif
set h=GetHandleId(tavern)
set count=OM7(h,"SuijiTavernCount")
loop
exitwhen i>count or i>9
if LoadInteger(L7,h,80+i)==proxy then
return i
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_DiscardChoice takes unit tavern,integer choice returns nothing
local integer h=0
local integer skill=0
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 or choice<=0 or choice>9 then
return
endif
set h=GetHandleId(tavern)
set skill=LoadInteger(L7,h,choice)
set proxy=LoadInteger(L7,h,80+choice)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
endif
call SaveInteger(L7,h,choice,0)
call SaveInteger(L7,h,20+choice,0)
call SaveInteger(L7,h,40+choice,0)
call SaveStr(L7,h,60+choice,"")
call SaveInteger(L7,h,80+choice,0)
endfunction
function SuijiTavernB295_RestoreChoice takes unit tavern,integer choice returns nothing
local integer proxy=0
if tavern==null or GetUnitTypeId(tavern)==0 or choice<=0 or choice>9 then
return
endif
set proxy=LoadInteger(L7,GetHandleId(tavern),80+choice)
if proxy!=0 then
call RemoveUnitFromStock(tavern,proxy)
call AddUnitToStock(tavern,proxy,1,1)
endif
endfunction
function SuijiTavernB295_IsStale takes unit tavern,unit hero,integer kind returns boolean
local integer th=0
if tavern==null or GetUnitTypeId(tavern)==0 or hero==null or GetUnitTypeId(hero)==0 then
return false
endif
set th=GetHandleId(tavern)
if kind==2 then
return LoadInteger(L7,th,102)!=OM7(GetHandleId(hero),"SuijiUltSkill") or LoadInteger(L7,th,103)!=OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")
endif
return LoadInteger(L7,th,101)!=OM7(GetHandleId(hero),"SuijiSmallSkill")
endfunction
function SuijiTavernB295_FirstChoice takes unit tavern returns integer
local integer h=0
local integer i=1
local integer skill=0
if tavern==null or GetUnitTypeId(tavern)==0 then
return 0
endif
set h=GetHandleId(tavern)
loop
exitwhen i>9
set skill=LoadInteger(L7,h,i)
if skill!=0 then
return skill
endif
set i=i+1
endloop
return 0
endfunction
function SuijiTavernB295_FocusNext takes unit hero returns nothing
local player p=null
local integer pid=0
local unit next=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if OM7(GetHandleId(hero),"SuijiSmallSkill")==0 then
set next=SUIJI_TAVERN_SMALL[pid]
elseif OM7(GetHandleId(hero),"SuijiUltSkill")==0 and OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")==0 then
set next=SUIJI_TAVERN_ULT[pid]
endif
call ClearSelectionForPlayer(p)
if next!=null and GetUnitTypeId(next)!=0 then
call SelectUnitAddForPlayer(next,p)
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
else
call SuijiTavern_StopTimeout(pid)
call SelectUnitAddForPlayer(hero,p)
call PanCameraToTimedForPlayer(p,GetUnitX(hero),GetUnitY(hero),.30)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFF00FF00随机OMG：英雄、小技能和大招均已选择完成|r")
endif
set next=null
set p=null
endfunction
function SuijiTavernB295_Choose takes unit hero,integer kind,integer skill returns integer
local player p=null
local integer pid=0
local integer h=0
local integer choice=0
local integer helper=0
local integer source=0
local integer result=0
local string order=""
local unit tavern=null
if hero==null or GetUnitTypeId(hero)==0 or skill==0 then
return 0
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
set h=GetHandleId(hero)
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if tavern==null or GetUnitTypeId(tavern)==0 then
set p=null
return 0
endif
if SuijiTavernB295_SyncLock(hero,tavern,kind) then
if kind==2 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外大招|r")
else
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外小技能|r")
endif
set tavern=null
set p=null
return 0
endif
if OM7(GetHandleId(tavern),"SuijiTavernLocked")!=0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：当前技能酒馆已经完成选择|r")
set tavern=null
set p=null
return 0
endif
set choice=SuijiTavernB295_FindChoice(tavern,skill)
if choice<=0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：本次选择无效，当前酒馆候选保持不变|r")
set tavern=null
set p=null
return 0
endif
set helper=LoadInteger(L7,GetHandleId(tavern),20+choice)
set source=LoadInteger(L7,GetHandleId(tavern),40+choice)
set order=LoadStr(L7,GetHandleId(tavern),60+choice)
set order=SuijiMode_RandomOrder(skill,order)
if SuijiMode_IsNativeRegisteredSkill(hero,skill) then
call SuijiTavernB295_RestoreChoice(tavern,choice)
call DisplayTimedTextToPlayer(p,0,0,10.,"|cFFFFCC00随机OMG："+GetObjectName(skill)+" 与已选择英雄的原生技能重复，本次选择无效，酒馆不刷新|r")
set order=""
set tavern=null
set p=null
return 0
endif
if SuijiMode_CanUseSkill(hero,skill,helper,order)==false or (kind==1 and SuijiTavern_PendingConflict(hero,skill,helper,order)) then
call SuijiTavernB295_RestoreChoice(tavern,choice)
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00随机OMG：该技能与当前英雄或另一项选择冲突，本次选择无效，酒馆不刷新|r")
set order=""
set tavern=null
set p=null
return 0
endif
if kind==2 and SuijiMode_UltLevel(hero)<=0 then
call NP7(h,"SuijiTavernUltPendingSkill",skill)
call NP7(h,"SuijiTavernUltPendingHelper",helper)
call NP7(h,"SuijiTavernUltPendingSource",source)
call NR7(h,"SuijiTavernUltPendingOrder",order)
set result=skill
call SuijiMode_NotifyPickedSkill(hero,skill,"额外大招","预选了")
elseif kind==2 then
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_UltLevel(hero),source,"SuijiUlt")
if result!=0 then
call SuijiMode_NotifyPickedSkill(hero,result,"额外大招","选择了")
endif
else
set result=SuijiMode_AddSkill(hero,skill,helper,order,SuijiMode_SmallLevel(hero),source,"SuijiSmall")
if result!=0 then
call SuijiMode_NotifyPickedSkill(hero,result,"额外小技能","选择了")
endif
endif
if result!=0 then
if kind==2 and result=='A088' then
call SuijiSuperAI_NotifyMulticastSelection(hero)
endif
call SuijiTavernB295_SyncLock(hero,tavern,kind)
call SuijiTavernB295_FocusNext(hero)
endif
set order=""
set tavern=null
set p=null
return result
endfunction
function SuijiTavernB295_UpdateCountdown takes integer pid,integer remaining returns nothing
local unit tavern=SUIJI_TAVERN_SMALL[pid]
if tavern!=null and GetUnitTypeId(tavern)!=0 and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call MHUnit_SetInfoName(tavern,"随机小技能酒馆（剩余"+I2S(remaining)+"秒）")
endif
set tavern=SUIJI_TAVERN_ULT[pid]
if tavern!=null and GetUnitTypeId(tavern)!=0 and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call MHUnit_SetInfoName(tavern,"随机大招酒馆（剩余"+I2S(remaining)+"秒）")
endif
set tavern=null
endfunction
function SuijiTavernB295_Timeout takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit hero=LoadUnitHandle(L7,th,0)
local integer pid=LoadInteger(L7,th,1)
local integer skill=0
local integer remaining=LoadInteger(L7,th,2)-1
local integer tries=0
local integer result=0
if hero!=null and GetUnitTypeId(hero)!=0 and (SuijiTavernB295_HasChosen(hero,1)==false or SuijiTavernB295_HasChosen(hero,2)==false) and remaining>0 then
call SaveInteger(L7,th,2,remaining)
call SuijiTavernB295_UpdateCountdown(pid,remaining)
set hero=null
set t=null
return
endif
if hero!=null and GetUnitTypeId(hero)!=0 and remaining<=0 then
set SUIJI_TAVERN_TIMEOUT[pid]=null
if SuijiTavernB295_HasChosen(hero,1)==false and SUIJI_TAVERN_SMALL[pid]!=null then
set tries=0
loop
exitwhen tries>=8 or SuijiTavernB295_HasChosen(hero,1)
if tries>0 or SuijiTavernB295_IsStale(SUIJI_TAVERN_SMALL[pid],hero,1) then
call SuijiTavernB295_Fill(SUIJI_TAVERN_SMALL[pid],1)
endif
set skill=SuijiTavernB295_FirstChoice(SUIJI_TAVERN_SMALL[pid])
set result=SuijiTavernB295_Choose(hero,1,skill)
set tries=tries+1
endloop
endif
if SuijiTavernB295_HasChosen(hero,2)==false and SUIJI_TAVERN_ULT[pid]!=null then
set tries=0
loop
exitwhen tries>=8 or SuijiTavernB295_HasChosen(hero,2)
if tries>0 or SuijiTavernB295_IsStale(SUIJI_TAVERN_ULT[pid],hero,2) then
call SuijiTavernB295_Fill(SUIJI_TAVERN_ULT[pid],2)
endif
set skill=SuijiTavernB295_FirstChoice(SUIJI_TAVERN_ULT[pid])
set result=SuijiTavernB295_Choose(hero,2,skill)
set tries=tries+1
endloop
endif
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：240秒选择时间结束，未选择的小技能和大招已自动随机确定|r")
else
set SUIJI_TAVERN_TIMEOUT[pid]=null
endif
call FlushChildHashtable(L7,th)
call PauseTimer(t)
call DestroyTimer(t)
set hero=null
set t=null
endfunction
function SuijiTavernB295_Start takes unit hero returns nothing
local player p=null
local integer pid=0
local boolean first=false
local timer t=null
if hero==null or GetUnitTypeId(hero)==0 then
return
endif
set p=GetOwningPlayer(hero)
set pid=GetPlayerId(p)
if GetPlayerController(p)!=MAP_CONTROL_USER then
set p=null
return
endif
if SUIJI_TAVERN_SMALL[pid]==null or GetUnitTypeId(SUIJI_TAVERN_SMALL[pid])==0 then
call ExecuteFunc("SuijiTavernB295_CreateSelectionArea")
endif
if SUIJI_TAVERN_TIMEOUT[pid]==null and OM7(GetHandleId(hero),"SuijiSmallSkill")==0 then
set t=CreateTimer()
set SUIJI_TAVERN_TIMEOUT[pid]=t
call SaveUnitHandle(L7,GetHandleId(t),0,hero)
call SaveInteger(L7,GetHandleId(t),1,pid)
call SaveInteger(L7,GetHandleId(t),2,240)
call SuijiTavernB295_UpdateCountdown(pid,240)
call TimerStart(t,1.,true,function SuijiTavernB295_Timeout)
endif
set first=OO7(GetHandleId(hero),"SuijiTavernStarted")==false
if first then
call NS7(GetHandleId(hero),"SuijiTavernStarted",true)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
if SpecialTitle_HasFreeRandom(p) then
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：请使用左上角对应玩家颜色的一行三个个人酒馆；称号特权可免费无限刷新技能|r")
else
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：请使用左上角对应玩家颜色的一行三个个人酒馆；小技能刷新50金币，大招刷新100金币|r")
endif
endif
set t=null
set p=null
endfunction
function SuijiTavernB295_Refresh takes unit tavern,unit hero,integer kind returns nothing
local player p=null
local integer h=0
local integer left=0
local integer cost=50
local boolean freeRandom=false
if tavern==null or GetUnitTypeId(tavern)==0 then
return
endif
set p=GetOwningPlayer(tavern)
set h=GetHandleId(tavern)
set freeRandom=SpecialTitle_HasFreeRandom(p)
if kind==2 then
set cost=100
endif
if OM7(h,"SuijiTavernLocked")!=0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：当前技能酒馆已经完成选择|r")
set p=null
return
endif
if hero!=null and GetUnitTypeId(hero)!=0 then
if kind==1 and OM7(GetHandleId(hero),"SuijiSmallSkill")!=0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外小技能|r")
set p=null
return
elseif kind==2 and (OM7(GetHandleId(hero),"SuijiUltSkill")!=0 or OM7(GetHandleId(hero),"SuijiTavernUltPendingSkill")!=0) then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外大招|r")
set p=null
return
endif
endif
if freeRandom==false and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<cost then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：刷新需要"+I2S(cost)+"金币|r")
set p=null
return
endif
if freeRandom==false then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-cost)
endif
call SuijiTavernB295_Fill(tavern,kind)
call ClearSelectionForPlayer(p)
call SelectUnitAddForPlayer(tavern,p)
if freeRandom then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：称号特权免费刷新候选，可无限刷新|r")
else
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFF00FF00随机OMG：已花费"+I2S(cost)+"金币刷新候选，可无限刷新|r")
endif
set p=null
endfunction
function SuijiTavernB295_RemoveOldTopLeft takes nothing returns nothing
local integer i=1
local unit u=null
loop
exitwhen i>12
set u=BZ4[i]
if u!=null and GetUnitTypeId(u)!=0 then
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set BZ4[i]=null
set i=i+1
endloop
set MP4=null
set MQ4=null
set MR4=null
set MS4=null
set MT4=null
set MU4=null
set MV4=null
set MW4=null
set MX4=null
set MY4=null
set MZ4=null
set MA4=null
set u=null
endfunction
function SuijiTavernB295_ReplaceHeroStore takes integer pid,real x,real y returns nothing
local player p=Player(pid)
local unit old=KU4[pid]
local unit tavern=null
local integer oldHandle=0
local integer newHandle=0
local integer heroType=0
local integer i=1
if old==null or GetUnitTypeId(old)==0 then
set old=null
set p=null
return
endif
set oldHandle=GetHandleId(old)
call SuijiTavernB316_LimitHeroChoices(old)
set tavern=CreateUnit(p,'nT90',x,y,270.)
set newHandle=GetHandleId(tavern)
call SetUnitPathing(tavern,false)
call SetUnitScale(tavern,.70,.70,.70)
loop
exitwhen i>4
set heroType=LoadInteger(TABLE_XJ,oldHandle,i)
if heroType!=0 then
call SaveInteger(TABLE_XJ,newHandle,i,heroType)
call AddUnitToStock(tavern,heroType,1,1)
call RemoveUnitFromStock(old,heroType)
endif
set i=i+1
endloop
call SaveInteger(TABLE_XJ,newHandle,100,LoadInteger(TABLE_XJ,oldHandle,100))
call UnitAddAbility(tavern,'A4DD')
call UnitAddAbility(tavern,'A4EP')
call ShowUnit(old,true)
set SUIJI_TAVERN_HERO[pid]=tavern
set old=null
set tavern=null
set p=null
endfunction
function SuijiTavernB295_CreateSelectionArea takes nothing returns nothing
local integer pid=1
local integer row=0
local player p=null
local real x=0.
local real y=0.
if SUIJI_TAVERN_AREA_READY then
return
endif
set SUIJI_TAVERN_AREA_READY=true
call SuijiTavernB295_RemoveOldTopLeft()
loop
exitwhen pid>11
if pid==6 then
set pid=7
endif
set p=Player(pid)
if GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
if pid<=5 then
set row=pid-1
set x=-7424.
else
set row=pid-7
set x=-6912.
endif
set y=7104.-160.*I2R(row)
call SuijiTavernB295_ReplaceHeroStore(pid,x,y)
set SUIJI_TAVERN_SMALL[pid]=CreateUnit(p,'nT91',x+160.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_SMALL[pid],false)
call SetUnitScale(SUIJI_TAVERN_SMALL[pid],.70,.70,.70)
call NP7(GetHandleId(SUIJI_TAVERN_SMALL[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavernB295_Fill(SUIJI_TAVERN_SMALL[pid],1)
set SUIJI_TAVERN_ULT[pid]=CreateUnit(p,'nT92',x+320.,y,270.)
call SetUnitPathing(SUIJI_TAVERN_ULT[pid],false)
call SetUnitScale(SUIJI_TAVERN_ULT[pid],.70,.70,.70)
call NP7(GetHandleId(SUIJI_TAVERN_ULT[pid]),"SuijiTavernRefreshLeft",3)
call SuijiTavernB295_Fill(SUIJI_TAVERN_ULT[pid],2)
call ClearSelectionForPlayer(p)
if SUIJI_TAVERN_HERO[pid]!=null and GetUnitTypeId(SUIJI_TAVERN_HERO[pid])!=0 then
call SelectUnitAddForPlayer(SUIJI_TAVERN_HERO[pid],p)
endif
call PanCameraToTimedForPlayer(p,-6880.,6784.,.30)
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFF00FF00随机OMG：左上角对应玩家颜色的一行三个酒馆；英雄酒馆每次显示4个英雄，依次选择原生英雄、小技能和大招|r")
endif
set pid=pid+1
endloop
set p=null
endfunction
function SuijiTavernB295_OnEvent takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetBuyingUnit=GetBuyingUnit()
local unit b1060GetSellingUnit=GetSellingUnit()
local unit b1060GetSoldUnit=GetSoldUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local unit sold=null
local unit tavern=null
local unit hero=null
local unit buyer=null
local player p=null
local integer pid=0
local integer shopPid=0
local integer skill=0
local integer proxy=0
local integer choice=0
local integer spell=0
if SUIJI_MODE==false then
set b1060ReturnValue=false
set b1060GetBuyingUnit=null
set b1060GetSellingUnit=null
set b1060GetSoldUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SELECTED then
set tavern=b1060GetTriggerUnit
set p=GetTriggerPlayer()
set pid=GetPlayerId(p)
set hero=M7[pid]
set shopPid=GetPlayerId(GetOwningPlayer(tavern))
if tavern==SUIJI_TAVERN_SMALL[pid] then
if SuijiTavernB295_IsStale(tavern,hero,1) and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call SuijiTavernB295_Fill(tavern,1)
endif
if SuijiTavernB295_SyncLock(hero,tavern,1)==false and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 and OM7(GetHandleId(tavern),"SuijiTavernCount")<=0 then
call SuijiTavernB295_Fill(tavern,1)
endif
elseif tavern==SUIJI_TAVERN_ULT[pid] then
if SuijiTavernB295_IsStale(tavern,hero,2) and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 then
call SuijiTavernB295_Fill(tavern,2)
endif
if SuijiTavernB295_SyncLock(hero,tavern,2)==false and OM7(GetHandleId(tavern),"SuijiTavernLocked")==0 and OM7(GetHandleId(tavern),"SuijiTavernCount")<=0 then
call SuijiTavernB295_Fill(tavern,2)
endif
elseif shopPid!=pid and (tavern==SUIJI_TAVERN_SMALL[shopPid] or tavern==SUIJI_TAVERN_ULT[shopPid] or tavern==SUIJI_TAVERN_HERO[shopPid]) then
call ClearSelectionForPlayer(p)
if tavern==SUIJI_TAVERN_SMALL[shopPid] and SUIJI_TAVERN_SMALL[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_SMALL[pid],p)
elseif tavern==SUIJI_TAVERN_ULT[shopPid] and SUIJI_TAVERN_ULT[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_ULT[pid],p)
elseif SUIJI_TAVERN_HERO[pid]!=null then
call SelectUnitAddForPlayer(SUIJI_TAVERN_HERO[pid],p)
endif
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：只能查看和选择自己颜色对应的一行三个酒馆|r")
endif
elseif b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SELL then
set sold=b1060GetSoldUnit
set tavern=b1060GetSellingUnit
if sold!=null then
set buyer=b1060GetBuyingUnit
if buyer!=null and GetUnitTypeId(buyer)!=0 then
set pid=GetPlayerId(GetOwningPlayer(buyer))
else
set pid=GetPlayerId(GetOwningPlayer(sold))
endif
set shopPid=GetPlayerId(GetOwningPlayer(tavern))
set proxy=GetUnitTypeId(sold)
if tavern==SUIJI_TAVERN_SMALL[shopPid] or tavern==SUIJI_TAVERN_ULT[shopPid] then
call RemoveUnit(sold)
if pid!=shopPid then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：只能从自己颜色对应的技能酒馆选择|r")
else
set choice=SuijiTavernB295_FindChoiceByProxy(tavern,proxy)
if choice<=0 then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：候选技能数据无效，本次选择无效，酒馆不刷新|r")
else
set skill=LoadInteger(L7,GetHandleId(tavern),choice)
set hero=M7[pid]
if hero==null or GetUnitTypeId(hero)==0 then
call AddUnitToStock(tavern,proxy,1,1)
call DisplayTimedTextToPlayer(Player(pid),0,0,8.,"|cFFFFCC00随机OMG：请先在英雄酒馆选择原生英雄|r")
elseif tavern==SUIJI_TAVERN_SMALL[pid] then
if SuijiTavernB295_SyncLock(hero,tavern,1) then
call DisplayTimedTextToPlayer(Player(pid),0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外小技能|r")
else
call SuijiTavernB295_Choose(hero,1,skill)
call SuijiTavernB295_SyncLock(hero,tavern,1)
endif
else
if SuijiTavernB295_SyncLock(hero,tavern,2) then
call DisplayTimedTextToPlayer(Player(pid),0,0,6.,"|cFFFFCC00随机OMG：你已经选择了额外大招|r")
else
call SuijiTavernB295_Choose(hero,2,skill)
call SuijiTavernB295_SyncLock(hero,tavern,2)
endif
endif
endif
endif
endif
endif
else
set tavern=b1060GetTriggerUnit
set pid=GetPlayerId(GetOwningPlayer(tavern))
set hero=M7[pid]
set spell=b1060B287_GetSpellAbilityId
if tavern==SUIJI_TAVERN_SMALL[pid] and spell=='A4T1' then
call SuijiTavernB295_Refresh(tavern,hero,1)
elseif tavern==SUIJI_TAVERN_ULT[pid] and spell=='A4T2' then
call SuijiTavernB295_Refresh(tavern,hero,2)
endif
endif
set sold=null
set tavern=null
set hero=null
set buyer=null
set p=null
set b1060ReturnValue=false
set b1060GetBuyingUnit=null
set b1060GetSellingUnit=null
set b1060GetSoldUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiTest_RechooseUnlockTavern takes integer pid,integer kind returns nothing
local unit tavern=null
local integer h=0
if kind==2 then
set tavern=SUIJI_TAVERN_ULT[pid]
else
set tavern=SUIJI_TAVERN_SMALL[pid]
endif
if tavern!=null and GetUnitTypeId(tavern)!=0 then
set h=GetHandleId(tavern)
call SuijiTavernB295_ClearStock(tavern)
call NP7(h,"SuijiTavernLocked",0)
call NP7(h,"SuijiTavernRefreshLeft",3)
if kind==2 then
call UnitAddAbility(tavern,'A4T2')
else
call UnitAddAbility(tavern,'A4T1')
endif
call SuijiTavernB295_Fill(tavern,kind)
endif
set tavern=null
endfunction
function SuijiTest_PrepareUnlimitedRechoose takes nothing returns nothing
local player p=LoadPlayerHandle(L7,StringHash("SuijiTestRechoosePlayer"),0)
local integer pid=0
local integer heroIndex=0
local unit oldHero=null
local unit heroTavern=null
call RemoveSavedHandle(L7,StringHash("SuijiTestRechoosePlayer"),0)
if ISTEST==false or SUIJI_MODE==false or p==null then
set p=null
return
endif
set pid=GetPlayerId(p)
set oldHero=M7[pid]
if oldHero==null or GetUnitTypeId(oldHero)==0 then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cFFFFCC00随机OMG：请先选择英雄后再使用 -rechoose|r")
set oldHero=null
set p=null
return
endif
set heroIndex=SuijiMode_GetStableHeroIndex(oldHero)
call SuijiTavern_StopTimeout(pid)
call SuijiTest_RechooseUnlockTavern(pid,1)
call SuijiTest_RechooseUnlockTavern(pid,2)
if heroIndex>=KL4 and heroIndex<=K54 then
set J[heroIndex]=false
set heroTavern=SUIJI_TAVERN_HERO[pid]
if heroTavern!=null and GetUnitTypeId(heroTavern)!=0 then
call AddUnitToStock(heroTavern,K34[heroIndex],1,1)
endif
endif
call YE7(oldHero)
set M7[pid]=null
set I[pid]=false
set W4[pid]=false
set oo[pid]=false
set P9[pid]=false
set G9=true
set T9=false
set F9=true
call ClearSelectionForPlayer(p)
if heroTavern!=null and GetUnitTypeId(heroTavern)!=0 then
call SelectUnitAddForPlayer(heroTavern,p)
call PanCameraToTimedForPlayer(p,GetUnitX(heroTavern),GetUnitY(heroTavern),.30)
endif
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG测试：已重开英雄、小技能和大招选择，可再次使用 -rechoose|r")
set oldHero=null
set heroTavern=null
set p=null
endfunction
function SuijiTavern_Init takes nothing returns nothing
if SUIJI_TAVERN_TRIGGER==null then
set SUIJI_TAVERN_TRIGGER=CreateTrigger()
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SELL)
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(SUIJI_TAVERN_TRIGGER,EVENT_PLAYER_UNIT_SELECTED)
call TriggerAddCondition(SUIJI_TAVERN_TRIGGER,Condition(function SuijiTavernB295_OnEvent))
endif
endfunction
function SuijiMode_EnsureManaRegenBonus takes unit suijiManaRegenUnit returns nothing
local integer suijiManaRegenHandle=0
local real suijiManaRegenBase=0.
local real suijiManaRegenCurrent=0.
if SUIJI_MODE==false or suijiManaRegenUnit==null then
return
endif
if IsUnitType(suijiManaRegenUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiManaRegenUnit) or GetUnitTypeId(suijiManaRegenUnit)=='H00J' then
return
endif
set suijiManaRegenHandle=GetHandleId(suijiManaRegenUnit)
set suijiManaRegenCurrent=MHUnit_GetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN)
if OO7(suijiManaRegenHandle,"SuijiManaRegenBonus")==false then
call NS7(suijiManaRegenHandle,"SuijiManaRegenBonus",true)
call NQ7(suijiManaRegenHandle,"SuijiManaRegenBase",suijiManaRegenCurrent)
call MHUnit_SetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN,suijiManaRegenCurrent+2.)
return
endif
set suijiManaRegenBase=ON7(suijiManaRegenHandle,"SuijiManaRegenBase")
if suijiManaRegenCurrent<suijiManaRegenBase+1.99 then
call MHUnit_SetData(suijiManaRegenUnit,UNIT_DATA_MANA_REGEN,suijiManaRegenBase+2.)
endif
endfunction
function SuijiMode_InitLevelAttributeBonus takes unit suijiAttrUnit returns nothing
local integer suijiAttrHandle=0
if SUIJI_MODE==false or suijiAttrUnit==null then
return
endif
if IsUnitType(suijiAttrUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiAttrUnit) or GetUnitTypeId(suijiAttrUnit)=='H00J' then
return
endif
set suijiAttrHandle=GetHandleId(suijiAttrUnit)
if LoadInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"))<=0 then
call SaveInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"),GetHeroLevel(suijiAttrUnit))
endif
endfunction
function SuijiMode_IsRegisteredSourceSkill takes integer suijiSkillSource,integer suijiOwnedSkill returns boolean
local integer suijiRegisteredSlot=1
if suijiSkillSource<=0 or suijiOwnedSkill==0 then
return false
endif
loop
exitwhen suijiRegisteredSlot>10
if LoadInteger(MSK,suijiSkillSource,suijiRegisteredSlot)==suijiOwnedSkill then
return true
endif
set suijiRegisteredSlot=suijiRegisteredSlot+1
endloop
return false
endfunction
function SuijiMode_IsRubickStolenOwner takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='E02X' or id=='Z02X'
endfunction
function SuijiMode_PrepareRubickTelekinesisButton takes unit u returns nothing
local player p=null
if SuijiMode_IsRubickStolenOwner(u)==false then
return
endif
set p=GetOwningPlayer(u)
// Preload the temporary Telekinesis landing button before random/stolen skills
// fill the command card. Later casts only toggle visibility, so Warcraft does
// not rebuild and reorder Rubick's two stolen-skill buttons on the first lift.
if SuijiMode_EnsureExactLiveAbility(u,'A27X',true)==false then
set p=null
return
endif
call MHAbility_SetCustomDataInt(u,'A27X',ABILITY_DEF_DATA_BUTTON_X,0)
call MHAbility_SetCustomDataInt(u,'A27X',ABILITY_DEF_DATA_BUTTON_Y,2)
call SetPlayerAbilityAvailable(p,'A27X',false)
set p=null
endfunction
function SuijiMode_TelekinesisButtonBegin takes unit u returns nothing
local integer h=0
local integer active=0
if u==null or GetUnitTypeId(u)==0 or SuijiMode_HasNativeAbility(u,'A27X')==false then
return
endif
set h=GetHandleId(u)
set active=LoadInteger(L7,h,StringHash("SuijiRubickTelekinesisActive"))+1
call SaveInteger(L7,h,StringHash("SuijiRubickTelekinesisActive"),active)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27F',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27X',true)
endfunction
function SuijiMode_TelekinesisButtonEnd takes unit u returns nothing
local integer h=0
local integer active=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set active=LoadInteger(L7,h,StringHash("SuijiRubickTelekinesisActive"))-1
if active<=0 then
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickTelekinesisActive"))
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27F',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27X',false)
else
call SaveInteger(L7,h,StringHash("SuijiRubickTelekinesisActive"),active)
// Another multicast lift still owns the temporary landing button.
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27F',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A27X',true)
endif
endfunction
function SuijiMode_RubickCanonicalStolenSkill takes integer skill returns integer
local integer logical=SuijiMode_ToOriginalSkill(skill)
local integer pair=-1
// Charge faces are aliases of one stolen skill, not additional slots.
set logical=Multiple_Skill_ButtonSource(null,logical)
set pair=SuijiMode_FindAghPair(logical)
if pair>=0 then
return YTI[pair]
endif
return logical
endfunction
function SuijiMode_RubickCanonicalRequestedSkill takes integer skill returns integer
set skill=SuijiMode_RubickCanonicalStolenSkill(skill)
if skill=='A065' then
return 'A4L1'
endif
return skill
endfunction
// B1094: Supernova refreshes small spells only, never items or the ultimate.
function B1094RefreshEggSmallSkill takes unit eggOwner1094,integer eggSkill1094,integer eggUlt1094 returns nothing
local integer eggLogical1094=SuijiMode_RubickCanonicalRequestedSkill(eggSkill1094)
local integer eggPhysical1094=0
local integer eggHandle1094=GetHandleId(eggOwner1094)
local integer eggEpochKey1094=0
local string eggPair1094=null
if eggSkill1094==0 or eggLogical1094==SuijiMode_RubickCanonicalRequestedSkill(eggUlt1094) or eggLogical1094=='A1RK' or SuijiMode_IsUltimateOnlySkill(eggLogical1094) or MHAbility_GetDefDataInt(eggLogical1094,ABILITY_DEF_DATA_REQ_LEVEL)>=6 then
return
endif
set eggPhysical1094=B287_GetPhysicalAbilityId(eggOwner1094,eggSkill1094)
if eggPhysical1094==0 or GetUnitAbilityLevel(eggOwner1094,eggPhysical1094)<=0 then
return
endif
set eggEpochKey1094=StringHash("B1094EggSkill"+I2S(eggPhysical1094))
call SaveInteger(L7,eggHandle1094,eggEpochKey1094,LoadInteger(L7,eggHandle1094,eggEpochKey1094)+1)
set eggPair1094=LoadStr(L7,eggHandle1094,StringHash("B1094EggPair"+I2S(eggPhysical1094)))
if eggPair1094!=null and eggPair1094!="" then
call B1092CancelCooldownTrigger(eggOwner1094,eggPair1094)
endif
call SuijiMode_RefreshTrackedSkillCooldown(eggOwner1094,eggSkill1094)
set eggPair1094=null
endfunction
function B1094RefreshEggSmallSkills takes unit eggOwner1094 returns nothing
local integer eggIndex1094=0
local integer eggUlt1094=0
local integer eggSlot1094=1
local integer eggHandle1094=0
if eggOwner1094==null or GetUnitTypeId(eggOwner1094)==0 then
return
endif
set eggHandle1094=GetHandleId(eggOwner1094)
set eggIndex1094=SuijiMode_GetStableHeroIndex(eggOwner1094)
set eggUlt1094=SuijiMode_GetAIOriginalUltimate(eggIndex1094)
// The stable registry includes native secondary and Scepter small-spell faces.
if eggIndex1094>=KL4 and eggIndex1094<=K54 then
loop
exitwhen eggSlot1094>10
call B1094RefreshEggSmallSkill(eggOwner1094,LoadInteger(MSK,eggIndex1094,eggSlot1094),eggUlt1094)
set eggSlot1094=eggSlot1094+1
endloop
endif
if SUIJI_MODE and LoadBoolean(L7,eggHandle1094,StringHash("SuijiDone")) then
call B1094RefreshEggSmallSkill(eggOwner1094,LoadInteger(L7,eggHandle1094,StringHash("SuijiSmallSkill")),eggUlt1094)
call B1094RefreshEggSmallSkill(eggOwner1094,LoadInteger(L7,eggHandle1094,StringHash("SuijiRubickStolenLogical1")),eggUlt1094)
call B1094RefreshEggSmallSkill(eggOwner1094,LoadInteger(L7,eggHandle1094,StringHash("SuijiRubickStolenLogical2")),eggUlt1094)
endif
endfunction
function B1094RefreshEggSmallSkillsEvent takes nothing returns nothing
call B1094RefreshEggSmallSkills(B1094_EGG_REFRESH_UNIT)
endfunction
function SuijiMode_RubickIsCurrentStolenSkill takes unit u,integer skill returns boolean
local integer h=0
local integer logical=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
set h=GetHandleId(u)
set logical=SuijiMode_RubickCanonicalStolenSkill(skill)
if logical==LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical1")) and LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel1"))>0 then
return true
endif
return logical==LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2")) and LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel2"))>0
endfunction
function SuijiMode_RubickRecordCurrentStolenSkill takes unit u,integer skill,integer level returns nothing
local integer h=0
local integer logical=0
local integer logical1=0
local integer logical2=0
local integer rubickButtonSlot=0
if u==null or GetUnitTypeId(u)==0 or skill==0 or level<=0 then
return
endif
set h=GetHandleId(u)
set logical=SuijiMode_RubickCanonicalStolenSkill(skill)
set logical1=LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical1"))
set logical2=LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2"))
// Only VXG (a completed steal) records ownership. Hero type is irrelevant.
// Keep the button bound to its logical skill even when record 2 compacts to 1.
if logical!=logical1 and logical!=logical2 then
if logical1!=0 and logical2!=0 then
set rubickButtonSlot=LoadInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical1)))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical1)))
elseif logical1!=0 then
set rubickButtonSlot=3-LoadInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical1)))
elseif logical2!=0 then
set rubickButtonSlot=3-LoadInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical2)))
else
set rubickButtonSlot=1
endif
call SaveInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical)),rubickButtonSlot)
endif
if logical==logical1 then
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill1"),skill)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel1"),level)
elseif logical==logical2 then
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill2"),skill)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel2"),level)
elseif logical1==0 then
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLogical1"),logical)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill1"),skill)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel1"),level)
elseif logical2==0 then
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLogical2"),logical)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill2"),skill)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel2"),level)
else
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLogical1"),logical2)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill1"),LoadInteger(L7,h,StringHash("SuijiRubickStolenSkill2")))
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel1"),LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel2")))
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLogical2"),logical)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill2"),skill)
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel2"),level)
endif
endfunction
function SuijiMode_RubickClearCurrentStolenSkill takes unit u,integer skill returns nothing
local integer h=0
local integer logical=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return
endif
set h=GetHandleId(u)
set logical=SuijiMode_RubickCanonicalStolenSkill(skill)
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenButton:"+I2S(logical)))
if logical==LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical1")) then
if LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel2"))>0 then
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLogical1"),LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2")))
call SaveInteger(L7,h,StringHash("SuijiRubickStolenSkill1"),LoadInteger(L7,h,StringHash("SuijiRubickStolenSkill2")))
call SaveInteger(L7,h,StringHash("SuijiRubickStolenLevel1"),LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel2")))
else
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLogical1"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenSkill1"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLevel1"))
endif
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLogical2"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenSkill2"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLevel2"))
elseif logical==LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2")) then
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLogical2"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenSkill2"))
call RemoveSavedInteger(L7,h,StringHash("SuijiRubickStolenLevel2"))
endif
if SuijiMode_IsEarthSpiritCompanionOwner(u)==false then
call SuijiMode_ClearEarthSpiritCompanions(u)
endif
endfunction
function SuijiMode_RubickHasIndependentSkill takes unit rubickOwnerUnit,integer rubickOwnerSkill returns boolean
local integer rubickOwnerHandle=0
local integer rubickOwnerLogical=SuijiMode_RubickCanonicalStolenSkill(rubickOwnerSkill)
local integer rubickOwnerPair=SuijiMode_FindAghPair(rubickOwnerLogical)
local integer rubickNativeSource=0
local integer rubickNativeSlot=1
if rubickOwnerUnit==null or GetUnitTypeId(rubickOwnerUnit)==0 or rubickOwnerSkill==0 then
return false
endif
// Never relocate, relevel, hide or remove a native/OMG-owned skill just
// because another copy of that logical skill was temporarily stolen.
if SuijiMode_IsNativeRegisteredSkill(rubickOwnerUnit,SuijiMode_ToOriginalSkill(rubickOwnerSkill)) or SuijiMode_IsNativeRegisteredSkill(rubickOwnerUnit,rubickOwnerLogical) then
return true
endif
if rubickOwnerPair>=0 and SuijiMode_IsNativeRegisteredSkill(rubickOwnerUnit,YRI[rubickOwnerPair]) then
return true
endif
if Get_Multiple_Skill_Pointer(rubickOwnerUnit,rubickOwnerLogical)>0 then
// A native charge learn book (for example Firestorm A4BP) can differ from
// both the cast face and ButtonSource. Compare the registered family too.
set rubickNativeSource=SuijiMode_GetStableHeroIndex(rubickOwnerUnit)
if rubickNativeSource>0 then
loop
exitwhen rubickNativeSlot>10
if rubickOwnerLogical==SuijiMode_RubickCanonicalStolenSkill(LoadInteger(MSK,rubickNativeSource,rubickNativeSlot)) then
return true
endif
set rubickNativeSlot=rubickNativeSlot+1
endloop
endif
endif
set rubickOwnerHandle=GetHandleId(rubickOwnerUnit)
return rubickOwnerLogical==SuijiMode_RubickCanonicalStolenSkill(OM7(rubickOwnerHandle,"SuijiSmallSkill")) or rubickOwnerLogical==SuijiMode_RubickCanonicalStolenSkill(OM7(rubickOwnerHandle,"SuijiUltSkill"))
endfunction
function SuijiMode_RubickApplyStolenButton takes unit rubickButtonUnit,integer rubickButtonSkill,integer rubickButtonPhysical returns nothing
local integer rubickButtonSlot=0
if SuijiMode_RubickIsCurrentStolenSkill(rubickButtonUnit,rubickButtonSkill)==false or SuijiMode_RubickHasIndependentSkill(rubickButtonUnit,rubickButtonSkill) then
return
endif
set rubickButtonSlot=LoadInteger(L7,GetHandleId(rubickButtonUnit),StringHash("SuijiRubickStolenButton:"+I2S(SuijiMode_RubickCanonicalStolenSkill(rubickButtonSkill))))
if rubickButtonSlot<1 or rubickButtonSlot>2 then
return
endif
// CommandFunc hides Move/Hold/Patrol. Keep (3,1) for skillmenu, (2,1)
// for simultaneous companions, and all four native bottom-row slots intact.
call SuijiMode_SetOwnedAbilityButtonSlot(rubickButtonUnit,rubickButtonPhysical,rubickButtonSlot-1,1)
if Get_Multiple_Skill_Pointer(rubickButtonUnit,rubickButtonSkill)>0 then
// Reuse the existing charge-face cache; do not add a periodic card scan.
call Multiple_Skill_CaptureButton(rubickButtonUnit,rubickButtonSkill,rubickButtonPhysical)
endif
endfunction
function SuijiMode_IsAllowedOwnedPoolSkill takes unit suijiOwnedUnit,integer suijiOwnedSkill returns boolean
local integer suijiOwnedHandle=0
local integer suijiOwnedLogicalSkill=0
if suijiOwnedUnit==null or GetUnitTypeId(suijiOwnedUnit)==0 or suijiOwnedSkill==0 then
return false
endif
set suijiOwnedHandle=GetHandleId(suijiOwnedUnit)
set suijiOwnedLogicalSkill=SuijiMode_ToOriginalSkill(suijiOwnedSkill)
// Rubick owns two independent stolen-skill slots.  Their live base/upgrade or
// fixed-clone rawcodes remain valid until the matching Rubick trigger replaces
// or expires that slot.
if SuijiMode_RubickIsCurrentStolenSkill(suijiOwnedUnit,suijiOwnedLogicalSkill) then
return true
endif
if suijiOwnedLogicalSkill==OM7(suijiOwnedHandle,"SuijiSmallSkill") then
return suijiOwnedSkill==OM7(suijiOwnedHandle,"SuijiSmallAbility")
endif
if suijiOwnedLogicalSkill==OM7(suijiOwnedHandle,"SuijiUltSkill") then
return suijiOwnedSkill==OM7(suijiOwnedHandle,"SuijiUltAbility")
endif
if SuijiMode_IsNativeRegisteredSkill(suijiOwnedUnit,suijiOwnedLogicalSkill) then
return true
endif
if SuijiMode_IsRegisteredSourceSkill(OM7(suijiOwnedHandle,"SuijiSmallSource"),suijiOwnedLogicalSkill) then
return true
endif
return SuijiMode_IsRegisteredSourceSkill(OM7(suijiOwnedHandle,"SuijiUltSource"),suijiOwnedLogicalSkill)
endfunction
function SuijiMode_RemoveUnexpectedPoolSkill takes unit suijiOwnedUnit,integer suijiOwnedSkill returns integer
local item suijiOwnedSourceItem=null
// Native Centaur Hoof Stomp is never cleanup-owned by OMG. Its random copy is
// Y00E and is intentionally not exempted from stale-clone cleanup.
if suijiOwnedSkill=='A00S' then
return 0
endif
if suijiOwnedSkill==0 or GetUnitAbilityLevel(suijiOwnedUnit,suijiOwnedSkill)<=0 or SuijiMode_IsAllowedOwnedPoolSkill(suijiOwnedUnit,suijiOwnedSkill) then
return 0
endif
set suijiOwnedSourceItem=B945SourceItem(suijiOwnedUnit,suijiOwnedSkill)
if suijiOwnedSourceItem!=null then
set suijiOwnedSourceItem=null
return 0
endif
call UnitRemoveAbility(suijiOwnedUnit,suijiOwnedSkill)
set suijiOwnedSourceItem=null
return 1
endfunction
function SuijiMode_CleanupUnexpectedPoolSkills takes unit suijiOwnedUnit returns nothing
local integer suijiOwnedIndex=KL4
local integer suijiOwnedRemoved=0
if SUIJI_MODE==false or suijiOwnedUnit==null or GetUnitTypeId(suijiOwnedUnit)==0 or IsUnitType(suijiOwnedUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiOwnedUnit) then
return
endif
if OO7(GetHandleId(suijiOwnedUnit),"SuijiDone")==false then
return
endif
loop
exitwhen suijiOwnedIndex>K54
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HM4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HM4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HN4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HN4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HO4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HO4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HP4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HP4[suijiOwnedIndex]))
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,HQ4[suijiOwnedIndex])
set suijiOwnedRemoved=suijiOwnedRemoved+SuijiMode_RemoveUnexpectedPoolSkill(suijiOwnedUnit,SuijiMode_ToFixedClone(HQ4[suijiOwnedIndex]))
set suijiOwnedIndex=suijiOwnedIndex+1
endloop
if suijiOwnedRemoved>0 and SUIJI_LOG then
call DisplayTimedTextToPlayer(GetOwningPlayer(suijiOwnedUnit),0,0,8.,"|cFFFFCC00随机OMG日志：|r已清理 "+I2S(suijiOwnedRemoved)+" 个未登记的残留技能。")
endif
endfunction
function SuijiMode_GrantLevelAttributeBonus takes unit suijiAttrUnit returns nothing
local integer suijiAttrHandle=0
local integer suijiAttrLevel=0
local integer suijiAttrLastLevel=0
local integer suijiAttrBonus=0
if SUIJI_MODE==false or suijiAttrUnit==null then
return
endif
if IsUnitType(suijiAttrUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiAttrUnit) or GetUnitTypeId(suijiAttrUnit)=='H00J' then
return
endif
set suijiAttrHandle=GetHandleId(suijiAttrUnit)
if OO7(suijiAttrHandle,"SuijiDone")==false then
return
endif
set suijiAttrLevel=GetHeroLevel(suijiAttrUnit)
set suijiAttrLastLevel=LoadInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"))
if suijiAttrLastLevel<=0 then
set suijiAttrLastLevel=suijiAttrLevel-1
if suijiAttrLastLevel<1 then
set suijiAttrLastLevel=1
endif
endif
if suijiAttrLevel<=suijiAttrLastLevel then
return
endif
set suijiAttrBonus=(suijiAttrLevel-suijiAttrLastLevel)*2
call SetHeroStr(suijiAttrUnit,GetHeroStr(suijiAttrUnit,false)+suijiAttrBonus,true)
call SetHeroAgi(suijiAttrUnit,GetHeroAgi(suijiAttrUnit,false)+suijiAttrBonus,true)
call SetHeroInt(suijiAttrUnit,GetHeroInt(suijiAttrUnit,false)+suijiAttrBonus,true)
call SaveInteger(L7,suijiAttrHandle,StringHash("SuijiLevelAttrBonusLevel"),suijiAttrLevel)
endfunction
// B1116: native ability ownership alone does not make lifecycle writes safe.
// Defer generic event reconciliation to the owning lifecycle's completion.
// No live MemHack ability enumeration is used here.
function B1116HeroLifecycleReady takes unit lifecycleHero1116 returns boolean
local integer lifecycleHandle1116=0
if lifecycleHero1116==null or GetUnitTypeId(lifecycleHero1116)==0 or not UnitAlive(lifecycleHero1116) or IsUnitHidden(lifecycleHero1116) then
return false
endif
set lifecycleHandle1116=GetHandleId(lifecycleHero1116)
if LoadBoolean(L7,lifecycleHandle1116,StringHash("SuijiRevivalPending")) or LoadBoolean(L7,lifecycleHandle1116,StringHash("B834ReincarnationPending")) or LoadBoolean(L7,lifecycleHandle1116,StringHash("B1018AegisPending")) or LoadInteger(L7,lifecycleHandle1116,StringHash("stateHideUnit"))==1 then
return false
endif
return not LoadBoolean(L7,lifecycleHandle1116,StringHash("SuijiTransformRestoring"))
endfunction
function SuijiMode_UpdateLevels takes unit u returns nothing
local integer h=0
local integer small=0
local integer ult=0
local integer level=0
local integer selected=0
local player p=null
local boolean human=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"B849TempestOwned") then
return
endif
set small=OM7(h,"SuijiSmallSkill")
set ult=OM7(h,"SuijiUltSkill")
if SUIJI_MODE==false or OO7(h,"SuijiDone")==false then
return
endif
if not B1116HeroLifecycleReady(u) then
call SaveBoolean(L7,h,StringHash("B1116EventDeferred"),true)
return
endif
call SuijiMode_CleanupUnexpectedPoolSkills(u)
call SuijiMode_EnsureManaRegenBonus(u)
set p=GetOwningPlayer(u)
set human=GetPlayerController(p)==MAP_CONTROL_USER
call SuijiMode_RestoreBaseHeroSkills(u)
if small==0 and human then
call SuijiTavernB295_Start(u)
elseif small!=0 then
set level=SuijiMode_SmallLevel(u)
call SuijiMode_RestoreSkill(u,"SuijiSmall",level)
if SuijiMode_GetLogicalAbilityLevel(u,small)<level then
call SuijiMode_SetLogicalAbilityLevel(u,small,level)
endif
endif
set level=SuijiMode_UltLevel(u)
if level>0 then
call SuijiMode_EnsureAIOriginalUltimate(u,level)
if ult==0 then
if human then
set ult=SuijiTavern_ApplyPendingUlt(u)
if ult==0 then
call SuijiTavernB295_Start(u)
endif
else
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
set ult=SuijiTest_AddPresetSkill(u,SuijiMode_ForcedUlt(GetPlayerId(p)),level,"SuijiUlt")
else
set ult=SuijiMode_AddRandomUltimate(u,level)
endif
if ult!=0 then
call SuijiMode_NotifyPickedSkill(u,ult,"额外大招","获得了")
endif
endif
else
call SuijiMode_RestoreSkill(u,"SuijiUlt",level)
if SuijiMode_GetLogicalAbilityLevel(u,ult)<level then
call SuijiMode_SetLogicalAbilityLevel(u,ult,level)
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFF00FF00随机OMG：额外大招 "+GetAbilityName(ult)+" 升到 "+I2S(level)+" 级|r")
endif
endif
endif
call SuijiMode_AutoLearnYellowBonus(u)
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_SyncRandomAttackRange(u)
call SuijiMode_ForcePassiveOrbs(u)
set p=null
endfunction
function SuijiMode_EventRandomSlotsSynchronized takes unit suijiEventUnit returns boolean
local integer suijiEventHandle=0
local integer suijiEventPlayerId=0
local integer suijiEventSkill=0
local integer suijiEventPhysical=0
local integer suijiEventExpected=0
if suijiEventUnit==null or GetUnitTypeId(suijiEventUnit)==0 or OO7(GetHandleId(suijiEventUnit),"SuijiDone")==false then
return false
endif
set suijiEventHandle=GetHandleId(suijiEventUnit)
set suijiEventSkill=OM7(suijiEventHandle,"SuijiSmallSkill")
if suijiEventSkill!=0 then
set suijiEventPhysical=OM7(suijiEventHandle,"SuijiSmallAbility")
if suijiEventPhysical==0 then
set suijiEventPhysical=SuijiMode_GetGrantSkill(suijiEventSkill)
endif
if GetUnitAbilityLevel(suijiEventUnit,suijiEventPhysical)!=SuijiMode_SmallLevel(suijiEventUnit) then
return false
endif
endif
set suijiEventExpected=SuijiMode_UltLevel(suijiEventUnit)
if suijiEventExpected<=0 then
return true
endif
set suijiEventSkill=OM7(suijiEventHandle,"SuijiUltSkill")
if suijiEventSkill==0 then
set suijiEventPlayerId=GetPlayerId(GetOwningPlayer(suijiEventUnit))
// Human players may still be choosing their tavern ultimate.  Only a pending
// choice or a computer-owned hero is expected to have an ultimate immediately.
return GetPlayerController(Player(suijiEventPlayerId))==MAP_CONTROL_USER and OM7(suijiEventHandle,"SuijiTavernUltPendingSkill")==0
endif
set suijiEventPhysical=OM7(suijiEventHandle,"SuijiUltAbility")
if suijiEventPhysical==0 then
set suijiEventPhysical=SuijiMode_GetGrantSkill(suijiEventSkill)
endif
return GetUnitAbilityLevel(suijiEventUnit,suijiEventPhysical)==suijiEventExpected
endfunction
function SuijiMode_EventReconcileTimer takes nothing returns nothing
local timer suijiEventTimer=GetExpiredTimer()
local integer suijiEventTimerHandle=GetHandleId(suijiEventTimer)
local unit suijiEventUnit=LoadUnitHandle(L7,suijiEventTimerHandle,0)
local integer suijiEventUnitHandle=0
local integer suijiEventRetry=LoadInteger(L7,suijiEventTimerHandle,1)
if suijiEventUnit!=null then
set suijiEventUnitHandle=GetHandleId(suijiEventUnit)
if LoadTimerHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))==suijiEventTimer then
if GetUnitTypeId(suijiEventUnit)!=0 then
if not B1116HeroLifecycleReady(suijiEventUnit) then
// Park the obligation, not a repeating timer or a retained unit reference.
// The lifecycle owner wakes it when revival, unhide or transformation ends.
call SaveBoolean(L7,suijiEventUnitHandle,StringHash("B1116EventDeferred"),true)
// Only an explicit completion wake grants this bounded engine-settle budget.
// Ordinary dead/hidden requests park immediately instead of polling.
if LoadInteger(L7,suijiEventTimerHandle,2)>0 then
call SaveInteger(L7,suijiEventTimerHandle,2,LoadInteger(L7,suijiEventTimerHandle,2)-1)
call TimerStart(suijiEventTimer,.25,false,function SuijiMode_EventReconcileTimer)
set suijiEventUnit=null
set suijiEventTimer=null
return
endif
call RemoveSavedHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))
call FlushChildHashtable(L7,suijiEventTimerHandle)
call PauseTimer(suijiEventTimer)
call DestroyTimer(suijiEventTimer)
set suijiEventUnit=null
set suijiEventTimer=null
return
endif
if OO7(suijiEventUnitHandle,"SuijiDone")==false then
set SUIJI_EVENT_UNIT=suijiEventUnit
call ExecuteFunc("SuijiMode_ApplyEventCurrent")
endif
if OO7(suijiEventUnitHandle,"SuijiDone") then
if suijiEventRetry>0 and SuijiMode_EventRandomSlotsSynchronized(suijiEventUnit) then
call RemoveSavedBoolean(L7,suijiEventUnitHandle,StringHash("B1116EventDeferred"))
call RemoveSavedHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))
call FlushChildHashtable(L7,suijiEventTimerHandle)
call PauseTimer(suijiEventTimer)
call DestroyTimer(suijiEventTimer)
set suijiEventUnit=null
set suijiEventTimer=null
return
elseif suijiEventRetry<3 then
// Arm the bounded verification before touching a live Ability object.  Some
// Warcraft/MemHack writes terminate the current JASS thread; pre-arming keeps
// the next explicit retry alive without restoring B659's every-spell scan.
call SaveInteger(L7,suijiEventTimerHandle,1,suijiEventRetry+1)
call TimerStart(suijiEventTimer,.25*(suijiEventRetry+1),false,function SuijiMode_EventReconcileTimer)
call SuijiMode_UpdateLevels(suijiEventUnit)
set suijiEventUnit=null
set suijiEventTimer=null
return
else
// Never leave a failed live write holding the unit-wide coalescing lock.
// Release and destroy this final verifier before the last best-effort pass.
call RemoveSavedHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))
call FlushChildHashtable(L7,suijiEventTimerHandle)
call PauseTimer(suijiEventTimer)
call DestroyTimer(suijiEventTimer)
call SuijiMode_UpdateLevels(suijiEventUnit)
if SuijiMode_EventRandomSlotsSynchronized(suijiEventUnit) then
call RemoveSavedBoolean(L7,suijiEventUnitHandle,StringHash("B1116EventDeferred"))
endif
set suijiEventUnit=null
set suijiEventTimer=null
return
endif
elseif suijiEventRetry<3 then
call SaveInteger(L7,suijiEventTimerHandle,1,suijiEventRetry+1)
call TimerStart(suijiEventTimer,.50,false,function SuijiMode_EventReconcileTimer)
set suijiEventUnit=null
set suijiEventTimer=null
return
endif
endif
call RemoveSavedHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))
endif
endif
call FlushChildHashtable(L7,suijiEventTimerHandle)
call PauseTimer(suijiEventTimer)
call DestroyTimer(suijiEventTimer)
set suijiEventUnit=null
set suijiEventTimer=null
endfunction
function SuijiMode_QueueEventReconcile takes unit suijiEventUnit,real suijiEventDelay returns nothing
local integer suijiEventUnitHandle=0
local integer suijiEventPlayerId=0
local timer suijiEventTimer=null
if SUIJI_MODE==false or suijiEventUnit==null or GetUnitTypeId(suijiEventUnit)==0 or IsUnitType(suijiEventUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiEventUnit) or GetUnitTypeId(suijiEventUnit)=='H00J' then
return
endif
set suijiEventUnitHandle=GetHandleId(suijiEventUnit)
set suijiEventPlayerId=GetPlayerId(GetOwningPlayer(suijiEventUnit))
if suijiEventPlayerId<0 or suijiEventPlayerId>$B or M7[suijiEventPlayerId]!=suijiEventUnit then
return
endif
call SaveBoolean(L7,suijiEventUnitHandle,StringHash("B1116EventDeferred"),true)
set suijiEventTimer=LoadTimerHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"))
// Coalesce level, learned-skill, enter, revive and addhero events. The pending
// pass observes the latest state, so scheduling an identical write is useless.
if suijiEventTimer!=null then
set suijiEventTimer=null
return
endif
set suijiEventTimer=CreateTimer()
call SaveTimerHandle(L7,suijiEventUnitHandle,StringHash("SuijiEventReconcileTimer"),suijiEventTimer)
call SaveUnitHandle(L7,GetHandleId(suijiEventTimer),0,suijiEventUnit)
call TimerStart(suijiEventTimer,suijiEventDelay,false,function SuijiMode_EventReconcileTimer)
set suijiEventTimer=null
endfunction
// Called by earlier lifecycle owners through ExecuteFunc. Clear the bridge
// before scheduling so a nested event cannot retain or replace its unit.
function B1116ResumeEventReconcile takes nothing returns nothing
local unit resumeHero1116=B1116ReconcileWakeUnit
local timer resumeTimer1116=null
set B1116ReconcileWakeUnit=null
if resumeHero1116!=null and GetUnitTypeId(resumeHero1116)!=0 and LoadBoolean(L7,GetHandleId(resumeHero1116),StringHash("B1116EventDeferred")) then
call SuijiMode_QueueEventReconcile(resumeHero1116,.10)
set resumeTimer1116=LoadTimerHandle(L7,GetHandleId(resumeHero1116),StringHash("SuijiEventReconcileTimer"))
if resumeTimer1116!=null then
// The engine may finish native split/ReviveHero after the completion callback.
// Three additional 0.25-second probes are bounded and perform no unsafe writes.
call SaveInteger(L7,GetHandleId(resumeTimer1116),2,3)
endif
endif
set resumeTimer1116=null
set resumeHero1116=null
endfunction
function SuijiMode_OnHeroLevelCurrent takes nothing returns nothing
call SuijiMode_GrantLevelAttributeBonus(SUIJI_LEVEL_UNIT)
call SuijiMode_MarkUnitVisibilityDirty(SUIJI_LEVEL_UNIT)
call SuijiMode_QueueEventReconcile(SUIJI_LEVEL_UNIT,.10)
set SUIJI_LEVEL_UNIT=null
endfunction
function SuijiMode_TryOpenAIRepickWindow takes nothing returns nothing
local integer i=0
local unit hero=null
local boolean hasAI=false
local boolean hasSuperAI=false
if SUIJI_MODE==false or SUIJI_AI_RE_WINDOW_STARTED then
return
endif
loop
exitwhen i>$B
if IsPlayerInForce(Player(i),QX4) and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER then
set hasAI=true
if SuijiSuperAI_HasPreset(i) then
set hasSuperAI=true
endif
set hero=M7[i]
if hero==null or GetUnitTypeId(hero)==0 or OO7(GetHandleId(hero),"SuijiDone")==false then
set hero=null
return
endif
endif
set i=i+1
endloop
if hasAI then
set SUIJI_AI_RE_WINDOW_STARTED=true
set AI_RE_TIME=Bz+60.
if QT4!=null then
if hasSuperAI then
call DisplayTimedTextToPlayer(QT4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让普通AI重选，每楼层每局限一次；超级AI楼层禁止重选。")
else
call DisplayTimedTextToPlayer(QT4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让AI重选，每楼层每局限一次，例如 |c00dd8dff-re2|r")
endif
endif
if QU4!=null then
if hasSuperAI then
call DisplayTimedTextToPlayer(QU4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让普通AI重选，每楼层每局限一次；超级AI楼层禁止重选。")
else
call DisplayTimedTextToPlayer(QU4,0,0,12.,"AI英雄已选择完毕，60秒内可输入|c00dd8dff-re楼层|r让AI重选，每楼层每局限一次，例如 |c00dd8dff-re7|r")
endif
endif
endif
set hero=null
endfunction
function SuijiMode_ApplyUnit takes unit u returns nothing
local integer h=0
local integer small=0
local integer ult=0
local integer ultLevel=0
local player p=null
if SUIJI_MODE==false then
call SuijiTest_DebugUnit(u,"AP0","进入ApplyUnit但SUIJI未开启，返回")
return
endif
if u==null then
call SuijiTest_DebugUnit(u,"AP1","进入ApplyUnit但unit为空，返回")
return
endif
call SuijiTest_DebugUnit(u,"AP2","进入ApplyUnit")
if IsUnitType(u,UNIT_TYPE_HERO)==false or IsUnitIllusion(u) or GetUnitTypeId(u)=='H00J' then
call SuijiTest_DebugUnit(u,"AP3","不是有效真实英雄，返回 type="+I2S(GetUnitTypeId(u)))
return
endif
// Hold ordinary AI grants until the host's second dialog resolves.
if B979Mode==0 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and not SuijiMode_HasForcedPreset(GetPlayerId(GetOwningPlayer(u))) then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiDone") then
call SuijiTest_DebugUnit(u,"AP4","SuijiDone已为true，跳过")
return
endif
if GetUnitPointValue(u)>=KL4 and GetUnitPointValue(u)<=K54 then
call SaveInteger(L7,h,StringHash("SuijiStableHeroIndex"),GetUnitPointValue(u))
endif
call SuijiMode_InitLevelAttributeBonus(u)
call SuijiTest_DebugUnit(u,"AP5","通过基础检查，准备分配随机技能")
call SuijiMode_PrepareRubickTelekinesisButton(u)
call SuijiMode_RestoreBaseHeroSkills(u)
call SuijiMode_ApplyAllInstantOrderCarrierCastpoints(u)
call SuijiMode_EnsureManaRegenBonus(u)
call SuijiTest_DebugUnit(u,"AP5B","初次基础技能恢复完成")
set p=GetOwningPlayer(u)
if GetPlayerController(p)==MAP_CONTROL_USER and SuijiMode_HasForcedPreset(GetPlayerId(p))==false then
call NS7(h,"SuijiDone",true)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
call SuijiTavernB295_Start(u)
set p=null
return
endif
call NS7(h,"SuijiDone",true)
call SuijiMode_FixInvokerNativeSkillVisibility(u)
if SuijiMode_HasForcedPreset(GetPlayerId(p)) then
set small=SuijiTest_AddPresetSkill(u,SuijiMode_ForcedSmall(GetPlayerId(p)),SuijiMode_SmallLevel(u),"SuijiSmall")
set ultLevel=SuijiMode_UltLevel(u)
if ultLevel>0 then
set ult=SuijiTest_AddPresetSkill(u,SuijiMode_ForcedUlt(GetPlayerId(p)),ultLevel,"SuijiUlt")
endif
else
set small=SuijiMode_AddRandomSmall(u)
endif
call SuijiTest_DebugUnit(u,"AP6","AddRandomSmall返回="+I2S(small))
if small==0 then
call NS7(h,"SuijiDone",false)
if SUIJI_LOG then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFFFFCC00随机OMG日志：|rAI "+Q[GetPlayerId(p)]+KZ4[GetPlayerId(p)]+"|r 的 "+GetUnitName(u)+" 本次没有抽到可用小技能，稍后自动重试。")
endif
set p=null
return
endif
if SuijiMode_HasForcedPreset(GetPlayerId(p))==false then
set ultLevel=SuijiMode_UltLevel(u)
if ultLevel>0 then
call SuijiTest_DebugUnit(u,"AP7","大招等级="+I2S(ultLevel)+"，开始抽大招")
set ult=SuijiMode_AddRandomUltimate(u,ultLevel)
else
call SuijiTest_DebugUnit(u,"AP7","当前等级未到额外大招条件")
endif
endif
if small!=0 then
call SuijiMode_NotifyPickedSkill(u,small,"额外小技能","获得了")
endif
if ult!=0 then
call SuijiMode_NotifyPickedSkill(u,ult,"额外大招","获得了")
endif
if small!=0 and ult!=0 then
call SuijiSuperAI_Announce(u)
endif
if small==0 and ult==0 then
call DisplayTimedTextToPlayer(p,0,0,15.,"|cFFFFCC00随机OMG：没有找到可用的额外技能|r")
endif
call SuijiMode_TryOpenAIRepickWindow()
set p=null
endfunction
function SuijiMode_ApplyEventCurrent takes nothing returns nothing
call SuijiMode_ApplyUnit(SUIJI_EVENT_UNIT)
set SUIJI_EVENT_UNIT=null
endfunction
function B515_InitializeNativeA00SVisibility takes unit u returns nothing
local integer h=0
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)!='H000' then
return
endif
set h=GetHandleId(u)
if LoadBoolean(L7,h,StringHash("B515NativeA00SVisibleInitialized")) then
return
endif
// B514 excluded native A00S from generic maintenance, so establish its stable
// command-card state once at the explicit hero-entry boundary.
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A00S',true)
call SaveBoolean(L7,h,StringHash("B515NativeA00SVisibleInitialized"),true)
endfunction
function SuijiMode_InitializeEntryUnit takes unit suijiEntryUnit,boolean suijiEntryRefresh returns nothing
local integer suijiEntryPlayerId=0
if SUIJI_MODE==false or suijiEntryUnit==null or GetUnitTypeId(suijiEntryUnit)==0 or IsUnitType(suijiEntryUnit,UNIT_TYPE_HERO)==false or IsUnitIllusion(suijiEntryUnit) or GetUnitTypeId(suijiEntryUnit)=='H00J' then
return
endif
set suijiEntryPlayerId=GetPlayerId(GetOwningPlayer(suijiEntryUnit))
if suijiEntryPlayerId<0 or suijiEntryPlayerId>$B then
return
endif
if M7[suijiEntryPlayerId]!=null and GetUnitTypeId(M7[suijiEntryPlayerId])==0 then
set M7[suijiEntryPlayerId]=null
endif
if M7[suijiEntryPlayerId]==null and GetUnitPointValue(suijiEntryUnit)>=KL4 and GetUnitPointValue(suijiEntryUnit)<=K54 then
set M7[suijiEntryPlayerId]=suijiEntryUnit
endif
if M7[suijiEntryPlayerId]!=suijiEntryUnit then
return
endif
call KK2026SummerEgg_EnsureUnitBonus(suijiEntryUnit)
if GetUnitTypeId(suijiEntryUnit)=='HMD0' then
set MiaoEntryUnit=suijiEntryUnit
call Miao_RegisterCurrent()
endif
call B515_InitializeNativeA00SVisibility(suijiEntryUnit)
call SuijiMode_ApplyUnit(suijiEntryUnit)
if suijiEntryRefresh and OO7(GetHandleId(suijiEntryUnit),"SuijiDone") then
call SuijiMode_MarkUnitVisibilityDirty(suijiEntryUnit)
call NS7(GetHandleId(suijiEntryUnit),"SuijiAghForceUpdate",true)
endif
call SuijiMode_QueueEventReconcile(suijiEntryUnit,.10)
endfunction
function SuijiMode_OnHeroReviveCurrent takes nothing returns nothing
call B1039Notify(SUIJI_EVENT_UNIT)
call SuijiMode_InitializeEntryUnit(SUIJI_EVENT_UNIT,true)
set SUIJI_EVENT_UNIT=null
endfunction
function SuijiMode_OnHeroAddCurrent takes nothing returns nothing
call SuijiMode_InitializeEntryUnit(SUIJI_EVENT_UNIT,false)
set SUIJI_EVENT_UNIT=null
endfunction
function SuijiMode_OnHeroSkillEvent takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if B287_GetLearnedSkill()=='A6L0' or B287_GetLearnedSkill()=='A6L1' or B287_GetLearnedSkill()=='A6L2' or B287_GetLearnedSkill()=='A6L3' then
call Luna_Activate()
endif
call SuijiMode_SyncStateReplaceBaseSlot(b1060GetTriggerUnit,B287_GetLearnedSkill())
call SuijiMode_MarkUnitVisibilityDirty(b1060GetTriggerUnit)
call SuijiMode_QueueEventReconcile(b1060GetTriggerUnit,.05)
set b1060GetTriggerUnit=null
endfunction
function SuijiMode_EventInit takes nothing returns nothing
local trigger suijiEventTrigger=CreateTrigger()
call YB7(suijiEventTrigger,EVENT_PLAYER_HERO_SKILL)
call TriggerAddAction(suijiEventTrigger,function SuijiMode_OnHeroSkillEvent)
set suijiEventTrigger=null
endfunction
function SuijiMode_ApplyCurrent takes nothing returns nothing
call SuijiTest_DebugUnit(IN4,"CUR0","ExecuteFunc进入ApplyCurrent")
call SuijiMode_InitializeEntryUnit(IN4,false)
endfunction
function SuijiMode_ApplyExisting takes nothing returns nothing
local integer i=0
local unit u=null
loop
exitwhen i>$B
set u=M7[i]
if u!=null then
call SuijiMode_InitializeEntryUnit(u,false)
endif
set i=i+1
endloop
set u=null
endfunction
// Wheel replacement runs after an actual revive, outside death/revive callbacks.
// Keep the old hero and physical item handles until the new pair is verified.
function B1009CarryBlessings takes unit blessingHero1009 returns nothing
local integer blessingPid1009=GetPlayerId(GetOwningPlayer(blessingHero1009))
// Install permanent entitlement carriers before random/Scepter reconciliation.
if CHIA[blessingPid1009]==1 and GetUnitAbilityLevel(blessingHero1009,'A330')==0 then
call XF7(blessingHero1009,'A330')
endif
if CHILLX[blessingPid1009]==1 then
if GetUnitAbilityLevel(blessingHero1009,'A334')==0 then
call XF7(blessingHero1009,'A334')
endif
if GetUnitAbilityLevel(blessingHero1009,'A2VW')==0 then
call XF7(blessingHero1009,'A2VW')
endif
endif
endfunction
function B1009BlessingsReady takes unit blessingHero1009 returns boolean
local integer blessingPid1009=GetPlayerId(GetOwningPlayer(blessingHero1009))
return (CHIA[blessingPid1009]!=1 or GetUnitAbilityLevel(blessingHero1009,'A330')>0) and (CHILLX[blessingPid1009]!=1 or (GetUnitAbilityLevel(blessingHero1009,'A334')>0 and GetUnitAbilityLevel(blessingHero1009,'A2VW')>0))
endfunction
// Restore physical items before deleting a failed candidate. Never recreate
// a missing handle: doing so could duplicate a converted or already moved item.
function SuijiMode_IsScanHero takes unit u returns boolean
if u==null then
return false
endif
if GetUnitTypeId(u)==0 then
return false
endif
if KKDefense_IsWaveType(GetUnitTypeId(u)) then
return false
endif
return IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false and GetUnitTypeId(u)!='H00J'
endfunction
function SuijiMode_ApplyMissingHeroes takes nothing returns nothing
local integer i=0
local integer pid=0
local player p=null
local group g=null
local unit u=null
local boolean seenMain=false
if SUIJI_MODE==false then
return
endif
set g=WS7()
loop
exitwhen i>$B
set p=Player(i)
if TA7(p) then
set pid=GetPlayerId(p)
set seenMain=false
if M7[pid]!=null and GetUnitTypeId(M7[pid])==0 then
set M7[pid]=null
endif
call GroupEnumUnitsOfPlayer(g,p,Condition(function TO7))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if SuijiMode_IsScanHero(u) then
if M7[pid]==null and GetUnitPointValue(u)>=KL4 and GetUnitPointValue(u)<=K54 then
set M7[pid]=u
call SuijiTest_DebugUnit(u,"SCAN1","扫描发现M7为空，补登记主英雄")
if SUIJI_LOG and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
call VV7(bj_FORCE_ALL_PLAYERS,8.,"|cFF00FF00随机OMG日志：|r已补登记AI "+Q[pid]+KZ4[pid]+"|r 的 "+GetUnitName(u))
endif
endif
if u==M7[pid] then
set seenMain=true
if OO7(GetHandleId(u),"SuijiDone")==false then
call SuijiTest_DebugUnit(u,"SCAN2","扫描发现主英雄未随机，调用ApplyUnit")
call SuijiMode_InitializeEntryUnit(u,false)
endif
endif
endif
endloop
if seenMain==false and M7[pid]!=null and SuijiMode_IsScanHero(M7[pid]) and OO7(GetHandleId(M7[pid]),"SuijiDone")==false then
call SuijiTest_DebugUnit(M7[pid],"SCAN3","M7主英雄不在枚举组但未随机，直接调用ApplyUnit")
call SuijiMode_InitializeEntryUnit(M7[pid],false)
endif
endif
set i=i+1
endloop
call WR7(g)
set p=null
set u=null
set g=null
endfunction
function SuijiMode_RestoreExisting takes nothing returns nothing
// B514: all mutable reconciliation is event-driven. If an obsolete caller
// starts the legacy timer, stop it without touching abilities or command cards.
call PauseTimer(SUIJI_RESTORE_TIMER)
endfunction
function SuijiMode_TransformBaseSkill takes integer heroIndex,integer slot returns integer
if heroIndex==117 then
if slot==1 then
return 'AMdQ'
elseif slot==2 then
return 'AMdW'
elseif slot==3 then
return 'AMdE'
elseif slot==4 then
return 'AMdR'
elseif slot==5 then
return 'AMdD'
endif
return 0
endif
if heroIndex<KL4 or heroIndex>K54 then
return 0
endif
if slot==1 then
return HM4[heroIndex]
elseif slot==2 then
return HN4[heroIndex]
elseif slot==3 then
return HO4[heroIndex]
elseif slot==4 then
return HP4[heroIndex]
elseif slot==5 then
return HQ4[heroIndex]
endif
return 0
endfunction
function SuijiMode_RestoreScriptedDragonForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm")==false then
return
endif
if SuijiMode_ScriptedFlightActive(h,3) then
call SuijiMode_EndScriptedFlight(u,3)
endif
if GetUnitTypeId(u)!=0 then
call B848_SetFormRange(u,ON7(h,"SuijiScriptedDragonBaseRange"))
call B1091SetAcquireBase(u,ON7(h,"SuijiScriptedDragonBaseAcquire"))
call UnitRemoveAbility(u,'ZDKA')
// Defensive cleanup for B571 and earlier direct-child states.
call UnitRemoveAbility(u,'ZDKM')
call UnitRemoveAbility(u,'ZDKF')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedDragonEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedDragonEffect"))
endif
call NS7(h,"SuijiScriptedDragonForm",false)
call NP7(h,"SuijiScriptedDragonLevel",0)
call NP7(h,"SuijiScriptedDragonVisualLevel",0)
call SuijiMode_EndVisualForm(u,3)
set fx=null
endfunction
function SuijiMode_ApplyScriptedDragonForm takes unit u returns nothing
local integer h=0
local integer currentType=0
local integer baseLevel=0
local integer level=0
local integer modelType='H00F'
local real remaining=0.
local boolean scepterActive=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedDragonUnitType") then
call NP7(h,"SuijiScriptedDragonUnitType",currentType)
call NQ7(h,"SuijiScriptedDragonBaseRange",B848_FormBaseRange(u))
call NQ7(h,"SuijiScriptedDragonBaseAcquire",B1091AcquireBase(u))
endif
// Resolve the stable logical A03G level first.  The physical Y0BE clone may
// temporarily report zero while a random-skill command card is being rebuilt.
set baseLevel=B287_GetUnitAbilityLevel(u,'A03G')
if OM7(h,"SuijiUltSkill")=='A03G' and SuijiMode_UltLevel(u)>baseLevel then
set baseLevel=SuijiMode_UltLevel(u)
endif
if baseLevel<1 then
set baseLevel=1
elseif baseLevel>3 then
set baseLevel=3
endif
set scepterActive=SuijiMode_ScepterRegistryIsActive(u,'A03G')
set level=baseLevel
if scepterActive then
set level=level+1
endif
if level>4 then
set level=4
endif
if level==2 then
set modelType='H00E'
elseif level==3 then
set modelType='H00G'
elseif level>=4 then
set modelType='H10G'
endif
if level!=OM7(h,"SuijiScriptedDragonVisualLevel") then
call NP7(h,"SuijiScriptedDragonVisualLevel",level)
call SuijiMode_SetVisualForm(u,3,EXGetUnitString(modelType,UNIT_STRING_MODEL_PATH))
endif
call NP7(h,"SuijiScriptedDragonBaseLevel",baseLevel)
call NS7(h,"SuijiScriptedDragonScepterActive",scepterActive)
call NP7(h,"SuijiScriptedDragonLevel",level)
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZDKA',1)
if ON7(h,"SuijiScriptedDragonBaseRange")<500. then
call B848_SetFormRange(u,500.)
else
call B848_SetFormRange(u,ON7(h,"SuijiScriptedDragonBaseRange"))
endif
if ON7(h,"SuijiScriptedDragonBaseAcquire")<800. then
call B1091SetAcquireBase(u,800.)
else
call B1091SetAcquireBase(u,ON7(h,"SuijiScriptedDragonBaseAcquire"))
endif
// Corrosive breath stays script-owned through AV3/AZ3/AG3.
// Never attach ACvs ZDKC to arbitrary random heroes at runtime.
if level>=3 then
if GetUnitAbilityLevel(u,'ZDKF')==0 then
call XF7(u,'ZDKF')
call UnitMakeAbilityPermanent(u,true,'ZDKF')
endif
else
call UnitRemoveAbility(u,'ZDKF')
endif
if level>=4 and SuijiMode_ScriptedFlightActive(h,3)==false then
set remaining=ON7(h,"SuijiScriptedDragonEnd")-TimerGetElapsed(W)
if remaining>.1 then
call SuijiMode_StartScriptedFlight(u,3,remaining)
endif
elseif level<4 and SuijiMode_ScriptedFlightActive(h,3) then
call SuijiMode_EndScriptedFlight(u,3)
endif
endfunction
function SuijiMode_NotifyScriptedDragonForm takes unit u returns nothing
local integer h=0
local integer baseLevel=0
local integer level=0
local player owner=null
local player controller=null
local string message=""
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set baseLevel=OM7(h,"SuijiScriptedDragonBaseLevel")
set level=OM7(h,"SuijiScriptedDragonLevel")
if OO7(h,"SuijiScriptedDragonScepterActive") then
set message="|cFF00FF00真龙形态：神杖已生效，基础 "+I2S(baseLevel)+" 级，当前 "+I2S(level)+" 级。|r"
else
set message="|cFFFFCC00真龙形态：当前没有神杖加成，形态为 "+I2S(level)+" 级。|r"
endif
if level>=4 then
set message=message+" |cFF80D8FF霜冻攻击与无视地形飞行已启用。|r"
elseif level>=3 then
set message=message+" |cFF80D8FF霜冻攻击已启用。|r"
endif
set owner=GetOwningPlayer(u)
call DisplayTimedTextToPlayer(owner,0,0,8.,message)
set controller=SuijiTest_PresetController(GetPlayerId(owner))
if controller!=null and controller!=owner then
call DisplayTimedTextToPlayer(controller,0,0,8.,message)
endif
set message=""
set owner=null
set controller=null
endfunction
function SuijiMode_ScriptedDragonFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedDragonSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=ON7(h,"SuijiScriptedDragonEnd") then
call SuijiMode_RestoreScriptedDragonForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ApplyScriptedDragonForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedDragonForm takes unit u returns nothing
local integer h=0
local integer serial=0
local integer count=1
local real duration=40.
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedDragonForm") then
call SuijiMode_RestoreScriptedDragonForm(u)
endif
set count=SuijiMode_GetDurationMulticastCount(u,'A03G')
if count<1 then
set count=1
endif
set duration=40.*count
set serial=OM7(h,"SuijiScriptedDragonSerial")+1
call NP7(h,"SuijiScriptedDragonSerial",serial)
call NP7(h,"SuijiScriptedDragonUnitType",0)
call NP7(h,"SuijiScriptedDragonLevel",0)
call NP7(h,"SuijiScriptedDragonVisualLevel",0)
call NQ7(h,"SuijiScriptedDragonEnd",TimerGetElapsed(W)+duration)
call NS7(h,"SuijiScriptedDragonForm",true)
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",u,"origin")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedDragonEffect"),fx)
call SuijiMode_ApplyScriptedDragonForm(u)
call SuijiMode_NotifyScriptedDragonForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call TimerStart(t,.10,true,function SuijiMode_ScriptedDragonFormTick)
set fx=null
set t=null
endfunction
function SuijiMode_RestoreScriptedTerrorbladeForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
