function CO9 takes unit u,unit CJ9,integer level,real TA9 returns nothing
	local real x = GetUnitX(CJ9)-50*Cos(TA9)
	local real y = GetUnitY(CJ9)-50*Sin(TA9)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1750+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1700+ZZMF
    else
    set length=1550+ZZMF
    endif
    // if ((MV7(u,ZU[FT4])!=null)or(MV7(u,ZU[R1K])!=null)or(CHIA[GetPlayerId(GetOwningPlayer(u))]==1)) then
	    // call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_TRI", level)
    // else
    // if ((MV7(u,ZU[FT4])!=null)or(MV7(u,ZU[R1K])!=null)or(CHIA[GetPlayerId(GetOwningPlayer(u))]==1)) then
	    // call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_TRI", level)
    // else
        call Wave(u,'h0HJ', 50 * level, length, 375, 375, x, y, GetUnitX(CJ9), GetUnitY(CJ9), 1050, 1, false, "QM_AI_USE_RENJIA", level)
    // endif
    call KillUnit(CJ9)
endfunction
function CP9 takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer iX=OM7(OB7,"Count")
local integer CQ9=iX-1
local real RK=ON7(OB7,"Angle")
local unit oA=O77(OB7,"Caster")
local unit WI7=O77(OB7,"Hero")
local integer V77=OM7(OB7,"Level")
local integer CR9=2+V77*2
local boolean CS9=OO7(OB7,"SpiritCast")
local unit CT9
local player cp9Owner=GetOwningPlayer(oA)
local real cp9X=GetUnitX(oA)
local real cp9Y=GetUnitY(oA)
if b1060GetTriggerEventId!=EVENT_UNIT_SPELL_ENDCAST and b1060GetTriggerEventId!=EVENT_UNIT_DEATH then
call NP7(OB7,"Count",iX+1)
endif
call SetUnitScale(oA,I2R(100+20*CQ9)/ 100,I2R(100+20*CQ9)/ 100,I2R(100+20*CQ9)/ 100)
if (b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and CS9==false) or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and b1060B287_GetSpellAbilityId=='A121') or CQ9==CR9 or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
if CS9 then
set CT9=O77(OB7,"Dummy")
call ShowUnit(CT9,false)
call UnitApplyTimedLife(CT9,'BTLF',1)
endif
call NM7(OB7)
call OZ7(t)
//if(LoadInteger(L7,(GetHandleId(WI7)),(704)))==0 or(LoadInteger(L7,(GetHandleId(WI7)),(704)))==1093679157 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A085',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(WI7),'A121',false)
call UnitRemoveAbility(WI7,'A121')
call CO9(WI7,oA,CQ9,RK)
endif
set oA=CreateUnit(cp9Owner,'h06M',cp9X+150*CQ9*Cos(RK),cp9Y+150*CQ9*Sin(RK),0)
call UnitApplyTimedLife(oA,'BTLF',7)
set t=null
set oA=null
set WI7=null
set CT9=null
set cp9Owner=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
