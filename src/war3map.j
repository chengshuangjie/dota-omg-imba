function I38 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function KSE))
set t=null
endfunction
function UAII takes real UNI, real UBI, real UCI, real F5OO, real HHXX, string P7EE, unit u, real tx, real ty, integer NMX, integer id returns nothing
    local integer skilltx
    if u==null or GetUnitTypeId(u)==0 then
        return
    endif
	set IRR = u
    if id=='ZC11' then
        set skilltx='h0H4'
    elseif id=='ZC12' then
        set skilltx='h0H5'
    else
        set skilltx='h0H3'
    endif
	call Wave(IRR,skilltx, F5OO, UNI, UBI, UCI, GetUnitX(u), GetUnitY(u), tx, ty, HHXX, 1, false, P7EE, NMX)
endfunction
function ShockWaveActions takes nothing returns nothing
	local unit target = Wave_U
    local unit suijiMagnusWaveSource = Wave_Sou
	local unit u = null
	local integer level = Wave_LV
    local real d = 75 * level
    if target==null or suijiMagnusWaveSource==null or GetUnitTypeId(target)==0 or GetUnitTypeId(suijiMagnusWaveSource)==0 then
        set target = null
        set suijiMagnusWaveSource = null
        return
    endif
    set u = M7[GetPlayerId(GetOwningPlayer(suijiMagnusWaveSource))]
    if u==null or GetUnitTypeId(u)==0 then
        set u = suijiMagnusWaveSource
    endif
    if not IsUnitType(target,UNIT_TYPE_HERO) then
        set d = d / 2
    endif
	if not IsUnitType(target, UNIT_TYPE_MAGIC_IMMUNE) then
		call B67(u, target, 1, d)
		call Z57(target,'A4FH', 1, .8,'B0JV')
	endif
	set target = null
	set u = null
    set suijiMagnusWaveSource = null
endfunction
function ShockWaveActionsBefore takes nothing returns nothing
	local unit target = Wave_U
    if target==null or GetUnitTypeId(target)==0 then
        set target = null
        return
    endif
	if not IsUnitType(target, UNIT_TYPE_MAGIC_IMMUNE) then
		call Z57(target,'A4FH', 1, .8,'B0JV')
	endif
	set target = null
endfunction
function a_shockwave takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local real sx = LoadReal(TABLE_HY, h, 2)
	local real sy = LoadReal(TABLE_HY, h, 3)
	local real tx = LoadReal(TABLE_HY, h, 0)
	local real ty = LoadReal(TABLE_HY, h, 1)
	local real length = LoadReal(TABLE_HY, h, 4)
	local real speed = LoadReal(TABLE_HY, h, 5)
    local integer level = LoadInteger(TABLE_HY, h, 10)
	local real a = bj_RADTODEG * Atan2(ty -sy, tx -sx)
	local real x = sx + length * Cos(a * bj_DEGTORAD)
	local real y = sy + length * Sin(a * bj_DEGTORAD)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local unit d = null
	local real range = 0.
    if u==null or GetUnitTypeId(u)==0 then
        call FlushChildHashtable(TABLE_HY, h)
        call PauseTimer(t)
        call DestroyTimer(t)
        set u = null
        set d = null
        set t = null
        return
    endif
	set d = CreateUnit(GetOwningPlayer(u),'e00E', x, y, 0)
	set range = SquareRoot((sx -GetUnitX(d))*(sx -GetUnitX(d))+(sy -GetUnitY(d))*(sy -GetUnitY(d)))
	call UnitApplyTimedLife(d,'BTLF',3.)
	if range > length then
		set range = length
	endif
    if MM_WAVE_END == false then
	    call UAII(range, 150., 150., 0, speed, "ShockWaveActions", d, sx, sy, level, GetUnitTypeId(u))
    endif
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set u = null
	set d = null
	set t = null
endfunction
function ZDB2 takes nothing returns nothing
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local unit ZX7=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer level=0
local integer h
local real damage=0.
local real length=1200.
local real speed=1200.
local integer ZZMF_level=0
local integer ZZMF=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set level=B287_GetUnitAbilityLevel(ZX7, skill)
set damage=75.*level
set ZZMF_level=GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ')
set MM_WAVE_END=false
if ZZMF_level>0 then
    set ZZMF=50*ZZMF_level
endif
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
set length=length+ZZMF+200
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
set length=length+ZZMF+150
else
set length=length+ZZMF
endif
call UAII(length, 150., 150., damage, speed, "ShockWaveActionsBefore", ZX7, b1060GetSpellTargetX, b1060GetSpellTargetY, 1, GetUnitTypeId(ZX7))
//call SetUnitVertexColor(IRR, 255, 100, 0, 255)
if SuijiMode_ScepterRegistryIsActive(ZX7,'A02S') then
    set h = TimerStartSingle(length / (speed-50) , function a_shockwave)
	call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
	call SaveReal(TABLE_HY, h, 0, b1060GetSpellTargetX)
	call SaveReal(TABLE_HY, h, 1, b1060GetSpellTargetY)
	call SaveReal(TABLE_HY, h, 2, GetUnitX(ZX7))
	call SaveReal(TABLE_HY, h, 3, GetUnitY(ZX7))
    call SaveReal(TABLE_HY, h, 4, length)
    call SaveReal(TABLE_HY, h, 5, speed)
    call SaveInteger(TABLE_HY, h, 10, level)
endif
set ZX7=null
endfunction
function ZDB takes nothing returns nothing
if B287_GetSpellAbilityId()=='A02S' or B287_GetSpellAbilityId()=='A4FJ' then
    call ZDB2()
endif
endfunction
function ZCZDB takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZDB))
set t=null
endfunction
function YCJDZC takes unit ZX7,unit IH7 returns nothing
    local trigger t
    local integer OB7
    local integer level=B287_GetUnitAbilityLevel(ZX7,'A0NQ')
    local real YM7=8.+12*level
    local real xishu=(1.5+.5*level)*.01
    local real d=LoadReal(ExtraHT, 'jdzc'+1, GetHandleId(IH7))+xishu
    local unit BB7
    if UnitAlive(IH7) and HaveSavedHandle(ExtraHT, 'jdzc', GetHandleId(IH7)) then
        set t=LoadTriggerHandle(ExtraHT, 'jdzc', GetHandleId(IH7))
        set OB7=GetHandleId(t)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        call SaveInteger(ExtraHT, OB7, 0, 20+level*10)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
        call XF7(BB7,'A0NJ')
        call MHAbility_SetCustomLevelDataReal(BB7,'A0NJ',1,ABILITY_LEVEL_DEF_DATA_DATA_A,d)
        call B947IssueTargetOrderById("YCJDZC @ war3map.j:110674 (B968)",BB7,$D006B,IH7)
call UnitApplyTimedLife(BB7,'BTLF',1.)
        call SaveReal(ExtraHT, 'jdzc'+1, GetHandleId(IH7), d)
    endif
    set t=null
    set BB7=null
endfunction
function ZCJDZC takes nothing returns nothing
    if LoadBoolean(TABLE_HY, EOO, 11)==false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and B287_GetUnitAbilityLevel(WXX,'A0NQ')>0 and GetUnitAbilityLevel(YXX,'B07I')>0 and IsUnitType(WXX, UNIT_TYPE_HERO) then
        call YCJDZC(WXX,YXX)
    endif
endfunction
function KVE takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8)) and UnitAlive(GetFilterUnit()) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0)!=null
endfunction
function KWE takes nothing returns nothing
call B67(D8,GetEnumUnit(),2,F8)
endfunction
function KXE takes unit ZX7,unit IH7,real VW9 returns nothing
local group VA9=WS7()
local boolexpr JJD=Condition(function KVE)
set D8=ZX7
set F8=VW9
call GroupEnumUnitsInRange(VA9,GetUnitX(IH7),GetUnitY(IH7),225,JJD)
call GroupRemoveUnit(VA9,IH7)
call ForGroup(VA9,function KWE)
call DestroyBoolExpr(JJD)
call WR7(VA9)
set VA9=null
set JJD=null
endfunction
function Get_ZL_XISHU takes unit ZX7,unit IH7 returns integer
    local integer level=IMaxBJ(B287_GetUnitAbilityLevel(ZX7,'A0OR'),B287_GetUnitAbilityLevel(ZX7,'A4K0'))
    local integer d=0
    if OT7(IH7,"ShallowGrave|Active") then
        set d=R2I((GetUnitState(IH7,UNIT_STATE_MAX_LIFE)-GetUnitState(IH7,UNIT_STATE_LIFE))*10./GetUnitState(IH7,UNIT_STATE_MAX_LIFE))
        set d=2*level*d
    endif
    return d
endfunction
function KVE_HX takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(D8))==false and UnitAlive(GetFilterUnit()) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0)!=null
endfunction
function KWE_HX takes nothing returns nothing
local unit IH7=GetEnumUnit()
local integer d2=Get_ZL_XISHU(D8,IH7)
call B907SkillHeal(D8,GetEnumUnit(),F8+F8*d2*0.01)
set IH7=null
endfunction
function KXE_HX takes unit ZX7,unit IH7,real VW9 returns nothing
local group VA9=WS7()
local boolexpr JJD=Condition(function KVE_HX)
set D8=ZX7
set F8=VW9
call GroupEnumUnitsInRange(VA9,GetUnitX(IH7),GetUnitY(IH7),225,JJD)
call GroupRemoveUnit(VA9,IH7)
call ForGroup(VA9,function KWE_HX)
call DestroyBoolExpr(JJD)
call WR7(VA9)
set VA9=null
set JJD=null
endfunction
function KYE takes nothing returns boolean
return (IsUnitInGroup(GetFilterUnit(),R8)==false and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())) and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and XH7(GetFilterUnit())==false and IsHideUnit(GetFilterUnit())==false)!=null
endfunction
function KYE_ALL takes nothing returns boolean
return (IsUnitInGroup(GetFilterUnit(),R8)==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and XH7(GetFilterUnit())==false and CHUIFENG(GetFilterUnit())==false and IsHideUnit(GetFilterUnit())==false)!=null
endfunction
function KZE takes group KAE,unit KBE,unit ZX7 returns unit
local group VA9=WS7()
local unit IH7=null
local unit FirstUnit
set R8=KAE
set D8=ZX7
if SuijiMode_ScepterRegistryIsActive(ZX7,'A0OR') then
call GroupEnumUnitsInRange(VA9,GetUnitX(KBE),GetUnitY(KBE),500,Condition(function KYE_ALL))
else
call GroupEnumUnitsInRange(VA9,GetUnitX(KBE),GetUnitY(KBE),500,Condition(function KYE))
endif
set FirstUnit=FirstOfGroup(VA9)
set IH7=FirstUnit
loop
exitwhen FirstUnit==null
if GetUnitState(FirstUnit,UNIT_STATE_LIFE)!=GetUnitState(FirstUnit,UNIT_STATE_MAX_LIFE)then  //选取单位优先级
    if FirstUnit!=ZX7 and IsUnitType(FirstUnit,UNIT_TYPE_HERO) and IsUnitType(IH7,UNIT_TYPE_HERO)==false then
        set IH7=FirstUnit
    elseif FirstUnit!=ZX7 and GetUnitState(FirstUnit,UNIT_STATE_LIFE)<GetUnitState(IH7,UNIT_STATE_LIFE)and IsUnitType(FirstUnit,UNIT_TYPE_HERO) and IsUnitType(IH7,UNIT_TYPE_HERO) then
        set IH7=FirstUnit
    elseif FirstUnit!=ZX7 and IsUnitType(IH7,UNIT_TYPE_HERO)==false and GetUnitState(FirstUnit,UNIT_STATE_LIFE)<GetUnitState(IH7,UNIT_STATE_LIFE)then
        set IH7=FirstUnit
    elseif FirstUnit==ZX7 then
        set IH7=FirstUnit
    endif
endif
call GroupRemoveUnit(VA9,FirstUnit)
set FirstUnit=FirstOfGroup(VA9)
endloop
call WR7(VA9)
set VA9=null
set FirstUnit=null
set DI7=IH7
return DI7
endfunction
function K6E takes unit WX7,unit IH7 returns nothing
local string KLE="Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl"
local string K1E="origin"
local unit array K0E
local integer i=1
local integer BC7=IMaxBJ(B287_GetUnitAbilityLevel(WX7,'A0OR'),B287_GetUnitAbilityLevel(WX7,'A4K0'))
local real VW9=70+BC7*20
local group g=WS7()
local integer MAX=2+BC7
local boolean K2E=false
local real d
local integer d2
loop
exitwhen i>MAX or K2E
if i==1 then
    set K0E[i]=WX7
elseif i==2 then
    if WX7==IH7 then
        set K0E[i]=KZE(g,K0E[i-1],WX7)
    else
        set K0E[i]=IH7
    endif
else
    set K0E[i]=KZE(g,K0E[i-1],WX7)
endif
if K0E[i]==null then
    set K2E=true
else
    call GroupAddUnit(g,K0E[i])
    call YS7(KLE,K0E[i],K1E,2)
    if IsUnitEnemy(K0E[i],GetOwningPlayer(WX7)) then //目标是敌人，造成固定伤害加普攻，治疗附近队友
        call KXE_HX(WX7,K0E[i],VW9)
        call B67(WX7,K0E[i],2,VW9)
        set ZX7_tmp=WX7
        set IH7_tmp=K0E[i]
        set AYB_MNGJ=true
        call ExecuteFunc("Func_MNGJ")
        set AYB_MNGJ=false
        call YCJDZC(WX7,K0E[i])
    else  //目标是队友时回血，对附近敌人造成伤害
        set d=DGH_BUFF(K0E[i])
        set d2=Get_ZL_XISHU(WX7,K0E[i])
        call B907SkillHeal(WX7,K0E[i],VW9*d+VW9*d2*0.01)
        call KXE(WX7,K0E[i],VW9)
    endif
    if i>1 then
        call YV7("SPLK",GetUnitX(K0E[i-1]),GetUnitY(K0E[i-1]),GetUnitX(K0E[i]),GetUnitY(K0E[i]),.3,.5,.9,1.,.7)
    endif
    set i=i+1
endif
endloop
loop
set i=i-1
set K0E[i]=null
exitwhen i<=1
endloop
call WR7(g)
call LINGXIA(WX7,IH7)
set g=null
endfunction
function AYB takes nothing returns boolean
local unit WX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A0OR' or B287_GetSpellAbilityId()=='A4K0' then
if IsUnitEnemy(IH7,GetOwningPlayer(WX7))==false or WQ7(IH7)==false then
    call K6E(WX7,IH7)
else
    call PLK(IH7)
endif
endif
set WX7=null
set IH7=null
return false
endfunction
function KE8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function AYB))
set t=null
endfunction
