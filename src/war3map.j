function KWG takes unit ZX7,integer I97,integer WF8 returns nothing
local group g1=WS7()
local group g2=WS7()
local integer i=0
set IN4=ZX7
loop
exitwhen i>WF8
call GroupEnumUnitsInRange(g2,ON7(I97,"X"+I2S(i)),ON7(I97,"Y"+I2S(i)),$E1,Condition(function AJ7_gai))
call GroupAddGroup(g2,g1)
call GroupClear(g2)
set i=i+1
endloop
call WR7(g2)
if FirstOfGroup(g1)!=null then
set S94=ZX7
set SD4=B287_GetUnitAbilityLevel(ZX7,'A19Z')
call ForGroup(g1,function KVG)
endif
call WR7(g1)
set g1=null
set g2=null
endfunction
function KXG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local real TP9=ON7(I97,"LastX")
local real TQ9=ON7(I97,"LastY")
local integer WF8=OM7(I97,"Count")
local integer durationTicks=OM7(I97,"DurationTicks")
local integer i
local real x
local real y
if durationTicks<=0 then
set durationTicks=360
endif
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>durationTicks or ZX7==null or GetUnitTypeId(ZX7)==0 or UnitAlive(ZX7)==false then
set i=0
loop
exitwhen i>WF8
call DestroyEffect(OG7(I97,"FX"+I2S(i)))
set i=i+1
endloop
call NM7(I97)
call OZ7(t)
else
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
if V8 then
call KUG(ZX7)
endif
if KF7(x,y,TP9,TQ9)>125 then
set WF8=WF8+1
call NP7(I97,"Count",WF8)
call NQ7(I97,"LastX",x)
call NQ7(I97,"LastY",y)
//call NU7(I97,"FX"+I2S(WF8),AddSpecialEffect("War3MapImported\\FireFlyGroundEffect.mdx",x,y))
call NU7(I97,"FX"+I2S(WF8),AddSpecialEffect("tx\\bat\\Batrider_E.mdx",x,y))
call NQ7(I97,"X"+I2S(WF8),x)
call NQ7(I97,"Y"+I2S(WF8),y)
endif
if ModuloInteger(GetTriggerEvalCount(t),$A)==0 then
set S44=true
call KWG(ZX7,I97,WF8)
set S44=false
endif
call Y67(GetUnitX(ZX7),GetUnitY(ZX7),100)
endif
return false
endfunction
