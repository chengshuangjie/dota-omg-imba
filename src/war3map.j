//玲珑心减CD
function Japi_ReduceUnitAbilityCoolDownActions takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local integer id = LoadInteger(TABLE_HY, h, 1)
	local unit u = LoadUnitHandle(TABLE_HY, h, 10)
	local real cooltime = LoadReal(TABLE_HY, h, 2)
	//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000单位ID为|r"+I2S(GetUnitTypeId(u)))
	//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000技能ID为|r"+I2S(id))
	//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000单位ID为|r"+I2S(GetUnitTypeId(u)))
	//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000技能ID为|r"+I2S(id))
	// B1092: discard a cooldown write queued before a completed Rearm.
	if u!=null and GetUnitTypeId(u)!=0 and LoadInteger(TABLE_HY,h,'rfE1')==LoadInteger(L7,GetHandleId(u),'rfE1') and LoadInteger(TABLE_HY,h,'egE1')==LoadInteger(L7,GetHandleId(u),StringHash("B1094EggSkill"+I2S(id))) then
	call YDWESetUnitAbilityState(u, id, 1, cooltime)
	endif
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(t)
	set t = null
	set u = null
	return false
endfunction
function Japi_ReduceUnitAbilityCoolDown takes unit u, integer id, real cooltime returns nothing
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	set id=B287_GetPhysicalAbilityId(u,id)
	call SaveInteger(TABLE_HY, h, 1, id)
	call SaveReal(TABLE_HY, h, 2, cooltime)
	call SaveUnitHandle(TABLE_HY, h, 10, u)
	call SaveInteger(TABLE_HY,h,'rfE1',LoadInteger(L7,GetHandleId(u),'rfE1'))
	call SaveInteger(TABLE_HY,h,'egE1',LoadInteger(L7,GetHandleId(u),StringHash("B1094EggSkill"+I2S(id))))
	call TriggerRegisterTimerEvent(t, 0.0, false)
	call TriggerAddCondition(t, Condition(function Japi_ReduceUnitAbilityCoolDownActions))
	set t = null
endfunction
function ReduceUnitAbilityCoolDownReal takes unit u returns real
local real d=1.
if GetUnitAbilityLevel(u,'A2VW')+GetUnitAbilityLevel(u,'A2YR')+IMaxBJ(B287_GetUnitAbilityLevel(u,'A10Q'),B287_GetUnitAbilityLevel(u,'A1DB'))>0 then
if GetUnitAbilityLevel(u,'A2VW')>0 then
set d=d-.25
endif
if GetUnitAbilityLevel(u,'A2YR')>0 then
set d=d-.08
endif
if IMaxBJ(B287_GetUnitAbilityLevel(u,'A10Q'),B287_GetUnitAbilityLevel(u,'A1DB'))>0 then
set d=d*(0.875-0.125*IMaxBJ(B287_GetUnitAbilityLevel(u,'A10Q'),B287_GetUnitAbilityLevel(u,'A1DB')))
endif
return d
endif
return -1.
endfunction
function LABIKE_ANMU_ReduceUnitAbilityCoolDownReal takes unit u returns real
local real d=1.
local integer level
if ISLABIKE(u) then
    if GetUnitLevel(u)>=16 then
        set level=3
    elseif GetUnitLevel(u)>=11 then
        set level=2
    elseif GetUnitLevel(u)>=6 then
        set level=1
    endif
endif
if ISLABIKE(u) then
if GetUnitAbilityLevel(u,'A2VW')>0 then
set d=d-.25
endif
if GetUnitAbilityLevel(u,'A2YR')>0 then
set d=d-.08
endif
set d=d*(0.875-0.125*level)
return d
endif
return -1.
endfunction
function CBX takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 17)
	local integer T0V = LoadInteger(TABLE_HY, h, 59)
	local integer CAX = LoadInteger(TABLE_HY, h, 60)
	local timer tt = LoadTimerHandle(TABLE_HY, h, 10)
	call SaveBoolean(TABLE_HY, h, 0, true)
	call UnitRemoveAbility(u, CAX)
	call UnitRemoveAbility(u, T0V)
	if GetUnitAbilityLevel(u, T0V)== 0 then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
		call PauseTimer(tt)
		call DestroyTimer(tt)
		call RemoveSavedHandle(TABLE_P, GetHandleId(u), 0 -T0V)
	else
		call TimerStart(tt, 1, true, null)
	endif
	set u = null
	set t = null
	set tt = null
	return false
endfunction
function pC takes nothing returns nothing
local location p1
local location p2
local unit m=GetEnumUnit()
local real x
local real y
local real RK
if IsUnitEnemy(m,GetOwningPlayer(TMPU1))then
set RK=GetUnitFacing(m)
set x=GetUnitX(TMPU1)
set y=GetUnitY(TMPU1)
set p1=Location(CoordinateX50((GetUnitX(m)+300*CosBJ(RK+90))),CoordinateY50((GetUnitY(m)+300*SinBJ(RK+90))))
set p2=Location(CoordinateX50((GetUnitX(m)+300*CosBJ(RK-90))),CoordinateY50((GetUnitY(m)+300*SinBJ(RK-90))))
if SquareRoot((GetLocationX(p1)-x)*(GetLocationX(p1)-x)+(GetLocationY(p1)-y)*(GetLocationY(p1)-y))+SquareRoot((GetLocationX(p2)-x)*(GetLocationX(p2)-x)+(GetLocationY(p2)-y)*(GetLocationY(p2)-y))<660 then
set Ad=true
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",GetEnumUnit(),"chest"))
endif
call RemoveLocation(p1)
call RemoveLocation(p2)
set p1=null
set p2=null
endif
set m=null
endfunction
function BlockUnitPass takes unit u returns boolean
if HAVEJH==false then
return false
endif
set Ad=false
set TMPU1=u
call ForGroup(aw,function pC)
return Ad
endfunction
function Bc takes real fx returns real
if fx<0 then
return Bc(fx+360)
endif
return fx
endfunction
function bc takes real x,real y,real RK,real x1,real y1,real x2,real y2,real xy returns boolean
local real d=SquareRoot((x2-x1)*(x2-x1)+(y2-y1)*(y2-y1))
local real d1=SquareRoot((x1-x)*(x1-x)+(y1-y)*(y1-y))
local real d2=SquareRoot((x2-x)*(x2-x)+(y2-y)*(y2-y))
local real fx
local real bcd1
local real bcd2
local real bcd3
local location p1
local location p2
if d>d1 and d>d2 then
set p1=Location(CoordinateX50((x+xy*.5*CosBJ(RK+90))),CoordinateY50((y+xy*.5*SinBJ(RK+90))))
set p2=Location(CoordinateX50((x+xy*.5*CosBJ(RK-90))),CoordinateY50((y+xy*.5*SinBJ(RK-90))))
set fx=Bc(bj_RADTODEG*Atan2(y1-y,x1-x))
set bcd1=Bc(bj_RADTODEG*Atan2(GetLocationY(p1)-y1,GetLocationX(p1)-x1)-fx)
set bcd2=Bc(bj_RADTODEG*Atan2(GetLocationY(p2)-y1,GetLocationX(p2)-x1)-fx)
set bcd3=Bc(bj_RADTODEG*Atan2(y2-y1,x2-x1)-fx)
call RemoveLocation(p1)
call RemoveLocation(p2)
set p1=null
set p2=null
if(bcd3>bcd1 and bcd3<bcd2)or(bcd3>bcd2 and bcd3<bcd1)then
return true
endif
endif
return false
endfunction
function Ec takes nothing returns nothing
if IsUnitAlly(GetEnumUnit(),GetOwningPlayer(TMPU1))and bc(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitFacing(GetEnumUnit()),GetUnitX(TMPU1),GetUnitY(TMPU1),GetUnitX(TMPU2),GetUnitY(TMPU2),600)then
set Ad=true
endif
endfunction
function Fc takes unit u,unit Ca returns boolean
if HAVEJH==false then
return false
endif
set TMPU1=u
set TMPU2=Ca
set Ad=false
call ForGroup(aw,function Ec)
return Ad
endfunction
function EMX takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	call SaveInteger(TABLE_HY, GetHandleId(LoadUnitHandle(TABLE_HY, h, 14)), LoadInteger(TABLE_HY, h, 33), 2)
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(t)
	set t = null
	return false
endfunction
//记录状态
function EPX takes unit EQX, integer EGX, real EHX returns nothing
	local trigger t = CreateTrigger()
	call TriggerAddCondition(t, Condition(function EMX))
	call TriggerRegisterTimerEvent(t, EHX, false)
	call SaveInteger(TABLE_HY, GetHandleId(EQX), EGX, 1)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 14, EQX)
	call SaveInteger(TABLE_HY, GetHandleId(t), 33, EGX)
	set t = null
endfunction
function AK7 takes unit u returns boolean
return GetUnitAbilityLevel(u,'B068')>0 or GetUnitAbilityLevel(u,'B07T')>0 or GetUnitAbilityLevel(u,'B076')>0 or GetUnitAbilityLevel(u,'BOwk')>0 or GetUnitAbilityLevel(u,'B04R')>0 or GetUnitAbilityLevel(u,'B0A5')>0 or GetUnitAbilityLevel(u,'B01Q')>0 or GetUnitAbilityLevel(u,'B006')>0 or GetUnitAbilityLevel(u,'Binv')>0 or GetUnitAbilityLevel(u,'Apiv')>0 or GetUnitAbilityLevel(u,'A021')>0 or GetUnitAbilityLevel(u,'A0K4')>0 or GetUnitAbilityLevel(u,'A0XB')>0 or GetUnitAbilityLevel(u,'A0Z2')>0 or GetUnitAbilityLevel(u,'A1GA')>0 or GetUnitAbilityLevel(u,'A1HW')>0 or GetUnitAbilityLevel(u,'A1HX')>0 or GetUnitAbilityLevel(u,'A0MB')>0 or GetUnitAbilityLevel(u,'B08K')>0 or GetUnitAbilityLevel(u,'B08X')>0 or GetUnitAbilityLevel(u,'B039')>0 or GetUnitAbilityLevel(u,'B00K')>0 or GetUnitAbilityLevel(u,'BHfs')>0 or GetUnitAbilityLevel(u,'A140')>0 or GetUnitAbilityLevel(u,'B021')>0 or GetUnitAbilityLevel(u,'A0ZD')>0 or GetUnitAbilityLevel(u,'A0KT')>0 or GetUnitAbilityLevel(u,'B0G8')>0 or GetUnitAbilityLevel(u,'B0GS')>0 or GetUnitAbilityLevel(u,'A2RZ')>0
endfunction
//隐身且不可见
function AM7 takes unit u,player p returns boolean
return AK7(u) and IsUnitVisible(u,p)==false
endfunction
function NOX takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit targetUnit
	local unit sourceUnit
	local real speed
	local unit missileDummy
	local real x
	local real y
	local real W_E
	local real W0E
	local real NAX
	local real NNX
	local real NBX
	local real NCX
    local boolean canDodge=LoadBoolean(TABLE_HY, h,-3)
	if GetTriggerEventId()== EVENT_UNIT_SPELL_EFFECT then
		if OXX(B287_GetSpellAbilityId()) then
			call SaveBoolean(TABLE_HY, h,-1, true)
			call SaveReal(TABLE_HY, h,-1, GetUnitX(b1060GetTriggerUnit))
			call SaveReal(TABLE_HY, h,-2, GetUnitY(b1060GetTriggerUnit))
		endif
	else
		set targetUnit = LoadUnitHandle(TABLE_HY, h, 30)
		set sourceUnit = LoadUnitHandle(TABLE_HY, h, 43)
		set speed =(LoadReal(TABLE_HY, h, 44))
		set missileDummy =(LoadUnitHandle(TABLE_HY, h, 45))
        // B1079: our attack missiles must never outlive their combatants or
        // chase indefinitely. Other NHX callers retain their existing rules.
        if LoadStr(TABLE_HY,h,46)=="B1079AttackHit" and (sourceUnit==null or targetUnit==null or missileDummy==null or GetUnitTypeId(sourceUnit)==0 or GetUnitTypeId(targetUnit)==0 or GetUnitTypeId(missileDummy)==0 or not UnitAlive(sourceUnit) or not UnitAlive(targetUnit) or TimerGetElapsed(W)>=LoadReal(TABLE_HY,h,'B179')) then
            call OZ7(t)
            if missileDummy!=null and GetUnitTypeId(missileDummy)!=0 then
                call KillUnit(missileDummy)
            endif
            call FlushChildHashtable(TABLE_HY,h)
            set t=null
            set targetUnit=null
            set sourceUnit=null
            set missileDummy=null
            set b1060GetTriggerUnit=null
            return false
        endif
        // Infest bursts own this callback; abort before reading removed units.
        // Other NHX projectiles retain their existing continuation rules.
        if LoadStr(TABLE_HY,h,46)=="B1029InfestBurstHit" and (sourceUnit==null or targetUnit==null or missileDummy==null or GetUnitTypeId(sourceUnit)==0 or GetUnitTypeId(targetUnit)==0 or GetUnitTypeId(missileDummy)==0) then
            call OZ7(t)
            if missileDummy!=null and GetUnitTypeId(missileDummy)!=0 then
                call KillUnit(missileDummy)
            endif
            call FlushChildHashtable(TABLE_HY,h)
            set t=null
            set targetUnit=null
            set sourceUnit=null
            set missileDummy=null
            set b1060ReturnValue=false
            set b1060GetTriggerUnit=null
            return b1060ReturnValue
        endif
		set x = GetUnitX(missileDummy)
		set y = GetUnitY(missileDummy)
		set W_E = GetUnitX(targetUnit)
		set W0E = GetUnitY(targetUnit)
		set NAX = speed * .03
		if(LoadBoolean(TABLE_HY, h,-1)) then
			set W_E = LoadReal(TABLE_HY, h,-1)
			set W0E = LoadReal(TABLE_HY, h,-2)
		endif
		set NNX = AngleBetweenXY(x, y, W_E, W0E)
		set NBX = x + NAX * Cos(NNX * bj_DEGTORAD)
		set NCX = y + NAX * Sin(NNX * bj_DEGTORAD)
		call SetUnitX(missileDummy, NBX)
		call SetUnitY(missileDummy, NCX)
		call EXSetUnitFacing(missileDummy, NNX)
		if not UnitAlive(targetUnit) or BlockUnitPass(missileDummy) then
			call KillUnit(missileDummy)
			if HaveSavedHandle(TABLE_HY,h,StringHash("B582BounceChain")) then
				set B584_BOUNCE_ABORT_MISSILE_HANDLE=h
				call ExecuteFunc("B584_AbortBounceChain")
				set B584_BOUNCE_ABORT_MISSILE_HANDLE=0
			endif
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		elseif KF7(W_E, W0E, NBX, NCX)<= NAX then
            if canDodge and AM7(targetUnit,GetOwningPlayer(sourceUnit)) then  //隐身躲避
                call SaveBoolean(TABLE_HY, h,-1, true)
            else
            endif
			call KillUnit(missileDummy)
			set U22 = sourceUnit
			set W22 = targetUnit
			if LoadBoolean(TABLE_HY, h,-1)==false then
				if HaveSavedString(TABLE_HY, h, 46) then
					call ExecuteFunc(LoadStr(TABLE_HY, h, 46))
				endif
			elseif HaveSavedHandle(TABLE_HY,h,StringHash("B582BounceChain")) then
				set B584_BOUNCE_ABORT_MISSILE_HANDLE=h
				call ExecuteFunc("B584_AbortBounceChain")
				set B584_BOUNCE_ABORT_MISSILE_HANDLE=0
			endif
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		endif
	endif
	set t = null
	set targetUnit = null
	set sourceUnit = null
	set missileDummy = null
	set b1060ReturnValue=false
	set b1060GetTriggerUnit=null
	return b1060ReturnValue
endfunction
function ChangeMissileDummy takes unit source,unit u,string DiffMissile returns nothing
    call SetUnitScale(u,XX7(source),XX7(source),XX7(source))
    call MHUnit_SetModel(u,DiffMissile,false)
endfunction
function NHX takes unit sourceUnit, unit targetUnit, integer unitTypeId, string callback, real speed, boolean canDodge, string DiffMissile returns trigger
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local real NWYE = GetUnitX(sourceUnit)
	local real NWZE = GetUnitY(sourceUnit)
	local real NMX = GetUnitFacing(sourceUnit)
    local unit missileDummy
	call TriggerRegisterTimerEvent(t, .03, true)
	call TriggerAddCondition(t, Condition(function NOX))
	call SaveReal(TABLE_HY, h, 44,((speed)* 1.))
	call SaveUnitHandle(TABLE_HY, h, 30,((targetUnit)))
	call SaveStr(TABLE_HY, h, 46,(callback))
	call SaveUnitHandle(TABLE_HY, h, 43,((sourceUnit)))
	call SaveBoolean(TABLE_HY, h,-1, false)
    call SaveBoolean(TABLE_HY, h,-3, canDodge)
	if canDodge and IsUnitEnemy(targetUnit,GetOwningPlayer(sourceUnit)) then
		call SaveReal(TABLE_HY, h,-1, 0)
		call SaveReal(TABLE_HY, h,-2, 0)
		call TriggerRegisterUnitEvent(t, targetUnit, EVENT_UNIT_SPELL_EFFECT)
	endif
    set missileDummy=CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)
    if DiffMissile !="" then
        call ChangeMissileDummy(sourceUnit,missileDummy,DiffMissile)
    endif
    call SaveUnitHandle(TABLE_HY, h, 45,missileDummy)
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	// if IsUnitOwnedByPlayer(sourceUnit, B7) then
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(sourceUnit), unitTypeId, NWYE, NWZE, NMX)))
	// else
		// call SaveUnitHandle(TABLE_HY, h, 45,(CreateUnit(GetOwningPlayer(targetUnit), unitTypeId, NWYE, NWZE, NMX)))
	// endif
	set V33 = t
	set t = null
	return V33
endfunction
function NHX_TANSHE takes unit skillsource,unit sourceUnit, unit targetUnit, integer unitTypeId, string callback, real speed, boolean canDodge, string DiffMissile returns trigger
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local real NWYE = GetUnitX(sourceUnit)
	local real NWZE = GetUnitY(sourceUnit)
	local real NMX = GetUnitFacing(sourceUnit)
    local unit missileDummy
	call TriggerRegisterTimerEvent(t, .03, true)
	call TriggerAddCondition(t, Condition(function NOX))
	call SaveReal(TABLE_HY, h, 44,((speed)* 1.))
	call SaveUnitHandle(TABLE_HY, h, 30,((targetUnit)))
	call SaveStr(TABLE_HY, h, 46,(callback))
	call SaveUnitHandle(TABLE_HY, h, 43,((skillsource)))
	call SaveBoolean(TABLE_HY, h,-1, false)
	if canDodge and IsUnitEnemy(targetUnit,GetOwningPlayer(skillsource)) then
		call SaveReal(TABLE_HY, h,-1, 0)
		call SaveReal(TABLE_HY, h,-2, 0)
		call TriggerRegisterUnitEvent(t, targetUnit, EVENT_UNIT_SPELL_EFFECT)
	endif
    set missileDummy=CreateUnit(GetOwningPlayer(skillsource), unitTypeId, NWYE, NWZE, NMX)
    if DiffMissile !="" then
        call ChangeMissileDummy(skillsource,missileDummy,DiffMissile)
    endif
    call SaveUnitHandle(TABLE_HY, h, 45,missileDummy)
	set V33 = t
	set t = null
	return V33
endfunction
function I1X_tmp takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local real I2X = I2R(LoadInteger(TABLE_HY, h, 0))
	local integer WOV = LoadInteger(TABLE_HY, h, 1)
	local real x
	local real y
	local real dx
	local real dy
	local real I3X
	local real sp
	local real d
	local real I4X = GetUnitDefaultMoveSpeed(u)+ I2R(U3V(u))
	local real I5X
	local integer I6X
	local integer c = LoadInteger(TABLE_HY, h,-1)+ 1
	if KK_GAME_DIFFICULTY==1 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and IsUnitType(u,UNIT_TYPE_HERO) and (WOV==0 or WOV>350) then
		set WOV=350
	elseif WOV == 0 then
		set WOV = 9999
	endif
	set I5X = RMinBJ(I4X *(100. + I2X)/ 100., WOV)-GetUnitMoveSpeed(u)
	set I5X = RMinBJ(I5X,1044-GetUnitMoveSpeed(u)) //限制移速最大值
	call SaveInteger(TABLE_HY, h,-1, c)
	call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(I5X))
	if I5X > 0 and UnitAlive(u) then
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set dx = LoadReal(TABLE_HY, h, 10)
		set dy = LoadReal(TABLE_HY, h, 11)
		set d = KF7(dx, dy, x, y)
		if LoadBoolean(TABLE_K, GetHandleId(u), 99)== false then
			set I6X = GetUnitCurrentOrder(u)
			if(d < 100  and d > 1) and I6X !=$D0019 and I6X !=$D0004 and I6X !=$D0005 then
				set I3X = Atan2(y -dy, x -dx)
				set sp = I5X * YNN
				call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(sp / YNN))
				call SetUnitX(u, CoordinateX50(x + sp * Cos(I3X)))
				call SetUnitY(u, CoordinateY50(y + sp * Sin(I3X)))
			endif
		else
			call SaveBoolean(TABLE_K, GetHandleId(u), 99, false)
		endif
		call SaveReal(TABLE_HY, h, 10, GetUnitX(u))
		call SaveReal(TABLE_HY, h,$B, GetUnitY(u))
	endif
    if UnitAlive(u)==false then
        call PauseTimer(t)
        call FlushChildHashtable(TABLE_HY,h)
        call FlushChildHashtable(TABLE_K,GetHandleId(u))
        call DestroyTimer(t)     
    endif
	set t = null
	set u = null
endfunction
function SetUnitImitateMoveSpeed_tmp takes unit u, integer I2X, integer WOV returns nothing
	local timer t
	local integer h
	if HaveSavedHandle(TABLE_K, GetHandleId(u),'MVSP')== false then
		set t = CreateTimer()
		set h = GetHandleId(t)
		call TimerStart(t, YNN, true, function I1X_tmp)
		set RRR = RRR + 1
		call SaveUnitHandle(TABLE_HY, h, 0, u)
		call SaveReal(TABLE_HY, h, 10, GetUnitX(u))
		call SaveReal(TABLE_HY, h,$B, GetUnitY(u))
		call SaveBoolean(TABLE_HY, h, 100, true)
		call SaveTimerHandle(TABLE_K, GetHandleId(u),'MVSP', t)
	else
		set t = LoadTimerHandle(TABLE_K, GetHandleId(u),'MVSP')
		set h = GetHandleId(t)
	endif
	if I2X == LoadInteger(TABLE_HY, h, 0) and WOV == LoadInteger(TABLE_HY, h, 1) then
		set t = null
		return
	endif
	call SaveInteger(TABLE_HY, h, 1, WOV)
	call SaveInteger(TABLE_HY, h, 0, I2X)
	if I2X == 0 then
		call PauseTimer(t)
		set RRR = RRR -1
		call SaveReal(TABLE_K, GetHandleId(u), 99, 0)
		call SaveBoolean(TABLE_HY, h, 100, false)
	elseif LoadBoolean(TABLE_HY, h, 100)== false then
		call TimerStart(t, YNN, true, function I1X_tmp)
		set RRR = RRR + 1
		call SaveBoolean(TABLE_HY, h, 100, true)
	endif
	set t = null
endfunction
function I1X takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer moveOwner1116 = LoadInteger(TABLE_HY, h, StringHash("B1116MoveOwner"))
	local real I2X = I2R(LoadInteger(TABLE_HY, h, 0))
	local integer WOV = LoadInteger(TABLE_HY, h, 1)
	local real x
	local real y
	local real dx
	local real dy
	local real I3X
	local real sp
	local real d
	local real I4X
	local real I5X
	local integer I6X
	local integer c = LoadInteger(TABLE_HY, h,-1)+ 1
	// B1116: a removed target or replaced owner must not leave a .015s orphan.
	// A dead hero with a valid unit and binding keeps its controller for revival.
	if u == null or GetUnitTypeId(u) == 0 or moveOwner1116 == 0 or LoadTimerHandle(TABLE_K, moveOwner1116, 'MVSP') != t then
		if moveOwner1116 != 0 and LoadTimerHandle(TABLE_K, moveOwner1116, 'MVSP') == t then
			call RemoveSavedHandle(TABLE_K, moveOwner1116, 'MVSP')
			call RemoveSavedReal(TABLE_K, moveOwner1116, 99)
			call RemoveSavedBoolean(TABLE_K, moveOwner1116, 99)
		endif
		if LoadBoolean(TABLE_HY, h, 100) then
			set RRR = RRR - 1
		endif
		call PauseTimer(t)
		call FlushChildHashtable(TABLE_HY, h)
		call DestroyTimer(t)
		set t = null
		set u = null
		return
	endif
	set I4X = GetUnitDefaultMoveSpeed(u)+ I2R(U3V(u))
	if KK_GAME_DIFFICULTY==1 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and IsUnitType(u,UNIT_TYPE_HERO) and (WOV==0 or WOV>350) then
		set WOV=350
	elseif WOV == 0 then
		set WOV = 9999
	endif
	set I5X = RMinBJ(I4X *(100. + I2X)/ 100., WOV)-GetUnitMoveSpeed(u)
	set I5X = RMinBJ(I5X,1044-GetUnitMoveSpeed(u)) //限制移速最大值
	call SaveInteger(TABLE_HY, h,-1, c)
	call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(I5X))
	if I5X > 0 and UnitAlive(u) then
		set x = GetUnitX(u)
		set y = GetUnitY(u)
		set dx = LoadReal(TABLE_HY, h, 10)
		set dy = LoadReal(TABLE_HY, h, 11)
		set d = KF7(dx, dy, x, y)
		if LoadBoolean(TABLE_K, GetHandleId(u), 99)== false then
			set I6X = GetUnitCurrentOrder(u)
			if(d < 100  and d > 1) and I6X !=$D0019 and I6X !=$D0004 and I6X !=$D0005 then
				set I3X = Atan2(y -dy, x -dx)
				set sp = I5X * YNN
				call SaveReal(TABLE_K, GetHandleId(u), 99, R2I(sp / YNN))
				call SetUnitX(u, CoordinateX50(x + sp * Cos(I3X)))
				// B1118: movement callbacks may stop or replace this controller.
				// Leave the new owner untouched and never repopulate a retired timer.
				if u == null or GetUnitTypeId(u) == 0 or LoadTimerHandle(TABLE_K, moveOwner1116, 'MVSP') != t then
					set t = null
					set u = null
					return
				endif
