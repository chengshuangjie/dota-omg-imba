if skill=='A02Q' or skill=='A1D9' then
return true
endif
if skill=='A0DH' or skill=='A1OB' or skill=='A06R' or skill=='A1B4' or skill=='A29J' or skill=='A1MP' then
return true
endif
if skill=='A0KV' or skill=='A0L8' then
return true
endif
if skill=='A06I' or skill=='A2S1' then
return true
endif
if skill=='A063' or skill=='A4NS' or skill=='A0A5' or skill=='A2SO' or skill=='A03D' or skill=='X03D' or skill=='X13D' then
return true
endif
if skill=='A03O' or skill=='A3K8' then
return true
endif
if skill=='A0G8' or skill=='A0H4' or skill=='A1A8' then
return true
endif
if skill=='A00P' or skill=='X00P' or skill=='X10P' or skill=='A04Y' then
return true
endif
if skill=='A0SK' or skill=='A0QK' or skill=='A21Q' then
return true
endif
if skill=='A0OO' or skill=='A0B1' then
return true
endif
return false
endfunction
function SuijiMode_MulticastCanonicalSkill takes integer skill returns integer
local integer pair=0
loop
exitwhen pair>=YPI
if (skill==YTI[pair] or skill==YRI[pair]) and SuijiMode_IsFixedPersistentAghPair(YTI[pair],YRI[pair]) then
return YTI[pair]
endif
set pair=pair+1
endloop
return skill
endfunction
function SuijiMode_MulticastPhysicalSkill takes unit u,integer skill returns integer
local integer canonical=SuijiMode_MulticastCanonicalSkill(skill)
local integer physical=B287_GetPhysicalAbilityId(u,canonical)
local integer registeredPhysical=0
local integer pair=0
// The Scepter registry already resolves native learnable pairs against the
// currently exposed engine-owned button.  Reuse that result instead of
// independently preferring a hidden base member of the pair.
if u!=null and GetUnitTypeId(u)!=0 and SuijiMode_ScepterRegistryIsRegistered(u,canonical) then
set registeredPhysical=SuijiMode_ScepterRegistryPhysical(u,canonical)
if registeredPhysical!=0 and GetUnitAbilityLevel(u,registeredPhysical)>0 then
return registeredPhysical
endif
endif
if u==null or GetUnitTypeId(u)==0 or GetUnitAbilityLevel(u,physical)>0 then
return physical
endif
loop
exitwhen pair>=YPI
if canonical==YTI[pair] and SuijiMode_IsFixedPersistentAghPair(YTI[pair],YRI[pair]) then
set physical=B287_GetPhysicalAbilityId(u,YRI[pair])
if GetUnitAbilityLevel(u,physical)>0 then
return physical
endif
return B287_GetPhysicalAbilityId(u,canonical)
endif
set pair=pair+1
endloop
return physical
endfunction
function SuijiMode_MulticastAllowedSkill takes unit u,integer skill returns boolean
local integer h=0
local integer physicalSkill=0
local item it=null
if u==null or skill==0 or skill=='A7H0' or skill=='A7H1' or skill=='A7H2' then
return false
endif
set skill=SuijiMode_MulticastCanonicalSkill(skill)
// State windows, movement and second-stage commands execute exactly once.
if skill=='AMdW' or skill=='AMdR' or skill=='AMdD' or skill=='AMdT' or skill=='AMdF' then
return false
endif
if B290_IsDisplacementSkill(skill) then
return false
endif
set h=GetHandleId(u)
set physicalSkill=SuijiMode_MulticastPhysicalSkill(u,skill)
// B515: native Centaur Hoof Stomp owns an engine AOw2 ability instance that
// MemHack's generic multicast inspection/cast path cannot safely consume.
// Reject it before GetSourceItem/cooldown/CastEx are queried. The OMG clone
// Y00E remains eligible because its physical id is different.
if skill=='A00S' and physicalSkill=='A00S' then
return false
endif
if skill==OM7(h,"SuijiSmallHelper") or skill==OM7(h,"SuijiUltHelper") then
return false
endif
if GetUnitAbilityLevel(u,physicalSkill)<=0 then
return false
endif
set it=B945SourceItem(u,physicalSkill)
if it!=null then
set it=null
return false
endif
if SuijiMode_MulticastHasSafeEffectRepeat(skill) then
set it=null
return true
endif
if SuijiMode_MulticastForbiddenSkill(skill) then
return false
endif
if UL7(skill)==false or L67(skill) or SGD(skill) or HGD(skill) then
return false
endif
// This function only runs for an actual spell event, so a passive ability can
// never reach this point.  Do not let a client-local MemHack query decide
// synchronized multicast eligibility.
set it=null
return true
endfunction
function SuijiMode_MulticastPointOrderId takes integer suijiMulticastPointSkill returns integer
if suijiMulticastPointSkill=='A06W' or suijiMulticastPointSkill=='A12K' then
return 852662
endif
if suijiMulticastPointSkill=='A1T5' or suijiMulticastPointSkill=='A235' then
return 852089
endif
if suijiMulticastPointSkill=='A1SU' then
return 852089
endif
if suijiMulticastPointSkill=='A1U6' or suijiMulticastPointSkill=='A2UO' then
return 852662
endif
return 0
endfunction
function SuijiMode_MulticastRepeatInterval takes integer suijiMulticastIntervalSkill returns real
if SuijiMode_IsDrainMulticastAllowedSkill(suijiMulticastIntervalSkill) then
return .75
endif
if suijiMulticastIntervalSkill=='A0QK' or suijiMulticastIntervalSkill=='A21Q' then
return .45
endif
return .30
endfunction
function SuijiMode_MulticastUsesDistinctTargets takes integer suijiMulticastDistinctSkill returns boolean
set suijiMulticastDistinctSkill=SuijiMode_MulticastCanonicalSkill(suijiMulticastDistinctSkill)
return suijiMulticastDistinctSkill=='A094' or suijiMulticastDistinctSkill=='A1H5' or suijiMulticastDistinctSkill=='A095' or suijiMulticastDistinctSkill=='A01P' or suijiMulticastDistinctSkill=='A02Q'
endfunction
function SuijiMode_MulticastDistinctAllowsMagicImmune takes unit suijiMulticastDistinctCaster,integer suijiMulticastDistinctSkill returns boolean
set suijiMulticastDistinctSkill=SuijiMode_MulticastCanonicalSkill(suijiMulticastDistinctSkill)
return suijiMulticastDistinctSkill=='A01P' and SuijiMode_ScepterRegistryIsActive(suijiMulticastDistinctCaster,'A01P')
endfunction
function SuijiMode_MulticastDistinctTargetIsValid takes unit suijiMulticastDistinctCaster,integer suijiMulticastDistinctSkill,unit suijiMulticastDistinctCandidate returns boolean
local boolean suijiMulticastDistinctAllowMagicImmune=SuijiMode_MulticastDistinctAllowsMagicImmune(suijiMulticastDistinctCaster,suijiMulticastDistinctSkill)
if suijiMulticastDistinctCaster==null or suijiMulticastDistinctCandidate==null then
return false
endif
return GetUnitTypeId(suijiMulticastDistinctCandidate)!=0 and UnitAlive(suijiMulticastDistinctCandidate) and IsUnitEnemy(suijiMulticastDistinctCandidate,GetOwningPlayer(suijiMulticastDistinctCaster)) and IsUnitVisible(suijiMulticastDistinctCandidate,GetOwningPlayer(suijiMulticastDistinctCaster)) and IsUnitType(suijiMulticastDistinctCandidate,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(suijiMulticastDistinctCandidate,'A04R')==0 and XH7(suijiMulticastDistinctCandidate)==false and CHUIFENG(suijiMulticastDistinctCandidate)==false and (suijiMulticastDistinctAllowMagicImmune or IsMagicImmuneUnit(suijiMulticastDistinctCandidate)==false)
endfunction
function SuijiMode_MulticastPickDistinctTarget takes unit suijiMulticastDistinctCaster,integer suijiMulticastDistinctSkill,group suijiMulticastDistinctGroup returns unit
local unit suijiMulticastDistinctTarget=null
local unit suijiMulticastDistinctCandidate=null
local group suijiMulticastDistinctHeroGroup=null
local group suijiMulticastDistinctOtherGroup=null
if suijiMulticastDistinctCaster==null or suijiMulticastDistinctGroup==null then
return null
endif
set suijiMulticastDistinctHeroGroup=CreateGroup()
set suijiMulticastDistinctOtherGroup=CreateGroup()
loop
set suijiMulticastDistinctCandidate=FirstOfGroup(suijiMulticastDistinctGroup)
exitwhen suijiMulticastDistinctCandidate==null
call GroupRemoveUnit(suijiMulticastDistinctGroup,suijiMulticastDistinctCandidate)
if SuijiMode_MulticastDistinctTargetIsValid(suijiMulticastDistinctCaster,suijiMulticastDistinctSkill,suijiMulticastDistinctCandidate) then
if IsUnitType(suijiMulticastDistinctCandidate,UNIT_TYPE_HERO) then
call GroupAddUnit(suijiMulticastDistinctHeroGroup,suijiMulticastDistinctCandidate)
else
call GroupAddUnit(suijiMulticastDistinctOtherGroup,suijiMulticastDistinctCandidate)
endif
endif
endloop
if FirstOfGroup(suijiMulticastDistinctHeroGroup)!=null then
set suijiMulticastDistinctTarget=GroupPickRandomUnit(suijiMulticastDistinctHeroGroup)
else
set suijiMulticastDistinctTarget=GroupPickRandomUnit(suijiMulticastDistinctOtherGroup)
endif
if suijiMulticastDistinctTarget!=null then
call GroupRemoveUnit(suijiMulticastDistinctHeroGroup,suijiMulticastDistinctTarget)
call GroupRemoveUnit(suijiMulticastDistinctOtherGroup,suijiMulticastDistinctTarget)
endif
loop
set suijiMulticastDistinctCandidate=FirstOfGroup(suijiMulticastDistinctHeroGroup)
exitwhen suijiMulticastDistinctCandidate==null
call GroupRemoveUnit(suijiMulticastDistinctHeroGroup,suijiMulticastDistinctCandidate)
call GroupAddUnit(suijiMulticastDistinctGroup,suijiMulticastDistinctCandidate)
endloop
loop
set suijiMulticastDistinctCandidate=FirstOfGroup(suijiMulticastDistinctOtherGroup)
exitwhen suijiMulticastDistinctCandidate==null
call GroupRemoveUnit(suijiMulticastDistinctOtherGroup,suijiMulticastDistinctCandidate)
call GroupAddUnit(suijiMulticastDistinctGroup,suijiMulticastDistinctCandidate)
endloop
call DestroyGroup(suijiMulticastDistinctHeroGroup)
call DestroyGroup(suijiMulticastDistinctOtherGroup)
set suijiMulticastDistinctHeroGroup=null
set suijiMulticastDistinctOtherGroup=null
set suijiMulticastDistinctCandidate=null
return suijiMulticastDistinctTarget
endfunction
function SuijiMode_RhastaMulticastShackleCleanup takes nothing returns nothing
local timer suijiRhastaMulticastCleanupTimer=GetExpiredTimer()
local integer suijiRhastaMulticastCleanupHandle=GetHandleId(suijiRhastaMulticastCleanupTimer)
local unit suijiRhastaMulticastCleanupTarget=LoadUnitHandle(L7,suijiRhastaMulticastCleanupHandle,0)
local effect suijiRhastaMulticastCleanupEffect=LoadEffectHandle(L7,suijiRhastaMulticastCleanupHandle,1)
if suijiRhastaMulticastCleanupEffect!=null then
call DestroyEffect(suijiRhastaMulticastCleanupEffect)
endif
call FlushChildHashtable(L7,suijiRhastaMulticastCleanupHandle)
call PauseTimer(suijiRhastaMulticastCleanupTimer)
call DestroyTimer(suijiRhastaMulticastCleanupTimer)
set suijiRhastaMulticastCleanupEffect=null
set suijiRhastaMulticastCleanupTarget=null
set suijiRhastaMulticastCleanupTimer=null
endfunction
function SuijiMode_RhastaMulticastShackleRepeat takes unit suijiRhastaMulticastCaster,unit suijiRhastaMulticastTarget returns nothing
local integer suijiRhastaMulticastLevel=1
if suijiRhastaMulticastCaster==null or suijiRhastaMulticastTarget==null or UnitAlive(suijiRhastaMulticastTarget)==false then
return
endif
set suijiRhastaMulticastLevel=B287_GetUnitAbilityLevel(suijiRhastaMulticastCaster,'A04Y')
if suijiRhastaMulticastLevel<1 then
set suijiRhastaMulticastLevel=1
endif
call B67(suijiRhastaMulticastCaster,suijiRhastaMulticastTarget,2,0.)
call B67(suijiRhastaMulticastCaster,suijiRhastaMulticastTarget,1,20.+10.*I2R(suijiRhastaMulticastLevel))
endfunction
function SuijiMode_RhastaAerialShackleMulticastRepeat takes unit suijiRhastaAerialShackleCaster,unit suijiRhastaAerialShackleTarget,integer suijiRhastaAerialShackleSkill returns nothing
local integer suijiRhastaAerialShackleLevel=0
if suijiRhastaAerialShackleCaster==null or suijiRhastaAerialShackleTarget==null or UnitAlive(suijiRhastaAerialShackleTarget)==false then
return
endif
set suijiRhastaAerialShackleLevel=GetUnitAbilityLevel(suijiRhastaAerialShackleCaster,suijiRhastaAerialShackleSkill)
if suijiRhastaAerialShackleLevel<=0 then
set suijiRhastaAerialShackleLevel=B287_GetUnitAbilityLevel(suijiRhastaAerialShackleCaster,'A00P')+GetUnitAbilityLevel(suijiRhastaAerialShackleCaster,'X00P')+GetUnitAbilityLevel(suijiRhastaAerialShackleCaster,'X10P')
endif
if suijiRhastaAerialShackleLevel<1 then
set suijiRhastaAerialShackleLevel=1
endif
call B67(suijiRhastaAerialShackleCaster,suijiRhastaAerialShackleTarget,1,40.+80.*I2R(suijiRhastaAerialShackleLevel))
call LINGXIA(suijiRhastaAerialShackleCaster,suijiRhastaAerialShackleTarget)
call SuijiMode_RhastaAerialShackleSpawnScepterWards(suijiRhastaAerialShackleCaster,suijiRhastaAerialShackleTarget)
endfunction
function SuijiMode_NagaMirrorMulticastExtra takes unit suijiNagaMirrorCaster returns nothing
local trigger suijiNagaMirrorTrigger=null
local integer suijiNagaMirrorHandle=0
local integer suijiNagaMirrorLevel=0
if suijiNagaMirrorCaster==null or GetUnitTypeId(suijiNagaMirrorCaster)==0 or UnitAlive(suijiNagaMirrorCaster)==false then
return
endif
set suijiNagaMirrorLevel=NagaSirenAghMirror_GetLevel(suijiNagaMirrorCaster)
if suijiNagaMirrorLevel<1 then
set suijiNagaMirrorLevel=1
elseif suijiNagaMirrorLevel>4 then
set suijiNagaMirrorLevel=4
endif
set suijiNagaMirrorTrigger=CreateTrigger()
set suijiNagaMirrorHandle=GetHandleId(suijiNagaMirrorTrigger)
call TriggerRegisterTimerEvent(suijiNagaMirrorTrigger,.05,false)
call TriggerAddCondition(suijiNagaMirrorTrigger,Condition(function NJFS4))
call SaveUnitHandle(L7,suijiNagaMirrorHandle,2,suijiNagaMirrorCaster)
call SaveInteger(L7,suijiNagaMirrorHandle,10,suijiNagaMirrorLevel)
set suijiNagaMirrorTrigger=null
endfunction
function SuijiMode_StartFiendsGripMulticastRepeat takes unit suijiFiendsGripMulticastCaster,unit suijiFiendsGripMulticastTarget returns boolean
local unit suijiFiendsGripMulticastDummy=null
local integer suijiFiendsGripPhysical='A02Q'
local integer suijiFiendsGripMulticastLevel=0
local boolean suijiFiendsGripMulticastIssued=false
if suijiFiendsGripMulticastCaster==null or suijiFiendsGripMulticastTarget==null or GetUnitTypeId(suijiFiendsGripMulticastCaster)==0 or GetUnitTypeId(suijiFiendsGripMulticastTarget)==0 or UnitAlive(suijiFiendsGripMulticastCaster)==false or UnitAlive(suijiFiendsGripMulticastTarget)==false then
return false
endif
if SuijiMode_ScepterRegistryIsActive(suijiFiendsGripMulticastCaster,'A02Q') then
set suijiFiendsGripPhysical='A1D9'
endif
set suijiFiendsGripMulticastLevel=SuijiMode_GetPairCastLevel(suijiFiendsGripMulticastCaster,suijiFiendsGripPhysical,'A02Q','A1D9')
if suijiFiendsGripMulticastLevel<1 then
return false
endif
set suijiFiendsGripMulticastDummy=CreateUnit(GetOwningPlayer(suijiFiendsGripMulticastCaster),'e00E',GetUnitX(suijiFiendsGripMulticastTarget),GetUnitY(suijiFiendsGripMulticastTarget),0.)
call UnitAddAbility(suijiFiendsGripMulticastDummy,suijiFiendsGripPhysical)
call SetUnitAbilityLevel(suijiFiendsGripMulticastDummy,suijiFiendsGripPhysical,suijiFiendsGripMulticastLevel)
call YDWESetUnitAbilityDataReal(suijiFiendsGripMulticastDummy,suijiFiendsGripPhysical,suijiFiendsGripMulticastLevel,ABILITY_DATA_DATA_A,0.)
call SetUnitState(suijiFiendsGripMulticastDummy,UNIT_STATE_MANA,GetUnitState(suijiFiendsGripMulticastDummy,UNIT_STATE_MAX_MANA))
call SaveUnitHandle(L7,GetHandleId(suijiFiendsGripMulticastDummy),StringHash("SuijiFiendsGripMulticastSource"),suijiFiendsGripMulticastCaster)
call SaveBoolean(L7,GetHandleId(suijiFiendsGripMulticastDummy),StringHash("SuijiFiendsGripMulticastDummy"),true)
call UnitApplyTimedLife(suijiFiendsGripMulticastDummy,'BTLF',10.)
set suijiFiendsGripMulticastIssued=B947IssueTargetOrderById("SuijiMode_StartFiendsGripMulticastRepeat @ war3map.j:195459 (B968)",suijiFiendsGripMulticastDummy,852480,suijiFiendsGripMulticastTarget)
if suijiFiendsGripMulticastIssued==false then
call RemoveSavedHandle(L7,GetHandleId(suijiFiendsGripMulticastDummy),StringHash("SuijiFiendsGripMulticastSource"))
call RemoveSavedBoolean(L7,GetHandleId(suijiFiendsGripMulticastDummy),StringHash("SuijiFiendsGripMulticastDummy"))
call RemoveUnit(suijiFiendsGripMulticastDummy)
endif
set suijiFiendsGripMulticastDummy=null
set suijiFiendsGripMulticastTarget=null
set suijiFiendsGripMulticastCaster=null
return suijiFiendsGripMulticastIssued
endfunction
function SuijiMode_MulticastSpecialRepeat takes unit suijiMulticastSpecialCaster,unit suijiMulticastSpecialTarget,integer suijiMulticastSpecialSkill,real suijiMulticastSpecialX,real suijiMulticastSpecialY returns boolean
if suijiMulticastSpecialSkill=='A02Q' or suijiMulticastSpecialSkill=='A1D9' then
return SuijiMode_StartFiendsGripMulticastRepeat(suijiMulticastSpecialCaster,suijiMulticastSpecialTarget)
endif
if suijiMulticastSpecialSkill=='A0KV' then
call LP9(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A0L8' then
call MiranaArrow_CastEffect(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY,true)
return true
endif
if suijiMulticastSpecialSkill=='A0SK' then
call SuijiMode_EarthshakerFissureEffect(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY)
return true
endif
if suijiMulticastSpecialSkill=='A0B1' then
call SuijiMode_MidnightPulseEffect(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY)
return true
endif
if suijiMulticastSpecialSkill=='A0QK' or suijiMulticastSpecialSkill=='A21Q' then
call SuijiMode_DarkSeerWallEffect(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY)
return true
endif
if suijiMulticastSpecialSkill=='A0DH' or suijiMulticastSpecialSkill=='A1OB' then
call SuijiMode_EchoSlamMulticastExtra(suijiMulticastSpecialCaster,suijiMulticastSpecialSkill)
return true
endif
if suijiMulticastSpecialSkill=='A06R' or suijiMulticastSpecialSkill=='A1B4' then
call SuijiMode_SandKingEpicenterExtra(suijiMulticastSpecialCaster,suijiMulticastSpecialSkill)
return true
endif
if suijiMulticastSpecialSkill=='A29J' or suijiMulticastSpecialSkill=='A1MP' then
call SuijiMode_NevermoreRequiemMulticastExtra(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A03O' or suijiMulticastSpecialSkill=='A3K8' then
call SuijiMode_StartChaosPhantasmImages(suijiMulticastSpecialCaster,suijiMulticastSpecialSkill,false)
return true
endif
if suijiMulticastSpecialSkill=='A063' or suijiMulticastSpecialSkill=='A4NS' then
call SuijiMode_NagaMirrorMulticastExtra(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A0A5' or suijiMulticastSpecialSkill=='A2SO' then
call SuijiMode_BeastmasterMulticastExtraBear(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A0OO' then
call SuijiMode_BeastmasterCallWildMulticastExtra(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A06I' or suijiMulticastSpecialSkill=='A2S1' then
call SuijiMode_MeatHookStart(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY,suijiMulticastSpecialSkill)
return true
endif
if suijiMulticastSpecialSkill=='A03D' or suijiMulticastSpecialSkill=='X03D' or suijiMulticastSpecialSkill=='X13D' then
call SuijiMode_LycanWolvesMulticastExtra(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A0G8' then
call SuijiMode_MorphlingMulticastExtraReplicate(suijiMulticastSpecialCaster,suijiMulticastSpecialTarget)
return true
endif
if suijiMulticastSpecialSkill=='A0H4' then
call TerrorbladeConjureImage_Create(suijiMulticastSpecialCaster)
return true
endif
if suijiMulticastSpecialSkill=='A1A8' then
call ElderTitanAncestralSpirit_Create(suijiMulticastSpecialCaster,suijiMulticastSpecialX,suijiMulticastSpecialY,false)
return true
endif
if suijiMulticastSpecialSkill=='A00P' or suijiMulticastSpecialSkill=='X00P' or suijiMulticastSpecialSkill=='X10P' then
call SuijiMode_RhastaAerialShackleMulticastRepeat(suijiMulticastSpecialCaster,suijiMulticastSpecialTarget,suijiMulticastSpecialSkill)
return true
endif
if suijiMulticastSpecialSkill=='A04Y' then
call SuijiMode_RhastaMulticastShackleRepeat(suijiMulticastSpecialCaster,suijiMulticastSpecialTarget)
return true
endif
return false
endfunction
function SuijiMode_MulticastCheckedRepeat takes unit u,widget target,integer physicalSkill,integer pointOrder,real x,real y returns boolean
local ability abil=null
local real cooldown=0.
local real maxCooldown=0.
local boolean hadCooldown=false
local boolean result=false
if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return false
endif
set abil=EXGetUnitAbility(u,physicalSkill)
if abil==null then
return false
endif
set cooldown=B582_GetAbilityCooldown(u,physicalSkill)
set maxCooldown=MHAbility_GetMaxCooldown(u,physicalSkill)
if cooldown>.01 then
set hadCooldown=true
endif
if pointOrder!=0 then
if hadCooldown then
call EXSetAbilityState(abil,1,0.)
call MHAbility_SetCooldown(u,physicalSkill,0.)
endif
set abil=null
set result=B947IssuePointOrderById("SuijiMode_MulticastCheckedRepeat @ war3map.j:195576 (B968)",u,pointOrder,x,y)
else
set abil=null
set result=MHAbility_CastEx(u,target,x,y,physicalSkill)
endif
if hadCooldown and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
set abil=EXGetUnitAbility(u,physicalSkill)
if abil!=null then
call EXSetAbilityState(abil,1,cooldown)
if maxCooldown>.01 then
call MHAbility_SetCooldownEx(u,physicalSkill,cooldown,maxCooldown)
else
call MHAbility_SetCooldown(u,physicalSkill,cooldown)
endif
endif
endif
set abil=null
set target=null
set u=null
return result
endfunction
function SuijiMode_MulticastWatchLifetime takes integer unitHandle,integer delta returns nothing
local integer count=0
if unitHandle==0 then
return
endif
set count=LoadInteger(L7,unitHandle,StringHash("SuijiMulticastLifetimeWatch"))+delta
if count>0 then
call SaveInteger(L7,unitHandle,StringHash("SuijiMulticastLifetimeWatch"),count)
else
call RemoveSavedInteger(L7,unitHandle,StringHash("SuijiMulticastLifetimeWatch"))
call RemoveSavedInteger(L7,unitHandle,StringHash("SuijiMulticastLifetimeSerial"))
endif
endfunction
function SuijiMode_MulticastInvalidateDeadUnit takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer h=0
if u!=null then
set h=GetHandleId(u)
if LoadInteger(L7,h,StringHash("SuijiMulticastLifetimeWatch"))>0 then
call SaveInteger(L7,h,StringHash("SuijiMulticastLifetimeSerial"),LoadInteger(L7,h,StringHash("SuijiMulticastLifetimeSerial"))+1)
endif
endif
set u=null
return false
endfunction
function SuijiMode_MulticastDestroyRepeatTimer takes timer t returns nothing
local integer h=0
local integer casterHandle=0
local integer targetHandle=0
local group suijiMulticastDistinctGroup=null
if t==null then
return
endif
set h=GetHandleId(t)
set casterHandle=LoadInteger(L7,h,10)
set targetHandle=LoadInteger(L7,h,12)
set suijiMulticastDistinctGroup=LoadGroupHandle(L7,h,18)
call SuijiMode_MulticastWatchLifetime(casterHandle,-1)
if targetHandle!=casterHandle then
call SuijiMode_MulticastWatchLifetime(targetHandle,-1)
endif
if suijiMulticastDistinctGroup!=null then
call DestroyGroup(suijiMulticastDistinctGroup)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set suijiMulticastDistinctGroup=null
endfunction
function SuijiMode_MulticastRepeat takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local integer casterHandle=LoadInteger(L7,h,10)
local integer casterSerial=LoadInteger(L7,h,11)
local integer targetHandle=LoadInteger(L7,h,12)
local integer targetSerial=LoadInteger(L7,h,13)
local integer casterPid=LoadInteger(L7,h,14)
local integer targetPid=LoadInteger(L7,h,16)
local unit u=LoadUnitHandle(L7,h,0)
local widget target=LoadWidgetHandle(L7,h,1)
local integer skill=LoadInteger(L7,h,2)
local integer physicalSkill=LoadInteger(L7,h,7)
local real x=LoadReal(L7,h,3)
local real y=LoadReal(L7,h,4)
local integer left=LoadInteger(L7,h,5)
local unit targetUnit=LoadUnitHandle(L7,h,6)
local integer suijiMulticastRepeatPointOrder=0
local boolean suijiMulticastRepeatSucceeded=false
local boolean suijiMulticastDistinctCanRepeat=true
local boolean suijiMulticastUsesDistinctTargets=LoadBoolean(L7,h,19)
local group suijiMulticastDistinctGroup=LoadGroupHandle(L7,h,18)
// A dead unit may be removed before this delayed callback runs.  Querying that
// non-null but stale handle through GetUnitTypeId/UnitAlive can crash Game.dll.
// Reject dead/revived or replaced units through integer lifecycle state first;
// no unit native is allowed before these guards finish.
if left<=0 or u==null or casterHandle==0 then
call SuijiMode_MulticastDestroyRepeatTimer(t)
elseif LoadInteger(L7,casterHandle,StringHash("SuijiMulticastLifetimeSerial"))!=casterSerial then
call SuijiMode_MulticastDestroyRepeatTimer(t)
elseif LoadBoolean(L7,h,15) and M7[casterPid]!=u then
call SuijiMode_MulticastDestroyRepeatTimer(t)
elseif targetHandle!=0 and (targetUnit==null or LoadInteger(L7,targetHandle,StringHash("SuijiMulticastLifetimeSerial"))!=targetSerial or (LoadBoolean(L7,h,17) and M7[targetPid]!=targetUnit)) then
call SuijiMode_MulticastDestroyRepeatTimer(t)
// Script-owned safe repeats do not cast the physical ability.  In particular,
// native Meat Hook may transition between A06I/A2S1 while its bounded repeat
// timer is pending.  Rejecting the repeat on a stale physical rawcode canceled
// both the extra hook and the text that is shown only after the first success.
elseif GetUnitTypeId(u)==0 or UnitAlive(u)==false or (SuijiMode_MulticastHasSafeEffectRepeat(skill)==false and GetUnitAbilityLevel(u,physicalSkill)<=0) then
call SuijiMode_MulticastDestroyRepeatTimer(t)
elseif targetUnit!=null and (GetUnitTypeId(targetUnit)==0 or UnitAlive(targetUnit)==false) then
call SuijiMode_MulticastDestroyRepeatTimer(t)
else
if suijiMulticastUsesDistinctTargets then
set targetUnit=SuijiMode_MulticastPickDistinctTarget(u,skill,suijiMulticastDistinctGroup)
if targetUnit==null then
set suijiMulticastDistinctCanRepeat=false
else
set target=targetUnit
set x=GetUnitX(targetUnit)
set y=GetUnitY(targetUnit)
endif
elseif targetUnit!=null then
set x=GetUnitX(targetUnit)
set y=GetUnitY(targetUnit)
endif
if suijiMulticastDistinctCanRepeat then
set casterHandle=GetHandleId(u)
call NS7(casterHandle,"SuijiMulticastCasting",true)
call NQ7(casterHandle,"SuijiMulticastBlockUntil",TimerGetElapsed(W)+.10)
set suijiMulticastRepeatPointOrder=SuijiMode_MulticastPointOrderId(skill)
if skill=='A0DH' or skill=='A1OB' then
set suijiMulticastRepeatSucceeded=SuijiMode_MulticastSpecialRepeat(u,targetUnit,skill,x,y)
else
set suijiMulticastRepeatSucceeded=SuijiMode_MulticastSpecialRepeat(u,targetUnit,skill,x,y)
if suijiMulticastRepeatSucceeded==false then
// CastEx restores the original multicast effect path. Snapshot and restore both cooldown
// representations after every extra cast so the repeated cast cannot clear the real cooldown.
set suijiMulticastRepeatSucceeded=SuijiMode_MulticastCheckedRepeat(u,target,physicalSkill,suijiMulticastRepeatPointOrder,x,y)
endif
endif
call NS7(casterHandle,"SuijiMulticastCasting",false)
if suijiMulticastRepeatSucceeded then
if LoadBoolean(L7,h,9)==false then
call SuijiMode_MulticastText(u,LoadInteger(L7,h,8))
call SaveBoolean(L7,h,9,true)
endif
set left=left-1
else
set left=0
endif
if left<=0 then
call SuijiMode_MulticastDestroyRepeatTimer(t)
else
call SaveInteger(L7,h,5,left)
endif
else
call SuijiMode_MulticastDestroyRepeatTimer(t)
endif
endif
set suijiMulticastDistinctGroup=null
set targetUnit=null
set target=null
set u=null
set t=null
endfunction
function SuijiMode_MulticastStart takes unit u,widget target,unit targetUnit,integer skill,real x,real y,integer left returns nothing
local timer t=null
local integer h=0
local integer casterHandle=0
local integer casterPid=0
local integer targetHandle=0
local integer targetPid=0
local unit suijiMulticastPreviousFilterCaster=null
local group suijiMulticastDistinctGroup=null
if left<=0 or u==null then
return
endif
if GetUnitTypeId(u)==0 or UnitAlive(u)==false then
return
endif
set skill=SuijiMode_MulticastCanonicalSkill(skill)
set t=CreateTimer()
set h=GetHandleId(t)
set casterHandle=GetHandleId(u)
set casterPid=GetPlayerId(GetOwningPlayer(u))
call SaveUnitHandle(L7,h,0,u)
call SaveWidgetHandle(L7,h,1,target)
call SaveInteger(L7,h,2,skill)
call SaveInteger(L7,h,7,SuijiMode_MulticastPhysicalSkill(u,skill))
call SaveReal(L7,h,3,x)
call SaveReal(L7,h,4,y)
call SaveInteger(L7,h,5,left)
call SaveUnitHandle(L7,h,6,targetUnit)
call SaveInteger(L7,h,8,left+1)
call SaveBoolean(L7,h,9,false)
call SaveInteger(L7,h,10,casterHandle)
call SaveInteger(L7,h,11,LoadInteger(L7,casterHandle,StringHash("SuijiMulticastLifetimeSerial")))
call SaveInteger(L7,h,14,casterPid)
call SaveBoolean(L7,h,15,M7[casterPid]==u)
call SuijiMode_MulticastWatchLifetime(casterHandle,1)
if targetUnit!=null and SuijiMode_MulticastUsesDistinctTargets(skill) then
set suijiMulticastDistinctGroup=CreateGroup()
set suijiMulticastPreviousFilterCaster=IN4
set IN4=u
call GroupEnumUnitsInRange(suijiMulticastDistinctGroup,x,y,450.,Condition(function AX7))
set IN4=suijiMulticastPreviousFilterCaster
call GroupRemoveUnit(suijiMulticastDistinctGroup,targetUnit)
call SaveGroupHandle(L7,h,18,suijiMulticastDistinctGroup)
call SaveBoolean(L7,h,19,true)
set target=null
set targetUnit=null
call RemoveSavedHandle(L7,h,1)
call RemoveSavedHandle(L7,h,6)
endif
if targetUnit!=null then
set targetHandle=GetHandleId(targetUnit)
set targetPid=GetPlayerId(GetOwningPlayer(targetUnit))
call SaveInteger(L7,h,12,targetHandle)
call SaveInteger(L7,h,13,LoadInteger(L7,targetHandle,StringHash("SuijiMulticastLifetimeSerial")))
call SaveInteger(L7,h,16,targetPid)
call SaveBoolean(L7,h,17,M7[targetPid]==targetUnit)
if targetHandle!=casterHandle then
call SuijiMode_MulticastWatchLifetime(targetHandle,1)
endif
endif
call TimerStart(t,SuijiMode_MulticastRepeatInterval(skill),true,function SuijiMode_MulticastRepeat)
set suijiMulticastDistinctGroup=null
set suijiMulticastPreviousFilterCaster=null
set t=null
endfunction
function SuijiMode_HasRandomMulticastSource takes unit suijiMulticastSourceUnit returns boolean
local integer suijiMulticastSourceHandle=0
if suijiMulticastSourceUnit==null or GetUnitTypeId(suijiMulticastSourceUnit)==0 then
return false
endif
set suijiMulticastSourceHandle=GetHandleId(suijiMulticastSourceUnit)
if suijiMulticastSourceUnit==ChaosObserverBoss and GetUnitTypeId(suijiMulticastSourceUnit)=='NB0S' then
return GetUnitAbilityLevel(suijiMulticastSourceUnit,'A9BM')>0
endif
if suijiMulticastSourceUnit==TianxingRedBoss and GetUnitTypeId(suijiMulticastSourceUnit)=='NTY1' then
return GetUnitAbilityLevel(suijiMulticastSourceUnit,'TRMC')>0
endif
if B287_GetUnitAbilityLevel(suijiMulticastSourceUnit,'A088')<=0 then
return false
endif
if GetUnitTypeId(suijiMulticastSourceUnit)=='Hmkg' or SuijiMode_GetStableHeroIndex(suijiMulticastSourceUnit)==18 then
return true
endif
if SUIJI_MODE and OO7(suijiMulticastSourceHandle,"SuijiDone") then
return OO7(suijiMulticastSourceHandle,"SuijiMulticast") or SuijiMode_HasRandomSkill(suijiMulticastSourceUnit,'A088')
endif
return false
endfunction
function IFG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'h0H8',GetUnitX(ZX7),GetUnitY(ZX7),0)
local integer multicastCount=1
local integer casterHandle=GetHandleId(ZX7)
// B772: Blade Fury used to enter the generic CastEx repeat path.  Every repeat
// created another five-second 0.05 controller, dummy and range scan.  Roll once
// on the real effect and merge the result into this one bounded controller.
if SuijiMode_HasRandomMulticastSource(ZX7) and OO7(casterHandle,"SuijiMulticastCasting")==false and ON7(casterHandle,"SuijiMulticastBlockUntil")<=TimerGetElapsed(W) then
set multicastCount=EUD(ZX7)
if multicastCount<1 then
set multicastCount=1
elseif multicastCount>1 then
call SuijiMode_MulticastText(ZX7,multicastCount)
endif
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A05G')==false then
call XF7(ZX7,'A4I5')
endif
// Separate this lifetime from Rage/Life Break/Skewer's shared A0ST cleanup.
call NP7(casterHandle,"B845BladeFuryOwners",OM7(casterHandle,"B845BladeFuryOwners")+1)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'ZBFI',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'ZBFB',false)
call XF7(ZX7,'ZBFB')
call SetUnitPathing(BB7,false)
call SetUnitTimeScale(BB7,1.5)
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function IEG))
call SaveUnitHandle(L7,I97,2,ZX7)
call SaveUnitHandle(L7,I97,3,BB7)
call SaveInteger(L7,I97,5,B287_GetUnitAbilityLevel(ZX7,'A05G'))
call SaveInteger(L7,I97,10,multicastCount)
call TriggerEvaluate(t)
call O37(ZX7,"BladeFury|Active",5)
set t=null
set ZX7=null
set BB7=null
endfunction
//剑刃风暴
function IGG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A05G' then
call IFG()
endif
return false
endfunction
function FJ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function IGG))
call MHAbility_SetHookOrder('A05G',852128)
set t=null
endfunction
function SuijiMode_RestoreLifeDrainMulticast takes unit u,integer serial returns nothing
local integer h=0
local integer savedSerial=0
local integer skill=0
local integer physicalSkill=0
local integer level=0
local real dataA=0.
local real dataB=0.
local real dataD=0.
local real dataE=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if LoadBoolean(L7,h,StringHash("SuijiLifeDrainMulticastActive"))==false then
return
endif
set savedSerial=LoadInteger(L7,h,StringHash("SuijiLifeDrainMulticastSerial"))
if serial>0 and serial!=savedSerial then
return
endif
set skill=LoadInteger(L7,h,StringHash("SuijiLifeDrainMulticastSkill"))
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
set level=LoadInteger(L7,h,StringHash("SuijiLifeDrainMulticastLevel"))
set dataA=LoadReal(L7,h,StringHash("SuijiLifeDrainOriginalDataA"))
set dataB=LoadReal(L7,h,StringHash("SuijiLifeDrainOriginalDataB"))
set dataD=LoadReal(L7,h,StringHash("SuijiLifeDrainOriginalDataD"))
set dataE=LoadReal(L7,h,StringHash("SuijiLifeDrainOriginalDataE"))
if GetUnitTypeId(u)!=0 and skill!=0 and level>0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
if skill=='A02N' then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,109,dataB)
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,112,dataE)
elseif skill=='A04L' then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,108,dataA)
else
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,108,dataA)
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,111,dataD)
endif
endif
call SaveBoolean(L7,h,StringHash("SuijiLifeDrainMulticastActive"),false)
call SaveInteger(L7,h,StringHash("SuijiLifeDrainMulticastCount"),1)
endfunction
function SuijiMode_LifeDrainMulticastSafety takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit u=LoadUnitHandle(L7,h,0)
local integer serial=LoadInteger(L7,h,1)
call SuijiMode_RestoreLifeDrainMulticast(u,serial)
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function SuijiMode_PrepareLifeDrainMulticast takes unit u,integer skill returns nothing
local integer h=0
local integer level=0
local integer physicalSkill=0
local integer count=1
local integer serial=0
local real dataA=0.
local real dataB=0.
local real dataD=0.
local real dataE=0.
local timer t=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
set level=GetUnitAbilityLevel(u,physicalSkill)
call SuijiMode_RestoreLifeDrainMulticast(u,0)
set count=EUD(u)
if count<2 then
set count=1
endif
call SaveInteger(L7,h,StringHash("SuijiLifeDrainMulticastCount"),count)
call SaveInteger(L7,h,StringHash("SuijiLifeDrainMulticastSkill"),skill)
call SaveReal(L7,h,StringHash("SuijiLifeDrainMulticastUntil"),TimerGetElapsed(W)+12.)
if count<=1 or level<=0 then
return
endif
if skill=='A02N' then
set dataB=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,109)
set dataE=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,112)
elseif skill=='A04L' then
set dataA=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,108)
else
set dataA=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,108)
set dataD=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,111)
if dataA<=0. then
if skill=='A02Z' then
set dataA=9.*level+9.
else
set dataA=7.5*level+7.5
endif
endif
if dataD<=0. then
set dataD=dataA
endif
endif
set serial=LoadInteger(L7,h,StringHash("SuijiLifeDrainMulticastSerial"))+1
call SaveInteger(L7,h,StringHash("SuijiLifeDrainMulticastSerial"),serial)
call SaveInteger(L7,h,StringHash("SuijiLifeDrainMulticastLevel"),level)
call SaveReal(L7,h,StringHash("SuijiLifeDrainOriginalDataA"),dataA)
call SaveReal(L7,h,StringHash("SuijiLifeDrainOriginalDataB"),dataB)
call SaveReal(L7,h,StringHash("SuijiLifeDrainOriginalDataD"),dataD)
call SaveReal(L7,h,StringHash("SuijiLifeDrainOriginalDataE"),dataE)
call SaveBoolean(L7,h,StringHash("SuijiLifeDrainMulticastActive"),true)
if skill=='A02N' then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,109,dataB*count)
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,112,dataE*count)
elseif skill=='A04L' then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,108,dataA*count)
else
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,108,dataA*count)
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,111,dataD*count)
endif
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call TimerStart(t,11.,false,function SuijiMode_LifeDrainMulticastSafety)
set t=null
endfunction
function SuijiMode_LifeDrainMulticastOnEnd takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
if skill=='A0CC' or skill=='A02Z' or skill=='A02N' or skill=='A04L' then
if u!=null and ((skill!='A0CC' and skill!='A02Z') or GetUnitCurrentOrder(u)!=852487) then
call SuijiMode_RestoreLifeDrainMulticast(u,0)
endif
endif
set u=null
return false
endfunction
function SuijiMode_IsDurationMulticastSkill takes integer skill returns boolean
if skill=='A1YQ' then
return true
endif
if skill=='A054' or skill=='A00U' then
return true
endif
if skill=='A0QG' or skill=='A08I' or skill=='A083' or skill=='A08F' or skill=='A08G' or skill=='A01Z' or skill=='A08R' or skill=='A037' or skill=='A0R7' then
return true
endif
if skill=='A2IS' or skill=='A14I' or skill=='A0LC' or skill=='A4CB' or skill=='A1WH' or skill=='A1EJ' or skill=='A05C' or skill=='A030' or skill=='A19Z' or skill=='A1IN' then
return true
endif
if skill=='A0Q7' or skill=='A4J4' or skill=='A173' or skill=='A0O8' or skill=='A2XO' or skill=='A0S1' or skill=='A0NQ' or skill=='A034' or skill=='A0B4' then
return true
endif
if skill=='A0LH' or skill=='A2Z9' or skill=='A4F3' or skill=='A4F4' or skill=='A4F5' or skill=='A4FU' or skill=='A0EC' or skill=='A2WJ' or skill=='A2OI' or skill=='A0AS' then
return true
endif
if skill=='A03G' or skill=='ANcr' or skill=='A093' or skill=='X093' or skill=='X193' or skill=='A15J' or skill=='X15J' then
return true
endif
if skill=='A1RI' or skill=='A1TX' or skill=='X1WH' or skill=='A0MV' or skill=='A11T' or skill=='A4AS' then
return true
endif
if skill=='A2NE' or skill=='A3NE' or skill=='A03K' or skill=='A0MQ' or skill=='A1B6' or skill=='A130' then
return true
endif
return skill=='A00F' or skill=='A007' or skill=='A01T' or skill=='A011'
endfunction
function SuijiMode_IsTimedTransformDurationSkill takes integer skill returns boolean
if skill=='A03G' or skill=='ANcr' or skill=='A093' or skill=='X093' or skill=='X193' or skill=='A15J' or skill=='X15J' then
return true
endif
if skill=='A1RI' or skill=='A1TX' or skill=='A1WH' or skill=='X1WH' or skill=='A0MV' or skill=='A11T' or skill=='A4AS' then
return true
endif
return skill=='A19Z' or skill=='A2NE' or skill=='A3NE' or skill=='A03K' or skill=='A0MQ' or skill=='A1B6' or skill=='A130'
endfunction
function SuijiMode_RestoreTransformDurationData takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit u=LoadUnitHandle(L7,h,0)
local integer skill=LoadInteger(L7,h,1)
local integer level=LoadInteger(L7,h,2)
if u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,skill)>0 then
call YDWESetUnitAbilityDataReal(u,skill,level,ABILITY_DATA_DUR,LoadReal(L7,h,3))
call YDWESetUnitAbilityDataReal(u,skill,level,ABILITY_DATA_HERODUR,LoadReal(L7,h,4))
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function SuijiMode_PrepareTransformDurationMulticast takes unit u,integer skill,integer count returns nothing
local integer level=0
local integer physicalSkill=0
local real duration=0.
local real heroDuration=0.
local timer t=null
local integer h=0
if u==null or count<=1 or SuijiMode_IsTimedTransformDurationSkill(skill)==false then
return
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
// Y0HB's finite duration and Scepter toggle are script-owned. Never rewrite
// its ANcl duration fields or create a delayed metadata restore for this cast.
if physicalSkill=='Y0HB' then
return
endif
set level=GetUnitAbilityLevel(u,physicalSkill)
if level<=0 then
return
endif
set duration=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,ABILITY_DATA_DUR)
set heroDuration=YDWEGetUnitAbilityDataReal(u,physicalSkill,level,ABILITY_DATA_HERODUR)
if duration>0. and duration<1000. then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,ABILITY_DATA_DUR,duration*count)
endif
if heroDuration>0. and heroDuration<1000. then
call YDWESetUnitAbilityDataReal(u,physicalSkill,level,ABILITY_DATA_HERODUR,heroDuration*count)
endif
if (duration>0. and duration<1000.) or (heroDuration>0. and heroDuration<1000.) then
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,u)
call SaveInteger(L7,h,1,physicalSkill)
call SaveInteger(L7,h,2,level)
call SaveReal(L7,h,3,duration)
call SaveReal(L7,h,4,heroDuration)
call TimerStart(t,2.,false,function SuijiMode_RestoreTransformDurationData)
set t=null
endif
endfunction
function SuijiMode_DurationMulticastOnCast takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer h=0
local integer skill=B287_GetSpellAbilityId()
local integer count=1
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
set u=null
return false
endif
if SuijiMode_HasRandomMulticastSource(u)==false then
set u=null
return false
endif
if GetSpellTargetItem()!=null or GetSpellTargetDestructable()!=null then
set u=null
return false
endif
set h=GetHandleId(u)
if OO7(h,"SuijiMulticastCasting") or ON7(h,"SuijiMulticastBlockUntil")>TimerGetElapsed(W) then
set u=null
return false
endif
set skill=SuijiMode_MulticastCanonicalSkill(skill)
if skill=='A0CC' or skill=='A02Z' or skill=='A02N' or skill=='A04L' then
call SuijiMode_PrepareLifeDrainMulticast(u,skill)
set u=null
return false
endif
if skill=='A1PH' or skill=='A4L2' or skill=='A4L3' or skill=='A4L4' or skill=='A4L5' or skill=='A4L6' then
set count=EUD(u)
if count<2 then
set count=1
endif
call SaveInteger(L7,h,StringHash("SuijiSpiritSiphonCount"),count)
call SaveReal(L7,h,StringHash("SuijiSpiritSiphonUntil"),TimerGetElapsed(W)+2.)
set u=null
return false
endif
if SuijiMode_IsDurationMulticastSkill(skill)==false then
set u=null
return false
endif
set count=EUD(u)
if B287_GetPhysicalAbilityId(u,skill)=='Y0HB' and SuijiMode_ScepterRegistryIsActive(u,'A2NE') then
// An indefinite toggle is one state transition, never repeated by Multicast.
set count=1
endif
if count<2 then
set count=1
endif
call SaveInteger(L7,h,StringHash("SuijiDurationMulticastSkill"),skill)
call SaveInteger(L7,h,StringHash("SuijiDurationMulticastCount"),count)
call SaveReal(L7,h,StringHash("SuijiDurationMulticastUntil"),TimerGetElapsed(W)+4.)
call SuijiMode_PrepareTransformDurationMulticast(u,skill,count)
set u=null
return false
endfunction
function SuijiMode_ApplyNativeDurationMulticast takes unit u,unit target,integer skill,integer count returns nothing
local integer level=B287_GetUnitAbilityLevel(u,skill)
local real duration=0.
if count<=1 then
return
endif
if B287_GetPhysicalAbilityId(u,skill)=='Y0HB' then
// The carrier lifecycle already applies the duration multiplier and has no
// native transformation buff for the retry timer to extend.
return
endif
if target==null then
set target=u
endif
if skill=='A01Z' then
set duration=15.*level*count
call SuijiMode_ScheduleDurationBuff(target,'B021',0,duration)
elseif skill=='A0LC' or skill=='A4CB' then
call SuijiMode_ScheduleDurationBuff(target,'B02H',0,7.*count)
call SuijiMode_ScheduleDurationBuff(target,'BEia',0,7.*count)
elseif skill=='A1WH' then
call SuijiMode_ScheduleDurationBuff(target,'B0DP',0,25.*count)
elseif skill=='X1WH' then
call SuijiMode_ScheduleDurationBuff(target,'B0DP',0,25.*count)
elseif skill=='A03G' then
if level==1 then
call SuijiMode_ScheduleDurationBuff(target,'B00Y',0,40.*count)
elseif level==2 then
call SuijiMode_ScheduleDurationBuff(target,'B00Z',0,40.*count)
else
call SuijiMode_ScheduleDurationBuff(target,'B010',0,40.*count)
endif
elseif skill=='A093' or skill=='X093' or skill=='X193' then
call SuijiMode_ScheduleDurationBuff(target,'B000',0,20.*count)
elseif skill=='A15J' or skill=='X15J' then
call SuijiMode_ScheduleDurationBuff(target,'B0AH',0,30.*count)
elseif skill=='A1RI' then
call SuijiMode_ScheduleDurationBuff(target,'BEme',0,30.*count)
elseif skill=='A1TX' then
call SuijiMode_ScheduleDurationBuff(target,'B0DJ',0,15.*count)
elseif skill=='A11T' or skill=='A4AS' then
if level<3 then
if level==1 and SuijiMode_ScepterRegistryIsActive(u,'A11T')==false then
set duration=30.*count
else
set duration=40.*count
endif
call SuijiMode_ScheduleDurationBuff(target,'B0AA',0,duration)
endif
elseif skill=='A19Z' then
call SuijiMode_ScheduleDurationBuff(target,'B0BG',0,18.*count)
elseif skill=='A2NE' or skill=='A3NE' then
call SuijiMode_ScheduleDurationBuff(target,'B0G9','B1G9',6.*count)
elseif skill=='A03K' then
call SuijiMode_ScheduleDurationBuff(target,'B0JX',0,30.*count)
elseif skill=='A130' then
call SuijiMode_ScheduleDurationBuff(target,'B09Z',0,(2.+.75*level)*count)
elseif skill=='A05C' then
call SuijiMode_ScheduleDurationBuff(target,'B013',0,12.*count)
elseif skill=='A030' then
set duration=(2.+2.*level)*count
call SuijiMode_ScheduleDurationBuff(target,'B00S',0,duration)
elseif skill=='A034' then
if IsUnitType(target,UNIT_TYPE_HERO) then
set duration=25.*count
else
set duration=120.*count
endif
call SuijiMode_ScheduleDurationBuff(target,'B00T',0,duration)
elseif skill=='A0B4' then
call SuijiMode_ScheduleDurationBuff(target,'B00L',0,30.*count)
elseif skill=='A0EC' then
call SuijiMode_ScheduleDurationBuff(target,'B0KX',0,8.*count)
endif
set target=null
endfunction
function SuijiMode_MulticastOnSpell takes nothing returns boolean
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local boolean b1060ReturnValue
local unit u=GetTriggerUnit()
local integer h=0
local integer skill=B287_GetSpellAbilityId()
local integer r=0
local unit targetUnit=null
local widget target=null
local real x=0.
local real y=0.
if SUIJI_MODE==false or u==null then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if GetUnitTypeId(u)==0 or UnitAlive(u)==false then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
// Dedicated TP, Travel Boots 1 and Travel Boots 2 share A4T0. Exclude the
// carrier before multicast source inspection or rolls can schedule an order
// that interrupts its protected channel.
if skill=='A4T0' then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
set h=GetHandleId(u)
if SuijiMode_HasRandomMulticastSource(u)==false then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if OO7(h,"SuijiMulticastCasting") or ON7(h,"SuijiMulticastBlockUntil")>TimerGetElapsed(W) then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if GetSpellTargetItem()!=null or GetSpellTargetDestructable()!=null then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
set skill=SuijiMode_MulticastCanonicalSkill(skill)
// Summon Familiars owns one replacement lifecycle.  A1NE, A2IG and their
// fixed OMG clones all canonicalize to A1NE, so reject the family before any
// Multicast roll can schedule additional physical or scripted casts.
if skill=='A1NE' then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
// B772: IFG owns Blade Fury's Multicast roll and folds the count into one
// five-second damage controller.  Never schedule generic CastEx repeats here.
if skill=='A05G' then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
// Meat Hook used to depend on the engine-swapped A2S1 button.  Canonicalize it
// before the generic source-item/physical-button checks so native Pudge and an
// OMG copied hook share the same bounded scripted repeat path.
if skill=='A06I' or skill=='A2S1' then
set r=EUD(u)
if r>1 then
set x=b1060GetSpellTargetX
set y=b1060GetSpellTargetY
if x==0. and y==0. then
set x=GetUnitX(u)
set y=GetUnitY(u)
endif
call SuijiMode_MulticastStart(u,null,null,'A06I',x,y,r-1)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
// Ravage rolls multicast inside XGF and merges it into one radial controller.
// A generic repeat cast would duplicate all 16 scan waves and every lift timer.
if skill=='A29I' or skill=='A2UL' then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
// Persistent/global scripted ultimates merge multicast into one bounded effect.
// Do not issue repeat orders here: Static Storm would otherwise multiply timers,
// dummy units, range enumerations and issued-order callbacks in AI-heavy games.
if skill=='A1U6' or skill=='A2UO' then
if ON7(h,"SuijiStaticStormMulticastRollUntil")>TimerGetElapsed(W) then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
call NQ7(h,"SuijiStaticStormMulticastRollUntil",TimerGetElapsed(W)+.20)
set r=EUD(u)
if r<1 then
set r=1
endif
call NP7(h,"SuijiStaticStormMulticastCount",r)
call NQ7(h,"SuijiStaticStormMulticastUntil",TimerGetElapsed(W)+8.)
if r>1 then
call SuijiMode_MulticastText(u,r)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if skill=='A0LT' or skill=='A1CS' then
if ON7(h,"SuijiChenHandMulticastRollUntil")>TimerGetElapsed(W) then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
call NQ7(h,"SuijiChenHandMulticastRollUntil",TimerGetElapsed(W)+.20)
set r=EUD(u)
if r<1 then
set r=1
endif
if r>1 then
call SuijiMode_MulticastText(u,r)
call ChenHandMulticastExtra(u,r-1)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if skill=='A0CC' or skill=='A02Z' or skill=='A02N' or skill=='A04L' then
set r=LoadInteger(L7,h,StringHash("SuijiLifeDrainMulticastCount"))
if LoadReal(L7,h,StringHash("SuijiLifeDrainMulticastUntil"))<TimerGetElapsed(W) then
set r=1
endif
if r>1 then
call SuijiMode_MulticastText(u,r)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if skill=='A1PH' or skill=='A4L2' or skill=='A4L3' or skill=='A4L4' or skill=='A4L5' or skill=='A4L6' then
set r=LoadInteger(L7,h,StringHash("SuijiSpiritSiphonCount"))
if LoadReal(L7,h,StringHash("SuijiSpiritSiphonUntil"))<TimerGetElapsed(W) then
set r=1
endif
if r>1 then
call SuijiMode_MulticastText(u,r)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if SuijiMode_IsDurationMulticastSkill(skill) then
set r=SuijiMode_GetDurationMulticastCount(u,skill)
if r>1 then
call SuijiMode_MulticastText(u,r)
call SuijiMode_ApplyNativeDurationMulticast(u,b1060GetSpellTargetUnit,skill,r)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if skill=='A12K' then
set r=EUD(u)
if r<1 then
set r=1
endif
call SaveInteger(L7,h,StringHash("SuijiPowershotMulticastCount"),r)
call SaveReal(L7,h,StringHash("SuijiPowershotMulticastUntil"),TimerGetElapsed(W)+8.)
if r>1 then
call SuijiMode_MulticastText(u,r)
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if B290_IsDisplacementSkill(skill) then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if SuijiMode_MulticastAllowedSkill(u,skill)==false then
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
set r=EUD(u)
if r>1 then
if skill=='A0DH' or skill=='A1OB' then
call SuijiMode_StartEchoMulticastCooldownGuard(u,skill)
endif
set targetUnit=b1060GetSpellTargetUnit
if targetUnit!=null then
set target=targetUnit
set x=GetUnitX(targetUnit)
set y=GetUnitY(targetUnit)
else
set x=b1060GetSpellTargetX
set y=b1060GetSpellTargetY
if x==0. and y==0. then
set target=u
set x=GetUnitX(u)
set y=GetUnitY(u)
endif
endif
call SuijiMode_MulticastStart(u,target,targetUnit,skill,x,y,r-1)
endif
set target=null
set targetUnit=null
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function B290_DisplacementMulticastOnCast takes nothing returns boolean
return false
endfunction
function SuijiMode_MulticastInit takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SuijiMode_MulticastInvalidateDeadUnit))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function SuijiMode_DurationMulticastOnCast))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function SuijiMode_LifeDrainMulticastOnEnd))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiMode_MulticastOnSpell))
set t=null
endfunction
function SuijiMode_InitRegisteredSkillTriggers takes integer skill returns nothing
local integer i=1
local integer k=1
if skill==0 then
return
endif
loop
exitwhen i>115
set k=1
loop
exitwhen k>10
if LoadInteger(MSK,i,k)==skill then
call SuijiMode_InitHeroTriggers(i)
set k=10
endif
set k=k+1
endloop
set i=i+1
endloop
endfunction
function SuijiMode_InitSkillTriggers takes integer source,integer skill returns nothing
// Tempest's listener also needs to exist when no native Arc Warden was selected.
// PN8 owns the once-only guard independently of the hero-family initialization flags.
if skill=='A2M0' then
call PN8()
endif
call SuijiMode_InitHeroTriggers(source)
call SuijiMode_InitRegisteredSkillTriggers(skill)
if source==51 and (skill=='A07F' or skill=='A08R' or skill=='A053' or skill=='A05T' or skill=='A08H') then
call SuijiMode_InitHeroTriggers(102)
endif
endfunction
function SuijiMode_NotifyPickedSkill takes unit u,integer skill,string kind,string action returns nothing
local player p=null
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return
endif
set p=GetOwningPlayer(u)
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFF00FF00随机OMG：|r"+Q[GetPlayerId(p)]+KZ4[GetPlayerId(p)]+"|r 的 "+GetUnitName(u)+" "+action+kind+" |cFFFFCC00"+GetAbilityName(skill)+"|r")
set p=null
endfunction
function SuijiMode_AddSkill takes unit u,integer skill,integer helper,string order,integer level,integer source,string mark returns integer
local player p=null
local integer h=0
local integer logicalSkill=SuijiMode_ToOriginalSkill(skill)
local integer physicalSkill=0
local boolean combatGate994=false
if logicalSkill==0 then
call SuijiTest_DebugUnit(u,"ADD0","AddSkill收到skill=0，返回")
return 0
endif
if SuijiMode_IsRandomPoolExcludedSkill(logicalSkill) then
call SuijiTest_DebugUnit(u,"ADD0","拒绝已移出随机池的技能 skill="+GetAbilityName(logicalSkill))
return 0
endif
if mark=="SuijiSmall" and SuijiMode_IsUltimateOnlySkill(logicalSkill) then
call SuijiTest_DebugUnit(u,"ADD0","拒绝把大招加入小技能槽 skill="+GetAbilityName(logicalSkill))
return 0
endif
if u==null or GetUnitTypeId(u)==0 then
call SuijiTest_DebugUnit(u,"ADD0","AddSkill收到无效单位，返回")
return 0
endif
if SuijiMode_IsAIRandomSkillBlocked(u,logicalSkill) then
call SuijiTest_DebugUnit(u,"ADD0","拒绝AI潮汐猎人获得随机多重施法")
return 0
endif
set order=SuijiMode_RandomOrder(logicalSkill,order)
set combatGate994=B994UsesCombatGate(logicalSkill,order)
set order=SuijiMode_ResolveAlternateCarrierOrder(u,logicalSkill,order)
// Random Reincarnation uses an active-class physical button only to obtain
// Warcraft's native cooldown overlay. Keep its OMG/AI order passive; the
// physical reincarnation order is separately swallowed at SPELL_CHANNEL.
if logicalSkill=='A01Y' or logicalSkill=='A4KM' then
set order="passive"
endif
if SuijiMode_IsNativeRegisteredSkill(u,logicalSkill) or SuijiMode_IsNativeRegisteredSkill(u,helper) then
call SuijiTest_DebugUnit(u,"ADD0","AddSkill收到本英雄原生技能，返回 skill="+GetAbilityName(logicalSkill))
return 0
endif
if helper==0 and SuijiMode_CanSkipHelper(logicalSkill)==false then
call SuijiTest_DebugUnit(u,"ADD0","AddSkill helper=0且不可跳过，返回 skill="+GetAbilityName(logicalSkill))
return 0
endif
if logicalSkill=='A0MP' and mark=="SuijiSmall" then
set level=IMinBJ(5,IMaxBJ(1,GetHeroLevel(u)/4+1))
endif
set physicalSkill=SuijiMode_GetCarrierGrantSkill(logicalSkill,order)
call SuijiTest_DebugUnit(u,"ADD0","AddSkill开始 skill="+GetAbilityName(logicalSkill)+" ability="+GetAbilityName(physicalSkill)+" helper="+I2S(helper)+" source="+I2S(source)+" mark="+mark)
set p=GetOwningPlayer(u)
set h=GetHandleId(u)
if SuijiMode_EnsureExactLiveAbility(u,physicalSkill,true)==false then
call SuijiTest_DebugUnit(u,"ADD0","物理技能原生添加失败，返回 skill="+GetAbilityName(logicalSkill))
set p=null
return 0
endif
if SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,level)==false then
call SuijiTest_DebugUnit(u,"ADD0","物理技能等级同步失败，返回 skill="+GetAbilityName(logicalSkill))
set p=null
return 0
endif
set level=GetUnitAbilityLevel(u,physicalSkill)
call SuijiMode_InitCopiedSkill(u,logicalSkill,level)
if SuijiMode_HasNativeAbility(u,physicalSkill)==false or GetUnitAbilityLevel(u,physicalSkill)!=level then
call SuijiTest_DebugUnit(u,"ADD0","初始化后原生技能复核失败，返回 skill="+GetAbilityName(logicalSkill))
set p=null
return 0
endif
if SuijiMode_IsUnifiedOrbSkill(logicalSkill) and physicalSkill!=logicalSkill and SuijiMode_IsNativeRegisteredSkill(u,logicalSkill)==false then
call UnitRemoveAbility(u,logicalSkill)
endif
call SetPlayerAbilityAvailable(p,physicalSkill,true)
call SuijiMode_InitSkillTriggers(source,logicalSkill)
call SuijiMode_InitUnitSource(u,source)
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,logicalSkill)
call NP7(h,mark+"Skill",logicalSkill)
call NP7(h,mark+"Ability",physicalSkill)
// Pool helper ids are ownership/conflict markers only.  They have no ability
// object and must never be added, removed, availability-written, or live-checked.
call NP7(h,mark+"Helper",helper)
call NP7(h,mark+"Source",source)
call NP7(h,mark+"SourceType",K34[source])
call NR7(h,mark+"Order",order)
if mark=="SuijiUlt" and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
if combatGate994 or order=="channel" then
call SaveInteger(L7,h,StringHash("B992ChannelUlt"),logicalSkill)
else
call RemoveSavedInteger(L7,h,StringHash("B992ChannelUlt"))
endif
endif
call SuijiMode_ApplyHotkey(u,physicalSkill,mark,order)
call SuijiMode_SyncOwnedChargeButtonSlot(u,logicalSkill,mark)
if SuijiMode_IsUnifiedOrbSkill(logicalSkill) then
call SuijiMode_ForcePassiveOrbs(u)
endif
call SuijiMode_CopyDruidPassivesToBear(u)
call SuijiMode_MarkUnitVisibilityDirty(u)
call NS7(h,"SuijiAghForceUpdate",true)
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_UpdateArcaneBlinkRandomCastpoints(u)
call SuijiTest_DebugUnit(u,"ADD1","AddSkill完成 skill="+GetAbilityName(logicalSkill)+" ability="+GetAbilityName(physicalSkill)+" mark="+mark)
set p=null
return logicalSkill
endfunction
function SuijiTest_AddPresetSkill takes unit u,integer skill,integer level,string mark returns integer
local integer idx=KL4
local integer helper=0
local string order=""
local boolean found=false
local boolean test11Fury1058=mark=="SuijiUlt" and skill=='A2UE' and GetUnitTypeId(u)=='H0DO' and SuijiTest_PresetUlt(GetPlayerId(GetOwningPlayer(u)))=='A2UE'
// A1SA is the zero-charge runtime face of Demonic Purge. The OMG ultimate
// pool is registered through A2ZU, so accept every visible family rawcode in
// -omgtest and normalize it to the pool entry before lookup.
if mark=="SuijiUlt" and (skill=='A1SA' or skill=='A2ZV' or skill=='A2ZW') then
set skill='A2ZU'
endif
loop
exitwhen idx>SUIJI_POOL_MAX
if (mark=="SuijiSmall" or test11Fury1058) and HM4[idx]==skill then
set helper=HR4[idx]
set order=HW4[idx]
set found=true
elseif (mark=="SuijiSmall" or test11Fury1058) and HN4[idx]==skill then
set helper=HS4[idx]
set order=HX4[idx]
set found=true
elseif (mark=="SuijiSmall" or test11Fury1058) and HO4[idx]==skill then
set helper=HT4[idx]
set order=HY4[idx]
set found=true
elseif mark=="SuijiUlt" and HP4[idx]==skill then
set helper=HU4[idx]
set order=HZ4[idx]
set found=true
elseif mark=="SuijiUlt" and HQ4[idx]==skill then
set helper=HV4[idx]
set order=HZ4[idx]
set found=true
endif
if found and (helper!=0 or SuijiMode_CanSkipHelper(skill)) then
return SuijiMode_AddSkill(u,skill,helper,order,level,SuijiMode_GetPoolSkillSource(idx,skill),mark)
endif
set helper=0
set order=""
set found=false
set idx=idx+1
endloop
if mark=="SuijiUlt" and skill=='A1YQ' then
return SuijiMode_AddSkill(u,skill,0,"berserk",level,50,mark)
endif
if mark=="SuijiUlt" and skill=='A0Z0' then
return SuijiMode_AddSkill(u,skill,0,OrderId2String($D0097),level,SuijiTest_FindHeroIndex('N0M7'),mark)
endif
return 0
endfunction
