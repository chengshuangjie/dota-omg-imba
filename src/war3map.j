function FQO takes unit u returns nothing
    local boolean array b
    local integer i= 1
       loop
           if IsUnitSelected(u, Player(i)) then
               set b[i]=true
           else
               set b[i]=false
           endif
           set i=i + 1
       exitwhen i > 12
       endloop
       call ShowUnit(u, false)
       call ShowUnit(u, true)
       set i=1
       loop
           if b[i] then
               call SelectUnitAddForPlayer(u, Player(i))
           endif
           set i=i + 1
       exitwhen i > 12
       endloop
   endfunction
function SDE takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 2)
	local unit d = LoadUnitHandle(TABLE_HY, h, 19)
	if GetUnitAbilityLevel(u,'A1HX') == 0 then
		call KillUnit(d)
		call SetUnitState(u, UNIT_STATE_TYPE, 2)
        call SaveInteger(L7,(GetHandleId((u))),((4421)),(2))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		call SetUnitX(d, GetUnitX(u))
		call SetUnitY(d, GetUnitY(u))
	endif
	set t = null
	set u = null
	set d = null
	return false
endfunction
function Add_XY_BUFF takes unit p5 returns nothing
local integer id=GetUnitTypeId(p5)
local integer passivetx
if id=='Z071' then
    set passivetx='X1I7'
else
    set passivetx='A1I7'
endif
call UnitRemoveAbility(p5,'A1IE')
call UnitRemoveAbility(p5,'A1IF')
call UnitRemoveAbility(p5,'A1IG')
call UnitRemoveAbility(p5,'B0C9')
if B287_GetUnitAbilityLevel(p5,'A1IN')==1 then
call XF7(p5,'A1IE')
    call XF7(p5,passivetx)
    call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I8')
call UnitMakeAbilityPermanent(p5,true,'A1IC')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1IE',false)
elseif B287_GetUnitAbilityLevel(p5,'A1IN')==2 then
call XF7(p5,'A1IF')
    call XF7(p5,passivetx)
    call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1I9')
call UnitMakeAbilityPermanent(p5,true,'A1ID')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1IF',false)
elseif B287_GetUnitAbilityLevel(p5,'A1IN')==3 then
call XF7(p5,'A1IG')
    call XF7(p5,passivetx)
    call UnitMakeAbilityPermanent(p5,true,passivetx)
call UnitMakeAbilityPermanent(p5,true,'A1IA')
call UnitMakeAbilityPermanent(p5,true,'A1IB')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1IG',false)
endif
endfunction
function SEE takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local unit d
	local integer level = B287_GetUnitAbilityLevel(u,'A1IN')
	local trigger t = CreateTrigger()
	local integer h = GetHandleId(t)
	local integer i = 4*SuijiMode_GetDurationMulticastCount(u,'A1IN')
    local integer id=GetUnitTypeId(u)
    local integer skilltx
    // Active expiry relies on RXE to withdraw regeneration in enemy vision.
    call RBE(u)
    if id=='Z071' then
        set skilltx='h1B1'
    else
        set skilltx='h0B1'
    endif
    set d = CreateUnit(GetOwningPlayer(u),skilltx, GetUnitX(u), GetUnitY(u), 0)
	call FQO(u)
	call Z67(u,'A1HW', 1, i)
	call Z67(u,'A1HX', 1, i)
    call Add_XY_BUFF(u)
    call SaveInteger(L7,(GetHandleId((u))),((4421)),(1))
	call SetUnitState(u, UNIT_STATE_TYPE, 0)
	call TriggerRegisterTimerEvent(t, .03, true)
	call TriggerAddCondition(t, Condition(function SDE))
	call SaveUnitHandle(TABLE_HY, h, 19,(d))
	call SaveUnitHandle(TABLE_HY, h, 2,(u))
	set u = null
	set d = null
	set t = null
endfunction
//暗影之舞
function SFE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1IN' then
call SEE()
endif
return false
endfunction
function NV8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SFE))
set t=null
endfunction
function SGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer SV9=GetTriggerEvalCount(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local lightning SHE=OH7(OB7,"Lightning")
local integer V77=OM7(OB7,"Level")
local real t5=ON7(OB7,"SourceX")
local real w5=ON7(OB7,"SourceY")
local real Y5=GetUnitX(m5)
local real Z5=GetUnitY(m5)
local real SIE
local real SJE
local real HTE=ON7(OB7,"LastX")
local real HUE=ON7(OB7,"LastY")
local real l4
local real BAD=KF7(HTE,HUE,Y5,Z5)
call NQ7(OB7,"LastX",Y5)
call NQ7(OB7,"LastY",Z5)
if BAD>100 or SV9>(3.5/ .03)or WF7(m5) then
call DestroyLightning(SHE)
call NM7(OB7)
call OZ7(t)
else
call MoveLightning(SHE,true,t5,w5,Y5,Z5)
if KF7(t5,w5,Y5,Z5)>325 then
set l4=Atan2(Z5-w5,Y5-t5)
set SIE=t5+(325)*Cos(l4)
set SJE=w5+(325)*Sin(l4)
call SetUnitX(m5,SIE)
call SetUnitY(m5,SJE)
endif
endif
set t=null
set p5=null
set m5=null
set SHE=null
return false
endfunction
function SKE takes unit ZX7,unit IH7,integer BC7 returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local lightning G7E=AddLightning("PONC",true,GetUnitX(ZX7),GetUnitY(ZX7),GetUnitX(IH7),GetUnitY(IH7))
call SetLightningColor(G7E,1,1,1,1)
call SaveLightningHandle(L7,(I97),StringHash("Lightning"),(G7E))
call NT7(I97,"Source",ZX7)
call NT7(I97,"Target",IH7)
call NP7(I97,"Level",BC7)
call NQ7(I97,"SourceX",GetUnitX(ZX7)*1.)
call NQ7(I97,"SourceY",GetUnitY(ZX7)*1.)
call NQ7(I97,"LastX",GetUnitX(IH7)*1.)
call NQ7(I97,"LastY",GetUnitY(IH7)*1.)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SGE))
call B67(ZX7,IH7,1,55*BC7)
call B947IssueTargetOrderById("SKE @ war3map.j:116674 (B968)",ZX7,$D000F,IH7)
set t=null
set G7E=null
endfunction
function SME takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local integer WF8=GetTriggerEvalCount(t)
local integer BC7=OM7(I97,"Level")
local unit ZX7=O77(I97,"Source")
local real SOE=ON7(I97,"Length")
local real d=ON7(I97,"Rate")
local real TA9=ON7(I97,"Angle")
local real PIE=ON7(I97,"SourceX")
local real PJE=ON7(I97,"SourceY")
local real Y_7=ON7(I97,"TargetX")
local real Z47=ON7(I97,"TargetY")
local real Z97=PIE+(30*(20+4*2)/d)*WF8*Cos(TA9*bj_DEGTORAD)
local real ZD7=PJE+(30*(20+4*2)/d)*WF8*Sin(TA9*bj_DEGTORAD)
local real SNE=SquareRoot((Z97-Y_7)*(Z97-Y_7)+(ZD7-Z47)*(ZD7-Z47))
local real SPE=175
local real SQE=(1-SNE/ SOE)*SPE*2
local group g=WS7()
local unit IH7
if WF8==1 then
call SetUnitAnimationByIndex(ZX7,5)
call SetUnitTimeScale(ZX7,1.5)
endif
if SQE>SPE then
call SetUnitAnimationByIndex(ZX7,5)
set SQE=SPE*2-SQE
endif
call SetUnitFlyHeight(ZX7,YK7(SQE,0),0)
if IsHideUnit(ZX7)==false then
    call SetUnitX(ZX7,X17(Z97))
    call SetUnitY(ZX7,X07(ZD7))
endif
call SetUnitFacing(ZX7,TA9)
set IN4=ZX7
call GroupEnumUnitsInRange(g,Z97,ZD7,153,Condition(function A37))
set IH7=FirstOfGroup(g)
call WR7(g)
if SNE<30 or IH7!=null or GetTriggerEvalCount(t)>75 or IsHideUnit(ZX7) then
call SetUnitFlyHeight(ZX7,0,0)
call SetUnitFacing(ZX7,TA9)
call SetUnitTimeScale(ZX7,1)
call SetUnitAnimation(ZX7,"stand")
call SetUnitPathing(ZX7,true)
call UnitRemoveAbility(ZX7,'A1J6')
call UnitRemoveAbility(ZX7,'X1J6')
call Y67(GetUnitX(ZX7),GetUnitY(ZX7),100)
if IH7!=null and WF7(IH7)==false then
call O37(IH7,"4408",5)
call SKE(ZX7,IH7,BC7)
endif
call NM7(I97)
call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
set g=null
return false
endfunction
function SRE takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer OB7=Get_Multiple_Skill_Key(ZX7,'A4BV')
local integer BC7=Multiple_Skill_Level(ZX7,'A4BV','A4BW')+Labike_Multiple_Skill_Level(ZX7,'A4BV')
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local real ZFD
local real d
local real TA9=GetUnitFacing(ZX7)
local real AQ9=GetUnitX(ZX7)
local real AR9=GetUnitY(ZX7)
local real Y_7
local real Z47
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
local integer id=GetUnitTypeId(ZX7)
local integer suijiDisplacementCount=B290_GetDisplacementMulticastCount(ZX7,B287_GetSpellAbilityId())
if SUIJI_MODE and OO7(GetHandleId(ZX7),"SuijiDone") and BC7<1 then
set BC7=B287_GetUnitAbilityLevel(ZX7,B287_GetSpellAbilityId())
endif
if N5E>0 then
if SuijiMode_ScepterRegistryIsActive(ZX7,'A4BV')==false then
set ZFD=700*suijiDisplacementCount
set d=30
else
set ZFD=1100*suijiDisplacementCount
set d=20
endif
set Y_7=X17(AQ9+ZFD*Cos(TA9*bj_DEGTORAD))
set Z47=X07(AR9+ZFD*Sin(TA9*bj_DEGTORAD))
call XF7(ZX7,'Amrf')
call UnitRemoveAbility(ZX7,'Amrf')
call SetUnitPathing(ZX7,false)
if id=='Z071' then
call XF7(ZX7,'X1J6')
else
call XF7(ZX7,'A1J6')
endif
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function SME))
call NT7(I97,"Source",ZX7)
call NP7(I97,"Level",BC7)
call NQ7(I97,"Length",ZFD*1.)
call NQ7(I97,"Rate",d*1.)
call NQ7(I97,"Angle",TA9*1.)
call NQ7(I97,"SourceX",AQ9*1.)
call NQ7(I97,"SourceY",AR9*1.)
call NQ7(I97,"TargetX",Y_7*1.)
call NQ7(I97,"TargetY",Z47*1.)
call UnitRemoveAbility(ZX7,skill)
set N5E=N5E-1
call SaveInteger(MSK,(OB7),(30),(N5E))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
if SuijiMode_EnsureExactLiveAbilityLevel(ZX7,skill,BC7,true) then
call Multiple_Skill_SyncButton(ZX7,skill)
call Reset_Skill_range(ZX7)
endif
else
call X377(GetOwningPlayer(ZX7),"无可用次数")
endif
if N5E==0 then
set WF8=(LoadReal(MSK,(OB7),(50)))
if WF8>0 then
call Multiple_Skill_StartZeroCooldown(ZX7,skill,WF8)
endif
endif
set ZX7=null
set t=null
endfunction
function SSE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1J7' or B287_GetSpellAbilityId()=='A4BZ' or B287_GetSpellAbilityId()=='A4C1' then
call SRE()
endif
return false
endfunction
function XXHASL takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(u)
local integer old_skill='A4BV'
local integer new_skill='A4BW'
local real interval
local integer O5=GetPlayerId(GetOwningPlayer(u))
if (B287_GetLearnedSkill()==old_skill or B287_GetLearnedSkill()==new_skill) and IsUnitIllusion(u)==false then
if (GetUnitAbilityLevel(u,old_skill)==1 or GetUnitAbilityLevel(u,new_skill)==1) then
call SaveInteger(MSK,(OB7),(0),('A1J7'))
call SaveInteger(MSK,(OB7),(1),('A4BZ'))
call SaveInteger(MSK,(OB7),(2),('A4C1'))
call Multiple_Skill(u,1,2,1.,old_skill,new_skill)
endif
if (GetUnitAbilityLevel(u,old_skill)>1 and GetUnitAbilityLevel(u,'A4BZ')>0) or (GetUnitAbilityLevel(u,new_skill)>1 and GetUnitAbilityLevel(u,'A4C1')>0) then
set interval=Multiple_Skill_Interval(old_skill,(GetUnitAbilityLevel(u,old_skill)+GetUnitAbilityLevel(u,new_skill)))
call SaveReal(MSK,(OB7),(50),(interval))
endif
endif
set u=null
return false
endfunction
function CXMJ takes nothing returns boolean
local real HSD=XYSR[GetPlayerId(GetTriggerPlayer())]*0.5
local integer id=GetUnitTypeId(M7[GetPlayerId(GetTriggerPlayer())])
if (id=='H071' or id=='Z071') then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,E9,10.,"永久增加的敏捷： "+R2S(HSD))
endif
return false
endfunction
