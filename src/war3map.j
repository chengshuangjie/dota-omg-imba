function VMF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local integer V77=OM7(OB7,"Level")
local unit T6F=O77(OB7,"Source")
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamage()>$A and OU7(t,"Cooldown")==false and GetOwningPlayer(GetEventDamageSource())!=GetOwningPlayer(GetTriggerUnit())then
call DisableTrigger(t)
call VJF(T6F,m5)
call EnableTrigger(t)
call O67(t,"Cooldown",.8-V77*.0285)
endif
else
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
endif
set t=null
set m5=null
set T6F=null
return false
endfunction
function VNF takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit hn=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=(OM7(GetHandleId(hn),"QuasLevel"))
local integer id=GetUnitTypeId(hn)
local string tx
if id=='Z00U' then
set tx="model\\hero_invoker_n4s_y_target.mdl"
elseif id=='Z10U' then
set tx="model\\hero_invoker_n3s_y_target.mdl"
elseif id=='Z20U' then
set tx="model\\hero_invoker_n2s_y_target.mdl"
else
set tx="Abilities\\Weapons\\SpiritOfVengeanceMissile\\SpiritOfVengeanceMissile.mdl"
endif
call TriggerRegisterTimerEvent(t,2.5+V77*.5,false)
call B1023RegisterDamage(t,m5)
call TriggerAddCondition(t,Condition(function VMF))
call NT7(OB7,"Target",m5)
call NP7(OB7,"Level",V77)
call NT7(OB7,"Source",hn)
call NU7(OB7,"FX",AddSpecialEffectTarget(tx,m5,"overhead"))
call VJF(hn,m5)
call LINGXIA(hn,m5)
set t=null
set hn=null
set m5=null
endfunction
function VOF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0VZ' and WQ7(GetSpellTargetUnit())==false then
call VNF()
endif
return false
endfunction
function VPF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function VOF))
call Y97('A0VI',GetRandomReal(1,25))
set t=null
endfunction
function VQF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local integer I97=GetHandleId(hn)
local integer VWF=OM7(I97,"Invoker|Quas")
local integer V77=B287_GetUnitAbilityLevel(hn,'A21W')
local integer d=VWF*V77
if d>0 then
call SetUnitState(hn,UNIT_STATE_LIFE,GetUnitState(hn,UNIT_STATE_LIFE)+d)
endif
set t=null
set hn=null
return false
endfunction
//冰回血
function VRF takes unit hn returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(hn)
call NV7(OB7,"Invoker|QuasTrigger",t)
call NT7(GetHandleId(t),"Hero",hn)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function VQF))
set t=null
endfunction
function VUF takes unit hn returns nothing
local integer OB7=GetHandleId(hn)
local integer VVF=OM7(OB7,"Invoker|Wex")
local integer VWF=OM7(OB7,"Invoker|Quas")
local integer VXF=OM7(OB7,"Invoker|Exort")
local integer S1F=B287_GetUnitAbilityLevel(hn,'A21X')
local integer T7F=B287_GetUnitAbilityLevel(hn,'A21W')
local integer S0F=B287_GetUnitAbilityLevel(hn,'A21V')
local integer wexLevel=VVF*S1F
local integer exortLevel=VXF*S0F
call UnitRemoveAbility(hn,'A0WD')
call UnitRemoveAbility(hn,'A0VE')
call UnitRemoveAbility(hn,'A0V7')
if VVF>0 and wexLevel>0 then
// Original Dota Invoker lifecycle: A0WD is a 21-level Spell Book whose levels
// select distinct A0WG..A0WC movement children.  No random-hero bridge needed.
call XF7(hn,'A0WD')
call XF7(hn,'A0VE')
call SetUnitAbilityLevel(hn,'A0WD',wexLevel)
call SetUnitAbilityLevel(hn,'A0VE',wexLevel)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),'A0WD',false)
endif
if VXF>0 and exortLevel>0 then
call SuijiMode_EnsureExactLiveAbilityLevel(hn,'A0V7',exortLevel,true)
endif
endfunction
function VYF takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if IsUnitIllusion(b1060GetTriggerUnit)==false and (B287_GetLearnedSkill()=='A21X' or B287_GetLearnedSkill()=='A21W' or B287_GetLearnedSkill()=='A21V') then
call VUF(b1060GetTriggerUnit)
if B287_GetLearnedSkill()=='A21X' then
call SetHeroAgi(b1060GetTriggerUnit,GetHeroAgi(b1060GetTriggerUnit,false)+2,true)
call NP7(GetHandleId(b1060GetTriggerUnit),"WexLevel",B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A21X'))
endif
if B287_GetLearnedSkill()=='A21W' then
call SetHeroStr(b1060GetTriggerUnit,GetHeroStr(b1060GetTriggerUnit,false)+2,true)
call NP7(GetHandleId(b1060GetTriggerUnit),"QuasLevel",B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A21W'))
if B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A21W')==1 then
        call VRF(b1060GetTriggerUnit)
    endif
endif
if B287_GetLearnedSkill()=='A21V' then
call SetHeroInt(b1060GetTriggerUnit,GetHeroInt(b1060GetTriggerUnit,false)+2,true)
call NP7(GetHandleId(b1060GetTriggerUnit),"ExortLevel",B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A21V'))
call SET_TH_TIP()
endif
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function VZF takes unit hn returns nothing
if GetUnitAbilityLevel(hn,'A0XL')>0 then
call SetUnitAbilityLevel(hn,'A0XL',B287_GetUnitAbilityLevel(hn,'A21X'))
endif
endfunction
function SuijiMode_ApplyInvokerInvokeAghState takes unit hn,integer IMF returns nothing
local integer level=0
local real cooldown=0.
if SUIJI_MODE==false or hn==null or GetUnitTypeId(hn)==0 or (IMF!='A21Y' and IMF!='A1GU') or SuijiMode_ScepterRegistryIsActive(hn,'A21Y')==false then
return
endif
set level=SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
if level==1 then
set cooldown=16.
elseif level==2 then
set cooldown=8.
elseif level==3 then
set cooldown=4.
else
set cooldown=0.
endif
call SuijiMode_StartPairCooldownSync(hn,IMF,'A21Y','A1GU',"SuijiInvokerInvokeCooldown",cooldown,cooldown,cooldown,cooldown,cooldown,cooldown)
endfunction
function VAF2 takes nothing returns nothing
local integer VBF=0
local unit hn=GetTriggerUnit()
local integer IMF=B287_GetSpellAbilityId()
local integer T_7=GetHandleId(hn)
local integer VCF=OM7(T_7,"Invoker|Wex")
local integer V3F=OM7(T_7,"Invoker|Quas")
local integer V6F=OM7(T_7,"Invoker|Exort")
local integer U47=OM7(T_7,"Invoker|Current1")
local integer U77=OM7(T_7,"Invoker|Current2")
if GetUnitAbilityLevel(hn,'A4H6')==0 then
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),OM7(T_7,"Invoker|Current3"),false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
    call XF7(hn,'A4H6')
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
    call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
endif
if VCF==3 and V3F==0 and V6F==0 then
set VBF=1
elseif VCF==2 and V3F==1 and V6F==0 then
set VBF=2
elseif VCF==2 and V3F==0 and V6F==1 then
set VBF=3
elseif VCF==1 and V3F==2 and V6F==0 then
set VBF=4
elseif VCF==1 and V3F==1 and V6F==1 then
set VBF=5
elseif VCF==1 and V3F==0 and V6F==2 then
set VBF=6
elseif VCF==0 and V3F==1 and V6F==2 then
set VBF=7
elseif VCF==0 and V3F==2 and V6F==1 then
set VBF=8
elseif VCF==0 and V3F==0 and V6F==3 then
set VBF=9
elseif VCF==0 and V3F==3 and V6F==0 then
set VBF=$A
endif
if BS[VBF]==U77 then
if SuijiMode_ScepterRegistryIsActive(hn,'A21Y') and SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')==4 then
else
call Japi_ReduceUnitAbilityCoolDown(hn,IMF,0.)
endif
set hn=null
return
endif
if U47!=0 and U77!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
set U47=U77
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
elseif U47==0 and U77!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,false)
set U47=U77
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U47,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
else
set U77=BS[VBF]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),U77,true)
endif
call NP7(T_7,"Invoker|Current1",U47)
call NP7(T_7,"Invoker|Current2",U77)
call VZF(hn)
set hn=null
endfunction
function VAF takes nothing returns nothing
local integer skill=0
local unit hn=GetTriggerUnit()
local integer IMF=B287_GetSpellAbilityId()
local integer T_7=GetHandleId(hn)
local integer VCF=OM7(T_7,"Invoker|Wex")
local integer V3F=OM7(T_7,"Invoker|Quas")
local integer V6F=OM7(T_7,"Invoker|Exort")
local integer skill3=OM7(T_7,"Invoker|Current3")
local integer skill2=OM7(T_7,"Invoker|Current2")
local integer skill1=OM7(T_7,"Invoker|Current1")
if GetUnitAbilityLevel(hn,'A4H6')==1 then
    call UnitRemoveAbility(hn,'A4H6')
endif
if VCF==3 and V3F==0 and V6F==0 then
set skill=1
elseif VCF==2 and V3F==1 and V6F==0 then
set skill=2
elseif VCF==2 and V3F==0 and V6F==1 then
set skill=3
elseif VCF==1 and V3F==2 and V6F==0 then
set skill=4
elseif VCF==1 and V3F==1 and V6F==1 then
set skill=5
elseif VCF==1 and V3F==0 and V6F==2 then
set skill=6
elseif VCF==0 and V3F==1 and V6F==2 then
set skill=7
elseif VCF==0 and V3F==2 and V6F==1 then
set skill=8
elseif VCF==0 and V3F==0 and V6F==3 then
set skill=9
elseif VCF==0 and V3F==3 and V6F==0 then
set skill=$A
endif
if BS[skill]==skill1 or BS[skill]==skill2 then
if SuijiMode_ScepterRegistryIsActive(hn,'A21Y') and SuijiMode_GetPairCastLevel(hn,IMF,'A21Y','A1GU')==4 then
else
call Japi_ReduceUnitAbilityCoolDown(hn,IMF,0.)
endif
set hn=null
return
endif
if skill2!=0 and skill1!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill3,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,false)
set skill3=skill2
set skill2=skill1
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill3,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
elseif skill3==0 and skill2==0 and skill1!=0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,false)
set skill2=skill1
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill2,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
else
set skill1=BS[skill]
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),skill1,true)
endif
call NP7(T_7,"Invoker|Current3",skill3)
call NP7(T_7,"Invoker|Current2",skill2)
call NP7(T_7,"Invoker|Current1",skill1)
call VZF(hn)
set hn=null
endfunction
