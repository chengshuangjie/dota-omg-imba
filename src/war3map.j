function SET_PIFU_DEMO_NULL takes player p returns nothing
local integer n=1
local integer i
if TV7(p) then
set i=7
else
set i=1
endif
loop
exitwhen n>5
// call DzSetUnitModel(PFDEMO[i],"")
call MHUnit_SetModel(PFDEMO[i],"",false)
set n=n+1
set i=i+1
endloop
endfunction
function SET_PIFU_DEMO takes unit u,player p returns nothing
local integer id=GetUnitTypeId(u)
local integer PIFU_ID
local string VH
local real d
local integer n=1
local integer i
if TV7(p) then
set i=1
else
set i=7
endif
loop
exitwhen n>5
set PIFU_ID=Get_PIFU_ID(u,n)
if PIFU_ID>0 then
set VH=EXGetUnitString(PIFU_ID, UNIT_STRING_MODEL_PATH)
else
set VH="Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl"
endif
// call DzSetUnitModel(PFDEMO[i],VH)
call MHUnit_SetModel(PFDEMO[i],VH,false)
if PIFU_ID>0 then
set d=XX7(u)
else
set d=1.
endif
call SetUnitScale(PFDEMO[i],d,d,d)
set n=n+1
set i=i+1
endloop
endfunction
