function SuijiMode_GetFixedTransientButton takes unit u,integer logicalSkill1,integer logicalSkill2,integer nativeButton,integer smallButton,integer ultButton returns integer
local integer h=0
local integer assignedSkill=0
if u==null or GetUnitTypeId(u)==0 then
return nativeButton
endif
if SUIJI_MODE and OO7(GetHandleId(u),"SuijiDone") then
set h=GetHandleId(u)
set assignedSkill=OM7(h,"SuijiSmallSkill")
if assignedSkill==logicalSkill1 or (logicalSkill2!=0 and assignedSkill==logicalSkill2) then
return smallButton
endif
set assignedSkill=OM7(h,"SuijiUltSkill")
if assignedSkill==logicalSkill1 or (logicalSkill2!=0 and assignedSkill==logicalSkill2) then
return ultButton
endif
endif
return nativeButton
endfunction
function SuijiMode_HideFixedTransientButtons takes unit u,integer nativeButton,integer smallButton,integer ultButton,boolean removeButtons returns nothing
local player p=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,nativeButton,false)
call SetPlayerAbilityAvailable(p,smallButton,false)
call SetPlayerAbilityAvailable(p,ultButton,false)
if removeButtons then
if GetUnitAbilityLevel(u,nativeButton)>0 then
call UnitRemoveAbility(u,nativeButton)
endif
if GetUnitAbilityLevel(u,smallButton)>0 then
call UnitRemoveAbility(u,smallButton)
endif
if GetUnitAbilityLevel(u,ultButton)>0 then
call UnitRemoveAbility(u,ultButton)
endif
endif
set p=null
endfunction
function SuijiMode_EnsureFixedTransientButton takes unit u,integer abilityId returns boolean
if u==null or GetUnitTypeId(u)==0 or abilityId==0 then
return false
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),abilityId,false)
if GetUnitAbilityLevel(u,abilityId)<=0 then
call UnitAddAbility(u,abilityId)
call UnitMakeAbilityPermanent(u,true,abilityId)
endif
return GetUnitAbilityLevel(u,abilityId)>0
endfunction
function SuijiMode_IsSnowballReleaseButton takes integer skill returns boolean
return skill=='A4HF' or skill=='ZT01' or skill=='ZT02'
endfunction
function SuijiMode_IsChakramReturnButton takes integer skill returns boolean
return skill=='A2FX' or skill=='ZT07' or skill=='ZT08'
endfunction
function SuijiMode_ChakramDebugStageText takes integer chakramDebugStage returns string
if chakramDebugStage==1 then
return "primary-start-pre"
elseif chakramDebugStage==2 then
return "primary-start-post-005"
elseif chakramDebugStage==3 then
return "primary-start-post-060"
elseif chakramDebugStage==4 then
return "primary-return-pre"
elseif chakramDebugStage==5 then
return "primary-return-post-005"
elseif chakramDebugStage==6 then
return "scepter-start-pre"
elseif chakramDebugStage==7 then
return "scepter-start-post-005"
elseif chakramDebugStage==8 then
return "scepter-start-post-060"
elseif chakramDebugStage==9 then
return "scepter-return-pre"
elseif chakramDebugStage==10 then
return "scepter-return-post-005"
endif
return "unknown"
endfunction
function SuijiMode_ChakramDebugRawcode takes integer chakramDebugRawcode returns string
if chakramDebugRawcode==0 then
return "----"
endif
return AbilityId2String(chakramDebugRawcode)
endfunction
function SuijiMode_ChakramDebugSnapshot takes unit chakramDebugUnit,integer chakramDebugStage returns nothing
local integer chakramDebugUnitHandle=0
local integer chakramDebugCount=0
local integer chakramDebugIndex=1
local integer chakramDebugButton=0
local integer chakramDebugAbility=0
local integer chakramDebugOrder=0
local string chakramDebugLine=""
local unit chakramDebugSelected=null
if SUIJI_CHAKRAM_LOG==false or chakramDebugUnit==null or GetUnitTypeId(chakramDebugUnit)==0 then
return
endif
set chakramDebugUnitHandle=GetHandleId(chakramDebugUnit)
set chakramDebugCount=LoadInteger(L7,chakramDebugUnitHandle,StringHash("SuijiChakramDebugCount"))
if chakramDebugCount>=24 then
return
endif
call SaveInteger(L7,chakramDebugUnitHandle,StringHash("SuijiChakramDebugCount"),chakramDebugCount+1)
if GetLocalPlayer()==Le then
set chakramDebugSelected=MHPlayer_GetSelectUnit()
if chakramDebugSelected==chakramDebugUnit then
call DisplayTimedTextToPlayer(Le,0,0,15.,"[CHAKRAM-STATE] stage="+SuijiMode_ChakramDebugStageText(chakramDebugStage)+" P"+I2S(GetPlayerId(GetOwningPlayer(chakramDebugUnit))+1)+" hid="+I2S(chakramDebugUnitHandle)+" cur="+I2S(GetUnitCurrentOrder(chakramDebugUnit))+" lvFK="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2FK'))+" lvE5="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2E5'))+" lvSH="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2SH'))+" lvSI="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2SI'))+" lvE6="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2E6'))+" lvFX="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'A2FX'))+" lvT07="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'ZT07'))+" lvT08="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'ZT08'))+" lvAbun="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'Abun'))+" lvY0BA="+I2S(GetUnitAbilityLevel(chakramDebugUnit,'Y0BA')))
call DisplayTimedTextToPlayer(Le,0,0,15.,"[CHAKRAM-CARD] stage="+SuijiMode_ChakramDebugStageText(chakramDebugStage)+" selected=1 small="+SuijiMode_ChakramDebugRawcode(LoadInteger(L7,chakramDebugUnitHandle,StringHash("SuijiSmallSkill")))+" ult="+SuijiMode_ChakramDebugRawcode(LoadInteger(L7,chakramDebugUnitHandle,StringHash("SuijiUltSkill"))))
loop
exitwhen chakramDebugIndex>12
set chakramDebugButton=MHUI_GetSkillBarButton(chakramDebugIndex)
if chakramDebugButton==0 then
set chakramDebugLine=chakramDebugLine+" #"+I2S(chakramDebugIndex)+"=null"
else
set chakramDebugAbility=MHUIData_GetCommandButtonAbility(chakramDebugButton)
set chakramDebugOrder=MHUIData_GetCommandButtonOrderId(chakramDebugButton)
set chakramDebugLine=chakramDebugLine+" #"+I2S(chakramDebugIndex)+"="+SuijiMode_ChakramDebugRawcode(chakramDebugAbility)+"/o"+I2S(chakramDebugOrder)+"/p"+I2S(MHUIData_GetCommandButtonX(chakramDebugButton))+","+I2S(MHUIData_GetCommandButtonY(chakramDebugButton))+"/k"+I2S(MHUIData_GetCommandButtonHotkey(chakramDebugButton))
endif
if ModuloInteger(chakramDebugIndex,4)==0 then
call DisplayTimedTextToPlayer(Le,0,0,15.,"[CHAKRAM-CARD]"+chakramDebugLine)
set chakramDebugLine=""
endif
set chakramDebugIndex=chakramDebugIndex+1
endloop
else
call DisplayTimedTextToPlayer(Le,0,0,15.,"[CHAKRAM-CARD] stage="+SuijiMode_ChakramDebugStageText(chakramDebugStage)+" selected=0 selectedHid="+I2S(GetHandleId(chakramDebugSelected))+" casterHid="+I2S(chakramDebugUnitHandle))
endif
endif
set chakramDebugSelected=null
set chakramDebugUnit=null
endfunction
function SuijiMode_ChakramDebugDeferred takes nothing returns nothing
local timer chakramDebugTimer=GetExpiredTimer()
local integer chakramDebugTimerHandle=GetHandleId(chakramDebugTimer)
local unit chakramDebugUnit=LoadUnitHandle(L7,chakramDebugTimerHandle,2)
local integer chakramDebugStage=LoadInteger(L7,chakramDebugTimerHandle,3)
call SuijiMode_ChakramDebugSnapshot(chakramDebugUnit,chakramDebugStage)
call FlushChildHashtable(L7,chakramDebugTimerHandle)
call PauseTimer(chakramDebugTimer)
call DestroyTimer(chakramDebugTimer)
set chakramDebugUnit=null
set chakramDebugTimer=null
endfunction
function SuijiMode_ChakramDebugSchedule takes unit chakramDebugUnit,integer chakramDebugStage,real chakramDebugDelay returns nothing
local timer chakramDebugTimer=null
local integer chakramDebugTimerHandle=0
if SUIJI_CHAKRAM_LOG==false or chakramDebugUnit==null or GetUnitTypeId(chakramDebugUnit)==0 then
return
endif
set chakramDebugTimer=CreateTimer()
set chakramDebugTimerHandle=GetHandleId(chakramDebugTimer)
call SaveUnitHandle(L7,chakramDebugTimerHandle,2,chakramDebugUnit)
call SaveInteger(L7,chakramDebugTimerHandle,3,chakramDebugStage)
call TimerStart(chakramDebugTimer,chakramDebugDelay,false,function SuijiMode_ChakramDebugDeferred)
set chakramDebugTimer=null
set chakramDebugUnit=null
endfunction
function SuijiMode_ChakramSyncStateButton takes unit chakramStateUnit,integer chakramBaseSkill1,integer chakramBaseSkill2,integer chakramStateSkill returns nothing
local integer chakramPhysicalBase=B287_GetPhysicalAbilityId(chakramStateUnit,chakramBaseSkill1)
local ability chakramBaseAbility=null
local ability chakramStateAbility=null
if chakramStateUnit==null or GetUnitTypeId(chakramStateUnit)==0 or chakramStateSkill==0 or SuijiMode_HasExactLiveAbility(chakramStateUnit,chakramStateSkill)==false then
return
endif
if SuijiMode_HasExactLiveAbility(chakramStateUnit,chakramPhysicalBase)==false and chakramBaseSkill2!=0 then
set chakramPhysicalBase=B287_GetPhysicalAbilityId(chakramStateUnit,chakramBaseSkill2)
endif
if SuijiMode_HasExactLiveAbility(chakramStateUnit,chakramPhysicalBase)==false then
return
endif
set chakramBaseAbility=EXGetUnitAbility(chakramStateUnit,chakramPhysicalBase)
set chakramStateAbility=EXGetUnitAbility(chakramStateUnit,chakramStateSkill)
if chakramBaseAbility==null or chakramStateAbility==null then
set chakramBaseAbility=null
set chakramStateAbility=null
return
endif
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_BUTTON_X,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_BUTTON_X))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_BUTTON_Y,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_BUTTON_Y))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_UNBUTTON_X,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_UNBUTTON_X))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_UNBUTTON_Y,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_UNBUTTON_Y))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_HOTKEY,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_HOTKEY))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_UNHOTKEY,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_UNHOTKEY))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_RESEARCH_HOTKEY,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_RESEARCH_HOTKEY))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_X,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_RESEARCH_BUTTON_X))
call MHAbility_SetCustomDataInt(chakramStateUnit,chakramStateSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_Y,MHAbility_GetCustomDataInt(chakramStateUnit,chakramPhysicalBase,ABILITY_DEF_DATA_RESEARCH_BUTTON_Y))
set chakramBaseAbility=null
set chakramStateAbility=null
endfunction
function SuijiMode_HasChakramReturnButton takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return GetUnitAbilityLevel(u,'A2FX')>0 or GetUnitAbilityLevel(u,'ZT07')>0 or GetUnitAbilityLevel(u,'ZT08')>0
endfunction
function SuijiMode_IssueChakramReturnOrder takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 or SuijiMode_HasChakramReturnButton(u)==false then
return false
endif
return B947IssueImmediateOrderById("SuijiMode_IssueChakramReturnOrder @ war3map.j:20813 (B968)",u,OrderId("etherealform"))
endfunction
function SuijiMode_ChakramReturnButtonBegin takes unit u returns integer
local integer returnButton=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set returnButton=SuijiMode_GetFixedTransientButton(u,'A2E5','A2SH','A2FX','ZT07','ZT08')
call SuijiMode_HideFixedTransientButtons(u,'A2FX','ZT07','ZT08',false)
if SuijiMode_EnsureFixedTransientButton(u,returnButton)==false then
return 0
endif
call SuijiMode_ChakramSyncStateButton(u,'A2E5','A2SH',returnButton)
return returnButton
endfunction
function SuijiMode_ChakramReturnButtonEnd takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call SuijiMode_HideFixedTransientButtons(u,'A2FX','ZT07','ZT08',true)
endfunction
function SuijiMode_IsPulseNovaCloseButton takes integer skill returns boolean
return skill=='A21H' or skill=='ZPNK' or skill=='ZPNL'
endfunction
function SuijiMode_PulseNovaCloseButtonBegin takes unit u returns integer
local integer closeButton=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set closeButton=SuijiMode_GetFixedTransientButton(u,'A21F','A21G','A21H','ZPNK','ZPNL')
call SuijiMode_HideFixedTransientButtons(u,'A21H','ZPNK','ZPNL',false)
if SuijiMode_EnsureFixedTransientButton(u,closeButton)==false then
return 0
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),closeButton,true)
return closeButton
endfunction
function SuijiMode_PulseNovaCloseButtonEnd takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call SuijiMode_HideFixedTransientButtons(u,'A21H','ZPNK','ZPNL',false)
endfunction
function SuijiMode_IssuePulseNovaCloseOrder takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if GetUnitAbilityLevel(u,'ZPNK')>0 or GetUnitAbilityLevel(u,'ZPNL')>0 then
return B947IssueImmediateOrderById("SuijiMode_IssuePulseNovaCloseOrder @ war3map.j:20861 (B968)",u,OrderId("unetherealform"))
endif
return N97(u,852100,'A21H')
endfunction
function OQ7 takes integer ki,string kI returns button
return LoadButtonHandle(L7,ki,StringHash(kI))
endfunction
function OR7 takes integer ki,string kI returns boolexpr
return LoadBooleanExprHandle(L7,ki,StringHash(kI))
endfunction
function OS7 takes integer ki,string kI returns force
return LoadForceHandle(L7,ki,StringHash(kI))
endfunction
function OT7 takes unit hI,string Hh returns boolean
return LoadInteger(L7,GetHandleId(hI),StringHash("state"+Hh))==1
endfunction
function OU7 takes trigger hI,string Hh returns boolean
return LoadInteger(L7,GetHandleId(hI),StringHash("state"+Hh))==1
endfunction
function OV7 takes unit hI,string Hh returns nothing
call SaveInteger(L7,GetHandleId(hI),StringHash("state"+Hh),1)
endfunction
function OW7 takes trigger hI,string Hh returns nothing
call SaveInteger(L7,GetHandleId(hI),StringHash("state"+Hh),1)
endfunction
function OX7 takes unit hI,string Hh returns nothing
call SaveInteger(L7,GetHandleId(hI),StringHash("state"+Hh),2)
if Hh=="HideUnit" and LoadBoolean(L7,GetHandleId(hI),StringHash("B1116EventDeferred")) then
set B1116ReconcileWakeUnit=hI
call ExecuteFunc("B1116ResumeEventReconcile")
endif
endfunction
function OY7 takes trigger hI,string Hh returns nothing
call SaveInteger(L7,GetHandleId(hI),StringHash("state"+Hh),2)
endfunction
function IsHideUnit takes unit ZX7 returns boolean
    return OT7(ZX7,"HideUnit")
endfunction
function DGFS takes unit u returns boolean
    return u!=null and (GetUnitTypeId(u)=='N0MM' or OO7(GetHandleId(u),"B849TempestOwned"))
endfunction
function ISJIANGSHI takes unit u returns boolean
    return GetUnitTypeId(u)=='n0F5' or GetUnitTypeId(u)=='n1F5'
endfunction
function l5 takes integer msgtype returns nothing
if D9==false and PT4==false then
if KBAI then
	if msgtype==1 and TriErrorLog1<10 then
    	call DisplayTextToPlayer(Player(KBAIID),0,0, "|c00FF0000OZ7时触发器为空|r")
		set TriErrorLog1=TriErrorLog1+1
	elseif msgtype==2 and TriErrorLog2<10 then
		call DisplayTextToPlayer(Player(KBAIID),0,0, "|c00FF0000OZ7时触发器数量大于8000|r")
		set TriErrorLog2=TriErrorLog2+1
	elseif msgtype==3 and TriErrorLog3<10 then
		call DisplayTextToPlayer(Player(KBAIID),0,0, "|c00FF0000l8时触发器为空|r")
		set TriErrorLog3=TriErrorLog3+1
	elseif msgtype==4 and TriErrorLog4<10 then
		call DisplayTextToPlayer(Player(KBAIID),0,0, "|c00FF0000l8时触发器是开启状态|r")
		set TriErrorLog4=TriErrorLog4+1
	endif
endif
endif
endfunction
function OZ7_RemoveIndex takes integer i returns nothing
if i!=Dy then
set Dx[i]=Dx[Dy]
set DX[i]=DX[Dy]
endif
set Dx[Dy]=null
set DX[Dy]=0
set Dy=Dy-1
endfunction
function OZ7_FindQueuedIndex takes trigger t returns integer
local integer i=1
loop
exitwhen i>Dy
if Dx[i]==t then
return i
endif
set i=i+1
endloop
return 0
endfunction
function OZ7_IsQueued takes trigger t returns boolean
if t==null then
return false
endif
return LoadBoolean(OZ7_HT,GetHandleId(t),0)
endfunction
function OZ7_CancelQueued takes trigger t returns boolean
local integer i
local timer overflow1060=null
if t==null then
return false
endif
if not LoadBoolean(OZ7_HT,GetHandleId(t),0)then
return true
endif
set i=OZ7_FindQueuedIndex(t)
call RemoveSavedBoolean(OZ7_HT,GetHandleId(t),0)
set overflow1060=LoadTimerHandle(OZ7_HT,GetHandleId(t),1)
if overflow1060!=null then
call RemoveSavedHandle(OZ7_HT,GetHandleId(t),1)
call PauseTimer(overflow1060)
call FlushChildHashtable(L7,GetHandleId(overflow1060))
call DestroyTimer(overflow1060)
set overflow1060=null
return true
endif
if i>0 then
call OZ7_RemoveIndex(i)
return true
endif
return false
endfunction
function B1060ActionEnter takes trigger owner1060 returns nothing
local integer key1060=GetHandleId(owner1060)
if owner1060!=null then
call SaveInteger(OZ7_HT,key1060,2,LoadInteger(OZ7_HT,key1060,2)+1)
endif
endfunction
function B1060ActionLeave takes trigger owner1060 returns nothing
local integer key1060=GetHandleId(owner1060)
local integer active1060=LoadInteger(OZ7_HT,key1060,2)-1
if active1060>0 then
call SaveInteger(OZ7_HT,key1060,2,active1060)
else
call RemoveSavedInteger(OZ7_HT,key1060,2)
endif
endfunction
function B1060RetireOverflow takes nothing returns nothing
local timer b1060Owned_tm=GetExpiredTimer()
local integer key=GetHandleId(b1060Owned_tm)
local trigger retired=LoadTriggerHandle(L7,key,0)
local integer retiredKey=GetHandleId(retired)
call PauseTimer(b1060Owned_tm)
if retired!=null and LoadTimerHandle(OZ7_HT,retiredKey,1)==b1060Owned_tm and LoadBoolean(OZ7_HT,retiredKey,0) and not IsTriggerEnabled(retired) and LoadInteger(OZ7_HT,retiredKey,2)>0 then
call TimerStart(b1060Owned_tm,1.,false,function B1060RetireOverflow)
set retired=null
set b1060Owned_tm=null
return
endif
if retired!=null and LoadTimerHandle(OZ7_HT,retiredKey,1)==b1060Owned_tm then
call RemoveSavedHandle(OZ7_HT,retiredKey,1)
if LoadBoolean(OZ7_HT,retiredKey,0) then
call RemoveSavedBoolean(OZ7_HT,retiredKey,0)
if not IsTriggerEnabled(retired) then
call DestroyTrigger(retired)
endif
endif
endif
call FlushChildHashtable(L7,key)
call DestroyTimer(b1060Owned_tm)
set retired=null
set b1060Owned_tm=null
endfunction
function OZ7 takes trigger t returns nothing
local integer h
local timer overflow1060=null
if t==null then
call l5(1)
return
endif
set h=GetHandleId(t)
if LoadBoolean(OZ7_HT,h,0)then
return
endif
if Dy>=8190 then
call l5(2)
// Never evict a young registration to make queue space.
call SaveBoolean(OZ7_HT,h,0,true)
call DisableTrigger(t)
set overflow1060=CreateTimer()
call SaveTriggerHandle(L7,GetHandleId(overflow1060),0,t)
call SaveTimerHandle(OZ7_HT,h,1,overflow1060)
call TimerStart(overflow1060,20.,false,function B1060RetireOverflow)
set overflow1060=null
return
endif
call SaveBoolean(OZ7_HT,h,0,true)
call DisableTrigger(t)
set Dy=Dy+1
set Dx[Dy]=t
set DX[Dy]=KQ7()+20
if Dy>8000 then
call l5(2)
endif
endfunction
function B1027TempestReleaseListeners takes unit owner1027 returns nothing
local integer ownerKey1027=GetHandleId(owner1027)
local integer count1027=LoadInteger(B1027TempestListenerTable,ownerKey1027,0)
local trigger listener1027=null
// Detach ownership before cleanup can enter another event.
call RemoveSavedInteger(B1027TempestListenerTable,ownerKey1027,0)
loop
exitwhen count1027<=0
set listener1027=LoadTriggerHandle(B1027TempestListenerTable,ownerKey1027,count1027)
call RemoveSavedHandle(B1027TempestListenerTable,ownerKey1027,count1027)
if listener1027!=null then
call RemoveSavedBoolean(B1027TempestListenerTable,GetHandleId(listener1027),-1)
call OZ7(listener1027)
call FlushChildHashtable(L7,GetHandleId(listener1027))
endif
set count1027=count1027-1
endloop
set listener1027=null
endfunction

// 缴械
function DisarmUnit takes unit whichUnit,boolean flag,integer disarmId,integer abilityId,integer buffId returns nothing
 local integer h= GetHandleId(whichUnit)
 local integer count= LoadInteger(ExtraHT, h, disarmId)
	if flag then
		set count=count + 1
	else
		set count=count - 1
	endif
	call SaveInteger(ExtraHT, h, disarmId, count)
	if count == 1 then
		call XF7(whichUnit , disarmId)
		call XF7(whichUnit , abilityId)
	elseif count == 0 then
		call RemoveSavedInteger(ExtraHT, h, disarmId)
		call UnitRemoveAbility(whichUnit, disarmId)
		call UnitRemoveAbility(whichUnit, abilityId)
		call UnitRemoveAbility(whichUnit, buffId)
	endif
endfunction
function DisarmUnitToTimedExpireActions takes nothing returns nothing
 local trigger trig= GetTriggeringTrigger()
 local integer h= GetHandleId(trig)
 local unit whichUnit= LoadUnitHandle(TABLE_HY, h, 0)
 local integer disarmId= LoadInteger(TABLE_HY, h, 1)
	call DisarmUnit(whichUnit , false , disarmId , LoadInteger(TABLE_HY, h, 2) , LoadInteger(TABLE_HY, h, 3))
	call RemoveSavedHandle(ExtraHT, GetHandleId(whichUnit), disarmId)
	call PauseTimer(LoadTimerHandle(TABLE_HY, h, 1))
	call DestroyTimer(LoadTimerHandle(TABLE_HY, h, 1))
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(trig)
	set whichUnit=null
	set trig=null
endfunction
function UnitRemoveDisarm takes unit whichUnit,integer disarmId returns nothing
 local integer h= GetHandleId(whichUnit)
 local trigger trig= null
 local integer abilityId
 local integer buffId
	if HaveSavedHandle(ExtraHT, h, disarmId) then
		set trig=LoadTriggerHandle(ExtraHT, h, disarmId)
		call RemoveSavedHandle(ExtraHT, h, disarmId)
		if trig!=null then
		set h=GetHandleId(trig)
		set abilityId=LoadInteger(TABLE_HY, h, 2)
		set buffId=LoadInteger(TABLE_HY, h, 3)
		call DisarmUnit(whichUnit , false , disarmId , abilityId , buffId)
		call PauseTimer(LoadTimerHandle(TABLE_HY, h, 1))
		call DestroyTimer(LoadTimerHandle(TABLE_HY, h, 1))
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(trig)
		endif
		set trig=null
	endif
endfunction
// 添加缴械
function DisarmUnitToTimed takes unit whichUnit,integer disarmId,integer abilityId,integer buffId,real time returns nothing
 local trigger trig
 local timer timr
 local integer h= GetHandleId(whichUnit)
	if HaveSavedHandle(ExtraHT, h, disarmId) then
		set trig=LoadTriggerHandle(ExtraHT, h, disarmId)
		set h=GetHandleId(trig)
		set timr=LoadTimerHandle(TABLE_HY, h, 1)
	else
		set trig=CreateTrigger()
		call SaveTriggerHandle(ExtraHT, h, disarmId, trig)
		set h=GetHandleId(trig)
		set timr=CreateTimer()
		call TriggerAddCondition(trig, Condition(function DisarmUnitToTimedExpireActions))
		call TriggerRegisterTimerExpireEvent(trig, timr)
		call TriggerRegisterDeathEvent(trig, whichUnit)
		call SaveUnitHandle(TABLE_HY, h, 0, whichUnit)
		call SaveInteger(TABLE_HY, h, 1, disarmId)
		call SaveInteger(TABLE_HY, h, 2, abilityId)
		call SaveInteger(TABLE_HY, h, 3, buffId)
		call SaveTimerHandle(TABLE_HY, h, 1, timr)
		call DisarmUnit(whichUnit , true , disarmId , abilityId , buffId)
	endif
	// IMBA: disarm duration x2 cap 5s.
	if XOMG_IMBA_ENABLED then
		set time=RMinBJ(time*IMBA_POWER,5.)
	endif
	call TimerStart(timr, time, false, null)
	set timr=null
	set trig=null
endfunction
