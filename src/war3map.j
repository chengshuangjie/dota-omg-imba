function Fun_FastMode takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
if GetTriggerEvalCount(t)==1 and FastMode>0 then
set killers=150
call VV7(bj_FORCE_ALL_PLAYERS,10,"|cFF00FF00已开启杀戮模式，人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
    if FastMode==5 then
        set P94=false
        set PSR=false
        set PDR=false
        set PGR=true
        call VV7(bj_FORCE_ALL_PLAYERS,10.,"|c00FF8000已开启加速模式，工资翻倍，死亡不掉钱，且复活时间随游戏时间增加|r")
    endif
endif
if GetTriggerEvalCount(t)==4 and XM_MODE then
    call VV7(bj_FORCE_ALL_PLAYERS,10.,"|c00FF8000XM模式选择英雄后可以在能量圈抽奖|r")
    call VV7(bj_FORCE_ALL_PLAYERS,10.," ")
endif   
if GetTriggerEvalCount(t)>4 then
    call OZ7(t)
endif
set t=null
endfunction
