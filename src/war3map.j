return
endif
set LotusOrbLogCount=LotusOrbLogCount+1
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFF66CCFF青莲宝珠日志["+tag+"]：|r"+message)
endfunction
function LotusOrb_DebugStatus takes nothing returns nothing
set LotusOrbLogCount=0
call LotusOrb_DebugPrint("STATUS","jassReady=true item=I0TT ability=A5VS duration=2.500 cooldown=20.000 limit=80")
endfunction
function LotusOrb_IsBlacklisted takes integer logicalSkill,integer physicalSkill returns boolean
return logicalSkill=='TBRE' or logicalSkill=='A1MO' or logicalSkill=='A1ZI' or logicalSkill=='A2RF' or logicalSkill=='A0SW' or logicalSkill=='A0BZ' or physicalSkill=='TBRE' or physicalSkill=='A1MO' or physicalSkill=='A1ZI' or physicalSkill=='A2RF' or physicalSkill=='A0SW' or physicalSkill=='A0BZ'
endfunction
function LotusOrb_IsMagicImmuneException takes integer logicalSkill,integer physicalSkill returns boolean
return logicalSkill=='Afbt' or logicalSkill=='A1T7' or logicalSkill=='A0I3' or logicalSkill=='A0R5' or logicalSkill=='A0AS' or logicalSkill=='A0CE' or physicalSkill=='Afbt' or physicalSkill=='A1T7' or physicalSkill=='A0I3' or physicalSkill=='A0R5' or physicalSkill=='A0AS' or physicalSkill=='A0CE'
endfunction
function LotusOrb_IsShellActive takes unit u returns boolean
local integer unitId=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set unitId=GetHandleId(u)
return LoadBoolean(L7,unitId,StringHash("LotusShellActive")) and LoadReal(L7,unitId,StringHash("LotusShellExpires"))>Bz
endfunction
function LotusOrb_ShellFinish takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
local integer serial=LoadInteger(L7,I97,1)
local integer unitId=0
local effect e=null
if u!=null then
set unitId=GetHandleId(u)
if LoadInteger(L7,unitId,StringHash("LotusShellSerial"))==serial then
set e=LoadEffectHandle(L7,unitId,StringHash("LotusShellEffect"))
call SaveBoolean(L7,unitId,StringHash("LotusShellActive"),false)
call RemoveSavedHandle(L7,unitId,StringHash("LotusShellEffect"))
if e!=null then
call DestroyEffect(e)
endif
endif
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set e=null
set u=null
set t=null
endfunction
function LotusOrb_Activate takes unit target returns nothing
local integer unitId=0
local integer serial=0
local effect oldEffect=null
local effect newEffect=null
local timer t=null
if target==null or GetUnitTypeId(target)==0 then
return
endif
set unitId=GetHandleId(target)
set oldEffect=LoadEffectHandle(L7,unitId,StringHash("LotusShellEffect"))
if oldEffect!=null then
call DestroyEffect(oldEffect)
endif
set serial=LoadInteger(L7,unitId,StringHash("LotusShellSerial"))+1
set newEffect=AddSpecialEffectTarget("model\\LotusOrb.mdx",target,"chest")
call SaveInteger(L7,unitId,StringHash("LotusShellSerial"),serial)
call SaveBoolean(L7,unitId,StringHash("LotusShellActive"),true)
call SaveReal(L7,unitId,StringHash("LotusShellExpires"),Bz+2.5)
call SaveEffectHandle(L7,unitId,StringHash("LotusShellEffect"),newEffect)
call UnitRemoveBuffs(target,false,true)
call YW8(target,0,0)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,target)
call SaveInteger(L7,GetHandleId(t),1,serial)
call TimerStart(t,2.5,false,function LotusOrb_ShellFinish)
set oldEffect=null
set newEffect=null
set t=null
endfunction
function LotusOrb_ClearTemp takes unit u,integer skill,integer serial returns nothing
local integer I97=0
if u==null then
return
endif
set I97=GetHandleId(u)
if LoadInteger(L7,I97,StringHash("LotusTempSerial"))!=serial or LoadInteger(L7,I97,StringHash("LotusTempSkill"))!=skill then
return
endif
if LoadBoolean(L7,I97,StringHash("LotusTempAdded")) and GetUnitAbilityLevel(u,skill)>0 then
call UnitRemoveAbility(u,skill)
endif
call SaveInteger(L7,I97,StringHash("LotusTempSkill"),0)
call SaveInteger(L7,I97,StringHash("LotusTempSerial"),0)
call SaveBoolean(L7,I97,StringHash("LotusTempAdded"),false)
endfunction
function LotusOrb_TempFallback takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
call LotusOrb_ClearTemp(u,LoadInteger(L7,I97,1),LoadInteger(L7,I97,2))
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function LotusOrb_GuardClear takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
if u!=null and GetUnitTypeId(u)!=0 then
call SaveBoolean(L7,GetHandleId(u),StringHash("LotusReflecting"),false)
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function LotusOrb_ReflectTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit originalCaster=LoadUnitHandle(L7,I97,0)
local unit reflector=LoadUnitHandle(L7,I97,1)
local integer logicalSkill=LoadInteger(L7,I97,2)
local integer physicalSkill=LoadInteger(L7,I97,3)
local integer level=LoadInteger(L7,I97,4)
local integer castSkill=physicalSkill
local integer cloneSkill=0
local integer unitId=0
local integer serial=0
local integer oldTempSkill=0
local integer oldTempSerial=0
local boolean added=false
local boolean castResult=false
local real oldCooldown=0.
local timer cleanup=null
local timer guard=null
if originalCaster==null or reflector==null or GetUnitTypeId(originalCaster)==0 or GetUnitTypeId(reflector)==0 or physicalSkill==0 or level<=0 then
call LotusOrb_DebugPrint("REFLECT","aborted-invalid-context logical="+I2S(logicalSkill)+" physical="+I2S(physicalSkill))
else
set cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
if GetUnitAbilityLevel(reflector,castSkill)>0 and cloneSkill!=0 and cloneSkill!=castSkill and GetUnitAbilityLevel(reflector,cloneSkill)<=0 then
set castSkill=cloneSkill
endif
set unitId=GetHandleId(reflector)
set oldTempSkill=LoadInteger(L7,unitId,StringHash("LotusTempSkill"))
set oldTempSerial=LoadInteger(L7,unitId,StringHash("LotusTempSerial"))
if oldTempSkill!=0 and oldTempSerial!=0 then
call LotusOrb_ClearTemp(reflector,oldTempSkill,oldTempSerial)
endif
if GetUnitAbilityLevel(reflector,castSkill)<=0 then
set added=UnitAddAbility(reflector,castSkill)
endif
if GetUnitAbilityLevel(reflector,castSkill)>0 then
set oldCooldown=B582_GetAbilityCooldown(reflector,castSkill)
call SetUnitAbilityLevel(reflector,castSkill,level)
if added then
call MHAbility_Hide(reflector,castSkill,true)
endif
call MHAbility_SetCooldown(reflector,castSkill,0.)
set serial=LoadInteger(L7,unitId,StringHash("LotusTempCounter"))+1
call SaveInteger(L7,unitId,StringHash("LotusTempCounter"),serial)
call SaveInteger(L7,unitId,StringHash("LotusTempSkill"),castSkill)
call SaveInteger(L7,unitId,StringHash("LotusTempSerial"),serial)
call SaveBoolean(L7,unitId,StringHash("LotusTempAdded"),added)
call SaveBoolean(L7,unitId,StringHash("LotusReflecting"),true)
set castResult=MHAbility_CastEx(reflector,originalCaster,GetUnitX(originalCaster),GetUnitY(originalCaster),castSkill)
if added==false then
call MHAbility_SetCooldown(reflector,castSkill,oldCooldown)
endif
set guard=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(guard),0,reflector)
call TimerStart(guard,0.,false,function LotusOrb_GuardClear)
if castResult and added then
set cleanup=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(cleanup),0,reflector)
call SaveInteger(L7,GetHandleId(cleanup),1,castSkill)
call SaveInteger(L7,GetHandleId(cleanup),2,serial)
// IMBA: lotus reflect window x2 cap 30s.
if XOMG_IMBA_ENABLED then
call TimerStart(cleanup,RMinBJ(12.*IMBA_POWER,30.),false,function LotusOrb_TempFallback)
else
call TimerStart(cleanup,12.,false,function LotusOrb_TempFallback)
endif
else
call LotusOrb_ClearTemp(reflector,castSkill,serial)
endif
call LotusOrb_DebugPrint("REFLECT","result="+SuijiMode_DebugBoolText(castResult)+" logical="+I2S(logicalSkill)+" physical="+I2S(physicalSkill)+" cast="+I2S(castSkill)+" level="+I2S(level)+" added="+SuijiMode_DebugBoolText(added))
else
call LotusOrb_DebugPrint("REFLECT","ability-add-failed physical="+I2S(castSkill))
endif
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set originalCaster=null
set reflector=null
set cleanup=null
set guard=null
set t=null
endfunction
function LotusOrb_AISelfCastTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit target=LoadUnitHandle(L7,I97,0)
local integer logicalSkill=LoadInteger(L7,I97,1)
local integer physicalSkill=LoadInteger(L7,I97,2)
local item lotus=null
local boolean issued=false
if target!=null and GetUnitTypeId(target)!=0 then
call SaveBoolean(L7,GetHandleId(target),StringHash("LotusAIPending"),false)
if UnitAlive(target) and IsUnitType(target,UNIT_TYPE_HERO) and GetPlayerController(GetOwningPlayer(target))==MAP_CONTROL_COMPUTER then
set lotus=MV7(target,ZU[it_lotus_orb])
if lotus!=null then
set issued=UnitUseItemTarget(target,lotus,target)
if issued then
call LotusOrb_DebugPrint("AI","self-cast target="+GetUnitName(target)+" incomingLogical="+I2S(logicalSkill)+" incomingPhysical="+I2S(physicalSkill))
endif
endif
endif
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set lotus=null
set target=null
set t=null
endfunction
function LotusOrb_ScheduleAISelfCast takes unit target,integer logicalSkill,integer physicalSkill returns nothing
local integer unitId=0
local timer t=null
if target==null or GetUnitTypeId(target)==0 then
return
endif
set unitId=GetHandleId(target)
if LoadBoolean(L7,unitId,StringHash("LotusAIPending")) then
return
endif
call SaveBoolean(L7,unitId,StringHash("LotusAIPending"),true)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,target)
call SaveInteger(L7,GetHandleId(t),1,logicalSkill)
call SaveInteger(L7,GetHandleId(t),2,physicalSkill)
call TimerStart(t,0.,false,function LotusOrb_AISelfCastTick)
set t=null
endfunction
function LotusOrb_OnSpellChannel takes nothing returns boolean
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local integer logicalSkill=B287_GetSpellAbilityId()
local integer physicalSkill=GetSpellAbilityId()
local integer level=0
local timer t=null
local integer I97=0
local item lotus=null
local string reason="no-shell"
if caster==null or target==null or GetUnitTypeId(caster)==0 or GetUnitTypeId(target)==0 or logicalSkill==0 or physicalSkill==0 or IsAttackSpecialEffects(logicalSkill) then
set caster=null
set target=null
return false
endif
if physicalSkill!='A5VS' and UnitAlive(target) and IsUnitType(target,UNIT_TYPE_HERO) and GetPlayerController(GetOwningPlayer(target))==MAP_CONTROL_COMPUTER and IsUnitEnemy(caster,GetOwningPlayer(target)) and not LoadBoolean(L7,GetHandleId(caster),StringHash("LotusReflecting")) then
set lotus=MV7(target,ZU[it_lotus_orb])
if lotus!=null then
call LotusOrb_ScheduleAISelfCast(target,logicalSkill,physicalSkill)
endif
endif
if LotusOrb_IsShellActive(target) then
if LoadBoolean(L7,GetHandleId(caster),StringHash("LotusReflecting")) then
set reason="reflected-recursion"
elseif physicalSkill=='A5VS' then
set reason="invalid-skill"
elseif not IsUnitEnemy(caster,GetOwningPlayer(target)) then
set reason="ally-cast"
elseif LotusOrb_IsBlacklisted(logicalSkill,physicalSkill) then
set reason="16-blacklist"
elseif IsMagicImmuneUnit(caster) and not LotusOrb_IsMagicImmuneException(logicalSkill,physicalSkill) then
set reason="caster-magic-immune"
else
set reason="reflect"
set level=GetUnitAbilityLevel(caster,physicalSkill)
if level<=0 then
set level=B287_GetUnitAbilityLevel(caster,logicalSkill)
endif
set t=CreateTimer()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,0,caster)
call SaveUnitHandle(L7,I97,1,target)
call SaveInteger(L7,I97,2,logicalSkill)
call SaveInteger(L7,I97,3,physicalSkill)
call SaveInteger(L7,I97,4,level)
call TimerStart(t,0.,false,function LotusOrb_ReflectTick)
endif
endif
if SUIJI_LOG and reason!="no-shell" and reason!="reflect" then
call LotusOrb_DebugPrint("FILTER",reason+" logical="+I2S(logicalSkill)+" physical="+I2S(physicalSkill)+" caster="+GetUnitName(caster)+" target="+GetUnitName(target))
endif
set caster=null
set target=null
set t=null
set lotus=null
return false
endfunction
function LotusOrb_OnSpellEffect takes nothing returns boolean
local unit caster=null
local unit target=null
if GetSpellAbilityId()=='A5VS' then
set caster=GetTriggerUnit()
set target=GetSpellTargetUnit()
if target!=null and GetUnitTypeId(target)!=0 then
call LotusOrb_Activate(target)
call LotusOrb_DebugPrint("ACTIVE","activated caster="+GetUnitName(caster)+" target="+GetUnitName(target)+" duration=2.500")
endif
endif
set caster=null
set target=null
return false
endfunction
function LotusOrb_OnSpellEnd takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer skill=GetSpellAbilityId()
local integer I97=0
local integer serial=0
if u!=null and GetUnitTypeId(u)!=0 then
set I97=GetHandleId(u)
set serial=LoadInteger(L7,I97,StringHash("LotusTempSerial"))
if serial!=0 and LoadInteger(L7,I97,StringHash("LotusTempSkill"))==skill then
call LotusOrb_ClearTemp(u,skill,serial)
endif
endif
set u=null
return false
endfunction
function LotusOrb_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function LotusOrb_OnSpellChannel))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function LotusOrb_OnSpellEffect))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_FINISH)
call TriggerAddCondition(t,Condition(function LotusOrb_OnSpellEnd))
set t=null
endfunction
// B907 healer gear. Inventory stats remain owned by item abilities, not hidden
// unit attachments. All timers/groups below are synchronized and bounded.
function B907ReadyKey takes integer gearSkill returns integer
if gearSkill=='A7H2' then
return StringHash("B907CupReady")
endif
return StringHash("B907LightReady")
endfunction
function B907SyncCooldown takes unit gearOwner,integer gearSkill returns nothing
local ability gearAbility=null
local real gearLeft=LoadReal(L7,GetHandleId(gearOwner),B907ReadyKey(gearSkill))-GetGameTime()
if gearLeft>0. and GetUnitAbilityLevel(gearOwner,gearSkill)>0 then
set gearAbility=EXGetUnitAbility(gearOwner,gearSkill)
if gearAbility!=null then
call EXSetAbilityState(gearAbility,1,gearLeft)
endif
endif
set gearAbility=null
endfunction
function B907InventoryFinish takes nothing returns nothing
local timer gearTimer=GetExpiredTimer()
local integer gearTimerKey=GetHandleId(gearTimer)
local unit gearOwner=LoadUnitHandle(L7,gearTimerKey,0)
local integer gearOwnerKey=GetHandleId(gearOwner)
call RemoveSavedBoolean(L7,gearOwnerKey,StringHash("B907InventoryPending"))
if gearOwner!=null and GetUnitTypeId(gearOwner)!=0 then
call B907SyncCooldown(gearOwner,'A7H0')
call B907SyncCooldown(gearOwner,'A7H1')
call B907SyncCooldown(gearOwner,'A7H2')
if not B907HasItem(gearOwner,'I7AA') then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Spring"))
endif
if not B907HasItem(gearOwner,'I7AG') then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Grace"))
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907LastHeal"))
endif
endif
call FlushChildHashtable(L7,gearTimerKey)
call PauseTimer(gearTimer)
call DestroyTimer(gearTimer)
set gearOwner=null
set gearTimer=null
endfunction
function B907QueueInventory takes unit gearOwner returns nothing
local timer gearTimer=null
local integer gearOwnerKey=GetHandleId(gearOwner)
if gearOwner!=null and GetUnitTypeId(gearOwner)!=0 and not LoadBoolean(L7,gearOwnerKey,StringHash("B907InventoryPending")) then
call SaveBoolean(L7,gearOwnerKey,StringHash("B907InventoryPending"),true)
set gearTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(gearTimer),0,gearOwner)
// The existing transfer-item -> owned-item conversion runs at zero delay.
call TimerStart(gearTimer,.05,false,function B907InventoryFinish)
endif
set gearTimer=null
endfunction
function B907OnInventory takes nothing returns boolean
local unit gearOwner=GetTriggerUnit()
local item gearItem=GetManipulatedItem()
local item gearOther=null
local integer gearRaw=GetItemTypeId(gearItem)
local integer gearSlot=0
local boolean gearCopy=false
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PAWN_ITEM then
set gearItem=GetSoldItem()
set gearRaw=GetItemTypeId(gearItem)
endif
if gearRaw>='I7A0' and gearRaw<='I7AH' then
if GetTriggerEventId()!=EVENT_PLAYER_UNIT_PICKUP_ITEM and (gearRaw=='I7AA' or gearRaw=='I7AG') then
loop
exitwhen gearSlot>5
set gearOther=UnitItemInSlot(gearOwner,gearSlot)
if gearOther!=gearItem and GetItemTypeId(gearOther)==gearRaw then
set gearCopy=true
endif
set gearSlot=gearSlot+1
endloop
if not gearCopy then
if gearRaw=='I7AA' then
call RemoveSavedReal(L7,GetHandleId(gearOwner),StringHash("B907Spring"))
else
call RemoveSavedReal(L7,GetHandleId(gearOwner),StringHash("B907Grace"))
call RemoveSavedReal(L7,GetHandleId(gearOwner),StringHash("B907LastHeal"))
endif
endif
endif
call B907QueueInventory(gearOwner)
endif
set gearOwner=null
set gearItem=null
set gearOther=null
return false
endfunction
function B907ClearShield takes unit gearTarget returns nothing
local integer gearTargetKey=GetHandleId(gearTarget)
local effect gearFx=LoadEffectHandle(L7,gearTargetKey,StringHash("B907ShieldFx"))
if gearFx!=null then
call DestroyEffect(gearFx)
endif
call RemoveSavedHandle(L7,gearTargetKey,StringHash("B907ShieldFx"))
call RemoveSavedReal(L7,gearTargetKey,StringHash("B907Shield"))
call RemoveSavedReal(L7,gearTargetKey,StringHash("B907ShieldUntil"))
set gearFx=null
endfunction
function B907ShieldExpire takes nothing returns nothing
local timer gearTimer=GetExpiredTimer()
local integer gearTimerKey=GetHandleId(gearTimer)
local unit gearTarget=LoadUnitHandle(L7,gearTimerKey,0)
if LoadInteger(L7,gearTimerKey,1)==LoadInteger(L7,GetHandleId(gearTarget),StringHash("B907ShieldSerial")) then
call B907ClearShield(gearTarget)
endif
call FlushChildHashtable(L7,gearTimerKey)
call PauseTimer(gearTimer)
call DestroyTimer(gearTimer)
set gearTarget=null
set gearTimer=null
endfunction
function B907GiveShield takes unit gearTarget,real gearAmount returns nothing
local integer gearTargetKey=GetHandleId(gearTarget)
local integer gearSerial=LoadInteger(L7,gearTargetKey,StringHash("B907ShieldSerial"))+1
local timer gearTimer=CreateTimer()
call B907ClearShield(gearTarget)
// Same-name shields replace rather than stack; the newest shield lasts four seconds.
call SaveInteger(L7,gearTargetKey,StringHash("B907ShieldSerial"),gearSerial)
call SaveReal(L7,gearTargetKey,StringHash("B907Shield"),gearAmount)
// IMBA: gear shield duration x2 cap 30s; end-time synced.
if XOMG_IMBA_ENABLED then
call SaveReal(L7,gearTargetKey,StringHash("B907ShieldUntil"),GetGameTime()+RMinBJ(4.*IMBA_POWER,30.))
else
call SaveReal(L7,gearTargetKey,StringHash("B907ShieldUntil"),GetGameTime()+4.)
endif
call SaveEffectHandle(L7,gearTargetKey,StringHash("B907ShieldFx"),AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",gearTarget,"origin"))
call SaveUnitHandle(L7,GetHandleId(gearTimer),0,gearTarget)
call SaveInteger(L7,GetHandleId(gearTimer),1,gearSerial)
if XM_MODE then
call TimerStart(gearTimer,RMinBJ(4.*IMBA_POWER,30.),false,function B907ShieldExpire)
else
call TimerStart(gearTimer,4.,false,function B907ShieldExpire)
endif
set gearTimer=null
endfunction
function B907OnDamaging takes nothing returns boolean
local unit gearTarget=MHEvent_GetUnit()
local integer gearTargetKey=GetHandleId(gearTarget)
local real gearDamage=MHDamagingEvent_GetDamage()
local real gearShield=LoadReal(L7,gearTargetKey,StringHash("B907Shield"))
local real gearAbsorbed=0.
if gearShield>0. then
if gearTarget==null or GetUnitTypeId(gearTarget)==0 or not UnitAlive(gearTarget) or GetGameTime()>=LoadReal(L7,gearTargetKey,StringHash("B907ShieldUntil")) then
call B907ClearShield(gearTarget)
elseif gearDamage>0. then
set gearAbsorbed=RMinBJ(gearDamage,gearShield)
call MHDamagingEvent_SetDamage(gearDamage-gearAbsorbed)
call SaveReal(L7,gearTargetKey,StringHash("B907Shield"),gearShield-gearAbsorbed)
if gearShield<=gearAbsorbed then
call B907ClearShield(gearTarget)
endif
endif
endif
set gearTarget=null
return false
endfunction
function B907OnDeath takes nothing returns boolean
local unit gearDead=GetTriggerUnit()
local integer gearDeadKey=GetHandleId(gearDead)
if not IsUnitType(gearDead,UNIT_TYPE_HERO) then
set gearDead=null
return false
endif
if LoadReal(L7,gearDeadKey,StringHash("B907Shield"))>0. then
call B907ClearShield(gearDead)
endif
// Death discards pending secondary heals and banked grace; cooldown survives.
call RemoveSavedReal(L7,gearDeadKey,StringHash("B907Spring"))
call RemoveSavedReal(L7,gearDeadKey,StringHash("B907Grace"))
call RemoveSavedReal(L7,gearDeadKey,StringHash("B907TetherHeal"))
set gearDead=null
return false
endfunction
function B907ValidTarget takes unit gearOwner,unit gearTarget,integer gearSkill returns boolean
if not B907RealHero(gearOwner) or not UnitAlive(gearOwner) or gearTarget==null or GetUnitTypeId(gearTarget)==0 or not UnitAlive(gearTarget) then
return false
endif
if not IsUnitAlly(gearTarget,GetOwningPlayer(gearOwner)) or IsUnitType(gearTarget,UNIT_TYPE_STRUCTURE) then
return false
endif
if gearSkill=='A7H2' then
return B907HasItem(gearOwner,'I7AG') and gearOwner!=gearTarget and B907RealHero(gearTarget)
elseif gearSkill=='A7H1' then
return B907HasItem(gearOwner,'I7AA')
endif
return B907HasItem(gearOwner,'I7A4')
endfunction
function B907OnCast takes nothing returns boolean
local integer gearSkill=GetSpellAbilityId()
local unit gearOwner=null
if gearSkill=='A7H0' or gearSkill=='A7H1' or gearSkill=='A7H2' then
set gearOwner=GetTriggerUnit()
if OO7(GetHandleId(gearOwner),"SuijiMulticastCasting") or OO7(GetHandleId(gearOwner),"LotusReflecting") or not B907ValidTarget(gearOwner,GetSpellTargetUnit(),gearSkill) then
call KR7(gearOwner)
elseif LoadReal(L7,GetHandleId(gearOwner),B907ReadyKey(gearSkill))>GetGameTime()+.01 then
call KR7(gearOwner)
call B907QueueInventory(gearOwner)
call DisplayTimedTextToPlayer(GetOwningPlayer(gearOwner),0,0,2.,"|cffffcc00该装备的共享冷却尚未结束。|r")
endif
endif
set gearOwner=null
return false
endfunction
function B907OnEffect takes nothing returns boolean
local integer gearSkill=GetSpellAbilityId()
local unit gearOwner=null
local unit gearTarget=null
local integer gearOwnerKey=0
local real gearGrace=0.
local real healLogBefore=0.
local integer healLogKind=3
if gearSkill=='A7H0' or gearSkill=='A7H1' or gearSkill=='A7H2' then
set gearOwner=GetTriggerUnit()
set gearTarget=GetSpellTargetUnit()
set gearOwnerKey=GetHandleId(gearOwner)
if not OO7(gearOwnerKey,"SuijiMulticastCasting") and not OO7(gearOwnerKey,"LotusReflecting") and B907ValidTarget(gearOwner,gearTarget,gearSkill) and LoadReal(L7,gearOwnerKey,B907ReadyKey(gearSkill))<=GetGameTime()+.01 then
if gearSkill!='A7H0' then
// Use the map's ordinary negative-dispel path (Lotus), never YZ8/strong cleanse.
call UnitRemoveBuffs(gearTarget,false,true)
call YW8(gearTarget,0,0)
endif
if gearSkill=='A7H2' then
set gearGrace=RMinBJ(600.,LoadReal(L7,gearOwnerKey,StringHash("B907Grace")))
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Grace"))
call B907GiveShield(gearTarget,200.+gearGrace)
call SaveReal(L7,gearOwnerKey,B907ReadyKey(gearSkill),GetGameTime()+35.)
else
// Deliberately not B907SkillHeal: gear healing cannot amplify or charge gear.
if B908HealingLog then
set healLogBefore=GetWidgetLife(gearTarget)
endif
call SetUnitState(gearTarget,UNIT_STATE_LIFE,GetWidgetLife(gearTarget)+200.*DGH_BUFF(gearTarget))
if B908HealingLog then
if gearSkill=='A7H1' then
set healLogKind=4
endif
call B908RecordHeal(gearOwner,gearTarget,healLogKind,200.,200.*DGH_BUFF(gearTarget),healLogBefore,GetWidgetLife(gearTarget))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",gearTarget,"origin"))
call SaveReal(L7,gearOwnerKey,B907ReadyKey(gearSkill),GetGameTime()+25.)
endif
call B907QueueInventory(gearOwner)
endif
endif
set gearOwner=null
set gearTarget=null
return false
endfunction
function B907HealerTick takes nothing returns nothing
local unit gearOwner=GetEnumUnit()
local integer gearOwnerKey=GetHandleId(gearOwner)
local real gearPool=LoadReal(L7,gearOwnerKey,StringHash("B907Spring"))
local real gearGrace=LoadReal(L7,gearOwnerKey,StringHash("B907Grace"))
local real gearRatio=1.
local real gearCandidateRatio=1.
local real healLogBefore=0.
local group gearNearby=null
local unit gearCandidate=null
local unit gearLowest=null
local boolean gearHasBranch=B907HasItem(gearOwner,'I7AA')
local boolean gearHasCup=B907HasItem(gearOwner,'I7AG')
if not B907RealHero(gearOwner) or not UnitAlive(gearOwner) or (not gearHasBranch and not gearHasCup) then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Spring"))
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Grace"))
call GroupRemoveUnit(B907Healers,gearOwner)
else
if not gearHasCup then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Grace"))
elseif gearGrace>0. and GetGameTime()>=LoadReal(L7,gearOwnerKey,StringHash("B907LastHeal"))+15. then
call SaveReal(L7,gearOwnerKey,StringHash("B907Grace"),RMaxBJ(0.,gearGrace-60.))
endif
if not gearHasBranch then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Spring"))
elseif ModuloInteger(B907Pulse,8)==0 and gearPool>0. then
call RemoveSavedReal(L7,gearOwnerKey,StringHash("B907Spring"))
set gearNearby=CreateGroup()
call GroupEnumUnitsInRange(gearNearby,GetUnitX(gearOwner),GetUnitY(gearOwner),800.,null)
loop
set gearCandidate=FirstOfGroup(gearNearby)
exitwhen gearCandidate==null
call GroupRemoveUnit(gearNearby,gearCandidate)
if gearCandidate!=gearOwner and B907RealHero(gearCandidate) and UnitAlive(gearCandidate) and IsUnitAlly(gearCandidate,GetOwningPlayer(gearOwner)) then
set gearCandidateRatio=GetWidgetLife(gearCandidate)/GetUnitState(gearCandidate,UNIT_STATE_MAX_LIFE)
if gearCandidateRatio<gearRatio then
set gearRatio=gearCandidateRatio
set gearLowest=gearCandidate
endif
endif
endloop
call DestroyGroup(gearNearby)
if gearLowest!=null then
if B908HealingLog then
set healLogBefore=GetWidgetLife(gearLowest)
endif
call SetUnitState(gearLowest,UNIT_STATE_LIFE,GetWidgetLife(gearLowest)+RMinBJ(250.,gearPool*.25)*DGH_BUFF(gearLowest))
if B908HealingLog then
call B908RecordHeal(gearOwner,gearLowest,5,RMinBJ(250.,gearPool*.25),RMinBJ(250.,gearPool*.25)*DGH_BUFF(gearLowest),healLogBefore,GetWidgetLife(gearLowest))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIhe\\AIheTarget.mdl",gearLowest,"origin"))
endif
endif
endif
set gearNearby=null
set gearCandidate=null
set gearLowest=null
set gearOwner=null
endfunction
function B907WardTick takes nothing returns nothing
local group gearWards=CreateGroup()
local group gearTargets=CreateGroup()
local group gearNearby=CreateGroup()
local unit gearWard=null
local unit gearCaster=null
local unit gearTarget=null
local integer gearTargetKey=0
local integer gearWardLevel=0
call GroupAddGroup(B907Wards,gearWards)
loop
set gearWard=FirstOfGroup(gearWards)
exitwhen gearWard==null
call GroupRemoveUnit(gearWards,gearWard)
set gearCaster=LoadUnitHandle(L7,GetHandleId(gearWard),StringHash("B907WardCaster"))
if GetUnitTypeId(gearWard)==0 or not UnitAlive(gearWard) or gearCaster==null or GetUnitTypeId(gearCaster)==0 then
call GroupRemoveUnit(B907Wards,gearWard)
call RemoveSavedHandle(L7,GetHandleId(gearWard),StringHash("B907WardCaster"))
else
set gearWardLevel=GetUnitAbilityLevel(gearWard,'A058')
call GroupEnumUnitsInRange(gearNearby,GetUnitX(gearWard),GetUnitY(gearWard),500.,null)
loop
set gearTarget=FirstOfGroup(gearNearby)
exitwhen gearTarget==null
call GroupRemoveUnit(gearNearby,gearTarget)
if IsUnitType(gearTarget,UNIT_TYPE_HERO) and UnitAlive(gearTarget) and not IsUnitType(gearTarget,UNIT_TYPE_MECHANICAL) and IsUnitAlly(gearTarget,GetOwningPlayer(gearWard)) then
set gearTargetKey=GetHandleId(gearTarget)
// Same aura never stacks; preserve the strongest ward in this pulse.
if not IsUnitInGroup(gearTarget,gearTargets) or gearWardLevel>LoadInteger(L7,gearTargetKey,StringHash("B907WardLevel")) then
call GroupAddUnit(gearTargets,gearTarget)
call SaveInteger(L7,gearTargetKey,StringHash("B907WardLevel"),gearWardLevel)
call SaveUnitHandle(L7,gearTargetKey,StringHash("B907WardHealer"),gearCaster)
endif
endif
endloop
endif
endloop
loop
set gearTarget=FirstOfGroup(gearTargets)
exitwhen gearTarget==null
call GroupRemoveUnit(gearTargets,gearTarget)
set gearTargetKey=GetHandleId(gearTarget)
set gearWardLevel=LoadInteger(L7,gearTargetKey,StringHash("B907WardLevel"))
set gearCaster=LoadUnitHandle(L7,gearTargetKey,StringHash("B907WardHealer"))
call RemoveSavedInteger(L7,gearTargetKey,StringHash("B907WardLevel"))
call RemoveSavedHandle(L7,gearTargetKey,StringHash("B907WardHealer"))
call B907SkillHeal(gearCaster,gearTarget,GetUnitState(gearTarget,UNIT_STATE_MAX_LIFE)*(.01+.01*gearWardLevel)*.25)
endloop
call DestroyGroup(gearWards)
call DestroyGroup(gearTargets)
call DestroyGroup(gearNearby)
set gearWard=null
set gearCaster=null
set gearTarget=null
set gearWards=null
set gearTargets=null
set gearNearby=null
endfunction
function B907PulseTick takes nothing returns nothing
set B907Pulse=B907Pulse+1
if FirstOfGroup(B907Wards)!=null then
call B907WardTick()
endif
if ModuloInteger(B907Pulse,4)==0 then
call ForGroup(B907Healers,function B907HealerTick)
endif
endfunction
function B907Init takes nothing returns nothing
local trigger gearTrigger=CreateTrigger()
local timer gearTimer=CreateTimer()
set B907Healers=CreateGroup()
set B907Wards=CreateGroup()
call YB7(gearTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(gearTrigger,Condition(function B907OnCast))
set gearTrigger=CreateTrigger()
call YB7(gearTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gearTrigger,Condition(function B907OnEffect))
set gearTrigger=CreateTrigger()
call YB7(gearTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call YB7(gearTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call YB7(gearTrigger,EVENT_PLAYER_UNIT_PAWN_ITEM)
call TriggerAddCondition(gearTrigger,Condition(function B907OnInventory))
set gearTrigger=CreateTrigger()
call YB7(gearTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gearTrigger,Condition(function B907OnDeath))
set gearTrigger=CreateTrigger()
call TriggerAddCondition(gearTrigger,Condition(function B907OnDamaging))
call MHDamagingEvent_Register(gearTrigger)
call TimerStart(gearTimer,.25,true,function B907PulseTick)
set gearTimer=null
set gearTrigger=null
endfunction
// B946: synchronized opt-in state; local selection controls text rendering only.
function B946OrderName takes integer detectOrder946 returns string
if detectOrder946==851971 then
return "智能/右键 smart"
elseif detectOrder946==851972 then
return "停止 stop"
elseif detectOrder946==851973 then
return "眩晕/暂停 stunned"
elseif detectOrder946==851983 then
return "攻击 attack"
elseif detectOrder946==851984 then
return "攻击地面 attackground"
elseif detectOrder946==851985 then
return "单次攻击 attackonce"
elseif detectOrder946==851986 then
return "移动/跟随 move"
elseif detectOrder946==851990 then
return "巡逻 patrol"
elseif detectOrder946==851993 then
return "保持位置 holdposition"
elseif detectOrder946==852001 then
return "丢弃/转交物品 dropitem"
elseif detectOrder946>=852002 and detectOrder946<=852007 then
return "移动物品至背包格 "+I2S(detectOrder946-852001)
endif
// Do not guess that an unknown order is non-spell (OMG carriers reuse orders).
return ""
endfunction
function B946DetectOrder takes nothing returns boolean
local unit detectUnit946=GetTriggerUnit()
local integer detectViewer946=GetPlayerId(GetLocalPlayer())
local integer detectOrder946=GetIssuedOrderId()
local string detectName946=""
local string detectTarget946=""
local string detectSource947="玩家/引擎或未标记来源（无脚本行号）"
// No shared state or handle creation/destruction is allowed below this local gate.
if B946DetectEnabled[detectViewer946] and IsUnitType(detectUnit946,UNIT_TYPE_HERO) and IsUnitSelected(detectUnit946,GetLocalPlayer()) then
set detectName946=B946OrderName(detectOrder946)
if detectName946!="" then
if B947OrderUnit==detectUnit946 and B947OrderId==detectOrder946 and B947OrderSite!="" then
if (B947OrderKind==1 and GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_ORDER) or (B947OrderKind==2 and GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER) or (B947OrderKind==3 and GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER and B947OrderTarget==GetOrderTarget()) then
set detectSource947=B947OrderSite
endif
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER then
set detectTarget946=" 坐标=("+R2S(GetOrderPointX())+","+R2S(GetOrderPointY())+")"
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
if GetOrderTargetUnit()!=null then
set detectTarget946=" 目标="+GetUnitName(GetOrderTargetUnit())+"#"+I2S(GetHandleId(GetOrderTargetUnit()))
elseif GetOrderTargetItem()!=null then
set detectTarget946=" 物品="+GetItemName(GetOrderTargetItem())+"#"+I2S(GetHandleId(GetOrderTargetItem()))
elseif GetOrderTargetDestructable()!=null then
set detectTarget946=" 可破坏物="+GetDestructableName(GetOrderTargetDestructable())+"#"+I2S(GetHandleId(GetOrderTargetDestructable()))
endif
endif
call DisplayTimedTextToPlayer(GetLocalPlayer(),0.,0.,5.,"|cff80ffff[detect "+R2S(TimerGetElapsed(W))+"s]|r "+GetUnitName(detectUnit946)+"#"+I2S(GetHandleId(detectUnit946))+" [P"+I2S(GetPlayerId(GetOwningPlayer(detectUnit946))+1)+"] "+detectName946+" ("+I2S(detectOrder946)+")"+detectTarget946+"\n    来源："+detectSource947)
endif
endif
set detectUnit946=null
return false
endfunction
function B964Reset takes nothing returns nothing
local integer i964=0
loop
exitwhen i964>=1024
set B960H8Source[i964]="开启前未采集"
set B960H8Change[i964]="开启前未采集"
set B960H8Time[i964]=0
set B960Entry[i964]=0
set B960EntryTime[i964]=0
set B960Next[i964]=0
set B961Next[i964]=0
set B961Reason[i964]="开启前未采集"
set B962FlagWrite[i964]="开启前未采集"
set B962FlagChange[i964]="开启前未采集"
set B962FlagTime[i964]=0
set B962StateNext[i964]=0
set B962AvoidNext[i964]=0
set B962AvoidLast[i964]="开启前未采集"
set B950RetreatPending[i964]=""
set i964=i964+1
endloop
endfunction
function B946DetectCommand takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local integer detectPlayer946=GetPlayerId(b1060GetTriggerPlayer)
set B946DetectEnabled[detectPlayer946]=not B946DetectEnabled[detectPlayer946]
if B946DetectEnabled[detectPlayer946] then
set B946DetectCount=B946DetectCount+1
if B946DetectCount==1 then
call B964Reset()
endif
call EnableTrigger(B946DetectOrders)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0.,0.,10.,"|cff80ffff[detect]|r 已开启：选中英雄后显示其新收到的普通命令及脚本函数/行号，不显示技能或物品施放。再次输入 -detect 关闭。")
else
set B946DetectCount=B946DetectCount-1
if B946DetectCount==0 then
call DisableTrigger(B946DetectOrders)
endif
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0.,0.,5.,"|cff80ffff[detect]|r 已关闭。")
endif
set b1060GetTriggerPlayer=null
endfunction
// Reuse B942 Preload file output: first wave, one-shot ten minutes, completion.
// No recurring timer, polling, file reads, order/damage hook, or native trace.
function B1037LogSafe takes string matchText returns string
local integer matchPos=0
local string matchChar
local string matchClean=""
loop
exitwhen matchPos>=StringLength(matchText)
set matchChar=SubString(matchText,matchPos,matchPos+1)
if matchChar=="\"" then
set matchChar="'"
elseif matchChar=="\\" then
set matchChar="/"
elseif matchChar=="\n" or matchChar=="\r" then
set matchChar=" "
endif
set matchClean=matchClean+matchChar
set matchPos=matchPos+1
endloop
return matchClean
endfunction
function B1037LogStamp takes nothing returns string
return I2S(MHTool_GetLocalTime(1))+"-"+I2S(MHTool_GetLocalTime(2))+"-"+I2S(MHTool_GetLocalTime(3))+"_"+I2S(MHTool_GetLocalTime(4))+"-"+I2S(MHTool_GetLocalTime(5))+"-"+I2S(MHTool_GetLocalTime(6))+"_"+I2S(MHTool_GetLocalTime(7))
endfunction
function B1037LogObject takes integer matchObject returns string
if matchObject==0 then
return "未选择/未分配 [0]"
endif
return B1037LogSafe(GetObjectName(matchObject))+" ["+SuijiTavernB750_RawId(matchObject)+"/"+I2S(matchObject)+"]"
endfunction
function B1037LogWrite takes string matchStatus returns nothing
local integer matchRow=0
call PreloadGenClear()
call PreloadStart()
call Preload(B1037LogHeader)
call Preload("STATUS="+matchStatus)
loop
exitwhen matchRow>=B1037LogCount
call Preload(B1037LogRows[matchRow])
set matchRow=matchRow+1
endloop
call PreloadGenEnd(B1037LogPath)
call PreloadGenClear()
endfunction
function B1038LogUltimate takes unit ultimateLogHero,integer ultimateLogApplied,integer ultimateLogPending returns string
local integer ultimateLogChoice=0
local integer ultimateLogSelected=0
if ultimateLogApplied!=0 then
return B1037LogObject(ultimateLogApplied)+" (已学习)"
endif
if ultimateLogPending!=0 then
return B1037LogObject(ultimateLogPending)+" (已选，尚未学习)"
endif
// Legacy choice dialog also stores a selection before granting the ability.
set ultimateLogChoice=OM7(GetHandleId(ultimateLogHero),"SuijiUltSelectedChoice")
if ultimateLogChoice>0 then
set ultimateLogSelected=OM7(GetHandleId(ultimateLogHero),"SuijiUltChoice"+I2S(ultimateLogChoice)+"Skill")
if ultimateLogSelected!=0 then
return B1037LogObject(ultimateLogSelected)+" (已选，尚未学习)"
endif
endif
if GetPlayerController(GetOwningPlayer(ultimateLogHero))==MAP_CONTROL_COMPUTER then
if GetHeroLevel(ultimateLogHero)<5 then
return "尚未到5级抽取 [0]"
endif
return "已到5级，尚未成功抽取 [0]"
endif
return "尚未选择 [0]"
endfunction
function B1038LogBindQuit takes nothing returns nothing
local integer quitLogButton=0
local integer quitLogBinding=0
if B1038LogConfirmBound or B1038LogConfirmTrigger==null then
return
endif
set quitLogButton=MHFrame_GetByName("ConfirmQuitQuitButton",0)
if quitLogButton!=0 then
set quitLogBinding=MHFrameEvent_Register(B1038LogConfirmTrigger,quitLogButton,EVENT_ID_FRAME_MOUSE_CLICK)
set B1038LogConfirmBound=quitLogBinding!=0
endif
endfunction
function B1038LogCapture takes string matchPhase returns nothing
local integer matchPid=0
local integer matchHandle=0
local integer matchSmall=0
local integer matchUlt=0
local integer matchPending=0
local integer matchIndex=0
local unit matchHero=null
local string matchKind
local string matchIdentity
// Append one bounded 12-slot snapshot; previous rows are never replaced.
set B1037LogRows[B1037LogCount]="SNAPSHOT phase="+matchPhase+" captured="+B1037LogStamp()+" elapsed="+R2S(TimerGetElapsed(W)-M_4)
set B1037LogCount=B1037LogCount+1
loop
exitwhen matchPid>=12
set matchHero=M7[matchPid]
if GetPlayerSlotState(Player(matchPid))==PLAYER_SLOT_STATE_PLAYING or KKServerScore_InitialHuman[matchPid] or (matchHero!=null and GetUnitTypeId(matchHero)!=0) then
set matchKind="AI"
set matchIdentity="AI-slot-"+I2S(matchPid+1)
if KKServerScore_InitialHuman[matchPid] or GetPlayerController(Player(matchPid))==MAP_CONTROL_USER then
set matchKind="HUMAN"
set matchIdentity=B894PlayerIdentity[matchPid]
if matchIdentity==null or matchIdentity=="" then
set matchIdentity="平台完整ID未取得"
endif
endif
set B1037LogRows[B1037LogCount]="PLAYER slot="+I2S(matchPid+1)+" kind="+matchKind+" id="+B1037LogSafe(matchIdentity)+" initial_name="+B1037LogSafe(KZ4[matchPid])+" display_name="+B1037LogSafe(GetPlayerName(Player(matchPid)))+" left="+I2S(B287_BoolToInt(KKServerScore_Left[matchPid]))
set B1037LogCount=B1037LogCount+1
if matchHero!=null and GetUnitTypeId(matchHero)!=0 then
set matchHandle=GetHandleId(matchHero)
set matchSmall=OM7(matchHandle,"SuijiSmallSkill")
set matchUlt=OM7(matchHandle,"SuijiUltSkill")
set matchPending=OM7(matchHandle,"SuijiTavernUltPendingSkill")
set matchIndex=LoadInteger(L7,matchHandle,StringHash("SuijiStableHeroIndex"))
// Read the stable identity without calling the getter that writes its cache.
if matchIndex<KL4 or matchIndex>K54 then
set matchIndex=GetUnitPointValue(matchHero)
endif
set B1037LogRows[B1037LogCount]="HERO slot="+I2S(matchPid+1)+" name="+B1037LogSafe(GetUnitName(matchHero))+" type="+B1037LogObject(GetUnitTypeId(matchHero))+" stable_index="+I2S(matchIndex)
set B1037LogCount=B1037LogCount+1
set B1037LogRows[B1037LogCount]="RANDOM slot="+I2S(matchPid+1)+" small="+B1037LogObject(matchSmall)+" ultimate="+B1038LogUltimate(matchHero,matchUlt,matchPending)+" learned_ultimate="+B1037LogObject(matchUlt)+" pending_ultimate="+B1037LogObject(matchPending)
set B1037LogCount=B1037LogCount+1
else
set B1037LogRows[B1037LogCount]="HERO slot="+I2S(matchPid+1)+" 未选择英雄；随机技能未分配"
set B1037LogCount=B1037LogCount+1
endif
endif
set matchPid=matchPid+1
endloop
set matchHero=null
endfunction
function B1037LogStart takes nothing returns nothing
local integer matchLocal=GetPlayerId(GetLocalPlayer())
local string matchStamp
// Local diagnostic state only; no handles or gameplay state are created here.
if B1037LogStarted or matchLocal>=12 or GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER or GetPlayerSlotState(GetLocalPlayer())!=PLAYER_SLOT_STATE_PLAYING then
return
endif
set B1037LogStarted=true
call B1038LogBindQuit()
set matchStamp=B1037LogStamp()
set B1037LogPath="1-miao-error\\"+matchStamp+"_p"+I2S(matchLocal+1)+" "+KK_RELEASE_VERSION+" match.text"
set B1037LogHeader=KK_RELEASE_VERSION+" MATCH snapshot; recorder=B1038 created="+matchStamp+" local_slot="+I2S(matchLocal+1)+" epoch="+I2S(B836ArcEpoch[matchLocal])+" test="+I2S(B287_BoolToInt(B1031TestMatch))+" first_wave_t="+R2S(TimerGetElapsed(W)-M_4)+" native_detect="+I2S(B287_BoolToInt(B1121DetectEnabled))+" detect_config="+B1121DetectStatus
call B1038LogCapture("FIRST_WAVE")
call B1037LogWrite("OPEN / 尚未收到正常结束或本地退出回调")
endfunction
function B1038LogTenSnapshot takes nothing returns nothing
if not B1037LogStarted or B1037LogFinished or B1038LogTenWritten then
return
endif
set B1038LogTenWritten=true
call B1038LogCapture("TEN_MINUTES")
call B1037LogWrite("OPEN / 已补充第10分钟快照，尚未收到正常结束或本地退出回调")
endfunction
function B1038LogTenMinute takes nothing returns nothing
local timer tenLogTimer=GetExpiredTimer()
// Synchronous lifecycle: destroy the one-shot timer before any local guards.
call PauseTimer(tenLogTimer)
call DestroyTimer(tenLogTimer)
set tenLogTimer=null
call B1038LogTenSnapshot()
endfunction
function B1038LogBegin takes nothing returns nothing
local timer beginLogTimer=null
// This guard and timer are shared on all clients, unlike local file state.
if B1038LogScheduled then
return
endif
set B1038LogScheduled=true
set beginLogTimer=CreateTimer()
call TimerStart(beginLogTimer,600.,false,function B1038LogTenMinute)
set beginLogTimer=null
call B1037LogStart()
endfunction
function B1037LogFinish takes string matchReason returns nothing
if not B1037LogStarted or B1037LogFinished then
return
endif
set B1037LogFinished=true
// Rewrite this file once with the original cached roster and its final status.
call B1037LogWrite("NORMAL_END / 正常结束; reason="+matchReason+" ended="+B1037LogStamp()+" elapsed="+R2S(TimerGetElapsed(W)-M_4))
endfunction
function B1038LogConfirmQuit takes nothing returns nothing
// Exact final confirmation button, not the menu's Quit or Cancel buttons.
call B1037LogFinish("F10确认主动退出")
endfunction
function B1037LogVictory takes nothing returns nothing
call B1037LogFinish("胜负结算 winner_team="+I2S(O94))
endfunction
function B1037LogExit takes nothing returns nothing
// MemHack local normal game-exit callback; never synchronize local state.
call B1037LogFinish("本地退出回调")
endfunction
function B1038LogStop takes nothing returns nothing
// The game-stop callback covers returning to the menu without exiting the process.
call B1037LogFinish("本地游戏停止回调")
endfunction
function B1037LogLeave takes nothing returns nothing
// Other players leaving must not close this client's record.
if GetTriggerPlayer()==GetLocalPlayer() then
call B1037LogFinish("本地玩家离开事件")
endif
endfunction
function B1037LogInit takes nothing returns nothing
local trigger matchLeaveTrigger=CreateTrigger()
local trigger matchExitTrigger=CreateTrigger()
local trigger matchStopTrigger=CreateTrigger()
local integer matchRegister=0
loop
exitwhen matchRegister>=12
call TriggerRegisterPlayerEvent(matchLeaveTrigger,Player(matchRegister),EVENT_PLAYER_LEAVE)
set matchRegister=matchRegister+1
endloop
call TriggerAddAction(matchLeaveTrigger,function B1037LogLeave)
call TriggerAddAction(matchExitTrigger,function B1037LogExit)
call MHGameExitEvent_Register(matchExitTrigger)
call TriggerAddAction(matchStopTrigger,function B1038LogStop)
call MHGameStopEvent_Register(matchStopTrigger)
// Create handles on every client in the shared init path; only UI binding is local.
set B1038LogConfirmTrigger=CreateTrigger()
call TriggerAddAction(B1038LogConfirmTrigger,function B1038LogConfirmQuit)
call B1038LogBindQuit()
set matchLeaveTrigger=null
set matchExitTrigger=null
set matchStopTrigger=null
endfunction
