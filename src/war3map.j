function S4D takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit Z69=(LoadUnitHandle(L7,(V07),(2)))
local real S7D=0.
if Z69==null or GetUnitTypeId(Z69)==0 then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
set t=null
set Z69=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set S7D=GetUnitState(Z69,UNIT_STATE_LIFE)
if (b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId!='A04Q') or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId=='A04Q' and GetTriggerEvalCount(t)==1) then
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId=='A04Q' then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
else
call UnitRemoveAbility(Z69,'A1R0')
call UnitRemoveAbility(Z69,'B0D5')
call B_7(Z69,0)
