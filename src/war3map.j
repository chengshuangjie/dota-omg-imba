function B979InitData takes nothing returns nothing
if B979DataReady then
return
endif
call ExecuteFunc("B979Data0")
call ExecuteFunc("B979Data1")
call ExecuteFunc("B979Data2")
call ExecuteFunc("B979Data3")
call ExecuteFunc("B979Data4")
call ExecuteFunc("B979Data5")
set B979DataReady=true
endfunction
function B979PoolSlot takes integer skill979,boolean ultimate979 returns integer
local integer row979=KL4
loop
exitwhen row979>SUIJI_POOL_MAX
if ultimate979 then
if HP4[row979]==skill979 then
return row979*8+4
elseif HQ4[row979]==skill979 then
return row979*8+5
endif
else
if HM4[row979]==skill979 then
return row979*8+1
elseif HN4[row979]==skill979 then
return row979*8+2
elseif HO4[row979]==skill979 then
return row979*8+3
endif
endif
set row979=row979+1
endloop
if ultimate979 and skill979=='A1YQ' then
return 50*8+6
endif
return 0
endfunction
function B979SlotHelper takes integer slot979 returns integer
local integer row979=slot979/8
local integer kind979=ModuloInteger(slot979,8)
if kind979==1 then
return HR4[row979]
elseif kind979==2 then
return HS4[row979]
elseif kind979==3 then
return HT4[row979]
elseif kind979==4 then
return HU4[row979]
elseif kind979==5 then
return HV4[row979]
endif
return 0
endfunction
function B979SlotOrder takes integer slot979 returns string
local integer row979=slot979/8
local integer kind979=ModuloInteger(slot979,8)
if kind979==1 then
return HW4[row979]
elseif kind979==2 then
return HX4[row979]
elseif kind979==3 then
return HY4[row979]
elseif kind979==4 or kind979==5 then
return HZ4[row979]
elseif kind979==6 then
return "magicdefense"
endif
return ""
endfunction
function B979PairValid takes unit hero979,integer key979 returns boolean
local integer small979=B979SmallPool[key979]
local integer ult979=B979UltPool[key979]
local integer sh979=0
local integer uh979=0
local string so979=""
local string uo979=""
local string alternate979=""
if small979==0 or ult979==0 or small979==ult979 then
return false
endif
if SuijiMode_IsRandomPoolExcludedSkill(small979) or SuijiMode_IsRandomPoolExcludedSkill(ult979) or SuijiMode_IsUltimateOnlySkill(small979) then
return false
endif
set B979SmallSlot=B979PoolSlot(small979,false)
set B979UltSlot=B979PoolSlot(ult979,true)
if B979SmallSlot==0 or B979UltSlot==0 then
return false
endif
set sh979=B979SlotHelper(B979SmallSlot)
set uh979=B979SlotHelper(B979UltSlot)
set so979=B979SlotOrder(B979SmallSlot)
set uo979=B979SlotOrder(B979UltSlot)
if sh979!=0 and sh979==uh979 then
return false
endif
if not SuijiMode_CanUseSkill(hero979,small979,sh979,so979) or not SuijiMode_CanUseSkill(hero979,ult979,uh979,uo979) then
return false
endif
set so979=SuijiMode_ResolveAlternateCarrierOrder(hero979,small979,SuijiMode_RandomOrder(small979,so979))
set uo979=SuijiMode_ResolveAlternateCarrierOrder(hero979,ult979,SuijiMode_RandomOrder(ult979,uo979))
// Reserve both orders before adding either skill. An alternate may belong to either slot.
if so979!="passive" and so979==uo979 then
set alternate979=SuijiMode_GetAlternateCarrierOrder(ult979)
if alternate979!=null and alternate979!="" and alternate979!=so979 and not SuijiMode_HasOrderConflict(hero979,ult979,alternate979) then
set uo979=alternate979
else
set alternate979=SuijiMode_GetAlternateCarrierOrder(small979)
if alternate979!=null and alternate979!="" and alternate979!=uo979 and not SuijiMode_HasOrderConflict(hero979,small979,alternate979) then
set so979=alternate979
else
return false
endif
endif
endif
set B979SmallOrder=so979
set B979UltOrder=uo979
return true
endfunction
function B979ChoosePair takes unit hero979 returns integer
local integer handle979=GetHandleId(hero979)
local integer index979=SuijiMode_GetStableHeroIndex(hero979)
local integer chosen979=OM7(handle979,"B979Pair")
local integer number979=1
local integer count979=0
local integer key979=0
if chosen979!=0 then
return chosen979
endif
if not B979DataReady then
call ExecuteFunc("B979InitData")
endif
loop
exitwhen number979>5
set key979=index979*5+number979
if B979PairValid(hero979,key979) then
set count979=count979+1
if GetRandomInt(1,count979)==1 then
set chosen979=key979
call NP7(handle979,"B979SmallSlot",B979SmallSlot)
call NP7(handle979,"B979UltSlot",B979UltSlot)
call NR7(handle979,"B979SmallOrder",B979SmallOrder)
call NR7(handle979,"B979UltOrder",B979UltOrder)
endif
endif
set number979=number979+1
endloop
if chosen979==0 then
set chosen979=-1
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00AI高难技能组合："+GetUnitName(hero979)+" 暂无兼容的预设组合，本英雄使用普通组合。|r")
else
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00AI高难技能组合："+GetUnitName(hero979)+" 选用第"+I2S(chosen979-index979*5)+"套，额外技能为 "+GetAbilityName(B979SmallPool[chosen979])+" + "+GetAbilityName(B979UltPool[chosen979])+"。|r")
endif
call NP7(handle979,"B979Pair",chosen979)
return chosen979
endfunction
function B979GrantPairSlot takes unit hero979,integer level979,boolean ultimate979 returns integer
local integer handle979=GetHandleId(hero979)
local integer key979=OM7(handle979,"B979Pair")
local integer slot979=0
local integer skill979=0
local string mark979="SuijiSmall"
if key979<=0 then
return 0
endif
if ultimate979 then
set mark979="SuijiUlt"
set skill979=B979UltPool[key979]
set slot979=OM7(handle979,"B979UltSlot")
return SuijiMode_AddSkill(hero979,skill979,B979SlotHelper(slot979),OP7(handle979,"B979UltOrder"),level979,SuijiMode_GetPoolSkillSource(slot979/8,skill979),mark979)
endif
set skill979=B979SmallPool[key979]
set slot979=OM7(handle979,"B979SmallSlot")
return SuijiMode_AddSkill(hero979,skill979,B979SlotHelper(slot979),OP7(handle979,"B979SmallOrder"),level979,SuijiMode_GetPoolSkillSource(slot979/8,skill979),mark979)
endfunction

// B1095: copied counters and orb state belong to this new unit, never its source.
function B1095TempestCopyRuntimeState takes unit source1095,unit double1095 returns nothing
local integer sourceHandle1095=GetHandleId(source1095)
local integer doubleHandle1095=GetHandleId(double1095)
local integer orbLevel1095=0
local integer soulLevel1095=GetUnitAbilityLevel(source1095,'A0CQ')
if (B287_GetUnitAbilityLevel(double1095,'A0BR')>0 or B287_GetUnitAbilityLevel(double1095,'A0FU')>0) and soulLevel1095>0 then
if Necromastery_SyncSoulLevel(double1095,soulLevel1095) then
call SaveInteger(L7,doubleHandle1095,710,soulLevel1095)
endif
endif
set orbLevel1095=B287_GetUnitAbilityLevel(source1095,'A21X')
if orbLevel1095<=0 then
set orbLevel1095=OM7(sourceHandle1095,"WexLevel")
endif
if orbLevel1095>0 then
call NP7(doubleHandle1095,"WexLevel",orbLevel1095)
endif
set orbLevel1095=B287_GetUnitAbilityLevel(source1095,'A21W')
if orbLevel1095<=0 then
set orbLevel1095=OM7(sourceHandle1095,"QuasLevel")
endif
if orbLevel1095>0 then
call NP7(doubleHandle1095,"QuasLevel",orbLevel1095)
endif
set orbLevel1095=B287_GetUnitAbilityLevel(source1095,'A21V')
if orbLevel1095<=0 then
set orbLevel1095=OM7(sourceHandle1095,"ExortLevel")
endif
if orbLevel1095>0 then
call NP7(doubleHandle1095,"ExortLevel",orbLevel1095)
endif
if SuijiMode_IsInvokerUnit(source1095) then
call NP7(doubleHandle1095,"Invoker|OrbFirst",OM7(sourceHandle1095,"Invoker|OrbFirst"))
call NP7(doubleHandle1095,"Invoker|OrbSecond",OM7(sourceHandle1095,"Invoker|OrbSecond"))
call NP7(doubleHandle1095,"Invoker|OrbThird",OM7(sourceHandle1095,"Invoker|OrbThird"))
call NP7(doubleHandle1095,"Invoker|Wex",OM7(sourceHandle1095,"Invoker|Wex"))
call NP7(doubleHandle1095,"Invoker|Quas",OM7(sourceHandle1095,"Invoker|Quas"))
call NP7(doubleHandle1095,"Invoker|Exort",OM7(sourceHandle1095,"Invoker|Exort"))
call NP7(doubleHandle1095,"Invoker|Current1",OM7(sourceHandle1095,"Invoker|Current1"))
call NP7(doubleHandle1095,"Invoker|Current2",OM7(sourceHandle1095,"Invoker|Current2"))
call NP7(doubleHandle1095,"Invoker|Current3",OM7(sourceHandle1095,"Invoker|Current3"))
call VLF(double1095,OM7(doubleHandle1095,"Invoker|Wex"),OM7(doubleHandle1095,"Invoker|Quas"),OM7(doubleHandle1095,"Invoker|Exort"))
call VUF(double1095)
call VZF(double1095)
if B287_GetUnitAbilityLevel(double1095,'A21W')>0 then
call VRF(double1095)
call B1027TempestTrackListener(double1095,LoadTriggerHandle(L7,doubleHandle1095,StringHash("Invoker|QuasTrigger")))
endif
endif
endfunction
// Rebuild learned native skills and the random small skill without sharing runtime handles.
function B849TempestInherit takes nothing returns nothing
local unit b849Source=B849TempestSource
local unit b849Double=B849TempestDouble
local integer b849Skill=0
local integer b849Level=0
local integer b998Index=1
local integer b998Hero=0
local integer b998Physical=0
local integer b998Seen=0
local integer pair1095=-1
set B849TempestSource=null
set B849TempestDouble=null
if b849Source==null or b849Double==null or B287_GetUnitAbilityLevel(b849Source,'A2M0')<=0 or not DGFS(b849Double) then
set b849Source=null
set b849Double=null
return
endif
call NS7(GetHandleId(b849Double),"B849TempestOwned",true)
// Enable ordinary passive/event consumers without enrolling in random selection.
call NS7(GetHandleId(b849Double),"SuijiDone",true)
// Rebuild learned native slots on the same hero type, including native ultimates.
// Runtime handles and active cast state always belong to the new unit.
set b998Hero=SuijiMode_GetStableHeroIndex(b849Source)
call NP7(GetHandleId(b849Double),"SuijiStableHeroIndex",b998Hero)
loop
exitwhen b998Index>15
if b998Index<=5 then
set b849Skill=LoadInteger(R1Y,GetUnitTypeId(b849Source),b998Index)
else
set b849Skill=LoadInteger(MSK,b998Hero,b998Index-5)
endif
if b849Skill!=0 and b849Skill!='A2M0' then
set b849Level=B287_GetUnitAbilityLevel(b849Source,b849Skill)
set b998Physical=B287_GetPhysicalAbilityId(b849Source,b849Skill)
// A native learn slot may expose only its Scepter variant, outside R1Y/MSK.
set pair1095=SuijiMode_FindAghPair(b849Skill)
if pair1095>=0 and YTI[pair1095]==b849Skill then
set b849Level=IMaxBJ(b849Level,B287_GetUnitAbilityLevel(b849Source,YRI[pair1095]))
if B287_GetUnitAbilityLevel(b849Source,YRI[pair1095])>0 then
// Keep native engine pairs on their live face and scripted pairs on the base.
set b998Physical=SuijiMode_ScepterRegistryResolvePairPhysical(b849Source,b849Skill,YRI[pair1095])
endif
endif
set b998Seen=StringHash("B998Native:"+I2S(b998Physical))
if b849Level>0 and not LoadBoolean(L7,GetHandleId(b849Double),b998Seen) then
call SaveBoolean(L7,GetHandleId(b849Double),b998Seen,true)
call UnitAddAbility(b849Double,b998Physical)
call SetUnitAbilityLevel(b849Double,b998Physical,b849Level)
call SuijiMode_InitCopiedSkill(b849Double,b849Skill,b849Level)
endif
endif
set b998Index=b998Index+1
endloop
call UnitRemoveAbility(b849Double,B287_GetPhysicalAbilityId(b849Source,'A2M0'))
call UnitRemoveAbility(b849Double,'A2M0')
call SetHeroStr(b849Double,GetHeroStr(b849Source,false),true)
call SetHeroAgi(b849Double,GetHeroAgi(b849Source,false),true)
call SetHeroInt(b849Double,GetHeroInt(b849Source,false),true)
if GetUnitTypeId(b849Double)=='HMD0' then
set MiaoEntryUnit=b849Double
call Miao_RegisterCurrent()
endif
if GetUnitAbilityLevel(b849Source,'A330')>0 then
call XF7(b849Double,'A330')
endif
set b849Skill=OM7(GetHandleId(b849Source),"SuijiSmallSkill")
if b849Skill!=0 and b849Skill!='A2M0' and SuijiMode_IsUltimateOnlySkill(b849Skill)==false then
set b849Level=B287_GetUnitAbilityLevel(b849Source,b849Skill)
if b849Level>0 then
// The preset pool contains base logical skills, not swapped Scepter faces.
set pair1095=SuijiMode_FindAghPair(b849Skill)
if pair1095>=0 then
set b849Skill=YTI[pair1095]
endif
call SuijiTest_AddPresetSkill(b849Double,b849Skill,b849Level,"SuijiSmall")
endif
endif
// UpdateLevels has a snapshot-owner guard: never roll or level an ultimate here.
call NS7(GetHandleId(b849Double),"SuijiAghForceUpdate",true)
call SuijiMode_UpdateAghSkills(b849Double)
call B1095TempestCopyRuntimeState(b849Source,b849Double)
set B849TempestDouble=b849Double
call ExecuteFunc("B1095TempestRegisterCurrent")
set B849TempestDouble=null
call SuijiMode_SyncRandomAttackRange(b849Double)
// Reconcile copied item charges after inventory and skill inheritance finish.
call B852MidasSchedule(b849Double)
set b849Source=null
set b849Double=null
endfunction
function SuijiMode_RestoreSkill takes unit u,string mark,integer level returns nothing
local integer h=0
local integer skill=0
local integer physicalSkill=0
local integer currentLevel=0
local player p=null
local string order=""
local boolean restored=false
local boolean suijiRestoreSkillChanged=false
local boolean suijiVisibilityRepair=false
local real restoreCooldown=0.
local integer restoreLevel=0
local boolean physicalWasPresent=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set suijiVisibilityRepair=SuijiMode_NeedsVisibilityRepair(u)
set skill=OM7(h,mark+"Skill")
set physicalSkill=OM7(h,mark+"Ability")
set order=OP7(h,mark+"Order")
if skill=='A0MP' and mark=="SuijiSmall" then
set level=SuijiMode_SmallLevel(u)
set order="passive"
endif
if skill==0 then
set order=""
return
endif
if physicalSkill==0 then
set physicalSkill=SuijiMode_GetGrantSkill(skill)
call NP7(h,mark+"Ability",physicalSkill)
endif
set p=GetOwningPlayer(u)
set currentLevel=GetUnitAbilityLevel(u,physicalSkill)
set physicalWasPresent=currentLevel>0
if currentLevel==0 then
if SuijiMode_EnsureExactLiveAbility(u,physicalSkill,true)==false then
call SuijiMode_MarkUnitVisibilityDirty(u)
set order=""
set p=null
return
endif
set restored=true
set suijiRestoreSkillChanged=true
set currentLevel=GetUnitAbilityLevel(u,physicalSkill)
endif
if level>0 then
set restoreLevel=level
else
set restoreLevel=currentLevel
endif
// Visibility repair alone only needs the player-level show/hide API.  Enter
// exact-live inspection only when this function must actually create or level
// a physical ability; this keeps the original integrity repair without
// scanning an unchanged command card after every spell.
if currentLevel!=restoreLevel then
if physicalWasPresent and SuijiMode_HasExactLiveAbility(u,physicalSkill) then
set restoreCooldown=YDWEGetUnitAbilityState(u,physicalSkill,1)
endif
if SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,restoreLevel)==false then
call SuijiMode_MarkUnitVisibilityDirty(u)
set order=""
set p=null
return
endif
set suijiRestoreSkillChanged=true
endif
if restored then
call SuijiMode_InitCopiedSkill(u,skill,restoreLevel)
endif
if (restored or suijiRestoreSkillChanged) and SuijiMode_HasNativeAbility(u,physicalSkill)==false then
call SuijiMode_MarkUnitVisibilityDirty(u)
set order=""
set p=null
return
endif
if (restored or suijiRestoreSkillChanged) and GetUnitAbilityLevel(u,physicalSkill)!=restoreLevel then
if SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,restoreLevel)==false then
call SuijiMode_MarkUnitVisibilityDirty(u)
set order=""
set p=null
return
endif
set suijiRestoreSkillChanged=true
endif
if SuijiMode_IsUnifiedOrbSkill(skill) and physicalSkill!=skill and SuijiMode_IsNativeRegisteredSkill(u,skill)==false then
call UnitRemoveAbility(u,skill)
endif
// A temporary command such as Ice Blast Release or X Mark Return exclusively
// owns this slot while its state controller is active.  B544's generic repair
// must not expose the physical base button beside that temporary command.
if (restored or suijiRestoreSkillChanged or suijiVisibilityRepair) and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,physicalSkill,true)
endif
if suijiRestoreSkillChanged then
call SuijiMode_RestoreAbilityCooldown(u,physicalSkill,restoreLevel,restoreCooldown)
endif
if restored or suijiRestoreSkillChanged then
if skill=='A4DJ' or skill=='A4DZ' then
call Reset_Skill_range(u)
endif
call SuijiMode_ApplyHotkey(u,physicalSkill,mark,order)
endif
if restored then
call B287_RestoreToggleState(u,skill)
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
if restored or suijiRestoreSkillChanged then
call NS7(h,"SuijiAghForceUpdate",true)
endif
if SuijiMode_IsUnifiedOrbSkill(skill) then
call SuijiMode_ForcePassiveOrbs(u)
endif
// Fixed clones are level bridges for Multiple_Skill families, not a second
// visible charge. Re-converge ownership only after an actual skill/visibility
// change; unchanged learned-skill events must not rewrite the command card.
if restored or suijiRestoreSkillChanged then
call SuijiMode_ApplyInstantOrderCarrierCastpoint(u,skill)
if skill=='A0VC' then
call SuijiMode_StartMarksmanshipTimer(u)
endif
call SuijiMode_UpdateArcaneBlinkRandomCastpoints(u)
endif
if restored or suijiRestoreSkillChanged or suijiVisibilityRepair then
call SuijiMode_SyncOwnedChargeButtonSlot(u,skill,mark)
endif
set order=""
set p=null
endfunction
function SuijiMode_EnsureAIOriginalUltimate takes unit u,integer level returns nothing
local integer h=0
local integer idx=0
local integer skill=0
local integer physicalSkill=0
local integer before=0
local integer tries=0
local real cooldown=0.
local player p=null
if u==null or GetUnitTypeId(u)==0 or level<=0 or SUIJI_MODE==false then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiDone")==false then
return
endif
set p=GetOwningPlayer(u)
if GetPlayerController(p)!=MAP_CONTROL_COMPUTER then
set p=null
return
endif
set idx=SuijiMode_GetStableHeroIndex(u)
if idx<KL4 or idx>K54 then
set p=null
return
endif
set skill=SuijiMode_GetAIOriginalUltimate(idx)
if skill==0 then
set p=null
return
endif
if skill=='A01Y' then
set before=IMaxBJ(GetUnitAbilityLevel(u,'A01Y'),GetUnitAbilityLevel(u,'A4KM'))
if before<level then
call SetPlayerAbilityAvailable(p,'A01Y',true)
loop
exitwhen IMaxBJ(GetUnitAbilityLevel(u,'A01Y'),GetUnitAbilityLevel(u,'A4KM'))>=level or GetHeroSkillPoints(u)<=0 or tries>=3
call SelectHeroSkill(u,'A01Y')
set tries=tries+1
endloop
set before=IMaxBJ(GetUnitAbilityLevel(u,'A01Y'),GetUnitAbilityLevel(u,'A4KM'))
if before>0 and before<level then
set physicalSkill=SuijiMode_ScepterRegistryResolvePairPhysical(u,'A01Y','A4KM')
call SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,level)
endif
endif
if ON7(h,"SuijiReincarnationReadyAt")>TimerGetElapsed(W) then
call SuijiMode_StartReincarnationCooldownGuard(u)
endif
set p=null
return
endif
set physicalSkill=B287_GetLearnableAbilityId(skill)
set before=B287_GetUnitAbilityLevel(u,skill)
if before<level then
if before>0 then
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
if SuijiMode_HasExactLiveAbility(u,physicalSkill) then
set cooldown=YDWEGetUnitAbilityState(u,physicalSkill,1)
endif
endif
call SetPlayerAbilityAvailable(p,physicalSkill,true)
loop
exitwhen B287_GetUnitAbilityLevel(u,skill)>=level or GetHeroSkillPoints(u)<=0 or tries>=3
call SelectHeroSkill(u,physicalSkill)
set tries=tries+1
endloop
if B287_GetUnitAbilityLevel(u,skill)==0 then
if SuijiMode_EnsureExactLiveAbilityLevel(u,physicalSkill,level,true)==false then
set p=null
return
endif
call SuijiMode_InitCopiedSkill(u,skill,level)
endif
if B287_GetUnitAbilityLevel(u,skill)<level then
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
if SuijiMode_SetExactLiveAbilityLevel(u,physicalSkill,level)==false then
set p=null
return
endif
endif
if cooldown>0. then
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
call SuijiMode_RestoreAbilityCooldown(u,physicalSkill,B287_GetUnitAbilityLevel(u,skill),cooldown)
endif
endif
set p=null
endfunction
function SuijiMode_RestorePlayerAbility takes unit u,player p,integer skill returns nothing
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,B287_GetPhysicalAbilityId(u,skill),true)
endif
endfunction
function SuijiMode_RestoreRegisteredHeroSkills takes unit u returns nothing
local integer idx=0
local integer i=1
local integer skill=0
local player p=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
if SuijiMode_IsInvokerUnit(u) then
return
endif
set idx=SuijiMode_GetStableHeroIndex(u)
if idx<=0 then
return
endif
set p=GetOwningPlayer(u)
loop
exitwhen i>10
set skill=LoadInteger(MSK,idx,i)
if skill!=0 and SuijiMode_IsTransientStateButton(skill)==false and B287_GetUnitAbilityLevel(u,skill)>0 and SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(p,B287_GetPhysicalAbilityId(u,skill),true)
endif
set i=i+1
endloop
set p=null
endfunction
function SuijiMode_RestoreBaseHeroSkills takes unit u returns nothing
local integer idx=0
local player p=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
if SuijiMode_NeedsVisibilityRepair(u)==false then
return
endif
if OO7(GetHandleId(u),"SuijiDone") then
call SuijiAI_RestoreVisibleSkills(u)
endif
set idx=SuijiMode_GetStableHeroIndex(u)
call SuijiMode_RestoreRegisteredHeroSkills(u)
if idx<KL4 or idx>K54 then
call SuijiMode_CommitVisibilityRepair(u)
return
endif
set p=GetOwningPlayer(u)
call SuijiMode_RestorePlayerAbility(u,p,HM4[idx])
call SuijiMode_RestorePlayerAbility(u,p,HN4[idx])
call SuijiMode_RestorePlayerAbility(u,p,HO4[idx])
call SuijiMode_RestorePlayerAbility(u,p,HP4[idx])
call SuijiMode_RestorePlayerAbility(u,p,HQ4[idx])
call SuijiMode_SyncNativeButtonSlots(u)
if LoadInteger(L7,GetHandleId(u),739)>0 then
call YLG(u,LoadInteger(L7,GetHandleId(u),739))
endif
call SuijiMode_RemoveYellowBonusIcons(u)
call SuijiMode_CommitVisibilityRepair(u)
set p=null
endfunction
