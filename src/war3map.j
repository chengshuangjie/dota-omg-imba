local real d=2
local string FR9="Use"
if FP9 then
set FR9="Store"
endif
if FO9=='I006' then
set FQ9="|c00ff0000"+GetObjectName('n0JQ')+"|r"
call C27("Rune"+FR9+"1",GetPlayerId(p))
elseif FO9=='I008' then
set FQ9="|c0000ff00"+GetObjectName('n0JN')+"|r"
call C27("Rune"+FR9+"2",GetPlayerId(p))
elseif FO9=='I00K' then
set FQ9="|c000000ff"+GetObjectName('n0K3')+"|r"
call C27("Rune"+FR9+"3",GetPlayerId(p))
elseif FO9=='I007' then
set FQ9="|c00afaf00"+GetObjectName('n0K2')+"|r"
call C27("Rune"+FR9+"4",GetPlayerId(p))
elseif FO9=='I00J' then
set FQ9="|c00652DC1"+GetObjectName('n0K4')+"|r"
call C27("Rune"+FR9+"5",GetPlayerId(p))
elseif FO9=='I0PJ' or FO9=='I0Q5' then
set FQ9="|c00FFD700"+GetObjectName('n0MT')+"|r"
call C27("Rune"+FR9+"6",GetPlayerId(p))
endif
if FP9 then
set s=Q[GetPlayerId(p)]+GetUnitName(WI7)+"|r "+GetObjectName('n0GU')+"|r "+FQ9+" "+GetObjectName('n0GW')
    set d=1
else
if FO9=='I00K' then
        call ADD_DOUBLE_ATTACK_BUFF(WI7)
    endif
    if NH then
set s=Q[GetPlayerId(p)]+GetUnitName(WI7)+"|r "+GetObjectName('n0GV')+"|r "+FQ9+" "+GetObjectName('n0GW')
    else
set s=Q[GetPlayerId(p)]+GetUnitName(WI7)+"|r "+GetObjectName('n0GT')+"|r "+FQ9+" "+GetObjectName('n0GW')
    endif
endif
if(IsPlayerAlly(GetLocalPlayer(),p)and GetLocalPlayer()!=p)or WG7(GetLocalPlayer())then
    call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,d,s)
endif
endfunction
