call XF7(WX7,W8F)
call XF7(WX7,WFF)
elseif V1F==0 and V0F==0 and V5F==3 then
call XF7(WX7,WDF)
call XF7(WX7,WEF)
call XF7(WX7,WFF)
elseif V1F==0 and V0F==3 and V5F==0 then
call XF7(WX7,W7F)
call XF7(WX7,W8F)
call XF7(WX7,W9F)
endif
endfunction
function A0E takes nothing returns nothing
local unit WX7=IN4
local integer I97=GetHandleId(WX7)
local integer WGF=OM7(I97,"Invoker|OrbFirst")
local integer WHF=OM7(I97,"Invoker|OrbSecond")
local integer WIF=OM7(I97,"Invoker|OrbThird")
local integer V1F=0
local integer V0F=0
local integer V5F=0
if WGF=='A21X' then
set V1F=V1F+1
elseif WGF=='A21W' then
set V0F=V0F+1
elseif WGF=='A21V' then
set V5F=V5F+1
endif
if WHF=='A21X' then
set V1F=V1F+1
elseif WHF=='A21W' then
set V0F=V0F+1
elseif WHF=='A21V' then
set V5F=V5F+1
endif
if WIF=='A21X' then
set V1F=V1F+1
elseif WIF=='A21W' then
set V0F=V0F+1
elseif WIF=='A21V' then
set V5F=V5F+1
endif
call VLF(WX7,V1F,V0F,V5F)
set WX7=null
endfunction
function WJF takes nothing returns nothing
local unit hn=GetTriggerUnit()
local integer OB7=GetHandleId(hn)
local integer WKF=B287_GetSpellAbilityId()
local integer WMF=OM7(OB7,"Invoker|OrbFirst")
local integer WNF=OM7(OB7,"Invoker|OrbSecond")
local integer WOF=OM7(OB7,"Invoker|OrbThird")
local integer VVF=0
local integer VWF=0
local integer VXF=0
set WMF=WNF
set WNF=WOF
set WOF=WKF
if WMF=='A21X' then
set VVF=VVF+1
elseif WMF=='A21W' then
set VWF=VWF+1
elseif WMF=='A21V' then
set VXF=VXF+1
endif
if WNF=='A21X' then
set VVF=VVF+1
elseif WNF=='A21W' then
set VWF=VWF+1
elseif WNF=='A21V' then
set VXF=VXF+1
endif
if WOF=='A21X' then
set VVF=VVF+1
elseif WOF=='A21W' then
set VWF=VWF+1
elseif WOF=='A21V' then
set VXF=VXF+1
endif
call NP7(OB7,"Invoker|OrbFirst",WMF)
call NP7(OB7,"Invoker|OrbSecond",WNF)
call NP7(OB7,"Invoker|OrbThird",WOF)
call NP7(OB7,"Invoker|Wex",VVF)
call NP7(OB7,"Invoker|Quas",VWF)
call NP7(OB7,"Invoker|Exort",VXF)
call VLF(hn,VVF,VWF,VXF)
call VUF(hn)
call VZF(hn)
endfunction
function WPF takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if b1060B287_GetSpellAbilityId=='A21X' or b1060B287_GetSpellAbilityId=='A21W' or b1060B287_GetSpellAbilityId=='A21V' then
call WJF()
elseif b1060B287_GetSpellAbilityId=='A21Y' or b1060B287_GetSpellAbilityId=='A1GU' then
    call SuijiMode_ApplyInvokerInvokeAghState(b1060GetTriggerUnit,b1060B287_GetSpellAbilityId)
    if  ThreeSkill[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))]==1 or GetPlayerController(GetOwningPlayer(b1060GetTriggerUnit))==MAP_CONTROL_COMPUTER then
        call VAF()
    else
        call VAF2()
    endif
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function MP8 takes nothing returns nothing
local trigger t=CreateTrigger()
set BS[1]='A0VS'
set BS[2]='A0VK'
set BS[3]='A0VQ'
set BS[4]='A0XL'
set BS[5]='A0VM'
set BS[6]='A0VN'
set BS[7]='A0VO'
set BS[8]='A0VP'
set BS[9]='A0VG'
set BS[10]='A0VZ'
call X_7(BS[1])
call X_7(BS[2])
call X_7(BS[3])
call X_7(BS[4])
call X_7(BS[5])
call X_7(BS[6])
call X_7(BS[7])
call X_7(BS[8])
