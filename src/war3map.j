elseif (b1060GetTriggerEventId==EVENT_UNIT_DEATH and b1060GetTriggerUnit==m5) or XH7(m5)then
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
call X37(GetOwningPlayer(p5),GetObjectName('n03F'))
elseif (b1060GetTriggerEventId==EVENT_UNIT_DEATH and b1060GetTriggerUnit==p5) or p5==null or XH7(p5)then
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call X37(GetOwningPlayer(p5),GetObjectName('n03G'))
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
