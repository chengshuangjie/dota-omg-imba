function B907HasItem takes unit healOwner,integer healItemId returns boolean
local integer healSlot=0
local item healItem=null
if healOwner==null or GetUnitTypeId(healOwner)==0 then
return false
endif
loop
exitwhen healSlot>5
set healItem=UnitItemInSlot(healOwner,healSlot)
if healItem!=null and GetItemTypeId(healItem)==healItemId then
set healItem=null
return true
endif
set healSlot=healSlot+1
endloop
set healItem=null
return false
endfunction
function B907RealHero takes unit healHero returns boolean
