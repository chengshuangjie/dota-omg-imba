function B933RadianceStop takes trigger radianceController returns nothing
local integer radianceKey=GetHandleId(radianceController)
local integer radianceUnitKey=LoadInteger(L7,radianceKey,StringHash("B933RadianceUnitKey"))
if radianceController==null then
return
endif
call DisableTrigger(radianceController)
if LoadTriggerHandle(L7,radianceUnitKey,StringHash("B933RadianceController"))==radianceController then
call RemoveSavedHandle(L7,radianceUnitKey,StringHash("B933RadianceController"))
endif
