function SFFQ_ELQX takes nothing returns nothing
	local unit target = Wave_U
	local unit u = Wave_Sou
	if u!=null and target!=null and GetUnitTypeId(u)!=0 and GetUnitTypeId(target)!=0 and GetUnitAbilityLevel(u,'A4L7')>0 and GetPrdRandom(u, 'A4L7', IMinBJ(20*imbaMult,100)) and UnitAlive(target) then
        call ELQX(u,target)
	endif
	set target = null
	set u = null
endfunction
function SFFQ3 takes nothing returns nothing
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
	local unit u = GetTriggerUnit()
	local integer level = 0
	local real x = 0.
	local real y = 0.
	local real length
    local integer ZZMF_level=0
    local integer ZZMF=0
    if u==null or GetUnitTypeId(u)==0 then
        set u=null
        return
    endif
    set level = GetUnitAbilityLevel(u, 'A02M')
    set x = GetUnitX(u)
    set y = GetUnitY(u)
    set ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1010+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=960+ZZMF
    else
    set length=810+ZZMF
    endif
    if GetUnitAbilityLevel(u,'A4L7')>0 then
        call Wave(u,'h0HM', 25 + 75 * level, length, 150, 300, x, y, b1060GetSpellTargetX, b1060GetSpellTargetY, 1100, 1, false, "SFFQ_ELQX", level)
    else
        call Wave(u,'h0HM', 25 + 75 * level, length, 150, 300, x, y, b1060GetSpellTargetX, b1060GetSpellTargetY, 1100, 1, false, "", level)
    endif
    set u=null
endfunction
function SFFQ2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A02M' then
call SFFQ3()
endif
return false
endfunction
