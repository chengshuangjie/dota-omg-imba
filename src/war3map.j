call TriggerAddCondition(t2,Condition(function DXG))
call SaveUnitHandle(L7,(IED),(2),(ZX7))
call SaveReal(L7,(IED),(6),((GetUnitX(ZX7))*1.))
call SaveReal(L7,(IED),(7),((GetUnitY(ZX7))*1.))
call SaveInteger(L7,(IED),(375),(I97))
set ZX7=null
set t=null
endfunction
