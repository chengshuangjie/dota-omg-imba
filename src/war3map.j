//蜘蛛网
function RQD takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0BG'
endfunction
function RRD takes nothing returns nothing
local unit xv=GetTriggerUnit()
local unit xU=null
local integer OB7=0
local integer V77=0
local integer xV=0
local unit xw=null
local integer x=1
local integer number=0
if xv==null or GetUnitTypeId(xv)==0 then
set xv=null
return
endif
set xU=CreateUnit(GetOwningPlayer(xv), 'o003', GetSpellTargetX(), GetSpellTargetY(), 0)
set OB7=GetHandleId(xv)
set V77=B287_GetUnitAbilityLevel(xv,'A0BG')
set xV=OM7(OB7,"TotalWebs")
set xw=O77(OB7,"Web1")
set number=V77*2
if SuijiMode_ScepterRegistryIsActive(xv,'A0BG') then
set number=number+8
endif
call SetUnitAnimation(xU, "birth")
call QueueUnitAnimation(xU, "stand")
set xV=xV+1
call SetUnitVertexColorBJ(xU,100,100,100,80)
call XF7(xU,'Aloc')
call NT7(OB7,"Web"+I2S(xV),xU)
if(xV>number)then
call KillUnit(xw)
loop
exitwhen x==xV
call NT7(OB7,"Web"+I2S(x),O77(OB7,"Web"+I2S(x+1)))
set x=x+1
endloop
set xV=xV-1
endif
call NP7(OB7,"TotalWebs",xV)
call SetUnitAbilityLevel(xU,'A0BF',V77)
set xU=null
set xv=null
set xw=null
endfunction
function HH8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RQD))
call TriggerAddAction(t,function RRD)
set t=null
endfunction
function RSD takes unit xv returns nothing
local integer OB7=0
local integer V77=0
local integer xV=0
local integer x=1
local unit VX
if xv==null or GetUnitTypeId(xv)==0 then
set VX=null
return
endif
set OB7=GetHandleId(xv)
set V77=B287_GetUnitAbilityLevel(xv,'A0BG')
set xV=OM7(OB7,"TotalWebs")
loop
exitwhen x>xV
set VX=O77(OB7,"Web"+I2S(x))
if VX!=null and GetUnitTypeId(VX)!=0 then
call SetUnitAbilityLevel(VX,'A0BF',V77)
endif
set x=x+1
endloop
set VX=null
endfunction
function RTD takes nothing returns nothing
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local unit RUD=O77(GetHandleId(b1060GetTriggeringTrigger),"Spider")
if RUD==null or GetUnitTypeId(RUD)==0 then
call FlushChildHashtable(L7,(GetHandleId(b1060GetTriggeringTrigger)))
call OZ7(b1060GetTriggeringTrigger)
else
if IsUnitType(RUD,UNIT_TYPE_HERO) then
if GetUnitAbilityLevel(RUD,'B01C')>0 then
call XF7(RUD,'A021')
else
call UnitRemoveAbility(RUD,'A021')
endif
else
if GetUnitAbilityLevel(RUD,'B01C')>0 then
call XF7(RUD,'A29C')
else
call UnitRemoveAbility(RUD,'A29C')
endif
endif
endif
set RUD=null
set b1060GetTriggeringTrigger=null
endfunction
function RVD takes unit ZX7 returns nothing
local integer OB7=0
local trigger t=null
if ZX7==null or GetUnitTypeId(ZX7)==0 then
return
endif
set OB7=GetHandleId(ZX7)
set t=LoadTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
if t!=null and OZ7_IsQueued(t)==false then
set t=null
return
endif
set t=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(t,1.5)
call TriggerAddAction(t,function RTD)
call NT7(GetHandleId(t),"Spider",ZX7)
call SaveTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"),t)
set t=null
endfunction
// Snapshot the actual caster, not the owner's current hero (wheel replacement).
function B1010GrowSpider takes unit b1010Spider,unit b1010Summoner returns nothing
local unit b1010Hero=null
local integer b1010Attribute=0
local real b1010Damage=0.
local real b1010Life=0.
if b1010Spider==null or GetUnitTypeId(b1010Spider)!='n019' or b1010Summoner==null then
return
endif
if IsUnitType(b1010Summoner,UNIT_TYPE_HERO) then
set b1010Hero=b1010Summoner
else
set b1010Hero=LoadUnitHandle(L7,GetHandleId(b1010Summoner),StringHash("B1010SpiderCaster"))
endif
if b1010Hero==null or GetUnitTypeId(b1010Hero)==0 or not IsUnitType(b1010Hero,UNIT_TYPE_HERO) then
set b1010Hero=null
return
endif
if LoadBoolean(L7,GetHandleId(b1010Spider),StringHash("B1010SpiderGrown")) then
set b1010Hero=null
return
endif
call SaveBoolean(L7,GetHandleId(b1010Spider),StringHash("B1010SpiderGrown"),true)
set b1010Attribute=WH7(b1010Hero)
if b1010Attribute==3 then
set b1010Damage=GetHeroStr(b1010Hero,true)*.15
elseif b1010Attribute==2 then
set b1010Damage=GetHeroAgi(b1010Hero,true)*.15
else
set b1010Damage=GetHeroInt(b1010Hero,true)*.15
endif
set b1010Life=GetUnitState(b1010Spider,UNIT_STATE_MAX_LIFE)+GetUnitState(b1010Hero,UNIT_STATE_MAX_LIFE)*.10
call SetUnitState(b1010Spider,UNIT_STATE_MAX_LIFE,b1010Life)
call SetUnitState(b1010Spider,UNIT_STATE_LIFE,b1010Life)
call SetUnitState(b1010Spider,UNIT_STATE_ATTACK1_DAMAGE_BASE,GetUnitState(b1010Spider,UNIT_STATE_ATTACK1_DAMAGE_BASE)+I2R(R2I(b1010Damage)))
set b1010Hero=null
endfunction
// Parasite births also enter the world; finish growth after native unit setup.
function B1014SpiderBirthFinish takes nothing returns nothing
local timer b1014BirthTimer=GetExpiredTimer()
local unit b1014Spider=LoadUnitHandle(L7,GetHandleId(b1014BirthTimer),0)
local unit b1014Hero=null
local integer b1014SpiderKey=GetHandleId(b1014Spider)
if b1014Spider!=null and GetUnitTypeId(b1014Spider)=='n019' then
set b1014Hero=LoadUnitHandle(L7,b1014SpiderKey,StringHash("B1014SpiderHero"))
call B1010GrowSpider(b1014Spider,b1014Hero)
endif
call RemoveSavedHandle(L7,b1014SpiderKey,StringHash("B1014SpiderHero"))
call RemoveSavedBoolean(L7,b1014SpiderKey,StringHash("B1014SpiderQueued"))
call FlushChildHashtable(L7,GetHandleId(b1014BirthTimer))
call PauseTimer(b1014BirthTimer)
call DestroyTimer(b1014BirthTimer)
set b1014BirthTimer=null
set b1014Spider=null
set b1014Hero=null
endfunction
function B1014QueueSpiderBirth takes unit b1014Spider,unit b1014Parent returns nothing
local unit b1014Hero=null
local timer b1014BirthTimer=null
local integer b1014SpiderKey=GetHandleId(b1014Spider)
if b1014Spider==null or GetUnitTypeId(b1014Spider)!='n019' or LoadBoolean(L7,b1014SpiderKey,StringHash("B1010SpiderGrown")) then
return
endif
if b1014Parent!=null then
if LoadReal(L7,GetHandleId(b1014Parent),StringHash("B1014SpiderSourceUntil"))>=TimerGetElapsed(W) then
set b1014Hero=LoadUnitHandle(L7,GetHandleId(b1014Parent),StringHash("B1010SpiderCaster"))
endif
if b1014Hero==null and IsUnitType(b1014Parent,UNIT_TYPE_HERO) and B287_GetUnitAbilityLevel(b1014Parent,'A0BH')>0 then
set b1014Hero=b1014Parent
endif
endif
if b1014Hero!=null then
// A real summon event overrides the entry fallback with the original caster.
call SaveUnitHandle(L7,b1014SpiderKey,StringHash("B1014SpiderHero"),b1014Hero)
elseif LoadUnitHandle(L7,b1014SpiderKey,StringHash("B1014SpiderHero"))==null then
// Capture now, never look up a replacement hero in the delayed callback.
set b1014Hero=M7[GetPlayerId(GetOwningPlayer(b1014Spider))]
if b1014Hero!=null and GetUnitTypeId(b1014Hero)!=0 and B287_GetUnitAbilityLevel(b1014Hero,'A0BH')>0 and LoadReal(L7,GetHandleId(b1014Hero),StringHash("B1014SpiderSourceUntil"))>=TimerGetElapsed(W) then
call SaveUnitHandle(L7,b1014SpiderKey,StringHash("B1014SpiderHero"),b1014Hero)
endif
endif
if not LoadBoolean(L7,b1014SpiderKey,StringHash("B1014SpiderQueued")) then
call SaveBoolean(L7,b1014SpiderKey,StringHash("B1014SpiderQueued"),true)
set b1014BirthTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b1014BirthTimer),0,b1014Spider)
call TimerStart(b1014BirthTimer,0.,false,function B1014SpiderBirthFinish)
endif
set b1014Hero=null
set b1014BirthTimer=null
endfunction
function B1014SpiderEntered takes nothing returns boolean
if GetUnitTypeId(GetEnteringUnit())=='n019' then
call B1014QueueSpiderBirth(GetEnteringUnit(),null)
endif
return false
endfunction
function RWD takes nothing returns boolean
local unit b1060GetSummonedUnit=GetSummonedUnit()
local boolean b1060ReturnValue
if GetUnitTypeId(b1060GetSummonedUnit)=='n01E' or GetUnitTypeId(b1060GetSummonedUnit)=='n019' then
call B1014QueueSpiderBirth(b1060GetSummonedUnit,GetSummoningUnit())
call RVD(b1060GetSummonedUnit)
endif
set b1060ReturnValue=false
set b1060GetSummonedUnit=null
return b1060ReturnValue
endfunction
function RXD takes unit WI7,boolean UA9 returns nothing
local trigger t
if B287_GetUnitAbilityLevel(WI7,'A0BG')==1 or UA9 then
call RVD(WI7)
else
call RSD(WI7)
endif
if UA9 then
set t=LoadTriggerHandle(L7,GetHandleId(WI7),StringHash("SpiderWebPeriodicTrigger"))
set aj[GetPlayerId(GetOwningPlayer(WI7))]=t
endif
set t=null
endfunction
function SuijiMode_ClearSpiderWebState takes unit ZX7 returns nothing
local integer OB7=0
local integer total=0
local integer x=1
local unit Web=null
local trigger periodic=null
if ZX7==null then
return
endif
set OB7=GetHandleId(ZX7)
set total=OM7(OB7,"TotalWebs")
loop
exitwhen x>total
set Web=O77(OB7,"Web"+I2S(x))
if Web!=null then
call RemoveUnit(Web)
endif
call RemoveSavedHandle(L7,OB7,StringHash("Web"+I2S(x)))
set x=x+1
endloop
call NP7(OB7,"TotalWebs",0)
set periodic=LoadTriggerHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
if periodic!=null then
if aj[GetPlayerId(GetOwningPlayer(ZX7))]==periodic then
set aj[GetPlayerId(GetOwningPlayer(ZX7))]=null
endif
call FlushChildHashtable(L7,GetHandleId(periodic))
call OZ7(periodic)
call RemoveSavedHandle(L7,OB7,StringHash("SpiderWebPeriodicTrigger"))
endif
set Web=null
set periodic=null
endfunction
function XXZZW2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endif
call SuijiMode_ClearSpiderWebState(ZX7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
