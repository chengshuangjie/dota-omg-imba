function SXD takes nothing returns nothing
local unit IH7=GetEnumUnit()
local unit SYD=GetTriggerUnit()
local integer SZD=GetHeroInt(SYD,true)-GetHeroInt(IH7,true)
local integer array SAD
local integer BC7=B287_GetUnitAbilityLevel(SYD,'A0OK')
local integer SBD=7+1*BC7
local real d
local boolean b1030PriorDamageFlag=Fe
if SuijiMode_ScepterRegistryIsActive(SYD,'A0OK') then
set SBD=9+1*BC7
endif
set SAD[1]=$A
set SAD[2]=30
set SAD[3]=50
set d=SZD*SBD
if(SZD>0)then
if OT7(IH7,"BorrowedTime|Active") and d>=GetUnitState(IH7,UNIT_STATE_MAX_LIFE) then
set d=GetUnitState(IH7,UNIT_STATE_MAX_LIFE)-50
endif
if((LoadInteger(L7,(GetHandleId((IH7))),((2485))))==1)and d>=GetUnitState(IH7,UNIT_STATE_LIFE)-2 then
set d=GetUnitState(IH7,UNIT_STATE_LIFE)-2
endif
if(SZD>SAD[BC7])then
set Fe=true
call UnitDamageTarget(SYD,IH7,d,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
set Fe=b1030PriorDamageFlag
call YW7(I2S(R2I(d)),3,IH7,.023,$D8,30,30,$D8)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",IH7,"overhead"))
endif
if(SZD<=SAD[BC7])then
set Fe=true
call UnitDamageTarget(SYD,IH7,d,true,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
set Fe=b1030PriorDamageFlag
call YW7(I2S(R2I(d)),3,IH7,.023,$D8,30,30,$D8)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",IH7,"overhead"))
call SetUnitState(IH7,UNIT_STATE_MANA,GetUnitState(IH7,UNIT_STATE_MANA)*.25)
endif
elseif(SZD<=0)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl",IH7,"overhead"))
call SetUnitState(IH7,UNIT_STATE_MANA,GetUnitState(IH7,UNIT_STATE_MANA)*.25)
endif
set IH7=null
set SYD=null
endfunction
