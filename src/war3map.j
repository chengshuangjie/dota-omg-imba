call SetUnitFacing(ZX7,a)
call SetUnitAnimationByIndex(ZX7,0)
if GetTriggerEvalCount(t)==30 then
call SetUnitInvulnerable(ZX7,true)
endif
if GetTriggerEvalCount(t)>30 then
if IL6==0 then
set g=WS7()
call GroupEnumUnitsInRange(g,Y_D,Z4D,150+25,Condition(function ZIJ6))
if FirstOfGroup(g)!=null then
if(GetUnitTypeId((FirstOfGroup(g)))=='o01Y')==false then
call KillUnit(FirstOfGroup(g))
endif
set IL6=1
call SaveInteger(L7,(I97),(34),(IL6))
endif
call WR7(g)
endif
if IL6==1 then
set r=r*2
endif
if IN6!=null then
set a=J47(ZX7,IN6)
call SaveReal(L7,(I97),(137),((a)*1.0))
endif
set x=H71+0.02*r*Cos(a*bj_DEGTORAD)
set y=H81+0.02*r*Sin(a*bj_DEGTORAD)
call SetUnitX(ZX7,X17(x))
call SetUnitY(ZX7,X07(y))
call SaveReal(L7,(I97),(6),((GetUnitX(ZX7))*1.0))
call SaveReal(L7,(I97),(7),((GetUnitY(ZX7))*1.0))
call SetUnitX(BB7,GetUnitX(ZX7))
call SetUnitY(BB7,GetUnitY(ZX7))
call Y67(GetUnitX(ZX7),GetUnitY(ZX7),100)
set d=KF7(H71,H81,GetUnitX(ZX7),GetUnitY(ZX7))
set AR3=AR3+d
call SaveReal(L7,(I97),(138),((AR3)*1.0))
set g=WS7()
set IN4=ZX7
set JYI=ZX7
set JKI=BQ9
set JLI=1
set JJI=null
set JSI=100
set JTI=IL6
set JRI=null
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),150+25,Condition(function AJ7_gai))
call ForGroup(g,function ZIY6)
call WR7(g)
if JRI!=null then
set g=WS7()
set JJI=null
set QQJ=9999
call GroupEnumUnitsInRange(g,GetUnitX(JRI),GetUnitY(JRI),600+25,Condition(function ZIV6))
call WR7(g)
if JJI==null then
set IM6=true
set JJI=JRI
else
set IN6=JJI
call SaveUnitHandle(L7,(I97),(810),(IN6))
endif
endif
else
call SetUnitX(ZX7,H71)
call SetUnitY(ZX7,H81)
if YM8(ZX7)then
set IM6=true
endif
endif
if suijiDisplacementCount<1 then
set suijiDisplacementCount=1
endif
if YM8(ZX7)or b1060GetTriggerEventId==EVENT_WIDGET_DEATH or IM6 or(IN6==null and(GetTriggerEvalCount(t)>130*suijiDisplacementCount or JOI or(IL6==0 and AR3>800*suijiDisplacementCount)or(IL6==1 and AR3>1600*suijiDisplacementCount)))then
call KillUnit(BB7)
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call UnitAddAbility(ZX7,'A2VA')
call UnitRemoveAbility(ZX7,'A2VA')
call SetUnitTimeScale(ZX7,1)
call SetUnitInvulnerable(ZX7,false)
if JOI==true then
set x=GetUnitX(JJI)+50*Cos(a*bj_DEGTORAD)
set y=GetUnitY(JJI)+50*Sin(a*bj_DEGTORAD)
call SetUnitX(ZX7,X17(x))
call SetUnitY(ZX7,X07(y))
call B947IssueTargetOrder("ZIK6 @ war3map.j:75730 (B968)",ZX7,"attack",JJI)
endif
endif
set ZX7=null
set t=null
set g=null
set BQ9=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
