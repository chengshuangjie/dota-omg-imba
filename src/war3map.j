local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
if m5!=null and GetUnitTypeId(m5)!=0 then
call UnitRemoveAbility(m5,'B07W')
call UnitRemoveAbility(m5,'Bblo')
call UnitRemoveAbility(m5,'B062')
call UnitRemoveAbility(m5,'Bcrs')
call UnitRemoveAbility(m5,'B016')
call UnitRemoveAbility(m5,'B05R')
