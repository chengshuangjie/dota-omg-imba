function ClickOrderSetUpSaveButton takes nothing returns nothing
    local string s = ""
    local integer i = 0
    local string VH
	call ShowSetUpPanel(false)
	call MapSettingsShortcut_SetOpen(false)
	call ClearAllEditBoxFocus()
	if MapSettingsShortcutDirectOpen then
		call MapSettingsShortcut_RestoreParent()
	else
		call DzClickFrame(DzFrameFindByName("PreviousButton",0))
	endif
	call DzFrameSetParent(UIFrame__ToolTip,GameUI)
    loop
        if UIFrame__IsCheckBoxEnable[i] then
            set VH = "N"
        else
            set VH = "O"
        endif
        set s = s + VH
        exitwhen i == 23
		set i = i + 1
    endloop
	call DzAPI_Map_SaveServerValue(GetLocalPlayer(),"XOMG1_SETUP","1;"+s)
	set i=1
	set s=""
	loop
		set VH=MHMath_ToHex(LocalCommandButtonHotKey[i])
		set VH=SubString(VH,StringLength(VH)-2,StringLength(VH))
		set s=s+VH
		exitwhen i==18
		set i=i+1
	endloop
	call DzAPI_Map_SaveServerValue(GetLocalPlayer(),"XOMG1_HOTKEY","1;"+s)
	set i=1
	set s=""
	loop
		set s=s+I2S(HotKeyQuickCast[i])
		exitwhen i==18
		set i=i+1
	endloop
	call DzAPI_Map_SaveServerValue(GetLocalPlayer(),"XOMG1_SPELL","1;"+s)
	call ClearTextMessages()
	call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|CFFFF8000[设置]|R |c006699CC地图设置与改键数据|r |cFF00FF00已保存|r")
endfunction
function GetLocalPlayerSetUp takes nothing returns nothing
    local string s=""
    local integer i = 0
    local integer key
    local boolean hasSetup=true
    local boolean hasHotKeys=true
    local string optionDefault="ONN"
    set ServerValue = DzAPI_Map_GetServerValue(GetLocalPlayer(), "XOMG1_SETUP")
	if ServerValue!=null and StringLength(ServerValue)>=2 and SubString(ServerValue,0,2)=="1;" then
		set ServerValue=SubString(ServerValue,2,StringLength(ServerValue))
	endif
	set s = SubString(ServerValue, 0 , 1)
    if ServerValue == null or ServerValue == "" or (s != "N" and s != "O") then //N开 O关
        if SPEPLAYER[GetPlayerId(GetLocalPlayer())]==1 then
            set ServerValue="OONONNNOONNNNONNNNNONNN"
        elseif SPEPLAYER[GetPlayerId(GetLocalPlayer())]==2 then
            set ServerValue="NONONNNOOONNOONNNNNOONN"
        elseif SPEPLAYER[GetPlayerId(GetLocalPlayer())]==20 then
            set ServerValue="NONONNNOOONNOONNNNNOONN"
        elseif SPEPLAYER[GetPlayerId(GetLocalPlayer())]==23 then
            set ServerValue="NONONNNOOONNOONNNNNOONN"
        else
			set hasSetup=false
        endif
	elseif StringLength(ServerValue)<23 then
		if SPEPLAYER[GetPlayerId(GetLocalPlayer())]==1 then
			set optionDefault="NNN"
		endif
		set ServerValue=SubString(ServerValue,0,20)+optionDefault
    endif
	// Legacy 23-character settings: duplicate the old shared hero restriction;
	// move the original-key blocking flag from index 22 to index 23.
	if hasSetup and StringLength(ServerValue)==23 then
		set ServerValue=SubString(ServerValue,0,22)+SubString(ServerValue,21,22)+SubString(ServerValue,22,23)
	endif
	if hasSetup then
		loop
			set s=SubString(ServerValue,i,i+1)
			set UIFrame__IsCheckBoxEnable[i]=s=="N"
			if Default_SetUp[i]!=UIFrame__IsCheckBoxEnable[i] then
				call Click_SetUp_GlueCheckBox_Actions(i)
				call DzFrameShow(UIFrame__HighLight[i],UIFrame__IsCheckBoxEnable[i])
			endif
			exitwhen i==23
			set i=i+1
		endloop
	endif
	set ServerValue=DzAPI_Map_GetServerValue(GetLocalPlayer(),"XOMG1_HOTKEY")
	if ServerValue!=null and StringLength(ServerValue)>=2 and SubString(ServerValue,0,2)=="1;" then
		set ServerValue=SubString(ServerValue,2,StringLength(ServerValue))
	endif
	if ServerValue==null or StringLength(ServerValue)<36 then
		if SPEPLAYER[GetPlayerId(GetLocalPlayer())]==1 then
			set ServerValue="7172343520C0000000000000000000000000"
		else
			set hasHotKeys=false
		endif
	endif
	if hasHotKeys then
		set i=1
		loop
			set s=SubString(ServerValue,(i-1)*2,i*2)
			set key=MHMath_ToDec("000000"+s)
			set s=HotKeyDisplayStr(key)
			if key==0 or s=="" then
				call DzFrameSetText(HotKeyButton[i],"-")
			else
				call DzFrameSetText(HotKeyButton[i],s)
			endif
			set LocalCommandButtonHotKey[i]=key
			exitwhen i==18
			set i=i+1
		endloop
	endif
	set ServerValue=DzAPI_Map_GetServerValue(GetLocalPlayer(),"XOMG1_SPELL")
	if ServerValue!=null and StringLength(ServerValue)>=2 and SubString(ServerValue,0,2)=="1;" then
		set ServerValue=SubString(ServerValue,2,StringLength(ServerValue))
	endif
	if ServerValue!=null and StringLength(ServerValue)>=18 then
		set i=1
		loop
			set s=SubString(ServerValue,i-1,i)
			set HotKeyQuickCast[i]=0
			if s=="1" then
				set HotKeyQuickCast[i]=1
			endif
			call DzFrameShow(HotKeyQuickCastHighlight[i],HotKeyQuickCast[i]==1)
			exitwhen i==18
			set i=i+1
		endloop
	endif
endfunction
function InitMainUI takes nothing returns nothing
	local integer clearBtn
 	// 实际上应该为常量,但无法在全局变量中声明
	set GameUI = DzGetGameUI()
	// 加载toc fdf模板
	call DzLoadToc("UI\\path.toc")
	//======================================================================
	// 防御符文按钮
	//======================================================================
	// 防御符文按钮
	//======================================================================
	// 防御符文按钮
	set GlyphFrame = DzCreateFrameByTagName("TEXTBUTTON", "name", GameUI, "Glyph_Button", 0)
	call DzFrameSetPoint(GlyphFrame, 4, DzFrameGetMinimap(), 4, 0.087, -0.061)
	call SetFrameToolTip( GlyphFrame, "激活 防御符文", "在5秒内，使你方阵营所有的建筑物对物理攻击免疫，高地塔和门牙塔获得四重攻击的能力。|n|n|cff99ccff团队冷却时间：|r5分钟" )
	//======================================================================
	// 工具提示
	//======================================================================
	// 工具提示
	//======================================================================
	// 工具提示
	set UIFrame__ToolTip = DzCreateFrameByTagName("FRAME", null, GameUI, null, 0)
	set UIBackDrop__ToolTip = DzCreateFrameByTagName("BACKDROP", null, UIFrame__ToolTip, "TooltipBackDrop", 0)
	set UIText__ToolTip = DzCreateFrameByTagName("TEXT", null, UIBackDrop__ToolTip, "TooltipText", 0)
	set UIText__ToolUberTip = DzCreateFrameByTagName("TEXT", null, UIBackDrop__ToolTip, "TooltipText", 0)
	call DzFrameSetSize(UIText__ToolTip, 0.209, 0)
	call DzFrameSetSize(UIText__ToolUberTip, 0.209, 0)
	// 设置"提示背景"的左上为"提示"的左上
	call DzFrameSetPoint(UIBackDrop__ToolTip, 0, UIText__ToolTip, 0, - 0.005, 0.005)
	// 设置"提示"的底部为"扩展提示"的顶部
	call DzFrameSetPoint(UIText__ToolTip, 6, UIText__ToolUberTip, 0, 0, 0.005)
	// 设置"提示背景"的右下为"扩展提示"的右下
	call DzFrameSetPoint(UIBackDrop__ToolTip, 8, UIText__ToolUberTip, 8, 0.005, - 0.005)
	call DzFrameSetAbsolutePoint(UIText__ToolUberTip, 8, 0.7935, 0.168)
	call DzFrameShow( UIFrame__ToolTip, false )
	call DzFrameSetPriority( UIFrame__ToolTip ,  100 )
	//======================================================================
	// 捕捉点击血条的按钮
	//======================================================================
	// 捕捉点击血条的按钮
