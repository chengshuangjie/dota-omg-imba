function Bedlam_Action takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(TABLE_XJ,(OB7),(2)))
local unit IH7=(LoadUnitHandle(TABLE_XJ,(OB7),(3)))
local unit u1=(LoadUnitHandle(TABLE_XJ,(OB7),(17)))
local unit u2=(LoadUnitHandle(TABLE_XJ,(OB7),(19)))
local integer level=(LoadInteger(TABLE_XJ,(OB7),(5)))
local real x
local real y
local real a
local real XGI=0
local real XHI=0
local real J72=-1*360*0.01/1.5
local integer WF8=GetTriggerEvalCount(t)
local real W9I
local group g
local boolexpr bedlamEnemyFilter=null
local unit u
if ZX7==null or IH7==null or u1==null or u2==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or GetUnitTypeId(u1)==0 or GetUnitTypeId(u2)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
if u1!=null then
call RemoveUnit(u1)
endif
if u2!=null then
call RemoveUnit(u2)
endif
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set t=null
set u1=null
set u2=null
set ZX7=null
set IH7=null
set u=null
set g=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set XGI=GetUnitX(IH7)
set XHI=GetUnitY(IH7)
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or WF8==500 then
call RemoveUnit(u1)
call RemoveUnit(u2)
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
else
set W9I=90
set a=W9I+J72*WF8
set x=CoordinateX50(XGI+200*Cos(a*bj_DEGTORAD))
set y=CoordinateY50(XHI+200*Sin(a*bj_DEGTORAD))
call SetUnitX(u1,x)
call SetUnitY(u1,y)
call SetUnitX(u2,x)
call SetUnitY(u2,y)
call MHUnit_SetFacing(u1,a-90,true)
if ModuloInteger(WF8,25)==0 then
set U22=ZX7
set g=WS7()
set bedlamEnemyFilter=Condition(function DKX)
call GroupEnumUnitsInRange(g,XGI,XHI,300,bedlamEnemyFilter)
call DestroyBoolExpr(bedlamEnemyFilter)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
call B67(ZX7,u,1,15+45*level)
endloop
call WR7(g)
endif
endif
set t=null
set u1=null
set u2=null
set ZX7=null
set IH7=null
set u=null
set g=null
set bedlamEnemyFilter=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function Bedlam_Main takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer level=0
local trigger t=null
local integer OB7=0
local unit u1
local unit u2
local real x
local real y
local integer suijiBedlamHandle=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set level=GetUnitAbilityLevel(ZX7,'A4IK')
if SUIJI_MODE then
set suijiBedlamHandle=GetHandleId(ZX7)
if LoadReal(TABLE_XJ,suijiBedlamHandle,StringHash("SuijiBedlamBlockUntil"))>TimerGetElapsed(W) then
set ZX7=null
set IH7=null
return
endif
call SaveReal(TABLE_XJ,suijiBedlamHandle,StringHash("SuijiBedlamBlockUntil"),TimerGetElapsed(W)+.60)
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set x=GetUnitX(IH7)+200*Cos(bj_DEGTORAD*90*-1.0)
set y=GetUnitY(IH7)+200*Sin(bj_DEGTORAD*90*-1.0)
set u1=CreateUnit(GetOwningPlayer(ZX7),'h0HC',x,y,90*-1.0)
set u2=CreateUnit(GetOwningPlayer(ZX7),'h0HD',x,y,90*-1.0)
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
call SaveUnitHandle(TABLE_XJ,(OB7),(3),(IH7))
call SaveUnitHandle(TABLE_XJ,(OB7),(17),(u1))
call SaveUnitHandle(TABLE_XJ,(OB7),(19),(u2))
call SaveInteger(TABLE_XJ,(OB7),(5),(level))
call TriggerRegisterTimerEvent(t,0.01,true)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Bedlam_Action))
set ZX7=null
set IH7=null
set u1=null
set u2=null
set t=null
endfunction
