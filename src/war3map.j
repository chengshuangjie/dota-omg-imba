function SuijiAI_ImmediateOrderIdForUnit takes unit u,integer skill returns integer
local integer physicalSkill=0
if u!=null and skill!=0 then
set physicalSkill=B287_GetPhysicalAbilityId(u,SuijiAI_OrderLogicalSkill(skill))
if physicalSkill=='YE1I' then
return OrderId("ancestralspirit")
elseif physicalSkill=='YE0I' then
return OrderId("frenzy")
elseif physicalSkill=='YE16' or physicalSkill=='YE17' then
return OrderId("frenzy")
elseif physicalSkill=='Y0BE' or physicalSkill=='Y0FR' or physicalSkill=='Y0BY' then
// These mutually exclusive random-only carriers use the same accepted ANcl
// command as Y0EP.  The logical skill still selects the scripted lifecycle.
return OrderId("metamorphosis")
elseif physicalSkill=='Y0HB' then
return OrderId("berserk")
endif
endif
return SuijiAI_ImmediateOrderId(skill)
endfunction
function SuijiAI_HasMappedOrder takes integer skill returns boolean
return SuijiAI_TargetOrderId(skill)!=0 or SuijiAI_PointOrderId(skill)!=0 or SuijiAI_ImmediateOrderId(skill)!=0
endfunction
function SuijiAI_IsChannelOrderText takes string suijiAIChannelOrderText returns boolean
return suijiAIChannelOrderText=="channel" or suijiAIChannelOrderText=="drain"
endfunction
function SuijiAI_IsBusyChannelingOrder takes integer suijiAIChannelOrderId returns boolean
return suijiAIChannelOrderId==852480 or suijiAIChannelOrderId==852487 or suijiAIChannelOrderId==852488 or suijiAIChannelOrderId==852188 or suijiAIChannelOrderId==$D0073 or suijiAIChannelOrderId==$D0131 or suijiAIChannelOrderId==$D0207 or suijiAIChannelOrderId==$D025E or suijiAIChannelOrderId==$D0278
endfunction
function SuijiAI_IsBusyChannelingUnit takes unit suijiAIChannelUnit returns boolean
if suijiAIChannelUnit==null then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(suijiAIChannelUnit))==MAP_CONTROL_COMPUTER and M7[GetPlayerId(GetOwningPlayer(suijiAIChannelUnit))]==suijiAIChannelUnit then
// For tracked AI heroes the event owner is authoritative. Reusing the old
// order whitelist after expiry/EFFECT would lock ordinary remapped ANcl casts.
return B835AIChannelBlocked(suijiAIChannelUnit)
endif
return SuijiAI_IsBusyChannelingOrder(GetUnitCurrentOrder(suijiAIChannelUnit))
endfunction
function SuijiAI_CanPayAndCastNormally takes unit u,integer skill returns boolean
local integer physicalSkill=0
local integer level=0
local integer manaCost=0
if u==null or skill==0 then
return false
endif
if B1120ControlBlocked(u) then
return false
endif
if MHUnit_GetSilenceCount(u)>0 then
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
set level=GetUnitAbilityLevel(u,physicalSkill)
if level<=0 then
return false
endif
if B581_AIAbilityReady(u,physicalSkill)==false then
return false
endif
set manaCost=B945DefinitionMana(physicalSkill,level)
if manaCost>0 and GetUnitState(u,UNIT_STATE_MANA)+.01<I2R(manaCost) then
return false
endif
return true
endfunction
function SuijiAI_SkillReady takes unit u,integer skill returns boolean
local integer physicalSkill=0
if u==null or skill==0 then
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
return B581_AIAbilityReady(u,physicalSkill)
endfunction
function SuijiAI_CanDirectCast takes unit u,unit target,integer skill,string order returns boolean
if not B992ChannelUltAllowed(u,skill) then
return false
endif
if u==null or target==null then
return false
endif
// A0M3 is normally passive, but its registered Scepter companion is a real
// point spell. Random AI may use that companion without changing the passive
// logical identity or exposing the hidden passive face.
if skill=='A0M3' and SuijiMode_ScepterRegistryIsActive(u,'A0M3') and GetUnitAbilityLevel(u,'ZBBA')>0 then
if UnitAlive(u)==false or UnitAlive(target)==false or IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) or IsUnitEnemy(target,GetOwningPlayer(u))==false or IsHideUnit(target) or IsUnitVisible(target,GetOwningPlayer(u))==false or IsUnitInRange(u,target,800.)==false then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and SuijiAI_IsBusyChannelingUnit(u) then
return false
endif
return SuijiAI_CanPayAndCastNormally(u,'ZBBA')
endif
if skill==0 or order=="passive" then
return false
endif
// An empty stored order with no explicit mapping cannot reach any successful
// issue path, whether the object is active or passive.  Reject it directly
// instead of exact-live classifying the ability on every AI pulse.
if order=="" and not SuijiAI_HasMappedOrder(skill) then
return false
endif
if UnitAlive(u)==false or UnitAlive(target)==false then
return false
endif
if SuijiAI_CanPayAndCastNormally(u,skill)==false then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and SuijiAI_IsBusyChannelingUnit(u) then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (skill=='A03R' or skill=='A0AV') and LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiFreezingFieldTrigger"))!=null then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (skill=='A06R' or skill=='A1B4') and LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiSandKingEpicenterTrigger"))!=null then
return false
endif
if SUIJI_MODE and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and OO7(GetHandleId(u),"SuijiDone") and (IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) or IsUnitEnemy(target,GetOwningPlayer(u))==false) then
return false
endif
if IsUnitAlly(target,GetOwningPlayer(u)) or IsHideUnit(target) or IsUnitVisible(target,GetOwningPlayer(u))==false then
return false
endif
if (skill=='A0QR' or skill=='A1B3') and IsUnitInRange(u,target,600.)==false then
return false
endif
if skill=='A07Z' and not IsUnitInRange(u,target,800.) then
return false
endif
// Preserve the native Shadow Dance health rule in both template and fallback.
if skill=='A1IN' and GetUnitLifePercent(u)>=45. then
return false
endif
if skill=='A05V' and IsUnitInRange(u,target,500.)==false then
return false
endif
if skill=='A2IS' and IsUnitInRange(u,target,430.)==false then
return false
endif
return SuijiAI_SkillReady(u,skill)
endfunction
function SuijiAI_IssueMappedTarget takes unit u,unit target,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
local boolean suijiFlare=SUIJI_AI_CASTING and SuijiMode_IsOwnedRandomFlareSkill(u,SUIJI_AI_SKILL_ID)
if B835AIChannelBlocked(u) then
return false
endif
if suijiFlare then
set X5=852060
endif
if X5==0 or target==null then
return false
endif
call DisableTrigger(Q04[O5])
if suijiFlare then
set done=B947IssuePointOrderById("SuijiAI_IssueMappedTarget @ war3map.j:122743 (B968)",u,X5,GetUnitX(target),GetUnitY(target))
else
set done=B947IssueTargetOrderById("SuijiAI_IssueMappedTarget @ war3map.j:122745 (B968)",u,X5,target)
endif
call EnableTrigger(Q04[O5])
return done
endfunction
function SuijiAI_IssueMappedPoint takes unit u,real x,real y,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
if B835AIChannelBlocked(u) then
return false
endif
if SUIJI_AI_CASTING and SuijiAI_OrderLogicalSkill(SUIJI_AI_SKILL_ID)=='A0BZ' then
set X5=SuijiMode_GetTossOrderId(u)
elseif SUIJI_AI_CASTING and SuijiMode_IsOwnedRandomFlareSkill(u,SUIJI_AI_SKILL_ID) then
set X5=852060
endif
if X5==0 then
return false
endif
call DisableTrigger(Q04[O5])
set done=B947IssuePointOrderById("SuijiAI_IssueMappedPoint @ war3map.j:122765 (B968)",u,X5,x,y)
call EnableTrigger(Q04[O5])
return done
endfunction
function SuijiAI_IssueMappedImmediate takes unit u,integer X5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(u))
local boolean done=false
if B835AIChannelBlocked(u) then
return false
endif
if X5==0 then
return false
endif
call DisableTrigger(Q04[16+O5])
set done=B947IssueImmediateOrderById("SuijiAI_IssueMappedImmediate @ war3map.j:122779 (B968)",u,X5)
call EnableTrigger(Q04[16+O5])
return done
endfunction
function B1005IsRandomVacuum takes unit vacuumUnit1005,integer vacuumSkill1005 returns boolean
return vacuumUnit1005!=null and SuijiAI_OrderLogicalSkill(vacuumSkill1005)=='A0QE' and B287_GetPhysicalAbilityId(vacuumUnit1005,'A0QE')=='Y06V' and GetUnitAbilityLevel(vacuumUnit1005,'Y06V')>0
endfunction
function B1005CastVacuum takes unit vacuumUnit1005,unit vacuumTarget1005 returns boolean
local boolean vacuumIssued1005=false
// Y06V is ANcl with DataB=2. Never try a unit-target order or native Blizzard.
if not SuijiAI_CanDirectCast(vacuumUnit1005,vacuumTarget1005,'A0QE',"unholyfrenzy") then
return false
endif
if not IsUnitInRange(vacuumUnit1005,vacuumTarget1005,600.+MHUnit_GetSpellRange(vacuumUnit1005)) then
return false
endif
set vacuumIssued1005=SuijiAI_IssueMappedPoint(vacuumUnit1005,GetUnitX(vacuumTarget1005),GetUnitY(vacuumTarget1005),OrderId("unholyfrenzy"))
if vacuumIssued1005 then
call SuijiTest_NotifyAICastSuccess(vacuumUnit1005,'A0QE')
endif
return vacuumIssued1005
endfunction
function SuijiAI_CastMappedOrder takes unit u,unit target,integer skill,string order returns boolean
local player p=null
local integer X5=0
local integer physicalSkill=B287_GetPhysicalAbilityId(u,skill)
if B1005IsRandomVacuum(u,skill) then
return B1005CastVacuum(u,target)
endif
if GetUnitAbilityLevel(u,physicalSkill)<=0 then
return false
endif
set p=GetOwningPlayer(u)
if SuijiAI_OrderLogicalSkill(skill)=='A2IT' then
set X5=SuijiAI_ImmediateOrderIdForUnit(u,skill)
if SuijiAI_IssueMappedImmediate(u,X5) then
set p=null
return true
endif
elseif SuijiAI_IsSelfTargetOrder(order) then
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,u,X5) then
set p=null
return true
endif
elseif SuijiAI_IsPointOrder(order) then
set X5=SuijiAI_PointOrderId(skill)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),X5) then
set p=null
return true
endif
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
elseif SuijiAI_IsImmediateOrder(order) then
set X5=SuijiAI_ImmediateOrderIdForUnit(u,skill)
if SuijiAI_IssueMappedImmediate(u,X5) then
set p=null
return true
endif
else
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
endif
set X5=SuijiAI_PointOrderId(skill)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),X5) then
set p=null
return true
endif
set X5=SuijiAI_ImmediateOrderIdForUnit(u,skill)
if SuijiAI_IssueMappedImmediate(u,X5) then
set p=null
return true
endif
set X5=SuijiAI_TargetOrderId(skill)
if SuijiAI_IssueMappedTarget(u,target,X5) then
set p=null
return true
endif
set p=null
return false
endfunction
function B515_TryEarthshakerAghTotemAI takes unit u,unit target,integer skill returns boolean
local integer O5=0
local boolean done=false
if skill!='A0DL' or u==null or target==null then
return false
endif
if GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER or GetUnitLifePercent(u)<=50. then
return false
endif
if GetUnitAbilityLevel(u,'A4LZ')==0 or AI_SKILL_OK(u,'A4LZ')==false then
return false
endif
if IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) or IsUnitEnemy(target,GetOwningPlayer(u))==false or IsUnitVisible(target,GetOwningPlayer(u))==false or IsUnitInRange(u,target,1000.)==false then
return false
endif
set done=B947IssuePointOrderById("B515_TryEarthshakerAghTotemAI @ war3map.j:122860 (B968)",u,$D02B8,GetUnitX(target),GetUnitY(target))
if done then
set O5=GetPlayerId(GetOwningPlayer(u))
set h4[O5]=target
call SuijiTest_NotifyAICastSuccess(u,'A4LZ')
endif
return done
endfunction
function B994ChannelCastKind takes integer skill994 returns integer
if skill994=='A0L3' or skill994=='A2SU' or skill994=='A07Z' or skill994=='A03R' or skill994=='A0AV' or skill994=='A07U' or skill994=='A2SR' or skill994=='A0LT' or skill994=='A1CS' or skill994=='A0CT' then
return 1
elseif skill994=='A0SW' or skill994=='A4FR' or skill994=='A2UX' then
return 3
elseif skill994=='A0R0' then
return 2
endif
return 0
endfunction
function SuijiAI_TemplateRange takes unit u,integer skill,real fallback returns real
local integer level=B287_GetUnitAbilityLevel(u,skill)
local integer value=0
if level<1 then
return fallback
endif
if level>4 then
set level=4
endif
set value=LoadInteger(C_4,skill,7+level)
if value<=0 then
return fallback
endif
if value>1600 then
return 1600.
endif
return I2R(value)+75.
endfunction
function SuijiAI_TemplateInRange takes unit u,unit target,integer skill,real fallback returns boolean
return target!=null and IsUnitInRange(u,target,SuijiAI_TemplateRange(u,skill,fallback))
endfunction
function SuijiAI_TemplateImmediateCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 then
return false
endif
if SuijiAI_TemplateInRange(u,target,skill,fallback)==false and MP7(450.,u,Condition(function k8))<=0 then
return false
endif
return N97(u,orderId,skill)
endfunction
// Limit the B1116 single-route policy to the investigated Overpower command.
// Other immediate skills need their established fallback: the shared 650 gate
// is not their effect radius or their self-buff/toggle activation policy.
function SuijiAI_UsesSingleImmediateRoute takes unit u,integer skill,string order returns boolean
local integer logicalSkill=SuijiAI_OrderLogicalSkill(skill)
local integer orderId=OrderId(order)
if logicalSkill!='A1P9' then
return false
endif
if u==null or order=="" or orderId==0 or not SuijiAI_IsImmediateOrder(order) then
return false
endif
if logicalSkill=='A28Q' or logicalSkill=='A1IN' or logicalSkill=='A1T8' or B994ChannelCastKind(logicalSkill)>0 or B287_UsesAlternateCarrier(u,logicalSkill) then
return false
endif
return SuijiAI_ImmediateOrderIdForUnit(u,logicalSkill)==orderId
endfunction
function SuijiAI_CastByOrder takes unit u,unit target,integer skill,string order returns boolean
local boolean done=false
local integer kind994=B994ChannelCastKind(skill)
if B1005IsRandomVacuum(u,skill) then
return B1005CastVacuum(u,target)
endif
if not SuijiAI_CanDirectCast(u,target,skill,order) then
return false
endif
call SuijiAI_RestoreVisibleSkills(u)
// Channel's base order does not describe its target type; retain the object mode.
if kind994>0 then
// Keep proven native hook IDs; only fallback/alternate carriers use stored orders.
if not B287_UsesAlternateCarrier(u,skill) and SuijiAI_HasMappedOrder(skill) then
set done=SuijiAI_CastMappedOrder(u,target,skill,order)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
endif
if order=="" then
return false
endif
if kind994==1 then
set done=B947IssueImmediateOrder("B994 channel immediate",u,order)
elseif kind994==2 then
set done=B947IssuePointOrder("B994 channel point",u,order,GetUnitX(target),GetUnitY(target))
else
set done=B947IssueTargetOrder("B994 channel target",u,order,target)
endif
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
if B515_TryEarthshakerAghTotemAI(u,target,skill) then
return true
endif
// A self buff may be prepared at distance; preserve that established behavior
// while keeping the investigated command to one guarded native submission.
if SuijiAI_UsesSingleImmediateRoute(u,skill,order) then
return N97(u,SuijiAI_ImmediateOrderIdForUnit(u,skill),skill)
endif
// A fallback carrier owns a deliberately different command from the logical
// source. Issuing the legacy mapped id here would fire another ready ability.
if B287_UsesAlternateCarrier(u,skill)==false and SuijiAI_CastMappedOrder(u,target,skill,order) then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
if order=="" then
return false
endif
if SuijiAI_IsSelfTargetOrder(order) then
set done=B947IssueTargetOrder("SuijiAI_CastByOrder @ war3map.j:122887 (B968)",u,order,u)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
endif
if SuijiAI_IsImmediateOrder(order) then
set done=B947IssueImmediateOrder("SuijiAI_CastByOrder @ war3map.j:122894 (B968)",u,order)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
if SuijiAI_IsPointOrder(order) then
set done=B947IssuePointOrder("SuijiAI_CastByOrder @ war3map.j:122901 (B968)",u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
set done=B947IssueTargetOrder("SuijiAI_CastByOrder @ war3map.j:122906 (B968)",u,order,target)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
set done=B947IssueTargetOrder("SuijiAI_CastByOrder @ war3map.j:122912 (B968)",u,order,target)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
if order=="channel" then
set done=B947IssuePointOrder("SuijiAI_CastByOrder @ war3map.j:122918 (B968)",u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
set done=B947IssueImmediateOrder("SuijiAI_CastByOrder @ war3map.j:122923 (B968)",u,order)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
set done=B947IssuePointOrder("SuijiAI_CastByOrder @ war3map.j:122929 (B968)",u,order,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endfunction
function SuijiAI_TemplatePointCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 or SuijiAI_TemplateInRange(u,target,skill,fallback)==false then
return false
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
if SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),orderId) then
call SuijiTest_NotifyAICastSuccess(u,skill)
return true
endif
return false
endfunction
function SuijiAI_TemplateTargetCast takes unit u,unit target,integer skill,integer orderId,real fallback returns boolean
if orderId==0 or SuijiAI_TemplateInRange(u,target,skill,fallback)==false then
return false
endif
return M57(u,orderId,skill,target)
endfunction
function SuijiAI_TrySkillTemplateSpecial takes unit u,unit target,integer skill returns boolean
local player p=null
local boolean done=false
if B515_TryEarthshakerAghTotemAI(u,target,skill) then
return true
endif
if skill=='A0M3' and SuijiMode_ScepterRegistryIsActive(u,'A0M3') and GetUnitAbilityLevel(u,'ZBBA')>0 then
set done=BristlebackAghActive_QueueAIActivate(u,GetUnitX(target),GetUnitY(target))
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endif
if skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then
if SuijiAI_TemplateInRange(u,target,skill,800.)==false then
return false
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'A2ZU',true)
call SetPlayerAbilityAvailable(p,'A2ZV',true)
call SetPlayerAbilityAvailable(p,'A2ZW',true)
set done=SuijiAI_IssueMappedTarget(u,target,852111)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then
if SuijiAI_TemplateInRange(u,target,skill,650.)==false then
return false
endif
set p=GetOwningPlayer(u)
call B287_SetPlayerAbilityAvailable(p,'A0OJ',true)
call SetPlayerAbilityAvailable(p,'A2ZY',true)
call SetPlayerAbilityAvailable(p,'A2ZZ',true)
set done=SuijiAI_IssueMappedTarget(u,target,852602)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A4F4' or skill=='A4F5' or skill=='A4FU' then
if SuijiAI_TemplateInRange(u,target,skill,800.)==false then
return false
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'A4F4',true)
call SetPlayerAbilityAvailable(p,'A4F5',true)
call SetPlayerAbilityAvailable(p,'A4FU',true)
set done=SuijiAI_IssueMappedTarget(u,target,852231)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
return done
endif
if skill=='A1T5' or skill=='A235' then
set done=SuijiAI_TemplatePointCast(u,target,skill,852089,900.)
if done==false and SuijiAI_TemplateInRange(u,target,skill,900.) then
set p=GetOwningPlayer(u)
call B287_SetPlayerAbilityAvailable(p,'A1T5',true)
call B287_SetPlayerAbilityAvailable(p,'A235',true)
set done=SuijiAI_IssueMappedPoint(u,GetUnitX(target),GetUnitY(target),852089)
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
set p=null
endif
return done
endif
if skill=='A28Q' then
if GetUnitAbilityLevel(u,'B08A')==0 then
if GetUnitLifePercent(u)>35. and SuijiAI_TemplateInRange(u,target,skill,700.) then
return N97(u,852589,skill)
endif
else
if GetUnitLifePercent(u)<25. or target==null then
return N97(u,852590,skill)
endif
endif
return false
endif
if skill=='A1IN' then
if GetUnitLifePercent(u)<45. then
return N97(u,852129,skill)
endif
return false
endif
if skill=='A1T8' then
set done=N97(u,852526,skill)
if done then
call B947IssueImmediateOrderById("SuijiAI_TrySkillTemplateSpecial @ war3map.j:123075 (B968)",u,852490)
endif
return done
endif
return false
endfunction
function SuijiAI_TrySkillTemplateNormalFallback takes unit u,unit target,integer skill,string order returns boolean
local boolean done=false
if B1005IsRandomVacuum(u,skill) then
return B1005CastVacuum(u,target)
endif
if order=="" or target==null then
return false
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
if SuijiAI_IsPointOrder(order) then
set done=B947IssuePointOrder("SuijiAI_TrySkillTemplateNormalFallback @ war3map.j:123088 (B968)",u,order,GetUnitX(target),GetUnitY(target))
elseif SuijiAI_IsImmediateOrder(order) then
set done=B947IssueImmediateOrder("SuijiAI_TrySkillTemplateNormalFallback @ war3map.j:123090 (B968)",u,order)
elseif SuijiAI_IsSelfTargetOrder(order) then
set done=B947IssueTargetOrder("SuijiAI_TrySkillTemplateNormalFallback @ war3map.j:123092 (B968)",u,order,u)
else
set done=B947IssueTargetOrder("SuijiAI_TrySkillTemplateNormalFallback @ war3map.j:123094 (B968)",u,order,target)
endif
if done then
call SuijiTest_NotifyAICastSuccess(u,skill)
endif
return done
endfunction
function SuijiAI_TrySkillTemplate takes unit u,unit target,integer skill,string order returns boolean
local integer targetOrder=SuijiAI_TargetOrderId(skill)
local integer pointOrder=SuijiAI_PointOrderId(skill)
local integer immediateOrder=SuijiAI_ImmediateOrderIdForUnit(u,skill)
local boolean singleImmediate1116=SuijiAI_UsesSingleImmediateRoute(u,skill,order)
if B1005IsRandomVacuum(u,skill) then
return B1005CastVacuum(u,target)
endif
if not SuijiAI_CanDirectCast(u,target,skill,order) then
return false
endif
if B994ChannelCastKind(skill)>0 or ((skill=='A29J' or skill=='A1MP' or skill=='A0NS' or skill=='A1DA') and B287_UsesAlternateCarrier(u,skill)) then
return SuijiAI_CastByOrder(u,target,skill,order)
endif
call SuijiAI_RestoreVisibleSkills(u)
if SuijiAI_TrySkillTemplateSpecial(u,target,skill) then
return true
endif
// Overpower has no target range; a native refusal still completes this attempt.
if singleImmediate1116 then
return N97(u,immediateOrder,skill)
endif
if order=="" and targetOrder==0 and pointOrder==0 and immediateOrder==0 then
return SuijiAI_TrySkillTemplateNormalFallback(u,target,skill,order)
endif
if SuijiAI_IsPointOrder(order) then
if SuijiAI_TemplatePointCast(u,target,skill,pointOrder,800.) then
return true
endif
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
elseif SuijiAI_IsImmediateOrder(order) then
if SuijiAI_TemplateImmediateCast(u,target,skill,immediateOrder,650.) then
return true
endif
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
elseif SuijiAI_IsSelfTargetOrder(order) then
if SuijiAI_TemplateTargetCast(u,u,skill,targetOrder,800.) then
return true
endif
else
if SuijiAI_TemplateTargetCast(u,target,skill,targetOrder,800.) then
return true
endif
if SuijiAI_TemplatePointCast(u,target,skill,pointOrder,800.) then
return true
endif
if SuijiAI_TemplateImmediateCast(u,target,skill,immediateOrder,650.) then
return true
endif
endif
return SuijiAI_TrySkillTemplateNormalFallback(u,target,skill,order)
endfunction
function SuijiAI_SoftCooldownDuration takes unit suijiAICoolUnit,integer suijiAICoolSkill,real suijiAICoolFallback returns real
local integer suijiAICoolLevel=0
local integer suijiAICoolPhysical=0
local real suijiAICoolDuration=0.
local real suijiAICoolReduce=0.
if suijiAICoolUnit==null or suijiAICoolSkill==0 then
return suijiAICoolFallback
endif
set suijiAICoolPhysical=B287_GetPhysicalAbilityId(suijiAICoolUnit,suijiAICoolSkill)
set suijiAICoolLevel=GetUnitAbilityLevel(suijiAICoolUnit,suijiAICoolPhysical)
if suijiAICoolLevel>0 then
set suijiAICoolDuration=MHAbility_GetLevelDefDataReal(suijiAICoolPhysical,suijiAICoolLevel,ABILITY_LEVEL_DEF_DATA_COOLDOWN)
endif
if suijiAICoolDuration<=0. then
set suijiAICoolDuration=MHAbility_GetMaxCooldown(suijiAICoolUnit,suijiAICoolPhysical)
endif
if suijiAICoolDuration<=0. then
set suijiAICoolDuration=suijiAICoolFallback
endif
set suijiAICoolReduce=ReduceUnitAbilityCoolDownReal(suijiAICoolUnit)
if suijiAICoolReduce>0. then
set suijiAICoolDuration=suijiAICoolDuration*suijiAICoolReduce
endif
if suijiAICoolDuration<.80 then
set suijiAICoolDuration=.80
endif
return suijiAICoolDuration
endfunction
function SuijiAI_SoftCooldownReady takes unit suijiAICoolUnit,string suijiAICoolMark returns boolean
if suijiAICoolUnit==null then
return false
endif
return ON7(GetHandleId(suijiAICoolUnit),"SuijiAI|Soft|"+suijiAICoolMark)<=TimerGetElapsed(W)
endfunction
function SuijiAI_SetSoftCooldown takes unit suijiAICoolUnit,string suijiAICoolMark,integer suijiAICoolSkill,real suijiAICoolFallback returns nothing
local real suijiAICoolDuration=0.
if SUIJI_MODE and suijiAICoolUnit!=null and suijiAICoolSkill!=0 and GetPlayerController(GetOwningPlayer(suijiAICoolUnit))==MAP_CONTROL_COMPUTER then
if suijiAICoolFallback<2. then
if suijiAICoolMark=="SuijiUlt" then
set suijiAICoolFallback=6.
else
set suijiAICoolFallback=3.
endif
endif
set suijiAICoolDuration=SuijiAI_SoftCooldownDuration(suijiAICoolUnit,suijiAICoolSkill,suijiAICoolFallback)
if B1005IsRandomVacuum(suijiAICoolUnit,suijiAICoolSkill) then
// An accepted order can be interrupted before EFFECT. Only debounce attempts;
// B581_AIAbilityReady enforces the real 18/9-second (and item-adjusted) cooldown.
set suijiAICoolDuration=1.50
endif
if suijiAICoolSkill=='A01O' and SuijiMode_ScepterRegistryIsActive(suijiAICoolUnit,'A01O') then
// Debounce only the one-second cast; the upgraded spell has no cooldown.
set suijiAICoolDuration=1.
endif
call NQ7(GetHandleId(suijiAICoolUnit),"SuijiAI|Soft|"+suijiAICoolMark,TimerGetElapsed(W)+suijiAICoolDuration)
endif
endfunction
function SuijiAI_RandomCastSearchRange takes unit u,integer skill,string order returns real
local integer level=0
local integer range=0
local real bonus=0.
if u==null or skill==0 then
return 0.
endif
if skill=='A07Z' then
return 800.
endif
if SuijiAI_IsImmediateOrder(order) or SuijiAI_IsSelfTargetOrder(order) then
return 1200.
endif
set level=B287_GetUnitAbilityLevel(u,skill)
if level<1 then
return 0.
endif
if level>4 then
set level=4
endif
set bonus=MHUnit_GetSpellRange(u)
if B1005IsRandomVacuum(u,skill) then
// The legacy W6E record says 500; the owned Y06V object actually casts at 600.
return 600.+bonus
endif
// Double Edge has only 150 cast range, but the native Centaur AI deliberately
// begins its short approach at 250. Keep that proven allowance while ensuring
// the random AI no longer chooses a target from the old global 1200 radius.
if skill=='A2ON' then
return 250.+bonus
endif
set range=LoadInteger(C_4,skill,7+level)
if range<=0 then
return 800.+bonus
endif
return RMinBJ(1200.,I2R(range)+bonus)
endfunction
function SuijiAI_PickRandomCastTarget takes unit u,unit fallback,integer skill,string order returns unit
local group g=null
local unit target=null
local unit best=null
local real radius=SuijiAI_RandomCastSearchRange(u,skill,order)
local real life=0.
local real bestLife=0.
if u==null or radius<=0. then
return null
endif
if fallback!=null and UnitAlive(fallback) and IsUnitType(fallback,UNIT_TYPE_HERO) and IsUnitIllusion(fallback)==false and IsUnitEnemy(fallback,GetOwningPlayer(u)) and IsHideUnit(fallback)==false and IsUnitVisible(fallback,GetOwningPlayer(u)) and IsUnitInRange(u,fallback,radius) then
return fallback
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),radius,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if UnitAlive(target) and IsUnitType(target,UNIT_TYPE_HERO) and IsUnitIllusion(target)==false and IsUnitEnemy(target,GetOwningPlayer(u)) and IsHideUnit(target)==false and IsUnitVisible(target,GetOwningPlayer(u)) then
set life=GetWidgetLife(target)
if best==null or life<bestLife then
set best=target
set bestLife=life
endif
endif
endloop
call WR7(g)
set g=null
set target=null
return best
endfunction
function SuijiAI_IsFocusSkill takes integer skill returns boolean
set skill=SuijiAI_OrderLogicalSkill(skill)
return skill=='A08V' or skill=='A06O' or skill=='A2ON' or skill=='A0QE'
endfunction
function SuijiAI_FocusDistance takes unit a,unit b returns real
local real dx=0.
local real dy=0.
if a==null or b==null then
return -1.
endif
set dx=GetUnitX(a)-GetUnitX(b)
set dy=GetUnitY(a)-GetUnitY(b)
return SquareRoot(dx*dx+dy*dy)
endfunction
function SuijiAI_FocusLog takes unit u,integer skill,string tag,string msg returns nothing
local integer h=0
local integer countKey=0
local integer count=0
if SUIJI_AI_FOCUS_LOG==false or u==null or GetUnitTypeId(u)==0 or SuijiAI_IsFocusSkill(skill)==false then
return
endif
if GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return
endif
set skill=SuijiAI_OrderLogicalSkill(skill)
set h=GetHandleId(u)
set countKey=StringHash("SuijiAIFocusCount|"+I2S(SUIJI_AI_FOCUS_LOG_SESSION))+skill
set count=LoadInteger(L7,h,countKey)
if count>=120 then
return
endif
call SaveInteger(L7,h,countKey,count+1)
call DisplayTimedTextToPlayer(Le,0,0,12.,"|cFF66CCFFAI4日志["+tag+"]：|rP"+I2S(GetPlayerId(GetOwningPlayer(u)))+" "+GetUnitName(u)+" "+GetAbilityName(skill)+" "+msg)
endfunction
function B936FocusLogReady takes unit logUnit936,integer logSkill936,string logTag936 returns boolean
local integer logKey936=0
if SUIJI_AI_FOCUS_LOG==false or logUnit936==null or SuijiAI_IsFocusSkill(logSkill936)==false then
return false
endif
set logSkill936=SuijiAI_OrderLogicalSkill(logSkill936)
set logKey936=StringHash("SuijiAIFocusNext|"+logTag936+"|"+I2S(SUIJI_AI_FOCUS_LOG_SESSION))+logSkill936
return LoadReal(L7,GetHandleId(logUnit936),logKey936)<=TimerGetElapsed(W)
endfunction
function SuijiAI_FocusLogThrottled takes unit u,integer skill,string tag,string msg,real delay returns nothing
local integer h=0
local integer nextKey=0
local real now=TimerGetElapsed(W)
if SUIJI_AI_FOCUS_LOG==false or u==null or SuijiAI_IsFocusSkill(skill)==false then
return
endif
set skill=SuijiAI_OrderLogicalSkill(skill)
set h=GetHandleId(u)
set nextKey=StringHash("SuijiAIFocusNext|"+tag+"|"+I2S(SUIJI_AI_FOCUS_LOG_SESSION))+skill
if LoadReal(L7,h,nextKey)>now then
return
endif
call SaveReal(L7,h,nextKey,now+delay)
call SuijiAI_FocusLog(u,skill,tag,msg)
endfunction
function SuijiAI_FocusTraceMark takes unit u,string mark returns nothing
local integer h=0
local integer skill=0
local integer physicalSkill=0
local integer level=0
local string order=""
local unit target=null
local real distance=-1.
local real now=TimerGetElapsed(W)
if SUIJI_AI_FOCUS_LOG==false or u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set skill=OM7(h,mark+"Skill")
if B936FocusLogReady(u,skill,"状态-"+mark)==false then
return
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
set level=GetUnitAbilityLevel(u,physicalSkill)
set order=OP7(h,mark+"Order")
set target=SuijiAI_PickRandomCastTarget(u,u,skill,order)
if target!=null then
set distance=SuijiAI_FocusDistance(u,target)
endif
if B936FocusLogReady(u,skill,"状态-"+mark) then
call SuijiAI_FocusLogThrottled(u,skill,"状态-"+mark,"logicalLv="+I2S(B287_GetUnitAbilityLevel(u,skill))+" physical="+I2S(physicalSkill)+"/lv"+I2S(level)+" stored="+I2S(OM7(h,mark+"Ability"))+" order="+order+" source="+I2S(OM7(h,mark+"SourceType"))+" ready="+I2S(B287_BoolToInt(B581_AIAbilityReady(u,physicalSkill)))+" pay="+I2S(B287_BoolToInt(SuijiAI_CanPayAndCastNormally(u,skill)))+" soft="+I2S(B287_BoolToInt(SuijiAI_SoftCooldownReady(u,mark)))+" try="+I2S(B287_BoolToInt(ON7(h,"SuijiAI|"+mark)<=now))+" pulse="+I2S(B287_BoolToInt(ON7(h,"SuijiAI|Pulse|"+mark)<=now))+" aiok="+I2S(B287_BoolToInt(AI_SKILL_OK(u,skill)))+" mana%="+I2S(R2I(GetUnitManaPercent(u)))+" current="+I2S(GetUnitCurrentOrder(u))+" busy="+I2S(B287_BoolToInt(SuijiAI_IsBusyChannelingUnit(u)))+" lock="+I2S(B287_BoolToInt(SUIJI_AI_CASTING))+" target="+I2S(GetHandleId(target))+" dist="+I2S(R2I(distance)),2.)
endif
set target=null
endfunction
function SuijiAI_FocusTraceUnit takes unit u returns nothing
call SuijiAI_FocusTraceMark(u,"SuijiSmall")
call SuijiAI_FocusTraceMark(u,"SuijiUlt")
endfunction
function SuijiAI_FocusOwnedCarrierSkill takes unit u returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if GetUnitAbilityLevel(u,'Y03B')>0 then
return 'A08V'
elseif GetUnitAbilityLevel(u,'Y02M')>0 then
return 'A06O'
elseif GetUnitAbilityLevel(u,'Y0AH')>0 or GetUnitAbilityLevel(u,'YD15')>0 then
return 'A2ON'
elseif GetUnitAbilityLevel(u,'Y06V')>0 then
return 'A0QE'
endif
return 0
endfunction
function SuijiAI_FocusAuditMark takes unit u,string mark returns boolean
local integer h=0
local integer skill=0
local integer storedPhysical=0
local integer resolvedPhysical=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
set skill=OM7(h,mark+"Skill")
if SuijiAI_IsFocusSkill(skill)==false then
return false
endif
set storedPhysical=OM7(h,mark+"Ability")
set resolvedPhysical=B287_GetPhysicalAbilityId(u,skill)
call SuijiAI_FocusLog(u,skill,"载体审计-"+mark,"logical="+I2S(skill)+" stored="+I2S(storedPhysical)+"/lv"+I2S(GetUnitAbilityLevel(u,storedPhysical))+" resolved="+I2S(resolvedPhysical)+"/lv"+I2S(GetUnitAbilityLevel(u,resolvedPhysical))+" clone="+I2S(LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,skill))+" alt="+I2S(LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,skill))+" order="+OP7(h,mark+"Order")+" done="+I2S(B287_BoolToInt(OO7(h,"SuijiDone"))))
return true
endfunction
function SuijiAI_FocusAuditUnit takes unit u returns boolean
local integer h=0
local integer carrierSkill=0
local boolean found=false
if u==null or GetUnitTypeId(u)==0 or GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return false
endif
set h=GetHandleId(u)
set found=SuijiAI_FocusAuditMark(u,"SuijiSmall")
if SuijiAI_FocusAuditMark(u,"SuijiUlt") then
set found=true
endif
if found==false then
set carrierSkill=SuijiAI_FocusOwnedCarrierSkill(u)
if carrierSkill!=0 then
call SuijiAI_FocusLog(u,carrierSkill,"孤立载体","small="+I2S(OM7(h,"SuijiSmallSkill"))+" ult="+I2S(OM7(h,"SuijiUltSkill"))+" resolved="+I2S(B287_GetPhysicalAbilityId(u,carrierSkill))+"/lv"+I2S(GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,carrierSkill)))+" done="+I2S(B287_BoolToInt(OO7(h,"SuijiDone"))))
set found=true
endif
endif
return found
endfunction
function SuijiAI_FocusAuditRoster takes nothing returns integer
local integer i=0
local integer found=0
loop
exitwhen i>$B
if SuijiAI_FocusAuditUnit(M7[i]) then
set found=found+1
endif
set i=i+1
endloop
return found
endfunction
function SuijiAI_TryOneGeneric takes unit u,unit target,string mark returns boolean
local integer h=GetHandleId(u)
local integer skill=OM7(h,mark+"Skill")
local integer helper=OM7(h,mark+"Helper")
local string order=OP7(h,mark+"Order")
local boolean singleImmediate1116=SuijiAI_UsesSingleImmediateRoute(u,skill,order)
local integer oldOrderId=SUIJI_AI_ORDER_ID
local integer oldSkillId=SUIJI_AI_SKILL_ID
local integer oldHelperId=SUIJI_AI_HELPER_ID
local integer oldTemplateId=SUIJI_AI_TEMPLATE_UNIT_ID
local boolean oldCasting=SUIJI_AI_CASTING
local boolean done=false
set target=SuijiAI_PickRandomCastTarget(u,target,skill,order)
if target==null then
if B936FocusLogReady(u,skill,"通用目标") then
call SuijiAI_FocusLogThrottled(u,skill,"通用目标","未找到范围内敌方英雄 order="+order,1.5)
endif
set order=""
return false
endif
set SUIJI_AI_CASTING=true
set SUIJI_AI_ORDER_ID=0
set SUIJI_AI_SKILL_ID=skill
set SUIJI_AI_HELPER_ID=helper
set SUIJI_AI_TEMPLATE_UNIT_ID=OM7(h,mark+"SourceType")
set done=SuijiAI_TrySkillTemplate(u,target,skill,order)
if B936FocusLogReady(u,skill,"通用原生") then
call SuijiAI_FocusLogThrottled(u,skill,"通用原生","template="+I2S(B287_BoolToInt(done))+" target="+I2S(GetHandleId(target))+" order="+order,1.5)
endif
if not done and not singleImmediate1116 then
set done=SuijiAI_CastByOrder(u,target,skill,order)
if B936FocusLogReady(u,skill,"通用下令") then
call SuijiAI_FocusLogThrottled(u,skill,"通用下令","fallback="+I2S(B287_BoolToInt(done))+" current="+I2S(GetUnitCurrentOrder(u))+" order="+order,1.5)
endif
endif
if done then
call SuijiAI_SetSoftCooldown(u,mark,skill,1.50)
endif
set SUIJI_AI_ORDER_ID=oldOrderId
set SUIJI_AI_SKILL_ID=oldSkillId
set SUIJI_AI_HELPER_ID=oldHelperId
set SUIJI_AI_TEMPLATE_UNIT_ID=oldTemplateId
set SUIJI_AI_CASTING=oldCasting
set order=""
return done
endfunction
function SuijiAI_IsHeroTarget takes unit u,unit target returns boolean
if u==null or target==null then
return false
endif
if GetWidgetLife(target)<=.405 then
return false
endif
if IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitIllusion(target) then
return false
endif
if IsUnitEnemy(target,GetOwningPlayer(u))==false then
return false
endif
if IsHideUnit(target) or IsUnitVisible(target,GetOwningPlayer(u))==false then
return false
endif
return true
endfunction
function SuijiAI_PickHeroTarget takes unit u,unit fallback returns unit
local group g=null
local unit t=null
local unit best=null
local real life=0.
local real bestLife=0.
if SuijiAI_IsHeroTarget(u,fallback) then
return fallback
endif
if u==null then
return null
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),1200.,Condition(function TO7))
loop
set t=FirstOfGroup(g)
exitwhen t==null
call GroupRemoveUnit(g,t)
if SuijiAI_IsHeroTarget(u,t) then
set life=GetWidgetLife(t)
if best==null or life<bestLife then
set best=t
set bestLife=life
endif
endif
endloop
call WR7(g)
set g=null
set t=null
if best!=null then
return best
endif
return null
endfunction
function SuijiAI_TryRandomGeneric takes unit u,unit target returns boolean
local unit castTarget=null
local boolean done=false
if u==null or target==null then
return false
endif
set castTarget=SuijiAI_PickHeroTarget(u,target)
if castTarget==null then
return false
endif
if SuijiAI_IsHeroTarget(u,castTarget)==false then
set castTarget=null
return false
endif
if SuijiAI_TryOneGeneric(u,castTarget,"SuijiUlt") then
set castTarget=null
return true
endif
if SuijiAI_TryOneGeneric(u,castTarget,"SuijiSmall") then
set castTarget=null
return true
endif
set done=SuijiAI_TryOneGeneric(u,castTarget,"SuijiUlt")
set castTarget=null
return done
endfunction
function SuijiAI_CanTryMark takes unit u,string mark,real delay returns boolean
local integer h=0
local integer skill=0
local string order=""
if u==null then
return false
endif
set h=GetHandleId(u)
if not SUIJI_MODE or not OO7(h,"SuijiDone") then
return false
endif
set skill=OM7(h,mark+"Skill")
set order=OP7(h,mark+"Order")
if skill==0 or order=="passive" then
return false
endif
if order=="" and not SuijiAI_HasMappedOrder(skill) then
return false
endif
if not SuijiAI_SoftCooldownReady(u,mark) then
return false
endif
if not SuijiAI_SkillReady(u,skill) then
return false
endif
if ON7(h,"SuijiAI|"+mark)>TimerGetElapsed(W) then
return false
endif
call NQ7(h,"SuijiAI|"+mark,TimerGetElapsed(W)+delay)
return true
endfunction
function SuijiAI_CanPulseMark takes unit u,string mark,real delay returns boolean
local integer h=0
local integer skill=0
local string order=""
if u==null then
return false
endif
set h=GetHandleId(u)
if not SUIJI_MODE or not OO7(h,"SuijiDone") then
return false
endif
set skill=OM7(h,mark+"Skill")
set order=OP7(h,mark+"Order")
if skill==0 or order=="passive" then
return false
endif
if order=="" and not SuijiAI_HasMappedOrder(skill) then
return false
endif
if not SuijiAI_SoftCooldownReady(u,mark) then
return false
endif
if not SuijiAI_SkillReady(u,skill) then
return false
endif
return ON7(h,"SuijiAI|Pulse|"+mark)<=TimerGetElapsed(W)
endfunction
function SuijiAI_TryPulseMark takes unit u,unit target,string mark,real delay returns boolean
local integer h=GetHandleId(u)
local integer skill=OM7(h,mark+"Skill")
local integer helper=OM7(h,mark+"Helper")
local string order=OP7(h,mark+"Order")
local boolean singleImmediate1116=SuijiAI_UsesSingleImmediateRoute(u,skill,order)
local integer oldOrderId=SUIJI_AI_ORDER_ID
local integer oldSkillId=SUIJI_AI_SKILL_ID
local integer oldHelperId=SUIJI_AI_HELPER_ID
local integer oldTemplateId=SUIJI_AI_TEMPLATE_UNIT_ID
local boolean done=false
local boolean pulseReady936=SuijiAI_CanPulseMark(u,mark,delay)
// Retaliation already has a validated nearby attacker; do not scan for another.
if pulseReady936 and u!=B991OrderOwner then
set target=SuijiAI_PickRandomCastTarget(u,target,skill,order)
endif
if not pulseReady936 or target==null then
if B936FocusLogReady(u,skill,"脉冲门槛") then
call SuijiAI_FocusLogThrottled(u,skill,"脉冲门槛","target="+I2S(GetHandleId(target))+" can="+I2S(B287_BoolToInt(pulseReady936))+" order="+order,1.5)
endif
set order=""
return false
endif
set SUIJI_AI_ORDER_ID=0
set SUIJI_AI_SKILL_ID=skill
set SUIJI_AI_HELPER_ID=helper
set SUIJI_AI_TEMPLATE_UNIT_ID=OM7(h,mark+"SourceType")
set done=SuijiAI_TrySkillTemplate(u,target,skill,order)
if B936FocusLogReady(u,skill,"脉冲原生") then
call SuijiAI_FocusLogThrottled(u,skill,"脉冲原生","template="+I2S(B287_BoolToInt(done))+" target="+I2S(GetHandleId(target))+" order="+order,1.5)
endif
if not done and not singleImmediate1116 then
set done=SuijiAI_CastByOrder(u,target,skill,order)
if B936FocusLogReady(u,skill,"脉冲下令") then
call SuijiAI_FocusLogThrottled(u,skill,"脉冲下令","fallback="+I2S(B287_BoolToInt(done))+" current="+I2S(GetUnitCurrentOrder(u))+" order="+order,1.5)
endif
endif
set SUIJI_AI_ORDER_ID=oldOrderId
set SUIJI_AI_SKILL_ID=oldSkillId
set SUIJI_AI_HELPER_ID=oldHelperId
set SUIJI_AI_TEMPLATE_UNIT_ID=oldTemplateId
if done then
call SuijiAI_SetSoftCooldown(u,mark,skill,1.50)
call NQ7(h,"SuijiAI|Pulse|"+mark,TimerGetElapsed(W)+delay)
set order=""
return true
endif
set order=""
return false
endfunction
function SuijiAI_IsRandomRepelAlly takes unit u,unit target returns boolean
if u==null or target==null or target==u then
return false
endif
if UnitAlive(target)==false or IsUnitType(target,UNIT_TYPE_HERO)==false or IsUnitAlly(target,GetOwningPlayer(u))==false then
return false
endif
if IsHideUnit(target) or GetUnitTypeId(target)=='H00J' or GetUnitAbilityLevel(target,'A04R')>0 or GetUnitAbilityLevel(target,'B014')>0 or WF7(target) then
return false
endif
return true
endfunction
function SuijiAI_IsRandomRepelPriorityAlly takes unit target returns boolean
local integer id=0
if target==null then
return false
endif
set id=GetUnitTypeId(target)
return id=='Ofar' or id=='UC11' or id=='H00Q' or id=='Opgh' or id=='UC91' or id=='H000' or id=='E02K' or id=='UC18' or GetPlayerController(GetOwningPlayer(target))==MAP_CONTROL_USER
endfunction
function SuijiAI_PickRandomRepelAlly takes unit u,real radius,boolean priorityOnly returns unit
local group g=null
local unit target=null
local unit best=null
local real life=0.
local real bestLife=0.
if u==null then
return null
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),radius,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if SuijiAI_IsRandomRepelAlly(u,target) and (priorityOnly==false or SuijiAI_IsRandomRepelPriorityAlly(target)) then
set life=GetUnitLifePercent(target)
if best==null or life<bestLife then
set best=target
set bestLife=life
endif
endif
endloop
call WR7(g)
set g=null
set target=null
return best
endfunction
function SuijiAI_HasRandomRepelEnemyHero takes unit u,real radius returns boolean
local group g=null
local unit target=null
local boolean found=false
if u==null then
return false
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),radius,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null or found
call GroupRemoveUnit(g,target)
set found=target!=u and UnitAlive(target) and IsUnitType(target,UNIT_TYPE_HERO) and IsUnitEnemy(target,GetOwningPlayer(u)) and IsHideUnit(target)==false and GetUnitTypeId(target)!='H00J' and GetUnitAbilityLevel(target,'A04R')==0
endloop
call WR7(g)
set g=null
set target=null
return found
endfunction
function SuijiAI_TryRandomRepel takes unit u returns boolean
local integer h=0
local integer pid=0
local string mark=""
local unit target=null
local real castRange=0.
local boolean oldCasting=false
local boolean done=false
if u==null or UnitAlive(u)==false or IsUnitIllusion(u) or IsHideUnit(u) then
return false
endif
set h=GetHandleId(u)
if OM7(h,"SuijiSmallSkill")=='A08V' then
set mark="SuijiSmall"
elseif OM7(h,"SuijiUltSkill")=='A08V' then
set mark="SuijiUlt"
else
return false
endif
if SuijiAI_SoftCooldownReady(u,mark)==false or SuijiAI_CanPayAndCastNormally(u,'A08V')==false then
if B936FocusLogReady(u,'A08V',"驱逐门槛") then
call SuijiAI_FocusLogThrottled(u,'A08V',"驱逐门槛","soft="+I2S(B287_BoolToInt(SuijiAI_SoftCooldownReady(u,mark)))+" pay="+I2S(B287_BoolToInt(SuijiAI_CanPayAndCastNormally(u,'A08V')))+" physical="+I2S(B287_GetPhysicalAbilityId(u,'A08V'))+" current="+I2S(GetUnitCurrentOrder(u)),1.5)
endif
set mark=""
return false
endif
set castRange=600.+MHUnit_GetSpellRange(u)
if GetHeroLevel(u)>10 and GetUnitManaPercent(u)>20. then
set target=SuijiAI_PickRandomRepelAlly(u,castRange,true)
endif
if target==null and GetUnitManaPercent(u)>20. and AK7(u)==false then
set target=SuijiAI_PickRandomRepelAlly(u,castRange,false)
endif
if target==null and GetUnitManaPercent(u)>30. and AK7(u)==false and GetUnitAbilityLevel(u,'B014')==0 and SuijiAI_HasRandomRepelEnemyHero(u,1400.) then
set target=u
endif
if target==null then
if B936FocusLogReady(u,'A08V',"驱逐目标") then
call SuijiAI_FocusLogThrottled(u,'A08V',"驱逐目标","无目标 level="+I2S(GetHeroLevel(u))+" mana%="+I2S(R2I(GetUnitManaPercent(u)))+" invis="+I2S(B287_BoolToInt(AK7(u)))+" enemy1400="+I2S(B287_BoolToInt(SuijiAI_HasRandomRepelEnemyHero(u,1400.))),1.5)
endif
set mark=""
return false
endif
if B936FocusLogReady(u,'A08V',"驱逐目标") then
call SuijiAI_FocusLogThrottled(u,'A08V',"驱逐目标","target="+GetUnitName(target)+"#"+I2S(GetHandleId(target))+" self="+I2S(B287_BoolToInt(target==u))+" life%="+I2S(R2I(GetUnitLifePercent(target)))+" range="+I2S(R2I(castRange)),1.5)
endif
set pid=GetPlayerId(GetOwningPlayer(u))
set oldCasting=SUIJI_AI_CASTING
set SUIJI_AI_CASTING=true
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A08V',true)
call DisableTrigger(Q04[pid])
set done=B947IssueTargetOrderById("SuijiAI_TryRandomRepel @ war3map.j:123762 (B968)",u,852186,target)
call EnableTrigger(Q04[pid])
if B936FocusLogReady(u,'A08V',"驱逐下令") then
call SuijiAI_FocusLogThrottled(u,'A08V',"驱逐下令","issued="+I2S(B287_BoolToInt(done))+" physical="+I2S(B287_GetPhysicalAbilityId(u,'A08V'))+" target="+I2S(GetHandleId(target))+" current="+I2S(GetUnitCurrentOrder(u)),1.5)
endif
if done then
call SuijiTest_NotifyAICastSuccess(u,'A08V')
call SuijiAI_SetSoftCooldown(u,mark,'A08V',1.50)
call NQ7(h,"SuijiAI|Pulse|"+mark,TimerGetElapsed(W)+.45)
endif
call SuijiAI_RestoreVisibleSkills(u)
set SUIJI_AI_CASTING=oldCasting
set mark=""
set target=null
return done
endfunction
function SuijiAI_TryNativeWalrusPunch takes unit u returns boolean
local group g=null
local unit target=null
local unit candidate=null
local real targetLife=0.
local real candidateLife=0.
local boolean done=false
if u==null or SuijiMode_GetStableHeroIndex(u)!=50 or B287_GetUnitAbilityLevel(u,'A1YQ')<=0 then
return false
endif
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),300.,null)
loop
set candidate=FirstOfGroup(g)
exitwhen candidate==null
call GroupRemoveUnit(g,candidate)
if UnitAlive(candidate) and IsUnitType(candidate,UNIT_TYPE_HERO) and IsUnitIllusion(candidate)==false and IsUnitEnemy(candidate,GetOwningPlayer(u)) and IsUnitVisible(candidate,GetOwningPlayer(u)) and GetUnitLifePercent(candidate)<60. then
set candidateLife=GetWidgetLife(candidate)
if target==null or candidateLife<targetLife then
set target=candidate
set targetLife=candidateLife
endif
endif
endloop
call WR7(g)
set g=null
set candidate=null
if target!=null then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1YQ',true)
set done=B947IssueImmediateOrderById("SuijiAI_TryNativeWalrusPunch @ war3map.j:123807 (B968)",u,OrderId("magicdefense"))
if done then
call SuijiTest_NotifyAICastSuccess(u,'A1YQ')
endif
endif
set target=null
return done
endfunction
function SuijiAI_TryPulseUnit takes unit u returns boolean
local unit target=null
local boolean done=false
if u==null or SUIJI_MODE==false then
return false
endif
if GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER or OO7(GetHandleId(u),"SuijiDone")==false then
return false
endif
call SuijiAI_FocusTraceUnit(u)
if SUIJI_AI_CASTING then
return false
endif
if UnitAlive(u)==false or IsUnitIllusion(u) or IsHideUnit(u) then
return false
endif
if SuijiAI_IsBusyChannelingUnit(u) then
return false
endif
if SuijiAI_TryNativeWalrusPunch(u) then
return true
endif
if SuijiAI_TryRandomRepel(u) then
return true
endif
if not SuijiAI_CanPulseMark(u,"SuijiSmall",.45) and not SuijiAI_CanPulseMark(u,"SuijiUlt",.65) then
return false
endif
set target=SuijiAI_PickHeroTarget(u,u)
if target==null then
return false
endif
set SUIJI_AI_CASTING=true
if GetRandomInt(1,2)==1 then
set done=SuijiAI_TryPulseMark(u,target,"SuijiSmall",.45)
if not done then
set done=SuijiAI_TryPulseMark(u,target,"SuijiUlt",.65)
endif
else
set done=SuijiAI_TryPulseMark(u,target,"SuijiUlt",.65)
if not done then
set done=SuijiAI_TryPulseMark(u,target,"SuijiSmall",.45)
endif
endif
set SUIJI_AI_CASTING=false
set target=null
return done
endfunction
function SuijiAI_RecoverStaleCastLock takes nothing returns nothing
local integer i=0
if not SUIJI_AI_CASTING then
return
endif
// B817: this periodic callback cannot run in the middle of another synchronous
// AI decision. A true flag here was therefore left behind by an interrupted
// copied-template/native-order thread. Clear the stale global context so one
// failed hero cannot permanently block every later random-skill holder.
if SUIJI_AI_FOCUS_LOG then
call DisplayTimedTextToPlayer(Le,0,0,12.,"|cFFFFCC00AI4日志[锁恢复]：|r清除上一轮残留施法锁 skill="+I2S(SUIJI_AI_SKILL_ID)+" template="+I2S(SUIJI_AI_TEMPLATE_UNIT_ID))
endif
set SUIJI_AI_CASTING=false
set SUIJI_AI_ORDER_ID=0
set SUIJI_AI_SKILL_ID=0
set SUIJI_AI_HELPER_ID=0
set SUIJI_AI_TEMPLATE_UNIT_ID=0
set B515_LEGACY_AI_UNIT=null
loop
exitwhen i>$B
if B946DetectCount>0 then
set G0[288+i]=B962Flag(0,288+i,false,"SuijiAI_RecoverStaleCastLock @ war3map.j:123884 (B968)")
else
set G0[288+i]=false
endif
set i=i+1
endloop
endfunction
// Native Luna: select the next link from real marks/attack hits, never from a
// fixed Slardar sleep chain. Uses existing AI ticks; creates no recurring timer.
function LunaAI_TargetValid takes unit lunaAIUnit,unit lunaAITarget returns boolean
return lunaAITarget!=null and GetUnitTypeId(lunaAITarget)!=0 and UnitAlive(lunaAITarget) and IsUnitEnemy(lunaAITarget,GetOwningPlayer(lunaAIUnit)) and IsUnitType(lunaAITarget,UNIT_TYPE_HERO) and not IsUnitIllusion(lunaAITarget) and not IsMagicImmuneUnit(lunaAITarget) and not MHUnit_IsInvulnerable(lunaAITarget) and not IsHideUnit(lunaAITarget) and IsUnitVisible(lunaAITarget,GetOwningPlayer(lunaAIUnit)) and IsUnitInRange(lunaAIUnit,lunaAITarget,1000.)
endfunction
function LunaAI_SafeApproach takes unit lunaAIUnit,unit lunaAITarget returns boolean
local group lunaAIScan=CreateGroup()
local unit lunaAIScanUnit=null
local integer lunaAIEnemies=0
local integer lunaAIAllies=1
local boolean lunaAITower=Q77(lunaAITarget)
call GroupEnumUnitsInRange(lunaAIScan,GetUnitX(lunaAITarget),GetUnitY(lunaAITarget),700.,null)
loop
set lunaAIScanUnit=FirstOfGroup(lunaAIScan)
exitwhen lunaAIScanUnit==null
call GroupRemoveUnit(lunaAIScan,lunaAIScanUnit)
if UnitAlive(lunaAIScanUnit) and IsUnitVisible(lunaAIScanUnit,GetOwningPlayer(lunaAIUnit)) then
if IsUnitEnemy(lunaAIScanUnit,GetOwningPlayer(lunaAIUnit)) then
if IsUnitType(lunaAIScanUnit,UNIT_TYPE_STRUCTURE) and IsUnitInRange(lunaAIScanUnit,lunaAITarget,600.) then
set lunaAITower=true
elseif IsUnitType(lunaAIScanUnit,UNIT_TYPE_HERO) and not IsUnitIllusion(lunaAIScanUnit) then
set lunaAIEnemies=lunaAIEnemies+1
endif
elseif lunaAIScanUnit!=lunaAIUnit and IsUnitType(lunaAIScanUnit,UNIT_TYPE_HERO) and not IsUnitIllusion(lunaAIScanUnit) then
set lunaAIAllies=lunaAIAllies+1
endif
endif
endloop
call DestroyGroup(lunaAIScan)
set lunaAIScan=null
return not lunaAITower and lunaAIEnemies<=lunaAIAllies+1
endfunction
function LunaAI_ReserveDash takes unit lunaAIUnit,integer lunaAISetupSkill returns boolean
local integer lunaAISetupLevel=GetUnitAbilityLevel(lunaAIUnit,lunaAISetupSkill)
local integer lunaAIRLevel=GetUnitAbilityLevel(lunaAIUnit,'A6L3')
local integer lunaAIMana=0
if lunaAISetupLevel<=0 then
return false
endif
set lunaAIMana=B945DefinitionMana(lunaAISetupSkill,lunaAISetupLevel)
if lunaAIRLevel>0 and SuijiAI_SkillReady(lunaAIUnit,'A6L3') then
set lunaAIMana=lunaAIMana+B945DefinitionMana('A6L3',lunaAIRLevel)
endif
return GetUnitState(lunaAIUnit,UNIT_STATE_MANA)>=I2R(lunaAIMana)
endfunction
function B991Damage takes nothing returns boolean
local unit u991=MHEvent_GetUnit()
local unit a991=MHDamageEvent_GetSource()
local integer p991=0
if u991!=null and a991!=null and MHDamageEvent_GetDamage()>0. then
set p991=GetPlayerId(GetOwningPlayer(u991))
// Constant-cost combat evidence shared by all channel-order random ultimates.
if p991<12 and u991==M7[p991] and GetPlayerController(GetOwningPlayer(u991))==MAP_CONTROL_COMPUTER and UnitAlive(u991) and IsUnitEnemy(a991,GetOwningPlayer(u991)) then
set B992HitOwner[p991]=u991
set B992HitUntil[p991]=TimerGetElapsed(W)+2.
endif
if p991<12 and u991==M7[p991] and GetPlayerController(GetOwningPlayer(u991))==MAP_CONTROL_COMPUTER and UnitAlive(u991) and IsUnitType(a991,UNIT_TYPE_HERO) and not IsUnitIllusion(a991) and IsUnitEnemy(a991,GetOwningPlayer(u991)) then
if B991Owner[p991]!=u991 then
set B991Owner[p991]=u991
set B991Until[p991]=0.
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=0.
endif
// Only record evidence here; never issue an order inside a damage event.
if B991Until[p991]<=TimerGetElapsed(W) or B991Attacker[p991]==a991 then
set B991Attacker[p991]=a991
set B991HitTime[p991]=TimerGetElapsed(W)
endif
endif
endif
set u991=null
set a991=null
return false
endfunction
function B991Control takes unit u991,unit a991,integer skill991,string order991 returns boolean
local integer h991=GetHandleId(u991)
if not SuijiAI_CanPayAndCastNormally(u991,skill991) then
return false
endif
if OM7(h991,"SuijiSmallSkill")==skill991 then
set order991=OP7(h991,"SuijiSmallOrder")
elseif OM7(h991,"SuijiUltSkill")==skill991 then
set order991=OP7(h991,"SuijiUltOrder")
endif
return SuijiAI_CastByOrder(u991,a991,skill991,order991)
endfunction
function B991Think takes unit u991 returns boolean
local integer p991=0
local unit a991=null
local boolean done991=false
local unit previous991=B991OrderOwner
if u991==null then
return false
endif
if u991==B991OrderOwner then
set previous991=null
return true
endif
set p991=GetPlayerId(GetOwningPlayer(u991))
if p991>=12 or u991!=M7[p991] or u991!=B991Owner[p991] then
set previous991=null
return false
endif
// Low-level heroes must reach Request's cleanup even during another AI cast.
if SUIJI_AI_CASTING and GetHeroLevel(u991)>=10 then
set previous991=null
return B991Until[p991]>TimerGetElapsed(W)
endif
if not B991Request(u991) then
if B991Until[p991]>0. then
// Let an in-flight cast finish before restoring movement.
if UnitAlive(u991) and (B835AIChannelBlocked(u991) or IsUnitPaused(u991) or IsUnitType(u991,UNIT_TYPE_STUNNED) or IsUnitType(u991,UNIT_TYPE_POLYMORPHED)) then
set previous991=null
return true
endif
set B991Until[p991]=0.
if h4[p991]==B991Attacker[p991] then
set h4[p991]=null
endif
// Release ownership to normal AI; never force a retreat just because a window expired.
endif
set previous991=null
return false
endif
if B835AIChannelBlocked(u991) or IsUnitPaused(u991) or IsUnitType(u991,UNIT_TYPE_STUNNED) or IsUnitType(u991,UNIT_TYPE_POLYMORPHED) or not K57(u991) or TimerGetElapsed(W)<B991ActionTime[p991] then
set previous991=null
return true
endif
set a991=B991Attacker[p991]
set h4[p991]=a991
set B991OrderOwner=u991
set B991ActionTime[p991]=TimerGetElapsed(W)+.35
if not IsMagicImmuneUnit(u991) then
set done991=MC7(u991,ZU[D0])
endif
if not done991 and GetUnitLifePercent(u991)<50. then
set done991=MC7(u991,ZU[it_sadan])
endif
// The reaction controller must not starve the guarded random ultimate pulse.
if not done991 and (LoadInteger(L7,GetHandleId(u991),StringHash("B992ChannelUlt"))!=0 or OM7(GetHandleId(u991),"SuijiUltSkill")=='A1IN') then
set SUIJI_AI_CASTING=true
set done991=SuijiAI_TryPulseMark(u991,a991,"SuijiUlt",.65)
set SUIJI_AI_CASTING=false
endif
if not done991 then
set B991EscapeDone=false
call ExecuteFunc("B991Escape")
set done991=B991EscapeDone
endif
// Short control only: do not invoke a full offensive chain or distant chase.
if not done991 and GetUnitTypeId(u991)=='HMD0' and SuijiAI_CanPayAndCastNormally(u991,'AMdD') and h9[p991]!=null and not IsUnitInRange(u991,h9[p991],150.) then
call SaveReal(MiaoTable,GetHandleId(u991),145,Atan2(GetUnitY(h9[p991])-GetUnitY(u991),GetUnitX(h9[p991])-GetUnitX(u991)))
call SaveReal(MiaoTable,GetHandleId(u991),146,GetGameTime()+1.)
set done991=B947IssueImmediateOrder("B991 Miao escape",u991,"fanofknives")
endif
if not done991 and GetUnitTypeId(u991)=='HMD0' and SuijiAI_CanPayAndCastNormally(u991,'AMdQ') then
set done991=B947IssueImmediateOrder("B991 Miao control",u991,"stomp")
endif
if not done991 then
set done991=B991Control(u991,a991,'A02A',"thunderbolt")
endif
if not done991 then
set done991=B991Control(u991,a991,'A190',"thunderbolt")
endif
if not done991 then
set done991=B991Control(u991,a991,'A0SK',"shockwave")
endif
if not done991 then
set done991=B991Control(u991,a991,'A03Y',"stomp")
endif
if not done991 and (GetUnitCurrentOrder(u991)!=OrderId("attack") or MHUnit_GetAttackTargetUnit(u991)!=a991) then
set done991=B947IssueTargetOrder("B991 close retaliation",u991,"attack",a991)
endif
set B991OrderOwner=previous991
set previous991=null
set a991=null
return true
endfunction
