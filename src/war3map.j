if skill=='A0ES' or skill=='A0G5' or skill=='A0G4' or skill=='A1D8' or skill=='A0CA' or skill=='A0CG' or skill=='A0CT' or skill=='A0BR' then
return true
endif
if skill=='A0FU' or skill=='A0FA' or skill=='A0C6' or skill=='A0EC' or skill=='A0I8' or skill=='A0MG' or skill=='A0NS' or skill=='A1DA' then
return true
endif
if skill=='A0FX' or skill=='A0NA' or skill=='A0H9' or skill=='A0OI' or skill=='A0N7' or skill=='A0MW' or skill=='A10Q' or skill=='A1DB' then
