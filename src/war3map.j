call SaveUnitHandle(L7,(I97),(22000+X87),(b1060GetEventDamageSource))
call SaveReal(L7,(I97),(20000+X87),((b1060GetEventDamage)*1.0))
call YN7(IH7,b1060GetEventDamage)
elseif b1060GetTriggerEventId!=EVENT_UNIT_DAMAGED and b1060GetTriggerEventId!=EVENT_WIDGET_DEATH then
if QU5!=QQ5 then
set QQ5=QU5
set QP5=YIO
