function OHv takes nothing returns boolean
return IsUnitAlly(IN4,GetOwningPlayer(GetFilterUnit()))and GZZ(GetFilterUnit()) and GetWidgetLife(GetFilterUnit())/GetUnitState(GetFilterUnit(),UNIT_STATE_MAX_LIFE)<=.2
endfunction
function Ojv takes nothing returns nothing
local unit greavesTarget934=GetEnumUnit()
local integer greavesKey934=GetHandleId(greavesTarget934)
local integer greavesCount934=LoadInteger(L7,greavesKey934,StringHash("B934GreavesSources"))-1
if greavesCount934<=0 then
call RemoveSavedInteger(L7,greavesKey934,StringHash("B934GreavesSources"))
if greavesTarget934!=null and GetUnitTypeId(greavesTarget934)!=0 then
call UnitRemoveAbility(greavesTarget934,'A2VT')
call UnitRemoveAbility(greavesTarget934,'A2VU')
endif
else
call SaveInteger(L7,greavesKey934,StringHash("B934GreavesSources"),greavesCount934)
endif
set greavesTarget934=null
endfunction
function OJv takes nothing returns nothing
local unit greavesTarget934=GetEnumUnit()
local integer greavesKey934=GetHandleId(greavesTarget934)
local integer greavesCount934=0
if not IsUnitInGroup(greavesTarget934,R8) then
set greavesCount934=LoadInteger(L7,greavesKey934,StringHash("B934GreavesSources"))
call SaveInteger(L7,greavesKey934,StringHash("B934GreavesSources"),greavesCount934+1)
if greavesCount934==0 then
call XF7(greavesTarget934,'A2VT')
call XF7(greavesTarget934,'A2VU')
endif
endif
set greavesTarget934=null
endfunction
function Okv takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=LoadUnitHandle(L7,I97,2)
local group g=LoadGroupHandle(L7,I97,340)
local group g2=null
local item greavesItem934=null
local item greavesDrop934=null
local integer greavesSlot934=0
local integer greavesOwner934=LoadInteger(L7,I97,StringHash("B934GreavesOwner"))
if GetTriggerEventId()==EVENT_UNIT_DROP_ITEM then
set greavesDrop934=GetManipulatedItem()
endif
if ZX7!=null and GetUnitTypeId(ZX7)!=0 then
loop
exitwhen greavesSlot934>=UnitInventorySize(ZX7) or greavesItem934!=null
set greavesItem934=UnitItemInSlot(ZX7,greavesSlot934)
if greavesItem934==greavesDrop934 or GetItemTypeId(greavesItem934)!=ZU[R06] then
set greavesItem934=null
endif
set greavesSlot934=greavesSlot934+1
endloop
endif
if ZX7==null or GetUnitTypeId(ZX7)==0 or greavesItem934==null then
if LoadTriggerHandle(L7,greavesOwner934,StringHash("B934GreavesController"))==t then
call RemoveSavedHandle(L7,greavesOwner934,StringHash("B934GreavesController"))
endif
call DisableTrigger(t)
call FlushChildHashtable(L7,I97)
call OZ7(t)
call ForGroup(g,function Ojv)
call WR7(g)
else
set g2=CreateGroup()
set IN4=ZX7
if not XH7(ZX7) then
call GroupEnumUnitsInRange(g2,GetUnitX(ZX7),GetUnitY(ZX7),925,Condition(function OHv))
endif
set R8=g
call ForGroup(g2,function OJv)
call GroupRemoveGroup(g2,g)
call ForGroup(g,function Ojv)
call SaveGroupHandle(L7,I97,340,g2)
call WR7(g)
endif
set t=null
set ZX7=null
set g=null
set g2=null
set greavesItem934=null
set greavesDrop934=null
return false
endfunction
function OKv takes unit ZX7 returns nothing
local trigger t=null
local integer I97=0
local integer greavesOwner934=GetHandleId(ZX7)
if ZX7==null or GetUnitTypeId(ZX7)==0 then
return
endif
if LoadTriggerHandle(L7,greavesOwner934,StringHash("B934GreavesController"))!=null then
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveTriggerHandle(L7,greavesOwner934,StringHash("B934GreavesController"),t)
call SaveInteger(L7,I97,StringHash("B934GreavesOwner"),greavesOwner934)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DROP_ITEM)
call TriggerAddCondition(t,Condition(function Okv))
call SaveUnitHandle(L7,I97,2,ZX7)
call SaveGroupHandle(L7,I97,340,CreateGroup())
set t=null
endfunction
