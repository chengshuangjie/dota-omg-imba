function PW1 takes nothing returns boolean
local player p
local integer i
local integer id
local integer Q38
set i=1
loop
exitwhen i>5
set p=Z7[i]
set id=GetPlayerId(p)
set Q38=GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)
if VSS[id]<(TimerGetElapsed(W))then
set EV0[id]=Q38
elseif Q38>EV0[id]then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,EV0[id])
else
set EV0[id]=Q38
endif
set p=A7[i]
set id=GetPlayerId(p)
set Q38=GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)
if VSS[id]<(TimerGetElapsed(W))then
set EV0[id]=Q38
elseif Q38>EV0[id]then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,EV0[id])
else
set EV0[id]=Q38
endif
set i=i+1
endloop
return false
endfunction
function Q68 takes nothing returns nothing
endfunction
// B832: only present human teammates rank; native bounty remains enabled.
function B832WardHuman takes player wardPlayer returns boolean
local integer wardPid=GetPlayerId(wardPlayer)
return wardPlayer!=null and wardPid>0 and wardPid<12 and wardPid!=6 and GetPlayerController(wardPlayer)==MAP_CONTROL_USER and GetPlayerSlotState(wardPlayer)==PLAYER_SLOT_STATE_PLAYING and KKServerScore_Left[wardPid]==false
endfunction
function B832WardRank takes player wardPlayer returns integer
local integer wardScan=1
local integer wardOwn=B832WardCount[GetPlayerId(wardPlayer)]
local integer wardMin=wardOwn
local integer wardMax=wardOwn
local integer wardHumanCount=0
local player wardOther
if B832WardHuman(wardPlayer)==false then
return 0
endif
loop
exitwhen wardScan>11
set wardOther=Player(wardScan)
if B832WardHuman(wardOther) and IsPlayerAlly(wardOther,wardPlayer) then
set wardHumanCount=wardHumanCount+1
set wardMin=IMinBJ(wardMin,B832WardCount[wardScan])
set wardMax=IMaxBJ(wardMax,B832WardCount[wardScan])
endif
set wardScan=wardScan+1
endloop
set wardOther=null
// B833: a sole human with a valid ward is the leader, never the loser.
if wardHumanCount==1 and wardOwn>0 then
return 1
elseif wardMin==wardMax then
return 0
elseif wardOwn==wardMax then
return 1
elseif wardOwn==wardMin then
return -1
endif
return 0
endfunction
function B832WardExcluded takes real wardX,real wardY returns boolean
// Exact saved editor rectangles; inclusive boundaries, overlap never counts.
// chayan1
if wardX>=-7808. and wardX<=-5472. and wardY>=-7808. and wardY<=-3360. then
return true
// chayan2
elseif wardX>=-5600. and wardX<=-3584. and wardY>=-7840. and wardY<=-4928. then
return true
// chayan3
elseif wardX>=-5632. and wardX<=-4608. and wardY>=-5024. and wardY<=-3904. then
return true
// chayan4
elseif wardX>=-3872. and wardX<=-1952. and wardY>=-8128. and wardY<=-7520. then
return true
endif
return false
endfunction
function B832WardStatus takes player wardPlayer returns nothing
local integer wardDirection=B832WardRank(wardPlayer)
local string wardSuffix="无调整"
if wardDirection==1 then
set wardSuffix="+10%"
elseif wardDirection==-1 then
set wardSuffix="-10%"
endif
call DisplayTimedTextToPlayer(wardPlayer,0,0,8.,"有效插眼："+I2S(B832WardCount[GetPlayerId(wardPlayer)])+"；兵线/野怪赏金："+wardSuffix+"。仅比较同队在场真人。")
endfunction
function B832WardPlaced takes player wardPlayer,unit wardCreated returns nothing
local integer wardPid=GetPlayerId(wardPlayer)
if B832WardHuman(wardPlayer)==false or wardCreated==null or (GetUnitTypeId(wardCreated)!='o004' and GetUnitTypeId(wardCreated)!='oeye') then
return
endif
if B832WardExcluded(GetUnitX(wardCreated),GetUnitY(wardCreated)) then
call DisplayTimedTextToPlayer(wardPlayer,0,0,5.,"此处守卫不计入有效插眼数量。")
return
endif
set B832WardCount[wardPid]=B832WardCount[wardPid]+1
set B832WardHasScore=true
call B832WardStatus(wardPlayer)
endfunction
function B832WardCreep takes unit wardVictim returns boolean
local integer wardType=GetUnitTypeId(wardVictim)
local player wardOwner=GetOwningPlayer(wardVictim)
local boolean wardResult=false
if wardVictim==null or wardType==0 or IsUnitType(wardVictim,UNIT_TYPE_HERO) or IsUnitType(wardVictim,UNIT_TYPE_STRUCTURE) or IsUnitType(wardVictim,UNIT_TYPE_SUMMONED) or IsUnitIllusion(wardVictim) then
set wardOwner=null
return false
endif
if wardOwner==Z7[0] or wardOwner==A7[0] then
// Same twelve lane creep types as QL8's last-hit counter.
set wardResult=wardType=='ugho' or wardType=='unec' or wardType=='esen' or wardType=='edry' or wardType=='u001' or wardType=='u002' or wardType=='e00V' or wardType=='e00W' or wardType=='ebal' or wardType=='e026' or wardType=='umtw' or wardType=='u00R'
elseif wardOwner==B7 then
// Normal/ancient camp spawns LC8..DJ9 only: no Roshan, defense bosses or dummies.
set wardResult=wardType=='n0HW' or wardType=='n0HX' or wardType=='njg1' or wardType=='njga' or wardType=='nbdo' or wardType=='nbds' or wardType=='nbdk' or wardType=='nbwm' or wardType=='ngst' or wardType=='nggr' or wardType=='n0LC' or wardType=='n0LD' or wardType=='nogm' or wardType=='nomg' or wardType=='nfpc' or wardType=='nfpu' or wardType=='nsth' or wardType=='nstl' or wardType=='nsat' or wardType=='nwlg' or wardType=='n00S' or wardType=='n026' or wardType=='nkol' or wardType=='nkob' or wardType=='nkot' or wardType=='nftb' or wardType=='nfsh' or wardType=='ncen' or wardType=='ncnk' or wardType=='ngns' or wardType=='ngh1' or wardType=='npfl' or wardType=='nowe' or wardType=='nowb' or wardType=='nmrl' or wardType=='nmrm' or wardType=='nmrr' or wardType=='ndtr' or wardType=='ndtw'
endif
set wardOwner=null
return wardResult
endfunction
function B832WardUntrack takes integer wardIndex returns nothing
local integer wardKey
local integer wardPendingIndex
if wardIndex<1 or wardIndex>B832WardTracked then
return
endif
set wardKey=GetHandleId(B832WardTrackedUnit[wardIndex])
set wardPendingIndex=LoadInteger(B832WardTable,wardKey,3)
if wardPendingIndex>0 and wardPendingIndex<=B832WardPendingCount and B832WardPending[wardPendingIndex]==wardKey then
set B832WardPending[wardPendingIndex]=B832WardPending[B832WardPendingCount]
call SaveInteger(B832WardTable,B832WardPending[wardPendingIndex],3,wardPendingIndex)
set B832WardPending[B832WardPendingCount]=0
set B832WardPendingCount=B832WardPendingCount-1
endif
call DisableTrigger(B832WardTrackedTrigger[wardIndex])
call OZ7(B832WardTrackedTrigger[wardIndex])
call FlushChildHashtable(B832WardTable,wardKey)
if wardIndex<B832WardTracked then
set B832WardTrackedUnit[wardIndex]=B832WardTrackedUnit[B832WardTracked]
set B832WardTrackedTrigger[wardIndex]=B832WardTrackedTrigger[B832WardTracked]
call SaveInteger(B832WardTable,GetHandleId(B832WardTrackedUnit[wardIndex]),0,wardIndex)
endif
set B832WardTrackedUnit[B832WardTracked]=null
set B832WardTrackedTrigger[B832WardTracked]=null
set B832WardTracked=B832WardTracked-1
endfunction
function B832WardBountyDelta takes player wardPlayer,integer wardBounty returns integer
local integer wardPid=GetPlayerId(wardPlayer)
local integer wardDirection=B832WardRank(wardPlayer)
local integer wardNumerator
local integer wardDelta
if wardDirection==0 or wardBounty<=0 then
return 0
endif
// Carry tenths instead of rounding every small creep's reward away.
set wardNumerator=wardDirection*wardBounty+B832WardGoldFraction[wardPid]
set wardDelta=wardNumerator/10
set B832WardGoldFraction[wardPid]=wardNumerator-wardDelta*10
return wardDelta
endfunction
function B832WardCreepEvent takes nothing returns boolean
local unit b1060GetKillingUnit=GetKillingUnit()
local boolean b1060ReturnValue
local unit wardVictim=GetTriggerUnit()
local integer wardKey=GetHandleId(wardVictim)
local integer wardPid=1
local player wardPlayer
local unit wardKiller
local integer wardBounty
local integer wardDelta
local integer wardIndex=LoadInteger(B832WardTable,wardKey,0)
local integer wardPendingIndex
local integer wardParentKey
if GetTriggerEventId()==EVENT_UNIT_STATE_LIMIT then
// Native life==0 fires before native bounty; unit death follows that award.
// Snapshot only at death, never on attacks, damage ticks, or a periodic gold poll.
if B832WardPendingCount>=64 then
// Fail closed if an abnormal death recursion exhausts the bounded context stack.
set wardPendingIndex=1
loop
exitwhen wardPendingIndex>B832WardPendingCount
call SaveBoolean(B832WardTable,B832WardPending[wardPendingIndex],1,false)
call SaveInteger(B832WardTable,B832WardPending[wardPendingIndex],3,0)
set B832WardPending[wardPendingIndex]=0
set wardPendingIndex=wardPendingIndex+1
endloop
set B832WardPendingCount=0
set wardVictim=null
set b1060ReturnValue=false
set b1060GetKillingUnit=null
return b1060ReturnValue
endif
if B832WardHasScore and B832WardCreep(wardVictim) and IsUnitType(wardVictim,UNIT_TYPE_DEAD) and LoadBoolean(B832WardTable,wardKey,1)==false and B832WardPendingCount<64 then
set B832WardPendingCount=B832WardPendingCount+1
set B832WardPending[B832WardPendingCount]=wardKey
call SaveInteger(B832WardTable,wardKey,3,B832WardPendingCount)
call SaveBoolean(B832WardTable,wardKey,1,true)
call SaveReal(B832WardTable,wardKey,2,TimerGetElapsed(W))
loop
exitwhen wardPid>11
if wardPid!=6 then
call SaveInteger(B832WardTable,wardKey,10+wardPid,GetPlayerState(Player(wardPid),PLAYER_STATE_RESOURCE_GOLD))
call SaveInteger(B832WardTable,wardKey,30+wardPid,ET[wardPid])
endif
set wardPid=wardPid+1
endloop
endif
else
set wardKiller=b1060GetKillingUnit
set wardPlayer=GetOwningPlayer(wardKiller)
set wardPid=GetPlayerId(wardPlayer)
if wardKiller!=null and B832WardHuman(wardPlayer) and B832WardCreep(wardVictim) and IsUnitEnemy(wardVictim,wardPlayer) and GetPlayerState(GetOwningPlayer(wardVictim),PLAYER_STATE_GIVES_BOUNTY)>0 and LoadBoolean(B832WardTable,wardKey,1) and LoadReal(B832WardTable,wardKey,2)==TimerGetElapsed(W) then
// S49's separately tracked Greevil's Greed income is not native creep bounty.
set wardBounty=GetPlayerState(wardPlayer,PLAYER_STATE_RESOURCE_GOLD)-LoadInteger(B832WardTable,wardKey,10+wardPid)-(ET[wardPid]-LoadInteger(B832WardTable,wardKey,30+wardPid))
set wardDelta=B832WardBountyDelta(wardPlayer,wardBounty)
if wardDelta!=0 then
call SetPlayerState(wardPlayer,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(wardPlayer,PLAYER_STATE_RESOURCE_GOLD)+wardDelta)
endif
endif
// Destroy the two unit-scoped registrations and all snapshots on every death.
// Nested creep deaths must not be counted again as the outer creep's bounty.
if LoadBoolean(B832WardTable,wardKey,1) and B832WardPendingCount>1 then
set wardPendingIndex=1
loop
exitwhen wardPendingIndex>B832WardPendingCount
set wardParentKey=B832WardPending[wardPendingIndex]
if wardParentKey!=wardKey then
set wardPid=1
loop
exitwhen wardPid>11
if wardPid!=6 then
call SaveInteger(B832WardTable,wardParentKey,10+wardPid,LoadInteger(B832WardTable,wardParentKey,10+wardPid)+GetPlayerState(Player(wardPid),PLAYER_STATE_RESOURCE_GOLD)-LoadInteger(B832WardTable,wardKey,10+wardPid))
call SaveInteger(B832WardTable,wardParentKey,30+wardPid,LoadInteger(B832WardTable,wardParentKey,30+wardPid)+ET[wardPid]-LoadInteger(B832WardTable,wardKey,30+wardPid))
endif
set wardPid=wardPid+1
endloop
endif
set wardPendingIndex=wardPendingIndex+1
endloop
endif
call B832WardUntrack(wardIndex)
endif
set wardVictim=null
set wardPlayer=null
set wardKiller=null
set b1060ReturnValue=false
set b1060GetKillingUnit=null
return b1060ReturnValue
endfunction
function B832WardTrack takes unit wardCreepUnit returns nothing
local trigger wardCreepTrigger
local integer wardKey
if B832WardEnabled==false or B832WardTracked>=4096 or wardCreepUnit==null then
return
endif
set wardKey=GetHandleId(wardCreepUnit)
if LoadInteger(B832WardTable,wardKey,0)>0 then
return
endif
if B832WardCreep(wardCreepUnit)==false or UnitAlive(wardCreepUnit)==false then
return
endif
set wardCreepTrigger=CreateTrigger()
set B832WardTracked=B832WardTracked+1
set B832WardTrackedUnit[B832WardTracked]=wardCreepUnit
set B832WardTrackedTrigger[B832WardTracked]=wardCreepTrigger
call SaveInteger(B832WardTable,wardKey,0,B832WardTracked)
call TriggerRegisterUnitStateEvent(wardCreepTrigger,wardCreepUnit,UNIT_STATE_LIFE,EQUAL,0.)
call TriggerRegisterUnitEvent(wardCreepTrigger,wardCreepUnit,EVENT_UNIT_DEATH)
call TriggerAddCondition(wardCreepTrigger,B832WardCreepCondition)
set wardCreepTrigger=null
endfunction
function B832WardPrune takes nothing returns nothing
local integer wardChecks=0
// Reuse the existing 1-second maintenance callback. At most 16 handles per call;
// death already cleans immediately. This catches RemoveUnit/owner changes too.
loop
exitwhen wardChecks>=16 or B832WardTracked==0
if B832WardPruneCursor>B832WardTracked then
set B832WardPruneCursor=1
endif
if UnitAlive(B832WardTrackedUnit[B832WardPruneCursor])==false or B832WardCreep(B832WardTrackedUnit[B832WardPruneCursor])==false then
call B832WardUntrack(B832WardPruneCursor)
else
set B832WardPruneCursor=B832WardPruneCursor+1
endif
set wardChecks=wardChecks+1
endloop
endfunction
function B832WardQuery takes nothing returns boolean
if B832WardHuman(GetTriggerPlayer()) then
call B832WardStatus(GetTriggerPlayer())
endif
return false
endfunction
// ===== XOMG1 item pools (SU finished equip, probe-filtered) + neutral drop =====
function B1063ItemEligible takes integer rawcode returns boolean
	local item probe=null
	if rawcode==0 then
	return false
	endif
	// inline denylist (was ED9): scripted reward/quest/Aegis set.
	if rawcode=='I006' or rawcode=='I008' or rawcode=='I00J' or rawcode=='I00K' or rawcode=='I007' or rawcode=='I0PJ' or rawcode=='I0Q5' or rawcode=='I0X5' then
	return false
	endif
	set probe=CreateItem(rawcode,-500.,-500.)
	if probe==null then
	return false
	endif
	if IsItemPowerup(probe) then
	call RemoveItem(probe)
	set probe=null
	return false
	endif
	call RemoveItem(probe)
	set probe=null
	return true
endfunction
function B1063BuildCheapPool takes nothing returns nothing
	local integer i=1
	local integer p=0
	if B1063PoolBuilt or EV<=0 then
	return
	endif
	set B1063CheapCount=0
	loop
	exitwhen i>EV or B1063CheapCount>=256
	if ZU[i]!=0 then
	set p=Get_Item_Price(ZU[i])
	if p>0 and p<=1000 and B1063ItemEligible(ZU[i]) then
	set B1063CheapCount=B1063CheapCount+1
	set B1063CheapPool[B1063CheapCount]=ZU[i]
	endif
	endif
	set i=i+1
	endloop
	set B1063PoolBuilt=true
endfunction
function B1063BuildLotteryPool takes nothing returns nothing
	local integer i=1
	local integer p=0
	if B1063LotteryBuilt or EV<=0 then
	return
	endif
	set B1063LotteryCount=0
	set B1063LotteryMinPrice=0
	loop
	exitwhen i>EV or B1063LotteryCount>=128
	if ZU[i]!=0 then
	set p=Get_Item_Price(ZU[i])
	if p>=1000 and B1063ItemEligible(ZU[i]) then
	set B1063LotteryCount=B1063LotteryCount+1
	set B1063LotteryPool[B1063LotteryCount]=ZU[i]
	if B1063LotteryMinPrice==0 or p<B1063LotteryMinPrice then
	set B1063LotteryMinPrice=p
	endif
	endif
	endif
	set i=i+1
	endloop
	set B1063LotteryBuilt=true
endfunction
function B1063NeutralDropAction takes nothing returns nothing
	local unit victim=GetTriggerUnit()
	local unit killer=GetKillingUnit()
	local player killerOwner=null
	local integer h=0
	local integer pick=0
	local integer roll=0
	local integer itemId=0
	local integer price=0
	local item drop=null
	if victim==null or not B832WardCreep(victim) then
	set victim=null
	set killer=null
	return
	endif
	call B1063BuildCheapPool()
	set h=GetHandleId(victim)
	if LoadBoolean(L7,h,16100) then
	set victim=null
	set killer=null
	return
	endif
	call SaveBoolean(L7,h,16100,true)
	set B1063DropEligibleKills=B1063DropEligibleKills+1
	if B1063CheapCount<=0 then
	if B1063DropLogCount<12 then
	set B1063DropLogCount=B1063DropLogCount+1
	call XOMG_LogEvent("DROP_SKIP eligible="+I2S(B1063DropEligibleKills)+" pool=0 victim="+GetObjectName(GetUnitTypeId(victim)))
	endif
	set victim=null
	set killer=null
	return
	endif
	set roll=GetRandomInt(1,10)
	set B1063DropRollCount=B1063DropRollCount+1
	set B1063DropLastRoll=roll
	if B1063DropLogCount<12 then
	set B1063DropLogCount=B1063DropLogCount+1
	call XOMG_LogEvent("DROP_ROLL eligible="+I2S(B1063DropEligibleKills)+" roll="+I2S(roll)+" pool="+I2S(B1063CheapCount)+" victim="+GetObjectName(GetUnitTypeId(victim)))
	endif
	if roll!=1 then
	set victim=null
	set killer=null
	return
	endif
	set pick=GetRandomInt(1,B1063CheapCount)
	set itemId=B1063CheapPool[pick]
	set price=Get_Item_Price(itemId)
	set drop=CreateItem(itemId,GetUnitX(victim),GetUnitY(victim))
	if drop!=null then
	set B1063DropSuccessCount=B1063DropSuccessCount+1
	call XOMG_LogEvent("DROP_OK count="+I2S(B1063DropSuccessCount)+" item="+GetObjectName(itemId)+" raw="+I2S(itemId)+" price="+I2S(price)+" roll="+I2S(roll))
	if killer!=null then
	set killerOwner=GetOwningPlayer(killer)
	if GetPlayerController(killerOwner)==MAP_CONTROL_USER then
	call DisplayTimedTextToPlayer(killerOwner,0,0,8.,"|cff00ff00[野怪掉落] 获得 "+GetObjectName(itemId)+"（价值"+I2S(price)+"）|r")
	endif
	endif
	else
	call XOMG_LogEvent("DROP_CREATE_FAIL item="+GetObjectName(itemId)+" raw="+I2S(itemId)+" price="+I2S(price))
	endif
	set victim=null
	set killer=null
	set killerOwner=null
	set drop=null
endfunction
function B1063DropPoolDeferred takes nothing returns nothing
	local timer poolTimer=GetExpiredTimer()
	call B1063BuildCheapPool()
	call B1063BuildLotteryPool()
	call XOMG_LogEvent("DROP_INIT ver="+XOMG_VERSION+" cheap_pool="+I2S(B1063CheapCount)+" lottery_pool="+I2S(B1063LotteryCount)+" chance=10 max_price=1000 source=ZU")
	call PauseTimer(poolTimer)
	call DestroyTimer(poolTimer)
	set poolTimer=null
endfunction
function B1063DropTest takes nothing returns nothing
	local player testPlayer=GetTriggerPlayer()
	local integer testPid=GetPlayerId(testPlayer)
	local integer testPick=0
	local integer testItem=0
	local integer testPrice=0
	local item testDrop=null
	call B1063BuildCheapPool()
	call X37(testPlayer,"[掉落诊断] pool="+I2S(B1063CheapCount)+" eligible="+I2S(B1063DropEligibleKills)+" rolls="+I2S(B1063DropRollCount)+" success="+I2S(B1063DropSuccessCount)+" last="+I2S(B1063DropLastRoll))
	call XOMG_LogEvent("DROP_TEST pid="+I2S(testPid)+" pool="+I2S(B1063CheapCount)+" eligible="+I2S(B1063DropEligibleKills)+" rolls="+I2S(B1063DropRollCount)+" success="+I2S(B1063DropSuccessCount)+" last="+I2S(B1063DropLastRoll))
	if B1063CheapCount>0 then
	set testPick=GetRandomInt(1,B1063CheapCount)
	set testItem=B1063CheapPool[testPick]
	set testPrice=Get_Item_Price(testItem)
	set testDrop=CreateItem(testItem,GetStartLocationX(GetPlayerStartLocation(testPlayer)),GetStartLocationY(GetPlayerStartLocation(testPlayer)))
	if testDrop!=null then
	call X37(testPlayer,"[掉落诊断] 已在出生点生成 "+GetObjectName(testItem)+"（价值"+I2S(testPrice)+"）")
	call XOMG_LogEvent("DROP_TEST_OK pid="+I2S(testPid)+" item="+GetObjectName(testItem)+" raw="+I2S(testItem)+" price="+I2S(testPrice))
	else
	call X37(testPlayer,"[掉落诊断] CreateItem失败。")
	call XOMG_LogEvent("DROP_TEST_CREATE_FAIL pid="+I2S(testPid)+" raw="+I2S(testItem)+" price="+I2S(testPrice))
	endif
	else
	call X37(testPlayer,"[掉落诊断] 低价装备池为空，请查看1-miao-error\\imba-runtime.text。")
	endif
	set testPlayer=null
	set testDrop=null
endfunction
function B1063NeutralDropInit takes nothing returns nothing
	local trigger t=CreateTrigger()
	local timer poolTimer=CreateTimer()
	call TriggerRegisterPlayerUnitEvent(t,Player(12),EVENT_PLAYER_UNIT_DEATH,null)
	call TriggerAddAction(t,function B1063NeutralDropAction)
	call TimerStart(poolTimer,2.00,false,function B1063DropPoolDeferred)
	set t=null
	set poolTimer=null
endfunction
function B832WardInit takes nothing returns nothing
local trigger wardChat=CreateTrigger()
local integer wardFirst=1
set B832WardCreepCondition=Condition(function B832WardCreepEvent)
loop
exitwhen wardFirst>11
if B832WardHuman(Player(wardFirst)) then
call TriggerRegisterPlayerChatEvent(wardChat,Player(wardFirst),"-wards",true)
// B833: one present human must enable real bounty settlement, not just its UI.
set B832WardEnabled=true
endif
set wardFirst=wardFirst+1
endloop
call TriggerAddCondition(wardChat,Condition(function B832WardQuery))
set wardChat=null
call B1063NeutralDropInit()
endfunction
