function rM4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local unit IH7=(LoadUnitHandle(L7,(h),(-$3CFCF864)))
local group g=(LoadGroupHandle(L7,(h),($214C62CC)))
local real v=LoadReal(L7,h,'84ER')
local real ya=(LoadReal(L7,(h),($434FA58A)))
local real yy=(LoadReal(L7,(h),(-$41027418)))+v
if u==null or IH7==null or GetUnitTypeId(u)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(u)==false then
if u!=null and GetUnitTypeId(u)!=0 then
call PauseUnitEx(u,false)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
endif
if g!=null then
call WR7(g)
endif
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set g=null
set u=null
set IH7=null
set t=null
return
endif
call SaveReal(L7,(h),(-$41027418),((yy)*1.))
set ZB4=yy
call ForGroup(g,function rJ4)
if ya==0 then
    set v=v-3
else
    set v=v-1
endif
call SaveReal(L7,h,'84ER',v*1.)
if v<-15 then
    set ya=ya+1
    call SaveReal(L7,(h),($434FA58A),((ya)*1.))
    if ya<2 then
call SaveReal(L7,h,'84ER',19*1.)
        call Play_JH_Sound(u)
        // call ForGroup(g,function rL4)
    else
        call PauseUnitEx(u,false)
        call SetUnitTimeScale(u,1)
        call SetUnitInvulnerable(u,false)
        call B947IssueTargetOrderById("rM4 @ war3map.j:219273 (B968)",u,$D000F,IH7)
        call DestroyEffect(AddSpecialEffect("tx\\jianhao\\jianhao_stomp.mdl",(LoadReal(L7,(h),($12315AF9))),(LoadReal(L7,(h),(-$91F1147)))))
        set IN4=u
        set ZB4=(LoadReal(L7,(h),(-$3F5412B6)))
        call ForGroup(g,function rK4)
        call WR7(g)
        call FlushChildHashtable(L7,((h)))
        call OZ7(t)
    endif
endif
if v==0 and ya==1 then
    call PauseUnitEx(u,false)
    call SetUnitTimeScale(u,1)
    call SetUnitInvulnerable(u,false)
    call B947IssueTargetOrderById("rM4 @ war3map.j:219287 (B968)",u,$D000F,IH7)
    call DestroyEffect(AddSpecialEffect("tx\\jianhao\\jianhao_stomp.mdl",(LoadReal(L7,(h),($12315AF9))),(LoadReal(L7,(h),(-$91F1147)))))
    set IN4=u
    set ZB4=(LoadReal(L7,(h),(-$3F5412B6)))
    call ForGroup(g,function rK4)
    call WR7(g)
    call FlushChildHashtable(L7,((h)))
    call OZ7(t)
endif
set g=null
set u=null
set IH7=null
set t=null
endfunction
function rl4 takes nothing returns nothing
local unit u=IN4
local unit IH7=GetEnumUnit()
local real d
if IsUnitAliveBJ(IH7)and IsUnitEnemy(u,GetOwningPlayer(IH7))and IsUnitVisible(IH7,GetOwningPlayer(u)) and SquareRoot((GetUnitX(IH7)-GetUnitX(u))*(GetUnitX(IH7)-GetUnitX(u))+(GetUnitY(IH7)-GetUnitY(u))*(GetUnitY(IH7)-GetUnitY(u)))<1300 then
set d=SquareRoot((ZB4-GetUnitX(IH7))*(ZB4-GetUnitX(IH7))+(ZC4-GetUnitY(IH7))*(ZC4-GetUnitY(IH7)))
if d<ZA4 then
set ZZ4=IH7
set ZA4=d
endif
endif
set u=null
set IH7=null
endfunction
function rN4 takes unit u returns unit
set IN4=u
set ZZ4=null
if ZGS_DIR[GetPlayerId(GetOwningPlayer(u))]==1 then
    set ZB4=(LoadReal(L7,GetHandleId((u)),'ZGSX'))
    set ZC4=(LoadReal(L7,GetHandleId((u)),'ZGSY'))
else
    set ZB4=LoadReal(L7,GetHandleId(u),'MOUX')
    set ZC4=LoadReal(L7,GetHandleId(u),'MOUY')
endif
set ZA4=$F423F
call ForGroup(yw,function rl4)
return ZZ4
endfunction
function JXZ2 takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit u=GetTriggerUnit()
local unit IH7
local real fx
local trigger t
local integer h
local group g
local integer level=0
local real YM7
local real d=0
if u==null or GetUnitTypeId(u)==0 then
set u=null
set b1060GetTriggerEventId=null
return
endif
set level=GetUnitAbilityLevel(u,'A4IX')
set d=GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS)
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_CAST then
    set IH7=rN4(u)
    if IH7!=null then
        call SaveUnitHandle(L7,(GetHandleId(u)),($5B2CAC46),(IH7))
    else
        call KR7(u)
        call X377(GetOwningPlayer(u),"周围没有被击飞的英雄")
    endif
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_EFFECT then
    set IH7=(LoadUnitHandle(L7,(GetHandleId(u)),($5B2CAC46)))
    if IH7==null or GetUnitTypeId(IH7)==0 or UnitAlive(IH7)==false then
        set u=null
        set IH7=null
        set t=null
        set g=null
        set b1060GetTriggerEventId=null
        return
    endif
    call SaveInteger(L7,(GetHandleId(u)),('ceng'),(0)) //移除Q的BUFF 重置层数
    call UnitRemoveAbility(u,'A4IV')
    call UnitRemoveAbility(u,'B0KB')
    call UnitRemoveAbility(u,'A4JC')
    call SaveReal(L7,(GetHandleId(u)),(-$58A9EA4D),((100)*1.))  //满盾
    call Gc(u)
    call Z57(u,'A4J0', 1, 15,'B0KD') //护甲穿透BUFF
    set YM7=100+100*level+d*2.5
    set fx=bj_RADTODEG*Atan2(GetUnitY(IH7)-GetUnitY(u),GetUnitX(IH7)-GetUnitX(u))
    call SetUnitX(u,CoordinateX50(GetUnitX(IH7)+80*CosBJ(fx)))
    call SetUnitY(u,CoordinateY50(GetUnitY(IH7)+80*SinBJ(fx)))
    call SetUnitFacing(u,fx+180)
    call SetUnitTimeScale(u,.55)
    set g=WS7()
    call GroupAddUnit(g,IH7)
    set IQ4=g
    set IN4=u
    set ZZ4=IH7
    call ForGroup(yw,function r14)
    call Play_JH_Sound(u)
    call YS7("tx\\jianhao\\jianhao_blade.mdx",u,"weapon",1)
    set t=CreateTrigger()
    set h=GetHandleId(t)
    call TriggerAddAction(t,function rM4)
    call TriggerRegisterTimerEvent(t,.03,true)
    call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
    call SaveUnitHandle(L7,(h),(-$3CFCF864),(IH7))
    call SaveInteger(L7,(h),($434FA58A),(0))
call SaveReal(L7,h,'84ER',15.)
    call SaveReal(L7,(h),(-$41027418),((0.)))
    call SaveGroupHandle(L7,(h),($214C62CC),(g))
    call SaveReal(L7,(h),($12315AF9),((GetUnitX(IH7))*1.))
    call SaveReal(L7,(h),(-$91F1147),((GetUnitY(IH7))*1.))
    call SaveReal(L7,(h),(-$3F5412B6),((YM7)*1.))
    call PauseUnitEx(u,true)
    call SetUnitAnimation(u,"spell throw")
    call SetUnitInvulnerable(u,true)
endif
set t=null
set u=null
set IH7=null
set g=null
set b1060GetTriggerEventId=null
endfunction
