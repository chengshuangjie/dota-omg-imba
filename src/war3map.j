function KKTianxingBlessing_LoadAll takes nothing returns nothing
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local integer i=0
local player p=null
loop
exitwhen i>$B
set p=Player(i)
set KKTianxingBlessingLoaded[i]=false
set KKTianxingBlessingOwned[i]=false
set KKTianxingBlessingApplied[i]=false
if KKServerScore_InitialHuman[i] and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER then
if DzAPI_Map_GetServerValueErrorCode(p)==0 then
set KKTianxingBlessingLoaded[i]=true
set KKTianxingBlessingOwned[i]=false // twin-blessing persistence disabled under XOMG1
endif
endif
set i=i+1
endloop
// Server storage is ready at this one-second initialization boundary, after
// starting gold and the Dalaran castle have already been created.  Apply the
// blessing immediately so players can use its 200 gold during hero selection;
// the later N54 calls remain idempotent fallbacks for unusual platform timing.
call KKTianxingBlessing_ApplyRewards()
call OZ7(b1060GetTriggeringTrigger)
set p=null
set b1060GetTriggeringTrigger=null
endfunction
