local integer ioTetherNativeSkill=GetSpellAbilityId()
local eventid ioTetherEvent=GetTriggerEventId()
if SUIJI_LOG and (ioTetherLogicalSkill=='A1TA' or ioTetherNativeSkill=='A1TU') then
if ioTetherEvent==EVENT_PLAYER_UNIT_SPELL_CAST then
call SuijiTest_DebugAll("TETHER-CAST-EVENT","phase=CAST caster="+GetUnitName(ioTetherCaster)+"#"+I2S(GetHandleId(ioTetherCaster))+" target="+I2S(GetHandleId(ioTetherTarget))+" logical="+I2S(ioTetherLogicalSkill)+" native="+I2S(ioTetherNativeSkill))
else
call SuijiTest_DebugAll("TETHER-CAST-EVENT","phase=EFFECT caster="+GetUnitName(ioTetherCaster)+"#"+I2S(GetHandleId(ioTetherCaster))+" target="+I2S(GetHandleId(ioTetherTarget))+" logical="+I2S(ioTetherLogicalSkill)+" native="+I2S(ioTetherNativeSkill))
endif
call SuijiMode_TetherDebugState(ioTetherCaster,"TETHER-EVENT-STATE",LoadTriggerHandle(L7,GetHandleId(ioTetherCaster),StringHash("SuijiTetherController")))
endif
if ioTetherLogicalSkill=='A1TA' then
if IoTether_CanTarget(ioTetherCaster,ioTetherTarget)==false then
call KR7(ioTetherCaster)
elseif ioTetherEvent==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call TTG()
endif
endif
set ioTetherCaster=null
set ioTetherTarget=null
set ioTetherEvent=null
return false
endfunction
