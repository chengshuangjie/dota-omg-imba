function O6E takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local unit WI7=O77(GetHandleId(GetTriggeringTrigger()),"Hero")
local real YM7=.2*GetEventDamage()
set YM7=YJ7(YM7,GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE))
if GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)>1 and (b1060GetEnumUnit)!=GetTriggerUnit() and GetUnitAbilityLevel((b1060GetEnumUnit),'B048')>0 then
if GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)<YM7 then
call B67(WI7,(b1060GetEnumUnit),3,YM7)
else
call ZA7(WI7,(b1060GetEnumUnit),YM7)
endif
endif
set WI7=null
set b1060GetEnumUnit=null
endfunction
function OLE takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group LQ7=OF7(OB7,"Group")
local real time=ON7(OB7,"TIME")
if GetTriggerEventId()==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(GetTriggerUnit(),'B048')>0 then
	if GetEventDamage()>$A and GetEventDamage()<9000 then
		call DisableTrigger(t)
		call ForGroup(LQ7,function O6E)
		call EnableTrigger(t)
	endif
elseif GetGameTime()>time then
