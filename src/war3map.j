call SuijiMode_SyncNativeAghCompanion(u,'A3NE',GetUnitAbilityLevel(u,'A2NE')+GetUnitAbilityLevel(u,'A3NF'),true,true)
endif
endif
//火猫
if id=='N0M0' then
set DZ7[0]='A3JO'
set DZ7[1]='A3JQ'
set DZ7[2]='A3JP'
set DZ7[3]='A3JR'
set DZ7[4]='A3JS'
set DZ7[5]='A3JT'
call UnitMakeAbilityPermanent(u,true,'A2YY')
call HZYJ_SKILL(u,true)
endif
//DP
if id=='UC76' then
    call XF7(u,'A4L7')
endif
//土猫
if id=='N0MU' or id=='N0MV' then
call SuijiMode_SyncNativeAghCompanion(u,'A2VM',1,true,true)
call UnitMakeAbilityPermanent(u,true,'A2Z4')
endif
if id=='H00V' or id=='H08D' or id=='H08C' or id=='H084' or id=='H08B' then
call UnitMakeAbilityPermanent(u,true,'A2ZE')
endif
//黑鸟
if id=='U00P' or id=='Z00P' then
call XF7(u,'A4A4')
call SetPlayerAbilityAvailable(p,'A4A4',false)
endif
if id=='Hblm' or id=='H06X' or id=='H06Y' or id=='H06W' or id=='H0BC' then
call UnitMakeAbilityPermanent(u,true,'A4AT')
endif
//幽鬼
if id=='E01B' or id=='Z01B' or id=='Z11B' or id=='Z21B' or id=='Z31B' then
call SuijiMode_SyncNativeAghCompanion(u,'A4B6',1,true,true)
endif
//炼金
if PDLJ(u) then
call CT7(p)
endif
//猛犸
if id=='UC11' or id=='ZC11' or id=='ZC12' then
call B287_MHAbility_SetCastpoint(u,'A3RD',.15)
call XF7(u,'A4FL')
call SetPlayerAbilityAvailable(p,'A4FL',false)
call UnitMakeAbilityPermanent(u,true,'A4FK')
endif
//火枪
if id=='Usyl' then
call B287_MHAbility_SetCastpoint(u,'A1AU',.3)
endif
//猴子
if id=='Ogrh' then
call SuijiMode_SyncNativeAghCompanion(u,'A0D7',1,true,true)
endif
//潮汐
if id=='Ofar' then
call XF7(u,'A4GC')
call SetPlayerAbilityAvailable(p,'A4GC',false)
endif
//海民
if id=='E02I' then
    call SuijiMode_SyncNativeAghCompanion(u,'A4HI',1,true,true)
endif
//神牛
if id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch' then
    call SuijiMode_SyncNativeAghCompanion(u,'A4LZ',B287_GetUnitAbilityLevel(u,'A0DL'),true,true)
	call B1000TotemLeapCastpoint(u)
endif
//亚巴顿
if id=='Udea' then
    call SuijiMode_SyncNativeAghCompanion(u,'A4LQ',1,true,true)
endif
//大树
if id=='Hamg' then
    call SuijiMode_SyncNativeAghCompanion(u,'A1G7',1,true,true)
endif
//巨魔
if id=='N016' or id=='N017' or id=='N200' or id=='N201' or id=='N02B' then
	call MHUnit_SetAttackSpeedLimit(u,8)
endif
//圣堂
if id=='E01Y' or id=='Z01Y' then
    call SuijiMode_SyncNativeAghCompanion(u,'A4KJ',1,true,true)
endif
//大牛
if id=='O015' then
    call SuijiMode_SyncNativeAghCompanion(u,'A4KK',1,true,true)
    call SuijiMode_SetExactLiveAbilityCastpoint(u,'A4KK',.7)
endif
if id=='Eevi' or id=='Eevm' or id=='E02V' or id=='E02W' or id=='E02U' then
    call UnitMakeAbilityPermanent(u,true,'A4HX')
endif
//SVEN
if id=='H001' or id=='H0CQ' or id=='Z001' or id=='Z0CQ' then
call SuijiMode_SyncNativeAghCompanion(u,'A4IL',B287_GetUnitAbilityLevel(u,'A190'),true,true)
endif
//水人
if id=='O00P' then
    set m5=LoadUnitHandle(L7,(GetHandleId(u)),($E5))
    if m5!=null and UnitAlive(m5) then
        call B287_SetPlayerAbilityAvailable(p,'A0G8',false)
        call XF7(u,'A0GC')
        call SetPlayerAbilityAvailable(p,'A0GC',true)
    else
        call UnitRemoveAbility(u,'A0GC')
        call XF7(u,'A0G8')
        call B287_SetPlayerAbilityAvailable(p,'A0G8',true)
    endif
    set m5=null
endif
call SuijiMode_ReconcileNativeAghCompanions(u,null)
endfunction
function CHIA_SKILL takes unit playeru4,player p4 returns nothing
local integer A1E
local integer playeru4id=GetUnitTypeId(playeru4)
set A1E=F29(playeru4)
if A1E!=0 then
call UnitAddAbility(playeru4,A1E)
call UnitMakeAbilityPermanent(playeru4,true,A1E)
call SetPlayerAbilityAvailable(p4,A1E,false)
if playeru4id=='H00U' then
set IN4=playeru4
call ExecuteFunc("A0E")
elseif playeru4id=='Hmkg' then
set IN4=playeru4
call ExecuteFunc("E3D")
endif
endif
if playeru4id=='Emoo' then
call SetPlayerTechResearched(p4,'R00J',1)
elseif playeru4id=='H00I' then
set IN4=playeru4
if D4 then
call ExecuteFunc("XSD2")
else
call ExecuteFunc("XSD")
endif
elseif playeru4id=='Ucrl' then
call UnitAddAbility(playeru4,'A2KB')
call UnitRemoveAbility(playeru4,'A2KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zcrl' then
call UnitAddAbility(playeru4,'X2KB')
call UnitRemoveAbility(playeru4,'X2KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zdrl' then
call UnitAddAbility(playeru4,'X3KB')
call UnitRemoveAbility(playeru4,'X3KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
elseif playeru4id=='Zerl' then
call UnitAddAbility(playeru4,'X4KB')
call UnitRemoveAbility(playeru4,'X4KB')
call AddUnitAnimationProperties(playeru4,"upgrade",true)
call SetPlayerTechResearched(p4,'R00K',1)
endif
call CHIA_SKILL_OTHERS(playeru4,p4,playeru4id,true)
call NagaSirenAghMirror_Update(playeru4)
call NagaSirenRipTide_Update(playeru4)
endfunction
