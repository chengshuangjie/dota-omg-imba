call SaveInteger(L7,I97,0,B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A06W'))
call SaveReal(L7,I97,$A,b1060GetSpellTargetX)
call SaveReal(L7,I97,$B,b1060GetSpellTargetY)
set t=null
set b1060GetTriggerUnit=null
endfunction
