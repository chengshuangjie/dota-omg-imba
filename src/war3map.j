function GetGameTime takes nothing returns real
	return TimerGetElapsed(W)
endfunction
function ISDODGE takes unit u returns boolean
return GetGameTime()-LoadReal(L7,GetHandleId((u)),'TIAO')<0
endfunction
function Get_MNCF_Unit takes unit IH7 returns unit
    if HaveSavedHandle(TABLE_HY,'CFMJ', GetHandleId(IH7)) and UnitAlive(LoadUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))) then
        return LoadUnitHandle(TABLE_HY,'CFMJ', GetHandleId(IH7))
    endif
        return IH7
endfunction
function RegisterUnitAttackEvent takes string s, integer level returns nothing
	local integer i = 0
	local integer b1062Gate = 0
	loop
	exitwhen HaveSavedString(TABLE_Q,'DMGE'+ level, i)== false
		if LoadStr(TABLE_Q,'DMGE'+ level, i)== s then
			return
		endif
		set i = i + 1
	endloop
	call SaveStr(TABLE_Q,'DMGE'+ level, i, s)
	// Classify once at registration; preserve the original list and its order.
	if s=="B1019EquipmentAttack" then
		set b1062Gate=1
	elseif s=="B964WSZR" then
		set b1062Gate=2
	elseif s=="OGO" then
		set b1062Gate=3
	elseif s=="SuijiMode_IllusionPassiveAttackFallback" then
		set b1062Gate=4
	elseif s=="BEARFSJ" then
		set b1062Gate=5
	elseif s=="FSJ" then
		set b1062Gate=6
	endif
	if b1062Gate!=0 then
		call SaveInteger(TABLE_Q,'DGGT'+level,i,b1062Gate)
	endif
endfunction
// Necessary conditions only. Read current state at this consumer's position:
// earlier consumers may change abilities, buffs or the nested damage context.
// Do not roll PRD, advance cooldowns, or cache unit eligibility here.
function B1062AttackGateAllows takes integer b1062Gate returns boolean
	if b1062Gate==1 then
		return GetUnitAbilityLevel(WXX,'A4O1')>0 or GetUnitAbilityLevel(WXX,'A4O2')>0
	elseif b1062Gate==2 then
		return GetUnitAbilityLevel(WXX,'A7B1')>0 or GetUnitAbilityLevel(WXX,'A7B2')>0
	elseif b1062Gate==3 then
		return GetUnitAbilityLevel(WXX,'B3B5')>0
	elseif b1062Gate==4 then
		return WXX!=null and GetUnitTypeId(WXX)!=0 and IsUnitIllusion(WXX)
	elseif b1062Gate==5 then
		return LoadBoolean(TABLE_HY,EOO,11) and GetUnitAbilityLevel(WXX,'A0AH')>0
	elseif b1062Gate==6 then
		return LoadBoolean(TABLE_HY,EOO,11) and GetUnitAbilityLevel(WXX,'A4C8')>0
	endif
	return true
endfunction
function ExecuteAttackEvent takes integer i returns nothing
	local integer k = 0
	local integer b1062Gate = 0
	loop
	exitwhen HaveSavedString(TABLE_Q,'DMGE'+ i, k)== false
		if i==0 or i==1 then
			set b1062Gate=LoadInteger(TABLE_Q,'DGGT'+i,k)
		endif
		if b1062Gate==0 or B1062AttackGateAllows(b1062Gate) then
			call ExecuteFunc(LoadStr(TABLE_Q,'DMGE'+ i, k))
		endif
		set k = k + 1
	endloop
endfunction
