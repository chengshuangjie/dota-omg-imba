function FKSZ_Damage2 takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 0)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 1)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real DUR=LoadReal(ExtraHT, OB7, 1)
    local real YM7=LoadReal(ExtraHT, OB7, 10)
    if n>=DUR*10 or (n>1 and GetUnitAbilityLevel(IH7,'B0ER')==0) or GetTriggerEventId()==EVENT_UNIT_DEATH then
        call RemoveSavedHandle( ExtraHT, 'fksz', GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set IH7=null
        return false
    elseif ModuloReal(n,10.)==0 then
        call B67(ZX7,IH7,1,YM7)
    endif
    call SaveReal(ExtraHT, OB7, 0, n+1)
    set t=null
    set ZX7=null
    set IH7=null
    return false
endfunction
function FKSZ_Damage takes unit ZX7,unit IH7,integer level returns nothing
    local trigger t
    local integer OB7
    local real DUR=2.+level
    local real YM7=100.
    if HaveSavedHandle(ExtraHT, 'fksz', GetHandleId(IH7)) then
	    set t=LoadTriggerHandle(ExtraHT, 'fksz', GetHandleId(IH7))
		set OB7=GetHandleId(t)
        call SaveReal(ExtraHT, OB7, 0, 0)
    else
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveUnitHandle(ExtraHT, OB7, 1, IH7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        call SaveTriggerHandle(ExtraHT, 'fksz', GetHandleId(IH7), t)
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function FKSZ_Damage2))
    endif
    set t=null
endfunction
function FKSZ_PD takes nothing returns boolean
if (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsHideUnit(GetFilterUnit())==false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and UnitAlive(GetFilterUnit()))!=null then
	call GroupAddUnit(FKSZGROUP,GetFilterUnit())
endif
return false
endfunction
function CLZY_PD takes nothing returns boolean
return UnitAlive(GetFilterUnit()) and GetUnitTypeId(GetFilterUnit())=='h0BT'
endfunction
function CLZY_ADD_UNIT takes nothing returns boolean
	local unit u=GetEnumUnit()
	local group g=WS7()
	set IN4=u
	call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),800,Condition(function FKSZ_PD))
	call WR7(g)
	set u=null
	set g=null
return false
endfunction
function FKSZ_TRI takes nothing returns boolean
	local unit u=GetEnumUnit()
local unit oA=CreateUnit(GetOwningPlayer(IN4),'e022',GetUnitX(u),GetUnitY(u),0)
call XF7(oA,'A06T')
call SetUnitAbilityLevel(oA,'A06T',AL4)
	call B947IssueTargetOrderById("FKSZ_TRI @ war3map.j:81800 (B968)",oA,$D008A,u)
	call FKSZ_Damage(IN4,u,AL4)
	if HaveDashuA then
		call DisarmUnitToTimed(u , 'A4LR' , 0 , 0 , 2+AL4)
	endif
	set u=null
	set oA=null
return false
endfunction
function F2D takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local group g=WS7()
local group g2=WS7()
local integer level=B287_GetUnitAbilityLevel(ZX7,'A07Z')
set HaveDashuA=false
if SuijiMode_ScepterRegistryIsActive(ZX7,'A07Z') then
	set HaveDashuA=true
endif
set FKSZGROUP=g2
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),800,Condition(function FKSZ_PD))
call GroupClear(g)
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(ZX7),Condition(function CLZY_PD))
if CountUnitsInGroup(g)>0 then
	set FKSZGROUP=g2
	call ForGroup(g,function CLZY_ADD_UNIT)
endif
set IN4=ZX7
set AL4=level
call ForGroup(g2,function FKSZ_TRI)
call WR7(g)
call WR7(g2)
set ZX7=null
set g=null
set g2=null
endfunction
function F5D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A07Z' then
	call F2D()
endif
return false
endfunction
