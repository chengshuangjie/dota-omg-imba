function FKE takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer V77=OM7(OB7,"Level")
local integer id=OM7(OB7,"id")
local real YM7=(30+30*V77)+(.1*(V77+2))*GetHeroStr(p5,true)
local integer U38=OM7(OB7,"Count")
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or UnitAlive(p5)==false or UnitAlive(m5)==false then
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST then
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and b1060B287_GetSpellAbilityId=='A0FL') or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and b1060B287_GetSpellAbilityId=='A1CX') or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and b1060B287_GetSpellAbilityId=='X1CX') then
call NM7(OB7)
call OZ7(t)
endif
elseif(GetTriggerEvalCount(t)>4 and IsUnitType(m5,UNIT_TYPE_HERO))or(GetTriggerEvalCount(t)>6 and IsUnitType(m5,UNIT_TYPE_HERO)==false)then
call NM7(OB7)
call OZ7(t)
call KR7(p5)
else
if V77>0 then
set U38=U38+1
if(U38<5 and IsUnitType(m5,UNIT_TYPE_HERO))or(U38<7 and IsUnitType(m5,UNIT_TYPE_HERO)==false)then
if id=='Z00F' then
call YS7("model\\hero_butcher_n9s_d_object.mdl",m5,"origin",1)
call YS7("model\\hero_butcher_n9s_d_target_pulse.mdl",m5,"origin",1)
endif
call SetUnitState(p5,UNIT_STATE_LIFE,GetUnitState(p5,UNIT_STATE_LIFE)+YM7)
call B67(p5,m5,1,YM7)
if U38==1 then
    call LINGXIA(p5,m5)
endif
endif
call NP7(OB7,"Count",U38)
endif
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function FME takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=B287_GetUnitAbilityLevel(p5,'A1CX')+GetUnitAbilityLevel(p5,'X1CX')
local integer id=GetUnitTypeId(p5)
if B287_GetSpellAbilityId()=='A0FL' then
set V77=B287_GetUnitAbilityLevel(p5,'A0FL')
endif
if SPEPLAYER[GetPlayerId(GetOwningPlayer(p5))]==1 and ISLABIKE(p5) then
    call YW7("我才是袁加凯！",5,p5,.03,$FF,$FF,0,$FF)
endif
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function FKE))
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NP7(OB7,"Level",V77)
call NP7(OB7,"id",id)
call NP7(OB7,"Count",0)
call TriggerEvaluate(t)
set t=null
set p5=null
set m5=null
endfunction
