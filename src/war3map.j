    call RegisterHeroSkill(i,'A4ID','A4IE','A4II','A4IK',0,0,0,0,0,0)
    set i=115
    call RegisterHeroSkill(i,'A4IU','A4IS','A4IT','A4IX',0,0,0,0,0,0)
    call RegisterHeroSkill(117,'AMdQ','AMdW','AMdE','AMdR','AMdD','AMdT','AMdF',0,0,0)
endfunction
function OmgSkipLoadPressAnyKey takes nothing returns nothing
local timer t=GetExpiredTimer()
if GetLocalPlayer()!=null then
call ForceUICancel()
endif
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function AeonDisk_HasItem takes unit u returns boolean
local integer slot=0
local item it=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
loop
exitwhen slot>5
set it=UnitItemInSlot(u,slot)
if it!=null and GetItemTypeId(it)=='I0TN' then
set it=null
return true
endif
set slot=slot+1
endloop
set it=null
return false
endfunction
function AeonDisk_IsActive takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return LoadBoolean(L7,GetHandleId(u),StringHash("AeonDiskActive"))
endfunction
function AeonDisk_DebugPrint takes string tag,string message returns nothing
if SUIJI_LOG==false or AeonDiskLogCount>=80 then
return
endif
set AeonDiskLogCount=AeonDiskLogCount+1
call VV7(bj_FORCE_ALL_PLAYERS,12.,"|cFFFFCC00永恒之盘日志["+tag+"]：|r"+message)
endfunction
function AeonDisk_ActiveFinish takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
local integer serial=LoadInteger(L7,I97,1)
local integer unitId=0
local effect shield=null
local effect burst=null
if u!=null then
set unitId=GetHandleId(u)
if LoadInteger(L7,unitId,StringHash("AeonDiskSerial"))==serial then
set shield=LoadEffectHandle(L7,unitId,StringHash("AeonDiskShield"))
set burst=LoadEffectHandle(L7,unitId,StringHash("AeonDiskBurst"))
call SaveBoolean(L7,unitId,StringHash("AeonDiskActive"),false)
call RemoveSavedHandle(L7,unitId,StringHash("AeonDiskShield"))
call RemoveSavedHandle(L7,unitId,StringHash("AeonDiskBurst"))
if shield!=null then
call DestroyEffect(shield)
endif
if burst!=null then
call DestroyEffect(burst)
endif
if GetUnitTypeId(u)!=0 then
call AeonDisk_DebugPrint("STATE","active-ended target="+GetUnitName(u)+"#"+I2S(unitId)+" life="+R2S(GetUnitState(u,UNIT_STATE_LIFE))+"/"+R2S(GetUnitState(u,UNIT_STATE_MAX_LIFE)))
endif
endif
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set shield=null
set burst=null
set u=null
set t=null
endfunction
function AeonDisk_Activate takes unit u returns nothing
local integer unitId=0
local integer serial=0
local effect shield=null
local effect burst=null
local timer t=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set unitId=GetHandleId(u)
set serial=LoadInteger(L7,unitId,StringHash("AeonDiskSerial"))+1
set shield=AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl",u,"origin")
set burst=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",u,"origin")
call SaveInteger(L7,unitId,StringHash("AeonDiskSerial"),serial)
call SaveBoolean(L7,unitId,StringHash("AeonDiskActive"),true)
call SaveEffectHandle(L7,unitId,StringHash("AeonDiskShield"),shield)
call SaveEffectHandle(L7,unitId,StringHash("AeonDiskBurst"),burst)
call UnitRemoveBuffs(u,false,true)
call YW8(u,0,0)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
// IMBA: aeon disk invuln window x2 cap 10s.
if XOMG_IMBA_ENABLED then
call TimerStart(t,RMinBJ(2.5*IMBA_POWER,10.),false,function AeonDisk_ActiveFinish)
else
call TimerStart(t,2.5,false,function AeonDisk_ActiveFinish)
endif
set shield=null
set burst=null
set t=null
endfunction
function AeonDisk_CooldownOverlayTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,2)
local real cooldown=LoadReal(L7,I97,4)
if u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,'A5VR')>0 and cooldown>.01 then
call YDWESetUnitAbilityState(u,'A5VR',1,cooldown)
call MHAbility_SetCooldownEx(u,'A5VR',cooldown,cooldown)
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function AeonDisk_StartCooldownOverlay takes unit u,real cooldown returns nothing
local timer t=null
local integer I97=0
if u==null or GetUnitTypeId(u)==0 or GetUnitAbilityLevel(u,'A5VR')<=0 or cooldown<=.01 then
return
endif
set t=CreateTimer()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,2,u)
call SaveReal(L7,I97,4,cooldown)
call TimerStart(t,0.,false,function AeonDisk_CooldownOverlayTick)
set t=null
endfunction
function AeonDisk_DebugStatus takes nothing returns nothing
set AeonDiskLogCount=0
call AeonDisk_DebugPrint("STATUS","jassReady=true item=I0TN active=2.500 baseCooldown=45.000 limit=80")
endfunction
function AeonDisk_OnDamaging takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local unit source=MHDamagingEvent_GetSource()
local real damage=MHDamagingEvent_GetDamage()
local real life=0.
local real maxLife=0.
local real projected=0.
local real threshold=0.
local real cooldown=45.
local real factor=-1.
local real readyAt=0.
local real remaining=-1.
local real shortest=0.
local integer slot=0
local integer itemHandle=0
local item it=null
local item readyItem=null
local boolean active=false
local boolean result=false
local boolean shouldLog=false
local string sourceName="invalid"
local string reason="evaluating"
set shouldLog=SUIJI_LOG and (AeonDisk_HasItem(target) or AeonDisk_HasItem(source))
if AeonDisk_IsActive(source) then
set active=true
set result=true
set reason="active-source-zero"
elseif AeonDisk_IsActive(target) then
set active=true
set result=true
set reason="active-target-zero"
elseif damage<=0. then
set reason="non-positive-damage"
elseif target==null or GetUnitTypeId(target)==0 then
set reason="invalid-target"
elseif source==null or GetUnitTypeId(source)==0 then
set reason="invalid-source"
elseif not IsUnitType(target,UNIT_TYPE_HERO) then
set reason="target-not-hero"
elseif not IsUnitType(source,UNIT_TYPE_HERO) then
set reason="source-not-hero"
else
set life=GetUnitState(target,UNIT_STATE_LIFE)
set maxLife=GetUnitState(target,UNIT_STATE_MAX_LIFE)
set projected=life-damage
set threshold=maxLife*.70
if maxLife<=0. or projected>threshold then
set reason="above-threshold"
else
loop
exitwhen slot>5 or readyItem!=null
set it=UnitItemInSlot(target,slot)
if it!=null and GetItemTypeId(it)=='I0TN' then
set readyAt=LoadReal(L7,GetHandleId(it),StringHash("AeonDiskReadyAt"))
if readyAt<=Bz then
set readyItem=it
set itemHandle=GetHandleId(it)
set remaining=0.
elseif itemHandle==0 or readyAt-Bz<shortest then
set itemHandle=GetHandleId(it)
set shortest=readyAt-Bz
set remaining=shortest
endif
endif
set slot=slot+1
endloop
if readyItem==null then
if itemHandle==0 then
set reason="no-item-I0TN"
else
set reason="item-cooldown"
endif
else
set factor=ReduceUnitAbilityCoolDownReal(target)
if factor>0. then
set cooldown=45.*factor
endif
if cooldown<=0. or cooldown>45. then
set cooldown=45.
endif
call SaveReal(L7,itemHandle,StringHash("AeonDiskReadyAt"),Bz+cooldown)
call AeonDisk_Activate(target)
call AeonDisk_StartCooldownOverlay(target,cooldown)
set active=true
set result=true
set reason="triggered"
endif
endif
endif
if result then
call MHDamagingEvent_SetDamage(0.)
endif
if shouldLog then
if source!=null and GetUnitTypeId(source)!=0 then
set sourceName=GetUnitName(source)+"#"+I2S(GetHandleId(source))
endif
if target!=null and GetUnitTypeId(target)!=0 then
call AeonDisk_DebugPrint("DAMAGE","target="+GetUnitName(target)+"#"+I2S(GetHandleId(target))+" source="+sourceName+" damage="+R2S(damage)+" life="+R2S(life)+"/"+R2S(maxLife)+" projected="+R2S(projected)+" threshold="+R2S(threshold)+" result="+SuijiMode_DebugBoolText(result)+" reason="+reason+" item="+I2S(itemHandle)+" cooldown="+R2S(remaining)+" duration="+R2S(cooldown)+" active="+SuijiMode_DebugBoolText(active))
endif
endif
set target=null
set source=null
set it=null
set readyItem=null
return false
endfunction
function AeonDisk_Init takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerAddCondition(t,Condition(function AeonDisk_OnDamaging))
call MHDamagingEvent_Register(t)
set t=null
endfunction
