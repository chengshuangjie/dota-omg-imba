function XLE takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local player pl
if StringCase(VH,false)=="-re" or StringCase(VH,false)=="-airepick" then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"请输入AI楼层，例如 |c00dd8dff-re2|r（1-5楼为达拉然，6-10楼为黑暗势力）；每个楼层每局只能重选一次。")
set pl=null
set b1060GetTriggerPlayer=null
return
endif
if StringCase(SubString(VH,0,3),false)=="-re" then
set pl=K27(S2I(SubString(VH,3,StringLength(VH))))
else
set pl=K27(S2I(SubString(VH,9,StringLength(VH))))
endif
if((pl!=null)and(TA7(pl))and(IsPlayerInForce(pl,QX4)))then
if((IsPlayerAlly(b1060GetTriggerPlayer,pl))or(NJ7(not IsPlayerAlly(b1060GetTriggerPlayer,Z7[0]))==null))then
if(M7[GetPlayerId(pl)]==null)then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"不能重选")
elseif B983RepickUsed[GetPlayerId(pl)] then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"该楼层本局已重选过英雄，每个楼层只允许重选一次。")
elseif(SuijiSuperAI_HasPreset(GetPlayerId(pl)))then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"本楼层出现超级AI，禁止重选")
elseif(Bz>AI_RE_TIME)then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"太迟了不能重选")
else
set B983RepickUsed[GetPlayerId(pl)]=true
call X3E(pl,false)
if M7[GetPlayerId(pl)]==null then
set B983RepickUsed[GetPlayerId(pl)]=false
else
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"该楼层已完成重选，本局不能再次重选。")
endif
endif
else
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"不能让有人类队友的敌人重选")
endif
endif
set pl=null
set b1060GetTriggerPlayer=null
endfunction
