endfunction
function JDISPLAY takes nothing returns nothing
	local player p = GetTriggerPlayer()
	local integer OB7 = GetHandleId(p)
	local boolean b = LoadBoolean(TABLE_P, OB7,'A0RO')
    set b=not b
    call SaveBoolean(TABLE_P, OB7,'A0RO', b)
    if b then
        call DisplayTextToPlayer(p, 0, 0, "灵能之刃作用范围显示|c00FF0000已关闭|r")
    else
        call DisplayTextToPlayer(p, 0, 0, "灵能之刃作用范围显示|cFF00FF00已开启|r")
    endif
endfunction
//预载英雄
function PRESKILL_TRI takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer n=GetTriggerEvalCount(t)
//暗牧
if n==1 then
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|cFF00FF00预载部分英雄技能，减少后续卡顿|r")
if LOADSKILL[90]==0 then
call ExecuteFunc("KE8")
call ExecuteFunc("KF8")
call ExecuteFunc("KG8")
call ExecuteFunc("KH8")
call RegisterUnitAttackEvent("ZCJDZC", 1)
set LOADSKILL[90]=1
endif
endif
//小黑
if n==3 then
if LOADSKILL[35]==0 then
call ExecuteFunc("Q51")
call ExecuteFunc("PP8")
call ExecuteFunc("PQ8")
set LOADSKILL[35]=1
endif
endif
//卡尔
if n==5 then
if LOADSKILL[94]==0 then
call ExecuteFunc("MP8")
call ExecuteFunc("ZCEnableThreeSkill")
set LOADSKILL[94]=1
endif
endif
//大牛
if n==7 then
if LOADSKILL[15]==0 then
call ExecuteFunc("NK8")
call ExecuteFunc("NM8")
call ExecuteFunc("NN8")
call ExecuteFunc("NO8")
set LOADSKILL[15]=1
endif
endif
//巨魔
if n==8 then
if LOADSKILL[27]==0 then
call ExecuteFunc("GC8")
call ExecuteFunc("G38")
call RegisterUnitAttackEvent("G68", -2)
call ExecuteFunc("GL8")
call ExecuteFunc("G18")
set LOADSKILL[27]=1
endif
call OZ7(t)
endif
set t=null
return false
endfunction
function PRESKILL takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function PRESKILL_TRI))
set t=null
endfunction
//修复地卜师
function JFIXDBS takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit u
local group g
local integer i
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"|cFF00FF00修复地卜师占用头像问题|r")
set g=GetUnitsOfPlayerAndTypeId(b1060GetTriggerPlayer,'H00I')
set u=FirstOfGroup(g)
call RemoveUnit(u)
call DestroyGroup(g)
set g=GetUnitsOfPlayerAndTypeId(b1060GetTriggerPlayer,'H00J')
set i=CountUnitsInGroup(g)
if i>0 then
loop
exitwhen i==0
set u=FirstOfGroup(g)
call GroupRemoveUnit(g,u)
call RemoveUnit(u)
set i=i-1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
set b1060GetTriggerPlayer=null
endfunction
function JFIXDG takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit u
local group g
local integer i
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"|cFF00FF00修复电狗分身占用头像问题|r")
set g=GetUnitsOfPlayerAll(b1060GetTriggerPlayer)
set i=CountUnitsInGroup(g)
if i>0 then
loop
exitwhen i==0
set u=FirstOfGroup(g)
call GroupRemoveUnit(g,u)
if DGFS(u) then
call RemoveUnit(u)
endif
set i=i-1
endloop
endif
call DestroyGroup(g)
set u=null
set g=null
set b1060GetTriggerPlayer=null
endfunction
function JSV takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit u
local integer ia
local integer i=S2I(SubString(GetEventPlayerChatString(),3,6))
if i > 0 and i < 11 then
if i > 5 then
set i=i+1
endif
set u=M7[i]
if u!=null then
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, Q[i]+GetUnitName(u)+"("+I2S(GetUnitLevel(u))+"级)|r"+" 技能加点：")
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00"+GetAbilityName(eY[336+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[336+i]))+"|r]")
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00"+GetAbilityName(eY[352+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[352+i]))+"|r]")
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00"+GetAbilityName(eY[368+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[368+i]))+"|r]")
if GetUnitAbilityLevel(u,eY[$BC+i]) > 0 then
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00"+GetAbilityName(eY[$BC+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[$BC+i]))+"|r]")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00"+GetAbilityName(eY[$AC+i])+"|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,eY[$AC+i]))+"|r]")
endif
set ia='Aamk'
if GetUnitTypeId(u)=='Nfir' or GetUnitTypeId(u)=='O00P' or GetUnitTypeId(u)=='N01O' or GetUnitTypeId(u)=='N013' or GetUnitTypeId(u)=='N014' or GetUnitTypeId(u)=='N015' or GetUnitTypeId(u)=='Hblm' or GetUnitTypeId(u)=='E02X' or GetUnitTypeId(u)=='UC42' or GetUnitTypeId(u)=='H00K' or GetUnitTypeId(u)=='UC60' or GetUnitTypeId(u)=='H00R' or GetUnitTypeId(u)=='H06W' or GetUnitTypeId(u)=='H06X' or GetUnitTypeId(u)=='H06Y' or GetUnitTypeId(u)=='H07I' or GetUnitTypeId(u)=='O016' or GetUnitTypeId(u)=='O017' or GetUnitTypeId(u)=='H0BC' or GetUnitTypeId(u)=='E02F' or GetUnitTypeId(u)=='O01F' or GetUnitTypeId(u)=='N0MU' or GetUnitTypeId(u)=='N0MV' or GetUnitTypeId(u)=='E01B' then
set ia='A0NR'
endif
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0, "        - |c0000cc00属性附加|r [|c00ffff00等级 "+I2S(GetUnitAbilityLevel(u,ia))+"|r]")
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0,0,"[数据仅供参考]")
endif
else
call DisplayTextToPlayer(b1060GetTriggerPlayer, 0, 0,"查看指定楼层技能加点：|cFF00FF00-sv 1~10|r")
endif
set u=null
set b1060GetTriggerPlayer=null
endfunction
function JCAM takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
	local real r = S2R(SubString(GetEventPlayerChatString(), 5, 15))
	call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_FARZ,$5F5E100, 0)
	if r <= 0 then
        set r=$672
		call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_TARGET_DISTANCE,r, 0)
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,0)
		call X37(b1060GetTriggerPlayer,"镜头已调整至默认值")
	elseif r == 1 then
        set r=2000
		call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,r)
        call DisplayTextToPlayer(b1060GetTriggerPlayer, 0, 0,"|cFF00FF00已锁定镜头为2000，解锁镜头请输入-cam|r")
	elseif r == 2 then
        set r=2300
		call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,r)
        call DisplayTextToPlayer(b1060GetTriggerPlayer, 0, 0,"|cFF00FF00已锁定镜头为2300，解锁镜头请输入-cam|r")
	elseif r == 3 then
        set r=2600
		call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_TARGET_DISTANCE,r , 0)
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,r)
        call DisplayTextToPlayer(b1060GetTriggerPlayer, 0, 0,"|cFF00FF00已锁定镜头为2600，解锁镜头请输入-cam|r")
	elseif r >= 600 and r <= 4500 then
		call SetCameraFieldForPlayer(b1060GetTriggerPlayer, CAMERA_FIELD_TARGET_DISTANCE, r, 0)
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,r)
        call DisplayTextToPlayer(b1060GetTriggerPlayer, 0, 0,"|cFF00FF00已锁定镜头为"+I2S(R2I(r))+"，解锁镜头请输入-cam|r")
	else
        call SaveReal(TABLE_Z,GetHandleId(b1060GetTriggerPlayer),100,0)
		call X37(b1060GetTriggerPlayer,"参数不能低于600或高于4500")
	endif
set b1060GetTriggerPlayer=null
endfunction
function JSH takes nothing returns nothing
    local player p=GetTriggerPlayer()
    local unit u
    local integer i=1
    local integer n=1
    local real time
    local integer minute=GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)
    local integer seconds=GetPlayerState(p,PLAYER_STATE_RESOURCE_FOOD_USED)
    if X14 then
        set time=(TimerGetElapsed(W)-M_4+60)/60
    else
        set time=1.
        set minute=0
        set seconds=0
    endif
    call ZZ7(p)
    call DisplayTimedTextToPlayer(p,0,0,10,"------------游戏时间: "+I2S(minute)+"分"+I2S(seconds)+"秒"+"------------")
    loop
    exitwhen n>5
    set u=M7[i]
    if u!=null then
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
            call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // endif
    endif
    set i=i+1
    set n=n+1
    endloop
    call DisplayTimedTextToPlayer(p,0,0,10,"------------------------------------")
    set i=7
    set n=1
    loop
    exitwhen n>5
    set u=M7[i]
    if u!=null then
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
        // if TL4 and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER then
            // call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"("+GetUnitName(u)+")"+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // else
            call DisplayTimedTextToPlayer(p,0,0,10, Q[i]+GetPlayerName(Player(i))+"|r 伤害总计 "+I2S(PlayerDamage[i])+" ("+I2S(R2I(PlayerDamage[i]/time))+"/分)")
        // endif
    endif
    set i=i+1
    set n=n+1
    endloop
    call DisplayTimedTextToPlayer(p,0,0,10,"------------------------------------")
    call DisplayTimedTextToPlayer(p,0,0,10," ")
    set u=null
    set p=null
endfunction
function Z32 takes player p returns nothing
local integer Z42
local player p2
set Z42=0
loop
set p2=Player(Z42)
if(PlayersAreCoAllied(p,p2)and p!=p2)then
call SetPlayerAlliance(p,p2,ALLIANCE_SHARED_VISION,true)
call SetPlayerAlliance(p,p2,ALLIANCE_SHARED_CONTROL,true)
call SetPlayerAlliance(p2,p,ALLIANCE_SHARED_CONTROL,true)
endif
set Z42=Z42+1
exitwhen Z42==12
endloop
endfunction
function VoteKick_GetFloorPlayer takes integer floor returns player
if floor>=1 and floor<=5 then
return Z7[floor]
elseif floor>=6 and floor<=10 then
return A7[floor-5]
endif
return null
endfunction
function VoteKick_GetPlayerFloor takes player p returns integer
local integer i=1
loop
exitwhen i>5
if Z7[i]==p then
return i
elseif A7[i]==p then
return i+5
endif
set i=i+1
endloop
return 0
endfunction
function VoteKick_IsActiveHuman takes player p returns boolean
return p!=null and VoteKick_GetPlayerFloor(p)>0 and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER
endfunction
function VoteKick_CountActiveHumans takes nothing returns integer
local integer floor=1
local integer count=0
local player p=null
loop
exitwhen floor>10
set p=VoteKick_GetFloorPlayer(floor)
if VoteKick_IsActiveHuman(p) then
set count=count+1
endif
set floor=floor+1
endloop
set p=null
return count
endfunction
function VoteKick_ResetChoices takes nothing returns nothing
local integer i=0
loop
exitwhen i>$B
set VoteKick_Choice[i]=0
set i=i+1
endloop
endfunction
function VoteKick_ClearState takes nothing returns nothing
set VoteKick_Active=false
set VoteKick_TargetId=-1
set VoteKick_TargetFloor=0
set VoteKick_InitiatorId=-1
set VoteKick_RequiredYes=0
set VoteKick_YesCount=0
set VoteKick_NoCount=0
call VoteKick_ResetChoices()
endfunction
function VoteKick_OnTimeout takes nothing returns nothing
if VoteKick_Active then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00投票结束：同意票不足（"+I2S(VoteKick_YesCount)+"/"+I2S(VoteKick_RequiredYes)+"），未踢出第"+I2S(VoteKick_TargetFloor)+"楼玩家。|r")
call VoteKick_ClearState()
endif
endfunction
function VoteKick_KickTarget takes nothing returns nothing
local integer targetId=VoteKick_TargetId
local integer targetFloor=VoteKick_TargetFloor
local player target=Player(targetId)
local string timeText
if VoteKick_Active==false then
set target=null
return
endif
if VoteKick_IsActiveHuman(target)==false then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00第"+I2S(targetFloor)+"楼玩家已经离开，本次投票取消。|r")
call VoteKick_ClearState()
set target=null
return
endif
if C<$A then
set timeText=I2S(B)+":0"+I2S(C)
else
set timeText=I2S(B)+":"+I2S(C)
endif
set VoteKick_Active=false
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|c00ff0303投票通过：第"+I2S(targetFloor)+"楼 "+KZ4[targetId]+" 已被踢出游戏。|r")
set C9[targetId]="|c00555555"+timeText+"|r"
call RemovePlayer(target,PLAYER_GAME_RESULT_DEFEAT)
call Z32(target)
set U2[targetId]=true
call DG8(target)
call DF8(target)
call VoteKick_ClearState()
set target=null
endfunction
function VoteKick_Start takes nothing returns nothing
local player requester=GetTriggerPlayer()
local player target=null
local integer requesterId=GetPlayerId(requester)
local integer targetFloor=S2I(SubString(GetEventPlayerChatString(),6,StringLength(GetEventPlayerChatString())))
local integer humans=0
local real remaining=0.
if VoteKick_IsActiveHuman(requester)==false then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00只有仍在游戏中的真人楼层玩家可以发起投票。|r")
set requester=null
return
endif
if VoteKick_Timer!=null then
set remaining=TimerGetRemaining(VoteKick_Timer)
endif
if VoteKick_Active or remaining>0. then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00发起投票后30秒内不能再次发起，请等待"+I2S(R2I(remaining)+1)+"秒。|r")
set requester=null
return
endif
if targetFloor<1 or targetFloor>10 then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00请输入有效指令：-kick 楼层（1-10）。|r")
set requester=null
return
endif
set target=VoteKick_GetFloorPlayer(targetFloor)
if target==requester then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00不能发起投票踢出自己。|r")
set requester=null
set target=null
return
endif
if VoteKick_IsActiveHuman(target)==false then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00目标楼层不是仍在游戏中的真人玩家，不能发起投票。|r")
set requester=null
set target=null
return
endif
set humans=VoteKick_CountActiveHumans()
if humans<=2 then
call DisplayTimedTextToPlayer(requester,0,0,10.,"|cffffcc00当前真人玩家不足3人，不能发起投票踢人。|r")
set requester=null
set target=null
return
endif
call VoteKick_ResetChoices()
set VoteKick_Active=true
set VoteKick_TargetId=GetPlayerId(target)
set VoteKick_TargetFloor=targetFloor
set VoteKick_InitiatorId=requesterId
if humans>=5 then
set VoteKick_RequiredYes=3
else
set VoteKick_RequiredYes=2
endif
set VoteKick_YesCount=1
set VoteKick_NoCount=0
set VoteKick_Choice[requesterId]=1
call TimerStart(VoteKick_Timer,30.,false,function VoteKick_OnTimeout)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|cffffcc00"+KZ4[requesterId]+" 发起投票：是否踢出第"+I2S(targetFloor)+"楼 "+KZ4[VoteKick_TargetId]+"？\n30秒内输入“同意”或“不同意”。发起者默认同意，目前同意票 "+I2S(VoteKick_YesCount)+"/"+I2S(VoteKick_RequiredYes)+"。|r")
set requester=null
set target=null
endfunction
function VoteKick_Vote takes nothing returns nothing
local player voter=GetTriggerPlayer()
local integer voterId=GetPlayerId(voter)
local string vote=GetEventPlayerChatString()
if VoteKick_Active==false or VoteKick_IsActiveHuman(voter)==false then
set voter=null
return
endif
if voterId==VoteKick_TargetId then
call DisplayTimedTextToPlayer(voter,0,0,10.,"|cffffcc00被投票玩家不能参与本次表决。|r")
set voter=null
return
endif
if VoteKick_Choice[voterId]!=0 then
call DisplayTimedTextToPlayer(voter,0,0,10.,"|cffffcc00你已经在本次投票中表决过了。|r")
set voter=null
return
endif
if vote=="同意" then
set VoteKick_Choice[voterId]=1
set VoteKick_YesCount=VoteKick_YesCount+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,8.,"|cFF00FF00"+KZ4[voterId]+" 同意踢出，同意票 "+I2S(VoteKick_YesCount)+"/"+I2S(VoteKick_RequiredYes)+"。|r")
if VoteKick_YesCount>=VoteKick_RequiredYes then
call VoteKick_KickTarget()
endif
elseif vote=="不同意" then
set VoteKick_Choice[voterId]=-1
set VoteKick_NoCount=VoteKick_NoCount+1
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,8.,"|cffffcc00"+KZ4[voterId]+" 不同意踢出。|r")
endif
set voter=null
endfunction
function VoteKick_OnPlayerLeave takes nothing returns nothing
local integer leavingId=GetPlayerId(GetTriggerPlayer())
if VoteKick_Active==false then
return
endif
if leavingId==VoteKick_TargetId then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00被投票玩家已经离开，本次投票取消。|r")
call VoteKick_ClearState()
elseif leavingId==VoteKick_InitiatorId then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffffcc00投票发起者已经离开，本次投票取消。|r")
call VoteKick_ClearState()
elseif VoteKick_Choice[leavingId]==1 then
set VoteKick_Choice[leavingId]=0
set VoteKick_YesCount=IMaxBJ(1,VoteKick_YesCount-1)
elseif VoteKick_Choice[leavingId]==-1 then
set VoteKick_Choice[leavingId]=0
set VoteKick_NoCount=IMaxBJ(0,VoteKick_NoCount-1)
endif
endfunction
function VoteKick_Init takes nothing returns nothing
local trigger kickTrigger=CreateTrigger()
local trigger voteTrigger=CreateTrigger()
local trigger leaveTrigger=CreateTrigger()
local integer i=1
set VoteKick_Timer=CreateTimer()
loop
exitwhen i>5
call TriggerRegisterPlayerChatEvent(kickTrigger,Z7[i],"-kick ",false)
call TriggerRegisterPlayerChatEvent(kickTrigger,A7[i],"-kick ",false)
call TriggerRegisterPlayerChatEvent(voteTrigger,Z7[i],"同意",true)
call TriggerRegisterPlayerChatEvent(voteTrigger,Z7[i],"不同意",true)
call TriggerRegisterPlayerChatEvent(voteTrigger,A7[i],"同意",true)
call TriggerRegisterPlayerChatEvent(voteTrigger,A7[i],"不同意",true)
call TriggerRegisterPlayerEventLeave(leaveTrigger,Z7[i])
call TriggerRegisterPlayerEventLeave(leaveTrigger,A7[i])
set i=i+1
endloop
call TriggerAddAction(kickTrigger,function VoteKick_Start)
call TriggerAddAction(voteTrigger,function VoteKick_Vote)
call TriggerAddAction(leaveTrigger,function VoteKick_OnPlayerLeave)
set kickTrigger=null
set voteTrigger=null
set leaveTrigger=null
endfunction
function JKICKAFK takes nothing returns nothing
local integer O5=S2I(SubString(GetEventPlayerChatString(),9,StringLength(GetEventPlayerChatString())))
local player p=GetTriggerPlayer()
local integer i=GetPlayerId(p)
local string VH
if SPEPLAYER[i]!=1 and SPEPLAYER[i]!=2 and SPEPLAYER[i]!=20 then
    set p=null
    return
endif
if O5>5 then
set O5=O5+1
endif
if O5==i then
	call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "|c00ff0303不能踢自己|r")
	set p=null
	return
endif
if(C<10)then
set VH=I2S(B)+":0"+I2S(C)
else
set VH=I2S(B)+":"+I2S(C)
endif
if TY7(Player(O5)) then
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00ff0303"+KZ4[GetPlayerId(Player(O5))]+" 已被踢出游戏|r")
set C9[GetPlayerId(Player(O5))]="|c00555555"+VH+"|r"
call RemovePlayer(Player(O5),PLAYER_GAME_RESULT_DEFEAT)
call Z32(Player(O5))
set U2[GetPlayerId(Player(O5))]=true
call DG8(Player(O5))
call DF8(Player(O5))
endif
set p=null
endfunction
