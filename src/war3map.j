function B1039Later takes nothing returns nothing
local timer skinTimer1039=GetExpiredTimer()
local integer skinKey1039=GetHandleId(skinTimer1039)
local integer skinPid1039=LoadInteger(L7,skinKey1039,0)
call FlushChildHashtable(L7,skinKey1039)
call PauseTimer(skinTimer1039)
call DestroyTimer(skinTimer1039)
set B1039Pending[skinPid1039]=false
if B1032Selected[skinPid1039]>0 or B1031Equipped[skinPid1039] then
call B1039Check(skinPid1039)
endif
set skinTimer1039=null
endfunction
