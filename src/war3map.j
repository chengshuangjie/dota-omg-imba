function JTJTX takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit u=M7[GetPlayerId(b1060GetTriggerPlayer)]
local integer tx
local integer i=S2I(SubString(GetEventPlayerChatString(),3,6))
if u==null then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,GetObjectName('n08A'))
elseif not IsUnitAliveBJ(u) then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "请等待英雄复活")
elseif i > 0 and i < 36 then
set tx=TJTX_TXCX(i)
call UnitAddAbility(u,tx)
call UnitMakeAbilityPermanent(u,true,tx)
call SetPlayerAbilityAvailable(b1060GetTriggerPlayer,tx,false)
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"添加特效方法：|cFF00FF00-tx 1~35|r (一共35种)\n使用 -cxtx 查询特效具体效果\n使用 -qx 取消所有特效")
endif
set u=null
set b1060GetTriggerPlayer=null
endfunction
