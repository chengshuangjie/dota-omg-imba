function UnitAddStun takes unit whichUnit returns nothing
	local unit dummyUnit = null
	if MiaoStarted and GetUnitAbilityLevel(whichUnit,'AMdI')>0 then
		return
	endif
		set dummyUnit = CreateUnit(GetOwningPlayer(whichUnit),'e00E', GetUnitX(whichUnit), GetUnitY(whichUnit), 0)
		call UnitAddAbility(dummyUnit, 'A4K1')
		call B947IssueTargetOrderById("UnitAddStun @ war3map.j:175285 (B968)",dummyUnit, 852095, whichUnit)
		set dummyUnit = null
endfunction
function TIAODAO_STOP2 takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
    // call DisplayTextToPlayer(Player(1), 0, 0, I2S(( GetUnitCurrentOrder(u) )))
    if GetUnitCurrentOrder(u)==851971 then //是移动命令就停止
	    call B947IssueImmediateOrderById("TIAODAO_STOP2 @ war3map.j:175294 (B968)",u,$D0004)
    endif
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set u = null
	set t = null
endfunction
function TIAODAO_STOP takes unit u returns nothing
	local timer t = CreateTimer()
	local integer h = GetHandleId(t)
	call TimerStart(t, 0, false, function TIAODAO_STOP2)
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	set t = null
endfunction
function MISS_MISSILE takes nothing returns nothing
    local integer missile=MHMissile_GetEnumMissile()
    local unit ZX7=MHMissile_GetSource(missile)
    local unit IH7=MHMissile_GetTargetUnit(missile)
    if IH7==missiletmpunit and IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) then
        call MHMissile_SetTarget(missile,null)
    endif
    set ZX7=null
    set IH7=null
endfunction
function TIAODAO takes nothing returns nothing
	local unit u = GetTriggerUnit()
    local real SourcetX=GetUnitX(u)
    local real SourcetY=GetUnitY(u)
    local real TargetX=X17(GetSpellTargetX())
    local real TargetY=X07(GetSpellTargetY())
    local location l
    local real Angle=AngleBetweenXY(SourcetX,SourcetY,TargetX,TargetY)
    local integer skill=B287_GetSpellAbilityId()
    local real d=1200.
	if GetUnitTypeId(u)=='ncop' then
		set u=null
		return
	endif
    if skill=='A2YR' or skill=='A4HR' or skill=='A4HS' then
        set d=1400.
    endif
    if KF7(SourcetX,SourcetY,TargetX,TargetY)>d then
        set TargetX=X17(SourcetX+d*Cos(Angle*bj_DEGTORAD))
        set TargetY=X07(SourcetY+d*Sin(Angle*bj_DEGTORAD))
    endif
    if YL7(TargetY,TargetY)==false then
        set l=YV8_EX(TargetX,TargetY)
        set TargetX=GetLocationX(l)
        set TargetY=GetLocationY(l)
        call RemoveLocation(l)
        set l=null
    endif
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",SourcetX,SourcetY))
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",TargetX,TargetY))
    // call ShowUnit(u,false) //会取消技能选择圈
    // call ShowUnit(u,true)
    // if IsUnitSelected(u,GetLocalPlayer()) then
    //     call SelectUnitForPlayerSingle(u,GetLocalPlayer())
    // endif
    // call SetUnitPosition(u,TargetX,TargetY) //会打断后续shift
    // call ShowUnit(u,false) //会取消技能选择圈
    // call ShowUnit(u,true)
    // if IsUnitSelected(u,GetLocalPlayer()) then
    //     call SelectUnitForPlayerSingle(u,GetLocalPlayer())
    // endif
    // call SetUnitPosition(u,TargetX,TargetY) //会打断后续shift
    set missiletmpunit=u
    call MHMissile_EnumInRange(SourcetX,SourcetY,2000.,function MISS_MISSILE)
    call SetUnitX(u,TargetX)
    call SetUnitY(u,TargetY)
    call MHUnit_SetFacing(u,Angle,false)
    call UnitAddStun(u)
    call TIAODAO_STOP(u)
    // if skill=='A2YR' then
    //     call MASG(u)
    // if skill=='A2YR' then
    //     call MASG(u)
    if skill=='A4HR' then
        call SSSG(u)
    elseif skill=='A4HS' then
        call XJSG(u)
    endif
	set u = null
endfunction
function XSBF2 takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	call SetUnitImitateMoveSpeed(LoadUnitHandle(TABLE_HY, h, 0), 0, 0)
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
endfunction
function XSBF takes nothing returns nothing
	local timer t = CreateTimer()
	local integer h = GetHandleId(t)
    local unit u = GetTriggerUnit()
	call SaveUnitHandle(TABLE_HY, h, 0, u)
	call SetUnitImitateMoveSpeed(u, 999, 800)
	// IMBA: XSBF buff x2 cap 30s.
	if XOMG_IMBA_ENABLED then
	call TimerStart(t, RMinBJ(15.*IMBA_POWER,30.), false, function XSBF2)
	else
	call TimerStart(t, 15., false, function XSBF2)
	endif
	set t = null
    set u = null
endfunction
function USE_LINGXIA4 takes unit ZX7,unit IH7 returns nothing
    local real damage
    if IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and IsAliveNotStrucNotWard(IH7) and WF7(IH7)==false and IsHideUnit(IH7)==false and CHUIFENG(IH7)==false and AM7(IH7,GetOwningPlayer(ZX7))==false then
	    if GetUnitAbilityLevel(ZX7,'A4K8')>0 and LoadInteger(TABLE_HY, GetHandleId(ZX7),'LXCD')== 0 then
            // call LXCD(ZX7)
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",GetUnitX(IH7),GetUnitY(IH7)))
            if GetUnitAbilityLevel(ZX7,'A4K7')>0 then
		        call B67(ZX7,IH7,1,150)
		        call Z57(IH7,'A4K9', 1, 2.,'B0KG')
                call YW7("+150",2,IH7,.023,255,80,168,255)
            elseif GetUnitAbilityLevel(ZX7,'A4KB')>0 then
                set damage = 150. + (GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) ) * 0.6
		        call B67(ZX7,IH7,1,damage)
		        call Z57(IH7,'A4KA', 1, 2.,'B0KH')
                call YW7("+"+I2S(R2I(damage)),2,IH7,.023,255,80,168,255)
            endif
	    endif
    endif
endfunction
