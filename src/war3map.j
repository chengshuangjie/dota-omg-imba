function AVF takes nothing returns boolean
if GetItemType(GetManipulatedItem())==ITEM_TYPE_PERMANENT and(KZ7(GetManipulatedItem())==R1K or KZ7(GetManipulatedItem())==U3 or KZ7(GetManipulatedItem())==ZL or KZ7(GetManipulatedItem())==WL or KZ7(GetManipulatedItem())==DK4 or KZ7(GetManipulatedItem())==DM4 or KZ7(GetManipulatedItem())==it_xueshou_off or KZ7(GetManipulatedItem())==it_xueshou_on or KZ7(GetManipulatedItem())==it_xueshou_off_courier or KZ7(GetManipulatedItem())==it_xueshou_on_courier or KZ7(GetManipulatedItem())==it_sadan or KZ7(GetManipulatedItem())==EZB or KZ7(GetManipulatedItem())==Z2 or KZ7(GetManipulatedItem())==R03 or KZ7(GetManipulatedItem())==R16 or KZ7(GetManipulatedItem())==it_zhzg or KZ7(GetManipulatedItem())==it_fls)then
call AUF()
endif
return false
endfunction
function AWF takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
if b1060GetTriggerEventId==EVENT_UNIT_DROP_ITEM and (KZ7(GetManipulatedItem())==DK4 or KZ7(GetManipulatedItem())==DN4 or KZ7(GetManipulatedItem())==it_xueshou_on or KZ7(GetManipulatedItem())==it_xueshou_on_courier) then
call NM7(OB7)
call OZ7(t)
elseif b1060GetTriggerEventId!=EVENT_UNIT_DROP_ITEM then
if((LoadInteger(L7,(GetHandleId((WI7))),((4310))))==1)==false then
if OM7(OB7,"BloodHandDrain")==1 then
call SetUnitState(WI7,UNIT_STATE_LIFE,YK7(GetUnitState(WI7,UNIT_STATE_LIFE)-GetUnitState(WI7,UNIT_STATE_MAX_LIFE)*.012,1))
else
call SetUnitState(WI7,UNIT_STATE_LIFE,YK7(GetUnitState(WI7,UNIT_STATE_LIFE)-HJ4,1))
endif
endif
endif
set t=null
set WI7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function AXF takes nothing returns nothing
local item b1060GetManipulatedItem=GetManipulatedItem()
local unit WI7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DROP_ITEM)
call TriggerAddCondition(t,Condition(function AWF))
call NT7(OB7,"Hero",WI7)
if KZ7(b1060GetManipulatedItem)==it_xueshou_on or KZ7(b1060GetManipulatedItem)==it_xueshou_on_courier then
call NP7(OB7,"BloodHandDrain",1)
else
call NP7(OB7,"BloodHandDrain",0)
endif
call TriggerEvaluate(t)
set t=null
set WI7=null
set b1060GetManipulatedItem=null
endfunction
//臂章
function AYF takes nothing returns boolean
if GetItemType(GetManipulatedItem())==ITEM_TYPE_PERMANENT and (KZ7(GetManipulatedItem())==DK4 or KZ7(GetManipulatedItem())==DN4 or KZ7(GetManipulatedItem())==it_xueshou_on or KZ7(GetManipulatedItem())==it_xueshou_on_courier) and KW7(GetTriggerUnit())==false and AS7(GetTriggerUnit())==false then
call AXF()
endif
return false
endfunction
