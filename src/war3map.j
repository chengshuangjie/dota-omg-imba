if tx>0 then
if tx==100 then
call XF7(playeru3,'A1RG')
call SetPlayerAbilityAvailable(p,'A1RG',false)
call XF7(playeru3,'A1RH')
call SetPlayerAbilityAvailable(p,'A1RH',false)
elseif tx==200 then
call XF7(playeru3,'A4CL')
call SetPlayerAbilityAvailable(p,'A4CL',false)
call XF7(playeru3,'A4CM')
call SetPlayerAbilityAvailable(p,'A4CM',false)
elseif tx=='A0PA' then
call UnitRemoveAbility(playeru3,'A0PA')
call UnitAddAbility(playeru3,'A0PA')
call UnitMakeAbilityPermanent(playeru3,true,'A1RG')
call SetPlayerAbilityAvailable(p,'A1RG',false)
else
call XF7(playeru3,tx)
call SetPlayerAbilityAvailable(p,tx,false)
endif
endif
endfunction
function FIND_SLOT takes unit playeru2,integer appointid returns integer
local integer i
local item ff
set i=0
loop
exitwhen i>5
set ff=UnitItemInSlot(playeru2,i)
if appointid==1 then
if(ff!=null)and(Y_82(ff))then
set ff=null
return i
endif
endif
if appointid==2 then
if(ff!=null)and(Y_8_BS(ff))then
set ff=null
return i
endif
endif
if appointid==3 then
if(ff!=null)and(Y_8_LLX(ff))then
set ff=null
return i
endif
endif
set i=i+1
endloop
set ff=null
return-1
endfunction
// Authoritative sources: held Scepter variants or a consumed Aghanim blessing.
// Native hidden spellbooks are effects of this state and must not become self-sustaining sources.
function SuijiMode_DetectAghanimSourceState takes unit u returns boolean
local integer ownItemIndex=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set ownItemIndex=F59(u)
return GetUnitAbilityLevel(u,'A0TK')>0 or FIND_SLOT(u,1)>-1 or (ownItemIndex>=0 and MV7(u,ZU[ownItemIndex])!=null) or MV7(u,ZU[GX4])!=null or MV7(u,ZU[R1K])!=null or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0
endfunction
// Physical detector used by state synchronization. It deliberately ignores the cached state.
function SuijiMode_DetectAghanimState takes unit u returns boolean
local integer nativeBook=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if SuijiMode_DetectAghanimSourceState(u) then
return true
endif
set nativeBook=F29(u)
return nativeBook>0 and GetUnitAbilityLevel(u,nativeBook)>0
endfunction
// Effect queries also accept the last synchronized state so native Aghanim spellbook normalization cannot suppress upgrades.
function SuijiMode_HasAghanimState takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if GetUnitTypeId(u)=='Hmkg' then
return SuijiMode_DetectAghanimSourceState(u)
endif
return LoadBoolean(L7,GetHandleId(u),StringHash("SuijiHasScepter")) or SuijiMode_DetectAghanimSourceState(u)
endfunction
function SuijiMode_IsNativeEarthshaker takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch'
endfunction
function SuijiMode_NormalizeNativeEarthshakerAgh takes unit u returns nothing
if SUIJI_MODE==false or SuijiMode_IsNativeEarthshaker(u)==false then
return
endif
if GetUnitAbilityLevel(u,'A1N0')>0 then
call UnitRemoveAbility(u,'A1N0')
endif
// Keep native A0DH/A1OB in its hero learn slot.  Only the derived helper book
// is normalized; registry state owns effects and resolves the live button.
endfunction
function SuijiMode_IsNativeSandKing takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='U00K' or id=='Z00K' or id=='Z10K'
endfunction
function SuijiMode_NormalizeNativeSandKingAgh takes unit u returns nothing
if SUIJI_MODE==false or SuijiMode_IsNativeSandKing(u)==false then
return
endif
if GetUnitAbilityLevel(u,'A1BC')>0 then
call UnitRemoveAbility(u,'A1BC')
endif
// Keep native A06R/A1B4 learnable.  Registered cooldown writes target the
// current physical button instead of replacing the pair.
endfunction
function SuijiMode_IsNativeNevermore takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='Nfir' or id=='Zfir' or id=='Zgir' or id=='Zhir'
endfunction
function SuijiMode_NormalizeNativeNevermoreAgh takes unit u returns nothing
if SUIJI_MODE==false or SuijiMode_IsNativeNevermore(u)==false then
return
endif
if GetUnitAbilityLevel(u,'A1MU')>0 then
call UnitRemoveAbility(u,'A1MU')
endif
// Keep native A29J/A1MP learnable.  The hidden helper can be removed without
// deleting or runtime-readding the hero's actual learn-slot ability.
endfunction
function SuijiMode_IsNativePudge takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetUnitTypeId(u)
return id=='U00F' or id=='Z00F'
endfunction
function SuijiMode_NormalizeNativePudgeAgh takes unit u returns nothing
if SUIJI_MODE==false or SuijiMode_IsNativePudge(u)==false then
return
endif
// Native Pudge must keep the engine-owned A06I/A2S1 learnable pair.  Removing
// A2S1 and adding A06I at runtime destroys the native hero learn slot after an
// -omgtest preset grants Scepter.  The registry resolves the current physical
// button below, while random copied Meat Hook still uses its stable clone.
endfunction
function SuijiMode_IsNativeLearnableAghPair takes unit u,integer normalSkill,integer aghSkill returns boolean
local integer h=0
local integer source=0
local integer slot=1
local boolean hasNormal=false
local boolean hasAgh=false
if u==null or GetUnitTypeId(u)==0 or normalSkill==0 or aghSkill==0 then
return false
endif
set h=GetHandleId(u)
set source=LoadInteger(L7,h,StringHash("SuijiStableHeroIndex"))
if source<KL4 or source>K54 then
set source=GetUnitPointValue(u)
endif
if source<KL4 or source>K54 then
return false
endif
loop
exitwhen slot>10
if LoadInteger(MSK,source,slot)==normalSkill then
set hasNormal=true
elseif LoadInteger(MSK,source,slot)==aghSkill then
set hasAgh=true
endif
set slot=slot+1
endloop
return hasNormal and hasAgh
endfunction
function SuijiMode_NormalizePersistentPairAbility takes unit u,integer normalSkill,integer aghSkill returns nothing
local integer normalLevel=0
local integer aghLevel=0
local integer level=0
local integer normalPhysical=0
local integer aghPhysical=0
local real cooldown=0.
local real otherCooldown=0.
local player p=null
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or normalSkill==0 or aghSkill==0 then
return
endif
if SuijiMode_IsNativeLearnableAghPair(u,normalSkill,aghSkill) then
return
endif
// Do not rebuild the A11T/A4AS command owner while its scripted Spirit form is
// active.  The cast-time duration/level is authoritative until form cleanup.
if normalSkill=='A11T' and aghSkill=='A4AS' and OO7(GetHandleId(u),"SuijiScriptedSpiritForm") then
return
endif
set normalLevel=B287_GetUnitAbilityLevel(u,normalSkill)
set aghLevel=B287_GetUnitAbilityLevel(u,aghSkill)
if aghLevel<1 then
return
endif
set aghPhysical=B287_GetPhysicalAbilityId(u,aghSkill)
if SuijiMode_HasNativeAbility(u,aghPhysical)==false then
return
endif
// The upgraded clone can be the only recorded slot owner at this point.
// Resolve the base side directly from the fixed-clone table so normalization
// never attaches the logical source ability or leaves it behind as an orphan.
set normalPhysical=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,normalSkill)
if normalPhysical==0 then
set normalPhysical=normalSkill
endif
set level=IMaxBJ(normalLevel,aghLevel)
if normalLevel>0 and SuijiMode_HasExactLiveAbility(u,B287_GetPhysicalAbilityId(u,normalSkill)) then
set cooldown=YDWEGetUnitAbilityState(u,B287_GetPhysicalAbilityId(u,normalSkill),1)
endif
if SuijiMode_HasExactLiveAbility(u,aghPhysical) then
set otherCooldown=YDWEGetUnitAbilityState(u,aghPhysical,1)
endif
if otherCooldown>cooldown then
set cooldown=otherCooldown
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,normalPhysical,level,true)==false then
return
endif
if cooldown>0. then
call YDWESetUnitAbilityState(u,normalPhysical,1,cooldown)
call MHAbility_SetCooldown(u,normalPhysical,cooldown)
endif
set p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,normalPhysical,true)
call SetPlayerAbilityAvailable(p,aghPhysical,false)
call UnitRemoveAbility(u,aghPhysical)
set p=null
endfunction
function SuijiMode_IsFixedPersistentAghPair takes integer normalSkill,integer aghSkill returns boolean
if (normalSkill=='A01Y' and aghSkill=='A4KM') or (normalSkill=='A0MQ' and aghSkill=='A1B6') or (normalSkill=='A0MW' and aghSkill=='A27C') then
return true
endif
if (normalSkill=='A0OR' and aghSkill=='A4K0') or (normalSkill=='A11T' and aghSkill=='A4AS') then
return true
endif
if (normalSkill=='A01P' and aghSkill=='A09Z') or (normalSkill=='A0Q7' and aghSkill=='A4J4') or (normalSkill=='A0OK' and aghSkill=='A1VW') or (normalSkill=='A4CR' and aghSkill=='A4DA') then
return true
endif
if (normalSkill=='A06I' and aghSkill=='A2S1') then
return true
endif
