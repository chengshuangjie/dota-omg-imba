if ChaosObserver_IsDalaranHero(hero) and XH7(hero)==false then
set dx=GetUnitX(hero)-ChaosObserverBoltX
set dy=GetUnitY(hero)-ChaosObserverBoltY
if dx*dx+dy*dy<=90000. then
call B67(ChaosObserverBoss,hero,3,250.+GetUnitState(hero,UNIT_STATE_MAX_LIFE)*.10)
call CommonUnitAddStun(hero,.5,true)
endif
endif
set i=i+1
endloop
set hero=null
endfunction
function ChaosObserver_DoPulse takes nothing returns nothing
local integer i=1
