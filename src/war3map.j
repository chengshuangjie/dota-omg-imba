    call B947IssueTargetOrderById("YJHY3 @ war3map.j:95723 (B968)",DA8,$D0249,u)
endif
if DB8!=null and UnitAlive(DB8) then
    call B947IssueTargetOrderById("YJHY3 @ war3map.j:95726 (B968)",DB8,$D0249,u)
endif
if DC8!=null and UnitAlive(DC8) then
    call B947IssueTargetOrderById("YJHY3 @ war3map.j:95729 (B968)",DC8,$D0249,u)
endif
if D38!=null and UnitAlive(D38) then
    call B947IssueTargetOrderById("YJHY3 @ war3map.j:95732 (B968)",D38,$D0249,u)
endif
set u=null
set D38=null
set DC8=null
set DB8=null
set DA8=null
endfunction
