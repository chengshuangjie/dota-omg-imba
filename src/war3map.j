function Chute_Main takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=LoadUnitHandle(TABLE_XJ,(OB7),(2))
local real x0=(LoadReal(TABLE_XJ,(OB7),(6)))
local real y0=(LoadReal(TABLE_XJ,(OB7),(7)))
local real DUR=(LoadReal(TABLE_XJ,(OB7),(10)))
local integer i
local real x
local real y
local group g
local boolexpr chuteDamageFilter=null
if GetTriggerEvalCount(t)>=DUR*2 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
else
set g=WS7()
set U22=ZX7
set chuteDamageFilter=Condition(function DJX)
call GroupEnumUnitsInRange(g,x0,y0,400+25,chuteDamageFilter)
call DestroyBoolExpr(chuteDamageFilter)
call ForGroup(g,function Chute_Add)
call WR7(g)
set i=1
loop
exitwhen i>3
set x=GetRandomReal(x0-250,x0+250)
set y=GetRandomReal(y0-250,y0+250)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",x,y))
set i=i+1
endloop
endif
set g=null
set chuteDamageFilter=null
set t=null
set ZX7=null
return false
endfunction
function Chute_RWG takes nothing returns boolean
local unit IH7=GetFilterUnit()
local unit ZX7=IN4
local real RXG=UR4
local real RYG=US4
local real x
local real y
local real a
local real d
if WF7(GetFilterUnit())==false and IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false) then
if(OT7(IH7,"4324")==false)then
call O37(IH7,"4324",.3)
endif
set d=KF7(RXG,RYG,GetUnitX(IH7),GetUnitY(IH7))
set a=J77(RXG,RYG,GetUnitX(IH7),GetUnitY(IH7))*bj_DEGTORAD
if d>400 then
set x=GetUnitX(IH7)+$B*Cos(a)
set y=GetUnitY(IH7)+$B*Sin(a)
else
set x=GetUnitX(IH7)-$B*Cos(a)
set y=GetUnitY(IH7)-$B*Sin(a)
endif
call SetUnitX(IH7,x)
call SetUnitY(IH7,y)
endif
set IH7=null
set ZX7=null
return false
endfunction
function Chute_RZG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real RXG=(LoadReal(L7,(I97),(6)))
local real RYG=(LoadReal(L7,(I97),(7)))
local real DUR=(LoadReal(L7,(I97),(10)))
local real x
local real y
local integer i=0
local group g
local boolexpr chutePullFilter=null
if GetTriggerEvalCount(t)>(50*DUR)then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
set g=WS7()
set UR4=RXG
set US4=RYG
set IN4=ZX7
set chutePullFilter=Condition(function Chute_RWG)
loop
exitwhen i>16
set x=RXG+400*Cos(bj_DEGTORAD*360.*i/16.)
set y=RYG+400*Sin(bj_DEGTORAD*360.*i/16.)
call GroupEnumUnitsInRange(g,x,y,75,chutePullFilter)
set i=i+1
endloop
call DestroyBoolExpr(chutePullFilter)
call WR7(g)
set g=null
endif
set t=null
set ZX7=null
set chutePullFilter=null
return false
endfunction
function Chute_Action takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local real x0=GetSpellTargetX()
local real y0=GetSpellTargetY()
local destructable d
local unit u
local integer i
local real a
local real x
local real y
local integer level=GetUnitAbilityLevel(ZX7,'A4IM')
local real DUR=1.5+level
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",x0,y0))
call Y67(x0,y0,400)
set i=1
loop
exitwhen i>28
set a=i*20
set x=x0+400*Cos(a*bj_DEGTORAD)
set y=y0+400*Sin(a*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(ZX7),'h0HE',x,y,AngleBetweenXY(x,y,x0,y0))
call UnitApplyTimedLife(u,'BTLF',DUR)
set i=i+1
endloop
set u=CreateUnit(GetOwningPlayer(ZX7),'h0HF',x0,y0,0)
call UnitApplyTimedLife(u,'BTLF',DUR)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function Chute_Main))
call SaveUnitHandle(TABLE_XJ,(OB7),(2),(ZX7))
call SaveReal(TABLE_XJ,(OB7),(6),((x0)*1.0))
call SaveReal(TABLE_XJ,(OB7),(7),((y0)*1.0))
call SaveReal(TABLE_XJ,(OB7),(10),(DUR))
call TriggerEvaluate(t)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call SaveUnitHandle(L7,(OB7),(2),(ZX7))
call SaveReal(L7,(OB7),(6),((x0)*1.))
call SaveReal(L7,(OB7),(7),((y0)*1.))
call SaveReal(L7,(OB7),(10),((DUR)))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function Chute_RZG))
set ZX7=null
set u=null
set d=null
set t=null
endfunction
