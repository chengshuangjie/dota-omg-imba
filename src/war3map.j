if b1060GetTriggerEventId==EVENT_PLAYER_HERO_SKILL and IsUnitIllusion(b1060GetTriggerUnit)==false and (B287_GetLearnedSkill()=='A2E5' or B287_GetLearnedSkill()=='A2SH' or B287_GetLearnedSkill()=='A2SI') then
call cNe()
endif
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
