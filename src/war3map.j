endfunction
function JND takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit p5=GetTriggerUnit()
local unit JED
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
local integer level=B287_GetUnitAbilityLevel(p5,b1060B287_GetSpellAbilityId)
local integer synergyLevel=B287_GetUnitAbilityLevel(p5,'A0A8')
local group g=WS7()
local integer skillbuff
local real d
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(p5),Condition(function JMD))
set JED=FirstOfGroup(g)
call WR7(g)
if level==1 then
	set skillbuff='A4M0'
elseif level==2 then
	set skillbuff='A4M1'
elseif level==3 then
	set skillbuff='A4M2'
elseif level==4 then
	set skillbuff='A4M3'
endif
if b1060B287_GetSpellAbilityId=='A1EF' then
	set d=10
elseif b1060B287_GetSpellAbilityId=='A1EE' then
	set d=20
elseif b1060B287_GetSpellAbilityId=='A1EH' then
	set d=30
elseif b1060B287_GetSpellAbilityId=='A1EI' then
	set d=40
elseif b1060B287_GetSpellAbilityId=='A1EG' then
	set d=50
// call XF7(BB7,1093681477)
// call SetUnitAbilityLevel(BB7,1093681477,V77)
// call XF7(BB7,1093681477)
// call SetUnitAbilityLevel(BB7,1093681477,V77)
// call XF7(BB7,1093681477)
// call SetUnitAbilityLevel(BB7,1093681477,V77)
endif
// Random Synergy uses a safe passive carrier instead of runtime ANeg. Preserve
// the old A1EF->A1EE->A1EH->A1EI->A1EG duration progression in script; native
// Lone Druid keeps the original engine-owned A0A8 controller.
if GetUnitAbilityLevel(p5,'Y03H')>0 and synergyLevel>0 then
set d=RMinBJ(50.,d+10.*synergyLevel)
endif
call REMOVE_KM_BUFF(p5)
call Z57(p5,skillbuff, 1, d,'B016')
if JED!=null and XH7(JED)==false then
call REMOVE_KM_BUFF(JED)
call Z57(JED,skillbuff, 1, d,'B016')
endif
set g=null
set p5=null
set JED=null
set BB7=null
endfunction
function JOD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1EF' or B287_GetSpellAbilityId()=='A1EE' or B287_GetSpellAbilityId()=='A1EH' or B287_GetSpellAbilityId()=='A1EI' or B287_GetSpellAbilityId()=='A1EG' then
call JND()
endif
return false
endfunction
