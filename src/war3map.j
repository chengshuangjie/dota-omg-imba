function SuijiTest_RawCode takes string raw returns integer
local integer a=0
local integer b=0
local integer c=0
local integer d=0
if StringLength(raw)!=4 then
return 0
endif
set a=SuijiTest_RawChar(SubString(raw,0,1))
set b=SuijiTest_RawChar(SubString(raw,1,2))
set c=SuijiTest_RawChar(SubString(raw,2,3))
set d=SuijiTest_RawChar(SubString(raw,3,4))
if a==0 or b==0 or c==0 or d==0 then
return 0
endif
return a*16777216+b*65536+c*256+d
endfunction
function SuijiTest_Command takes nothing returns nothing
local player host=GetTriggerPlayer()
local player target=null
local string text=GetEventPlayerChatString()
local string heroText=""
local string smallText=""
local string ultText=""
local integer floor=0
local integer hero=0
local integer small=0
local integer ult=0
local integer pid=0
local boolean keepOld=false
if Test_NoOtherHumanPlayer(host)==false then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00有其他真人玩家时不能使用 -omgtest|r")
set host=null
return
endif
if GetPlayerController(host)!=MAP_CONTROL_USER then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00只有玩家可以使用 OMG 测试指令|r")
set host=null
return
endif
if SUIJI_MODE==false then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00请先进入 OMG 模式后再使用测试指令|r")
set host=null
return
endif
set keepOld=SuijiTest_CommandWord(text,1)=="-omgtest2"
set floor=S2I(SuijiTest_CommandWord(text,2))
set heroText=SuijiTest_CommandWord(text,3)
set smallText=SuijiTest_CommandWord(text,4)
set ultText=SuijiTest_CommandWord(text,5)
if floor<1 or floor>10 or StringLength(heroText)!=4 or StringLength(smallText)!=4 or StringLength(ultText)!=4 then
call DisplayTimedTextToPlayer(host,0,0,12.,"|cFFFFCC00用法：-omgtest 楼层 英雄ID 小技能ID 大招ID，例如 -omgtest 6 Nfir A0EY A29J|r")
set host=null
return
endif
set target=K27(floor)
if target==null or (target!=host and GetPlayerController(target)!=MAP_CONTROL_COMPUTER) then
call DisplayTimedTextToPlayer(host,0,0,8.,"|cFFFFCC00目标楼层必须是自己所在楼层或电脑玩家|r")
set host=null
set target=null
return
endif
set hero=SuijiTest_RawCode(heroText)
set small=SuijiTest_RawCode(smallText)
set ult=SuijiTest_RawCode(ultText)
if SuijiTest_FindHeroIndex(hero)==0 or SuijiTest_IsSmallPoolSkill(small)==false or SuijiTest_IsUltPoolSkill(ult)==false or small==ult then
call DisplayTimedTextToPlayer(host,0,0,12.,"|cFFFFCC00技能槽位不匹配：第一个必须是随机小技能，第二个必须是随机大招。请用网页生成命令。|r")
set host=null
set target=null
return
endif
set pid=GetPlayerId(target)
call SaveInteger(L7,StringHash("SuijiTestPresetHero"),pid,hero)
call SaveInteger(L7,StringHash("SuijiTestPresetSmall"),pid,small)
call SaveInteger(L7,StringHash("SuijiTestPresetUlt"),pid,ult)
call SavePlayerHandle(L7,StringHash("SuijiTestPresetController"),pid,host)
if SuijiTest_ReplaceAIHero(target,keepOld) then
call DisplayTimedTextToPlayer(host,0,0,10.,"|cFF00FF00OMG测试：已创建第 "+I2S(floor)+" 楼 AI，立即给予英雄 "+heroText+"、小技能 "+smallText+"、大招 "+ultText+"。|r")
if keepOld then
call DisplayTimedTextToPlayer(host,0,0,10.,"|cFF66CCFFOMG测试2：已保留该楼层此前创建的英雄。|r")
endif
if ult=='A03G' or ult=='ANcr' or ult=='A093' then
call DisplayTimedTextToPlayer(host,0,0,12.,"|cFF66CCFFB579变身入口：|r逻辑="+GetAbilityName(ult)+" 载体="+GetAbilityName(B287_GetPhysicalAbilityId(M7[pid],ult))+" 等级="+I2S(GetUnitAbilityLevel(M7[pid],B287_GetPhysicalAbilityId(M7[pid],ult)))+"；三个物理载体由 CHANNEL/CAST/EFFECT 直接分发。")
endif
else
call DisplayTimedTextToPlayer(host,0,0,10.,"|cFFFFCC00OMG测试：目标 AI 创建失败，请在选人阶段后重试。|r")
endif
set host=null
set target=null
set text=""
set heroText=""
set smallText=""
set ultText=""
endfunction
function B1058Test11 takes nothing returns nothing
local player testHost1058=GetTriggerPlayer()
local player testPlayer1058=null
local integer testFloor1058=2
local integer testPid1058=0
local integer testHero1058=0
local integer testSmall1058=0
local integer testUlt1058=0
local integer testCount1058=0
if not Test_NoOtherHumanPlayer(testHost1058) or not SUIJI_MODE or GetPlayerController(testHost1058)!=MAP_CONTROL_USER then
call DisplayTimedTextToPlayer(testHost1058,0,0,8.,"-test11 仅供单真人 OMG 对局使用。")
set testHost1058=null
return
endif
// Validate every slot before replacing any hero.
loop
exitwhen testFloor1058>10
set testPlayer1058=K27(testFloor1058)
if testPlayer1058==null or GetPlayerController(testPlayer1058)!=MAP_CONTROL_COMPUTER then
call DisplayTimedTextToPlayer(testHost1058,0,0,8.,"-test11 需要2至10楼全部为AI。")
set testHost1058=null
set testPlayer1058=null
return
endif
set testFloor1058=testFloor1058+1
endloop
set testFloor1058=2
loop
exitwhen testFloor1058>10
if testFloor1058==2 then
set testHero1058='H00Q'
set testSmall1058='A0BZ'
set testUlt1058='A0SW'
elseif testFloor1058==3 then
set testHero1058='H00U'
set testSmall1058='A01N'
set testUlt1058='A0DB'
elseif testFloor1058==4 then
set testHero1058='UC18'
set testSmall1058='A4DJ'
set testUlt1058='A088'
elseif testFloor1058==5 then
set testHero1058='N01A'
set testSmall1058='A229'
set testUlt1058='A0SW'
elseif testFloor1058==6 then
set testHero1058='U008'
set testSmall1058='A0K9'
set testUlt1058='A2CI'
elseif testFloor1058==7 then
set testHero1058='N01I'
set testSmall1058='A2UE'
set testUlt1058='A03Q'
elseif testFloor1058==8 then
set testHero1058='Hvsh'
set testSmall1058='A0T2'
set testUlt1058='A0CY'
elseif testFloor1058==9 then
set testHero1058='H0DO'
set testSmall1058='A08V'
set testUlt1058='A2UE'
elseif testFloor1058==10 then
set testHero1058='UC76'
set testSmall1058='A0MM'
set testUlt1058='A15J'
endif
set testPlayer1058=K27(testFloor1058)
set testPid1058=GetPlayerId(testPlayer1058)
call SaveInteger(L7,StringHash("SuijiTestPresetHero"),testPid1058,testHero1058)
call SaveInteger(L7,StringHash("SuijiTestPresetSmall"),testPid1058,testSmall1058)
call SaveInteger(L7,StringHash("SuijiTestPresetUlt"),testPid1058,testUlt1058)
call SavePlayerHandle(L7,StringHash("SuijiTestPresetController"),testPid1058,testHost1058)
if SuijiTest_ReplaceAIHero(testPlayer1058,false) then
set testCount1058=testCount1058+1
else
call DisplayTimedTextToPlayer(testHost1058,0,0,8.,"-test11 第"+I2S(testFloor1058)+"楼创建失败，请在选人后重试。")
endif
set testFloor1058=testFloor1058+1
endloop
call DisplayTimedTextToPlayer(testHost1058,0,0,12.,"-test11 已创建"+I2S(testCount1058)+"/9个AI，按崩溃对局分配英雄技能；天怒神灭斩已替换为怒意狂击。")
set testHost1058=null
set testPlayer1058=null
endfunction
