function B938CompactReviveQueue takes nothing returns nothing
local integer reviveRead938=1
local integer reviveWrite938=1
local integer reviveOldCount938=NP4
set B938ReviveQueueDirty=false
loop
exitwhen reviveRead938>reviveOldCount938
if NN4[reviveRead938]!=0. then
set NM4[reviveWrite938]=NM4[reviveRead938]
set NN4[reviveWrite938]=NN4[reviveRead938]
set NO4[reviveWrite938]=NO4[reviveRead938]
set reviveWrite938=reviveWrite938+1
endif
set reviveRead938=reviveRead938+1
endloop
set NP4=reviveWrite938-1
loop
exitwhen reviveWrite938>reviveOldCount938
set NM4[reviveWrite938]=null
set NN4[reviveWrite938]=0.
set NO4[reviveWrite938]=false
set reviveWrite938=reviveWrite938+1
endloop
endfunction
function Q18 takes integer i returns nothing
if i<1 or i>NP4 then
return
endif
set NM4[i]=null
set NN4[i]=0.
set NO4[i]=false
set B938ReviveQueueDirty=true
if B938ReviveSweepRunning==false then
call B938CompactReviveQueue()
endif
endfunction
