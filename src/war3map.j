call SaveStr(SUIJI_FIXED_CLONE_TABLE,3,'A2H0',"impale")
// Dragon Slave and Shockwave are independent scripted point skills whose
// normal random carriers both own carrionswarm. Either one can be the native
// skill, so keep a direction-safe alternate for each random side.
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,2,'A01F','YE1E')
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,1,'YE1E','A01F')
