// set BB7=null
// endfunction
function E3D takes nothing returns nothing
local unit ZX7=IN4
call XF7(ZX7,'A2KQ')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2KQ',true)
call NS7(GetHandleId(ZX7),"AI|Magi2Blast",true)
set ZX7=null
endfunction
function HYBH takes unit p5,unit m5,integer skill,boolean b returns nothing
local integer V77
local real d
if skill=='A2KQ' then
set d=250.
else
set V77=GetUnitAbilityLevel(p5,'A04W')+GetUnitAbilityLevel(p5,'A089')+GetUnitAbilityLevel(p5,'A08A')+B287_GetUnitAbilityLevel(p5,'A08D')
set d=55.*V77
endif
call B67(p5,m5,1,d)
call CommonUnitAddStun(m5, 1.5, false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",m5,"chest"))
if b then 
    call LINGXIA(p5,m5)
endif
endfunction
function ELD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
local integer E1D=OM7(OB7,"Iterations")
local integer V77=OM7(OB7,"Level")
local integer E0D=OM7(OB7,"Spell")
if GetTriggerEvalCount(t)>E1D then
call NM7(OB7)
call OZ7(t)
else
call HYBH(p5,m5,E0D,false)
endif
set t=null
set m5=null
set p5=null
return false
endfunction
function E5D takes integer r returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local unit p5=b1060GetTriggerUnit
local unit m5=GetSpellTargetUnit()
local integer E0D=B287_GetSpellAbilityId()
local integer V77=B287_GetUnitAbilityLevel(p5,E0D)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
if r==2 then
call YW7(GetObjectName('n0K7'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,b1060GetTriggerUnit,.03,255,0,0,255)
endif
set r=r-1
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
call NP7(OB7,"Iterations",r)
call NP7(OB7,"Level",V77)
call NP7(OB7,"Spell",E0D)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerAddCondition(t,Condition(function ELD))
set t=null
set m5=null
set p5=null
set b1060GetTriggerUnit=null
endfunction
function E_D takes nothing returns boolean
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local boolean b1060ReturnValue
local integer id=GetPlayerId(b1060GetTriggerPlayer)
local string DAD
local string DBD
local string DCD
local string F4D
local string F7D
local string F7DD
if TI4[id]>0 then
set DAD=GetObjectName('n0JH')+" "+I2S(TI4[id])
set DBD=GetObjectName('n0JM')+" "+I2S(TF4[id]+TG4[id]+TH4[id]+N4[id])+" ("+I2S((TF4[id]+TG4[id]+TH4[id]+N4[id])*100/TI4[id])+"%)"
set DCD=GetObjectName('n0JL')+" "+I2S(TF4[id])+" ("+I2S(100*TF4[id]/TI4[id])+"%)"
set F4D=GetObjectName('n0JK')+" "+I2S(TG4[id])+" ("+I2S(100*TG4[id]/TI4[id])+"%)"
set F7D=GetObjectName('n0JJ')+" "+I2S(TH4[id])+" ("+I2S(100*TH4[id]/TI4[id])+"%)"
set F7DD=GetObjectName('n0JI')+" "+I2S(N4[id])+" ("+I2S(100*N4[id]/TI4[id])+"%)"
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,DAD)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,DBD)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,DCD)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,F4D)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,F7D)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,F7DD)
endif
set b1060ReturnValue=false
set b1060GetTriggerPlayer=null
return b1060ReturnValue
endfunction
function F8D takes nothing returns boolean
return B287_GetSpellAbilityId()=='A08N'
endfunction
function Omniknight_HasScepter takes unit omniknightUnit returns boolean
if omniknightUnit==null then
return false
endif
return SuijiMode_ScepterRegistryIsActive(omniknightUnit,'A08N')
endfunction
function Uu takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')!=1 and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())))!=null
endfunction
function UU takes nothing returns nothing
call B67(GetTriggerUnit(),GetEnumUnit(),3,F8)
endfunction
function F9D takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local boolexpr hP=Condition(function Uu)
local group LQ7=WS7()
local unit ZX7=(b1061SavedGetTriggerUnit)
local unit IH7=(b1061SavedGetSpellTargetUnit)
local real x=GetUnitX(IH7)
local real y=GetUnitY(IH7)
local real d
local real LIFE=GetUnitState(IH7,UNIT_STATE_MAX_LIFE)*.05
if Omniknight_HasScepter(ZX7) then
set LIFE=LIFE*2
endif
set F8=90*B287_GetUnitAbilityLevel(ZX7,'A08N')+LIFE
call GroupEnumUnitsInRange(LQ7,x,y,285,hP)
call ForGroup(LQ7,function UU)
if GetUnitState(IH7,UNIT_STATE_LIFE)>1 then
set d=DGH_BUFF(IH7)
call B907SkillHeal(ZX7,IH7,F8*d)
endif
call WR7(LQ7)
call DestroyBoolExpr(hP)
set LQ7=null
set hP=null
set ZX7=null
set IH7=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
function PN takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function F8D))
call TriggerAddAction(t,function F9D)
set t=null
endfunction
function QNQZ takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A08V')
call XF7(BB7,'A4GO')
call SetUnitAbilityLevel(BB7,'A4GO',level)
call B947IssueTargetOrderById("QNQZ @ war3map.j:81213 (B968)",BB7,$D00DA,IH7)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set ZX7=null
set IH7=null
set BB7=null
endfunction
function ZCQZ2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A08V' then
call QNQZ()
endif
return false
endfunction
function ZCQZ takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZCQZ2))
set t=null
endfunction
function FDD takes nothing returns boolean
if GetUnitTypeId(GetFilterUnit())==K34[21]and GetOwningPlayer(GetFilterUnit())==GetOwningPlayer(GetTriggerUnit())and IsUnitIllusion(GetFilterUnit())==false then
set IN4=GetFilterUnit()
endif
return false
endfunction
function FED takes nothing returns nothing
local unit FFD=GetTriggerUnit()
local unit p5
local group g=WS7()
local real x
local real y
set IN4=null
call GroupEnumUnitsInRange(g,GetUnitX(FFD),GetUnitY(FFD),$3E8,Condition(function FDD))
call WR7(g)
set p5=IN4
if p5!=null then
set x=GetUnitX(p5)
set y=GetUnitY(p5)
call SetUnitPosition(FFD,x,y)
endif
set x=GetUnitX(FFD)+1000*Cos(GetUnitFacing(FFD)*bj_DEGTORAD)
set y=GetUnitY(FFD)+1000*Sin(GetUnitFacing(FFD)*bj_DEGTORAD)
call B947IssuePointOrderById("FED @ war3map.j:81254 (B968)",FFD,$D0012,x,y)
set FFD=null
set p5=null
set g=null
endfunction
function FGD takes nothing returns boolean
if GetUnitAbilityLevel(GetTriggerUnit(),'B03A')>0 then
call FED()
endif
return false
endfunction
function Po takes nothing returns nothing
local trigger t=CreateTrigger()
local region r=CreateRegion()
call RegionAddRect(r,bj_mapInitialPlayableArea)
call TriggerRegisterEnterRegion(t,r,Condition(function TO7))
call TriggerAddCondition(t,Condition(function FGD))
set t=null
set r=null
endfunction
function FHD takes nothing returns boolean
return (IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker())) and not IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE) and UnitHasBuffBJ(GetAttacker(),'B03B') and ISPH(GetAttacker())==false and GetUnitTypeId(GetAttackedUnitBJ())!='n00L')!=null
endfunction
function FID takes nothing returns boolean
if GetUnitAbilityLevel(GetFilterUnit(),'B03B')>0 then
set IH4=IH4+1
endif
return false
endfunction
function FJD takes nothing returns nothing
local unit FKD=GetAttacker()
local group g=WS7()
local boolexpr phantomLancerJuxtaposeCountFilter=null
local integer FMD=GetRandomInt(1,100)
local integer FND=B287_GetUnitAbilityLevel(FKD,'A0DB')
local integer FOD=GetUnitAbilityLevel(FKD,'A0YK')
local unit BB7
local integer FPD=3+2*FND
local integer FQD=35+5*FND
local integer skill
local integer skill_fs
if GetPlayerController(GetOwningPlayer(FKD))==MAP_CONTROL_USER then
set skill='A4AM'
set skill_fs='A4AN'
else
set skill='A0DD'
set skill_fs='A2R7'
endif
set IH4=0
set phantomLancerJuxtaposeCountFilter=Condition(function FID)
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(FKD),phantomLancerJuxtaposeCountFilter)
call DestroyBoolExpr(phantomLancerJuxtaposeCountFilter)
call WR7(g)
if IH4<FPD then
if IsUnitIllusion(FKD)==false and FMD<=FQD then
set BB7=CreateUnit(GetOwningPlayer(FKD),'e00E',GetUnitX(FKD),GetUnitY(FKD),0)
call XF7(BB7,skill)
call B947IssueTargetOrderById("FJD @ war3map.j:81311 (B968)",BB7,$D0132,FKD)
call UnitApplyTimedLife(BB7,'BTLF',1.)
endif
if IsUnitIllusion(FKD) and FMD<=(8+0*FOD) then
set BB7=CreateUnit(GetOwningPlayer(FKD),'e00E',GetUnitX(FKD),GetUnitY(FKD),0)
call XF7(BB7,skill_fs)
call B947IssueTargetOrderById("FJD @ war3map.j:81317 (B968)",BB7,$D0132,FKD)
call UnitApplyTimedLife(BB7,'BTLF',1.)
endif
endif
set FKD=null
set g=null
set BB7=null
set phantomLancerJuxtaposeCountFilter=null
endfunction
function PO takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function FHD))
call TriggerAddAction(t,function FJD)
set t=null
endfunction
function FRD takes nothing returns boolean
local unit FSD=GetSummonedUnit()
local unit oA
local unit m5
if GetUnitAbilityLevel(FSD,'B0IO')>0 or GetUnitAbilityLevel(FSD,'B0IP')>0 then
set oA=GetSummoningUnit()
set m5=O77(GetHandleId(oA),"SpiritTarget")
call SetUnitX(FSD,GetUnitX(m5))
call SetUnitY(FSD,GetUnitY(m5))
call B947IssueTargetOrderById("FRD @ war3map.j:81342 (B968)",FSD,$D000F,m5)
endif
set FSD=null
set oA=null
set m5=null
return false
endfunction
function FTD takes player p,unit m5,integer V77 returns nothing
local unit oA=CreateUnit(p,'e00E',GetUnitX(m5),GetUnitX(m5),0)
local integer skill
call NT7(GetHandleId(oA),"SpiritTarget",m5)
if GetPlayerController(p)==MAP_CONTROL_USER then
if V77==1 then
set skill='A4AQ'
elseif V77==2 then
set skill='A4AP'
elseif V77==3 then
set skill='A4AR'
else
set skill='A4AO'
endif
else
if V77==1 then
set skill='A10H'
elseif V77==2 then
set skill='A10G'
elseif V77==3 then
set skill='A10I'
else
set skill='A10F'
endif
endif
call XF7(oA,skill)
call B947IssueTargetOrderById("FTD @ war3map.j:81375 (B968)",oA,$D0132,M7[GetPlayerId(p)])
set oA=null
endfunction
function PhantomLancerSpiritLance_HasScepter takes unit u returns boolean
if u==null then
return false
endif
return SuijiMode_ScepterRegistryIsActive(u,'A10D')
endfunction
