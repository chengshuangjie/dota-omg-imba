function B945DefinitionMana takes integer b945Skill,integer b945Rank returns integer
if b945Skill==0 or b945Rank<=0 then
return 0
endif
if b945Skill=='A0MP' or b945Skill=='Y05U' then
return 0
endif
return LoadInteger(B945SpellData,b945Skill,b945Rank)
endfunction
function B945SourceItem takes unit b945Caster,integer b945Skill returns item
local integer b945Slot=0
local item b945Candidate=null
if b945Caster==null or GetUnitTypeId(b945Caster)==0 or b945Skill==0 then
return null
endif
loop
exitwhen b945Slot>=6
set b945Candidate=UnitItemInSlot(b945Caster,b945Slot)
if b945Candidate!=null and LoadBoolean(B945SpellData,GetItemTypeId(b945Candidate),b945Skill) then
set b945Candidate=null
return UnitItemInSlot(b945Caster,b945Slot)
endif
set b945Slot=b945Slot+1
endloop
set b945Candidate=null
return null
endfunction
function B287_MHAbility_GetSourceItem takes unit u,integer logicalSkill returns item
return B945SourceItem(u,B287_GetPhysicalAbilityId(u,logicalSkill))
endfunction
function B1111SyncLogAppend takes string syncRow1111 returns nothing
// Final snapshots run after the shared diagnostic timer is already stopped.
if B1111SyncLogPath!="" and GetPlayerController(GetLocalPlayer())==MAP_CONTROL_USER and B1111SyncLogCount<192 then
set B1111SyncLogRows[B1111SyncLogCount]=syncRow1111
set B1111SyncLogCount=B1111SyncLogCount+1
endif
endfunction
function B1120OrderTraceWrite takes nothing returns nothing
local integer traceRow1120=0
if B1120OrderLogPath=="" or GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER then
return
endif
call PreloadGenClear()
call PreloadStart()
call Preload(KK_RELEASE_VERSION+" ORDER diagnostic; state bits: 1=paused 2=native_stun 4=stun_flag 8=polymorph 16=hidden 32=dead")
loop
exitwhen traceRow1120>=B1120OrderRowCount
call Preload(B1120OrderRows[traceRow1120])
set traceRow1120=traceRow1120+1
endloop
call PreloadGenEnd(B1120OrderLogPath)
call PreloadGenClear()
endfunction
function B1120OrderTrace takes unit traceUnit1120,integer traceSkill1120,integer traceOrder1120,string tracePhase1120 returns nothing
local integer tracePid1120=0
local integer traceState1120=0
local integer tracePhysical1120=0
local real traceNow1120=0.
// Opt-in only. No live Ability lookup, gameplay writes, or retained unit handles.
if not B1120OrderLogEnabled or B1120OrderRowCount>=128 or traceUnit1120==null or GetUnitTypeId(traceUnit1120)==0 then
return
endif
set traceNow1120=TimerGetElapsed(W)
if traceNow1120>=B1120OrderLogUntil then
return
endif
set tracePid1120=GetPlayerId(GetOwningPlayer(traceUnit1120))
if tracePid1120<0 or tracePid1120>=12 or B1120TraceCount[tracePid1120]>=96 then
return
endif
if traceNow1120>=B1120TraceWindow[tracePid1120] then
set B1120TraceWindow[tracePid1120]=traceNow1120+1.
set B1120TraceBurst[tracePid1120]=0
endif
if B1120TraceBurst[tracePid1120]>=8 then
return
endif
set B1120TraceBurst[tracePid1120]=B1120TraceBurst[tracePid1120]+1
set B1120TraceCount[tracePid1120]=B1120TraceCount[tracePid1120]+1
if IsUnitPaused(traceUnit1120) then
set traceState1120=traceState1120+1
endif
if IsUnitType(traceUnit1120,UNIT_TYPE_STUNNED) then
set traceState1120=traceState1120+2
endif
if MHUnit_IsFlag2(traceUnit1120,UNIT_FLAG2_STUN) then
set traceState1120=traceState1120+4
endif
if IsUnitType(traceUnit1120,UNIT_TYPE_POLYMORPHED) then
set traceState1120=traceState1120+8
endif
if IsUnitHidden(traceUnit1120) then
set traceState1120=traceState1120+16
endif
if not UnitAlive(traceUnit1120) then
set traceState1120=traceState1120+32
endif
if traceSkill1120!=0 then
set tracePhysical1120=B287_GetPhysicalAbilityId(traceUnit1120,traceSkill1120)
endif
set B1120OrderRows[B1120OrderRowCount]=tracePhase1120+" t="+R2S(traceNow1120)+" p="+I2S(tracePid1120+1)+" u="+I2S(GetHandleId(traceUnit1120))+" type="+I2S(GetUnitTypeId(traceUnit1120))+" logical="+I2S(traceSkill1120)+" physical="+I2S(tracePhysical1120)+" order="+I2S(traceOrder1120)+" current="+I2S(GetUnitCurrentOrder(traceUnit1120))+" state="+I2S(traceState1120)+" pauseCount="+I2S(LoadInteger(ExtraHT,GetHandleId(traceUnit1120),HTKEY_UNIT_PAUSE_COUINT))
set B1120OrderRowCount=B1120OrderRowCount+1
// Flush before the next native order: a zero-delay writer cannot run if it hangs.
call B1120OrderTraceWrite()
endfunction
function B1111SyncLogPassive takes unit syncUnit1111,integer syncLogical1111,integer syncPhysical1111,integer syncResult1111 returns nothing
if not B1111SyncLogEnabled or GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER or B1111SyncLogPassiveCount>=40 then
return
endif
set B1111SyncLogPassiveCount=B1111SyncLogPassiveCount+1
call B1111SyncLogAppend("PASSIVE t="+R2S(TimerGetElapsed(W))+" unit="+I2S(GetHandleId(syncUnit1111))+" type="+I2S(GetUnitTypeId(syncUnit1111))+" logical="+I2S(syncLogical1111)+" physical="+I2S(syncPhysical1111)+" result="+I2S(syncResult1111))
endfunction
function B287_MHAbility_IsPassive takes unit u,integer logicalSkill returns boolean
local integer physicalSkill=0
local boolean syncPassiveResult1111=false
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
if B1111SyncLogEnabled then
call B1111SyncLogPassive(u,logicalSkill,0,-1)
endif
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if physicalSkill==0 or SuijiMode_HasExactLiveAbility(u,physicalSkill)==false then
if B1111SyncLogEnabled then
call B1111SyncLogPassive(u,logicalSkill,physicalSkill,-2)
endif
return false
endif
set syncPassiveResult1111=MHAbility_IsPassive(u,physicalSkill)
if B1111SyncLogEnabled then
call B1111SyncLogPassive(u,logicalSkill,physicalSkill,B287_BoolToInt(syncPassiveResult1111))
endif
return syncPassiveResult1111
endfunction
function B287_MHAbility_GetCastpoint takes unit u,integer logicalSkill returns real
local integer physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
return SuijiMode_GetExactLiveAbilityCastpoint(u,physicalSkill)
endfunction
function B287_MHAbility_SetCastpoint takes unit u,integer logicalSkill,real value returns integer
local integer physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if SuijiMode_SetExactLiveAbilityCastpoint(u,physicalSkill,value) then
return 1
endif
return 0
endfunction
