function UseBS_LR2 takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer id=0
local integer level
local real d
local integer skill=B287_GetSpellAbilityId()
if u==null or GetUnitTypeId(u)==0 then
set u=null
return false
endif
set id=GetUnitTypeId(u)
if (skill=='A093' and id=='U008') or (skill=='X093' and id=='Z008') or (skill=='X193' and id=='Z009') then
set level=B287_GetUnitAbilityLevel(u,skill)
set d=20.
if SuijiMode_ScepterRegistryIsActive(u,skill) then
set d=40.
endif
call YDWESetUnitAbilityDataReal(u,B287_GetPhysicalAbilityId(u,skill),level,ABILITY_DATA_HERODUR,d)
endif
set u=null
return false
endfunction
function UseBS_LR takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function UseBS_LR2))
set t=null
endfunction
// KK Tianxing Twins: the second boss phase starts only after Chaos Observer is
// defeated. Both bosses are fixed non-hero units owned by Player(7), avoiding
// the map's normal hero-revive broker and its one-hero-per-player arrays.
function TianxingTwins_Message takes string text returns nothing
call VV7(bj_FORCE_ALL_PLAYERS,7.,"|cffffcc00[天星双圣]|r "+text)
endfunction
function TianxingTwins_IsAlive takes unit u returns boolean
return u!=null and GetUnitTypeId(u)!=0 and XH7(u)==false
endfunction
function TianxingTwins_ClearRedAura takes nothing returns nothing
if TianxingRedAuraTrigger!=null then
call FlushChildHashtable(L7,GetHandleId(TianxingRedAuraTrigger))
call OZ7(TianxingRedAuraTrigger)
set TianxingRedAuraTrigger=null
endif
endfunction
function TianxingTwins_StopHeartbeat takes nothing returns nothing
if TianxingHeartbeatTimer!=null then
call PauseTimer(TianxingHeartbeatTimer)
call DestroyTimer(TianxingHeartbeatTimer)
set TianxingHeartbeatTimer=null
endif
endfunction
function TianxingTwins_StopReviveTimer takes nothing returns nothing
if TianxingReviveTimer!=null then
call PauseTimer(TianxingReviveTimer)
call DestroyTimer(TianxingReviveTimer)
set TianxingReviveTimer=null
endif
endfunction
function TianxingTwins_AddEquipmentItem takes unit u,integer itemId returns nothing
local item it=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set it=CreateItem(itemId,GetUnitX(u),GetUnitY(u))
call SetItemPlayer(it,GetOwningPlayer(u),false)
if UnitAddItem(u,it)==false then
call RemoveItem(it)
endif
set it=null
endfunction
function TianxingTwins_EnsureSkillHandlers takes nothing returns nothing
if LOADSKILL[36]==0 then
call ExecuteFunc("PN")
call ExecuteFunc("ZCQZ")
set LOADSKILL[36]=1
endif
if LOADSKILL[61]==0 then
call ExecuteFunc("H38")
call ExecuteFunc("H68")
call ExecuteFunc("HL8")
set LOADSKILL[61]=1
endif
if LOADSKILL[87]==0 then
call ExecuteFunc("JW8")
call RegisterUnitAttackEvent("JX8",4)
call ExecuteFunc("JY8")
call ExecuteFunc("JZ8")
set LOADSKILL[87]=1
endif
if LOADSKILL[90]==0 then
call ExecuteFunc("KE8")
call ExecuteFunc("KF8")
call ExecuteFunc("KG8")
call ExecuteFunc("KH8")
call RegisterUnitAttackEvent("ZCJDZC",1)
set LOADSKILL[90]=1
endif
if LOADSKILL[94]==0 then
call ExecuteFunc("MP8")
call ExecuteFunc("ZCEnableThreeSkill")
set LOADSKILL[94]=1
endif
if LOADSKILL[29]==0 then
call ExecuteFunc("OI8")
call ExecuteFunc("OJ8")
call ExecuteFunc("OK8")
call ExecuteFunc("OM8")
set LOADSKILL[29]=1
endif
if LOADSKILL[42]==0 then
// Heart Fire uses the established Huskar spell-effect lifecycle. Initialize
// the complete skill family so a later native Huskar does not lose handlers.
call ExecuteFunc("KS8")
call ExecuteFunc("KT8")
call ExecuteFunc("KU8")
call ExecuteFunc("ZCXY")
set LOADSKILL[42]=1
endif
endfunction
function TianxingTwins_InitRedAura takes unit u returns nothing
local trigger t=null
local integer h=0
call TianxingTwins_ClearRedAura()
if u==null or GetUnitTypeId(u)!='NTY1' then
return
endif
call XF7(u,'A0OL')
call XF7(u,'A0OM')
call XF7(u,'A0ON')
call XF7(u,'A0OH')
set t=CreateTrigger()
set h=GetHandleId(t)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SHD))
call TriggerAddAction(t,function SID)
call NT7(h,"Destroyer",u)
set TianxingRedAuraTrigger=t
set t=null
endfunction
function TianxingTwins_InitRed takes unit u returns nothing
local integer h=0
if u==null or GetUnitTypeId(u)!='NTY1' then
return
endif
set h=GetHandleId(u)
call SetUnitAbilityLevel(u,'BT01',1)
call SetUnitAbilityLevel(u,'BT02',1)
call SetUnitAbilityLevel(u,'BT03',1)
call SetUnitAbilityLevel(u,'BT04',1)
call SetUnitAbilityLevel(u,'BT05',1)
call SetUnitAbilityLevel(u,'BT06',1)
call SetUnitAbilityLevel(u,'BT07',1)
call SetUnitAbilityLevel(u,'BT08',1)
call SetUnitAbilityLevel(u,'BT09',1)
call SetUnitAbilityLevel(u,'BT10',1)
call SetUnitAbilityLevel(u,'TRMC',3)
call SetUnitAbilityLevel(u,'ATBM',4)
call SetUnitAbilityLevel(u,'TRAR',4)
call SetUnitAbilityLevel(u,'A4HK',4)
call NP7(h,"WexLevel",7)
call NP7(h,"QuasLevel",7)
call NP7(h,"ExortLevel",7)
call SetUnitVertexColor(u,255,35,35,255)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
call TianxingTwins_InitRedAura(u)
// Essence Aura's four native hidden bonuses total 350 maximum mana. The unit
// object's 2650 base therefore resolves to the requested exact 3000 in play.
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
endfunction
function TianxingTwins_InitBlack takes unit u returns nothing
if u==null or GetUnitTypeId(u)!='NTY2' then
return
endif
call SetUnitAbilityLevel(u,'TBPU',4)
call SetUnitAbilityLevel(u,'TBRE',4)
call SetUnitAbilityLevel(u,'TBDA',4)
call SetUnitAbilityLevel(u,'TBGA',3)
call SetUnitAbilityLevel(u,'TBSG',4)
call SetUnitAbilityLevel(u,'ATBT',4)
call SetUnitAbilityLevel(u,'ATBO',4)
call SetUnitAbilityLevel(u,'A4HK',4)
call SetUnitVertexColor(u,25,25,25,255)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
set TianxingOverchargeInitUnit=u
call ExecuteFunc("TianxingTwins_InitBlackOvercharge")
set TianxingOverchargeInitUnit=null
endfunction
function TianxingTwins_FindTarget takes unit source,real maxRange returns unit
local integer i=1
local unit hero=null
local unit nearest=null
local real dx=0.
local real dy=0.
local real distance=0.
local real nearestDistance=maxRange*maxRange
if source==null or GetUnitTypeId(source)==0 then
return null
endif
loop
exitwhen i>5
set hero=M7[i]
if hero!=null and GetUnitTypeId(hero)!=0 and GetPlayerId(GetOwningPlayer(hero))==i and XH7(hero)==false and IsUnitIllusion(hero)==false then
set dx=GetUnitX(hero)-GetUnitX(source)
set dy=GetUnitY(hero)-GetUnitY(source)
set distance=dx*dx+dy*dy
if distance<=nearestDistance then
set nearest=hero
set nearestDistance=distance
endif
endif
set i=i+1
endloop
set hero=null
return nearest
endfunction
function TianxingTwins_CanAct takes unit u returns boolean
if TianxingTwins_IsAlive(u)==false then
return false
endif
return IsUnitPaused(u)==false and IsUnitType(u,UNIT_TYPE_STUNNED)==false and IsUnitType(u,UNIT_TYPE_POLYMORPHED)==false
endfunction
function TianxingTwins_AbilityReady takes unit u,integer logicalSkill returns boolean
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return false
endif
return B581_AIAbilityReady(u,B287_GetPhysicalAbilityId(u,logicalSkill))
endfunction
function TianxingTwins_ResetBlackTetherState takes nothing returns nothing
local integer casterHandle=0
local unit oldTarget=null
local trigger controller=null
if TianxingBlackBoss==null or GetUnitTypeId(TianxingBlackBoss)==0 then
return
endif
set casterHandle=GetHandleId(TianxingBlackBoss)
set controller=LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherController"))
// A live controller owns its lightning, group and helper state.  Never repair
// across it; this path is only for a boss-specific orphaned command card.
if controller!=null then
set controller=null
return
endif
// Set the guard before the player-availability native.  Warcraft may terminate
// that call's thread, and the heartbeat must not retry it every engine tick.
set TianxingBlackTetherRepairCooldown=1.
set oldTarget=LoadUnitHandle(L7,casterHandle,652)
if oldTarget!=null and GetUnitTypeId(oldTarget)!=0 and O77(GetHandleId(oldTarget),"AI|TetherSource")==TianxingBlackBoss then
call UnitRemoveAbility(oldTarget,'A1TH')
call UnitRemoveAbility(oldTarget,'A1TI')
call UnitRemoveAbility(oldTarget,'A1TG')
call UnitRemoveAbility(oldTarget,'A1TJ')
call UnitRemoveAbility(oldTarget,'B0DH')
call UnitRemoveAbility(oldTarget,'A4G1')
call RemoveSavedHandle(L7,GetHandleId(oldTarget),StringHash("AI|TetherSource"))
endif
call UnitRemoveAbility(TianxingBlackBoss,'A1TH')
call UnitRemoveAbility(TianxingBlackBoss,'A1TI')
call UnitRemoveAbility(TianxingBlackBoss,'A1TG')
call UnitRemoveAbility(TianxingBlackBoss,'A1TJ')
call UnitRemoveAbility(TianxingBlackBoss,'B0DH')
call UnitRemoveAbility(TianxingBlackBoss,'A1TU')
call RemoveSavedHandle(L7,casterHandle,652)
call RemoveSavedBoolean(L7,casterHandle,StringHash("SuijiTetherActive"))
call RemoveSavedBoolean(L7,casterHandle,StringHash("B289StateReplaceBase")+'A1TA')
call SaveInteger(L7,casterHandle,4295,2)
call B287_SetTetherAbilityAvailable(TianxingBlackBoss,GetOwningPlayer(TianxingBlackBoss),true)
set oldTarget=null
set controller=null
endfunction
function TianxingTwins_BlackTetherIsActive takes nothing returns boolean
local integer casterHandle=0
local trigger controller=null
local boolean active=false
local boolean replaced=false
local boolean staleTarget=false
if TianxingBlackBoss==null or GetUnitTypeId(TianxingBlackBoss)==0 then
return false
endif
set casterHandle=GetHandleId(TianxingBlackBoss)
set controller=LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherController"))
if controller!=null then
set controller=null
return true
endif
set active=LoadBoolean(L7,casterHandle,StringHash("SuijiTetherActive"))
set replaced=LoadBoolean(L7,casterHandle,StringHash("B289StateReplaceBase")+'A1TA')
set staleTarget=LoadUnitHandle(L7,casterHandle,652)!=null
if TianxingBlackTetherRepairCooldown<=0. and (active or replaced or staleTarget or GetUnitAbilityLevel(TianxingBlackBoss,'A1TU')>0) then
call TianxingTwins_ResetBlackTetherState()
endif
set controller=null
return false
endfunction
function TianxingTwins_RedTryCast takes unit target returns boolean
local integer attempts=0
local integer slot=0
local integer skill=0
local real dx=0.
local real dy=0.
local real distance=0.
local boolean issued=false
if TianxingTwins_CanAct(TianxingRedBoss)==false or target==null or XH7(target) then
return false
endif
if GetUnitAbilityLevel(TianxingRedBoss,'BNms')>0 and GetUnitState(TianxingRedBoss,UNIT_STATE_MANA)<100. then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120049 (B968)",TianxingRedBoss,852590)
elseif GetUnitAbilityLevel(TianxingRedBoss,'BNms')==0 and GetUnitState(TianxingRedBoss,UNIT_STATE_MANA)>300. and TianxingTwins_AbilityReady(TianxingRedBoss,'A0MP') then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120051 (B968)",TianxingRedBoss,852589)
endif
if issued then
set TianxingRedCastDelay=.6
return true
endif
set dx=GetUnitX(target)-GetUnitX(TianxingRedBoss)
set dy=GetUnitY(target)-GetUnitY(TianxingRedBoss)
set distance=SquareRoot(dx*dx+dy*dy)
loop
exitwhen attempts>=11 or issued
set TianxingRedSkillCursor=TianxingRedSkillCursor+1
if TianxingRedSkillCursor>11 then
set TianxingRedSkillCursor=1
endif
set slot=TianxingRedSkillCursor
if slot==1 then
set skill='A0VZ'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueTargetOrderById("TianxingTwins_RedTryCast @ war3map.j:120070 (B968)",TianxingRedBoss,852505,target)
endif
elseif slot==2 then
set skill='A0VK'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssuePointOrderById("TianxingTwins_RedTryCast @ war3map.j:120075 (B968)",TianxingRedBoss,852491,GetUnitX(target),GetUnitY(target))
endif
elseif slot==3 then
set skill='A0VN'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssuePointOrderById("TianxingTwins_RedTryCast @ war3map.j:120080 (B968)",TianxingRedBoss,852216,GetUnitX(target),GetUnitY(target))
endif
elseif slot==4 then
set skill='A0VM'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssuePointOrderById("TianxingTwins_RedTryCast @ war3map.j:120085 (B968)",TianxingRedBoss,852215,GetUnitX(target),GetUnitY(target))
endif
elseif slot==5 then
set skill='A0VS'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssuePointOrderById("TianxingTwins_RedTryCast @ war3map.j:120090 (B968)",TianxingRedBoss,852217,GetUnitX(target),GetUnitY(target))
endif
elseif slot==6 then
set skill='A0VQ'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueTargetOrderById("TianxingTwins_RedTryCast @ war3map.j:120095 (B968)",TianxingRedBoss,852490,TianxingRedBoss)
endif
elseif slot==7 then
set skill='A0VO'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120100 (B968)",TianxingRedBoss,852132)
endif
elseif slot==8 then
set skill='A0VP'
if distance<=450. and TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120105 (B968)",TianxingRedBoss,852134)
endif
elseif slot==9 then
set skill='A0VG'
if TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssuePointOrderById("TianxingTwins_RedTryCast @ war3map.j:120110 (B968)",TianxingRedBoss,852089,GetUnitX(target),GetUnitY(target))
endif
elseif slot==10 then
set skill='A0XL'
if GetUnitLifePercent(TianxingRedBoss)<50. and TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120115 (B968)",TianxingRedBoss,852129)
endif
else
set skill='A4HK'
if distance<=500. and TianxingTwins_AbilityReady(TianxingRedBoss,skill) then
set issued=B947IssueImmediateOrderById("TianxingTwins_RedTryCast @ war3map.j:120120 (B968)",TianxingRedBoss,OrderId("dispel"))
endif
endif
set attempts=attempts+1
endloop
if issued then
// Reserve the cast window for the native Multicast repeat controller.
set TianxingRedCastDelay=1.6
endif
return issued
endfunction
function TianxingTwins_BlackTryTether takes nothing returns boolean
local boolean issued=false
if TianxingTwins_CanAct(TianxingBlackBoss)==false or TianxingTwins_IsAlive(TianxingRedBoss)==false then
return false
endif
if TianxingTwins_BlackTetherIsActive() then
return false
endif
if GetUnitState(TianxingBlackBoss,UNIT_STATE_MANA)>=40. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A1TA') then
set issued=B947IssueTargetOrderById("TianxingTwins_BlackTryTether @ war3map.j:120140 (B968)",TianxingBlackBoss,852119,TianxingRedBoss)
if issued then
set TianxingBlackCastDelay=.8
return true
elseif LoadTriggerHandle(L7,GetHandleId(TianxingBlackBoss),StringHash("SuijiTetherController"))==null and TianxingBlackTetherRepairCooldown<=0. then
// A ready physical carrier with a rejected order is the observable signature
// of the orphaned player-level button state. Repair once, then retry shortly.
call TianxingTwins_ResetBlackTetherState()
set TianxingBlackCastDelay=.5
return true
endif
endif
return false
endfunction
function TianxingTwins_BlackTryCast takes unit enemy returns boolean
local real redLife=100.
local real blackLife=GetUnitLifePercent(TianxingBlackBoss)
local real enemyDistance=99999.
local boolean issued=false
if TianxingTwins_CanAct(TianxingBlackBoss)==false then
return false
endif
// Red is the designated support target. Use a fixed high-priority queue so a
// lower-health Black cannot consume every heal that the encounter assigned to
// Red. Target orders keep a two-second ownership window so walking into cast
// range is not cancelled by the next heartbeat attack order.
if TianxingTwins_IsAlive(TianxingRedBoss) then
set redLife=GetUnitLifePercent(TianxingRedBoss)
// Shallow Grave and Repel are owned by the direct Red-damage support queue;
// do not let the ordinary rotation cast them outside the requested thresholds.
if redLife<=98. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A08N') then
set issued=B947IssueTargetOrderById("TianxingTwins_BlackTryCast @ war3map.j:120171 (B968)",TianxingBlackBoss,852225,TianxingRedBoss)
endif
if issued==false and redLife<=85. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A0ER') then
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackTryCast @ war3map.j:120174 (B968)",TianxingBlackBoss,852599)
endif
endif
if issued==false and blackLife<=90. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A08N') then
set issued=B947IssueTargetOrderById("TianxingTwins_BlackTryCast @ war3map.j:120178 (B968)",TianxingBlackBoss,852225,TianxingBlackBoss)
elseif issued==false and blackLife<=80. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A0ER') then
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackTryCast @ war3map.j:120180 (B968)",TianxingBlackBoss,852599)
endif
if issued then
set TianxingBlackCastDelay=2.
return true
endif
if enemy!=null then
set enemyDistance=KE7(TianxingBlackBoss,enemy)
endif
if GetUnitAbilityLevel(TianxingBlackBoss,'B08A')>0 then
if enemy==null or GetUnitLifePercent(TianxingBlackBoss)<30. or GetUnitManaPercent(TianxingBlackBoss)<15. then
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackTryCast @ war3map.j:120191 (B968)",TianxingBlackBoss,852590)
endif
elseif enemy!=null and enemyDistance<=1600. and LoadTriggerHandle(L7,GetHandleId(TianxingBlackBoss),StringHash("SuijiTetherController"))!=null and GetUnitLifePercent(TianxingBlackBoss)>55. and GetUnitManaPercent(TianxingBlackBoss)>30. and TianxingTwins_AbilityReady(TianxingBlackBoss,'A28Q') then
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackTryCast @ war3map.j:120194 (B968)",TianxingBlackBoss,852589)
endif
if issued then
set TianxingBlackCastDelay=.6
endif
return issued
endfunction
function TianxingTwins_HasNegativeState takes unit u,boolean includeSilence returns boolean
local boolean negative=false
if TianxingTwins_IsAlive(u)==false then
return false
endif
set negative=UnitCountBuffsExBJ(bj_BUFF_POLARITY_NEGATIVE,bj_BUFF_RESIST_EITHER,u,false,false)>0 or IsUnitPaused(u) or IsUnitType(u,UNIT_TYPE_STUNNED) or IsUnitType(u,UNIT_TYPE_POLYMORPHED)
if includeSilence and negative==false then
set negative=MHUnit_GetSilenceCount(u)>0
endif
return negative
endfunction
function TianxingTwins_ClearBlackControl takes nothing returns nothing
local integer count=0
if TianxingTwins_IsAlive(TianxingBlackBoss)==false then
return
endif
call UnitRemoveBuffs(TianxingBlackBoss,false,true)
call FixUnitSilence(TianxingBlackBoss)
set count=MHUnit_GetStunCount(TianxingBlackBoss)
if count>0 then
loop
exitwhen count<=0
call MHUnit_Stun(TianxingBlackBoss,false)
set count=count-1
endloop
elseif count<0 then
loop
exitwhen count>=0
call MHUnit_Stun(TianxingBlackBoss,true)
set count=count+1
endloop
endif
if IsUnitPaused(TianxingBlackBoss) or IsUnitType(TianxingBlackBoss,UNIT_TYPE_STUNNED) then
call FixUnitPause(TianxingBlackBoss,Player(0))
call EXPauseUnit(TianxingBlackBoss,false)
call FixUnitMove(TianxingBlackBoss)
endif
endfunction
function TianxingTwins_BlackTryDirectSupport takes boolean includeSilence returns boolean
local real redLife=100.
local item it=null
local boolean negative=false
local boolean tetherActive=false
local boolean issued=false
if TianxingTwins_CanAct(TianxingBlackBoss)==false or TianxingTwins_IsAlive(TianxingRedBoss)==false then
return false
endif
set redLife=GetUnitLifePercent(TianxingRedBoss)
set negative=TianxingTwins_HasNegativeState(TianxingRedBoss,includeSilence)
set tetherActive=TianxingTwins_BlackTetherIsActive()
// Direct defensive orders are ranked so repeated damage cannot restart the
// same approach/cast every event, while a new lethal threshold can still
// preempt a lower-priority tether or dispel order.
if redLife<15. and GetUnitAbilityLevel(TianxingRedBoss,'A21I')==0 and TianxingTwins_AbilityReady(TianxingBlackBoss,'A10L') and (TianxingBlackDirectOrderLock<=0. or TianxingBlackDirectOrderPriority<4) then
set issued=B947IssueTargetOrder("TianxingTwins_BlackTryDirectSupport @ war3map.j:120255 (B968)",TianxingBlackBoss,"devourmagic",TianxingRedBoss)
if issued then
set TianxingBlackDirectOrderPriority=4
set TianxingBlackDirectOrderLock=2.
set TianxingBlackCastDelay=2.
endif
endif
if issued==false and redLife<30. and CHUIFENG(TianxingRedBoss)==false and (TianxingBlackDirectOrderLock<=0. or TianxingBlackDirectOrderPriority<3) then
set it=MV7(TianxingBlackBoss,'I0X3')
if it!=null then
set issued=UnitUseItemTarget(TianxingBlackBoss,it,TianxingRedBoss)
endif
if issued then
set TianxingBlackDirectOrderPriority=3
set TianxingBlackDirectOrderLock=2.
set TianxingBlackCastDelay=2.
endif
endif
set it=null
if issued==false and negative and CHUIFENG(TianxingRedBoss)==false and (TianxingBlackDirectOrderLock<=0. or TianxingBlackDirectOrderPriority<2) then
if TianxingTwins_AbilityReady(TianxingBlackBoss,'A08V') then
set issued=B947IssueTargetOrderById("TianxingTwins_BlackTryDirectSupport @ war3map.j:120276 (B968)",TianxingBlackBoss,852186,TianxingRedBoss)
endif
if issued==false then
set it=MV7(TianxingBlackBoss,'I0XJ')
if it!=null then
set issued=UnitUseItemTarget(TianxingBlackBoss,it,TianxingRedBoss)
endif
endif
if issued then
set TianxingBlackDirectOrderPriority=2
set TianxingBlackDirectOrderLock=2.
set TianxingBlackCastDelay=2.
endif
endif
set it=null
if issued==false and tetherActive==false and (TianxingBlackDirectOrderLock<=0. or TianxingBlackDirectOrderPriority<1) then
set issued=TianxingTwins_BlackTryTether()
if issued then
set TianxingBlackOverchargePending=true
set TianxingBlackDirectOrderPriority=1
set TianxingBlackDirectOrderLock=.8
endif
endif
if issued==false and tetherActive and TianxingBlackOverchargePending then
if GetUnitAbilityLevel(TianxingBlackBoss,'B08A')>0 then
set TianxingBlackOverchargePending=false
elseif TianxingTwins_AbilityReady(TianxingBlackBoss,'A28Q') and (TianxingBlackDirectOrderLock<=0. or TianxingBlackDirectOrderPriority<1) then
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackTryDirectSupport @ war3map.j:120303 (B968)",TianxingBlackBoss,852589)
if issued then
set TianxingBlackOverchargePending=false
set TianxingBlackDirectOrderPriority=1
set TianxingBlackDirectOrderLock=.6
set TianxingBlackCastDelay=.6
endif
endif
endif
return issued
endfunction
function TianxingTwins_OnRedDamaged takes nothing returns nothing
local unit source=GetEventDamageSource()
if TianxingActive and GetTriggerUnit()==TianxingRedBoss and GetEventDamage()>0. and source!=null and source!=TianxingRedBoss and IsUnitEnemy(source,GetOwningPlayer(TianxingRedBoss)) then
// The damage event uses only deterministic buff/unit state. The existing
// heartbeat remains the sole bounded silence-counter reader.
call TianxingTwins_BlackTryDirectSupport(false)
endif
set source=null
endfunction
function TianxingTwins_Heartbeat takes nothing returns nothing
local unit redTarget=null
local unit blackTarget=null
local boolean issued=false
if TianxingActive==false then
return
endif
if TianxingRedProtection>0. then
set TianxingRedProtection=TianxingRedProtection-.25
if TianxingRedProtection<=0. and TianxingTwins_IsAlive(TianxingRedBoss) then
call SetUnitInvulnerable(TianxingRedBoss,false)
endif
endif
if TianxingBlackProtection>0. then
set TianxingBlackProtection=TianxingBlackProtection-.25
if TianxingBlackProtection<=0. and TianxingTwins_IsAlive(TianxingBlackBoss) then
call SetUnitInvulnerable(TianxingBlackBoss,false)
endif
endif
if TianxingRedCastDelay>0. then
set TianxingRedCastDelay=TianxingRedCastDelay-.25
endif
if TianxingBlackCastDelay>0. then
set TianxingBlackCastDelay=TianxingBlackCastDelay-.25
endif
if TianxingBlackTetherRepairCooldown>0. then
set TianxingBlackTetherRepairCooldown=TianxingBlackTetherRepairCooldown-.25
endif
if TianxingBlackDirectOrderLock>0. then
set TianxingBlackDirectOrderLock=TianxingBlackDirectOrderLock-.25
if TianxingBlackDirectOrderLock<=0. then
set TianxingBlackDirectOrderPriority=0
endif
endif
if TianxingRedAttackDelay>0. then
set TianxingRedAttackDelay=TianxingRedAttackDelay-.25
endif
if TianxingBlackAttackDelay>0. then
set TianxingBlackAttackDelay=TianxingBlackAttackDelay-.25
endif
if TianxingTwins_IsAlive(TianxingRedBoss) then
set redTarget=TianxingTwins_FindTarget(TianxingRedBoss,9999.)
set issued=false
if TianxingRedCastDelay<=0. and redTarget!=null then
set issued=TianxingTwins_RedTryCast(redTarget)
endif
if issued==false and redTarget!=null and TianxingRedAttackDelay<=0. then
call B947IssueTargetOrder("TianxingTwins_Heartbeat @ war3map.j:120370 (B968)",TianxingRedBoss,"attack",redTarget)
set TianxingRedAttackDelay=1.
endif
endif
if TianxingTwins_IsAlive(TianxingBlackBoss) then
call TianxingTwins_ClearBlackControl()
set blackTarget=TianxingTwins_FindTarget(TianxingBlackBoss,9999.)
set issued=false
if TianxingBlackCastDelay<=0. then
// Direct Red protection owns the command first: lethal thresholds, negative
// state, then tether/overcharge. Ordinary Omniknight casting follows only
// when no direct order was issued.
set issued=TianxingTwins_BlackTryDirectSupport(true)
if issued==false then
set issued=TianxingTwins_BlackTryCast(blackTarget)
endif
endif
if issued==false and blackTarget!=null and TianxingBlackAttackDelay<=0. and TianxingBlackCastDelay<=0. then
call B947IssueTargetOrder("TianxingTwins_Heartbeat @ war3map.j:120388 (B968)",TianxingBlackBoss,"attack",blackTarget)
set TianxingBlackAttackDelay=1.
endif
endif
set redTarget=null
set blackTarget=null
endfunction
function TianxingTwins_CreateRed takes real x,real y returns nothing
set TianxingRedBoss=CreateUnit(Player(7),'NTY1',x,y,270.)
call SetHeroLevel(TianxingRedBoss,30,false)
call TianxingTwins_InitRed(TianxingRedBoss)
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I0SD')
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I0WJ')
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I0TE')
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I0AL')
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I00Z')
call TianxingTwins_AddEquipmentItem(TianxingRedBoss,'I0Y7')
call SetUnitInvulnerable(TianxingRedBoss,true)
call TriggerRegisterUnitEvent(TianxingDeathTrigger,TianxingRedBoss,EVENT_UNIT_DEATH)
call B1023RegisterDamage(TianxingRedDamageTrigger,TianxingRedBoss)
endfunction
function TianxingTwins_CreateBlack takes real x,real y returns nothing
set TianxingBlackBoss=CreateUnit(Player(8),'NTY2',x,y,270.)
call SetHeroLevel(TianxingBlackBoss,30,false)
call TianxingTwins_InitBlack(TianxingBlackBoss)
call TianxingTwins_AddEquipmentItem(TianxingBlackBoss,'I0X3')
call TianxingTwins_AddEquipmentItem(TianxingBlackBoss,'I0XJ')
call TianxingTwins_AddEquipmentItem(TianxingBlackBoss,'I0A9')
call TianxingTwins_AddEquipmentItem(TianxingBlackBoss,'I0BK')
call TianxingTwins_AddEquipmentItem(TianxingBlackBoss,'I09Z')
call SetUnitInvulnerable(TianxingBlackBoss,true)
call TriggerRegisterUnitEvent(TianxingDeathTrigger,TianxingBlackBoss,EVENT_UNIT_DEATH)
endfunction
function TianxingTwins_CleanupExpired takes nothing returns nothing
local timer t=GetExpiredTimer()
set TianxingCleanupTimer=null
if TianxingRedBoss!=null then
call RemoveUnit(TianxingRedBoss)
set TianxingRedBoss=null
endif
if TianxingBlackBoss!=null then
call RemoveUnit(TianxingBlackBoss)
set TianxingBlackBoss=null
endif
if TianxingDeathTrigger!=null then
call OZ7(TianxingDeathTrigger)
set TianxingDeathTrigger=null
endif
if TianxingKillTrigger!=null then
call OZ7(TianxingKillTrigger)
set TianxingKillTrigger=null
endif
if TianxingRedDamageTrigger!=null then
call OZ7(TianxingRedDamageTrigger)
set TianxingRedDamageTrigger=null
endif
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function TianxingTwins_Finalize takes nothing returns nothing
if TianxingDefeated then
return
endif
set TianxingDefeated=true
set TianxingActive=false
set TianxingPendingRevive=false
call TianxingTwins_ClearRedAura()
call TianxingTwins_StopHeartbeat()
call TianxingTwins_StopReviveTimer()
call TianxingTwins_Message("赤曜与玄曜已在10秒内同时被击杀，天星双圣彻底陨落。")
call KKTianxingBlessing_SaveAll()
call ExecuteFunc("B836ArcUnlock")
if TianxingCleanupTimer!=null then
call PauseTimer(TianxingCleanupTimer)
call DestroyTimer(TianxingCleanupTimer)
endif
set TianxingCleanupTimer=CreateTimer()
call TimerStart(TianxingCleanupTimer,.5,false,function TianxingTwins_CleanupExpired)
endfunction
function TianxingTwins_ReviveExpired takes nothing returns nothing
local timer t=GetExpiredTimer()
local boolean revived=false
set TianxingReviveTimer=null
if TianxingActive and TianxingPendingRevive then
if TianxingFirstDeathRed then
if TianxingTwins_IsAlive(TianxingBlackBoss) then
set revived=ReviveHero(TianxingRedBoss,TianxingDeadX,TianxingDeadY,true)
if revived then
call TianxingTwins_InitRed(TianxingRedBoss)
call SetUnitInvulnerable(TianxingRedBoss,true)
set TianxingRedProtection=1.5
set TianxingRedCastDelay=.5
set TianxingRedAttackDelay=0.
call TianxingTwins_Message("玄曜未在10秒内被击杀，赤曜已经复活。")
endif
else
call TianxingTwins_Finalize()
endif
else
if TianxingTwins_IsAlive(TianxingRedBoss) then
set revived=ReviveHero(TianxingBlackBoss,TianxingDeadX,TianxingDeadY,true)
if revived then
call TianxingTwins_InitBlack(TianxingBlackBoss)
call TianxingTwins_ClearBlackControl()
call SetUnitInvulnerable(TianxingBlackBoss,true)
set TianxingBlackProtection=1.5
set TianxingBlackCastDelay=.5
set TianxingBlackAttackDelay=0.
call TianxingTwins_Message("赤曜未在10秒内被击杀，玄曜已经复活。")
endif
else
call TianxingTwins_Finalize()
endif
endif
endif
if revived then
set TianxingPendingRevive=false
endif
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function TianxingTwins_CataclysmExpire takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer id=GetHandleId(t)
local unit source=O77(id,"Hero")
local real damage=ON7(id,"Damage")
local real x=ON7(id,"x")
local real y=ON7(id,"y")
local group g=WS7()
local integer count
local unit cataclysmVictim1026=null
if source!=null and GetUnitTypeId(source)!=0 then
set IN4=source
call GroupEnumUnitsInRange(g,x,y,$E1,Condition(function AJ7_gai))
endif
set count=CountUnitsInGroup(g)
if count<1 then
set count=1
endif
// E49/D_9 and other nested damage handlers can overwrite IN4 and IJ4.
set damage=damage/count
loop
set cataclysmVictim1026=FirstOfGroup(g)
exitwhen cataclysmVictim1026==null or source==null or GetUnitTypeId(source)==0
call GroupRemoveUnit(g,cataclysmVictim1026)
if GetUnitTypeId(cataclysmVictim1026)!=0 and UnitAlive(cataclysmVictim1026) then
call B67(source,cataclysmVictim1026,7,damage)
endif
endloop
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
call WR7(g)
call DestroyEffect(OG7(id,"Effect"))
call NM7(id)
call OZ7(t)
set t=null
set source=null
set g=null
set cataclysmVictim1026=null
return false
endfunction
function TianxingTwins_CreateCataclysmStrike takes unit source,real x,real y returns nothing
local trigger t
local integer id
if source==null or GetUnitTypeId(source)==0 then
return
endif
set t=CreateTrigger()
set id=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1.7,false)
call TriggerAddCondition(t,Condition(function TianxingTwins_CataclysmExpire))
call NT7(id,"Hero",source)
call NQ7(id,"x",x)
call NQ7(id,"y",y)
call NQ7(id,"Damage",500.)
call NU7(id,"Effect",AddSpecialEffect("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",x,y))
set t=null
endfunction
function TianxingTwins_BlackDeathCataclysm takes nothing returns nothing
local integer i=1
local unit target=null
local unit source=null
local real a=0.
local real x=0.
local real y=0.
local real r=100.
if TianxingActive==false or TianxingBlackBoss==null or GetUnitTypeId(TianxingBlackBoss)==0 then
return
endif
// A short-lived existing dummy remains valid through the 1.7-second delayed
// Sun Strike controller even when this is the twins' final death and both hero
// handles are removed by encounter cleanup.
set source=CreateUnit(Player(8),'e00E',GetUnitX(TianxingBlackBoss),GetUnitY(TianxingBlackBoss),0.)
if source==null then
return
endif
call UnitApplyTimedLife(source,'BTLF',3.)
loop
exitwhen i>5
set target=M7[i]
if target!=null and GetUnitTypeId(target)!=0 and GetPlayerId(GetOwningPlayer(target))==i and XH7(target)==false and IsUnitIllusion(target)==false and IsUnitEnemy(target,Player(8)) then
set a=GetRandomReal(0.,360.)
set x=GetUnitX(target)+r*Cos(a*bj_DEGTORAD)
set y=GetUnitY(target)+r*Sin(a*bj_DEGTORAD)
call TianxingTwins_CreateCataclysmStrike(source,x,y)
set a=a+180.
set x=GetUnitX(target)+r*Cos(a*bj_DEGTORAD)
set y=GetUnitY(target)+r*Sin(a*bj_DEGTORAD)
call TianxingTwins_CreateCataclysmStrike(source,x,y)
endif
set i=i+1
endloop
set target=null
set source=null
endfunction
function TianxingTwins_BlackCastHeartFire takes nothing returns nothing
local boolean issued=false
if TianxingTwins_IsAlive(TianxingBlackBoss)==false or GetUnitAbilityLevel(TianxingBlackBoss,'A4HK')<=0 then
return
endif
// Heart Fire costs 130 mana at level four. Guarantee only the cast threshold;
// do not refill the rest of Black's mana pool.
if GetUnitState(TianxingBlackBoss,UNIT_STATE_MANA)<130. then
call SetUnitState(TianxingBlackBoss,UNIT_STATE_MANA,130.)
endif
// A4HK is an isolated Channel carrier whose authoritative DataF order is
// "dispel".  Do not use the legacy generic immediate order 852526 here.
set issued=B947IssueImmediateOrderById("TianxingTwins_BlackCastHeartFire @ war3map.j:120607 (B968)",TianxingBlackBoss,OrderId("dispel"))
if issued then
set TianxingBlackCastDelay=1.5
set TianxingBlackDirectOrderLock=1.5
set TianxingBlackDirectOrderPriority=5
endif
endfunction
function TianxingTwins_OnDeath takes nothing returns nothing
local unit dying=GetDyingUnit()
local boolean isRed=dying==TianxingRedBoss
if TianxingActive==false or (isRed==false and dying!=TianxingBlackBoss) then
set dying=null
return
endif
if isRed then
call TianxingTwins_ClearRedAura()
call TianxingTwins_BlackCastHeartFire()
else
call TianxingTwins_BlackDeathCataclysm()
endif
if TianxingPendingRevive==false then
set TianxingPendingRevive=true
set TianxingFirstDeathRed=isRed
set TianxingDeadX=GetUnitX(dying)
set TianxingDeadY=GetUnitY(dying)
call TianxingTwins_StopReviveTimer()
set TianxingReviveTimer=CreateTimer()
call TimerStart(TianxingReviveTimer,10.,false,function TianxingTwins_ReviveExpired)
if isRed then
call TianxingTwins_Message("赤曜陨落！必须在10秒内击杀玄曜，否则赤曜会复活。")
else
call TianxingTwins_Message("玄曜陨落！必须在10秒内击杀赤曜，否则玄曜会复活。")
endif
elseif (TianxingFirstDeathRed and dying==TianxingBlackBoss) or (TianxingFirstDeathRed==false and dying==TianxingRedBoss) then
call TianxingTwins_Finalize()
endif
set dying=null
endfunction
function TianxingTwins_OnHeroKill takes nothing returns nothing
local unit dying=GetDyingUnit()
local unit killer=GetKillingUnit()
local integer pid=0
local real healed=0.
if TianxingActive and (killer==TianxingRedBoss or killer==TianxingBlackBoss) and dying!=null and IsUnitIllusion(dying)==false then
set pid=GetPlayerId(GetOwningPlayer(dying))
if pid>=1 and pid<=5 and M7[pid]==dying then
set healed=GetUnitState(killer,UNIT_STATE_MAX_LIFE)*.25
call SetWidgetLife(killer,RMinBJ(GetUnitState(killer,UNIT_STATE_MAX_LIFE),GetWidgetLife(killer)+healed))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",killer,"origin"))
call TianxingTwins_Message(GetUnitName(killer)+"击杀英雄，恢复25%最大生命。")
endif
endif
set dying=null
set killer=null
endfunction
function TianxingTwins_Spawn takes real x,real y returns nothing
if TianxingSpawned then
return
endif
set TianxingSpawned=true
set TianxingActive=true
set TianxingDefeated=false
set TianxingPendingRevive=false
set TianxingRedSkillCursor=0
set TianxingBlackSkillCursor=0
set TianxingRedProtection=3.
set TianxingBlackProtection=3.
set TianxingRedCastDelay=.75
set TianxingBlackCastDelay=.75
set TianxingBlackTetherRepairCooldown=0.
set TianxingBlackDirectOrderLock=0.
set TianxingBlackDirectOrderPriority=0
set TianxingBlackOverchargePending=false
set TianxingRedAttackDelay=0.
set TianxingBlackAttackDelay=0.
call TianxingTwins_EnsureSkillHandlers()
set TianxingDeathTrigger=CreateTrigger()
call TriggerAddAction(TianxingDeathTrigger,function TianxingTwins_OnDeath)
set TianxingRedDamageTrigger=CreateTrigger()
call TriggerAddAction(TianxingRedDamageTrigger,function TianxingTwins_OnRedDamaged)
call TianxingTwins_CreateRed(x-160.,y)
call TianxingTwins_CreateBlack(x+160.,y)
set TianxingKillTrigger=CreateTrigger()
call YB7(TianxingKillTrigger,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(TianxingKillTrigger,function TianxingTwins_OnHeroKill)
set TianxingHeartbeatTimer=CreateTimer()
call TimerStart(TianxingHeartbeatTimer,.25,true,function TianxingTwins_Heartbeat)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x-160.,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x+160.,y))
call TianxingTwins_Message("混沌观测者陨落，天星双圣降临！赤曜与玄曜均拥有100000生命，并获得3秒出场保护；必须在10秒内先后击杀两者。")
endfunction
// KK Chaos Observer: all encounter events and the only periodic timer are
// created after the visible Scourge fountain dies. Nothing below is active at
// map initialization.
function ChaosObserver_Message takes string text returns nothing
call VV7(bj_FORCE_ALL_PLAYERS,6.,"|cffffcc00[混沌观测者]|r "+text)
endfunction
function ChaosObserver_IsDalaranHero takes unit u returns boolean
local integer id=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set id=GetPlayerId(GetOwningPlayer(u))
return id>=1 and id<=5 and M7[id]==u
endfunction
function ChaosObserver_CountPlayers takes nothing returns integer
local integer i=1
local integer count=0
loop
exitwhen i>5
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER and M7[i]!=null and GetUnitTypeId(M7[i])!=0 then
set count=count+1
endif
set i=i+1
endloop
if count<1 then
set count=1
elseif count>5 then
set count=5
endif
return count
endfunction
function ChaosObserver_ResetBuckets takes nothing returns nothing
local integer i=0
loop
exitwhen i>=40
set ChaosObserverPhysicalBucket[i]=0.
set ChaosObserverMagicBucket[i]=0.
set ChaosObserverPureBucket[i]=0.
set i=i+1
endloop
set ChaosObserverBucketIndex=0
set ChaosObserverPhysicalTotal=0.
set ChaosObserverMagicTotal=0.
set ChaosObserverPureTotal=0.
endfunction
function ChaosObserver_GetSpellBurst takes nothing returns real
local integer i=0
local integer index=ChaosObserverBucketIndex
local real total=0.
loop
exitwhen i>=8
set total=total+ChaosObserverMagicBucket[index]+ChaosObserverPureBucket[index]
set index=index-1
if index<0 then
set index=39
endif
set i=i+1
endloop
return total
endfunction
function ChaosObserver_ClearAdaptEffects takes nothing returns nothing
if ChaosObserverAdaptEffect!=null then
call DestroyEffect(ChaosObserverAdaptEffect)
set ChaosObserverAdaptEffect=null
endif
if ChaosObserverOverloadEffect!=null then
call DestroyEffect(ChaosObserverOverloadEffect)
set ChaosObserverOverloadEffect=null
endif
endfunction
function ChaosObserver_ClearWarningEffects takes nothing returns nothing
if ChaosObserverWarpEffect!=null then
call DestroyEffect(ChaosObserverWarpEffect)
set ChaosObserverWarpEffect=null
endif
if ChaosObserverBoltEffect!=null then
call DestroyEffect(ChaosObserverBoltEffect)
set ChaosObserverBoltEffect=null
endif
if ChaosObserverMeteorEffect!=null then
call DestroyEffect(ChaosObserverMeteorEffect)
set ChaosObserverMeteorEffect=null
endif
if ChaosObserverSweepEffect!=null then
call DestroyEffect(ChaosObserverSweepEffect)
set ChaosObserverSweepEffect=null
endif
if ChaosObserverCollapseEffect!=null then
call DestroyEffect(ChaosObserverCollapseEffect)
set ChaosObserverCollapseEffect=null
endif
endfunction
function ChaosObserver_ClearCores takes nothing returns nothing
local integer i=1
loop
exitwhen i>3
if ChaosObserverCore[i]!=null then
call RemoveUnit(ChaosObserverCore[i])
set ChaosObserverCore[i]=null
endif
set i=i+1
endloop
if ChaosObserverCoreTrigger!=null then
call OZ7(ChaosObserverCoreTrigger)
set ChaosObserverCoreTrigger=null
endif
endfunction
function ChaosObserver_ClearGuards takes nothing returns nothing
local integer i=1
loop
exitwhen i>4
if ChaosObserverGuard[i]!=null then
call RemoveUnit(ChaosObserverGuard[i])
set ChaosObserverGuard[i]=null
endif
set i=i+1
endloop
endfunction
function ChaosObserver_CountGuards takes nothing returns integer
local integer i=1
local integer count=0
loop
exitwhen i>4
if ChaosObserverGuard[i]!=null then
if XH7(ChaosObserverGuard[i]) then
set ChaosObserverGuard[i]=null
else
set count=count+1
endif
endif
set i=i+1
endloop
return count
endfunction
function ChaosObserver_CanAct takes nothing returns boolean
if ChaosObserverBoss==null or XH7(ChaosObserverBoss) or ChaosObserverOwnPause or ChaosObserverRitual or ChaosObserverRebuildState!=0 then
return false
endif
if ChaosObserverUnstoppable>0. then
return true
endif
return IsUnitPaused(ChaosObserverBoss)==false and IsUnitType(ChaosObserverBoss,UNIT_TYPE_STUNNED)==false and IsUnitType(ChaosObserverBoss,UNIT_TYPE_POLYMORPHED)==false and MHUnit_GetSilenceCount(ChaosObserverBoss)<=0
endfunction
function ChaosObserver_StopTimer takes nothing returns nothing
if ChaosObserverTimer!=null then
call PauseTimer(ChaosObserverTimer)
call DestroyTimer(ChaosObserverTimer)
set ChaosObserverTimer=null
endif
endfunction
function ChaosObserver_ReleaseOwnPause takes nothing returns nothing
if ChaosObserverOwnPause and ChaosObserverBoss!=null and GetUnitTypeId(ChaosObserverBoss)!=0 then
call PauseUnitEx(ChaosObserverBoss,false)
endif
set ChaosObserverOwnPause=false
endfunction
function ChaosObserver_ClearControl takes nothing returns nothing
local integer count=0
if ChaosObserverBoss==null or GetUnitTypeId(ChaosObserverBoss)==0 then
return
endif
call UnitRemoveBuffs(ChaosObserverBoss,false,true)
call FixUnitSilence(ChaosObserverBoss)
set count=MHUnit_GetStunCount(ChaosObserverBoss)
if count>0 then
loop
exitwhen count<=0
call MHUnit_Stun(ChaosObserverBoss,false)
set count=count-1
endloop
elseif count<0 then
loop
exitwhen count>=0
call MHUnit_Stun(ChaosObserverBoss,true)
set count=count+1
endloop
endif
call FixUnitPause(ChaosObserverBoss,Player(0))
if ChaosObserverOwnPause==false then
call EXPauseUnit(ChaosObserverBoss,false)
endif
call FixUnitMove(ChaosObserverBoss)
call SetUnitMoveSpeed(ChaosObserverBoss,ChaosObserverDesiredSpeed)
endfunction
function ChaosObserver_ClearStun takes nothing returns nothing
local integer count=0
if ChaosObserverBoss==null or GetUnitTypeId(ChaosObserverBoss)==0 or ChaosObserverOwnPause then
return
endif
set count=MHUnit_GetStunCount(ChaosObserverBoss)
if count>0 then
loop
exitwhen count<=0
call MHUnit_Stun(ChaosObserverBoss,false)
set count=count-1
endloop
elseif count<0 then
loop
exitwhen count>=0
call MHUnit_Stun(ChaosObserverBoss,true)
set count=count+1
endloop
endif
if IsUnitPaused(ChaosObserverBoss) or IsUnitType(ChaosObserverBoss,UNIT_TYPE_STUNNED) then
call FixUnitPause(ChaosObserverBoss,Player(0))
call EXPauseUnit(ChaosObserverBoss,false)
call FixUnitMove(ChaosObserverBoss)
endif
endfunction
function ChaosObserver_ApplyPlayerScaling takes unit u,integer abilityId returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
if GetUnitAbilityLevel(u,abilityId)==0 then
call UnitAddAbility(u,abilityId)
endif
call SetUnitAbilityLevel(u,abilityId,ChaosObserverPlayerCount)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
endfunction
function ChaosObserver_OnHeroKill takes nothing returns nothing
local unit dying=GetDyingUnit()
local unit killer=GetKillingUnit()
local real healed=0.
if ChaosObserverActive and ChaosObserverBoss!=null and GetUnitTypeId(ChaosObserverBoss)!=0 and killer==ChaosObserverBoss and ChaosObserver_IsDalaranHero(dying) and IsUnitIllusion(dying)==false then
set healed=ChaosObserverMaxLife*.25
call SetWidgetLife(ChaosObserverBoss,RMinBJ(ChaosObserverMaxLife,GetWidgetLife(ChaosObserverBoss)+healed))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",ChaosObserverBoss,"origin"))
call ChaosObserver_Message("混沌观测者击杀英雄，恢复25%最大生命（"+I2S(R2I(healed))+"）。")
endif
set dying=null
set killer=null
endfunction
function ChaosObserver_Shutdown takes nothing returns nothing
set ChaosObserverActive=false
call ChaosObserver_ReleaseOwnPause()
call ChaosObserver_ClearCores()
call ChaosObserver_ClearGuards()
call ChaosObserver_ClearAdaptEffects()
call ChaosObserver_ClearWarningEffects()
call ChaosObserver_StopTimer()
if ChaosObserverDamageTrigger!=null then
call OZ7(ChaosObserverDamageTrigger)
set ChaosObserverDamageTrigger=null
endif
if ChaosObserverDeathTrigger!=null then
call OZ7(ChaosObserverDeathTrigger)
set ChaosObserverDeathTrigger=null
endif
if ChaosObserverKillTrigger!=null then
call OZ7(ChaosObserverKillTrigger)
set ChaosObserverKillTrigger=null
endif
if ChaosObserverEffectTrigger!=null then
call OZ7(ChaosObserverEffectTrigger)
set ChaosObserverEffectTrigger=null
endif
set ChaosObserverBoss=null
set ChaosObserverWarpTarget=null
endfunction
function ChaosObserver_OnBossDeath takes nothing returns nothing
local unit dying=GetDyingUnit()
local real x=0.
local real y=0.
if dying==ChaosObserverBoss then
set x=GetUnitX(dying)
set y=GetUnitY(dying)
set ChaosObserverDefeated=true
call ChaosObserver_Message("混沌观测者已被击败。")
call KK2026SummerEgg_SaveAll()
call ChaosObserver_Shutdown()
call RemoveUnit(dying)
call TianxingTwins_Spawn(x,y)
endif
set dying=null
endfunction
function ChaosObserver_EndRitual takes nothing returns nothing
local integer destroyed=ChaosObserverCoreDestroyed
local real now=GetGameTime()
if ChaosObserverRitual==false then
return
endif
set ChaosObserverRitual=false
set ChaosObserverRitualRemaining=0.
call ChaosObserver_ClearCores()
call ChaosObserver_ReleaseOwnPause()
set ChaosObserverMeteorCooldown=now+4.
set ChaosObserverSweepCooldown=now+6.
set ChaosObserverGuardCooldown=now+4.
if destroyed<=0 then
set ChaosObserverPulseCount=3
set ChaosObserverCoreHealTicks=25
set ChaosObserverCoreHealPerTick=ChaosObserverMaxLife*.004
set ChaosObserverNextPulse=now+1.
call ChaosObserver_Message("未摧毁核心：发动三次混沌脉冲，并恢复10%最大生命。")
elseif destroyed==1 then
set ChaosObserverPulseCount=2
set ChaosObserverCoreHealTicks=25
set ChaosObserverCoreHealPerTick=ChaosObserverMaxLife*.002
set ChaosObserverNextPulse=now+1.
call ChaosObserver_Message("仅摧毁一个核心：发动两次混沌脉冲，并恢复5%最大生命。")
elseif destroyed==2 then
set ChaosObserverExposedMultiplier=1.15
set ChaosObserverExposedUntil=now+6.
call ChaosObserver_Message("已摧毁两个核心：混沌观测者进入6秒易伤状态。")
else
set ChaosObserverExposedMultiplier=1.25
set ChaosObserverExposedUntil=now+10.
call ChaosObserver_Message("已摧毁全部核心：混沌观测者进入10秒强效易伤状态。")
endif
endfunction
function ChaosObserver_OnCoreDeath takes nothing returns nothing
local unit dying=GetDyingUnit()
local integer i=1
if ChaosObserverRitual then
loop
exitwhen i>3
if dying==ChaosObserverCore[i] then
set ChaosObserverCore[i]=null
set ChaosObserverCoreDestroyed=ChaosObserverCoreDestroyed+1
call ChaosObserver_Message("混沌核心已摧毁（"+I2S(ChaosObserverCoreDestroyed)+"/3）。")
set i=4
endif
set i=i+1
endloop
if ChaosObserverCoreDestroyed>=3 then
call ChaosObserver_EndRitual()
endif
endif
set dying=null
endfunction
function ChaosObserver_StartRitual takes nothing returns nothing
local integer i=1
local real angle=0.
local real x=0.
local real y=0.
local player owner=null
if ChaosObserverRitual or ChaosObserverBoss==null or XH7(ChaosObserverBoss) then
return
endif
set ChaosObserverRitual=true
set ChaosObserverCoreDestroyed=0
set ChaosObserverRitualRemaining=12.
set ChaosObserverWarpRemaining=0.
set ChaosObserverWarpStrikeRemaining=0.
set ChaosObserverBoltRemaining=0.
set ChaosObserverMeteorRemaining=0.
set ChaosObserverSweepRemaining=0.
set ChaosObserverCollapseRemaining=0.
call ChaosObserver_ClearGuards()
call ChaosObserver_ClearWarningEffects()
set ChaosObserverCoreTrigger=CreateTrigger()
set owner=GetOwningPlayer(ChaosObserverBoss)
call PauseUnitEx(ChaosObserverBoss,true)
set ChaosObserverOwnPause=true
loop
exitwhen i>3
set angle=(i-1)*120.
set x=ChaosObserverHomeX+475.*Cos(angle*bj_DEGTORAD)
set y=ChaosObserverHomeY+475.*Sin(angle*bj_DEGTORAD)
set ChaosObserverCore[i]=CreateUnit(owner,'nC0R',x,y,angle+180.)
call ChaosObserver_ApplyPlayerScaling(ChaosObserverCore[i],'A9BC')
call TriggerRegisterUnitEvent(ChaosObserverCoreTrigger,ChaosObserverCore[i],EVENT_UNIT_DEATH)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",x,y))
set i=i+1
endloop
call TriggerAddAction(ChaosObserverCoreTrigger,function ChaosObserver_OnCoreDeath)
call ChaosObserver_Message("终局观测：12秒内至少摧毁三个核心中的两个。")
set owner=null
endfunction
function ChaosObserver_StopRebuild takes boolean interrupted returns nothing
local real now=GetGameTime()
if ChaosObserverRebuildState==0 then
return
endif
set ChaosObserverRebuildState=0
set ChaosObserverRebuildTicks=0
set ChaosObserverRebuildDamage=0.
call ChaosObserver_ReleaseOwnPause()
set ChaosObserverMeteorCooldown=now+2.
set ChaosObserverSweepCooldown=now+4.
set ChaosObserverGuardCooldown=now+3.
if interrupted then
call ChaosObserver_Message("重构已被打断。")
else
call ChaosObserver_Message("重构完成。")
endif
endfunction
function ChaosObserver_StartRebuild takes integer stage returns nothing
if ChaosObserverRebuildState!=0 or ChaosObserverRitual or ChaosObserverBoss==null or XH7(ChaosObserverBoss) then
return
endif
if stage==60 then
set ChaosObserverRebuild60Used=true
else
set ChaosObserverRebuild20Used=true
endif
set ChaosObserverRebuildState=1
set ChaosObserverRebuildTicks=6
set ChaosObserverRebuildDamage=0.
set ChaosObserverWarpRemaining=0.
set ChaosObserverWarpStrikeRemaining=0.
set ChaosObserverBoltRemaining=0.
set ChaosObserverMeteorRemaining=0.
set ChaosObserverSweepRemaining=0.
set ChaosObserverCollapseRemaining=0.
call ChaosObserver_ClearGuards()
call ChaosObserver_ClearWarningEffects()
call PauseUnitEx(ChaosObserverBoss,true)
set ChaosObserverOwnPause=true
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCaster.mdl",ChaosObserverBoss,"origin"))
call ChaosObserver_Message("重构预警：引导期间累计造成其2.5%最大生命伤害即可打断。")
endfunction
function ChaosObserver_DoConeStrike takes nothing returns nothing
local integer i=1
local unit hero=null
local real dx=0.
local real dy=0.
local real distance=0.
local real forwardX=Cos(ChaosObserverWarpAngle)
local real forwardY=Sin(ChaosObserverWarpAngle)
if ChaosObserverWarpEffect!=null then
call DestroyEffect(ChaosObserverWarpEffect)
set ChaosObserverWarpEffect=null
endif
if ChaosObserverBoss==null or XH7(ChaosObserverBoss) then
return
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",ChaosObserverBoss,"origin"))
loop
exitwhen i>5
set hero=M7[i]
if ChaosObserver_IsDalaranHero(hero) and XH7(hero)==false then
set dx=GetUnitX(hero)-GetUnitX(ChaosObserverBoss)
set dy=GetUnitY(hero)-GetUnitY(ChaosObserverBoss)
set distance=SquareRoot(dx*dx+dy*dy)
if distance<=500. and dx*forwardX+dy*forwardY>=distance*.707 then
call B67(ChaosObserverBoss,hero,3,300.+GetUnitState(hero,UNIT_STATE_MAX_LIFE)*.12)
call CommonUnitAddStun(hero,.75,true)
endif
endif
set i=i+1
endloop
if ChaosObserverWarpTarget!=null and XH7(ChaosObserverWarpTarget)==false then
call B947IssueTargetOrder("ChaosObserver_DoConeStrike @ war3map.j:121141 (B968)",ChaosObserverBoss,"attack",ChaosObserverWarpTarget)
endif
set hero=null
endfunction
function ChaosObserver_DoBoltStrike takes nothing returns nothing
local integer i=1
