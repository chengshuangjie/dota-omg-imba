function BDI takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit ZX7=LoadUnitHandle(TABLE_HY, h, 0)
	local unit IH7=LoadUnitHandle(TABLE_HY, h, 1)
	local integer ht=LoadInteger(TABLE_HY, h, 20)
	local integer TME=LoadInteger(TABLE_HY, h, 21)
	local boolean cleanup=false
	local real r
	if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
		set cleanup=true
	elseif UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
		set cleanup=true
	elseif GetTriggerEventId()== EVENT_WIDGET_DEATH or (GetUnitAbilityLevel(IH7,'B4AZ')==0 and GetTriggerEvalCount(t)>2) then
		set cleanup=true
	endif
	if cleanup then
		call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
		if IH7!=null and GetUnitTypeId(IH7)!=0 then
			call UnitRemoveAbility(IH7,'A4AZ')
		endif
		if ht!=0 then
			call RemoveSavedHandle(TABLE_HY, ht,'FRSW'+ TME)
			call RemoveSavedBoolean(TABLE_HY, ht,'FRSW'+ TME)
		endif
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	else
		if LoadBoolean(TABLE_HY, h, 2) then
			call YW7("+" + I2S(R2I(LoadReal(TABLE_HY, h, 100))), 1, IH7, .023, 0, 232, 232, 216)
			set r=B4R(ZX7)+B4R_XXGH(ZX7)
			if IsUnitIllusion(IH7)==false and r>0 then			
				call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+ LoadReal(TABLE_HY, h, 100) * r)
			endif
			call B67(ZX7, IH7, 2, LoadReal(TABLE_HY, h, 100))
			call SaveBoolean(TABLE_HY, h, 2, false)
		elseif GetGameTime()> LoadReal(TABLE_HY, h, 0) then
			call UnitRemoveAbility(IH7,'A4AZ')
			call DestroyEffect(LoadEffectHandle(TABLE_HY, h, 10))
			if ht!=0 then
				call RemoveSavedHandle(TABLE_HY, ht,'FRSW'+ TME)
				call RemoveSavedBoolean(TABLE_HY, ht,'FRSW'+ TME)
			endif
			call FlushChildHashtable(TABLE_HY, h)
			call OZ7(t)
		endif
	endif
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function BFI takes unit ZX7, unit IH7 returns nothing
	local trigger t=null
	local integer h
    local integer ht=0
    local integer TME=0
    local integer level=0
    local integer YM7=0
    local integer jinu_level=0
    local real xishu=1
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    if UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
        return
    endif
    set ht=GetHandleId(IH7)
    set TME=GetPlayerId(GetOwningPlayer(ZX7))
    set level=B287_GetUnitAbilityLevel(ZX7,'A2UE')
	if level<=0 then
		return
	endif
    set YM7=10 + 5 * level
    set jinu_level=B287_GetUnitAbilityLevel(ZX7,'A0LC')
    if jinu_level==1 then
        set xishu=1.5
    elseif jinu_level==2 then
        set xishu=1.8
    elseif jinu_level==3 then
        set xishu=2.0
    endif
    if OT7(ZX7,"JINU") then
        set YM7=R2I(YM7*xishu)
    endif
	set t=LoadTriggerHandle(TABLE_HY, ht,'FRSW'+ TME)
	if LoadBoolean(TABLE_HY, ht,'FRSW'+ TME)== false or t==null then
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, IH7)
		call TriggerRegisterTimerEvent(t, 1, true)
		call TriggerAddCondition(t, Condition(function BDI))
		call SaveBoolean(TABLE_HY, ht,'FRSW'+ TME, true)
		call SaveTriggerHandle(TABLE_HY, ht,'FRSW'+ TME, t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call SaveUnitHandle(TABLE_HY, h, 1, IH7)
		call SaveInteger(TABLE_HY, h, 20, ht)
		call SaveInteger(TABLE_HY, h, 21, TME)
		call TriggerRegisterTimerEvent(t, 0, false)
		call SaveEffectHandle(TABLE_HY, h, 10, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\BattleRoar\\RoarTarget.mdl", IH7, "overhead"))
		call XF7(IH7,'A4AZ')
	else
		set h = GetHandleId(t)
		call SaveBoolean(TABLE_HY, h, 2, true)
		call TriggerRegisterTimerEvent(t, 0, false)
	endif
		call SaveUnitHandle(TABLE_HY, h, 0, ZX7)
		call SaveReal(TABLE_HY, h, 100, LoadReal(TABLE_HY, h, 100)+ YM7)
		call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 15)
	set t = null
endfunction
//怒意狂击
function SWA takes nothing returns nothing
	if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 then
		return
	endif
	if UnitAlive(WXX)==false or UnitAlive(YXX)==false then
		return
	endif
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A2UE')> 0 then
		call BFI(WXX, YXX)
	endif
endfunction
function O91 takes nothing returns boolean 
local trigger t=GetTriggeringTrigger() 
local integer I97=GetHandleId(t) 
local unit p5=(LoadUnitHandle(L7,(I97),(2))) 
call FlushChildHashtable(L7,(I97)) 
call OZ7(t) 
call SetUnitPathing(p5,true) 
set t=null 
set p5=null 
return false 
endfunction 
function OA1 takes unit p5 returns nothing 
local trigger t=CreateTrigger() 
local integer I97=GetHandleId(t) 
call TriggerRegisterTimerEvent(t,5,false) 
call TriggerAddCondition(t,Condition(function O91)) 
call SaveUnitHandle(L7,(I97),(2),(p5)) 
call SetUnitPathing(p5,false) 
set t=null 
endfunction 
function O_D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real P4D=ON7(OB7,"rRealX1")
local real x2=ON7(OB7,"x2")
local real P7D=ON7(OB7,"rRealY1")
local real y2=ON7(OB7,"y2")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl",m5,"origin"))
call SetUnitPosition(p5,x2,y2)
call O37(m5,"4407",1)
call SetUnitPosition(m5,P4D,P7D)
call LINGXIA(p5,m5)
if IsUnitInRegion(BKDD,m5) then 
call OA1(m5) 
endif
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endfunction
function P8D takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real P4D=GetUnitX(p5)
local real P7D=GetUnitY(p5)
local real x2=GetUnitX(m5)
local real y2=GetUnitY(m5)
local trigger t
local integer OB7
if IsUnitAlly(p5,GetOwningPlayer(m5)) or WQ7(GetSpellTargetUnit())==false then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NQ7(OB7,"rRealX1",(P4D)*1.)
call NQ7(OB7,"x2",(x2)*1.)
call NQ7(OB7,"rRealY1",(P7D)*1.)
call NQ7(OB7,"y2",(y2)*1.)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function O_D))
call YV7("SPLK",P4D,P7D,x2,y2,.5,0,1,1,.3)
call Y67(P4D,P7D,300)
call Y67(x2,y2,300)
endif
set p5=null
set m5=null
set t=null
endfunction
function P9D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0IN' or B287_GetSpellAbilityId()=='A1AW' then
call P8D()
endif
return false
endfunction
function PDD takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
if(IsTerrainPathable(GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit),PATHING_TYPE_WALKABILITY))then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),GetObjectName('n03B'))
endif
if IsUnitAlly(b1060GetSpellTargetUnit,GetOwningPlayer(b1060GetTriggerUnit)) and OO7(GetHandleId(GetOwningPlayer(b1060GetSpellTargetUnit)),"DisableHelp")then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),GetObjectName('n038'))
endif
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
function PED takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0IN' or B287_GetSpellAbilityId()=='A1AW' then
call PDD()
endif
return false
endfunction
function GV8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function P9D))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function PED))
set t=null
endfunction
function PFD takes unit BB7,real x,real y,integer V77 returns nothing
call SetUnitPosition(BB7,x,y)
if GetPlayerController(GetOwningPlayer(BB7))==MAP_CONTROL_COMPUTER then
call UnitAddAbility(BB7,'A0AP')
call SetUnitAbilityLevel(BB7,'A0AP',V77)
endif
call B947IssueImmediateOrderById("PFD @ war3map.j:89715 (B968)",BB7,$D026C)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl",x,y))
set BB7=null
endfunction
function PGD takes nothing returns boolean
local unit b1060GetFilterUnit=GetFilterUnit()
local boolean b1060EnumReturn
if IsUnitEnemy(IN4,GetOwningPlayer((b1060GetFilterUnit))) and (GetUnitAbilityLevel((b1060GetFilterUnit),'A04R')==0 and IsUnitType((b1060GetFilterUnit),UNIT_TYPE_STRUCTURE)==false and XH7((b1060GetFilterUnit))==false and GetUnitAbilityLevel((b1060GetFilterUnit),'Bcyc')>0==false) and IsUnitInGroup((b1060GetFilterUnit),p0)==false then
call GroupAddUnit(p0,(b1060GetFilterUnit))
if GetUnitState((b1060GetFilterUnit),UNIT_STATE_LIFE)>R04 then
call SetUnitState((b1060GetFilterUnit),UNIT_STATE_LIFE,GetUnitState((b1060GetFilterUnit),UNIT_STATE_LIFE)-(R04))
call Add_EX_PlayerDamage(Q0,(b1060GetFilterUnit),R04)
else
call B67(Q0,(b1060GetFilterUnit),7,R04)
endif
endif
set b1060EnumReturn=false
set b1060GetFilterUnit=null
return b1060EnumReturn
endfunction
function PHD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit BB7=O77(OB7,"Caster")
local real l4=ON7(OB7,"Angle")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local integer V77=OM7(OB7,"Level")
local group T69=OF7(OB7,"AlreadyDamaged")
local group g
if GetTriggerEvalCount(t)>$A or BlockUnitPass(BB7) then
call WR7(T69)
call KillUnit(BB7)
call RemoveUnit(BB7)
call NM7(OB7)
call OZ7(t)
else
set p0=T69
set Q0=p5
set R04=V77*20+10
set IN4=p5
set g=WS7()
call GroupEnumUnitsInRange(g,x,y,325,Condition(function PGD))
call WR7(g)
set g=null
call PFD(BB7,x,y,V77)
if ModuloInteger(GetTriggerEvalCount(t),2)==0 then
call KillUnit(CreateUnit(GetOwningPlayer(p5),'e02A',x,y,0))
endif
set x=X17(x+$C8*Cos(l4*bj_DEGTORAD))
set y=X07(y+$C8*Sin(l4*bj_DEGTORAD))
call NQ7(OB7,"x",x*1.)
call NQ7(OB7,"y",y*1.)
endif
set t=null
set p5=null
set BB7=null
set T69=null
return false
endfunction
function PID takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit p5=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=GetLocationX(l)
local real y2=GetLocationY(l)
local real l4=J77(x1,y1,x2,y2)
local integer V77=B287_GetUnitAbilityLevel(p5,'A17O')
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',x1,y1,0)
call XF7(BB7,'A0AP')
call SetUnitAbilityLevel(BB7,'A0AP',V77)
call RemoveLocation(l)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Caster",BB7)
call NP7(OB7,"Level",V77)
call NQ7(OB7,"x",x1*1.)
call NQ7(OB7,"y",y1*1.)
call NQ7(OB7,"Angle",l4*1.)
call NB7(OB7,"AlreadyDamaged",WS7())
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function PHD))
set t=null
set p5=null
set l=null
set BB7=null
endfunction
function PJD takes nothing returns boolean
