function T6G takes unit ZX7,boolean b,real TLG,real T1G,real a2 returns nothing
local real T0G
local real T5G
local real a
local real x
local real y
local real T2G
set a=a2
set T0G=TLG+50*Cos(a*bj_DEGTORAD)
set T5G=T1G+50*Sin(a*bj_DEGTORAD)
set T2G=a
set x=T0G+200*Cos(T2G*bj_DEGTORAD)
set y=T5G+200*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
call Y67(x,y,300)
set T2G=a-40
set x=T0G+200*Cos(T2G*bj_DEGTORAD)
set y=T5G+200*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
call Y67(x,y,300)
set T2G=a-80
set x=T0G+200*Cos(T2G*bj_DEGTORAD)
set y=T5G+200*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
call Y67(x,y,300)
set T2G=a+40
set x=T0G+200*Cos(T2G*bj_DEGTORAD)
set y=T5G+200*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
call Y67(x,y,300)
set T2G=a+80
set x=T0G+200*Cos(T2G*bj_DEGTORAD)
set y=T5G+200*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
call Y67(x,y,300)
if b then
    set T2G=a-100
    set x=T0G+240*Cos(T2G*bj_DEGTORAD)
    set y=T5G+240*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
    call Y67(x,y,300)
    set T2G=a-120
    set x=T0G+280*Cos(T2G*bj_DEGTORAD)
    set y=T5G+280*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
    call Y67(x,y,300)
    set T2G=a+100
    set x=T0G+240*Cos(T2G*bj_DEGTORAD)
    set y=T5G+240*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
    call Y67(x,y,300)
    set T2G=a+120
    set x=T0G+280*Cos(T2G*bj_DEGTORAD)
    set y=T5G+280*Sin(T2G*bj_DEGTORAD)
call ZN7(CreateDestructable('B006',x,y,-1*T2G,.6,1),5)
    call Y67(x,y,300)
endif
endfunction
