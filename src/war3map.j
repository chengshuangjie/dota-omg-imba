function rt4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit IH7=(LoadUnitHandle(L7,(h),($5372AAA)))
local real v=LoadReal(L7,h,'84ER')
call SetUnitFlyHeight(IH7,GetUnitFlyHeight(IH7)+v,0)
if v<=-32 then
call Sb(IH7)
call PauseUnitEx(IH7,false)
call SetUnitPathing(IH7,true)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set v=v-2
call SaveReal(L7,h,'84ER',v*1.)
set IH7=null
set t=null
endfunction
function ZGS_GJ takes unit ZX7,unit IH7 returns nothing
    local real CXATTACK=ON7(GetHandleId(ZX7),"attack")
	local real d
    local real xishu=.4
	local real damage
	local real r=B4R(ZX7)+B4R_XXGH(ZX7)
    local real FL_rate=0.
    local real BJ_rate=ON7(GetHandleId(ZX7),"BJ_rate")
	local integer level=GetUnitAbilityLevel(ZX7,'A4IU')
    if XM_MODE then
        set xishu=.5
    endif
    call MNGJTX(ZX7,IH7)
	set d=CXATTACK*xishu+20*level
	set damage=Get_Target_Attacked_Damge(d,IH7)
	call B67_DPS(ZX7,IH7,2,d*BJ_rate)
    if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'B0KD')>0 then
        call JH_HJCT(ZX7,IH7,d)
    endif
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000暴击值|r"+R2S(BJ_rate)+" 减伤前伤害"+R2S(d*BJ_rate)+" 减伤后伤害"+R2S(damage*BJ_rate))
	if UnitAlive(IH7) and GetUnitAbilityLevel(ZX7,'A1AB')> 0 and IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and (IH7 != V4 and AS7(IH7)==false) then	
		call Q5A(ZX7, IH7, damage)
	endif
	if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 then
		call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+damage*BJ_rate*r)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", ZX7, "origin"))
	endif
    if BJ_rate>1 then
        call YW7(I2S(R2I(damage*BJ_rate))+"!",2,IH7,0.024,255,0,128,255)
    endif
	//分裂(狂战和授予力量)
    if (GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (MR7(ZX7,ZU[X1]) or MR7(ZX7,ZU[it_xh]))  then
	    set FL_rate=.45*(Have_Item_Quantity(ZX7,X1)+Have_Item_Quantity(ZX7,it_xh))
    endif
    if Have_SYLL(ZX7) then
        set level=LoadInteger(ExtraHT, 'A037', GetHandleId(ZX7))
        set FL_rate=(0.1 + level * 0.1)+FL_rate
    endif
    if FL_rate>0 and JH_FL then
        call B67_DPS(ZX7 , IH7 , 10 , d*BJ_rate*FL_rate)
    endif
set ZX7=null
set IH7=null
endfunction
function ru4 takes nothing returns nothing //旋风
local unit u=Y24
local unit IH7=GetEnumUnit()
local integer h
local trigger t
if IsUnitInGroup(IH7,IQ4)==false then
call ZGS_GJ(u,IH7)
call GroupAddUnit(IQ4,IH7)
if WF7(IH7)==false then
	if KCD(IH7)==false then
call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
	endif
// call FC(u,IH7,1,0) //击晕敌人
call PauseUnitEx(IH7,true)
call SetUnitPathing(IH7,false)
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function rt4)
call TriggerRegisterTimerEvent(t,.03,true)
call SaveUnitHandle(L7,(h),($5372AAA),(IH7))
call SaveReal(L7,h,'84ER',32*1.)
call YS7("tx\\jianhao\\jianhao_blade.mdl",IH7,"chest",.5)
call Rb(IH7)
endif
endif
set u=null
set IH7=null
set t=null
endfunction
function rv4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit m=(LoadUnitHandle(L7,(h),($2B0A6845)))
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local real rw4=(LoadReal(L7,(h),($64956AE6)))
local real rx4=(LoadReal(L7,(h),($29E62CB7)))
local real dx=(LoadReal(L7,(h),($1FB8CFB5)))-rw4
local real dy=(LoadReal(L7,(h),($73298C5)))-rx4
local group g=(LoadGroupHandle(L7,(h),($214C62CC)))
local group g2=(LoadGroupHandle(L7,(h),($214C62CD)))
local integer n=GetTriggerExecCount(t)
if n<33 and BlockUnitPass(m)==false then
call SaveReal(L7,(h),($1FB8CFB5),((dx)*1.))
call SaveReal(L7,(h),($73298C5),((dy)*1.))
call SetUnitX(m,GetUnitX(m)+dx)
call SetUnitY(m,GetUnitY(m)+dy)
set IN4=u
set Y24=u
set IQ4=g2
set IJ4=(LoadReal(L7,(h),(-$3F5412B6)))
set JH_FL=false  //单条旋风不附带分裂效果
call GroupEnumUnitsInRange(g,GetUnitX(m),GetUnitY(m),200,Condition(function AJ7_Visible))
call ForGroup(g,function ru4)
else
call KillUnit(m)
call WR7(g)
call WR7(g2)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set g=null
set g2=null
set m=null
set u=null
set t=null
endfunction
function ZGS_GROUP_GJ takes nothing returns nothing
    local unit ZX7=Y24
    local unit IH7=GetEnumUnit()
    call ZGS_GJ(ZX7,IH7)
    set ZX7=null
    set IH7=null
endfunction
function rz4 takes nothing returns nothing
    local unit ZX7=Y24
    local unit IH7=GetEnumUnit()
    if IsUnitInGroup(IH7,IQ4)==false then
        call GroupAddUnit(IQ4,IH7)
        set WNU7=WNU7+1
    endif
    set ZX7=null
    set IH7=null
endfunction
function rA4 takes unit u returns nothing
local integer hu=GetHandleId(u)
call UnitRemoveAbility(u,'A4JC')
call SaveInteger(L7,(hu),('ceng'),(0))
endfunction
function ZGS_Z07 takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=LoadUnitHandle(L7,OB7,17)
local integer o6=LoadInteger(L7,OB7,59)
local integer Z17=LoadInteger(L7,OB7,60)
local integer unitHandle=LoadInteger(L7,OB7,61)
if m5==null or GetUnitTypeId(m5)==0 then
call FlushChildHashtable(L7,OB7)
call OZ7(t)
call RemoveSavedHandle(Dvv,unitHandle,0-o6)
set t=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0)or b1060GetTriggerEventId==EVENT_WIDGET_DEATH or LoadBoolean(L7,OB7,0) then
    call rA4(m5)
    call SaveBoolean(L7,OB7,0,true)
    call UnitRemoveAbility(m5,Z17)
    call UnitRemoveAbility(m5,o6)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
elseif GetUnitAbilityLevel(m5,o6)==0 and GetTriggerEvalCount(t)>1 then
    call rA4(m5)
    call UnitRemoveAbility(m5,Z17)
    call UnitRemoveAbility(m5,o6)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
endif
set t=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ZGS_Z57 takes unit m5,integer o6,integer V77,real Z27,integer Z17 returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+Z27
if XH7(m5) or SuijiMode_EnsureExactLiveAbilityLevel(m5,o6,V77,true)==false then
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-o6)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-o6)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,o6)
call SaveInteger(L7,OB7,60,Z17)
call SaveInteger(L7,OB7,61,GetHandleId(m5))
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function ZGS_Z07))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-o6,t)
endif
call SaveBoolean(L7,OB7,0,false)
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
set t=null
endfunction
function rB4 takes unit u,boolean b returns nothing
local integer hu=GetHandleId(u)
local integer n=(LoadInteger(L7,(hu),('ceng')))
if b or n==2 then
	set n=n+1
	if n==3 then
		set n=0
        call UnitRemoveAbility(u,'A4JC')
        call UnitRemoveAbility(u,'A4IV')
        call UnitRemoveAbility(u,'B0KB')
    else
		if n==2 then
            call ZGS_Z57(u,'A4IV', 1, 10,'B0KB') //旋风烈斩-buff
            call XF7(u,'A4JC')
            call XC7(GetOwningPlayer(u),"Sound\\Interface\\Hint.wav") 
		endif
	endif
	call SaveInteger(L7,(hu),('ceng'),(n))
endif
endfunction
function rb4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local unit m
local real x
local real y
local group g
local group g2
local integer hu=GetHandleId(u)
local boolean b=false
local integer n=(LoadInteger(L7,(hu),('ceng'))) //层数
set x=GetUnitX(u)
set y=GetUnitY(u)
set g=WS7()
set g2=WS7()
set IQ4=g2
set IN4=u
set Y24=u
call DestroyEffect(AddSpecialEffectTarget("tx\\jianhao\\jianhao_Q_BladeFlashCircle.mdx",u,"origin"))
if n==2 then  //范围龙卷风
	set IJ4=(LoadReal(L7,(h),(-$3F5412B6)))
	call GroupEnumUnitsInRange(g,x,y,325,Condition(function AJ7_Visible))
    if CountUnitsInGroup(g)>1 then
        set JH_FL=true
    else
        set JH_FL=false
    endif
	call ForGroup(g,function ru4)
else  //范围普攻
	call GroupEnumUnitsInRange(g,x,y,325,Condition(function AJ7_Visible))
	set WNU7=0
	set IJ4=(LoadReal(L7,(h),(-$3F5412B6)))
	call ForGroup(g,function rz4)
    if CountUnitsInGroup(g2)>1 then
        set JH_FL=true
    else
        set JH_FL=false
    endif
    call ForGroup(g2,function ZGS_GROUP_GJ)
	set b=WNU7>0
endif
call WR7(g)
call WR7(g2)
call rB4(u,b)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set m=null
set u=null
set g=null
set t=null
endfunction
function Play_JH_Sound takes unit u returns nothing
local integer n
set n=GetRandomInt(1,3)
if n==1 then
	call StopSoundBJ(JH_SOUND_1,false)
	call PlaySoundOnUnitBJ(JH_SOUND_1,100,u)
elseif n==2 then
	call StopSoundBJ(JH_SOUND_2,false)
	call PlaySoundOnUnitBJ(JH_SOUND_2,100,u)
else
	call StopSoundBJ(JH_SOUND_3,false)
	call PlaySoundOnUnitBJ(JH_SOUND_3,100,u)
endif
endfunction
function rC4 takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit u=GetTriggerUnit()
local unit m
local unit BB7
local integer hu=GetHandleId(u)
local integer n=(LoadInteger(L7,(hu),('ceng')))
local trigger t
local integer h
local integer i
local integer level=GetUnitAbilityLevel(u,'A4IU')
local real fx
local real dx
local real dy
local real jl
local real x
local real y
local group g
local group g2
local boolean b=false
local real YM7
local boolean TJING
local real scale=1.2
local real BJ_rate=CXMAOJI_BJ(u)
local real d=(GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
call NQ7(GetHandleId(u),"BJ_rate",BJ_rate)
call NQ7(GetHandleId(u),"attack",d)
if ZGS_DIR[GetPlayerId(GetOwningPlayer(u))]==1 then
    set fx=bj_RADTODEG*Atan2((LoadReal(L7,GetHandleId((u)),'ZGSY'))-GetUnitY(u),(LoadReal(L7,GetHandleId((u)),'ZGSX'))-GetUnitX(u))
else
    set fx=bj_RADTODEG*Atan2(LoadReal(L7,GetHandleId(u),'MOUY')-GetUnitY(u),LoadReal(L7,GetHandleId(u),'MOUX')-GetUnitX(u))
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_CAST then
	set TJING=GetGameTime()-(LoadReal(L7,(hu),(-$73F194E0)))<.5
	call SaveReal(L7,(hu),(-$62840529),(GetGameTime()*1.))
	call SetUnitFacing(u,fx)
	set t=CreateTrigger()
	set h=GetHandleId(t)
	call TriggerAddAction(t,function rr4)
	call TriggerRegisterTimerEvent(t,.01,false)
	call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
	call SaveReal(L7,(h),(-$3815E6B8),((fx)*1.))
	call SaveInteger(L7,(h),($2970F80D),(n))
	call SaveBoolean(TABLE_HY,h,0,TJING)
	call SaveBoolean(TABLE_HY,hu,-$5FDF498F,TJING)
else
	set TJING=LoadBoolean(TABLE_HY,hu,-$5FDF498F)
	set YM7=25*level
	call Play_JH_Sound(u)
	if TJING==false then //不是在突进时释放
		if n==2 then  //龙卷风
			set jl=56
			set dx=jl*CosBJ((fx))
			set dy=jl*SinBJ((fx))
			set g=WS7()
			set g2=WS7()
			set t=CreateTrigger()
			set h=GetHandleId(t)
			set m=CreateUnit(GetOwningPlayer(u),'h0HH',GetUnitX(u),GetUnitY(u),fx)
			call SetUnitScale(m,scale,scale,scale)
			call MHUnit_SetModel(m,"tx\\jianhao\\jianhao_wind.mdl",false)
			call SetUnitVertexColor(m,$FF,$FF,$FF,0)
			call SetUnitTimeScale(m,2)
			call PlaySoundOnUnitBJ(JH_SOUND_WIND,100,m)
			call TriggerAddAction(t,function rv4)
			call TriggerRegisterTimerEvent(t,.03,true)
			call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
			call SaveUnitHandle(L7,(h),($2B0A6845),(m))
			call SaveReal(L7,(h),($1FB8CFB5),((dx)*1.))
			call SaveReal(L7,(h),($73298C5),((dy)*1.))
			call SaveReal(L7,(h),(-$3F5412B6),((YM7)*1.))
			call SaveReal(L7,(h),($64956AE6),((dx*.03)*1.))
			call SaveReal(L7,(h),($29E62CB7),((dy*.03)*1.))
			call SaveGroupHandle(L7,(h),($214C62CC),(g))
			call SaveGroupHandle(L7,(h),($214C62CD),(g2))
		else     //戳刺
			set BB7=CreateUnit(GetOwningPlayer(u),'h0HH',GetUnitX(u),GetUnitY(u),fx)
			set scale=1.3
			call SetUnitScale(BB7,scale,scale,scale)
			call MHUnit_SetModel(BB7,"tx\\jianhao\\jianhao_blade_flash2.mdl",false)
			call KillUnit(BB7)
			set g=WS7()
			set g2=WS7()
			set i=0
			set x=GetUnitX(u)
			set y=GetUnitY(u)
			set jl=60
			set dx=jl*CosBJ((fx))
			set dy=jl*SinBJ((fx))
			set IQ4=g2
			set IN4=u
			set WNU7=0
			set IJ4=YM7
            set Y24=u
			loop
			set x=x+dx
			set y=y+dy
			call GroupEnumUnitsInRange(g,x,y,125,Condition(function AJ7_Visible))
            call ForGroup(g,function rz4)
			set i=i+1
			exitwhen i>5
			endloop
            if CountUnitsInGroup(g2)>1 then
                set JH_FL=true
            else
                set JH_FL=false
            endif
            call ForGroup(g2,function ZGS_GROUP_GJ)
			set b=WNU7>0
			call WR7(g)
			call WR7(g2)
		endif
		call rB4(u,b)
	else     //在突进时释放
		call ResetUnitVertexColor(u,0)
		set t=CreateTrigger()
		set h=GetHandleId(t)
		call TriggerAddAction(t,function rb4)
		call TriggerRegisterTimerEvent(t,.01,false)
		call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
		call SaveReal(L7,(h),(-$3F5412B6),((YM7)*1.))
	endif
	if PT4==false then
		call Japi_ReduceUnitAbilityCoolDown(u,'A4IU',Get_JH_1_CD(u))
	endif
endif
set u=null
set m=null
set BB7=null
set t=null
set g=null
set g2=null
set b1060GetTriggerEventId=null
endfunction
function ZGS takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4IU' then
call rC4()
endif
return false
endfunction
function Change_Direction2 takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer id=GetPlayerId(p)
if ZGS_DIR[id]==0 then
    set ZGS_DIR[id]=1
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00已将控制方式切换为方式二|r")
else
    set ZGS_DIR[id]=0
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00已将控制方式切换为方式一|r")
endif
set u=null
set p=null
endfunction
function Change_Direction takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4IW' then
call Change_Direction2()
endif
return false
endfunction
function Record_Direction takes nothing returns nothing
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
if((IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_HERO)))then
    if((b1060GetOrderTargetUnit==null))then
        call SaveReal(L7,GetHandleId(b1060GetTriggerUnit),'ZGSX',GetOrderPointX())
        call SaveReal(L7,GetHandleId(b1060GetTriggerUnit),'ZGSY',b1060GetOrderPointY)
    else
        call SaveReal(L7,GetHandleId(b1060GetTriggerUnit),'ZGSX',GetUnitX(b1060GetOrderTargetUnit))
        call SaveReal(L7,GetHandleId(b1060GetTriggerUnit),'ZGSY',GetUnitY(b1060GetOrderTargetUnit))
    endif
endif
set b1060GetOrderTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
function B1065MouseDirectionSync takes nothing returns nothing
    local player p=DzGetTriggerSyncPlayer()
    local integer pid=GetPlayerId(p)
    local string data=DzGetTriggerSyncData()
    local integer length=StringLength(data)
    local integer i=0
    local integer first=-1
    local integer second=-1
    local integer heroId=0
    local integer x=0
    local integer y=0
    local unit u=null
    // Accept only the sender's current hero and a canonical, bounded payload.
    if pid>=0 and pid<bj_MAX_PLAYERS and length>0 and length<=40 and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
        loop
            exitwhen i>=length
            if SubString(data,i,i+1)=="," then
                if first==-1 then
                    set first=i
                elseif second==-1 then
                    set second=i
                endif
            endif
            set i=i+1
        endloop
        if first>0 and second>first+1 and second<length-1 then
            set heroId=S2I(SubString(data,0,first))
            set x=S2I(SubString(data,first+1,second))
            set y=S2I(SubString(data,second+1,length))
            if data==I2S(heroId)+","+I2S(x)+","+I2S(y) and x>=-655360 and x<=655360 and y>=-655360 and y<=655360 then
                set u=M7[pid]
                if u!=null and GetHandleId(u)==heroId and GetUnitTypeId(u)=='Z060' and GetOwningPlayer(u)==p then
                    call SaveReal(L7,GetHandleId(u),'MOUX',I2R(x)/10.)
                    call SaveReal(L7,GetHandleId(u),'MOUY',I2R(y)/10.)
                endif
            endif
        endif
    endif
    set u=null
    set p=null
endfunction
function Mouse_Direction takes nothing returns boolean
    local player p=DzGetTriggerKeyPlayer()
    local integer pid=GetPlayerId(p)
    local unit u=null
    local real x=0.
    local real y=0.
    // Local input only sends data; synchronized gameplay is written by the receiver.
    if p==GetLocalPlayer() and pid>=0 and pid<bj_MAX_PLAYERS then
        set u=M7[pid]
        if u!=null and GetUnitTypeId(u)=='Z060' and GetOwningPlayer(u)==p then
            set x=DzGetMouseTerrainX()
            set y=DzGetMouseTerrainY()
            if x>=-65536. and x<=65536. and y>=-65536. and y<=65536. then
                call DzSyncData("B1065MD",I2S(GetHandleId(u))+","+I2S(R2I(x*10.))+","+I2S(R2I(y*10.)))
            endif
        endif
    endif
    set u=null
    set p=null
    return false
endfunction
function ZCZGS takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function ZGS))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Change_Direction))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(t,Condition(function Record_Direction))
set t=CreateTrigger()
call DzTriggerRegisterKeyEvent(t,81,1,false,null)
call DzTriggerRegisterKeyEvent(t,82,1,false,null)
call TriggerAddCondition(t,Condition(function Mouse_Direction))
set t=CreateTrigger()
call DzTriggerRegisterSyncData(t,"B1065MD",false)
call TriggerAddAction(t,function B1065MouseDirectionSync)
set t=null
endfunction
function rS4 takes nothing returns nothing
local unit u=GetEnumUnit()
call SaveInteger(L7,(GetHandleId(u)),('A4IS'),((LoadInteger(L7,(GetHandleId(u)),('A4IS')))-1))
set u=null
endfunction
function r54 takes nothing returns nothing
local trigger t1=GetTriggeringTrigger()
local integer h=GetHandleId(t1)
local integer n=GetTriggerExecCount(t1)
local trigger t
local group g
if n*.5<(LoadReal(L7,(h),($6B54C545)))and GetUnitState((LoadUnitHandle(L7,(h),($B74872F))),UNIT_STATE_LIFE)>0 then
else
set t=LoadTriggerHandle(TABLE_HY,h,0)
set g=(LoadGroupHandle(L7,(GetHandleId(t)),($214C62CC)))
call ForGroup(g,function rS4)
call DestroyGroup(g)
call FlushChildHashtable(L7,((GetHandleId(t))))
call FlushChildHashtable(TABLE_HY,GetHandleId(t))
call OZ7(t)
call GroupRemoveUnit(aw,(LoadUnitHandle(L7,(h),($B74872F))))
call KillUnit((LoadUnitHandle(L7,(h),($B74872F))))
call FlushChildHashtable(L7,((h)))
call OZ7(t1)
endif
set g=null
set t=null
endfunction
function rT4 takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit rU4=(LoadUnitHandle(L7,(GetHandleId(GetTriggeringTrigger())),($B74872F)))
local group g
if IsUnitAlly(u,GetOwningPlayer(rU4))then
set g=(LoadGroupHandle(L7,(GetHandleId(GetTriggeringTrigger())),($214C62CC)))
if IsUnitInGroup(u,g)==false then
call GroupAddUnit(g,u)
call SaveInteger(L7,(GetHandleId(u)),('A4IS'),((LoadInteger(L7,(GetHandleId(u)),('A4IS')))+1))
endif
set g=null
endif
set u=null
set rU4=null
endfunction
function rV4 takes player p,real x,real y,real fx,real ia returns unit
local unit m1=CreateUnit(p,'e0A5',x,y,fx)
local trigger t
local integer h
local trigger rW4
local integer rX4
local group g=CreateGroup()
call GroupAddUnit(aw,m1)
set bj_lastCreatedUnit=m1
call UnitApplyTimedLife(m1,0,ia)
set rW4=CreateTrigger()
set rX4=GetHandleId(rW4)
call TriggerRegisterUnitInRange(rW4,m1,1200,null)
call TriggerAddAction(rW4,function rT4)
call SaveUnitHandle(L7,(rX4),($B74872F),(m1))
call SaveGroupHandle(L7,(rX4),($214C62CC),(g))
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function r54)
call TriggerRegisterTimerEvent(t,.5,true)
call SaveUnitHandle(L7,(h),($B74872F),(m1))
call SaveTriggerHandle(TABLE_HY,h,0,rW4)
call SaveReal(L7,(h),($6B54C545),((ia)*1.))
set rW4=null
set t=null
set m1=null
set g=null
return bj_lastCreatedUnit
endfunction
function iB takes unit u,real fx,real jl returns nothing
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SetUnitX(u,CoordinateX50(x+jl*CosBJ(fx)))
call SetUnitY(u,CoordinateY50(y+jl*SinBJ(fx)))
endfunction
function r24 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(GetTriggeringTrigger())
local unit m=(LoadUnitHandle(L7,(h),($2B0A6845)))
local real v=LoadReal(L7,h,'84ER')-.6
local real DUR=LoadReal(L7,(h),(10))
if m==null or GetUnitTypeId(m)==0 then
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set m=null
set t=null
return
endif
call SaveReal(L7,h,'84ER',v*1.)
if v>0 then
call iB(m,(LoadReal(L7,(h),(-$3815E6B8))),v)
else
call UnitApplyTimedLife(m,0,DUR)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
endif
set m=null
set t=null
endfunction
function rZ4 takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer level=0
local real DUR=0
local integer h
local trigger t
local real SourcetX=0
local real SourcetY=0
local real TargetX=GetSpellTargetX()
local real TargetY=GetSpellTargetY()
local real fx=0
local unit m=null
local real d=600.
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
set level=GetUnitAbilityLevel(u,'A4IS')
set DUR=3.+0.5*level
set SourcetX=GetUnitX(u)
set SourcetY=GetUnitY(u)
set fx=AngleBetweenXY(SourcetX,SourcetY,TargetX,TargetY)
set m=rV4(GetOwningPlayer(u),SourcetX,SourcetY,fx,DUR)
if m==null or GetUnitTypeId(m)==0 then
set u=null
set m=null
return
endif
if KF7(SourcetX,SourcetY,TargetX,TargetY)>d then
    set TargetX=X17(SourcetX+d*Cos(fx*bj_DEGTORAD))
    set TargetY=X07(SourcetY+d*Sin(fx*bj_DEGTORAD))
endif
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function r24)
call TriggerRegisterTimerEvent(t,.03,true)
call SaveUnitHandle(L7,(h),($2B0A6845),(m))
call SaveReal(L7,h,'84ER',SquareRoot(1.2*KF7(SourcetX,SourcetY,TargetX,TargetY))*1.)
call SaveReal(L7,(h),(-$3815E6B8),((fx)*1.))
call SaveReal(L7,(h),(10),(DUR))
set t=null
set u=null
set m=null
endfunction
function FZBZ takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4IS' then
call rZ4()
endif
return false
endfunction
function ZCFZBZ takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function FZBZ))
set t=null
endfunction
function rD4 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit u=(LoadUnitHandle(L7,(h),(-$3CFCF863)))
local unit IH7=(LoadUnitHandle(L7,(h),($5372AAA)))
local unit m
local integer n=GetTriggerExecCount(t)
local real dx
local real dy
local integer i
local integer MW
local integer rE4
local real x
local real y
local real r34=0
local location l
local real YM7=(LoadReal(L7,(h),(-$3F5412B6)))
if u==null or IH7==null or GetUnitTypeId(u)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(u)==false then
if u!=null and GetUnitTypeId(u)!=0 then
call SetUnitPathing(u,true)
call ResetUnitVertexColor(u,0)
call PauseUnitEx(u,false)
endif
set m=(LoadUnitHandle(L7,(h),($2B0A6845)))
if m!=null then
call RemoveUnit(m)
endif
set i=0
loop
set m=(LoadUnitHandle(L7,(h),(StringHash("m"+I2S(i)))))
if m!=null then
call RemoveUnit(m)
endif
set i=i+1
exitwhen i>=$A
endloop
call DestroyEffect(LoadEffectHandle(TABLE_HY,h,0))
call FlushChildHashtable(TABLE_HY,h)
call FlushChildHashtable(L7,((h)))
call OZ7(t)
set u=null
set m=null
set t=null
set IH7=null
return
endif
set r34=(LoadReal(L7,(GetHandleId(u)),(-$62840529)))
if n<33 then
	set dx=(LoadReal(L7,(h),($1FB8CFB5)))-(LoadReal(L7,(h),($64956AE6)))
	set dy=(LoadReal(L7,(h),($73298C5)))-(LoadReal(L7,(h),($29E62CB7)))
	call SaveReal(L7,(h),($1FB8CFB5),((dx)*1.))
	call SaveReal(L7,(h),($73298C5),((dy)*1.))
	set i=0
	loop
	set m=(LoadUnitHandle(L7,(h),(StringHash("m"+I2S(i)))))
	set MW=(LoadInteger(L7,(h),(StringHash("alpha"+I2S(i)))))+-20
	call SaveInteger(L7,(h),(StringHash("alpha"+I2S(i))),(MW))
	call SetUnitVertexColor(m,$A0,$A0,$A0,MW)
	set i=i+1
	exitwhen i>=$A
	endloop
	set rE4=ModuloInteger(n,$A)
	set m=(LoadUnitHandle(L7,(h),(StringHash("m"+I2S(rE4)))))
	call SetUnitX(m,GetUnitX(u))
	call SetUnitY(m,GetUnitY(u))
	call SetUnitFlyHeight(m,GetUnitFlyHeight(u),0)
	call SetUnitVertexColor(m,$A0,$A0,$A0,$C8)
	call SaveInteger(L7,(h),(StringHash("alpha"+I2S(rE4))),($C8))
	set x=CoordinateX50(GetUnitX(u)+dx)
	set y=CoordinateY50(GetUnitY(u)+dy)
	if(GetGameTime())-r34>.5 then
		call PauseUnitEx(u, true)
		call PauseUnitEx(u,false)
	endif
	call SetUnitX(u,x)
	call SetUnitY(u,y)
	call SetUnitFacing(u,(LoadReal(L7,(h),(StringHash("fx")))))
	set m=(LoadUnitHandle(L7,(h),($2B0A6845)))
	call SetUnitX(m,GetUnitX(u))
	call SetUnitY(m,GetUnitY(u))
	call SetUnitFlyHeight(m,GetUnitFlyHeight(u),0)
	if n==15 then
		call B67(u,IH7,1,YM7)
        call YW7(I2S(R2I(YM7)),0.5,IH7,.02,60,245,$FF,$FF)
        call LINGXIA(u,IH7)
	endif
    if n==32 and UnitAlive(u) and IsPointInRegion(IU4,x,y) then
        set l=YV8(x,y)
        set x=GetLocationX(l)
        set y=GetLocationY(l)
        call SetUnitX(u,x)
        call SetUnitY(u,y)
        call RemoveLocation(l)
        set l=null
    endif
elseif n==33 then
	if(GetGameTime())-(LoadReal(L7,(GetHandleId(u)),(-$62840529)))>1 and UnitAlive(u) then
		call SetUnitAnimation(u,"stand")
	endif
	call SetUnitPathing(u,true)
	call RemoveUnit((LoadUnitHandle(L7,(h),($2B0A6845))))
	call ResetUnitVertexColor(u,0)
	set i=0
	loop
	set m=(LoadUnitHandle(L7,(h),(StringHash("m"+I2S(i)))))
	call RemoveUnit(m)
	set i=i+1
	exitwhen i>=$A
	endloop
	call DestroyEffect(LoadEffectHandle(TABLE_HY,h,0))
	call FlushChildHashtable(TABLE_HY,h)
	call FlushChildHashtable(L7,((h)))
	call OZ7(t)
endif
set u=null
set m=null
set t=null
set IH7=null
endfunction
function r64 takes unit u,unit IH7 returns nothing
local unit m
local trigger t
local integer level=GetUnitAbilityLevel(u,'A4IT')
local integer h
local integer hu=GetHandleId(u)
local real dx
local real dy
local real jl=24
local real fx
local real now=GetGameTime()
local integer i
local real YM7
local real last
local integer layer
local real scale=.8
// local real d=(GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
set YM7=60+30*level
set last=(LoadReal(L7,(hu),(-$73F194E0)))
if XM_MODE then
    set layer=IMinBJ((LoadInteger(L7,(hu),(-$6D29BE10)))+1,4)
else
    set layer=0
endif
call SaveInteger(L7,(hu),(-$6D29BE10),(layer))
if now-last<3 then //3秒内突进提升伤害
set YM7=YM7+YM7*.1*layer
else
call SaveInteger(L7,(hu),(-$6D29BE10),(0))
endif
call SaveReal(L7,(hu),(-$73F194E0),((now)*1.))
call SaveReal(L7,(GetHandleId(IH7)),('A4IT'),((now)*1.))
// if GetLocalPlayer()==GetOwningPlayer(u)then
// set tx="tx\\jianhao\\BloodBuff.mdl"
// else
// set tx=" "
// endif
// call YS7(tx,IH7,"origin",cd+.3)
// if GetLocalPlayer()==GetOwningPlayer(u)then
// set tx="tx\\jianhao\\BloodBuff.mdl"
// else
// set tx=" "
// endif
// call YS7(tx,IH7,"origin",cd+.3)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",IH7,"chest"))
set fx=bj_RADTODEG*Atan2(GetUnitY(IH7)-GetUnitY(u),GetUnitX(IH7)-GetUnitX(u))
call SetUnitVertexColor(u,$FF,$FF,$FF,0)
set m=CreateUnit(GetOwningPlayer(u),'h0HH',GetUnitX(u),GetUnitY(u),fx)
call SetUnitScale(m,scale,scale,scale)
call MHUnit_SetModel(m,"model\\Hero_jianhao.mdl",false)
call SetUnitAnimationByIndex(m,6)
call SetUnitAnimationByIndex(u,6)
call SetUnitPathing(u,false)
call SaveReal(L7,(hu),('A4IT'),((now)*1.))
set dx=jl*CosBJ((fx))
set dy=jl*SinBJ((fx))
set t=CreateTrigger()
set h=GetHandleId(t)
call TriggerAddAction(t,function rD4)
call TriggerRegisterTimerEvent(t,.01,true)
call SaveEffectHandle(TABLE_HY,h,0,AddSpecialEffectTarget("tx\\jianhao\\jianhao_smoke.mdl",u,"origin"))
call SaveUnitHandle(L7,(h),(-$3CFCF863),(u))
call SaveUnitHandle(L7,(h),($5372AAA),(IH7))
call SaveUnitHandle(L7,(h),($2B0A6845),(m))
call SaveReal(L7,(h),(-$3815E6B8),((fx)*1.))
call SaveReal(L7,(h),($1FB8CFB5),((dx)*1.))
call SaveReal(L7,(h),($73298C5),((dy)*1.))
call SaveReal(L7,(h),(-$3F5412B6),((YM7)*1.))
call SaveReal(L7,(h),($64956AE6),((dx*.03)*1.))
call SaveReal(L7,(h),($29E62CB7),((dy*.03)*1.))
set i=0
loop
set m=CreateUnit(GetOwningPlayer(u),'h0HH',GetUnitX(u),GetUnitY(u),fx)
call SetUnitScale(m,scale,scale,scale)
call MHUnit_SetModel(m,"model\\Hero_jianhao.mdl",false)
call SetUnitAnimationByIndex(m,6)
call SetUnitVertexColor(m,160,160,160,0)
call SaveUnitHandle(L7,(h),(StringHash("m"+I2S(i))),(m))
call SaveInteger(L7,(h),(StringHash("alpha"+I2S(i))),($C8))
set i=i+1
exitwhen i>=10
endloop
if PT4==false then
call Japi_ReduceUnitAbilityCoolDown(u,'A4IT',Get_JH_3_CD(u))
endif
set t=null
set m=null
endfunction
function LowHP_HERO takes nothing returns boolean
	return IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit())) and IsAliveNotStrucNotWard(GetFilterUnit()) and IsMagicImmuneUnit(GetFilterUnit())== false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(U22)) and IsHideUnit(GetFilterUnit())==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)
endfunction
function LowHP_Unit takes nothing returns boolean
	return IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit())) and IsAliveNotStrucNotWard(GetFilterUnit()) and IsMagicImmuneUnit(GetFilterUnit())== false and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(U22)) and IsHideUnit(GetFilterUnit())==false
endfunction
function Get_LowHP_Unit_PD2 takes nothing returns nothing
local real d=GetUnitState(GetEnumUnit(),UNIT_STATE_LIFE)
if d<ZA4 then
set ZA4=d
set ZZ4=GetEnumUnit()
endif
endfunction
function Get_LowHP_Unit_PD takes group g returns unit
set ZA4=$F423F
set ZZ4=null
call ForGroup(g,function Get_LowHP_Unit_PD2)
return ZZ4
endfunction
function Get_LowHP_Unit takes unit u returns unit
local group g=WS7()
local real x=0
local real y=0
if u==null or GetUnitTypeId(u)==0 then
call WR7(g)
set g=null
return null
endif
set x=GetUnitX(u)
set y=GetUnitY(u)
set U22=u
call GroupEnumUnitsInRange(g,x,y,425,Condition(function LowHP_HERO))
set LOWHPUNIT=Get_LowHP_Unit_PD(g)
if LOWHPUNIT==null then
    call GroupEnumUnitsInRange(g,x,y,425,Condition(function LowHP_Unit))
    set LOWHPUNIT=Get_LowHP_Unit_PD(g)
endif
call WR7(g)
set g=null
return LOWHPUNIT
endfunction
function rI4 takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit u=GetTriggerUnit()
local integer id=0
local unit IH7
if u==null or GetUnitTypeId(u)==0 then
set u=null
set IH7=null
set b1060GetTriggerEventId=null
return
endif
set id=GetPlayerId(GetOwningPlayer(u))
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_CAST then
    if TQZ_TARGET[id]==0 then
        set IH7=GetSpellTargetUnit()
        if IH7==null or GetUnitTypeId(IH7)==0 or WF7(IH7) then
            call KR7(u)
call X377(GetOwningPlayer(u),GetObjectName('n0LR'))
        else
            call SaveUnitHandle(L7,(GetHandleId(u)),('A4IT'),(IH7))
        endif
    else
        set IH7=Get_LowHP_Unit(u)
        if IH7==null then
            call KR7(u)
            call X377(GetOwningPlayer(u),"范围内没有可突进的敌方单位")
        else
            call SaveUnitHandle(L7,(GetHandleId(u)),('A4IT'),(IH7))
        endif
    endif
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_EFFECT then
	set IH7=LoadUnitHandle(L7,(GetHandleId(u)),('A4IT'))
	if IH7==null or GetUnitTypeId(IH7)==0 or UnitAlive(IH7)==false then
		set u=null
		set IH7=null
		set b1060GetTriggerEventId=null
		return
	endif
	call r64(u,IH7)
endif	
set u=null
set IH7=null
set b1060GetTriggerEventId=null
endfunction
function TQZ takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4IT' then
    call rI4()
endif
return false
endfunction
function Change_E_Target2 takes unit u,boolean b returns nothing
local player p=null
local integer id=0
local integer i
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
set p=GetOwningPlayer(u)
set id=GetPlayerId(p)
if TQZ_TARGET[id]==0 or b then
    set TQZ_TARGET[id]=1
    set i=0
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',1,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',2,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',3,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',4,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    if b==false then
        call DisplayTextToPlayer(p,0,0, "|cFF00FF00已将突进方式切换为方式二|r")
    endif
else
    set TQZ_TARGET[id]=0
    set i=1
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',1,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',2,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',3,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call MHAbility_SetCustomLevelDataReal(u,'A4IT',4,ABILITY_LEVEL_DEF_DATA_DATA_B,i)
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00已将突进方式切换为方式一|r")
endif
set p=null
endfunction
function Change_E_Target takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4JB' then
call Change_E_Target2(GetTriggerUnit(),false)
endif
return false
endfunction
function XXTQZ takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetLearnedSkill()=='A4IT' and IsUnitIllusion(b1060GetTriggerUnit)==false and GetUnitAbilityLevel(b1060GetTriggerUnit,'A4IT')==1 then
    call SuijiMode_SetExactLiveAbilityCastpoint(b1060GetTriggerUnit,'A4IT',.01)
    if TQZ_TARGET[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))]==1 then
        call Change_E_Target2(b1060GetTriggerUnit,true)
    endif
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function ZCTQZ takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function TQZ))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function XXTQZ))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Change_E_Target))
set t=null
endfunction
function Gc takes unit u returns nothing
local integer hu=0
local string tx
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
set hu=GetHandleId(u)
if LoadEffectHandle(TABLE_HY,hu,-$5A98E05F)==null then
if IsUnitAlly(u,GetLocalPlayer())then
set tx="war3mapImported\\jianhao_armor_2.mdx"
else
set tx=""
endif
call SaveEffectHandle(TABLE_HY,hu,-$5A98E05F,AddSpecialEffectTarget(tx,u,"origin"))
endif
call SetTextTagVisibility(LoadTextTagHandle(TABLE_HY,hu,-$5E692E6),false)
endfunction
function r14 takes nothing returns nothing
local unit u=IN4
local unit IH7=GetEnumUnit()
local real range=0
local real DUR=0
if u==null or IH7==null or ZZ4==null or GetUnitTypeId(u)==0 or GetUnitTypeId(IH7)==0 or GetUnitTypeId(ZZ4)==0 then
set u=null
set IH7=null
return
endif
set range=Get_JH_4_Range(u)
set DUR=Get_JH_4_Xuanyun(u)
if IsUnitAliveBJ(IH7)and IsUnitEnemy(u,GetOwningPlayer(IH7))and IsUnitVisible(IH7,GetOwningPlayer(u)) and SquareRoot((GetUnitX(IH7)-GetUnitX(ZZ4))*(GetUnitX(IH7)-GetUnitX(ZZ4))+(GetUnitY(IH7)-GetUnitY(ZZ4))*(GetUnitY(IH7)-GetUnitY(ZZ4)))<range then
call GroupAddUnit(IQ4,IH7)
call CommonUnitAddStun(IH7, DUR, true)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",IH7,"chest"))
call SetUnitAnimation(IH7,"death")
endif
set u=null
set IH7=null
endfunction
function rJ4 takes nothing returns nothing
local unit IH7=GetEnumUnit()
call SetUnitFlyHeight(IH7,260+ZB4,0)
set IH7=null
endfunction
function YW7_JXZ takes string Hx,real Hk,unit HX,real Ia,integer r,integer g,integer b,integer a returns nothing
local texttag tt=CreateTextTag()
call SetTextTagText(tt,Hx,Ia)
call SetTextTagPosUnit(tt,HX,-128)
call SetTextTagColor(tt,r,g,b,a)
call SetTextTagVelocity(tt,0,.0355)
call SetTextTagFadepoint(tt,2)
call SetTextTagPermanent(tt,false)
call SetTextTagLifespan(tt,Hk)
if IsUnitVisible(HX,GetLocalPlayer())or WG7(GetLocalPlayer())then
call SetTextTagVisibility(tt,true)
else
call SetTextTagVisibility(tt,false)
endif
set tt=null
endfunction
function rK4 takes nothing returns nothing
local unit IH7=GetEnumUnit()
local real d=Get_Target_Attacked_Damge(ZB4,IH7)
call B67(IN4,IH7,2,ZB4)
call YW7_JXZ(I2S(R2I(d))+"!",3,IH7,0.024,255,0,0,255)
call SetUnitFlyHeight(IH7,GetUnitDefaultFlyHeight(IH7),$FA0)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",IH7,"chest"))
