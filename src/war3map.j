function SuijiT4_NormalizeAbilityIcon takes string icon returns string
local string lowerIcon=""
local integer length=0
if icon==null or icon=="" then
return""
endif
set length=StringLength(icon)
set lowerIcon=StringCase(icon,false)
if length>=4 and (SubString(lowerIcon,length-4,length)==".blp" or SubString(lowerIcon,length-4,length)==".tga") then
set lowerIcon=""
return icon
endif
set lowerIcon=""
return icon+".blp"
endfunction
function SuijiT4_FirstIcon takes string icon returns string
local integer i=0
if icon==null or icon=="" then
return""
endif
loop
exitwhen i>=StringLength(icon)
if SubString(icon,i,i+1)=="," then
return SubString(icon,0,i)
endif
set i=i+1
endloop
return icon
endfunction
function SuijiT4_AbilityIcon takes integer skill returns string
local string icon=null
if skill==0 then
return"UI\\Widgets\\Console\\Undead\\undead-inventory-slotfiller.blp"
endif
set icon=SuijiT4_NormalizeAbilityIcon(SuijiT4_FirstIcon(MHAbility_GetDefDataStr(skill,ABILITY_DEF_DATA_ART)))
if icon==null or icon=="" then
return"ReplaceableTextures\\CommandButtons\\BTNCancel.blp"
endif
return icon
endfunction
function SuijiT4_PlayerSkillId takes player p,integer slot returns integer
local unit u=M7[GetPlayerId(p)]
local integer h=0
local integer source=0
local integer selected=0
local integer skill=0
if u!=null then
set source=SuijiMode_ReadStableHeroIndex(u)
if SUIJI_MODE and OO7(GetHandleId(u),"SuijiDone") then
set h=GetHandleId(u)
if slot==1 then
set skill=OM7(h,"SuijiSmallSkill")
elseif slot==2 then
set skill=OM7(h,"SuijiUltSkill")
if skill==0 then
set selected=OM7(h,"SuijiUltSelectedChoice")
if selected>0 then
set skill=OM7(h,"SuijiUltChoice"+I2S(selected)+"Skill")
endif
endif
elseif source>=KL4 and source<=K54 then
set skill=LoadInteger(MSK,source,slot-2)
endif
elseif source>=KL4 and source<=K54 then
set skill=LoadInteger(MSK,source,slot)
endif
endif
set u=null
return skill
endfunction
function SuijiT4_PlayerSkillIcon takes player p,integer slot returns string
return SuijiT4_AbilityIcon(SuijiT4_PlayerSkillId(p,slot))
endfunction
