local unit m5=O77(OB7,"Target")
local real RK=ON7(OB7,"Angle")
local real x=GetUnitX(m5)-5*Cos(RK)
local real y=GetUnitY(m5)-5*Sin(RK)
local integer V77=OM7(OB7,"Level")
local real IPD=ON7(OB7,"x")
local real IQD=ON7(OB7,"y")
if((IPD-x)*(IPD-x))+((IQD-y)*(IQD-y))<100 then
set x=IPD
set y=IQD
endif
call SetUnitX(m5,x)
call SetUnitY(m5,y)
if GetTriggerEvalCount(t)==(20+$A*V77)or b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST then
call NM7(OB7)
call OZ7(t)
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST then
call KillUnit(b1060GetTriggerUnit)
endif
endif
set t=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function IRD takes unit u,real IPD,real IQD,integer V77,unit m5 returns boolean
local trigger t
local integer OB7
local unit oA=CreateUnit(GetOwningPlayer(u),'u00X',IPD,IQD,0)
local integer id=GetUnitTypeId(u)
local integer skill
local boolean b=false
if WQ7(m5) then
    set b=true
endif
if id=='Z00S' then
    set skill='X14Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N4S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
elseif id=='Z10S' then
    set skill='X24Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N4S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
elseif id=='Z20S' then
    set skill='X34Q'
    call YT7_by_scale("model\\Hero_STormSpirit_N8S_E_Source.mdl",GetUnitX(u),GetUnitY(u),1.5,2)
else
    set skill='A14Q'
endif
call UnitApplyTimedLife(oA,'BTLF',1+0.5*V77)
call UnitAddAbility(oA,skill)
call SetUnitAbilityLevel(oA,skill,V77)
call UnitRemoveAbility(m5,'B0AD')
call B947IssueTargetOrderById("IRD @ war3map.j:83963 (B968)",oA,$D0200,m5)
if b==false then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,oA,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function IOD))
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Angle",((Atan2(GetUnitY(m5)-IQD,GetUnitX(m5)-IPD))*1.0))
call NP7(OB7,"Level",V77)
call NQ7(OB7,"x",IPD)
call NQ7(OB7,"y",IQD)
call CommonUnitAddStun(m5,1+0.5*V77, true)
call LINGXIA(u,m5)
endif
set t=null
set oA=null
return true
endfunction
