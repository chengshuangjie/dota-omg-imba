function MUBEI_Damaging_EVENT takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local unit source=MHDamagingEvent_GetSource()
if UndyingIsTombstone(target) and MHDamagingEvent_GetDamage()>0. and MHDamagingEvent_IsPhysical() then
if IsUnitType(source,UNIT_TYPE_HERO) then
call MHDamagingEvent_SetDamage(2.)
else
call MHDamagingEvent_SetDamage(1.)
endif
endif
set target=null
set source=null
return false
endfunction
