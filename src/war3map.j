call WR7(g)
call DestroyEffect(OG7(I97,"FX"))
if BB7!=null then
call RemoveUnit(BB7)
endif
call OZ7(t)
call NM7(I97)
call WR7(BQ9)
set ZX7=null
set BB7=null
set g=null
set t=null
set BQ9=null
