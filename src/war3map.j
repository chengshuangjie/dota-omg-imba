call TriggerAddCondition(t,Condition(function JOD))
set t=null
endfunction
function JPD takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZQ8=(LoadUnitHandle(L7,(I97),(2)))
local real JQD
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamage>2 and b1060GetEventDamageSource!=b1060GetTriggerUnit and TX7(GetOwningPlayer(b1060GetEventDamageSource))then
call SaveReal(L7,(I97),(714),(((TimerGetElapsed(W)))*1.))
endif
endif
set JQD=(LoadReal(L7,(I97),(714)))
if JQD+3<(TimerGetElapsed(W))then
if(LoadInteger(L7,(I97),(34)))==2 then
call SaveInteger(L7,(I97),(34),(1))
call OX7(ZQ8,"4327")
call SetPlayerAbilityAvailable(GetOwningPlayer(ZQ8),'A0A7',true)
endif
else
if(LoadInteger(L7,(I97),(34)))==1 then
call SaveInteger(L7,(I97),(34),(2))
call OV7(ZQ8,"4327")
call SetPlayerAbilityAvailable(GetOwningPlayer(ZQ8),'A0A7',false)
endif
endif
set t=null
set ZQ8=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function JRD takes unit ZQ8 returns nothing
local trigger t
local integer I97
call SetPlayerAbilityAvailable(GetOwningPlayer(ZQ8),'A0A7',true)
if GetPlayerController(GetOwningPlayer(ZQ8))==MAP_CONTROL_USER then
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.2,true)
call B1023RegisterDamage(t,ZQ8)
call TriggerRegisterUnitEvent(t,ZQ8,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function JPD))
call SaveUnitHandle(L7,(I97),(2),(ZQ8))
call SaveReal(L7,(I97),(714),((0)*1.))
call SaveInteger(L7,(I97),(34),(1))
set t=null
endfunction
