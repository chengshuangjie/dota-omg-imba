call JD2("Fonts\\U.blp",90,90,x-70,y,0,true)
call SetImageColor(AB4,255,0,0,a)
call SaveImageHandle(L7,(OB7),(160),(AB4))
call JD2("Fonts\\R.blp",90,90,x-30,y,0,true)
call SetImageColor(AB4,255,0,0,a)
call SaveImageHandle(L7,(OB7),(161),(AB4))
call JD2("Fonts\\T.blp",90,90,x+30,y,0,true)
call SetImageColor(AB4,255,0,0,a)
call SaveImageHandle(L7,(OB7),(162),(AB4))
call JD2("Fonts\\U.blp",90,90,x+70,y,0,true)
call SetImageColor(AB4,255,0,0,a)
call SaveImageHandle(L7,(OB7),(163),(AB4))
call JD2("Fonts\\R.blp",90,90,x+110,y,0,true)
