// The minimap entry purchases the existing shop unit; it never revives or charges directly.
function B927BuybackCost takes player bbPlayer927 returns integer
local integer bbIndex927=0
loop
exitwhen bbIndex927>59
if V9[bbIndex927]==W9[GetPlayerId(bbPlayer927)] then
return X9[bbIndex927]
endif
set bbIndex927=bbIndex927+1
endloop
return -1
endfunction
function B927BuybackError takes player bbPlayer927 returns string
local integer bbPid927=GetPlayerId(bbPlayer927)
local unit bbHero927=M7[bbPid927]
local unit bbShop927=KU4[bbPid927]
local string bbError927=""
local integer bbCost927=B927BuybackCost(bbPlayer927)
if GetPlayerController(bbPlayer927)!=MAP_CONTROL_USER or GetPlayerSlotState(bbPlayer927)!=PLAYER_SLOT_STATE_PLAYING then
set bbError927="仅当前在线玩家可以使用买活。"
elseif D4 or not X14 then
set bbError927="当前阶段不可买活。"
elseif bbHero927==null or GetUnitTypeId(bbHero927)==0 or GetOwningPlayer(bbHero927)!=bbPlayer927 or IsUnitIllusion(bbHero927) then
set bbError927="当前没有可买活的主英雄。"
elseif bbShop927==null or GetUnitTypeId(bbShop927)==0 or GetOwningPlayer(bbShop927)!=bbPlayer927 then
set bbError927="买活商店当前不可用。"
elseif not XH7(bbHero927) then
set bbError927="英雄尚未阵亡，无需买活。"
elseif HSS[bbPid927] then
set bbError927="被死神镰刀杀死，无法买活。"
elseif OT7(bbHero927,"chongsheng") or OO7(GetHandleId(bbHero927),"B834ReincarnationPending") then
set bbError927="英雄重生中，无法买活。"
elseif W9[bbPid927]=='h0D4' or GetUnitAbilityLevel(bbShop927,'A20U')>0 then
set bbError927="买活冷却中。"
elseif bbCost927<0 then
set bbError927="买活库存尚未准备就绪。"
elseif GetPlayerState(bbPlayer927,PLAYER_STATE_RESOURCE_GOLD)<bbCost927 then
set bbError927="黄金不足，还需要 "+I2S(bbCost927-GetPlayerState(bbPlayer927,PLAYER_STATE_RESOURCE_GOLD))+" 黄金。"
endif
set bbHero927=null
set bbShop927=null
return bbError927
endfunction
function B927BuybackSync takes player bbSender927 returns nothing
local integer bbId927=GetPlayerId(bbSender927)
local string bbReason927
if bbId927<0 or bbId927>=bj_MAX_PLAYERS then
return
endif
if GetGameTime()<B927BuybackSharedReady[bbId927] then
return
endif
set B927BuybackSharedReady[bbId927]=GetGameTime()+.25
set bbReason927=B927BuybackError(bbSender927)
if bbReason927!="" then
call X37(bbSender927,bbReason927)
elseif not B947IssueImmediateOrderById("B927BuybackSync @ war3map.j:222722 (B968)",KU4[bbId927],W9[bbId927]) then
call X37(bbSender927,"买活购买失败，请检查买活库存和冷却。")
endif
endfunction
function B927BuybackClick takes nothing returns nothing
if B922WheelOpen or MHUI_IsChatEditBarOn() or EditingHotKeyIndex>0 then
return
endif
if GetGameTime()>=B927BuybackLocalReady then
set B927BuybackLocalReady=GetGameTime()+.25
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,2.,"|cFF66CCFF买活：|r正在请求购买……")
call DzSyncData("p","buyback")
endif
endfunction
function Trig_Synsp takes nothing returns nothing
	local player p = DzGetTriggerSyncPlayer()
	local integer id = GetPlayerId(p)
	local string s = DzGetTriggerSyncData()
	if s == "buyback" then
		call B927BuybackSync(p)
	elseif s == "1" then //激活防御符文
		call B947IssueImmediateOrderById("Trig_Synsp @ war3map.j:222743 (B968)",KU4[GetPlayerId(p)],$D0114)
	elseif s == "2" then
		call Trig_SynsL(p, id)
	elseif s == "0" then
		if IsPlayerAlly(GetLocalPlayer(), p) or WG7(GetLocalPlayer()) then
			if GetSeGlyphCdByUnit(p) == 0.00 then
				call EXDisplayChat(p, 1, "|c00fffc01防御符文|r > 已准备就绪")
			else
				call EXDisplayChat(p, 1, "|c00fffc01防御符文|r > 冷却中，还剩 |c00FF0000" + I2S(R2I(GetSeGlyphCdByUnit(p)))+ "|r 秒")
			endif
		endif
	endif
	set p=null
endfunction
