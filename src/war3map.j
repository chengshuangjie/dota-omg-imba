function QZD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0GK')
local real YM7=20+70*level
local real casterLife=GetUnitState(ZX7,UNIT_STATE_LIFE)
local real casterMaxLife=GetUnitState(ZX7,UNIT_STATE_MAX_LIFE)
local real drainedLife=0.
local real healedLife=0.
local real overflow=0.
local real drainedMana=0.
local boolean nightmareActive=LoadInteger(L7,GetHandleId(IH7),791)!=0 and GetUnitAbilityLevel(IH7,'B02F')>0
call B67(ZX7,IH7,7,YM7)
set drainedLife=RMinBJ(YM7,GetUnitState(IH7,UNIT_STATE_LIFE))
if casterLife>1 then
set healedLife=RMinBJ(drainedLife,RMaxBJ(casterMaxLife-casterLife,0.))
set overflow=drainedLife-healedLife
if healedLife>0. then
call SetUnitState(ZX7,UNIT_STATE_LIFE,casterLife+healedLife)
endif
if overflow>0. then
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)+overflow)
endif
endif
if nightmareActive then
set drainedMana=RMinBJ(GetUnitState(IH7,UNIT_STATE_MANA)*.2,300.)
if drainedMana>0. then
call SetUnitState(IH7,UNIT_STATE_MANA,GetUnitState(IH7,UNIT_STATE_MANA)-drainedMana)
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)+drainedMana)
endif
endif
