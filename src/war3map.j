function CullingBlade_GetArmorAbility takes integer bit returns integer
if bit==0 then
return 'ZV20'
elseif bit==1 then
return 'ZV21'
elseif bit==2 then
return 'ZV22'
elseif bit==3 then
return 'ZV23'
elseif bit==4 then
return 'ZV24'
elseif bit==5 then
return 'ZV25'
elseif bit==6 then
return 'ZV26'
elseif bit==7 then
return 'ZV27'
endif
return 0
endfunction
function CullingBlade_SetPermanentArmor takes unit u,integer armor returns nothing
local integer i=0
local integer value=IMinBJ(armor,255)
local integer armorAbility=0
loop
exitwhen i>7
set armorAbility=CullingBlade_GetArmorAbility(i)
call UnitRemoveAbility(u,armorAbility)
set i=i+1
endloop
set i=0
loop
exitwhen value<=0 or i>7
set armorAbility=CullingBlade_GetArmorAbility(i)
if ModuloInteger(value,2)==1 then
call XF7(u,armorAbility)
endif
set value=value/2
set i=i+1
endloop
endfunction
function QWD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local real PLD=GetUnitState(IH7,UNIT_STATE_LIFE)
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0E2')
local integer armor
local unit BB7
local boolean QXD=false
local group g
local integer U43=250
local integer U53=325
local integer U63=400
local integer id=GetUnitTypeId(WI7)
local string tx
local string tx2
local boolean cullingHeroExecution=false
if id=='Zpgh' then
    set tx="model\\Hero_Axe_N9S_C_Target.mdl"
    set tx2="model\\Hero_Axe_N9S_C_Source.mdl"
elseif id=='Zpgi' then
    set tx="model\\Hero_Axe_N4S_C_Target.mdl"
    set tx2="model\\Hero_Axe_N4S_C_Source.mdl"
elseif id=='Zpgj' then
    set tx="AZModel\\AZ_AxeCold_C2.mdl"
    set tx2="AZModel\\AZ_AxeCold_C1.mdl"
else
    set tx="Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl"
    set tx2="war3mapImported\\AxeUltiMSFX_01.mdx"
endif
set R34=6
if SuijiMode_ScepterRegistryIsActive(WI7,'A0E2') and SuijiMode_DetectAghanimSourceState(WI7) then
    set QXD=true
    set U43=375
    set U53=500
    set U63=625
    set R34=10
endif
if(PLD<=U43 and BC7==1)or(PLD<=U53 and BC7==2)or(PLD<=U63 and BC7==3)then
else
    call LINGXIA(WI7,IH7)
endif
set PLD=GetUnitState(IH7,UNIT_STATE_LIFE)
if UnitAlive(IH7) and ((PLD<=U43 and BC7==1)or(PLD<=U53 and BC7==2)or(PLD<=U63 and BC7==3))then
    if IsUnitType(IH7,UNIT_TYPE_HERO)then
call B287_UnitRemoveAbility(WI7,'A0E2')
call B287_UnitAddAbility(WI7,'A0E2')
call B287_SetUnitAbilityLevel(WI7,'A0E2',BC7)
    endif
    call PlaySoundOnUnitBJ(YN,100,IH7)
    call YW7("斩杀!!!",4,WI7,.04,$FF,$FF,0,$FF)
    call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"overhead"))
set BB7=CreateUnit(GetOwningPlayer(WI7),'e00E',0,0,0)
    set cullingHeroExecution=IsUnitType(IH7,UNIT_TYPE_HERO) and IsUnitIllusion(IH7)==false and IsUnitEnemy(IH7,GetOwningPlayer(WI7))
    call UnitRemoveBuffs(IH7,true,true)
call UnitRemoveAbility(IH7,'Aetl')
    call UnitDamageTarget(BB7,IH7,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
    if cullingHeroExecution and UnitAlive(IH7)==false then
        set armor=IMinBJ(OM7(GetHandleId(WI7),"CullingBladePermanentArmor")+2,254)
        call NP7(GetHandleId(WI7),"CullingBladePermanentArmor",armor)
        call CullingBlade_SetPermanentArmor(WI7,armor)
    endif
call UnitApplyTimedLife(BB7,'BTLF',1.)
    call DestroyEffect(AddSpecialEffectTarget(tx2,WI7,"origin"))
    call Add_EX_PlayerDamage(WI7,IH7,R2I(PLD))
    set g=WS7()
    call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),925,Condition(function B97))
    set U22=WI7
    call ForGroup(g,function QUD)
    call WR7(g)
    set g=null
endif
set WI7=null
set IH7=null
set BB7=null
endfunction
function G_8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function QVD))
