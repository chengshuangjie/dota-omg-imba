function CYD takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0EY' or B287_GetSpellAbilityId()=='A0FH' or B287_GetSpellAbilityId()=='A0F0'
endfunction
function CZD takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))and GZZ(GetFilterUnit())
endfunction
function B906RazeClear takes timer razeTimer returns nothing
local integer razeKey=GetHandleId(razeTimer)
local unit razeCaster=LoadUnitHandle(L7,razeKey,0)
local unit razeTarget=LoadUnitHandle(L7,razeKey,1)
local trigger razeDeath=LoadTriggerHandle(L7,razeKey,2)
if LoadTimerHandle(B906RazePairs,GetHandleId(razeCaster),GetHandleId(razeTarget))==razeTimer then
call RemoveSavedHandle(B906RazePairs,GetHandleId(razeCaster),GetHandleId(razeTarget))
endif
call FlushChildHashtable(L7,GetHandleId(razeDeath))
call OZ7(razeDeath)
call PauseTimer(razeTimer)
call DestroyTimer(razeTimer)
call FlushChildHashtable(L7,razeKey)
set razeCaster=null
set razeTarget=null
set razeDeath=null
endfunction
function B906RazeExpire takes nothing returns nothing
call B906RazeClear(GetExpiredTimer())
endfunction
function B906RazeDeath takes nothing returns nothing
call B906RazeClear(LoadTimerHandle(L7,GetHandleId(GetTriggeringTrigger()),0))
endfunction
function B906RazeBonus takes unit razeCaster,unit razeTarget,integer razeLevel returns real
local timer razeTimer=null
local trigger razeDeath=null
local integer razeKey=0
local integer razeStacks=0
local real razeBonus=0.
if razeCaster==null or razeTarget==null or GetUnitTypeId(razeCaster)==0 or GetUnitTypeId(razeTarget)==0 or not UnitAlive(razeTarget) or razeLevel<1 then
return 0.
endif
set razeTimer=LoadTimerHandle(B906RazePairs,GetHandleId(razeCaster),GetHandleId(razeTarget))
if razeTimer==null then
set razeTimer=CreateTimer()
set razeKey=GetHandleId(razeTimer)
set razeDeath=CreateTrigger()
call SaveUnitHandle(L7,razeKey,0,razeCaster)
call SaveUnitHandle(L7,razeKey,1,razeTarget)
call SaveTriggerHandle(L7,razeKey,2,razeDeath)
call SaveTimerHandle(L7,GetHandleId(razeDeath),0,razeTimer)
call TriggerRegisterDeathEvent(razeDeath,razeTarget)
call TriggerAddAction(razeDeath,function B906RazeDeath)
call SaveTimerHandle(B906RazePairs,GetHandleId(razeCaster),GetHandleId(razeTarget),razeTimer)
else
set razeKey=GetHandleId(razeTimer)
if GetGameTime()<LoadReal(L7,razeKey,4) then
set razeStacks=LoadInteger(L7,razeKey,3)
endif
endif
// Damage uses the old count. Publish the next count before damage callbacks.
set razeBonus=I2R(razeStacks)*(40.+15.*I2R(IMinBJ(4,razeLevel)))
call SaveInteger(L7,razeKey,3,razeStacks+1)
// IMBA: raze bonus buff x2 cap 30s; end-time synced.
if XOMG_IMBA_ENABLED then
call SaveReal(L7,razeKey,4,GetGameTime()+RMinBJ(6.*IMBA_POWER,30.))
call TimerStart(razeTimer,RMinBJ(6.*IMBA_POWER,30.),false,function B906RazeExpire)
else
call SaveReal(L7,razeKey,4,GetGameTime()+6.)
call TimerStart(razeTimer,6.,false,function B906RazeExpire)
endif
set razeTimer=null
set razeDeath=null
return razeBonus
endfunction
function CBD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local unit BB7
local group g=WS7()
local real W27=GetUnitFacing(WX7)
local real x
local real y
local real Xww=0
local unit u2
local integer id=B287_GetSpellAbilityId()
local integer BC7=B287_GetUnitAbilityLevel(WX7,id)
local real AGI=0.
local real d=75*BC7+25
local integer i1=GetUnitTypeId(WX7)
local boolean suijiShadowRazeAgh=SuijiMode_ScepterRegistryIsActive(WX7,'A0EY')
local string suijiShadowRazeAghText="0"
if suijiShadowRazeAgh then
	set suijiShadowRazeAghText="1"
	set AGI=GetHeroAgi(WX7,true)*.5
	set d=d+AGI
endif
if SUIJI_MODE and SUIJI_AGH_DEBUG[GetPlayerId(GetOwningPlayer(WX7))] then
call DisplayTextToPlayer(GetOwningPlayer(WX7),0,0,"|cFFFF8080[A杖诊断:影压]|r skill="+GetAbilityName(id)+" state="+suijiShadowRazeAghText+" 等级="+I2S(BC7)+" 基础="+R2S(75*BC7+25)+" 敏捷加成="+R2S(AGI)+" 最终="+R2S(d))
endif
if id=='A0EY' then
set Xww=200.
elseif id=='A0FH' then
set Xww=450.
elseif id=='A0F0' then
set Xww=700.
endif
set x=GetUnitX(WX7)+Xww*Cos(W27*bj_DEGTORAD)
set y=GetUnitY(WX7)+Xww*Sin(W27*bj_DEGTORAD)
if i1=='Zfir' or i1=='Zgir' then
	call DestroyEffect(AddSpecialEffect("model\\Hero_ShadowFiend_N8S_X_Boom.mdl",x,y))
elseif i1=='Zhir' then
	call DestroyEffect(AddSpecialEffect("model\\Hero_ShadowFiend_N4S_X_Boom.mdl",x,y))
else
	set BB7=CreateUnit(GetOwningPlayer(WX7),'e006',x,y,0)
	call UnitApplyTimedLife(BB7,'BTLF',2)
endif
call GroupEnumUnitsInRange(g,x,y,275,Condition(function CZD))
loop
set u2=FirstOfGroup(g)
exitwhen u2==null
call B67(WX7,u2,1,d+B906RazeBonus(WX7,u2,BC7))
call GroupRemoveUnit(g,u2)
endloop
call WR7(g)
set WX7=null
set BB7=null
set g=null
set suijiShadowRazeAghText=null
endfunction
function I48 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function CBD)
call TriggerAddCondition(t,Condition(function CYD))
set t=null
endfunction
function Necromastery_SyncSoulLevel takes unit u,integer level returns boolean
local boolean soulWasPresent=false
local integer h=0
local integer damageKey=StringHash("NecromasteryDamageContribution")
local real applied=0.
local real desired=0.
if u==null or GetUnitTypeId(u)==0 or level<1 then
return false
endif
set h=GetHandleId(u)
set soulWasPresent=GetUnitAbilityLevel(u,'A0CQ')>0
// Soul gain/loss is a high-frequency stat transition.  Keep A0CQ as the soul
// level marker, but apply A4CE's former 0..36 fixed attack contribution through
// the native unit-state field so no visible or player-disabled helper is needed.
if soulWasPresent==false then
if UnitAddAbility(u,'A0CQ')==false then
return false
endif
call UnitMakeAbilityPermanent(u,true,'A0CQ')
endif
if GetUnitAbilityLevel(u,'A0CQ')!=level then
call SetUnitAbilityLevel(u,'A0CQ',level)
endif
if GetUnitAbilityLevel(u,'A0CQ')!=level then
if soulWasPresent==false then
call UnitRemoveAbility(u,'A0CQ')
endif
return false
endif
if GetUnitAbilityLevel(u,'A4CE')>0 then
call UnitRemoveAbility(u,'A4CE')
endif
set applied=LoadReal(L7,h,damageKey)
set desired=I2R(level-1)
call SetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BONUS,GetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BONUS)-applied+desired)
call SaveReal(L7,h,damageKey,desired)
return true
endfunction
function CCD takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if B287_GetLearnedSkill()=='A0EY' then
if B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0EY')==1 then
call UnitAddAbility(b1060GetTriggerUnit,'A0F0')
call UnitAddAbility(b1060GetTriggerUnit,'A0FH')
else
call SetUnitAbilityLevelSwapped('A0F0',b1060GetTriggerUnit,B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0EY'))
call SetUnitAbilityLevelSwapped('A0FH',b1060GetTriggerUnit,B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0EY'))
endif
endif
if B287_GetLearnedSkill()=='A0BR' then
if B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0BR')==1 then
call Necromastery_SyncSoulLevel(b1060GetTriggerUnit,1)
endif
endif
set b1060GetTriggerUnit=null
endfunction
function RM takes nothing returns nothing
set DK=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(DK,EVENT_PLAYER_HERO_SKILL)
call TriggerAddAction(DK,function CCD)
endfunction
function R7m_EFFECT takes nothing returns nothing
	local unit u = M7[GetPlayerId(GetOwningPlayer(Wave_Sou))]
	local integer level = Wave_LV
    local real d = (50 + 50 * level)*0.4
    if UnitAlive(u) and GetWidgetLife(u)!=GetUnitState(u,UNIT_STATE_MAX_LIFE) then
        call SetWidgetLife(u,d+GetWidgetLife(u))
    endif
	set u = null
endfunction
function R7m takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
local integer BC7=LoadInteger(L7,I97,1)
local integer CLD=LoadInteger(L7,I97,0)
local integer C1D=CLD
local integer i
local integer k
local real a
local real x=0.
local real y=0.
local real r
local player p=null
local real dx
local real dy
local integer id=0
local real length=1000
if u==null or GetUnitTypeId(u)==0 then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(L7,I97)
set u=null
set t=null
return
endif
set x=GetUnitX(u)
set y=GetUnitY(u)
set p=GetOwningPlayer(u)
set id=GetUnitTypeId(u)
set C1D=C1D/2
set a=360./(C1D*1.)
set i=1
set k=C1D
loop
exitwhen i>k
set r=i*a*bj_DEGTORAD
set dx=X17(x+length*(Cos(r)))
set dy=X07(y+length*(Sin(r)))
call Wave(u,'h0HN', (50 + 50 * BC7)*0.4, length, 125, 450, dx, dy, x, y, 700, 1, false, "R7m_EFFECT", BC7)
set i=i+1
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(L7,I97)
set u=null
set p=null
set t=null
endfunction
function R7n takes unit u,integer CLD,integer BC7 returns nothing
local timer t=CreateTimer()
local integer I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,0,u)
call SaveInteger(L7,I97,0,CLD)
call SaveInteger(L7,I97,1,BC7)
// call SaveReal(L7,I97,0,1000./700.)
// call TimerStart(t,LoadReal(L7,I97,0),false,function R7m)
// call SaveReal(L7,I97,0,1000./700.)
// call TimerStart(t,LoadReal(L7,I97,0),false,function R7m)
// call SaveReal(L7,I97,0,1000./700.)
// call TimerStart(t,LoadReal(L7,I97,0),false,function R7m)
call TimerStart(t,1.43,false,function R7m)
set t=null
endfunction
