local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A2V7')
local real d
local real GKD=(LoadReal(L7,(GetHandleId(IH7)),(807)))
local real earthLifeBefore1099=0.
local real earthLifeAfter1099=0.
local real earthHeal1099=0.
