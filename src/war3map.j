// B1001: native unit checks only, never live ability-instance inspection.
function B1001SnakeLive takes unit snakeUnit1001 returns boolean
return snakeUnit1001!=null and GetUnitTypeId(snakeUnit1001)!=0 and UnitAlive(snakeUnit1001)
endfunction
function B1001SnakeFinish takes trigger snakeTrigger1001,unit snakeMissile1001,group snakeHits1001,integer snakeIndex1001 returns nothing
call DisableTrigger(snakeTrigger1001)
call TP7(snakeIndex1001)
if B1001SnakeLive(snakeMissile1001) then
call KillUnit(snakeMissile1001)
endif
if snakeHits1001!=null then
call DestroyGroup(snakeHits1001)
endif
call NM7(GetHandleId(snakeTrigger1001))
call OZ7(snakeTrigger1001)
endfunction
function A6D takes nothing returns boolean
local real d
if B1001SnakeLive(GetFilterUnit()) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(RE4)) and IsUnitInGroup(GetFilterUnit(),RG4)==false and AM7(GetFilterUnit(),GetOwningPlayer(RF4))==false then
set d=KF7(GetUnitX(GetFilterUnit()),GetUnitY(GetFilterUnit()),GetUnitX(RE4),GetUnitY(RE4))
if d<VZ then
set RD4=GetFilterUnit()
set VZ=d
endif
endif
return false
endfunction
function ALD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit BB7=O77(OB7,"Caster")
local integer V77=OM7(OB7,"Level")
local integer HaveA=OM7(OB7,"HaveA")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local unit target=O77(OB7,"target")
local group A1D=OF7(OB7,"AlreadyHit")
local real A0D=ON7(OB7,"StolenMana")
local real A5D=ON7(OB7,"ManaCounter")
local real A2D=ON7(OB7,"DmgCounter")
local real T98
local group g
local real a
local real x
local real y
local boolean snakeDone1001=false
local real snakeMana1001=0.
local real snakeMaxMana1001=0.
call DisableTrigger(t)
if p5==null or GetUnitTypeId(p5)==0 or not B1001SnakeLive(BB7) then
    set snakeDone1001=true
elseif m5==null or GetUnitTypeId(m5)==0 then
    call TP7(B07)
    set B07=TS7(p5)
    call NP7(OB7,"TargetIndex",B07)
    set m5=p5
endif
if not snakeDone1001 then
set a=Atan2(GetUnitY(m5)-GetUnitY(BB7),GetUnitX(m5)-GetUnitX(BB7))
if p5==m5 then
    set x=GetUnitX(BB7)+30*Cos(a)
    set y=GetUnitY(BB7)+30*Sin(a)
else
    set x=GetUnitX(BB7)+25*Cos(a)
    set y=GetUnitY(BB7)+25*Sin(a)
endif
call SetUnitX(BB7,x)
call SetUnitY(BB7,y)
if BlockUnitPass(BB7) then
    set snakeDone1001=true
elseif KF7(x,y,GetUnitX(m5),GetUnitY(m5))<60 then
    set x=GetUnitX(m5)
    set y=GetUnitY(m5)
    call SetUnitX(BB7,x)
    call SetUnitY(BB7,y)
    if p5==m5 then
        if B1001SnakeLive(p5) and A0D>0. then
            set snakeMana1001=GetUnitState(p5,UNIT_STATE_MANA)
            set snakeMaxMana1001=GetUnitState(p5,UNIT_STATE_MAX_MANA)
            if snakeMaxMana1001>0. and snakeMana1001<snakeMaxMana1001 then
                call SetUnitState(p5,UNIT_STATE_MANA,RMinBJ(snakeMaxMana1001,snakeMana1001+A0D))
            endif
        endif
        set snakeDone1001=true
    else
        if B1001SnakeLive(m5) and (AK7(m5)==false or IsUnitVisible(m5,GetOwningPlayer(BB7))) then
            if(GetUnitAbilityLevel(m5,'B0BQ')>0)then
                call B67(p5,m5,3,(40+40*V77)+.35*A2D*(40+40*V77))
            else
                call B67(p5,m5,1,(40+40*V77)+.35*A2D*(40+40*V77))
            endif
            if HaveA>0 and B1001SnakeLive(m5) then
                call CommonUnitAddStun(m5,1+.2*A2D,false)
                if B1001SnakeLive(m5) then
                    call Z57(m5,'A4G9',1,1+.2*A2D,0)
                endif
            endif
            set A2D=A2D+1
            // Revalidate after synchronous damage, stun and helper callbacks.
            if B1001SnakeLive(m5) then
                set snakeMana1001=GetUnitState(m5,UNIT_STATE_MANA)
                set snakeMaxMana1001=GetUnitState(m5,UNIT_STATE_MAX_MANA)
                if snakeMana1001>0. and snakeMaxMana1001>0. then
                    set T98=RMinBJ(snakeMana1001,(.08+.03*V77)*snakeMaxMana1001)
                    call SetUnitState(m5,UNIT_STATE_MANA,RMaxBJ(0.,snakeMana1001-T98))
                    call Y17(oI,x,y)
                    set A0D=A0D+T98
                    set A5D=A5D+1
                endif
            endif
            if m5==target and B1001SnakeLive(m5) and p5!=null and GetUnitTypeId(p5)!=0 then
                call LINGXIA(p5,target)
            endif
        endif
        call NQ7(OB7,"StolenMana",(A0D)*1.)
        call NQ7(OB7,"DmgCounter",(A2D)*1.)
        call NQ7(OB7,"ManaCounter",(A5D)*1.)
        set g=WS7()
        set RD4=null
        set RE4=m5
        set RG4=A1D
        set VZ=99999
        set RF4=p5
        if p5!=null and GetUnitTypeId(p5)!=0 and m5!=null and GetUnitTypeId(m5)!=0 then
            call GroupEnumUnitsInRange(g,x,y,525,Condition(function A6D))
        endif
        call WR7(g)
        if RD4==null or A2D>=(2+V77)then
            call NP7(OB7,"TargetIndex",TS7(p5))
        else
            call NP7(OB7,"TargetIndex",TS7(RD4))
            call GroupAddUnit(A1D,RD4)
        endif
    endif
    if not snakeDone1001 then
        call TP7(B07)
    endif
endif
endif
if snakeDone1001 then
    call B1001SnakeFinish(t,BB7,A1D,B07)
else
    call EnableTrigger(t)
endif
set t=null
set p5=null
set m5=null
set g=null
set BB7=null
set A1D=null
set target=null
return false
endfunction
function A_D takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=0
local integer HaveA=0
local trigger t=null
local integer OB7=0
local group g=null
local real A2D=0
local real A5D=0
local real A0D=0
local unit BB7=null
if not B1001SnakeLive(p5) or not B1001SnakeLive(m5) then
set p5=null
set m5=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
// A projectile-long hit record must not occupy the shared short-lived group pool.
set g=CreateGroup()
set BB7=CreateUnit(GetOwningPlayer(p5),'h090',GetUnitX(p5),GetUnitY(p5),GetUnitFacing(p5))
set V77=SuijiMode_GetPairCastLevel(p5,B287_GetSpellAbilityId(),'A0G2','A2ZD')
if SuijiMode_ScepterRegistryIsActive(p5,'A0G2') then
set HaveA=1
endif
call Y17(eI,GetUnitX(p5),GetUnitY(p5))
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function ALD))
call NB7(OB7,"AlreadyHit",g)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Caster",BB7)
call NP7(OB7,"Level",V77)
call NP7(OB7,"HaveA",HaveA)
call NP7(OB7,"TargetIndex",TS7(m5))
call NP7(OB7,"Count",0)
call NQ7(OB7,"StolenMana",(A0D)*1.)
call NQ7(OB7,"DmgCounter",(A2D)*1.)
call NQ7(OB7,"ManaCounter",(A5D)*1.)
call NT7(OB7,"target",m5)
call GroupAddUnit(g,m5)
set p5=null
set m5=null
set t=null
set g=null
set BB7=null
endfunction
function B4D takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A0G2' or B287_GetSpellAbilityId()=='A2ZD') and WQ7(GetSpellTargetUnit())==false then
call A_D()
endif
return false
endfunction
