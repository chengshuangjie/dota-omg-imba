function Q6G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer level=(LoadInteger(L7,(I97),(10)))
local integer QSG=GetTriggerEvalCount(t)
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif QSG==4 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
if(OT7(IH7,"DisruptionState"))then
call SetUnitInvulnerable(IH7,false)
endif
if GetUnitAbilityLevel(IH7,'B0D9')>0 then
call B67(ZX7,IH7,1,100+100*level)
endif
if(OT7(IH7,"DisruptionState"))then
call SetUnitInvulnerable(IH7,true)
endif
call UnitRemoveAbility(IH7,'A2ZX')
call UnitRemoveAbility(IH7,'B0D9')
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function QLG_Damage takes unit ZX7,unit IH7,integer level returns nothing
local trigger t
local integer I97
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
return
endif
if UnitAlive(IH7) then
    set t=CreateTrigger()
    set I97=GetHandleId(t)
    call XF7(IH7,'A2ZX')
    call TriggerRegisterTimerEvent(t,1,true)
    call TriggerAddCondition(t,Condition(function Q6G))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveUnitHandle(L7,(I97),(17),(IH7))
    call SaveInteger(L7,(I97),(10),(level))
    call TriggerEvaluate(t)
endif
set t=null
endfunction
function QLG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer OB7=0
local integer N5E=0
local real WF8
local integer skill=0
local unit oA
local integer level=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
set oA=null
return
endif
set OB7=Get_Multiple_Skill_Key(ZX7,'A2ZM')
set N5E=(LoadInteger(MSK,(OB7),(30)))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
set level=Multiple_Skill_Level(ZX7,'A2ZM','A2ZN')+Labike_Multiple_Skill_Level(ZX7,'A2ZM')
if N5E>0 then
    if WQ7(IH7) then
        call PLK(IH7)
    else
        call RemoveUnitGoodBuff(IH7,false)
        call RemoveRYBF(IH7)
        call LINGXIA(ZX7,IH7)
        call QLG_Damage(ZX7,IH7,level)
        set oA=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
        if SuijiMode_EnsureExactLiveAbilityLevel(oA,'A4KE',1,false) then
        call B947IssueTargetOrder("QLG @ war3map.j:203249 (B968)",oA,"purge",IH7)
        endif
    endif
    call UnitRemoveAbility(ZX7,skill)
    set N5E=N5E-1
    call SaveInteger(MSK,(OB7),(30),(N5E))
    set skill=(LoadInteger(MSK,(OB7),(N5E)))
    if SuijiMode_EnsureExactLiveAbilityLevel(ZX7,skill,level,true) then
    call Multiple_Skill_SyncButton(ZX7,skill)
    call Reset_Skill_range(ZX7)
    endif
    call DGBD(ZX7,IH7)
else
    call X377(GetOwningPlayer(ZX7),"无可用次数")
endif
if N5E==0 then
    set WF8=(LoadReal(MSK,(OB7),(50)))
    if WF8>0 then
        call Multiple_Skill_StartZeroCooldown(ZX7,skill,WF8)
        call TimerStart(N84[GetPlayerId(GetOwningPlayer(ZX7))],WF8,false,null)
    endif
endif
set ZX7=null
set IH7=null
set oA=null
endfunction
function Q1G takes nothing returns boolean
local unit suijiDemonicPurgeCaster=GetTriggerUnit()
local unit suijiDemonicPurgeTarget=GetSpellTargetUnit()
if (B287_GetSpellAbilityId()=='A1SA' or B287_GetSpellAbilityId()=='A2ZU' or B287_GetSpellAbilityId()=='A2ZV' or B287_GetSpellAbilityId()=='A2ZW') and suijiDemonicPurgeCaster!=null and suijiDemonicPurgeTarget!=null and GetUnitTypeId(suijiDemonicPurgeCaster)!=0 and GetUnitTypeId(suijiDemonicPurgeTarget)!=0 then
    call QLG()
endif
set suijiDemonicPurgeCaster=null
set suijiDemonicPurgeTarget=null
return false
endfunction
