//光击阵
function GJZ2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit u=(O77(I97,"Source"))
local real x=(ON7(I97,"LocationX"))
local real y=(ON7(I97,"LocationY"))
local unit m5
local integer id=GetUnitTypeId(u)
local integer BC7=B287_GetUnitAbilityLevel(u,'A027')
local real YM7=40+BC7*40
local string skilltx
local string skilltx2
local group g=WS7()
if id=='Z004' then
set skilltx="model\\Hero_Slayer_N8S_T_MagicMatrix.mdl"
set skilltx2="model\\Hero_Slayer_N8S_T_Blast.mdl"
call YT7(skilltx,x,y,1)
call YT7(skilltx2,x,y,1)
else
call YT7("tx\\lina\\Lina_T.mdl",x,y,1)
endif
call Y67(x,y,225)
set U22 = u
call GroupEnumUnitsInRange(g, x, y,225+25, Condition(function DJX))
loop
	set m5 = FirstOfGroup(g)
exitwhen m5 == null
	call B67(u, m5, 1, YM7)
    call CommonUnitAddStun(m5, 1.3+0.3*BC7, false)
	call GroupRemoveUnit(g, m5)
endloop
call WR7(g)
call NM7(I97)
call OZ7(t)
set g=null
set t=null
set u=null
set m5=null
return false
endfunction
function GJZ takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local integer id=GetUnitTypeId(u)
local real d=0.5
if SuijiMode_ScepterRegistryIsActive(u,'A027') then
set d=0.
endif
call TriggerRegisterTimerEvent(t,d,false)
call TriggerAddCondition(t,Condition(function GJZ2))
call NT7(I97,"Source",u)
call NQ7(I97,"LocationX",x)
call NQ7(I97,"LocationY",y)
set u=null
set t=null
endfunction
function LPZ takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local integer level = B287_GetUnitAbilityLevel(u, 'A01F')
	local real x = GetUnitX(u)
	local real y = GetUnitY(u)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1275+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1225+ZZMF
    else
    set length=1075+ZZMF
    endif
    call Wave(u,'h0HI', 40 + 70 * level, length, 275, 275, x, y, GetSpellTargetX(), GetSpellTargetY(), 1200, 1, false, "", level)
    set u=null
endfunction
function SMZ takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer id=GetUnitTypeId(u)
local integer BC7=B287_GetUnitAbilityLevel(u,'A01P')
local real d
if id=='Z004' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Slayer_N8S_G_star.MDX",m5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Slayer_N8S_G_Caster.MDX",u,"origin"))
call MA9("HVDG12",u,m5,1,1,1,1,.5)
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",m5,"origin"))
call MA9("CLPB",u,m5,1,1,1,1,.5)
endif
set d=250.+200.*BC7
if SuijiMode_ScepterRegistryIsActive(u,'A01P') then
call B67(u,m5,7,d)
else
call B67(u,m5,1,d)
endif
call LINGXIA(u,m5)
set u=null
set m5=null
endfunction
function Z13 takes nothing returns boolean
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
local integer skill=B287_GetSpellAbilityId()
if(skill=='A027') then
call GJZ()
endif
if(skill=='A01P' or skill=='A09Z') and WQ7(b1060GetSpellTargetUnit)==false then
call SMZ()
endif
if(skill=='A01F')then
call LPZ()
endif
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function ZO3 takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetSpellAbilityId()=='A01P' and WF7(GetSpellTargetUnit()) then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),GetObjectName('n0LR'))
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function NF8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function ZO3))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Z13))
set t=null
endfunction
function KHG takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local trigger t=b1060GetTriggeringTrigger
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local unit IH7=O77(I97,"Target")
local integer WF8=OM7(GetHandleId(IH7),"StickyNapalm|Count")
local boolean KIG=OO7(I97,"Locked")
local real YM7
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call SetUnitTurnSpeed(IH7,GetUnitDefaultTurnSpeed(IH7))
call NP7(GetHandleId(IH7),"StickyNapalm|Count",0)
call NM7(I97)
call OZ7(t)
call YW8(IH7,0,0)
elseif WF8==0 then
call SetUnitTurnSpeed(IH7,GetUnitDefaultTurnSpeed(IH7))
call NP7(GetHandleId(IH7),"StickyNapalm|Count",0)
call NM7(I97)
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and KIG==false then
if WF8>0 and B287_GetUnitAbilityLevel(b1060GetEventDamageSource,'A1EL')>0 and O77(GetHandleId(b1060GetTriggeringTrigger),"Source")==b1060GetEventDamageSource then
call NS7(I97,"Locked",true)
if S44 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LordofFlameMissile\\LordofFlameMissile.mdl",IH7,"chest"))
set YM7=.5*(14+4*B287_GetUnitAbilityLevel(ZX7,'A1EL'))*WF8
elseif bJ==false and b1060GetEventDamage>$C then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LordofFlameMissile\\LordofFlameMissile.mdl",IH7,"chest"))
set YM7=(14+4*B287_GetUnitAbilityLevel(ZX7,'A1EL'))*WF8
endif
if IsUnitType(IH7,UNIT_TYPE_HERO)==false then
set YM7=YM7*0.5
endif
if S44 then
call B67(ZX7,IH7,1,YM7)
elseif bJ==false and b1060GetEventDamage>$C then
call B67(ZX7,IH7,1,YM7)
endif
call NS7(I97,"Locked",false)
endif
else
call SetUnitTurnSpeed(IH7,GetUnitDefaultTurnSpeed(IH7)*.3)
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function KJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(O77(I97,"Source"))
local unit IH7=(O77(I97,"Target"))
local real ZV8=(ON7(GetHandleId(IH7),"StickyNapalm|LastTime"))
local integer StickyCount=(OM7(GetHandleId(IH7),"StickyNapalm|Count"))
if(TimerGetElapsed(W))-ZV8>=8 then
call SetUnitTurnSpeed(IH7,GetUnitDefaultTurnSpeed(IH7))
call NP7(GetHandleId(IH7),"StickyNapalm|Count",0)
call YW8(IH7,0,0)
endif
call NM7(I97)
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function KKG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetEnumUnit()
local trigger t
local integer I97
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A1EL')
local integer layer
local boolean b=false
if WF7(IH7)then
set ZX7=null
set IH7=null
return
endif
set layer=OM7(GetHandleId(IH7),"StickyNapalm|Count")
if layer==0 then
    set b=true
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A1EL') then
    set layer=IMinBJ(layer+2,10)
else
    set layer=IMinBJ(layer+1,10)
endif
call YW8(IH7,BC7,layer)
call NP7(GetHandleId(IH7),"StickyNapalm|Count",layer)
call NQ7(GetHandleId(IH7),"StickyNapalm|LastTime",(TimerGetElapsed(W))*1.)
call SetUnitTurnSpeed(IH7,GetUnitDefaultTurnSpeed(IH7)*.3)
if IsUnitType(IH7,UNIT_TYPE_HERO) then
call YX7(GetOwningPlayer(ZX7),I2S(layer),2,IH7,.026,255,255,0,$D8)
endif
if b then
set t=CreateTrigger()
set I97=GetHandleId(t)
call NT7(I97,"Source",ZX7)
call NT7(I97,"Target",IH7)
call NS7(I97,"Locked",false)
call B1023RegisterDamage(t,IH7)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function KHG))
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,8,false)
call TriggerAddCondition(t,Condition(function KJG))
call NT7(I97,"Source",ZX7)
call NT7(I97,"Target",IH7)
set t=null
set ZX7=null
set IH7=null
endfunction
function KMG takes nothing returns nothing
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local group g=WS7()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local unit p5=(b1061SavedGetTriggerUnit)
call GroupEnumUnitsInRange(g,x,y,400,Condition(function AW7_gai))
call ForGroup(g,function KKG)
call Y57(GetOwningPlayer(p5),2,x,y,500)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x,y+$82))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x,y-$82))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x+$82,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x+$82,y+$82))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x+$82,y-$82))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x-$82,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x-$82,y+$82))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadBlood\\UndeadBloodGargoyle.mdl",x-$82,y-$82))
call RemoveLocation(l)
call WR7(g)
set g=null
set l=null
set p5=null
set b1061SavedGetTriggerUnit=null
endfunction
