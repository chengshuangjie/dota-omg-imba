function B1060PhantomStrikeResume takes nothing returns nothing
local timer b1060Owned_tm=GetExpiredTimer()
local integer key=GetHandleId(b1060Owned_tm)
local unit source=LoadUnitHandle(L7,key,0)
local unit target=LoadUnitHandle(L7,key,1)
call PauseTimer(b1060Owned_tm)
call FlushChildHashtable(L7,key)
call DestroyTimer(b1060Owned_tm)
if source!=null and target!=null and UnitAlive(source) and UnitAlive(target) then
call B947IssueTargetOrderById("B1060PhantomStrikeResume",source,$D000F,target)
endif
set source=null
set target=null
set b1060Owned_tm=null
endfunction
function LZD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer V77=B287_GetUnitAbilityLevel(p5,'A0PL')
local trigger t
local integer OB7
local timer resume1060=null
call DestroyEffect(AddSpecialEffect("war3mapImported\\PhantomStrike.mdx",GetUnitX(p5),GetUnitY(p5)))
call SetUnitX(p5,GetUnitX(m5))
call SetUnitY(p5,GetUnitY(m5))
if IsUnitAlly(p5,GetOwningPlayer(m5))==false then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call XF7(p5,'A1CO')
call NP7(GetHandleId(p5),"Count",0)
call NT7(GetHandleId(p5),"Target",m5)
call B947IssueTargetOrderById("LZD @ war3map.j:103872 (B968)",p5,$D000F,m5)
if(GetPlayerController(GetOwningPlayer(p5))!=MAP_CONTROL_USER)then
set resume1060=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(resume1060),0,p5)
call SaveUnitHandle(L7,GetHandleId(resume1060),1,m5)
call TimerStart(resume1060,.01,false,function B1060PhantomStrikeResume)
set resume1060=null
endif
call LINGXIA(p5,m5)
call TriggerRegisterTimerEvent(t,3,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function LYD))
call NT7(OB7,"Source",p5)
call NP7(OB7,"TargetIndex",TS7(m5))
endif
set p5=null
set m5=null
set t=null
endfunction
function LAD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0PL' then
call LZD()
endif
return false
endfunction
function LBD takes unit p5 returns nothing
local integer OB7=GetHandleId(p5)
local unit m5=O77(OB7,"Target")
local integer SV9=OM7(OB7,"Count")
local integer V77=B287_GetUnitAbilityLevel(p5,'A0PL')
if GetTriggerUnit()!=m5 or SV9>=2+2*V77 then
call UnitRemoveAbility(p5,'A1CO')
call RemoveSavedHandle(L7,OB7,StringHash("Target"))
call RemoveSavedInteger(L7,OB7,StringHash("Count"))
else
set SV9=SV9+1
call NP7(OB7,"Count",SV9)
endif
set m5=null
