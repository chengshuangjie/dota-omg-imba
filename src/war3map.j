// B848: preserve native Carrion Swarm damage on its alternate physical copy.
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,2,'A078','YE1G')
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,1,'YE1G','A078')
call SaveStr(SUIJI_FIXED_CLONE_TABLE,3,'A078',"shockwave")
call MHAbility_SetHookOrder('YE1G',OrderId("shockwave"))
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,2,'A2QB','YE1H')
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,1,'YE1H','A2QB')
call SaveStr(SUIJI_FIXED_CLONE_TABLE,3,'A2QB',"shockwave")
// B1086: Windrun and both Pulse Nova start faces actually own berserk.
// B1088: the conflicting copy owns ANcl.DataF; do not hook its native order.
// B1090: fanofknives belongs to native Diabolic Edict, too.
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,2,'A14I','YE1I')
call SaveInteger(SUIJI_FIXED_CLONE_TABLE,1,'YE1I','A14I')
call SaveStr(SUIJI_FIXED_CLONE_TABLE,3,'A14I',"ancestralspirit")
// Non-ANcl copies retain their native implementation; only their alternate copies get a hook order.
call MHAbility_SetHookOrder('YE0A',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE01',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE03',OrderId("impale"))
call MHAbility_SetHookOrder('YE04',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE05',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE08',OrderId("impale"))
call MHAbility_SetHookOrder('YE0C',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0D',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0E',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0G',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0H',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0I',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0J',OrderId("impale"))
call MHAbility_SetHookOrder('YE0K',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0L',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0M',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0P',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0R',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0S',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0T',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE0W',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0X',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE0Z',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE11',OrderId("impale"))
call MHAbility_SetHookOrder('YE13',OrderId("soulburn"))
call MHAbility_SetHookOrder('YE14',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE15',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE1B',OrderId("frenzy"))
call MHAbility_SetHookOrder('YE1C',OrderId("impale"))
call MHAbility_SetHookOrder('YE1D',OrderId("impale"))
endfunction
function SuijiMode_GuardianAngelAlternateCast takes nothing returns boolean
local unit suijiGuardianAlternateCaster=GetTriggerUnit()
local unit suijiGuardianAlternateDummy=null
local integer suijiGuardianAlternateLevel=0
local integer suijiGuardianAlternateEffectSkill='A0ER'
if SUIJI_MODE and suijiGuardianAlternateCaster!=null and GetUnitTypeId(suijiGuardianAlternateCaster)!=0 and B287_GetSpellAbilityId()=='A0ER' and B287_UsesAlternateCarrier(suijiGuardianAlternateCaster,'A0ER') then
set suijiGuardianAlternateLevel=B287_GetUnitAbilityLevel(suijiGuardianAlternateCaster,'A0ER')
if suijiGuardianAlternateLevel>0 then
if SuijiMode_ScepterRegistryIsActive(suijiGuardianAlternateCaster,'A0ER') then
set suijiGuardianAlternateEffectSkill='A2U2'
endif
set suijiGuardianAlternateDummy=CreateUnit(GetOwningPlayer(suijiGuardianAlternateCaster),'e00E',GetUnitX(suijiGuardianAlternateCaster),GetUnitY(suijiGuardianAlternateCaster),0.)
call XF7(suijiGuardianAlternateDummy,suijiGuardianAlternateEffectSkill)
call SetUnitAbilityLevel(suijiGuardianAlternateDummy,suijiGuardianAlternateEffectSkill,suijiGuardianAlternateLevel)
call B947IssueImmediateOrderById("SuijiMode_GuardianAngelAlternateCast @ war3map.j:191315 (B968)",suijiGuardianAlternateDummy,852599)
call UnitApplyTimedLife(suijiGuardianAlternateDummy,'BTLF',2.)
endif
endif
set suijiGuardianAlternateCaster=null
set suijiGuardianAlternateDummy=null
return false
endfunction
function SuijiMode_GuardianAngelAlternateInit takes nothing returns nothing
local trigger suijiGuardianAlternateTrigger=CreateTrigger()
call YB7(suijiGuardianAlternateTrigger,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(suijiGuardianAlternateTrigger,Condition(function SuijiMode_GuardianAngelAlternateCast))
set suijiGuardianAlternateTrigger=null
endfunction
