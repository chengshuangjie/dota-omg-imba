call SetUnitInvulnerable(WI7,false)
endif
call OX7(WI7,"Omnislashing")
call SetUnitVertexColor(WI7,$FF,$FF,$FF,$FF)
call UnitRemoveAbility(WI7,'A04R')
endif
endif
set t=null
set WI7=null
set Tr=null
set BB7=null
return false
endfunction
