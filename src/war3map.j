if IsUnitType(b1060GetSpellTargetUnit,UNIT_TYPE_HERO)==true or IsUnitIllusion(b1060GetSpellTargetUnit)then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),GetObjectName('n0K9'))
elseif IsUnitType(u,UNIT_TYPE_ANCIENT) or IsUnitType(u,UNIT_TYPE_MAGIC_IMMUNE) or u==V4 then
if SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A28T')==false or b1060GetSpellTargetUnit==V4 then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),GetObjectName('n0K9'))
endif
endif
endif
endif
set u=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function ChenPersuadedOrderAttack takes unit st,unit target returns nothing
local group g=WS7()
local unit u
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(st),Condition(function DWR))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if u!=target and GetWidgetLife(u)>.405 then
call B947IssueTargetOrderById("ChenPersuadedOrderAttack @ war3map.j:68661 (B968)",u,851983,target)
endif
endloop
call WR7(g)
set g=null
set u=null
endfunction
function ChenPersuadedOnAttack takes nothing returns boolean
local unit st=GetAttacker()
local unit target=GetTriggerUnit()
if ChenIsHero(st) and target!=null and IsUnitEnemy(target,GetOwningPlayer(st)) and WQ7(target)==false then
call ChenPersuadedOrderAttack(st,target)
endif
set st=null
set target=null
return false
endfunction
function ChenPersuadedOrderTimer takes nothing returns boolean
local integer i=0
local unit st
local group g
local unit u
loop
exitwhen i>11
set st=M7[i]
if ChenIsHero(st) and GetWidgetLife(st)>.405 then
set g=WS7()
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(st),Condition(function DWR))
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if GetUnitCurrentOrder(u)==0 and IsUnitInRange(u,st,700.)==false then
call B947IssuePointOrderById("ChenPersuadedOrderTimer @ war3map.j:68694 (B968)",u,851986,GetUnitX(st),GetUnitY(st))
endif
endloop
call WR7(g)
set g=null
endif
set i=i+1
endloop
set st=null
set u=null
return false
endfunction
function EX8 takes nothing returns nothing
local trigger t=CreateTrigger()
