function IsDestructableInRange takes real x,real y,real r returns boolean
local rect DB2=Rect(x-r,y-r,x+r,y+r)
local boolean destructableInRangeFound=false
set IM4=999999
set SB=null
set IJ4=x
set IK4=y
call EnumDestructablesInRect(DB2,Condition(function TO7),function DestructableInRange)
if SB !=null then
set destructableInRangeFound=true
endif
call RemoveRect(DB2)
set DB2=null
return destructableInRangeFound
endfunction
function GetDestructableInRange takes real x,real y,real r returns destructable
local rect DB2=Rect(x-r,y-r,x+r,y+r)
set IM4=999999
set SB=null
set IJ4=x
set IK4=y
call EnumDestructablesInRect(DB2,Condition(function TO7),function DestructableInRange)
call RemoveRect(DB2)
set DB2=null
return SB
endfunction
