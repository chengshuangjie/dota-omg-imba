function PD_Alreay_Use2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer O5=LoadInteger(L7,OB7,0)
local integer n=LoadInteger(L7,OB7,1)
local integer skill=LoadInteger(L7,OB7,2)
if (GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()==skill) or GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
	// call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000已经使用物品或超过10秒|r")
    call SaveInteger(TABLE_BUY, O5, n, 0)
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
return false
endfunction
function PD_Alreay_Use takes player p,integer O5,integer n,integer skill returns nothing
    local trigger t=CreateTrigger()
    local integer OB7=GetHandleId(t)
    call TriggerRegisterPlayerUnitEvent(t,p,EVENT_PLAYER_UNIT_SPELL_EFFECT,Condition(function TO7))
    call TriggerRegisterTimerEvent(t,10.,false)
    call TriggerAddCondition(t,Condition(function PD_Alreay_Use2))
    call SaveInteger(L7,OB7,0,O5)
    call SaveInteger(L7,OB7,1,n)
    call SaveInteger(L7,OB7,2,skill)
    set t=null
endfunction
function Record_Buy_Item takes player p,integer O5,integer id returns nothing
    call SaveInteger(TABLE_BUY,O5,BUY[O5] , ZU[id])
    call SaveReal(TABLE_BUY,O5, BUY[O5],GetGameTime())
	if PD_ITEM_SKILL(ZU[id])>0 then
		call PD_Alreay_Use(p,O5,BUY[O5],PD_ITEM_SKILL(ZU[id]))
	 endif
    set BUY[O5]=BUY[O5]+1
endfunction
function Z3X takes unit ZX7, unit u, boolean Z4X, integer Z5X returns nothing
	local integer i = 0
	local item it
	local integer k = 0
	local integer Z6X = 0
	local integer j
	local player p = GetOwningPlayer(u)
	local integer Z7X
	local integer Z8X
	local integer O5=GetPlayerId(p)
	call FlushChildHashtable(TABLE_HY,'ITEM')
	loop
		set it = UnitItemInSlot(ZX7, i)
		if it != null and(GetItemPlayer(it)== p or PK4 or GetPlayerSlotState(GetItemPlayer(it))== PLAYER_SLOT_STATE_LEFT) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			set k = k + 1
		endif
		set it = UnitItemInSlot(u, i)
		if it != null and(GetItemPlayer(it)== p or PK4 or GetPlayerSlotState(GetItemPlayer(it))== PLAYER_SLOT_STATE_LEFT) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			set k = k + 1
		endif
		set i = i + 1
	exitwhen i > 5
	endloop
	set it = null
	if Z4X == false and k <= 6 then
        set p=null
		return
	endif
	set Z6X = k
	set k = 1
	if Z4X then
		set k = Z5X
	endif
	loop
		call SaveInteger(TABLE_HY,'ITEM', 51, FJ4[k])
		call SaveInteger(TABLE_HY,'ITEM', 52, FK4[k])
		call SaveInteger(TABLE_HY,'ITEM', 53, FM4[k])
		call SaveInteger(TABLE_HY,'ITEM', 54, FN4[k])
		call SaveInteger(TABLE_HY,'ITEM', 55, FO4[k])
		set Z8X = 0
		set Z7X = 0
		set i = 0
		if FJ4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FK4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FM4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FN4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		if FO4[k]!= 0 then
			set Z7X = Z7X + 1
		endif
		loop
			set j = LoadInteger(TABLE_HY,'ITEM', i)
			if j > 0 and LoadBoolean(TABLE_HY,'ITEM', i)!= true then
				if(j == LoadInteger(TABLE_HY,'ITEM', 51) and Z2X(TABLE_HY,'ITEM', 51)) or(j == LoadInteger(TABLE_HY,'ITEM', 52) and Z2X(TABLE_HY,'ITEM', 52)) or(j == LoadInteger(TABLE_HY,'ITEM', 53) and Z2X(TABLE_HY,'ITEM', 53)) or(j == LoadInteger(TABLE_HY,'ITEM', 54) and Z2X(TABLE_HY,'ITEM', 54)) or(j == LoadInteger(TABLE_HY,'ITEM', 55) and Z2X(TABLE_HY,'ITEM', 55)) then
					call SaveItemHandle(TABLE_HY,'ITEM', 100 + Z8X, LoadItemHandle(TABLE_HY,'ITEM', i))
					call SaveBoolean(TABLE_HY,'ITEM', i, true)
					call SaveInteger(TABLE_HY,'ITEM',$C8+ Z8X, i)
					set Z8X = Z8X + 1
				endif
			endif
			set i = i + 1
		exitwhen i >= Z6X
		endloop
		if Z8X > 0 then
			set i = 100 
			loop
				if Z8X == Z7X then
					set it = LoadItemHandle(TABLE_HY,'ITEM', i)
					if FP4[k]== DI4 then
						call SaveInteger(TABLE_HY,'ITEM', 300, 12)
                    elseif FP4[k]== VB then
                        call SaveInteger(TABLE_HY,'ITEM', 300, 6)
                    elseif FP4[k]== E1 then
                        call SaveInteger(TABLE_HY,'ITEM', 300, 8)
					elseif FP4[k]== it_dgh then
						if KY7(it)== DY4 then
							call SaveInteger(TABLE_HY,'ITEM', 300, GetItemCharges(it))
						endif
					elseif FP4[k]== DT4 then
						if KY7(it)== ZA then
							call SaveInteger(TABLE_HY,'ITEM', 300, GetItemCharges(it))
						endif
					endif
					call RemoveItem(it)
				else
					call RemoveSavedBoolean(TABLE_HY,'ITEM', LoadInteger(TABLE_HY,'ITEM', 100 + i))
				endif
				call RemoveSavedHandle(TABLE_HY,'ITEM', i)
				set i = i + 1
			exitwhen HaveSavedHandle(TABLE_HY,'ITEM', i)== false
			endloop
		endif
		if Z8X == Z7X then
            if Z4X == false then
				set it = UnitAddItemById(u, ZU[FP4[k]])
				if FP4[k]== DI4 or FP4[k]== DT4 or FP4[k]==it_dgh or FP4[k]== VB or FP4[k]== E1 then
					if HaveSavedInteger(TABLE_HY,'ITEM', 300) then
						call SetItemCharges(it, LoadInteger(TABLE_HY,'ITEM', 300))
						call RemoveSavedInteger(TABLE_HY,'ITEM', 300)
					endif
				endif
				call SetItemPlayer(it, p, true)
				call SetItemUserData(it, 0)
				call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl", u, "origin"))
				set it = null
            else
                set it = CreateItem(SU[FP4[k]], GetUnitX(u), GetUnitY(u))
				call Record_Buy_Item(p,O5,FP4[k])
				if FP4[k]==B5 then
					set BUYSJTIME[GetPlayerId(p)]=GetGameTime()
				if IsPlayerAlly(GetLocalPlayer(),p) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p)]+KZ4[GetPlayerId(p)]+"|r |c00ffff00"+GetObjectName('n0LY')+"|r")
				endif
				endif
				if FP4[k]== DI4 or FP4[k]== DT4 or FP4[k]== it_dgh or FP4[k]== VB or FP4[k]== E1 then
					if HaveSavedInteger(TABLE_HY,'ITEM', 300) then
						call SetItemCharges(it, LoadInteger(TABLE_HY,'ITEM', 300))
						call RemoveSavedInteger(TABLE_HY,'ITEM', 300)
					endif
				endif
				call SetItemPlayer(it, p, true)
				call SetItemUserData(it, 0)
				call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl", u, "origin"))
                call UnitAddItem(u, it)
				set it = null
            endif
			if QuickBuySharedRequestActive and QuickBuySharedRequestPlayerId==O5 and QuickBuySharedExpectedRecipe==k then
				set QuickBuySharedCompleted=true
			endif
		endif
	exitwhen k >= FQ4
		set k = k + 1
	endloop
	set p=null
endfunction
//运输物品
function B1060CourierWork takes nothing returns nothing
local unit courier1060=B1060PendingSource
local integer pid1060=B1060PendingMode
local integer courierMode1061=G97[432+pid1060]
set B1060PendingSource=null
if courier1060!=null and UnitAlive(courier1060) and M7[pid1060]!=null and GetUnitTypeId(M7[pid1060])!=0 and KU4[16+pid1060]==courier1060 and OM7(GetHandleId(courier1060),"aiCrow|CurrentOwner")==pid1060 then
set G97[432+pid1060]=2
call BVE(pid1060,M7[pid1060],false)
set G97[432+pid1060]=courierMode1061
if UnitAlive(courier1060) and KU4[16+pid1060]==courier1060 and OM7(GetHandleId(courier1060),"aiCrow|CurrentOwner")==pid1060 then
call Y8F(courier1060)
endif
endif
call RemoveSavedBoolean(L7,GetHandleId(Player(pid1060)),StringHash("B1061CourierBusy"))
set courier1060=null
endfunction
function B1060StartCourierWork takes unit courier1060,integer pid1060 returns nothing
if LoadBoolean(L7,GetHandleId(Player(pid1060)),StringHash("B1061CourierBusy")) then
return
endif
if B1060CourierAction==null then
set B1060CourierAction=CreateTrigger()
call TriggerAddAction(B1060CourierAction,function B1060CourierWork)
endif
call SaveBoolean(L7,GetHandleId(Player(pid1060)),StringHash("B1061CourierBusy"),true)
set B1060PendingSource=courier1060
set B1060PendingMode=pid1060
call TriggerExecute(B1060CourierAction)
endfunction
function YQF takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit EK9=O77(I97,"Courier")
local unit ZX7=O77(I97,"Source")
local integer i
local player p=GetOwningPlayer(ZX7)
local item D88
local integer O5=GetPlayerId(p)
local boolean deferred1060=false
// RemoveUnit does not follow the hero-death path used by delivery tasks.
if ZX7==null or GetUnitTypeId(ZX7)==0 or EK9==null or GetUnitTypeId(EK9)==0 then
if EK9!=null and OE7(GetHandleId(EK9),"aiCrow|DeliverTrigger")==t then
call NV7(GetHandleId(EK9),"aiCrow|DeliverTrigger",null)
endif
call NM7(I97)
call OZ7(t)
set t=null
set EK9=null
set ZX7=null
set p=null
set b1060GetTriggerEventId=null
return false
endif
if b1060GetTriggerEventId==EVENT_WIDGET_DEATH then
if GetTriggerUnit()==ZX7 then
call Y8F(EK9)
endif
call NM7(I97)
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER then
if(OM7(I97,"OnDelivery"))==1 then
call NP7(I97,"OnDelivery",0)
elseif b1060GetIssuedOrderId!=$D0084 and b1060GetIssuedOrderId!=$D007A and(not QY4[O5]) then
call OZ7(t)
    if b1060GetIssuedOrderId==$D0005 and GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_USER then
        set Upgrade_JJ_FIX_UNIT=ZX7
        call ExecuteFunc("Upgrade_JJ_FIX")
    endif
endif
elseif(QY4[O5]and IG4[O5])then
call Y8F(EK9)
else
if KE7(EK9,ZX7)<200 then
call NM7(I97)
call OZ7(t)
if QY4[O5]and OM7(GetHandleId(EK9),"aiCrow|CurrentOwner")==O5 then
set deferred1060=true
call B1060StartCourierWork(EK9,O5)
else
call Z3X(EK9,ZX7,false,0) //满格合成
call YFF(EK9,ZX7) //传递物品
endif
if not deferred1060 then
call Y8F(EK9)
endif
else
if QY4[O5]then
set IN4=EK9
set i=MP7(800.,IN4,Condition(function BQ7))
if(i==0)then
call YGF(t)
else
call B947IssuePointOrderByIdLoc("YQF @ war3map.j:166381 (B968)",EK9,$D0012,M07(KU4[O5]))
endif
else
call YGF(t)
endif
if(Bz>hq[880+O5])and TZ7(p)and(KE7(EK9,ZX7)<$708)then
call B947IssueImmediateOrderById("YQF @ war3map.j:166387 (B968)",EK9,$D0084)
set hq[880+O5]=Bz+5
endif
endif
endif
set t=null
set EK9=null
set ZX7=null
set D88=null
set p=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function YRF takes unit WX7,boolean YSF returns nothing
local trigger t=null
local integer I97=0
local unit X_8=GetSellingUnit()
local integer YTF=OM7(GetHandleId(X_8),"DeliveryIndex")
local integer O5=GetPlayerId(GetOwningPlayer(WX7))
if WX7!=null then
if QY4[O5]and(OM7(GetHandleId(X_8),"aiCrow|CurrentOwner")==O5)then
set t=OE7(GetHandleId(X_8),"aiCrow|DeliverTrigger")
if(t!=null and IsTriggerEnabled(t))then
set t=null
set X_8=null
return
endif
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
if WX7!=O77(GetHandleId(X_8),"DeliveryTarget"+I2S(YTF))and YSF then
set YTF=YTF+1
call NP7(GetHandleId(X_8),"DeliveryIndex",YTF)
call NT7(GetHandleId(X_8),"DeliveryTarget"+I2S(YTF),(WX7))
endif
call NQ7(I97,"DeliveryTargetX",(GetUnitX(WX7)*1.))
call NQ7(I97,"DeliveryTargetY",(GetUnitY(WX7)*1.))
call B947IssueTargetOrderById("YRF @ war3map.j:166423 (B968)",X_8,$D0012,WX7)
call TriggerRegisterDeathEvent(t,X_8)
call TriggerRegisterDeathEvent(t,WX7)
call TriggerRegisterUnitEvent(t,X_8,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,X_8,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,X_8,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function YQF))
call NT7(I97,"Source",WX7)
call NT7(I97,"Courier",X_8)
call NV7(GetHandleId(X_8),"aiCrow|DeliverTrigger",t)
endif
set t=null
set X_8=null
endfunction
