function T00 takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(I97),2))
local unit m5=(LoadUnitHandle(L7,(I97),17))
local integer BC7=LoadInteger(L7,I97,5)
local real YNG=0.
local boolean suijiLifeDrainScepter=LoadBoolean(L7,I97,15)
local integer suijiLifeDrainMulticastCount=LoadInteger(L7,I97,StringHash("SuijiLifeDrainMulticastCount"))
if suijiLifeDrainMulticastCount<1 then
set suijiLifeDrainMulticastCount=1
endif
if p5==null or m5==null then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or UnitAlive(p5)==false or UnitAlive(m5)==false then
if LoadUnitHandle(L7,GetHandleId(p5),'A0CC')==m5 then
if SUIJI_MODE and LoadBoolean(L7,GetHandleId(p5),StringHash("SuijiDone")) then
if LoadInteger(L7,GetHandleId(p5),StringHash("SuijiA0CCSerial"))==LoadInteger(L7,I97,StringHash("SuijiA0CCSerial")) then
call RemoveSavedHandle(L7,GetHandleId(p5),'A0CC')
endif
else
call RemoveSavedHandle(L7,GetHandleId(p5),'A0CC')
endif
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set YNG=75+75*BC7
if suijiLifeDrainScepter then
set YNG=90+90*BC7
endif
set YNG=YNG*.1
set YNG=YNG*suijiLifeDrainMulticastCount
if GetUnitAbilityLevel(p5,'Bdcl')==0 or(b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and(b1060B287_GetSpellAbilityId=='A0CC' or b1060B287_GetSpellAbilityId=='A02Z'))then
if LoadUnitHandle(L7,GetHandleId(p5),'A0CC')==m5 then
if SUIJI_MODE and LoadBoolean(L7,GetHandleId(p5),StringHash("SuijiDone")) then
if LoadInteger(L7,GetHandleId(p5),StringHash("SuijiA0CCSerial"))==LoadInteger(L7,I97,StringHash("SuijiA0CCSerial")) then
call RemoveSavedHandle(L7,GetHandleId(p5),'A0CC')
endif
else
call RemoveSavedHandle(L7,GetHandleId(p5),'A0CC')
endif
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif b1060GetTriggerEventId!=EVENT_UNIT_SPELL_ENDCAST then
if GetUnitState(p5,UNIT_STATE_LIFE)+YNG>=GetUnitState(p5,UNIT_STATE_MAX_LIFE)then
call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+YNG+GetUnitState(p5,UNIT_STATE_LIFE)-GetUnitState(p5,UNIT_STATE_MAX_LIFE))
endif
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function TII takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function T00))
call SaveUnitHandle(L7,(I97),2,(p5))
call SaveUnitHandle(L7,(I97),17,(m5))
call SaveInteger(L7,I97,5,SuijiMode_GetPairCastLevel(p5,b1060B287_GetSpellAbilityId,'A0CC','A02Z'))
call SaveBoolean(L7,I97,15,SuijiMode_ScepterRegistryIsActive(p5,'A0CC'))
call SaveInteger(L7,I97,StringHash("SuijiLifeDrainMulticastCount"),LoadInteger(L7,GetHandleId(p5),StringHash("SuijiLifeDrainMulticastCount")))
if SUIJI_MODE and p5!=null then
if LoadBoolean(L7,GetHandleId(p5),StringHash("SuijiDone")) then
call SaveInteger(L7,I97,StringHash("SuijiA0CCSerial"),LoadInteger(L7,GetHandleId(p5),StringHash("SuijiA0CCSerial")))
endif
endif
set p5=null
set m5=null
set t=null
endfunction
function YMBH takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer id=GetUnitTypeId(ZX7)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0MT')
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',x,y,0)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call XF7(BB7,'A4GW')
call SetUnitAbilityLevel(BB7,'A4GW',BC7)
call B947IssueBuildOrderById("YMBH @ war3map.j:106052 (B968)",BB7,$D0079,x,y)
set ZX7=null
set BB7=null
endfunction
function TSS takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit suijiA0CCSpellCaster=GetTriggerUnit()
local unit suijiA0CCSpellTarget=GetSpellTargetUnit()
local integer suijiA0CCSpellCasterHandle=0
local integer suijiA0CCSpellSerial=0
if(b1060B287_GetSpellAbilityId=='A0CC' or b1060B287_GetSpellAbilityId=='A02Z')then
if suijiA0CCSpellCaster==null or suijiA0CCSpellTarget==null or GetUnitTypeId(suijiA0CCSpellCaster)==0 or GetUnitTypeId(suijiA0CCSpellTarget)==0 then
set suijiA0CCSpellTarget=null
set suijiA0CCSpellCaster=null
return false
endif
if SUIJI_MODE then
set suijiA0CCSpellCasterHandle=GetHandleId(suijiA0CCSpellCaster)
if LoadBoolean(L7,suijiA0CCSpellCasterHandle,StringHash("SuijiDone")) then
set suijiA0CCSpellSerial=LoadInteger(L7,suijiA0CCSpellCasterHandle,StringHash("SuijiA0CCSerial"))+1
call SaveInteger(L7,suijiA0CCSpellCasterHandle,StringHash("SuijiA0CCSerial"),suijiA0CCSpellSerial)
endif
endif
call SuijiMode_StartPairCooldownSync(suijiA0CCSpellCaster,b1060B287_GetSpellAbilityId,'A0CC','A02Z',"SuijiLifeDrainCooldown",22.,22.,22.,0.,0.,0.)
if IsUnitType(suijiA0CCSpellTarget,UNIT_TYPE_HERO)then
call TII()
endif
call SaveUnitHandle(L7,GetHandleId(suijiA0CCSpellCaster),'A0CC',suijiA0CCSpellTarget)
call LINGXIA(suijiA0CCSpellCaster,suijiA0CCSpellTarget)
endif
if b1060B287_GetSpellAbilityId=='A0MT' then
    call YMBH()
endif
set suijiA0CCSpellTarget=null
set suijiA0CCSpellCaster=null
return false
endfunction
function J11 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function TSS))
set t=null
endfunction
function R25 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit IH7=(LoadUnitHandle(L7,(OB7),(17)))
call SetUnitVertexColor(IH7,$FF,$FF,$FF,$FF)
call DestroyEffect((LoadEffectHandle(L7,(OB7),(32))))
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
set t=null
set IH7=null
return false
endfunction
function R26 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
if u==null or GetUnitTypeId(u)==0 then
call PauseTimer(t)
call FlushChildHashtable(L7,I97)
call DestroyTimer(t)
elseif GetUnitAbilityLevel(u,'B01N')==0 or XH7(u)then
call UnitRemoveAbility(u,LoadInteger(L7,I97,0))
call UnitRemoveAbility(u,LoadInteger(L7,I97,2))
call UnitRemoveAbility(u,'A2WI')
call UnitRemoveAbility(u,'B0HE')
call UnitRemoveAbility(u,'A2WK')
call UnitRemoveAbility(u,'B0HF')
call PauseTimer(t)
call FlushChildHashtable(L7,I97)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function R2A takes unit p5,unit m5,integer BC7 returns nothing
local timer t=CreateTimer()
local integer I97=GetHandleId(t)
local integer id
local integer aYe
local integer applyLevel=BC7
local real duration=3.5*SuijiMode_GetDurationMulticastCount(p5,'A2WJ')
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or BC7<1 or BC7>4 then
call PauseTimer(t)
call DestroyTimer(t)
set t=null
return
endif
if IsPlayerAlly(GetOwningPlayer(p5),GetOwningPlayer(m5))then
set id='A2WL'
set aYe='A2WL'
set applyLevel=1
call XF7(m5,'A2WI')
call SuijiMode_ScheduleDurationBuff(m5,'B01N',0,duration)
else
set id='A2WM'
set aYe='A2WM'
call Z57(m5,'A2WN'-1+BC7,1,duration,'B0HF')
endif
call TimerStart(t,.1,true,function R26)
call SaveUnitHandle(L7,I97,0,m5)
call SaveInteger(L7,I97,0,id)
call R1T(m5,id,applyLevel)
call SaveInteger(L7,I97,2,'A2WN'-1+BC7)
call LINGXIA(p5,m5)
set t=null
endfunction
function R2B takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
local integer BC7=B287_GetUnitAbilityLevel(p5,'A2WJ')
local trigger t
local integer I97
call UnitApplyTimedLife(BB7,'BTLF',1.)
call UnitAddAbility(BB7,'A0CE')
call SetUnitAbilityLevel(BB7,'A0CE',BC7)
call B947IssueTargetOrderById("R2B @ war3map.j:106169 (B968)",BB7,$D0206,m5)
if GetUnitTypeId(m5)=='n0FJ' or GetUnitTypeId(m5)=='n0FI' or GetUnitTypeId(m5)=='n0F6' or GetUnitTypeId(m5)=='n0FH' then
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,3.5,false)
call TriggerRegisterDeathEvent(t,m5)
call TriggerAddCondition(t,Condition(function R25))
