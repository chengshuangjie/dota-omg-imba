call B67(A3,GetEnumUnit(),1,B287_GetUnitAbilityLevel(A3,'A1IM')*75/10)
endfunction
function RTE takes unit ZX7 returns nothing
local real FVE=B287_GetUnitAbilityLevel(ZX7,'A1IM')*75/2
set FVE=FVE/10.
if GetUnitState(ZX7,UNIT_STATE_LIFE)<=FVE*.75 then
set FVE=GetUnitState(ZX7,UNIT_STATE_LIFE)/.75-$A
endif
call B67(ZX7,ZX7,3,FVE)
endfunction
function RUE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=O77(OB7,"Source")
local integer id=OM7(OB7,"ID")
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local group g
local unit BB7
local integer WF8=GetTriggerEvalCount(t)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call NM7(OB7)
call OZ7(t)
return false
else
if GetTriggerEvalCount(t)==1 then
if id=='Z071' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_MurlocNightcrawler_N6S_C_Source_Self.mdl",ZX7,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_MurlocNightcrawler_N6S_C_Source.mdl",ZX7,"origin"))
else
set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0B2',x,y,0)
call UnitApplyTimedLife(BB7,'BTLF',1)
set BB7=null
endif
call TriggerRegisterTimerEvent(t,.1,true)
set g=WS7()
set A3=ZX7
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,350,Condition(function AJ7_gai))
call ForGroup(g,function RSE)
call RTE(ZX7)
call WR7(g)
else
if WF8==$A then
call NM7(OB7)
call OZ7(t)
endif
set g=WS7()
set A3=ZX7
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,350,Condition(function AJ7_gai))
call ForGroup(g,function RSE)
call RTE(ZX7)
call WR7(g)
call YZ8(ZX7)
call YW8(ZX7,0,0)
endif
endif
set t=null
set g=null
set ZX7=null
return false
endfunction
function RVE takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit p5=GetTriggerUnit()
local real YM7=B287_GetUnitAbilityLevel(p5,'A1IM')*75/2
call TriggerRegisterTimerEvent(t,1.5,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function RUE))
call NT7(OB7,"Source",p5)
call NP7(OB7,"ID",GetUnitTypeId(p5))
