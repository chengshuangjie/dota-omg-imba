function ORv takes nothing returns boolean
local unit p5=GetTriggerUnit()
if GetItemTypeId(GetManipulatedItem())==ZU[R1Q]then
if MU7(p5,ZU[R1Q],GetManipulatedItem())==null and CHILLX[GetPlayerId(GetOwningPlayer(p5))]==0 then
call Fee(p5,1)
endif
set p5=null
return false
endif
set p5=null
return false
endfunction
function ONv takes nothing returns nothing
local timer t=GetExpiredTimer()
if GetWidgetLife(LoadItemHandle(L7,GetHandleId(t),0))<.405 then
call SetWidgetLife(LoadItemHandle(L7,GetHandleId(t),0),1.)
call RemoveItem(LoadItemHandle(L7,GetHandleId(t),0))
endif
call FlushChildHashtable(L7,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Obv takes nothing returns boolean
local item b1060GetManipulatedItem=GetManipulatedItem()
local boolean b1060ReturnValue
local timer t
if(GetWidgetLife(b1060GetManipulatedItem)==0)then
set t=CreateTimer()
call TimerStart(t,.0,false,function ONv)
call SaveItemHandle(L7,GetHandleId(t),0,b1060GetManipulatedItem)
set t=null
endif
set b1060ReturnValue=false
set b1060GetManipulatedItem=null
return b1060ReturnValue
endfunction
function Dte takes unit u,integer id returns boolean
if id=='ANcr' then
return GetUnitTypeId(u)!='N01I'
elseif id=='A03G' then
return GetUnitTypeId(u)!='Hlgr'
elseif id=='A093' then
return GetUnitTypeId(u)!='U008'
elseif id=='X093' then
return GetUnitTypeId(u)!='Z008'
elseif id=='X193' then
return GetUnitTypeId(u)!='Z009'
elseif id=='A19Z' then
return GetUnitTypeId(u)!='O016'
elseif id=='A1RI' then
return GetUnitTypeId(u)!='Eevi'
elseif id=='A1TX' then
return GetUnitTypeId(u)!='E02N'
elseif id=='A1WH' then
return GetUnitTypeId(u)!='H001'
elseif id=='X1WH' then
return GetUnitTypeId(u)!='Z001'
elseif id=='A11T' then
return GetUnitTypeId(u)!='Hblm'
elseif id=='A15J' then
return GetUnitTypeId(u)!='H00R'
elseif id=='X15J' then
return GetUnitTypeId(u)!='Z00R'
elseif id=='A2NE' or id=='A3NE' then
return GetUnitTypeId(u)!='N0M7'
endif
return false
endfunction
function FAe takes nothing returns nothing
local integer id=B287_GetSpellAbilityId()
local unit u=GetTriggerUnit()
if Dte(u,id)then
set u=null
return
endif
if HaveSavedString(ZCS,0,id)then
call ExecuteFunc(LoadStr(ZCS,0,id))
endif
if GetUnitAbilityLevel(u,'A2VW')==1 then
// call EE5(u,id,true,25)
call Fee(u,2)
endif
set u=null
endfunction
function nPv takes unit u,unit t returns boolean
local integer id=GetUnitTypeId(t)
if TV7(GetOwningPlayer(u))then
return id=='u00M' or id=='u00D' or id=='u00N' or id=='u00T'
else
return id=='e00R' or id=='e011' or id=='e00S' or id=='e019'
endif
endfunction
function WYSW_UNIT takes unit u returns boolean
local integer uid=GetUnitTypeId(u)
	return uid=='o00T' or  uid=='o00U' or uid=='o00V' or uid=='o00W'
endfunction
//任意单位接收伤害
function Ffe takes nothing returns boolean
local unit m5
local unit ZX7
local unit IH7
local real YM7
local real Fge
local player p=null
local real recover
local real d
local real recover_qsel=0.
set m5=MHEvent_GetUnit()
set ZX7=MHDamageEvent_GetSource() //伤害来源
if m5==null or ZX7==null or GetUnitTypeId(m5)==0 or GetUnitTypeId(ZX7)==0 then
    set m5=null
    set ZX7=null
    return false
endif
if GetUnitAbilityLevel(m5,'Aloc')>0 or GetOwningPlayer(m5)==Player(15) or WYSW_UNIT(ZX7) then
    set m5=null
    set ZX7=null
    return false
endif
set p=GetOwningPlayer(ZX7)
    set bj_cineModePriorFogSetting=(TX7(GetOwningPlayer(ZX7))or TX7(GetOwningPlayer(m5)))
    set YM7=MHDamageEvent_GetDamage()
    set Fge=.0
    set bj_cineModePriorDawnDusk=IsUnitType(m5,UNIT_TYPE_HERO)
    if YM7>0 and YM7<9999 then
        if GetUnitAbilityLevel(m5,'B0J8')>0 then  //疯脸增伤
            call MHDamageEvent_SetDamage(YM7*1.3)
        elseif GetUnitAbilityLevel(m5,'B07S')>0 then
            call MHDamageEvent_SetDamage(YM7*1.25)
        endif
        if(GetUnitAbilityLevel(ZX7,'Aloc')==1)and IsUnitType(ZX7,UNIT_TYPE_HERO)==false then
            set IH7=M7[GetPlayerId(GetOwningPlayer(ZX7))]
        else
            set IH7=ZX7
        endif
        if bj_cineModePriorFogSetting then
            if p!=Z7[0]and p!=A7[0]and p!=B7 then
                if bj_cineModePriorDawnDusk then
                    set yv[GetPlayerId(p)]=yv[GetPlayerId(p)]+R2I(YM7)
                elseif IsUnitType(m5,UNIT_TYPE_STRUCTURE)then
                    if nPv(ZX7,m5)then
                        set Yvv[GetPlayerId(p)]=Yvv[GetPlayerId(p)]+R2I(YM7)
                    endif
                endif
                // B1019: preserve V2's suppression priority and damage-stage ordering.
                if GetUnitAbilityLevel(IH7,'B0M2')>0 then
                    set YM7=YM7*.5
                    call MHDamageEvent_SetDamage(YM7)
                elseif GetUnitAbilityLevel(IH7,'B0M1')>0 then
                    set YM7=YM7*.6
                    call MHDamageEvent_SetDamage(YM7)
                endif
                //法强
                if (GetUnitAbilityLevel(IH7,'A2YK')>0 or GetUnitAbilityLevel(IH7,'A2YJ')>0 or GetUnitAbilityLevel(IH7,'A4DJ')>0 or GetUnitAbilityLevel(IH7,'A4DZ')>0 or GetUnitAbilityLevel(IH7,'A4H2')>0 or GetUnitAbilityLevel(IH7,'A4H0')>0) and (GetUnitAbilityLevel(ZX7,'Aloc')==1 or Fe) then
                    if GetUnitAbilityLevel(IH7,'A4DJ')>0  or GetUnitAbilityLevel(IH7,'A4DZ')>0 then
                        set d=.05*(GetUnitAbilityLevel(IH7,'A4DJ')+GetUnitAbilityLevel(IH7,'A4DZ'))
                    else
                        set d=0.
                    endif
					if GetUnitAbilityLevel(IH7,'A4H2')>0 then
						set d=d+0.18
                    elseif GetUnitAbilityLevel(IH7,'A2YK')>0 then
                        set d=d+0.15
                    elseif GetUnitAbilityLevel(IH7,'A4H0')>0 then
                        set d=d+0.1
                    elseif GetUnitAbilityLevel(IH7,'A2YJ')>0 then
                        set d=d+0.05
                    endif
                    set YM7=YM7+YM7*d
	                call MHDamageEvent_SetDamage(YM7)
                endif
                //驱使恶灵
                if GetUnitTypeId(ZX7)=='u00G' and GetWidgetLife(IH7)>=1 then
                    set d=DGH_BUFF(IH7)
                    set recover_qsel=YM7*.25*d
                    call SetWidgetLife(IH7,recover_qsel + GetWidgetLife(IH7))
                endif
                //法吸
                if GetUnitAbilityLevel(IH7,'A2VW')==1 and GetWidgetLife(IH7)>=1 then
                    if GetUnitCurrentOrder(ZX7)==$D0207 and(B287_GetUnitAbilityLevel(ZX7,'A0CC')!=0 or B287_GetUnitAbilityLevel(ZX7,'A02Z')!=0)then
	                    if bj_cineModePriorDawnDusk then
		                    call SetWidgetLife(ZX7,YM7*.25+GetWidgetLife(ZX7))
	                    else
		                    call SetWidgetLife(ZX7,YM7*.05+GetWidgetLife(ZX7))
	                    endif
	                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SpellFizzle.mdx",ZX7,"overhead"))
                    //带蝗虫技能或者B67造成的伤害都会触发吸血
                    elseif V00==false and(GetUnitAbilityLevel(ZX7,'Aloc')==1 or Fe) and MRPH(IH7)==false  then
	                    set d=DGH_BUFF(IH7)
	                    if bj_cineModePriorDawnDusk then
		                    set recover=YM7*.25*d
	                    else
		                    set recover=YM7*.05*d
	                    endif
	                    if (recover>3 or recover_qsel>0) and GetUnitState(IH7,UNIT_STATE_LIFE)!=GetUnitState(IH7,UNIT_STATE_MAX_LIFE) then
		                    call HXXS("+"+I2S(R2I(recover+recover_qsel)),1,IH7,.02)
	                    endif
	                    call SetWidgetLife(IH7,recover + GetWidgetLife(IH7))
                        if recover>0 and GetUnitState(IH7,UNIT_STATE_LIFE)!=GetUnitState(IH7,UNIT_STATE_MAX_LIFE) then
                            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SpellFizzle.mdx",IH7,"overhead"))
                        endif
                    endif
                endif
            endif
        endif
    endif
    //伤害统计
    if YM7>0 and YM7<99999 and p!=null and TX7(p) and m5!=null and GetUnitTypeId(m5)!=0 and IsUnitType(m5,UNIT_TYPE_HERO) then
        set PlayerDamage[GetPlayerId(p)]=PlayerDamage[GetPlayerId(p)]+R2I(YM7)
    endif
set m5=null
set ZX7=null
set IH7=null
set p=null
return false
endfunction
// function FGe takes nothing returns boolean
