function DUN_SKILL3 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=O77(I97,"Hero")
local integer n=LoadInteger(TABLE_HY, GetHandleId(WX7), 'CSJY')
local real x=LoadReal(L7,I97,6)
local real y=LoadReal(L7,I97,7)
local integer b1018Serial=LoadInteger(L7,I97,10)
local integer b1018Stage=LoadInteger(L7,I97,9)
local trigger b1018Next=null
local integer b1018Key=0
call DisableTrigger(t)
if WX7==null or GetUnitTypeId(WX7)==0 or b1018Serial!=LoadInteger(L7,GetHandleId(WX7),StringHash("B1018AegisSerial")) then
call NM7(I97)
call OZ7(t)
set t=null
set WX7=null
return false
endif
if b1018Stage==0 then
// The synchronous HERO_REVIVE event must not rebuild this hero mid-ReviveHero.
if UnitAlive(WX7)==false then
call ReviveHero(WX7,x,y,true)
endif
set b1018Next=CreateTrigger()
set b1018Key=GetHandleId(b1018Next)
call NT7(b1018Key,"Hero",WX7)
call SaveReal(L7,b1018Key,6,x)
call SaveReal(L7,b1018Key,7,y)
call SaveInteger(L7,b1018Key,9,1)
call SaveInteger(L7,b1018Key,10,b1018Serial)
call TriggerRegisterTimerEvent(b1018Next,0.,false)
call TriggerAddCondition(b1018Next,Condition(function DUN_SKILL3))
call NM7(I97)
call OZ7(t)
set b1018Next=null
set t=null
set WX7=null
return false
endif
if not UnitAlive(WX7) then
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("SuijiRevivalPending"))
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("B1018AegisPending"))
call OX7(WX7,"chongsheng")
call VK8(WX7,1.,false)
call NM7(I97)
call OZ7(t)
set t=null
set WX7=null
return false
endif
// Run the shared status reset once, after the native revive stack has unwound.
call FixUnitPause(WX7,Player(0))
call FixUnitSilence(WX7)
call OX7(WX7,"HideUnit")
call OX7(WX7,"4316")
call OX7(WX7,"QPD")
call OX7(WX7,"JINU")
call OX7(WX7,"DISRB")
call OX7(WX7,"ShallowGrave|Active")
call SaveBoolean(L7,GetHandleId(WX7),'DARK',false)
call SaveInteger(TABLE_HY,GetHandleId(WX7),'echs',0)
call RemoveSavedHandle(TABLE_HY,GetHandleId(WX7),'A4KW')
call RemoveSavedHandle(TABLE_HY,GetHandleId(WX7),'A4GA')
call RemoveSavedHandle(TABLE_HY,GetHandleId(WX7),'A18X')
set HSS[GetPlayerId(GetOwningPlayer(WX7))]=false
set IG4[GetPlayerId(GetOwningPlayer(WX7))]=false
call YZ8(WX7)
call YW8(WX7,0,0)
call UnitRemoveBuffs(WX7,true,true)
call CK7(WX7)
if GetUnitTypeId(WX7)==0 or not UnitAlive(WX7) then
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("SuijiRevivalPending"))
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("B1018AegisPending"))
call OX7(WX7,"chongsheng")
if GetUnitTypeId(WX7)!=0 then
call VK8(WX7,1.,false)
endif
call NM7(I97)
call OZ7(t)
set t=null
set WX7=null
return false
endif
call SetUnitX(WX7,x)
call SetUnitY(WX7,y)
call OX7(WX7,"chongsheng")
call AddHeroXP(WX7,n,true)
call SaveInteger(TABLE_HY, GetHandleId(WX7), 'CSJY', 0)
call DestroyEffect(AddSpecialEffect("effects\\Hero_SkeletonKing_N7S_R_Object.mdl",x,y))
call UnitRemoveAbility(WX7,'A2YV')
call UnitRemoveAbility(WX7,'A2YW')
call UnitRemoveAbility(WX7,'B0I1')
call FT9(WX7)
call DP8(WX7)
call SetUnitPathing(WX7,true)
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("SuijiRevivalPending"))
call RemoveSavedBoolean(L7,GetHandleId(WX7),StringHash("B1018AegisPending"))
call ClearSelectionForPlayer(GetOwningPlayer(WX7))
call SelectUnitAddForPlayer(WX7,GetOwningPlayer(WX7))
call PanCameraToTimedForPlayer(GetOwningPlayer(WX7),GetUnitX(WX7),GetUnitY(WX7),0)
if GetUnitTypeId(WX7)=='H00I' then
if D4 then
set dbsdd=0
endif
call FU9(WX7,GetUnitX(WX7),GetUnitY(WX7))
endif
set ZX7_tmp=WX7
call ExecuteFunc("Func_AUTO_CHANGE_FORM")
set SUIJI_EVENT_UNIT=WX7
call ExecuteFunc("SuijiMode_OnHeroReviveCurrent")
set B957Revived=WX7
call ExecuteFunc("B957OnRevive")
call NM7(I97)
call OZ7(t)
set t=null
set WX7=null
return false
endfunction
// B594: Aegis death is arbitrated by the persistent global hero-death entry.
// Consume the saved one-use owner before scheduling, so duplicate death
// observers and Reincarnation can never own the same death.
function DUN_StartAegisRevival takes unit WX7 returns boolean
local trigger owner=null
local trigger tt=null
local integer OB7=0
local integer I97=0
if WX7==null or GetUnitTypeId(WX7)==0 or IsUnitIllusion(WX7) or DUN_HasAegis(WX7)==false then
set owner=null
set tt=null
return false
endif
set OB7=GetHandleId(WX7)
call NS7(OB7,"SuijiRevivalPending",true)
call NS7(OB7,"B1018AegisPending",true)
call SaveInteger(L7,OB7,StringHash("B1018AegisSerial"),LoadInteger(L7,OB7,StringHash("B1018AegisSerial"))+1)
set owner=LoadTriggerHandle(L7,OB7,'A2YV')
call RemoveSavedHandle(L7,OB7,'A2YV')
if owner!=null then
call OZ7(owner)
endif
call OV7(WX7,"chongsheng")
call C27("AegisOff",GetPlayerId(GetOwningPlayer(WX7)))
if GetUnitTypeId(WX7)=='H00I' then
call FW9(WX7,GetUnitX(WX7),GetUnitY(WX7))
endif
set NW4=null
set tt=CreateTrigger()
set I97=GetHandleId(tt)
call TriggerRegisterTimerEvent(tt,5+.01,false)
call TriggerAddCondition(tt,Condition(function DUN_SKILL3))
call NT7(I97,"Hero",WX7)
call SaveReal(L7,I97,6,GetUnitX(WX7))
call SaveReal(L7,I97,7,GetUnitY(WX7))
call SaveInteger(L7,I97,10,LoadInteger(L7,OB7,StringHash("B1018AegisSerial")))
set owner=null
set tt=null
return true
endfunction
// Keep the B594 Aegis fallback for special multi-unit heroes excluded by WM8.
// The saved owner is consumed atomically, so the primary broker and this
// listener cannot schedule two revivals for the same death.
function DUN_GlobalDeath takes nothing returns boolean
local unit WX7=GetTriggerUnit()
if WX7!=null and IsUnitType(WX7,UNIT_TYPE_HERO) and DUN_HasAegis(WX7) then
call DUN_StartAegisRevival(WX7)
endif
set WX7=null
return false
endfunction
function DUN_EnsureGlobalDeathTrigger takes nothing returns nothing
local integer key=StringHash("DUNGlobalDeathTrigger")
local trigger t=LoadTriggerHandle(L7,key,0)
if t==null then
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function DUN_GlobalDeath))
call SaveTriggerHandle(L7,key,0,t)
endif
set t=null
endfunction
function DUN_SKILL2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=(LoadUnitHandle(L7,(I97),(2)))
local integer OB7=GetHandleId(WX7)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
call DUN_StartAegisRevival(WX7)
else
call RemoveSavedHandle(L7,OB7,'A2YV')
call NM7(I97)
call OZ7(t)
endif
set t=null
set WX7=null
return false
endfunction
function DUN_SKILL takes unit WX7 returns boolean
local trigger t
local integer I97
local integer OB7=GetHandleId(WX7)
//local integer n=0
if WX7==null or GetUnitTypeId(WX7)==0 then
return false
endif
call DUN_EnsureGlobalDeathTrigger()
if DUN_HasAegis(WX7) then
return true
endif
// Keep B537's user-validated A2YW status buff/model, but never attach B546's
// Aamk A2YV marker.  The trigger below owns the scripted one-use revival.
call XF7(WX7,'A2YW')
if GetUnitAbilityLevel(WX7,'A2YW')==0 then
return false
endif
// loop
// exitwhen n>5
// if GetItemTypeId(UnitItemInSlot(WX7,n))==ZU[X0] then
// call RemoveItem(UnitItemInSlot(WX7,n))
// endif
// set n=n+1
// endloop
// loop
// exitwhen n>5
// if GetItemTypeId(UnitItemInSlot(WX7,n))==ZU[X0] then
// call RemoveItem(UnitItemInSlot(WX7,n))
// endif
// set n=n+1
// endloop
// loop
// exitwhen n>5
// if GetItemTypeId(UnitItemInSlot(WX7,n))==ZU[X0] then
// call RemoveItem(UnitItemInSlot(WX7,n))
// endif
// set n=n+1
// endloop
if not HaveSavedHandle(L7,OB7,'A2YV')then
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,E27+7,false)
call TriggerAddCondition(t,Condition(function DUN_SKILL2))
call SaveUnitHandle(L7,(I97),(2),(WX7))
call SaveTriggerHandle(L7,OB7,'A2YV',t)
endif
set t=null
return true
endfunction
function C2F takes nothing returns boolean
local unit WX7=GetTriggerUnit()
local item D88=GetManipulatedItem()
local integer id=GetItemTypeId(D88)
local integer i
local integer i1=GetUnitTypeId(WX7)
local boolean aegisReady=false
if(id==ZU[XC])and IsUnitType(WX7,UNIT_TYPE_HERO) and not DGFS(WX7) and i1!='H00J' then
set TW4[GetPlayerId(GetOwningPlayer(WX7))]=GetItemX(D88)
set TX4[GetPlayerId(GetOwningPlayer(WX7))]=GetItemY(D88)
endif
if(id==ZU[F6])and IsUnitType(WX7,UNIT_TYPE_HERO) and not DGFS(WX7) and i1!='H00J' then
set TW4FX[GetPlayerId(GetOwningPlayer(WX7))]=GetItemX(D88)
set TX4FX[GetPlayerId(GetOwningPlayer(WX7))]=GetItemY(D88)
endif
if(id==ZU[FF6])and IsUnitType(WX7,UNIT_TYPE_HERO) and not DGFS(WX7) and i1!='H00J' then
set TW4DFX[GetPlayerId(GetOwningPlayer(WX7))]=GetItemX(D88)
set TX4DFX[GetPlayerId(GetOwningPlayer(WX7))]=GetItemY(D88)
endif
// Aegis owns its scripted reincarnation/status lifecycle below.  Do not run
// unrelated consumable/native-skill rebuilds before attaching that lifecycle.
if id!='I0X5' then
call AHF(WX7,D88)
call AIF(WX7,D88)
endif
if(GetItemTypeId(D88)==ZU[DK4]or GetItemTypeId(D88)==ZU[DM4] or GetItemTypeId(D88)==ZU[it_xueshou_on] or GetItemTypeId(D88)==ZU[it_xueshou_off])and KW7(WX7)then
call UnitRemoveItem(WX7,D88)
elseif GetItemTypeId(D88)==ZU[DT4]and IsUnitType(WX7,UNIT_TYPE_HERO) then
set i=(LoadInteger(L7,(GetHandleId(WX7)),(750)))
if i>0 then
if(LoadBoolean(L7,(GetHandleId(WX7)),(751)))==false then
call SaveBoolean(L7,(GetHandleId(WX7)),(751),(true))
call SetItemCharges(D88,i)
endif
endif
elseif GetItemTypeId(D88)=='I0X5' and GetUnitTypeId(WX7)!='n00L' and KW7(WX7)==false and AS7(WX7)==false then
set aegisReady=DUN_SKILL(WX7)
if aegisReady then
if NX4==false then
set NW4=WX7
set NX4=true
call C27("AegisOn",GetPlayerId(GetOwningPlayer(WX7)))
call VV7(bj_FORCE_ALL_PLAYERS,10.,Q[GetPlayerId(GetOwningPlayer(WX7))]+GetUnitName(WX7)+"|r "+GetObjectName('n0EQ'))
endif
if D4 and GetUnitTypeId(WX7)=='H00I' then
set dbsdd=1
endif
call DisplayTimedTextToPlayer(GetOwningPlayer(WX7), 0,0,10, "|cFF00FF00不朽之守护已显示在状态栏，不朽之守护最多持续360秒|r")
endif
elseif GetItemTypeId(D88)==ZU[EX4]and KU7(WX7)then
call C0F(WX7)
elseif GetItemTypeId(D88)==ZU[G64] and GetUnitTypeId(WX7)=='Emoo' then
call SetPlayerTechResearched(GetOwningPlayer(WX7),'R00J',1)
elseif GetItemTypeId(D88)==ZU[G04] and GetUnitTypeId(WX7)=='H00I' then
set IN4=WX7
call ExecuteFunc("XSD")
elseif GetItemTypeId(D88)==ZU[GB4] and GetUnitTypeId(WX7)=='Ucrl' then
call UnitAddAbility(WX7,'A2KB')
call UnitRemoveAbility(WX7,'A2KB')
call AddUnitAnimationProperties(WX7,"upgrade",true)
call SetPlayerTechResearched(GetOwningPlayer(WX7),'R00K',1)
elseif GetItemTypeId(D88)==ZU[GB4]and GetUnitTypeId(WX7)=='Zcrl' then
call UnitAddAbility(WX7,'X2KB')
call UnitRemoveAbility(WX7,'X2KB')
call AddUnitAnimationProperties(WX7,"upgrade",true)
call SetPlayerTechResearched(GetOwningPlayer(WX7),'R00K',1)
elseif GetItemTypeId(D88)==ZU[GB4]and GetUnitTypeId(WX7)=='Zdrl' then
call UnitAddAbility(WX7,'X3KB')
call UnitRemoveAbility(WX7,'X3KB')
call AddUnitAnimationProperties(WX7,"upgrade",true)
call SetPlayerTechResearched(GetOwningPlayer(WX7),'R00K',1)
elseif GetItemTypeId(D88)==ZU[GB4]and GetUnitTypeId(WX7)=='Zerl' then
call UnitAddAbility(WX7,'X4KB')
call UnitRemoveAbility(WX7,'X4KB')
call AddUnitAnimationProperties(WX7,"upgrade",true)
call SetPlayerTechResearched(GetOwningPlayer(WX7),'R00K',1)
endif
set WX7=null
set D88=null
return false
endfunction
