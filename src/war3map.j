function Continuous_Damage2 takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(ExtraHT, OB7, 0)
    local unit IH7=LoadUnitHandle(ExtraHT, OB7, 1)
    local real n=LoadReal(ExtraHT, OB7, 0)
    local real DUR=LoadReal(ExtraHT, OB7, 1)
    local real YM7=LoadReal(ExtraHT, OB7, 10)
    if IH7==null or GetUnitTypeId(IH7)==0 or ZX7==null or GetUnitTypeId(ZX7)==0 then
        if IH7!=null and GetUnitTypeId(IH7)!=0 then
            call UnitRemoveAbility(IH7,'A4JL')
            call UnitRemoveAbility(IH7,'B028')
            call RemoveSavedHandle( ExtraHT, 'jdxx', GetHandleId(IH7))
        endif
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        set b1060ReturnValue=false
        set b1060GetTriggerEventId=null
        return b1060ReturnValue
    endif
    if (n>0 and GetUnitAbilityLevel(IH7,'B028')==0) or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
        call UnitRemoveAbility(IH7,'A4JL')
        call UnitRemoveAbility(IH7,'B028')
        call RemoveSavedHandle( ExtraHT, 'jdxx', GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT, OB7)
        call OZ7(t)
        set t=null
        set ZX7=null
        set IH7=null
        set b1060ReturnValue=false
        set b1060GetTriggerEventId=null
        return b1060ReturnValue
    endif
    set n=n+1
    call DisableTrigger(t)
    call B67(ZX7,IH7,1,YM7)
    call EnableTrigger(t)
    if n>=DUR or UnitAlive(IH7)==false then
        call UnitRemoveAbility(IH7,'A4JL')
        call UnitRemoveAbility(IH7,'B028')
        call RemoveSavedHandle(ExtraHT,'jdxx',GetHandleId(IH7))
        call FlushChildHashtable(ExtraHT,OB7)
        call OZ7(t)
    else
        call SaveReal(ExtraHT,OB7,0,n)
    endif
    set t=null
    set ZX7=null
    set IH7=null
    set b1060ReturnValue=false
    set b1060GetTriggerEventId=null
    return b1060ReturnValue
endfunction
function Continuous_Damage takes unit ZX7,unit IH7 returns nothing
    local trigger t
    local integer OB7
    local integer level=0
    local real DUR=0.
    local real YM7=0.
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        return
    endif
    set level=SuijiMode_GetPairCastLevel(ZX7,'A013','A013','A0A6')
    if SuijiMode_ScepterRegistryIsActive(ZX7,'A013') then
        set DUR=8.+level*2
        set YM7=60.+30*level+GetUnitState(IH7,UNIT_STATE_MAX_LIFE)*0.01
    else
        set DUR=4.+level*2
        set YM7=60.+30*level
    endif
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl",IH7,"chest"))
    if HaveSavedHandle(ExtraHT, 'jdxx', GetHandleId(IH7)) then
	    set t=LoadTriggerHandle(ExtraHT, 'jdxx', GetHandleId(IH7))
		set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        if GetUnitAbilityLevel(IH7,'B028')==0 then
            call XF7(IH7,'A4JL')
        endif
    else
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SaveUnitHandle(ExtraHT, OB7, 0, ZX7)
        call SaveUnitHandle(ExtraHT, OB7, 1, IH7)
        call SaveReal(ExtraHT, OB7, 0, 0)
        call SaveReal(ExtraHT, OB7, 1, DUR)
        call SaveReal(ExtraHT, OB7, 10, YM7)
        call SaveTriggerHandle(ExtraHT, 'jdxx', GetHandleId(IH7), t)
        call TriggerRegisterTimerEvent(t,1.,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function Continuous_Damage2))
        call XF7(IH7,'A4JL')
    endif
    set t=null
endfunction
function M_E_TRI takes nothing returns nothing
	local unit target = Wave_U
	local unit u = Wave_Sou
	if u!=null and target!=null and GetUnitTypeId(u)!=0 and GetUnitTypeId(target)!=0 and WF7(target)==false  then
        call Continuous_Damage(u,target)
	endif
	set target = null
	set u = null
endfunction
function B661_PoisonNovaCleanup takes trigger t returns nothing
local integer h=0
local integer i=1
local unit missile=null
local unit caster=null
local group g=null
if t==null then
return
endif
set h=GetHandleId(t)
if LoadBoolean(L7,h,StringHash("B661PoisonNovaCleaned")) then
return
endif
call SaveBoolean(L7,h,StringHash("B661PoisonNovaCleaned"),true)
set caster=LoadUnitHandle(L7,h,0)
if caster!=null and LoadTriggerHandle(L7,GetHandleId(caster),StringHash("B661PoisonNovaController"))==t then
call RemoveSavedHandle(L7,GetHandleId(caster),StringHash("B661PoisonNovaController"))
endif
loop
exitwhen i>18
set missile=LoadUnitHandle(L7,h,100+i)
if missile!=null and GetUnitTypeId(missile)!=0 then
call ShowUnit(missile,false)
call KillUnit(missile)
endif
set g=LoadGroupHandle(L7,h,200+i)
if g!=null then
call DestroyGroup(g)
endif
set i=i+1
endloop
set g=LoadGroupHandle(L7,h,50)
if g!=null then
call DestroyGroup(g)
endif
if B661_POISON_NOVA_ACTIVE>0 then
set B661_POISON_NOVA_ACTIVE=B661_POISON_NOVA_ACTIVE-1
endif
call FlushChildHashtable(L7,h)
call OZ7(t)
set missile=null
set caster=null
set g=null
endfunction
function B661_PoisonNovaTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,h,0)
local unit target=null
local unit missile=null
local group scan=LoadGroupHandle(L7,h,50)
local group hit=null
local integer i=1
local real x=LoadReal(L7,h,1)
local real y=LoadReal(L7,h,2)
local real radius=LoadReal(L7,h,3)+22.
local real angle=0.
local real px=0.
local real py=0.
local boolean finished=false
if caster==null or GetUnitTypeId(caster)==0 or scan==null then
call B661_PoisonNovaCleanup(t)
set caster=null
set target=null
set missile=null
set scan=null
set hit=null
set t=null
return false
endif
// The legacy 800-distance Wave starts 37.5 behind the caster and performs its
// final hit test after the 74th 11-unit step, giving the documented ~900 outer
// radius once the 125 collision circle is included.
if radius>=776.5 then
set radius=776.5
set finished=true
endif
loop
exitwhen i>18
set angle=20.*i*bj_DEGTORAD
set px=CoordinateX50(x+radius*Cos(angle))
set py=CoordinateY50(y+radius*Sin(angle))
set missile=LoadUnitHandle(L7,h,100+i)
if missile!=null and GetUnitTypeId(missile)!=0 then
call SetUnitX(missile,px)
call SetUnitY(missile,py)
endif
set i=i+1
endloop
call GroupClear(scan)
call GroupEnumUnitsInRange(scan,x,y,RAbsBJ(radius)+125.,null)
loop
set target=FirstOfGroup(scan)
exitwhen target==null
call GroupRemoveUnit(scan,target)
if IsUnitEnemy(caster,GetOwningPlayer(target)) and Group_Condition(target) then
set i=1
loop
exitwhen i>18
set angle=20.*i*bj_DEGTORAD
set px=CoordinateX50(x+radius*Cos(angle))
set py=CoordinateY50(y+radius*Sin(angle))
set hit=LoadGroupHandle(L7,h,200+i)
if hit!=null and IsUnitInGroup(target,hit)==false and IsUnitInRangeXY(target,px,py,125.) then
call GroupAddUnit(hit,target)
call B67(caster,target,1,.01)
call Continuous_Damage(caster,target)
endif
set i=i+1
endloop
endif
endloop
call SaveReal(L7,h,3,radius)
if finished then
call B661_PoisonNovaCleanup(t)
endif
set caster=null
set target=null
set missile=null
set scan=null
set hit=null
set t=null
return false
endfunction
function M_E takes nothing returns nothing
local unit u=GetTriggerUnit()
local trigger t=null
local integer h=0
local integer i=1
local real a=0.
local real x=0.
local real y=0.
local real r=0.
local unit missile=null
if u==null or GetUnitTypeId(u)==0 then
set u=null
return
endif
call SuijiMode_StartPairCooldownSync(u,B287_GetSpellAbilityId(),'A013','A0A6',"SuijiPoisonNovaCooldown",90.,80.,70.,90.,80.,70.)
set x=GetUnitX(u)
set y=GetUnitY(u)
set t=CreateTrigger()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,u)
call SaveTriggerHandle(L7,GetHandleId(u),StringHash("B661PoisonNovaController"),t)
call SaveReal(L7,h,1,x)
call SaveReal(L7,h,2,y)
call SaveReal(L7,h,3,-37.5)
call SaveGroupHandle(L7,h,50,CreateGroup())
loop
exitwhen i>18
set a=20.*i
set r=a*bj_DEGTORAD
set missile=CreateUnit(GetOwningPlayer(u),'h0HO',CoordinateX50(x-37.5*Cos(r)),CoordinateY50(y-37.5*Sin(r)),a)
call SaveUnitHandle(L7,h,100+i,missile)
call SaveGroupHandle(L7,h,200+i,CreateGroup())
set i=i+1
endloop
set B661_POISON_NOVA_ACTIVE=B661_POISON_NOVA_ACTIVE+1
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function B661_PoisonNovaTick))
set u=null
set missile=null
set t=null
endfunction
function N4E takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer h=0
local real now=TimerGetElapsed(W)
// A013/A0A6 and their fixed clones are one logical cast.  Use a caster-family
// lock that also blocks same-physical duplicate effect events during a Scepter
// replacement; the generic pair guard only sees an opposite rawcode overlap.
if u!=null and (skill=='A013' or skill=='A0A6') then
set h=GetHandleId(u)
if LoadTriggerHandle(L7,h,StringHash("B661PoisonNovaController"))==null and ON7(h,"B661PoisonNovaEffectUntil")<=now then
call NQ7(h,"B661PoisonNovaEffectUntil",now+1.)
call M_E()
endif
endif
set u=null
return false
endfunction
function I08 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function N4E))
set t=null
endfunction
function WYSW_TRI takes nothing returns nothing
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
	local trigger t=GetTriggeringTrigger()
	local integer OB7=GetHandleId(t)
	local unit ZX7=LoadUnitHandle(L7,OB7,0)
	local unit BB7=LoadUnitHandle(L7,OB7,1)
	local real DUR=LoadReal(L7,OB7,2)
	local unit IH7=LoadUnitHandle(L7,OB7,3)
	local string VH
	if GetGameTime()>DUR or ZX7==null or BB7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(BB7)==0 or UnitAlive(ZX7)==false or UnitAlive(BB7)==false then
		if BB7!=null and GetUnitTypeId(BB7)!=0 and UnitAlive(BB7) then
			call KillUnit(BB7)
		endif
		call FlushChildHashtable(L7, OB7)
		call OZ7(t)
	elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER and (GetUnitCurrentOrder(ZX7)==$D000F or GetUnitCurrentOrder(ZX7)==$D0003) and IsUnitEnemy(b1060GetOrderTargetUnit,GetOwningPlayer(ZX7)) then
		call SaveUnitHandle(L7,OB7,3,b1060GetOrderTargetUnit)
	else
		call SetUnitX(BB7,GetUnitX(ZX7))
		call SetUnitY(BB7,GetUnitY(ZX7))
		if IsHideUnit(ZX7) or IsUnitVisible(ZX7,GetLocalPlayer())==false then
			set VH=""
		else
			set VH="units\\orc\\SerpentWard\\SerpentWard.mdl"
		endif
		call MHUnit_SetModel(BB7,VH,false)
		if ModuloInteger(GetTriggerEvalCount(t),25)==0 and IH7!=null and GetUnitTypeId(IH7)!=0 then
			call B947IssueTargetOrderById("WYSW_TRI @ war3map.j:112038 (B968)",BB7,$D000F,IH7)
		endif
	endif
	set ZX7=null
	set BB7=null
	set IH7=null
	set t=null
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
endfunction
function WYSW takes unit ZX7,unit IH7 returns nothing
local unit BB7
local integer uid
local player p=null
local real x
local real y
local integer level=0
local real d=40.
local trigger t
local integer OB7
local boolean b=false
local integer DC_level=0
local real EX_ATTACK=0.
if ZX7==null or GetUnitTypeId(ZX7)==0 then
    return
endif
if IH7!=null and GetUnitTypeId(IH7)==0 then
    set IH7=null
endif
set p=GetOwningPlayer(ZX7)
set level=B287_GetUnitAbilityLevel(ZX7,'A0MS')
set DC_level=B287_GetUnitAbilityLevel(ZX7,'A0MY')
set EX_ATTACK=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS))*0.15
if ISLABIKE(ZX7) then
    set DC_level=4
endif
if ISLABIKE(ZX7) and level<=0 then
    set level=4
endif
if level<=0 and SuijiMode_HasRandomSkill(ZX7,'A173') then
    set level=B287_GetUnitAbilityLevel(ZX7,'A173')
endif
if level<=0 then
    set p=null
    return
endif
if IH7!=null and IsUnitAlly(IH7,GetOwningPlayer(ZX7)) and SuijiMode_HasAghanimState(ZX7) and GetUnitAbilityLevel(IH7,'A04R')==0 then
	set x=GetUnitX(IH7)
	set y=GetUnitY(IH7)
	set b=true
elseif IH7!=null then
	set x=GetUnitX(IH7)
	set y=GetUnitY(IH7)
else
    set x=GetSpellTargetX()
    set y=GetSpellTargetY()
endif
if level==1 then
	set uid='o00T'
elseif level==2 then
	set uid='o00U'
elseif level==3 then
	set uid='o00V'
elseif level==4 then
	set uid='o00W'
endif
set BB7=CreateUnit(p,uid,x,y,0)
call UnitApplyTimedLife(BB7,'BTLF',d)
call UnitRemoveAbility(BB7,'Amov')
if DC_level>0 then
call SuijiMode_EnsureExactLiveAbilityLevel(BB7,'Y05Y',DC_level,true)
endif
if SuijiMode_HasAghanimState(ZX7) then
	call YLG2(BB7,R2I(EX_ATTACK))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_COOL,GetUnitState(ZX7,UNIT_STATE_ATTACK1_COOL))
	// call SetUnitState(BB7,UNIT_STATE_ATTACK1_SPEED,GetUnitState(ZX7,UNIT_STATE_ATTACK1_SPEED))
endif
if b then
	call XF7(BB7,'Aloc')
	call SetUnitPhaseMove(BB7,true)
	set t=CreateTrigger()
	set OB7=GetHandleId(t)
	call SaveUnitHandle(L7,OB7,0,IH7)
	call SaveUnitHandle(L7,OB7,1,BB7)
	call SaveReal(L7,OB7,2,GetGameTime()+d)
	call SaveUnitHandle(L7,OB7,3,null)
	call TriggerRegisterTimerEvent(t,.02,true)
	call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_ISSUED_TARGET_ORDER)
	call TriggerAddCondition(t,Condition(function WYSW_TRI))
endif
set BB7=null
set p=null
set t=null
endfunction
function EXEC_WYSW takes nothing returns nothing
    call WYSW(TMPU3,TMPU4)
endfunction
