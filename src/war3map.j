function XXXEJH takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer OB7=0
if u==null or GetUnitTypeId(u)==0 then
set u=null
return false
endif
set OB7=GetHandleId(u)
if (B287_GetLearnedSkill()=='A2ZM' or B287_GetLearnedSkill()=='A2ZN') and IsUnitIllusion(u)==false then
if (GetUnitAbilityLevel(u,'A2ZM')==1 or GetUnitAbilityLevel(u,'A2ZN')==1) then
call SaveInteger(MSK,(OB7),(0),('A1SA'))
call SaveInteger(MSK,(OB7),(1),('A2ZU'))
call SaveInteger(MSK,(OB7),(2),('A2ZV'))
call SaveInteger(MSK,(OB7),(3),('A2ZW'))
call Multiple_Skill(u,1,3,50.,'A2ZM','A2ZN')
endif
endif
set u=null
return false
endfunction
