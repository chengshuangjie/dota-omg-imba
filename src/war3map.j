set IH7=B11F(WX7,x,y)
else
set IH7=B1F(WX7,x,y)
endif
call RemoveLocation(l)
endif
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
if IH7==JW_JD then
set tpCastleLanding=TpSlot_GetCastleLanding(WX7,IH7,x,y)
set x=GetLocationX(tpCastleLanding)
set y=GetLocationY(tpCastleLanding)
call RemoveLocation(tpCastleLanding)
set tpCastleLanding=null
