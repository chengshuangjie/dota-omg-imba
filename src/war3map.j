function ZWF takes unit WX7 returns nothing
local integer i=0
local item D88
call DisableTrigger(H94)
loop
exitwhen i>5
set D88=UnitItemInSlot(WX7,i)
if D88!=null then
call ZVF(WX7,D88)
endif
set i=i+1
endloop
call EnableTrigger(H94)
set D88=null
endfunction
function ZXF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1RI' or B287_GetSpellAbilityId()=='A03G' or B287_GetSpellAbilityId()=='A0BE' then
if XH7(GetTriggerUnit())==false then
call ZWF(GetTriggerUnit())
endif
endif
return false
endfunction
function ZYF takes unit WX7,item D88 returns boolean
local unit u=WX7
local integer z8=GetUnitTypeId(u)
local integer Z48=KY7(D88)
local real x
local real y
local boolean ZZF=true
set x=GetUnitX(u)
set y=GetUnitY(u)
set GF7=GetItemPlayer(D88)
if Z48==XZ then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",u,"overhead"))
call XC7(GetOwningPlayer(u),"Abilities\\Spells\\Human\\Heal\\HealTarget.wav")
set IR4=GetItemPlayer(D88)
call KX7(D88)
set HA4=UnitAddItemById(u,ZU[IA])
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if Z48==D1 and GetItemCharges(D88)==0 then
set IR4=GetItemPlayer(D88)
call KX7(D88)
set HA4=UnitAddItemById(u,ZU[F1])
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if Z48==VB and GetItemCharges(D88)==0 then
set IR4=GetItemPlayer(D88)
call KX7(D88)
set HA4=UnitAddItemById(u,ZU[WB])
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
call DisableTrigger(H94)
if(Z48==H6 or Z48==G6 or Z48==N6)and(MU7(u,ZU[H6],D88)!=null or MU7(u,ZU[G6],D88)!=null or MU7(u,ZU[N6],D88)!=null)then
call X37(GetOwningPlayer(u),GetObjectName('n02L'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if(Z48==BA or Z48==X1)and(MU7(u,ZU[BA],D88)!=null or MU7(u,ZU[GB],D88)!=null or MU7(u,ZU[X1],D88)!=null)and(z8==121111)then
call X37(GetOwningPlayer(u),GetObjectName('n0HL'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
set ZZF=false
endif
if ZZF and(Z48==GB or Z48==X1)and(MU7(u,ZU[BA],D88)!=null or MU7(u,ZU[GB],D88)!=null or MU7(u,ZU[X1],D88)!=null)and(z8==121111)then
call X37(GetOwningPlayer(u),GetObjectName('n0HL'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
set ZZF=false
endif
if(Z48==DM4 or Z48==DK4 or Z48==DO4 or Z48==DN4 or Z48==it_xueshou_off or Z48==it_xueshou_on or Z48==it_xueshou_off_courier or Z48==it_xueshou_on_courier)and(MU7(u,ZU[DM4],D88)!=null or MU7(u,ZU[DK4],D88)!=null or MU7(u,ZU[DO4],D88)!=null or MU7(u,ZU[DN4],D88)!=null or MU7(u,ZU[it_xueshou_off],D88)!=null or MU7(u,ZU[it_xueshou_on],D88)!=null or MU7(u,ZU[it_xueshou_off_courier],D88)!=null or MU7(u,ZU[it_xueshou_on_courier],D88)!=null)then
call X37(GetOwningPlayer(u),GetObjectName('n02C'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if(Z48==it_link or Z48==A5)and(MU7(u,ZU[it_link],D88)!=null or MU7(u,ZU[A5],D88)!=null)then
call X37(GetOwningPlayer(u),"你只能携带一个林肯法球")
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if(Z48==B5 and IsPlayerEnemy(GetItemPlayer(D88),GetOwningPlayer(u)))then
set IR4=GetItemPlayer(D88)
call KX7(D88)
set HA4=UnitAddItemById(u,ZU[C5])
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
//信使和熊灵不能携带不朽盾
if(Z48==X0)and(KW7(u)or AS7(u))then
if KW7(u)then
call X37(GetOwningPlayer(u),GetObjectName('n02K'))
endif
set IR4=GetItemPlayer(D88)
set IH4=GetItemCharges(D88)
call RemoveItem(D88)
if Z48==X0 then
set HA4=CreateItem(SU[Z48],GetRectCenterX(ND),GetRectCenterY(ND))
endif
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
if Z48==X0 then
call SetItemCharges(HA4,IH4)
endif
endif
if Z48==RW and(z8==12150 or z8==14290)then
call X37(GetOwningPlayer(u),GetObjectName('n02J'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
if ZZF and(Z48==BA or Z48==GB or Z48==X1)and(z8==12111191870)then
call X37(GetOwningPlayer(u),GetObjectName('n02J'))
set IR4=GetItemPlayer(D88)
call RemoveItem(D88)
set HA4=CreateItem(SU[Z48],x,y)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
set ZZF=false
endif
if Z48==D0 or Z48==E0 or Z48==J0 or Z48==N0 or Z48==O0 or Z48==R0 and z8=='U00C' then
call DisplayTimedTextToPlayer(GetOwningPlayer(u),0,E9,10,"|c00ff0303"+GetObjectName('n02P')+"|r")
endif
call EnableTrigger(H94)
if ZZF and GetUnitTypeId(WX7)!='e00E' then
call ZUF(WX7,D88)
endif
set u=null
set D88=null
return false
endfunction
function ZAF takes integer Z48 returns boolean
return Z48==O1 or Z48==DN4 or Z48==DO4 or Z48==DQ4 or Z48==J1 or Z48==DK4 or Z48==DM4 or Z48==it_xueshou_off or Z48==it_xueshou_on or Z48==it_xueshou_off_courier or Z48==it_xueshou_on_courier or Z48==it_bingjia or Z48==EW or Z48==HW or Z48==S6 or Z48==V6 or Z48==R00 or Z48==R01 or Z48==it_jfcj or Z48==it_bfcj
endfunction
function ZBF takes integer Z48 returns boolean
return Z48==EW or Z48==HW
endfunction
function ZCF takes unit WI7,item QU8 returns boolean
local item KA7=QU8
local integer Z48=KZ7(KA7)
local integer Z3F=0
local boolean AF8=false
local integer Z6F=KC7(KA7)
local boolean ZLF=false
if IsUnitType(WI7,UNIT_TYPE_HERO) then
if Z48==O1 then
set Z3F=J1
endif
if Z48==V6 then
set Z3F=S6
endif
if Z48==DN4 then
set Z3F=DK4
endif
if Z48==DO4 then
set Z3F=DM4
endif
if Z48==it_xueshou_on_courier then
set Z3F=it_xueshou_on
endif
if Z48==it_xueshou_off_courier then
set Z3F=it_xueshou_off
endif
if Z48==DQ4 then
set Z3F=it_bingjia
endif
if Z48==HW then
set Z3F=EW
endif
if Z6F==HW then
set Z3F=EW
set ZLF=true
endif
if Z3F!=0 then
set IR4=GetItemPlayer(KA7)
call KX7(KA7)
if ZLF then
set HA4=UnitAddItemById(WI7,BU[Z3F])
else
set HA4=UnitAddItemById(WI7,ZU[Z3F])
endif
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
set AF8=true
endif
else
if Z48==J1 then
set Z3F=O1
endif
if Z48==S6 then
set Z3F=V6
endif
if Z48==DK4 then
set Z3F=DN4
endif
if Z48==DM4 then
set Z3F=DO4
endif
if Z48==it_xueshou_on then
set Z3F=it_xueshou_on_courier
endif
if Z48==it_xueshou_off then
set Z3F=it_xueshou_off_courier
endif
if Z48==it_bingjia then
set Z3F=DQ4
endif
if Z48==EW then
set Z3F=HW
endif
if Z6F==EW then
set Z3F=HW
set ZLF=true
endif
if Z3F!=0 then
set IR4=GetItemPlayer(KA7)
call KX7(KA7)
if ZLF then
set HA4=UnitAddItemById(WI7,BU[Z3F])
else
set HA4=UnitAddItemById(WI7,ZU[Z3F])
endif
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
set AF8=true
endif
endif
set KA7=null
return AF8
endfunction
function Z1F takes unit WI7,item QU8 returns boolean
if ZAF(KZ7(QU8))or ZBF(KC7(QU8))then
return ZCF(WI7,QU8)
endif
return false
endfunction
//丢A卖A判断
function Lost_A takes unit u,item QU8 returns nothing
local integer id=GetUnitTypeId(u)
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)
local integer n5=F59(u)
local integer A1E=F29(u)
call YSBJ(u)
if Lost_A_PD(u,ZU[R1Q],QU8)==null and id=='Ubal' or id=='Zbal' and CHILLX[i]==0 then
call UnitRemoveAbility(u,'A33B')
endif
//移除星落
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='N01V' or id=='Z01V' or id=='Z11V' or id=='Z21V' or id=='Z31V' or id=='Z41V') and SuijiMode_HasAghanimState(u)==false then
	call UnitRemoveAbility(u,'AFZB')
	call UnitRemoveAbility(u,'A3UF')
	call UnitRemoveAbility(u,'A3UG')
    call UnitRemoveAbility(u,'A4F2')
endif
//移除分裂箭
if Lost_A_PD(u,ZU[n5],QU8)==null and id=='Nbrn' and SuijiMode_HasAghanimState(u)==false then
	call UnitRemoveAbility(u,'S3UR')
	call UnitRemoveAbility(u,'AFZA')
endif
//移除食尸鬼之怒
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='U00C' or id=='Z00C') and SuijiMode_HasAghanimState(u)==false then
    call B287_SetPlayerAbilityAvailable(p,'A194',false)
    call UnitRemoveAbility(u,'A4EV')
    call UnitRemoveAbility(u,'A4EW')
endif
//移除严寒烧灼
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='N0M7' or id=='N1MB' or id=='N1MC' or id=='N1MO' or id=='N1MA') and SuijiMode_HasAghanimState(u)==false then
    call UnitRemoveAbility(u,'A2Y6')
    call UnitRemoveAbility(u,'A3NE')
endif
//火猫
if Lost_A_PD(u,ZU[n5],QU8)==null and id=='N0M0' and SuijiMode_HasAghanimState(u)==false then
set DZ7[0]='A2JO'
set DZ7[1]='A2JQ'
set DZ7[2]='A2JP'
set DZ7[3]='A2JR'
call HZYJ_SKILL(u,false)
endif
//DP
if Lost_A_PD(u,ZU[n5],QU8)==null and id=='UC76' and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,'A4L7')
endif
//土猫
if Lost_A_PD(u,ZU[n5],QU8)==null and id=='N0MU' and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A2VM',false)
endif
//黑鸟
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='U00P' or id=='Z00P')  and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,'A4A4')
endif
//幽鬼
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='E01B' or id=='Z01B' or id=='Z11B' or id=='Z21B' or id=='Z31B') and SuijiMode_HasAghanimState(u)==false then
call B287_SetPlayerAbilityAvailable(p,'A4B6',false)
endif
//尸王
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Z00R' or id=='Z07I') and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,'A4B7')
endif
//炼金
if PDLJ(u) then
call CT7(p)
endif
//斯文
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='H001' or id=='H0CQ') and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,'A4CG')
endif
//猛犸
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='UC11' or id=='ZC11' or id=='ZC12') and SuijiMode_HasAghanimState(u)==false then
call B287_MHAbility_SetCastpoint(u,'A3RD',.3)
call UnitRemoveAbility(u,'A4FL')
endif
//猴子
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Ogrh') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A0D7',false)
endif
//夜魔
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Udre' or id=='Udrf') and SuijiMode_HasAghanimState(u)==false then
call SCTX(u)
endif
//潮汐
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Ofar') and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,'A4GC')
endif
//海民
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='E02I') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A4HI',false)
endif
//神牛
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A4LZ',false)
endif
//亚巴顿
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Udea') and SuijiMode_HasAghanimState(u)==false then
	call SetPlayerAbilityAvailable(p,'A4LQ',false)
endif
//大树
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Hamg') and SuijiMode_HasAghanimState(u)==false then
call B287_SetPlayerAbilityAvailable(p,'A1G7',false)
endif
//巨魔
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='N016' or id=='N017' or id=='N200' or id=='N201' or id=='N02B') and SuijiMode_HasAghanimState(u)==false then
call MHUnit_SetAttackSpeedLimit(u,5)
endif
//圣堂
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='E01Y' or id=='Z01Y') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A4KJ',false)
endif
//大牛
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='O015') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A4KK',false)
endif
//SVEN
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='H001' or id=='H0CQ' or id=='Z001' or id=='Z0CQ') and SuijiMode_HasAghanimState(u)==false then
call SetPlayerAbilityAvailable(p,'A4IL',false)
endif
//水人
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='O00P') and SuijiMode_HasAghanimState(u)==false then
    if LoadUnitHandle(L7,(GetHandleId(u)),($E5))!=null and UnitAlive(LoadUnitHandle(L7,(GetHandleId(u)),($E5))) then
        call KillUnit(LoadUnitHandle(L7,(GetHandleId(u)),($E5)))
    endif
    call UnitRemoveAbility(u,'A0GC')
    call B287_SetPlayerAbilityAvailable(p,'A0G8',false)
endif
if Lost_A_PD(u,ZU[n5],QU8)==null and GetUnitAbilityLevel(u,A1E)>0 and SuijiMode_HasAghanimState(u)==false then
call UnitRemoveAbility(u,A1E)
call SCTX(u)
if GetUnitTypeId(u)=='Hmkg' then
call SetPlayerAbilityAvailable(p,'A2KQ',false)
endif
endif
//火枪
if Lost_A_PD(u,ZU[n5],QU8)==null and (id=='Usyl') and SuijiMode_HasAghanimState(u)==false then
call B287_MHAbility_SetCastpoint(u,'A04P',1.7)
endif
call SuijiMode_ReconcileNativeAghCompanions(u,QU8)
call Reset_Skill_range(u)
set p=null
endfunction
function Z0F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit Y_F=O77(OB7,"Unit")
local integer Z5F=OM7(OB7,"EventType")
local integer Y68=OM7(OB7,"indexId")
local boolean Z2F=OO7(OB7,"Temporary")
local item QU8
local player p=GetOwningPlayer(Y_F)
local player Z_F
local integer RTF
local boolean A4F=false
local item RJF
local integer n5
local integer A1E
local item Z4
local item A7F
local boolean A8F=false
local integer YC7
// A deferred item event may outlive a wheel candidate or the item's holder.
// Validate before disabling shared item triggers or touching the saved item.
if Y_F==null or GetUnitTypeId(Y_F)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set Y_F=null
set p=null
return false
endif
if not Z2F then
set QU8=OJ7(OB7,"Item")
if QU8==null or GetItemTypeId(QU8)==0 or (Z5F==1 and not UnitHasItem(Y_F,QU8)) then
call NM7(OB7)
call OZ7(t)
set t=null
set QU8=null
set Y_F=null
set p=null
return false
endif
endif
call DisableTrigger(SV4)
if Z2F then
set A7F=null
set Z_F=O97(OB7,"p")
set RTF=OM7(OB7,"charges")
else
set QU8=OJ7(OB7,"Item")
set A7F=QU8
set Z_F=GetItemPlayer(QU8)
set RTF=GetItemCharges(QU8)
endif
set GG7=Y68
set GF7=Z_F
set eY[512+GetPlayerId(GF7)]=1
if Z2F then
set G87[288+GetPlayerId(Z_F)]=null
else
set G87[288+GetPlayerId(Z_F)]=QU8
endif
if Z2F==false and QU8==null then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call EnableTrigger(SV4)
set t=null
set Y_F=null
set p=null
set Z_F=null
set A7F=null
return false
endif
if Z5F==1 then
if p!=Z_F and PK4==false and GetUnitTypeId(Y_F)=='ncop' then
if Z78(Y38(Y68))or Z88(Y38(Y68))then
set A4F=true
endif
if IsPlayerEnemy(p,Z_F)then
call X0F(SU[Y68],KV4[GetPlayerId(p)],KW4[GetPlayerId(p)],Z_F,A4F,RTF)
else
call X0F(SU[Y68],KV4[GetPlayerId(Z_F)],KW4[GetPlayerId(Z_F)],Z_F,A4F,RTF)
endif
call X37(p,GetObjectName('n0DR'))
if Z2F==false then
set A8F=true
call KX7(QU8)
endif
elseif PK4==false and Z2F==false and GetItemType(QU8)==ITEM_TYPE_CAMPAIGN and Y4F(QU8)!=0 and(p==Z_F or(GetPlayerSlotState((Z_F))==PLAYER_SLOT_STATE_LEFT))then
if Z88(Y68)then
set A4F=true
else
set A4F=false
endif
if(GetPlayerSlotState((Z_F))==PLAYER_SLOT_STATE_LEFT)and W47(Y68)then
else
call KX7(QU8)
set A8F=true
set RJF=UnitAddItemById(Y_F,ZU[Y68])
set A7F=RJF
call SetItemPlayer(RJF,Z_F,false)
call SetItemUserData(RJF,0)
if A4F then
call SetItemCharges(RJF,RTF)
endif
endif
elseif PK4==false and Z2F==false and GetItemType(QU8)==ITEM_TYPE_PERMANENT and p!=Z_F and BU[KY7(QU8)]!=0 and(GetPlayerSlotState((Z_F))==PLAYER_SLOT_STATE_LEFT)==false then
if Z88(Y68)then
set A4F=true
else
set A4F=false
endif
call KX7(QU8)
set A8F=true
set RJF=UnitAddItemById(Y_F,BU[Y68])
set A7F=RJF
call SetItemPlayer(RJF,Z_F,false)
call SetItemUserData(RJF,0)
if A4F then
call SetItemCharges(RJF,RTF)
endif
//获得A判断
elseif Z2F==false and GetItemType(QU8)==ITEM_TYPE_PERMANENT and Y_8(QU8)and IsUnitType(Y_F,UNIT_TYPE_HERO) then
set n5=F59(Y_F)
set A1E=F29(Y_F)
//设置A杖特效
call CHIA_TX(Y_F,p)
if A1E!=0 then
call XF7(Y_F,A1E)
call SetPlayerAbilityAvailable(p,A1E,false)
if GetUnitTypeId(Y_F)=='H00U' then
set IN4=Y_F
call ExecuteFunc("A0E")
elseif GetUnitTypeId(Y_F)=='Hmkg' then
set IN4=Y_F
call ExecuteFunc("E3D")
endif
endif
set YC7=Y08(Y_F,4)
if Y68!=n5 then
call KX7(QU8)
set RJF=UnitAddItemById(Y_F,ZU[n5])
set A7F=RJF
call SetItemPlayer(RJF,Z_F,false)
call SetItemUserData(RJF,1)
endif
call CHIA_SKILL_OTHERS(Y_F,p,GetUnitTypeId(Y_F),false)
call Reset_Skill_range(Y_F)
elseif Z2F==false and GetItemType(QU8)==ITEM_TYPE_ARTIFACT then
call DisableTrigger(H94)
set Z4=X5F(Z_F,Y_F,Y68,QU8)
if Z4==null then
else
call SetItemCharges(Z4,RTF+GetItemCharges(Z4))
call KX7(QU8)
set A7F=null
endif
call EnableTrigger(H94)
elseif Z2F and Z78(Y38(Y68))then
call DisableTrigger(H94)
if YRE(Y_F)==0 and X_F(Z_F,Y_F,Y68)==null then
call X37(p,GetObjectName('n02O'))
call X0F(SU[(Y68)],((ON7(OB7,"x"))*1.),((ON7(OB7,"y"))*1.),(Z_F),(true),(RTF))
else
set Z4=X_F(Z_F,Y_F,Y68)
if Z4==null then
call DisableTrigger(H94)
set RJF=UnitAddItemById(Y_F,ZU[Y68])
set A7F=RJF
call SetItemPlayer(RJF,Z_F,false)
call SetItemUserData(RJF,1)
call SetItemCharges(RJF,RTF)
else
call SetItemCharges(Z4,RTF+GetItemCharges(Z4))
set G87[288+GetPlayerId(Z_F)]=Z4
endif
endif
call EnableTrigger(H94)
elseif Z2F then
call Y0F(Z_F,Y_F,null,Y68,ON7(OB7,"x"),ON7(OB7,"y"),RTF,1)
elseif Z2F==false and(GetItemType(QU8)==ITEM_TYPE_PERMANENT or GetItemType(QU8)==ITEM_TYPE_CAMPAIGN)then
call SetItemUserData(QU8,1)
set A8F=YCF(Z_F,Y_F,0)
if Y_8_LLX(QU8) and GetUnitTypeId(Y_F)=='Ubal' or GetUnitTypeId(Y_F)=='Zbal' then
call XF7(Y_F,'A33B')
call SetPlayerAbilityAvailable(p,'A33B',false)
endif
//END
endif
if A8F==false and A7F!=null and Y7F(A7F)==false and GetUnitTypeId(Y_F)!='e00E' then
set A8F=Z1F(Y_F,A7F)
endif
if A8F==false and A7F!=null and Y7F(A7F)==false then
call ZYF(Y_F,A7F)
endif
else
if GetWidgetLife(QU8)>0 then
//丢A判断
call Lost_A(Y_F,null)
set YC7=Y08(Y_F,4)
if IsItemOwned(QU8)==false then
if GetItemType(QU8)==ITEM_TYPE_ARTIFACT or Z88(Y68)then
set A4F=true
endif
call X0F(SU[Y68],GetItemX(QU8),GetItemY(QU8),Z_F,A4F,RTF)
call KX7(QU8)
endif
endif
endif
call NM7(OB7)
call OZ7(t)
call EnableTrigger(SV4)
if A7F!=null then
set G87[288+GetPlayerId(Z_F)]=A7F
endif
set t=null
set QU8=null
set Y_F=null
set p=null
set Z_F=null
set RJF=null
set Z4=null
set A7F=null
return false
endfunction
