function ChaosObserver_DoSweep takes nothing returns nothing
local integer i=1
local unit hero=null
local real dx=0.
local real dy=0.
local real distance=0.
local real forwardX=Cos(ChaosObserverSweepAngle)
local real forwardY=Sin(ChaosObserverSweepAngle)
local real x=0.
local real y=0.
if ChaosObserverSweepEffect!=null then
call DestroyEffect(ChaosObserverSweepEffect)
set ChaosObserverSweepEffect=null
endif
if ChaosObserver_CanAct()==false then
return
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",ChaosObserverBoss,"origin"))
loop
exitwhen i>5
set hero=M7[i]
if ChaosObserver_IsDalaranHero(hero) and XH7(hero)==false then
set dx=GetUnitX(hero)-GetUnitX(ChaosObserverBoss)
set dy=GetUnitY(hero)-GetUnitY(ChaosObserverBoss)
set distance=SquareRoot(dx*dx+dy*dy)
if distance<=550. and dx*forwardX+dy*forwardY>=distance*.574 then
call B67(ChaosObserverBoss,hero,2,450.+GetUnitState(hero,UNIT_STATE_MAX_LIFE)*.08)
if distance>1. then
set x=GetUnitX(hero)+120.*dx/distance
set y=GetUnitY(hero)+120.*dy/distance
call SetUnitPosition(hero,x,y)
endif
endif
endif
set i=i+1
endloop
set hero=null
endfunction
