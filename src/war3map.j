function GetEnableText takes boolean enable returns string
	if enable then
		return " |cFF00FF00已开启|r"
	else
		return " |cFFF00000已关闭|r"
	endif
	return null
endfunction
function GetSetUpText takes string msg, boolean enable returns nothing
	call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 5, "|CFFFF8000[设置]|R |c006699CC" + msg + GetEnableText(enable)) 
endfunction
function STV takes nothing returns nothing
	local integer id = LoadInteger(TABLE_HY, GetHandleId(GetExpiredTimer()), 0)
	set IsAttackEffectEnabled[id]= false
endfunction
function EnableAttackEffectByTime takes integer i, real time returns nothing
	set IsAttackEffectEnabled[i]= true
	if time == 0 then
		return
	endif
	if OTIME[i]== null then
		set OTIME[i]= CreateTimer()
		call SaveInteger(TABLE_HY, GetHandleId(OTIME[i]), 0, i)
	endif
	if TimerGetRemaining(OTIME[i])< time then
		call TimerStart(OTIME[i], time, false, function STV)
	endif
endfunction
function BrewmasterBrawler_GetLevel takes unit u returns integer
local integer level=B287_GetUnitAbilityLevel(u,'A0MX')*(1-GetUnitAbilityLevel(u,'A4G4'))
if level<0 then
set level=0
endif
return level
endfunction
function BrewmasterBrawler_GetStance takes unit u returns integer
local integer stance=LoadInteger(L7,GetHandleId(u),StringHash("BrewmasterBrawlerStance"))
if stance<1 or stance>3 then
set stance=1
endif
return stance
endfunction
function BrewmasterBrawler_SetBrewed takes unit u,real dur returns nothing
if BrewmasterBrawler_GetLevel(u)>0 then
call SaveReal(L7,GetHandleId(u),StringHash("BrewmasterBrawlerBrewed"),TimerGetElapsed(W)+dur)
endif
endfunction
function BrewmasterBrawler_IsBrewed takes unit u returns boolean
return BrewmasterBrawler_GetLevel(u)>0 and LoadReal(L7,GetHandleId(u),StringHash("BrewmasterBrawlerBrewed"))>TimerGetElapsed(W)
endfunction
function BrewmasterBrawler_HasScepter takes unit u returns boolean
if u==null then
return false
endif
return SuijiMode_EarlyScepterRegistryIsActive(u,'A0MX')
endfunction
function BrewmasterBrawler_SetScepterPower takes unit u,real dur returns nothing
if BrewmasterBrawler_GetLevel(u)>0 and BrewmasterBrawler_HasScepter(u) then
call SaveReal(L7,GetHandleId(u),StringHash("BrewmasterBrawlerScepterPower"),TimerGetElapsed(W)+dur)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl",u,"origin"))
endif
endfunction
function BrewmasterBrawler_IsScepterPowered takes unit u returns boolean
return BrewmasterBrawler_GetLevel(u)>0 and BrewmasterBrawler_HasScepter(u) and LoadReal(L7,GetHandleId(u),StringHash("BrewmasterBrawlerScepterPower"))>TimerGetElapsed(W)
endfunction
function BrewmasterBrawler_EvasionChance takes unit u returns integer
local integer level=BrewmasterBrawler_GetLevel(u)
local real chance=0.
if level>0 and BrewmasterBrawler_GetStance(u)==2 then
if BrewmasterBrawler_IsScepterPowered(u) then
return 100
endif
set chance=5.+5.*level
if BrewmasterBrawler_IsBrewed(u) then
set chance=chance+10.
endif
endif
return R2I(RMinBJ(chance,45.))
endfunction
function BrewmasterBrawler_CritRate takes unit u returns real
local integer level=BrewmasterBrawler_GetLevel(u)
local real chance=0.
if level>0 and BrewmasterBrawler_GetStance(u)==3 then
if BrewmasterBrawler_IsScepterPowered(u) then
return 1.
endif
set chance=(5.+5.*level)/100.
if BrewmasterBrawler_IsBrewed(u) then
set chance=chance+.1
endif
endif
return RMinBJ(chance,.45)
endfunction
function BrewmasterBrawler_TryCrit takes unit u returns boolean
local real rate=BrewmasterBrawler_CritRate(u)*100.
if rate>=100. then
return true
endif
return rate>0. and GetPrdRandom(u,'A0MX',rate)
endfunction
function BrewmasterBrawler_DamageTakenRate takes unit u returns real
local integer level=BrewmasterBrawler_GetLevel(u)
local real reduce=0.
if level>0 and BrewmasterBrawler_GetStance(u)==1 then
set reduce=.05*level
if BrewmasterBrawler_IsBrewed(u) then
set reduce=reduce+.1
endif
endif
return 1.-RMinBJ(reduce,.45)
endfunction
function BrewmasterBrawler_OnDamaged takes nothing returns nothing
local unit target=GetTriggerUnit()
local real reduce=1.-BrewmasterBrawler_DamageTakenRate(target)
if reduce>0. and GetEventDamage()>0. and GetEventDamageSource()!=target and UnitAlive(target) then
call SetWidgetLife(target,GetWidgetLife(target)+GetEventDamage()*reduce)
endif
set target=null
endfunction
// B1023: a dead but existing hero may legitimately retain a lifecycle listener.
// Null/removed handles must never cross the platform damage-registration hook.
// Temporary heroes own these listeners; the player's primary hero never does.
function B1027TempestTrackListener takes unit owner1027,trigger listener1027 returns nothing
local integer ownerKey1027=GetHandleId(owner1027)
local integer count1027=0
if owner1027==null or listener1027==null or (GetUnitTypeId(owner1027)!='N0MM' and not LoadBoolean(L7,ownerKey1027,StringHash("B849TempestOwned"))) then
return
endif
if LoadBoolean(B1027TempestListenerTable,GetHandleId(listener1027),-1) then
return
endif
call SaveBoolean(B1027TempestListenerTable,GetHandleId(listener1027),-1,true)
set count1027=LoadInteger(B1027TempestListenerTable,ownerKey1027,0)+1
call SaveInteger(B1027TempestListenerTable,ownerKey1027,0,count1027)
call SaveTriggerHandle(B1027TempestListenerTable,ownerKey1027,count1027,listener1027)
endfunction
function B1023RegisterDamage takes trigger damageOwner1023,unit damageUnit1023 returns nothing
if damageOwner1023!=null and damageUnit1023!=null and GetUnitTypeId(damageUnit1023)!=0 then
call TriggerRegisterUnitEvent(damageOwner1023,damageUnit1023,EVENT_UNIT_DAMAGED)
endif
endfunction
function BrewmasterBrawler_RegisterDamage takes unit target returns nothing
local integer h
local trigger t
if target==null or IsUnitIllusion(target) then
set target=null
return
endif
set h=GetHandleId(target)
if LoadTriggerHandle(L7,h,StringHash("BrewmasterBrawlerDamageTrigger"))==null then
set t=CreateTrigger()
call B1027TempestTrackListener(target,t)
call B1023RegisterDamage(t,target)
call TriggerAddAction(t,function BrewmasterBrawler_OnDamaged)
call SaveTriggerHandle(L7,h,StringHash("BrewmasterBrawlerDamageTrigger"),t)
set t=null
endif
set target=null
endfunction
function BrewmasterBrawler_StanceName takes integer stance returns string
if stance==2 then
return "风姿态"
elseif stance==3 then
return "火姿态"
endif
return "土姿态"
endfunction
function BrewmasterBrawler_ApplyVisual takes unit caster,integer stance returns nothing
if stance==2 then
call SetUnitVertexColor(caster,80,190,255,255)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",caster,"origin"))
elseif stance==3 then
call SetUnitVertexColor(caster,255,110,70,255)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",caster,"origin"))
else
call SetUnitVertexColor(caster,180,140,80,255)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",caster,"origin"))
endif
endfunction
function BrewmasterBrawler_OnSpellCondition takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0MX' or B287_GetSpellAbilityId()=='A06M' or B287_GetSpellAbilityId()=='Acdh'
endfunction
function BrewmasterBrawler_OnSpellEffect takes nothing returns nothing
local unit caster=GetTriggerUnit()
local integer spell=B287_GetSpellAbilityId()
local integer stance
if spell=='A0MX' then
set stance=BrewmasterBrawler_GetStance(caster)+1
if stance>3 then
set stance=1
endif
call SaveInteger(L7,GetHandleId(caster),StringHash("BrewmasterBrawlerStance"),stance)
call BrewmasterBrawler_ApplyVisual(caster,stance)
call BrewmasterBrawler_RegisterDamage(caster)
call BrewmasterBrawler_SetBrewed(caster,5.)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\StrongDrink\\BrewmasterTarget.mdl",caster,"origin"))
call DisplayTimedTextToPlayer(GetOwningPlayer(caster),0,0,2.5,"醉拳切换为"+BrewmasterBrawler_StanceName(stance))
else
call BrewmasterBrawler_SetScepterPower(caster,5.)
if spell=='A06M' then
call SaveUnitHandle(L7,StringHash("BrewmasterCinderThunderClap"),0,caster)
call ExecuteFunc("BrewmasterCinderBrew_ThunderClapIgnite")
endif
endif
set caster=null
endfunction
function BrewmasterBrawler_OnLearn takes nothing returns nothing
local unit caster=GetTriggerUnit()
if B287_GetLearnedSkill()=='A0MX' and IsUnitIllusion(caster)==false then
call BrewmasterBrawler_RegisterDamage(caster)
endif
set caster=null
endfunction
function BrewmasterBrawler_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function BrewmasterBrawler_OnSpellCondition))
call TriggerAddAction(t,function BrewmasterBrawler_OnSpellEffect)
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_HERO_SKILL,null)
set i=i+1
endloop
call TriggerAddAction(t,function BrewmasterBrawler_OnLearn)
call RegisterUnitAttackEvent("BrewmasterBrawler_CritEvent",0)
set t=null
endfunction
function PandaSplit_IsEarthType takes integer id returns boolean
return id=='npn3' or id=='npn6' or id=='n010' or id=='n0GZ'
endfunction
function PandaSplit_IsFireType takes integer id returns boolean
return id=='npn1' or id=='npn4' or id=='n011' or id=='n0H0'
endfunction
function PandaSplit_IsStormType takes integer id returns boolean
return id=='npn2' or id=='npn5' or id=='n012' or id=='n0H1'
endfunction
function PandaSplit_IsAlive takes unit u returns boolean
return u!=null and GetWidgetLife(u)>.405 and not IsUnitHidden(u)
endfunction
function PandaSplit_FireSkillByType takes integer id returns integer
if id=='npn1' then
return 'A19R'
elseif id=='npn4' then
return 'A19S'
elseif id=='n011' then
return 'A0YU'
elseif id=='n0H0' then
return 'A1CR'
endif
return 0
endfunction
function PandaSplit_FireSkillByEarth takes integer id returns integer
if id=='npn3' then
return 'A19R'
elseif id=='npn6' then
return 'A19S'
elseif id=='n010' then
return 'A0YU'
elseif id=='n0GZ' then
return 'A1CR'
endif
return 0
endfunction
function PandaSplit_RemoveFireSkill takes unit earth returns nothing
call UnitRemoveAbility(earth,'A19R')
call UnitRemoveAbility(earth,'A19S')
call UnitRemoveAbility(earth,'A0YU')
call UnitRemoveAbility(earth,'A1CR')
endfunction
function PandaSplit_RemoveStormSkills takes unit earth returns nothing
call UnitRemoveAbility(earth,'ACcy')
call UnitRemoveAbility(earth,'ANwk')
call UnitRemoveAbility(earth,'ACdm')
endfunction
function PandaSplit_AddStormSkills takes unit earth returns nothing
call UnitAddAbility(earth,'ACcy')
call UnitAddAbility(earth,'ANwk')
call UnitAddAbility(earth,'ACdm')
endfunction
function PandaSplit_AddEarthSkills takes unit earth,unit fire,unit storm returns nothing
local integer fireSkill=0
if earth==null then
return
endif
call UnitAddAbility(earth,'ACtb')
if fire!=null then
set fireSkill=PandaSplit_FireSkillByType(GetUnitTypeId(fire))
endif
if fireSkill==0 then
set fireSkill=PandaSplit_FireSkillByEarth(GetUnitTypeId(earth))
endif
if fireSkill!=0 then
call UnitAddAbility(earth,fireSkill)
endif
if storm!=null then
call PandaSplit_AddStormSkills(earth)
endif
endfunction
function PandaSplit_OrderFollowerTarget takes unit follower,unit target returns nothing
if PandaSplit_IsAlive(follower) and target!=null and GetWidgetLife(target)>.405 and IsUnitEnemy(target,GetOwningPlayer(follower)) then
call B947IssueTargetOrderById("PandaSplit_OrderFollowerTarget @ war3map.j:13819 (B968)",follower,851983,target)
endif
set follower=null
set target=null
endfunction
function PandaSplit_OrderFollowerPoint takes unit follower,integer orderId,real x,real y returns nothing
if PandaSplit_IsAlive(follower) then
call B947IssuePointOrderById("PandaSplit_OrderFollowerPoint @ war3map.j:13826 (B968)",follower,orderId,x,y)
endif
set follower=null
endfunction
function PandaSplit_CommandFollowers takes unit earth,unit target returns nothing
local integer h
if earth==null or target==null then
return
endif
set h=GetHandleId(earth)
call SaveUnitHandle(L7,h,StringHash("PandaSplitTarget"),target)
call PandaSplit_OrderFollowerTarget(LoadUnitHandle(L7,h,StringHash("PandaSplitFire")),target)
call PandaSplit_OrderFollowerTarget(LoadUnitHandle(L7,h,StringHash("PandaSplitStorm")),target)
endfunction
function PandaSplit_StopTimer takes timer t returns nothing
if t!=null then
call FlushChildHashtable(L7,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
endfunction
function PandaSplit_DestroyTriggerTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local trigger trig=LoadTriggerHandle(L7,GetHandleId(t),0)
if trig!=null then
call DestroyTrigger(trig)
endif
call PandaSplit_StopTimer(t)
set trig=null
set t=null
endfunction
function PandaSplit_QueueDestroyTrigger takes trigger trig returns nothing
local timer t
if trig==null then
return
endif
call DisableTrigger(trig)
set t=CreateTimer()
call SaveTriggerHandle(L7,GetHandleId(t),0,trig)
call TimerStart(t,0.,false,function PandaSplit_DestroyTriggerTimer)
set trig=null
set t=null
endfunction
function PandaSplit_CleanupEarth takes unit earth returns nothing
local integer h
local trigger trig
local timer tm
if earth==null then
return
endif
set h=GetHandleId(earth)
set trig=LoadTriggerHandle(L7,h,StringHash("PandaSplitEarthTrigger"))
set tm=LoadTimerHandle(L7,h,StringHash("PandaSplitFollowTimer"))
call RemoveSavedBoolean(L7,h,StringHash("PandaSplitActive"))
call RemoveSavedBoolean(L7,h,StringHash("PandaSplitFireReady"))
call RemoveSavedBoolean(L7,h,StringHash("PandaSplitStormReady"))
call RemoveSavedHandle(L7,h,StringHash("PandaSplitFire"))
call RemoveSavedHandle(L7,h,StringHash("PandaSplitStorm"))
call RemoveSavedHandle(L7,h,StringHash("PandaSplitTarget"))
call RemoveSavedHandle(L7,h,StringHash("PandaSplitFollowTimer"))
call RemoveSavedHandle(L7,h,StringHash("PandaSplitEarthTrigger"))
if trig!=null then
call PandaSplit_QueueDestroyTrigger(trig)
endif
if tm!=null then
call PandaSplit_StopTimer(tm)
endif
set trig=null
set tm=null
set earth=null
endfunction
function PandaSplit_ProtectOff takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit earth=LoadUnitHandle(L7,GetHandleId(t),0)
if earth!=null then
call SetUnitInvulnerableEx(earth,false)
endif
call PandaSplit_StopTimer(t)
set earth=null
set t=null
endfunction
function PandaSplit_StartProtect takes unit earth returns nothing
local timer t
if earth==null then
return
endif
set t=CreateTimer()
call SetUnitInvulnerableEx(earth,true)
call SaveUnitHandle(L7,GetHandleId(t),0,earth)
call DestroyEffect(AddSpecialEffectTarget("effects\\MImmunEffect.mdx",earth,"origin"))
call TimerStart(t,.5,false,function PandaSplit_ProtectOff)
set t=null
set earth=null
endfunction
function PandaSplit_ConsumeFire takes unit earth returns boolean
local integer h
local unit fire
if earth==null then
return false
endif
set h=GetHandleId(earth)
set fire=LoadUnitHandle(L7,h,StringHash("PandaSplitFire"))
if LoadBoolean(L7,h,StringHash("PandaSplitFireReady")) and PandaSplit_IsAlive(fire) then
call SaveBoolean(L7,h,StringHash("PandaSplitFireReady"),false)
call PandaSplit_RemoveFireSkill(earth)
call KillUnit(fire)
set fire=null
return true
endif
if LoadBoolean(L7,h,StringHash("PandaSplitFireReady")) then
call SaveBoolean(L7,h,StringHash("PandaSplitFireReady"),false)
call PandaSplit_RemoveFireSkill(earth)
endif
set fire=null
return false
endfunction
function PandaSplit_ConsumeStorm takes unit earth returns boolean
local integer h
local unit storm
if earth==null then
return false
endif
set h=GetHandleId(earth)
set storm=LoadUnitHandle(L7,h,StringHash("PandaSplitStorm"))
if LoadBoolean(L7,h,StringHash("PandaSplitStormReady")) and PandaSplit_IsAlive(storm) then
call SaveBoolean(L7,h,StringHash("PandaSplitStormReady"),false)
call PandaSplit_RemoveStormSkills(earth)
call KillUnit(storm)
set storm=null
return true
endif
if LoadBoolean(L7,h,StringHash("PandaSplitStormReady")) then
call SaveBoolean(L7,h,StringHash("PandaSplitStormReady"),false)
call PandaSplit_RemoveStormSkills(earth)
endif
set storm=null
return false
endfunction
function PandaSplit_TryConsume takes unit earth returns boolean
local real hp
if earth==null then
return false
endif
if PandaSplit_ConsumeFire(earth) or PandaSplit_ConsumeStorm(earth) then
set hp=GetUnitState(earth,UNIT_STATE_MAX_LIFE)*.33
if hp<1. then
set hp=1.
endif
call YDWESetEventDamage(0.)
call SetWidgetLife(earth,hp)
call PandaSplit_StartProtect(earth)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",earth,"origin"))
return true
endif
return false
endfunction
function PandaSplit_RefreshDeadFollowers takes unit earth returns nothing
local integer h
local unit fire
local unit storm
if earth==null then
return
endif
set h=GetHandleId(earth)
set fire=LoadUnitHandle(L7,h,StringHash("PandaSplitFire"))
set storm=LoadUnitHandle(L7,h,StringHash("PandaSplitStorm"))
if LoadBoolean(L7,h,StringHash("PandaSplitFireReady")) and not PandaSplit_IsAlive(fire) then
call SaveBoolean(L7,h,StringHash("PandaSplitFireReady"),false)
call PandaSplit_RemoveFireSkill(earth)
endif
if LoadBoolean(L7,h,StringHash("PandaSplitStormReady")) and not PandaSplit_IsAlive(storm) then
call SaveBoolean(L7,h,StringHash("PandaSplitStormReady"),false)
call PandaSplit_RemoveStormSkills(earth)
endif
set fire=null
set storm=null
endfunction
function PandaSplit_EarthEvent takes nothing returns nothing
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local unit earth=GetTriggerUnit()
local real damage=0.
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call PandaSplit_CleanupEarth(earth)
else
set damage=b1060GetEventDamage
if LoadBoolean(L7,GetHandleId(earth),StringHash("PandaSplitActive")) and damage>0. and b1060GetEventDamageSource!=earth then
call PandaSplit_RefreshDeadFollowers(earth)
if damage+.405>=GetWidgetLife(earth) then
call PandaSplit_TryConsume(earth)
endif
endif
endif
set earth=null
set b1060GetEventDamageSource=null
endfunction
function PandaSplit_RegisterEarth takes unit earth returns nothing
local integer h
local trigger trig
if earth==null then
return
endif
set h=GetHandleId(earth)
if LoadTriggerHandle(L7,h,StringHash("PandaSplitEarthTrigger"))==null then
set trig=CreateTrigger()
call B1023RegisterDamage(trig,earth)
call TriggerRegisterUnitEvent(trig,earth,EVENT_UNIT_DEATH)
call TriggerAddAction(trig,function PandaSplit_EarthEvent)
call SaveTriggerHandle(L7,h,StringHash("PandaSplitEarthTrigger"),trig)
set trig=null
endif
set earth=null
endfunction
function PandaSplit_FollowTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit earth=LoadUnitHandle(L7,th,0)
local integer h
local unit fire
local unit storm
local unit target
local real x
local real y
if earth==null then
call PandaSplit_StopTimer(t)
set t=null
return
endif
set h=GetHandleId(earth)
if not LoadBoolean(L7,h,StringHash("PandaSplitActive")) or GetWidgetLife(earth)<=.405 or IsUnitHidden(earth) then
call PandaSplit_CleanupEarth(earth)
set earth=null
set t=null
return
endif
call PandaSplit_RefreshDeadFollowers(earth)
set fire=LoadUnitHandle(L7,h,StringHash("PandaSplitFire"))
set storm=LoadUnitHandle(L7,h,StringHash("PandaSplitStorm"))
set target=LoadUnitHandle(L7,h,StringHash("PandaSplitTarget"))
if target!=null and GetWidgetLife(target)>.405 and IsUnitEnemy(target,GetOwningPlayer(earth)) then
call PandaSplit_OrderFollowerTarget(fire,target)
call PandaSplit_OrderFollowerTarget(storm,target)
else
set x=GetUnitX(earth)
set y=GetUnitY(earth)
if PandaSplit_IsAlive(fire) and (GetUnitX(fire)-x)*(GetUnitX(fire)-x)+(GetUnitY(fire)-y)*(GetUnitY(fire)-y)>202500. then
call B947IssuePointOrderById("PandaSplit_FollowTick @ war3map.j:14070 (B968)",fire,851986,x,y)
endif
if PandaSplit_IsAlive(storm) and (GetUnitX(storm)-x)*(GetUnitX(storm)-x)+(GetUnitY(storm)-y)*(GetUnitY(storm)-y)>202500. then
call B947IssuePointOrderById("PandaSplit_FollowTick @ war3map.j:14073 (B968)",storm,851986,x,y)
endif
endif
set fire=null
set storm=null
set target=null
set earth=null
set t=null
endfunction
function PandaSplit_StartFollow takes unit earth returns nothing
local timer t
if earth==null then
return
endif
if LoadTimerHandle(L7,GetHandleId(earth),StringHash("PandaSplitFollowTimer"))==null then
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,earth)
call SaveTimerHandle(L7,GetHandleId(earth),StringHash("PandaSplitFollowTimer"),t)
call TimerStart(t,.45,true,function PandaSplit_FollowTick)
set t=null
endif
set earth=null
endfunction
function PandaSplit_Setup takes unit earth,unit fire,unit storm returns nothing
local integer h
if earth==null then
return
endif
set h=GetHandleId(earth)
call SaveBoolean(L7,h,StringHash("PandaSplitActive"),true)
call SaveUnitHandle(L7,h,StringHash("PandaSplitFire"),fire)
call SaveUnitHandle(L7,h,StringHash("PandaSplitStorm"),storm)
call SaveBoolean(L7,h,StringHash("PandaSplitFireReady"),PandaSplit_IsAlive(fire))
call SaveBoolean(L7,h,StringHash("PandaSplitStormReady"),PandaSplit_IsAlive(storm))
call PandaSplit_AddEarthSkills(earth,fire,storm)
call PandaSplit_RegisterEarth(earth)
call PandaSplit_StartFollow(earth)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",earth,"origin"))
set earth=null
set fire=null
set storm=null
endfunction
function PandaSplit_DelayedSetup takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local integer pid=LoadInteger(L7,th,0)
local real x=LoadReal(L7,th,1)
local real y=LoadReal(L7,th,2)
local integer tryCount=LoadInteger(L7,th,StringHash("PandaSplitSetupTry"))+1
local group g=CreateGroup()
local unit u
local unit earth=null
local unit fire=null
local unit storm=null
local integer id
local real d
local real de=999999.
local real df=999999.
local real ds=999999.
local boolean done=false
call GroupEnumUnitsInRange(g,x,y,900.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if GetOwningPlayer(u)==Player(pid) and PandaSplit_IsAlive(u) then
set id=GetUnitTypeId(u)
set d=(GetUnitX(u)-x)*(GetUnitX(u)-x)+(GetUnitY(u)-y)*(GetUnitY(u)-y)
if PandaSplit_IsEarthType(id) and d<de then
set de=d
set earth=u
elseif PandaSplit_IsFireType(id) and d<df then
set df=d
set fire=u
elseif PandaSplit_IsStormType(id) and d<ds then
set ds=d
set storm=u
endif
endif
endloop
if earth!=null and fire!=null and storm!=null then
set done=true
call PandaSplit_Setup(earth,fire,storm)
elseif tryCount>=20 and earth!=null then
set done=true
call PandaSplit_Setup(earth,fire,storm)
elseif tryCount>=20 then
set done=true
else
call SaveInteger(L7,th,StringHash("PandaSplitSetupTry"),tryCount)
endif
call DestroyGroup(g)
if done then
call PandaSplit_StopTimer(t)
endif
set u=null
set earth=null
set fire=null
set storm=null
set g=null
set t=null
endfunction
function PandaSplit_ScheduleSetup takes unit caster returns nothing
local timer t
if caster==null then
return
endif
set t=CreateTimer()
call SaveInteger(L7,GetHandleId(t),0,GetPlayerId(GetOwningPlayer(caster)))
call SaveReal(L7,GetHandleId(t),1,GetUnitX(caster))
call SaveReal(L7,GetHandleId(t),2,GetUnitY(caster))
call SaveInteger(L7,GetHandleId(t),StringHash("PandaSplitSetupTry"),0)
call TimerStart(t,.10,true,function PandaSplit_DelayedSetup)
set t=null
set caster=null
endfunction
function PandaSplit_ScriptedRestore takes timer t,boolean survived returns nothing
local integer th=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,th,0)
local unit earth=LoadUnitHandle(L7,th,1)
local unit fire=LoadUnitHandle(L7,th,2)
local unit storm=LoadUnitHandle(L7,th,3)
local unit survivor=null
local player p=null
local integer h=0
local integer serial=LoadInteger(L7,th,4)
local real x=0.
local real y=0.
local real life=.01
if caster==null or GetUnitTypeId(caster)==0 then
call PandaSplit_CleanupEarth(earth)
if earth!=null then
call RemoveUnit(earth)
endif
if fire!=null then
call RemoveUnit(fire)
endif
if storm!=null then
call RemoveUnit(storm)
endif
call PandaSplit_StopTimer(t)
set caster=null
set earth=null
set fire=null
set storm=null
set survivor=null
set p=null
set t=null
return
endif
set h=GetHandleId(caster)
if serial!=LoadInteger(L7,h,StringHash("PandaSplitScriptedSerial")) then
call PandaSplit_StopTimer(t)
set caster=null
set earth=null
set fire=null
set storm=null
set survivor=null
set p=null
set t=null
return
endif
if survived then
if PandaSplit_IsAlive(earth) then
set survivor=earth
elseif PandaSplit_IsAlive(storm) then
set survivor=storm
elseif PandaSplit_IsAlive(fire) then
set survivor=fire
else
set survived=false
endif
endif
if survived then
set x=GetUnitX(survivor)
set y=GetUnitY(survivor)
set life=GetWidgetLife(survivor)/GetUnitState(survivor,UNIT_STATE_MAX_LIFE)
if life<.01 then
set life=.01
elseif life>1. then
set life=1.
endif
else
set x=GetUnitX(caster)
set y=GetUnitY(caster)
endif
call PandaSplit_CleanupEarth(earth)
if earth!=null then
call RemoveUnit(earth)
endif
if fire!=null then
call RemoveUnit(fire)
endif
if storm!=null then
call RemoveUnit(storm)
endif
call SaveBoolean(L7,h,StringHash("PandaSplitScriptedActive"),false)
call ShowUnit(caster,true)
call SetUnitX(caster,x)
call SetUnitY(caster,y)
call SetUnitPathing(caster,true)
call SetUnitInvulnerableEx(caster,false)
call PauseUnitEx(caster,false)
if survived then
call SetWidgetLife(caster,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*life)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",caster,"origin"))
set p=GetOwningPlayer(caster)
call SelectUnitForPlayerSingle(caster,p)
set B1116ReconcileWakeUnit=caster
call ExecuteFunc("B1116ResumeEventReconcile")
else
call KillUnit(caster)
endif
call PandaSplit_StopTimer(t)
set caster=null
set earth=null
set fire=null
set storm=null
set survivor=null
set p=null
set t=null
endfunction
function PandaSplit_ScriptedTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,th,0)
local unit earth=LoadUnitHandle(L7,th,1)
local unit fire=LoadUnitHandle(L7,th,2)
local unit storm=LoadUnitHandle(L7,th,3)
local boolean anyAlive=PandaSplit_IsAlive(earth) or PandaSplit_IsAlive(fire) or PandaSplit_IsAlive(storm)
if caster==null or GetUnitTypeId(caster)==0 then
call PandaSplit_ScriptedRestore(t,false)
elseif not anyAlive then
call PandaSplit_ScriptedRestore(t,false)
elseif TimerGetElapsed(W)>=LoadReal(L7,th,5) then
call PandaSplit_ScriptedRestore(t,true)
endif
set caster=null
set earth=null
set fire=null
set storm=null
set t=null
endfunction
function PandaSplit_StartScripted takes unit caster,integer rawSkill returns nothing
local integer logicalSkill='A0MQ'
local integer level=IMaxBJ(B287_GetUnitAbilityLevel(caster,'A0MQ'),B287_GetUnitAbilityLevel(caster,'A1B6'))
local integer fireId=0
local integer stormId=0
local integer earthId=0
local integer serial
local integer count
local real duration
local real x
local real y
local real facing
local player p
local unit fire
local unit storm
local unit earth
local timer t
if caster==null or GetUnitTypeId(caster)==0 or LoadBoolean(L7,GetHandleId(caster),StringHash("PandaSplitScriptedActive")) then
set caster=null
return
endif
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if LoadBoolean(L7,GetHandleId(caster),StringHash("SuijiScepterActive"+I2S('A0MQ'))) then
if level==1 then
set fireId='npn4'
set stormId='npn5'
set earthId='npn6'
set duration=20.
elseif level==2 then
set fireId='n011'
set stormId='n012'
set earthId='n010'
set duration=23.
else
set fireId='n0H0'
set stormId='n0H1'
set earthId='n0GZ'
set duration=26.
endif
else
if level==1 then
set fireId='npn1'
set stormId='npn2'
set earthId='npn3'
set duration=15.
elseif level==2 then
set fireId='npn4'
set stormId='npn5'
set earthId='npn6'
set duration=17.
else
set fireId='n011'
set stormId='n012'
set earthId='n010'
set duration=19.
endif
endif
set count=1
if SUIJI_MODE and LoadReal(L7,GetHandleId(caster),StringHash("SuijiDurationMulticastUntil"))>=TimerGetElapsed(W) and LoadInteger(L7,GetHandleId(caster),StringHash("SuijiDurationMulticastSkill"))==logicalSkill then
set count=LoadInteger(L7,GetHandleId(caster),StringHash("SuijiDurationMulticastCount"))
if count<1 then
set count=1
endif
endif
set duration=duration*count
set x=GetUnitX(caster)
set y=GetUnitY(caster)
set facing=GetUnitFacing(caster)
set p=GetOwningPlayer(caster)
set fire=CreateUnit(p,fireId,x+90.,y,facing)
set storm=CreateUnit(p,stormId,x-45.,y+78.,facing)
set earth=CreateUnit(p,earthId,x-45.,y-78.,facing)
if fire==null or storm==null or earth==null then
if fire!=null then
call RemoveUnit(fire)
endif
if storm!=null then
call RemoveUnit(storm)
endif
if earth!=null then
call RemoveUnit(earth)
endif
set caster=null
set fire=null
set storm=null
set earth=null
set p=null
return
endif
set serial=LoadInteger(L7,GetHandleId(caster),StringHash("PandaSplitScriptedSerial"))+1
call SaveInteger(L7,GetHandleId(caster),StringHash("PandaSplitScriptedSerial"),serial)
call SaveBoolean(L7,GetHandleId(caster),StringHash("PandaSplitScriptedActive"),true)
call PandaSplit_Setup(earth,fire,storm)
call SetUnitInvulnerableEx(caster,true)
call PauseUnitEx(caster,true)
call SetUnitPathing(caster,false)
call ShowUnit(caster,false)
call SelectUnitForPlayerSingle(earth,p)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,caster)
call SaveUnitHandle(L7,GetHandleId(t),1,earth)
call SaveUnitHandle(L7,GetHandleId(t),2,fire)
call SaveUnitHandle(L7,GetHandleId(t),3,storm)
call SaveInteger(L7,GetHandleId(t),4,serial)
call SaveReal(L7,GetHandleId(t),5,TimerGetElapsed(W)+duration)
call TimerStart(t,.10,true,function PandaSplit_ScriptedTick)
set caster=null
set fire=null
set storm=null
set earth=null
set p=null
set t=null
endfunction
function B1117StopNativePandaReturn takes timer pandaReturnTimer1117 returns nothing
local integer pandaReturnTimerKey1117=GetHandleId(pandaReturnTimer1117)
local integer pandaReturnHeroKey1117=LoadInteger(L7,pandaReturnTimerKey1117,1)
if LoadTimerHandle(L7,pandaReturnHeroKey1117,StringHash("B1117NativePandaReturnTimer"))==pandaReturnTimer1117 then
call RemoveSavedHandle(L7,pandaReturnHeroKey1117,StringHash("B1117NativePandaReturnTimer"))
endif
call PandaSplit_StopTimer(pandaReturnTimer1117)
endfunction
function B1117NativePandaReturnTick takes nothing returns nothing
local timer pandaReturnTimer1117=GetExpiredTimer()
local integer pandaReturnTimerKey1117=GetHandleId(pandaReturnTimer1117)
local unit pandaReturnHero1117=LoadUnitHandle(L7,pandaReturnTimerKey1117,0)
local integer pandaReturnHeroKey1117=LoadInteger(L7,pandaReturnTimerKey1117,1)
local boolean pandaReturnWake1117=false
local boolean pandaReturnStop1117=false
local real pandaReturnNow1117=TimerGetElapsed(W)
if pandaReturnHero1117==null or GetUnitTypeId(pandaReturnHero1117)==0 then
set pandaReturnStop1117=true
elseif LoadTimerHandle(L7,pandaReturnHeroKey1117,StringHash("B1117NativePandaReturnTimer"))!=pandaReturnTimer1117 then
set pandaReturnStop1117=true
elseif M7[GetPlayerId(GetOwningPlayer(pandaReturnHero1117))]!=pandaReturnHero1117 then
set pandaReturnStop1117=true
elseif IsUnitHidden(pandaReturnHero1117) then
// ANef's hidden caster is not assumed to satisfy UnitAlive throughout the split.
call SaveBoolean(L7,pandaReturnTimerKey1117,3,true)
elseif LoadBoolean(L7,pandaReturnTimerKey1117,3) or pandaReturnNow1117>=LoadReal(L7,pandaReturnTimerKey1117,4) then
// A visible caster after an observed hide is a real return. The setup grace
// also covers a split that ended before the first sample or never hid.
set pandaReturnWake1117=true
set pandaReturnStop1117=true
endif
if pandaReturnNow1117>=LoadReal(L7,pandaReturnTimerKey1117,2) then
set pandaReturnStop1117=true
endif
if pandaReturnStop1117 then
// Detach and destroy this generation before Resume may allocate another timer.
call B1117StopNativePandaReturn(pandaReturnTimer1117)
if pandaReturnWake1117 then
set B1116ReconcileWakeUnit=pandaReturnHero1117
call ExecuteFunc("B1116ResumeEventReconcile")
endif
endif
set pandaReturnHero1117=null
set pandaReturnTimer1117=null
endfunction
function B1117StartNativePandaReturn takes unit pandaReturnHero1117 returns nothing
local integer pandaReturnHeroKey1117=0
local integer pandaReturnTimerKey1117=0
local integer pandaReturnCount1117=1
local integer pandaReturnSkill1117=0
local integer pandaReturnPlayer1117=0
local real pandaReturnNow1117=TimerGetElapsed(W)
local timer pandaReturnTimer1117=null
if not SUIJI_MODE or pandaReturnHero1117==null or GetUnitTypeId(pandaReturnHero1117)==0 or IsUnitIllusion(pandaReturnHero1117) then
return
endif
set pandaReturnPlayer1117=GetPlayerId(GetOwningPlayer(pandaReturnHero1117))
if pandaReturnPlayer1117<0 or pandaReturnPlayer1117>11 or M7[pandaReturnPlayer1117]!=pandaReturnHero1117 then
return
endif
set pandaReturnHeroKey1117=GetHandleId(pandaReturnHero1117)
set pandaReturnTimer1117=LoadTimerHandle(L7,pandaReturnHeroKey1117,StringHash("B1117NativePandaReturnTimer"))
if pandaReturnTimer1117!=null then
call B1117StopNativePandaReturn(pandaReturnTimer1117)
endif
// CAST stores its roll for four seconds. EUD's only nonzero results are 2..5;
// native ANef's longest Scepter definition is 26 seconds, hence at most 130.
set pandaReturnSkill1117=LoadInteger(L7,pandaReturnHeroKey1117,StringHash("SuijiDurationMulticastSkill"))
if (pandaReturnSkill1117=='A0MQ' or pandaReturnSkill1117=='A1B6') and LoadReal(L7,pandaReturnHeroKey1117,StringHash("SuijiDurationMulticastUntil"))>=pandaReturnNow1117 then
set pandaReturnCount1117=LoadInteger(L7,pandaReturnHeroKey1117,StringHash("SuijiDurationMulticastCount"))
endif
set pandaReturnCount1117=IMaxBJ(1,IMinBJ(5,pandaReturnCount1117))
set pandaReturnTimer1117=CreateTimer()
set pandaReturnTimerKey1117=GetHandleId(pandaReturnTimer1117)
call SaveTimerHandle(L7,pandaReturnHeroKey1117,StringHash("B1117NativePandaReturnTimer"),pandaReturnTimer1117)
call SaveUnitHandle(L7,pandaReturnTimerKey1117,0,pandaReturnHero1117)
call SaveInteger(L7,pandaReturnTimerKey1117,1,pandaReturnHeroKey1117)
call SaveReal(L7,pandaReturnTimerKey1117,2,pandaReturnNow1117+26.*I2R(pandaReturnCount1117)+4.)
call SaveBoolean(L7,pandaReturnTimerKey1117,3,IsUnitHidden(pandaReturnHero1117))
// Existing native element setup already waits at most twenty .10-second ticks.
call SaveReal(L7,pandaReturnTimerKey1117,4,pandaReturnNow1117+2.)
call TimerStart(pandaReturnTimer1117,.25,true,function B1117NativePandaReturnTick)
set pandaReturnTimer1117=null
endfunction
function PandaSplit_OnSpellCondition takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0MQ' or B287_GetSpellAbilityId()=='A1B6'
endfunction
function PandaSplit_OnSpellEffect takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if GetSpellAbilityId()=='Y0CV' or GetSpellAbilityId()=='Y0DS' then
call PandaSplit_StartScripted(b1060GetTriggerUnit,GetSpellAbilityId())
else
call B1117StartNativePandaReturn(b1060GetTriggerUnit)
call PandaSplit_ScheduleSetup(b1060GetTriggerUnit)
endif
set b1060GetTriggerUnit=null
endfunction
function PandaSplit_OnAttack takes nothing returns boolean
local unit earth=GetAttacker()
local unit target=GetTriggerUnit()
if earth!=null and LoadBoolean(L7,GetHandleId(earth),StringHash("PandaSplitActive")) and PandaSplit_IsEarthType(GetUnitTypeId(earth)) then
call PandaSplit_CommandFollowers(earth,target)
endif
set earth=null
set target=null
return false
endfunction
function PandaSplit_OnTargetOrder takes nothing returns boolean
local unit earth=GetTriggerUnit()
local unit target=GetOrderTargetUnit()
local integer orderId=GetIssuedOrderId()
if earth!=null and target!=null and LoadBoolean(L7,GetHandleId(earth),StringHash("PandaSplitActive")) and PandaSplit_IsEarthType(GetUnitTypeId(earth)) then
if (orderId==851983 or orderId==851971) and IsUnitEnemy(target,GetOwningPlayer(earth)) then
call PandaSplit_CommandFollowers(earth,target)
endif
endif
set earth=null
set target=null
return false
endfunction
function PandaSplit_OnPointOrder takes nothing returns boolean
local unit earth=GetTriggerUnit()
local integer h
local integer orderId=GetIssuedOrderId()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
if earth!=null and LoadBoolean(L7,GetHandleId(earth),StringHash("PandaSplitActive")) and PandaSplit_IsEarthType(GetUnitTypeId(earth)) then
if orderId==851986 or orderId==851983 then
set h=GetHandleId(earth)
call PandaSplit_OrderFollowerPoint(LoadUnitHandle(L7,h,StringHash("PandaSplitFire")),orderId,x,y)
call PandaSplit_OrderFollowerPoint(LoadUnitHandle(L7,h,StringHash("PandaSplitStorm")),orderId,x,y)
endif
endif
set earth=null
return false
endfunction
function PandaSplit_Init takes nothing returns nothing
local trigger t
local integer h=StringHash("PandaSplitInit")
local integer i
if LoadBoolean(L7,h,0) then
return
endif
call SaveBoolean(L7,h,0,true)
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function PandaSplit_OnSpellCondition))
call TriggerAddAction(t,function PandaSplit_OnSpellEffect)
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ATTACKED,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function PandaSplit_OnAttack))
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function PandaSplit_OnTargetOrder))
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function PandaSplit_OnPointOrder))
set t=null
endfunction
function NagaSirenAghMirror_IsHero takes unit u returns boolean
return u!=null and (GetUnitTypeId(u)=='HC49' or LoadBoolean(L7,GetHandleId(u),StringHash("SuijiNagaScepter"))) and IsUnitIllusion(u)==false
endfunction
function NagaSirenAghMirror_HasScepter takes unit u returns boolean
if u==null then
return false
endif
return LoadBoolean(L7,GetHandleId(u),StringHash("SuijiHasScepter")) or MV7(u,ZU[R1H])!=null or MV7(u,ZU[R1K])!=null or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0
endfunction
function NagaSirenAghMirror_GetLevel takes unit u returns integer
local integer level=B287_GetUnitAbilityLevel(u,'A063')
local integer aghLevel=GetUnitAbilityLevel(u,'A4NS')
if aghLevel>level then
return aghLevel
endif
return level
endfunction
function NagaSirenAghMirror_Update takes unit u returns nothing
if not NagaSirenAghMirror_IsHero(u) then
return
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A063',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4NS',false)
if GetUnitAbilityLevel(u,'A4NS')>0 then
call UnitRemoveAbility(u,'A4NS')
endif
endfunction
function NagaSirenRipTide_GetLevel takes unit u returns integer
local integer level=GetUnitAbilityLevel(u,'A2KU')
local integer passiveLevel=GetUnitAbilityLevel(u,'A4RT')
if passiveLevel>level then
return passiveLevel
endif
return level
endfunction
function NagaSirenRipTide_Update takes unit u returns nothing
if not NagaSirenAghMirror_IsHero(u) then
return
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2KU',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4RT',false)
if GetUnitAbilityLevel(u,'A4RT')>0 then
call UnitRemoveAbility(u,'A4RT')
endif
endfunction
function NagaSirenAghMirror_OnLearn takes nothing returns nothing
local unit u=GetTriggerUnit()
if IsUnitIllusion(u)==false and (B287_GetLearnedSkill()=='A063' or B287_GetLearnedSkill()=='A4NS' or B287_GetLearnedSkill()=='A2KU' or B287_GetLearnedSkill()=='A4RT') then
call NagaSirenAghMirror_Update(u)
call NagaSirenRipTide_Update(u)
endif
set u=null
endfunction
function NagaSirenAghMirror_OnItem takes nothing returns boolean
local unit u=GetTriggerUnit()
call NagaSirenAghMirror_Update(u)
call NagaSirenRipTide_Update(u)
set u=null
return false
endfunction
function NagaSirenAghMirror_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_HERO_SKILL,null)
set i=i+1
endloop
call TriggerAddAction(t,function NagaSirenAghMirror_OnLearn)
set t=CreateTrigger()
set i=0
loop
exitwhen i>15
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_PICKUP_ITEM,null)
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_DROP_ITEM,null)
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_PAWN_ITEM,null)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function NagaSirenAghMirror_OnItem))
set t=null
endfunction
function BrewmasterCinderBrew_IsSpellDamage takes integer BL7 returns boolean
return BL7==1 or BL7==3 or BL7==7 or BL7==8 or BL7==9 or BL7>=11
endfunction
function BrewmasterCinderBrew_LevelOfTarget takes unit target returns integer
local integer level=LoadInteger(L7,GetHandleId(target),StringHash("BrewmasterCinderLevel"))
if level<1 then
if GetUnitAbilityLevel(target,'A3PU')>0 then
set level=4
elseif GetUnitAbilityLevel(target,'A3PT')>0 then
set level=3
elseif GetUnitAbilityLevel(target,'A3PS')>0 then
set level=2
elseif GetUnitAbilityLevel(target,'A3PR')>0 then
set level=1
endif
endif
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
return level
endfunction
function BrewmasterCinderBrew_ClearTargetData takes unit target returns nothing
local integer h
if target!=null then
set h=GetHandleId(target)
if UnitAlive(target)==false or (GetUnitAbilityLevel(target,'BNdh')==0 and LoadReal(L7,h,StringHash("BrewmasterCinderExpire"))<=TimerGetElapsed(W)) then
call RemoveSavedInteger(L7,h,StringHash("BrewmasterCinderBurning"))
call RemoveSavedInteger(L7,h,StringHash("BrewmasterCinderLevel"))
call RemoveSavedHandle(L7,h,StringHash("BrewmasterCinderCaster"))
call RemoveSavedReal(L7,h,StringHash("BrewmasterCinderExpire"))
endif
endif
endfunction
function BrewmasterCinderBrew_CleanupTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit target=LoadUnitHandle(L7,h,0)
call BrewmasterCinderBrew_ClearTargetData(target)
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set target=null
set t=null
endfunction
function BrewmasterCinderBrew_StartCleanup takes unit target returns nothing
local timer t
local integer h
if target==null then
return
endif
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,target)
call TimerStart(t,5.2,false,function BrewmasterCinderBrew_CleanupTimer)
set t=null
endfunction
function BrewmasterCinderBrew_BurnTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,h,0)
local unit target=LoadUnitHandle(L7,h,1)
local integer level=LoadInteger(L7,h,2)
local integer tick=LoadInteger(L7,h,3)+1
if caster==null or target==null or UnitAlive(target)==false or GetUnitAbilityLevel(target,'BNdh')==0 or tick>5 then
if target!=null then
call SaveInteger(L7,GetHandleId(target),StringHash("BrewmasterCinderBurning"),0)
call BrewmasterCinderBrew_ClearTargetData(target)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
else
call SaveInteger(L7,h,3,tick)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireDamage.mdl",target,"chest"))
call UnitDamageTarget(caster,target,10.+10.*level,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
endif
set caster=null
set target=null
set t=null
endfunction
function BrewmasterCinderBrew_TryIgnite takes unit source,unit target,integer BL7 returns nothing
local integer h
local integer level
local unit caster
local timer t
if source==null or target==null or BrewmasterCinderBrew_IsSpellDamage(BL7)==false then
return
endif
if UnitAlive(target)==false or GetUnitAbilityLevel(target,'BNdh')==0 or LoadInteger(L7,GetHandleId(target),StringHash("BrewmasterCinderBurning"))==1 then
return
endif
set h=GetHandleId(target)
set caster=LoadUnitHandle(L7,h,StringHash("BrewmasterCinderCaster"))
if caster==null then
set caster=source
endif
if IsUnitEnemy(target,GetOwningPlayer(caster))==false then
set caster=source
endif
set level=BrewmasterCinderBrew_LevelOfTarget(target)
call SaveInteger(L7,h,StringHash("BrewmasterCinderBurning"),1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",target,"origin"))
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,caster)
call SaveUnitHandle(L7,h,1,target)
call SaveInteger(L7,h,2,level)
call SaveInteger(L7,h,3,0)
call TimerStart(t,1.,true,function BrewmasterCinderBrew_BurnTick)
set caster=null
set t=null
endfunction
function BrewmasterCinderBrew_ThunderClapIgnite takes nothing returns nothing
local integer h=StringHash("BrewmasterCinderThunderClap")
local unit caster=LoadUnitHandle(L7,h,0)
local group g
local unit u=null
local player p
call RemoveSavedHandle(L7,h,0)
if caster==null then
set caster=null
return
endif
set g=CreateGroup()
set p=GetOwningPlayer(caster)
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),400.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if UnitAlive(u) and IsUnitEnemy(u,p) and GetUnitAbilityLevel(u,'BNdh')>0 and not IsUnitType(u,UNIT_TYPE_STRUCTURE) and not IsUnitHidden(u) then
call BrewmasterCinderBrew_TryIgnite(caster,u,3)
endif
endloop
call DestroyGroup(g)
set u=null
set p=null
set g=null
set caster=null
endfunction
function MRPH takes unit ZX7 returns boolean
return GetUnitAbilityLevel(ZX7,'BNdd')>0
endfunction
function SKPH takes unit ZX7 returns boolean
return GetUnitAbilityLevel(ZX7,'B0JW')>0
endfunction
function ISPH takes unit ZX7 returns boolean
return MRPH(ZX7) or SKPH(ZX7)
endfunction
function ISSTUN takes unit ZX7 returns boolean
    return MHUnit_IsFlag2(ZX7,UNIT_FLAG2_STUN)
endfunction
function ISWUDI takes unit ZX7 returns boolean
    return MHUnit_IsFlag1(ZX7,UNIT_FLAG1_INVULNERABLE)
endfunction
function ISYINSHEN takes unit ZX7 returns boolean
    return MHUnit_IsFlag2(ZX7,UNIT_FLAG2_INVISIBLE)
endfunction
function Disable_Unit_Auto_Attack takes unit ZX7,boolean b returns nothing
    local integer n=MHUnit_GetDisableAutoAttackCount(ZX7)
    if (n==0 and b) or (n==1 and b==false) then
        call MHUnit_DisableAutoAttack(ZX7,b)
    endif
endfunction
function GetUnitMissProbability takes unit whichUnit returns integer
	local real probability = 1
	local integer inventorySize
	local integer i = 0
	local item it
	local integer level
    local integer d
	// 模糊
	if IsAttackEffectEnabled[4]then
		set level = B287_GetUnitAbilityLevel(whichUnit,'A03P') * (1 -GetUnitAbilityLevel(whichUnit,'A4G4'))
		if level > 0 then
			set probability = probability *(.9 -0.1 * level)
		endif
	endif
	// 醉拳
	if IsAttackEffectEnabled[1] then
set d=BrewmasterBrawler_EvasionChance(whichUnit)
if d>0 then
set probability=probability*(1.-I2R(d)/100.)
		endif
	endif
	if IsAttackEffectEnabled[2]or IsAttackEffectEnabled[3]or IsAttackEffectEnabled[6]then
		set inventorySize = UnitInventorySize(whichUnit)
		loop
		exitwhen i > inventorySize
			set it = UnitItemInSlot(whichUnit, i)
			if it != null then
				if GetItemTypeId(it)== ZU[Z2] then
					// 蝴蝶 35%
					if GetUnitAbilityLevel(whichUnit,'A2R1') > 0 then
						set probability = probability * .65
					endif
				elseif GetItemTypeId(it)== ZU[JB] or GetItemTypeId(it)== ZU[R3] then
					// 闪避护符和天堂之戟 25%
					set probability = probability * .75
				endif
			endif
			set i = i + 1
		endloop
		set it = null
	endif
	//炎阳纹章
	if IsAttackEffectEnabled[5]then
		if GetUnitAbilityLevel(whichUnit,'A2RK')== 1 then
			set probability = probability * .75
		endif
		if GetUnitAbilityLevel(whichUnit,'A2T5')== 1 then
			set probability = probability * .75
		endif
	endif
	set d = 100 -R2I(probability * 100 )
    if d==31 then
        set d=30
    endif
    //蝴蝶主动
    if GetUnitAbilityLevel(whichUnit,'B0GU') > 0 then
        set d = 100
    endif
    if MRPH(whichUnit) then
        set d=0
    endif
    return d
endfunction
function UUEE takes integer c, integer ccc returns integer
	if c == 0 then
		return ccc
	endif
	return  100 -( 100 -c)*( 100 -ccc)/ 100 
endfunction
// 获取单位致盲几率
function GetUnitBlind takes unit u returns integer
	local integer c = 0
	//激光
	if IsAttackEffectEnabled[14]then
		if GetUnitAbilityLevel(u,'B02P')== 1 then
			set c = 100 
		endif
	endif
	if c != 100  then
		if IsAttackEffectEnabled[9]then
			if GetUnitAbilityLevel(u,'B01D')== 1 then
				if GetUnitAbilityLevel(u,'A3PY')== 1 then
					set c = UUEE(c, 60)
				elseif GetUnitAbilityLevel(u,'A3PV')== 1 then
					set c = UUEE(c, 30)
				elseif GetUnitAbilityLevel(u,'A3PW')== 1 then
					set c = UUEE(c, 40)
				elseif GetUnitAbilityLevel(u,'A3PX')== 1 then
					set c = UUEE(c, 50)
				endif
			endif
		endif
		if IsAttackEffectEnabled[13] then
			// 烟幕
			if GetUnitAbilityLevel(u,'Bhea')== 1 then
				set c = UUEE(c, 30 + 10 * YMDJ)
			endif
		endif
		if IsAttackEffectEnabled[10] then
			// 致盲之光
			if GetUnitAbilityLevel(u,'B09K')== 1 then
				set c = UUEE(c, 80)
			endif
		endif
		if IsAttackEffectEnabled[11]then
			// 伤残恐惧
			if GetUnitAbilityLevel(u,'B02M')== 1 and SCKJBT== 1 then
				set c = UUEE(c, 25)
			endif
			if GetUnitAbilityLevel(u,'B02M')== 1 and SCKJBT== 0 then
				set c = UUEE(c, 50)
			endif
		endif
		if IsAttackEffectEnabled[12]then
			// 辉耀
			if GetUnitAbilityLevel(u,'B0GR')== 1 then
				set c = UUEE(c, 17)
			endif
		endif
		if IsAttackEffectEnabled[15]then
			// 炎阳纹章
			if GetUnitAbilityLevel(u,'A2RL')== 1 and GetUnitAbilityLevel(u,'B0GW')>0 then
				set c = UUEE(c, 25)
			endif
			if GetUnitAbilityLevel(u,'A2RL')== 2 and GetUnitAbilityLevel(u,'B0GW')>0 then
				set c = UUEE(c, 12)
			endif
		endif
		if IsAttackEffectEnabled[16]then
			// 旋风飞斧
			if GetUnitAbilityLevel(u,'B00C')== 1 then
				set c = UUEE(c, 60)
			endif
		endif
	endif
	//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000致盲几率|r"+I2S(c))
	return c
endfunction
function JFX takes unit u returns nothing
	local integer WPV = GetUnitTypeId(u)
	local integer a = 255
	if HaveSavedInteger(TABLE_P, GetHandleId(u),'ALPH') then
		set a = LoadInteger(TABLE_P, GetHandleId(u),'ALPH')
	endif
	call SetUnitVertexColor(u,$80, 192, 192, a)
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 0,$80)
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 1, 192)
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 2, 192)
	call SaveInteger(TABLE_P, GetHandleId(u),'ALPH', a)
endfunction
// 恢复单位的RGB
function ResetUnitVertexColor takes unit u,integer WPV returns nothing
	local integer r = 255
	local integer g = 255
	local integer b = 255
	local integer a = 255
    local boolean J4=false
    if WPV==0 then
        set WPV = GetUnitTypeId(u)
        set J4 = true
    endif
	if HaveSavedInteger(TABLE_L, WPV, 0) then
		set r = LoadInteger(TABLE_L, WPV, 0)
	endif
	if HaveSavedInteger(TABLE_L, WPV, 1) then
		set g = LoadInteger(TABLE_L, WPV, 1)
	endif
	if HaveSavedInteger(TABLE_L, WPV, 2) then
		set b = LoadInteger(TABLE_L, WPV, 2)
	endif
	if HaveSavedInteger(TABLE_P, GetHandleId(u),'ALPH') then
		set a = LoadInteger(TABLE_P, GetHandleId(u),'ALPH')
	endif
	call SetUnitVertexColor(u, r, g, b, a)
    if J4 then
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 0, r)
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 1, g)
	call SaveInteger(TABLE_P, GetHandleId(u), ICC + 2, b)
	call SaveInteger(TABLE_P, GetHandleId(u),'ALPH', a)
    endif
endfunction
function SaveColorToUnitType takes integer whichTypeId, integer r, integer g, integer b returns nothing
	if r >-1 and r < 256 then
		call SaveInteger(TABLE_L, whichTypeId, 0, r)
	endif
	if g >-1 and g < 256 then
		call SaveInteger(TABLE_L, whichTypeId, 1, g)
	endif
	if b >-1 and b < 256 then
		call SaveInteger(TABLE_L, whichTypeId, 2, b)
	endif
endfunction
function GAIN_ITEM takes unit ZX7,unit u returns nothing
local item it=null
local integer n=0
    loop
    exitwhen n>5
    //set it=UnitItemInSlot(u,n)
    set it=UnitRemoveItemFromSlot(u,n)
    if it!=null then
        call UnitAddItem(ZX7,it)
        call UnitDropItemSlot(ZX7,it,n)
    endif
    set n=n+1
    endloop
endfunction
