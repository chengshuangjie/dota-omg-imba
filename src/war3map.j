function SuijiMode_ScepterRegistryHasSkill takes unit u,integer normalSkill,integer aghSkill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return B287_GetUnitAbilityLevel(u,normalSkill)>0 or (aghSkill!=0 and B287_GetUnitAbilityLevel(u,aghSkill)>0)
endfunction
function SuijiMode_ScepterRegistryResolvePairPhysical takes unit u,integer normalSkill,integer aghSkill returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
// Native hero learnable pairs remain engine-owned.  Random copies still
// resolve through B287's fixed physical clone table.
if SuijiMode_IsNativeLearnableAghPair(u,normalSkill,aghSkill) then
if GetUnitAbilityLevel(u,aghSkill)>0 then
return aghSkill
elseif GetUnitAbilityLevel(u,normalSkill)>0 then
return normalSkill
endif
endif
return B287_GetPhysicalAbilityId(u,normalSkill)
endfunction
function SuijiMode_ScepterRegistryAllowsLiveTooltip takes unit u,integer skill returns boolean
// Native transformation abilities rebuild their Ability object and command card
// while changing unit type.  Per-unit tooltip writes on those live objects can
// leave MemHack holding metadata for the pre-transform Ability object.
// Scripted Dragon Form also mutates several live combat helpers at form entry;
// keep its stable ANcl clone on static object text instead of mixing metadata
// writes into the same MemHack update window.
if skill=='A03G' or skill=='A03K' or skill=='A093' or skill=='X093' or skill=='X193' then
return false
endif
if skill=='A11T' or skill=='A4AS' or skill=='A15J' or skill=='X15J' then
return false
endif
if skill=='A1RI' or skill=='A1WH' or skill=='X1WH' or skill=='A2NE' or skill=='A3NE' then
return false
endif
return true
endfunction
function SuijiMode_ScepterRegistryWriteTooltip takes unit u,integer normalSkill,integer aghSkill,boolean active,string activeText returns boolean
local integer physicalSkill=0
local integer sourceSkill=normalSkill
local integer level=1
local integer maxLevel=0
local integer currentLevel=0
local ability a=null
local string tip=null
local string ubertip=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set physicalSkill=SuijiMode_ScepterRegistryResolvePairPhysical(u,normalSkill,aghSkill)
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return false
endif
set a=EXGetUnitAbility(u,physicalSkill)
if a==null then
set a=null
return false
endif
if active and aghSkill!=0 then
set sourceSkill=aghSkill
endif
// The native Invoker buttons have one object-data level. Their random OMG
// carriers have three authored levels, so transition-only Scepter tooltip
// refreshes must read the physical carrier rather than an absent native level.
if physicalSkill!=normalSkill and (normalSkill=='A0VG' or normalSkill=='A0VN') then
set sourceSkill=physicalSkill
endif
set maxLevel=MHAbility_GetDefDataInt(normalSkill,ABILITY_DEF_DATA_MAX_LEVEL)
if aghSkill!=0 then
set maxLevel=IMaxBJ(maxLevel,MHAbility_GetDefDataInt(aghSkill,ABILITY_DEF_DATA_MAX_LEVEL))
endif
set currentLevel=GetUnitAbilityLevel(u,physicalSkill)
if currentLevel>maxLevel then
set maxLevel=currentLevel
endif
if maxLevel<1 then
set maxLevel=1
endif
loop
exitwhen level>maxLevel
set tip=MHAbility_GetLevelDefDataStr(sourceSkill,level,ABILITY_LEVEL_DEF_DATA_TIP)
set ubertip=MHAbility_GetLevelDefDataStr(sourceSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
if tip==null or tip=="" then
set tip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP)
endif
if ubertip==null or ubertip=="" then
set ubertip=MHAbility_GetLevelDefDataStr(normalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
endif
if active then
set tip=tip+" |cffffcc00[神杖]|r"
set ubertip=ubertip+"|n|n|cffffcc00当前：神杖效果已启用"+activeText+"|r"
endif
call MHAbility_SetCustomLevelDataStr(u,physicalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP,tip)
call MHAbility_SetCustomLevelDataStr(u,physicalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,ubertip)
set level=level+1
endloop
set tip=null
set ubertip=null
set a=null
return true
endfunction
function SuijiMode_ScepterRegistryWriteWallTooltip takes unit u,boolean active returns boolean
local integer physicalSkill=0
local integer level=1
local integer maxLevel=0
local ability a=null
local string tip=null
local string ubertip=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,'A21Q')
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return false
endif
set a=EXGetUnitAbility(u,physicalSkill)
if a==null then
set a=null
return false
endif
set maxLevel=MHAbility_GetDefDataInt('A0QK',ABILITY_DEF_DATA_MAX_LEVEL)
if GetUnitAbilityLevel(u,physicalSkill)>maxLevel then
set maxLevel=GetUnitAbilityLevel(u,physicalSkill)
endif
if maxLevel<1 then
set maxLevel=1
endif
loop
exitwhen level>maxLevel
set tip=MHAbility_GetLevelDefDataStr('A0QK',level,ABILITY_LEVEL_DEF_DATA_TIP)
set ubertip=MHAbility_GetLevelDefDataStr('A0QK',level,ABILITY_LEVEL_DEF_DATA_UBERTIP)
if active then
set tip=tip+" |cffffcc00[神杖]|r"
set ubertip=ubertip+"|n|n|cffffcc00当前：神杖效果已启用（复制出的幻象攻击力提高）|r"
endif
call MHAbility_SetCustomLevelDataStr(u,physicalSkill,level,ABILITY_LEVEL_DEF_DATA_TIP,tip)
call MHAbility_SetCustomLevelDataStr(u,physicalSkill,level,ABILITY_LEVEL_DEF_DATA_UBERTIP,ubertip)
set level=level+1
endloop
set tip=null
set ubertip=null
set a=null
return true
endfunction
function SuijiMode_ScepterRegistryRefresh takes unit u,integer normalSkill,integer aghSkill,boolean active,string activeText returns boolean
local integer h=0
local integer physicalSkill=0
local boolean registered=false
local boolean changed=false
local boolean tooltipOk=false
local string suffix=""
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
set suffix=I2S(normalSkill)
set registered=OO7(h,"SuijiScepterRegistered"+suffix)
if SuijiMode_ScepterRegistryHasSkill(u,normalSkill,aghSkill)==false then
if registered then
if SuijiMode_ScepterRegistryAllowsLiveTooltip(u,normalSkill) then
call SuijiMode_ScepterRegistryWriteTooltip(u,normalSkill,aghSkill,false,activeText)
endif
call NS7(h,"SuijiScepterRegistered"+suffix,false)
call NS7(h,"SuijiScepterActive"+suffix,false)
call NS7(h,"SuijiScepterTooltipValid"+suffix,false)
call NP7(h,"SuijiScepterPhysical"+suffix,0)
set suffix=""
return true
endif
set suffix=""
return false
endif
set physicalSkill=SuijiMode_ScepterRegistryResolvePairPhysical(u,normalSkill,aghSkill)
set changed=registered==false or OO7(h,"SuijiScepterActive"+suffix)!=active or OM7(h,"SuijiScepterPhysical"+suffix)!=physicalSkill or OO7(h,"SuijiScepterTooltipValid"+suffix)==false
call NS7(h,"SuijiScepterRegistered"+suffix,true)
call NS7(h,"SuijiScepterActive"+suffix,active)
call NP7(h,"SuijiScepterPhysical"+suffix,physicalSkill)
if changed then
if SuijiMode_ScepterRegistryAllowsLiveTooltip(u,normalSkill) then
set tooltipOk=SuijiMode_ScepterRegistryWriteTooltip(u,normalSkill,aghSkill,active,activeText)
else
// Static object text already documents these upgrades.  Mark the transition as
// handled without mutating a command card that is about to be rebuilt.
set tooltipOk=true
endif
call NS7(h,"SuijiScepterTooltipValid"+suffix,tooltipOk)
endif
set suffix=""
return changed
endfunction
function SuijiMode_ScepterRegistryIsRegistered takes unit u,integer normalSkill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return OO7(GetHandleId(u),"SuijiScepterRegistered"+I2S(normalSkill))
endfunction
function SuijiMode_ScepterRegistryIsActive takes unit u,integer normalSkill returns boolean
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScepterRegistered"+I2S(normalSkill)) then
return OO7(h,"SuijiScepterActive"+I2S(normalSkill))
endif
return SuijiMode_HasAghanimState(u)
endfunction
function SuijiMode_GetRegisteredAghLevel takes unit u,integer normalSkill,integer aghSkill returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if SuijiMode_ScepterRegistryIsRegistered(u,normalSkill) then
if SuijiMode_ScepterRegistryIsActive(u,normalSkill) then
return IMaxBJ(B287_GetUnitAbilityLevel(u,normalSkill),B287_GetUnitAbilityLevel(u,aghSkill))
endif
return 0
endif
return B287_GetUnitAbilityLevel(u,aghSkill)
endfunction
// B925: one passive owner for native A086 and its random physical carriers.
function B925NightHunterSync takes unit hunterUnit925 returns nothing
local integer hunterLevel925=0
local integer hunterDesired925=5
local integer hunterEffect984=0
local integer hunterScan984=0
local integer hunterType984=GetUnitTypeId(hunterUnit925)
local integer hunterForm984=OM7(GetHandleId(hunterUnit925),"SuijiVisualCurrentStatus")
if hunterUnit925==null or GetUnitTypeId(hunterUnit925)==0 then
return
endif
set hunterLevel925=B287_GetUnitAbilityLevel(hunterUnit925,'A086')
if hunterLevel925>0 and not XH7(hunterUnit925) and not ISPH(hunterUnit925) then
if not X67() or SuijiMode_ScepterRegistryIsActive(hunterUnit925,'A086') then
set hunterDesired925=IMinBJ(4,hunterLevel925)
endif
endif
if hunterLevel925<=0 then
if GetUnitAbilityLevel(hunterUnit925,'S00A')>0 then
call UnitRemoveAbility(hunterUnit925,'S00A')
endif
else
set hunterEffect984='ZN01'+hunterDesired925-1
// A morph may retain the spellbook while dropping its effect child.
// Rebuild only this owned container when the desired child is missing.
if GetUnitAbilityLevel(hunterUnit925,'S00A')==hunterDesired925 and (GetUnitAbilityLevel(hunterUnit925,hunterEffect984)==0 or OM7(GetHandleId(hunterUnit925),"B984HunterType")!=hunterType984 or OM7(GetHandleId(hunterUnit925),"B984HunterForm")!=hunterForm984) then
call UnitRemoveAbility(hunterUnit925,'S00A')
call UnitRemoveAbility(hunterUnit925,hunterEffect984)
endif
call SuijiMode_EnsureHiddenRuntimeContainerLevel(hunterUnit925,'S00A',hunterDesired925)
if GetUnitAbilityLevel(hunterUnit925,hunterEffect984)>0 then
call UnitMakeAbilityPermanent(hunterUnit925,true,hunterEffect984)
endif
call NP7(GetHandleId(hunterUnit925),"B984HunterType",hunterType984)
call NP7(GetHandleId(hunterUnit925),"B984HunterForm",hunterForm984)
endif
// Permanent children from an earlier form must not survive day/break/level changes.
set hunterScan984='ZN01'
loop
exitwhen hunterScan984>'ZN05'
if hunterScan984!=hunterEffect984 and GetUnitAbilityLevel(hunterUnit925,hunterScan984)>0 then
call UnitRemoveAbility(hunterUnit925,hunterScan984)
endif
set hunterScan984=hunterScan984+1
endloop
if hunterLevel925<=0 or hunterDesired925==5 then
if GetUnitAbilityLevel(hunterUnit925,'A116')>0 then
call UnitRemoveAbility(hunterUnit925,'A116')
endif
if GetUnitAbilityLevel(hunterUnit925,'A117')>0 then
call UnitRemoveAbility(hunterUnit925,'A117')
endif
else
if GetUnitAbilityLevel(hunterUnit925,'A116')==0 then
call XF7(hunterUnit925,'A116')
endif
if GetUnitAbilityLevel(hunterUnit925,'A117')==0 then
call XF7(hunterUnit925,'A117')
endif
endif
endfunction
function SuijiMode_ScepterRegistryTooltipValid takes unit u,integer normalSkill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return OO7(GetHandleId(u),"SuijiScepterTooltipValid"+I2S(normalSkill))
endfunction
function SuijiMode_ScepterRegistryPhysical takes unit u,integer normalSkill returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
return OM7(GetHandleId(u),"SuijiScepterPhysical"+I2S(normalSkill))
endfunction
function SuijiMode_ApplyRegisteredCastRange takes unit u,integer normalSkill,boolean active,real normal1,real normal2,real normal3,real agh1,real agh2,real agh3 returns boolean
local integer physical=0
local ability a=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
set a=EXGetUnitAbility(u,physical)
if a==null then
return false
endif
if active then
call YDWESetUnitAbilityDataReal(u,physical,1,107,agh1)
call YDWESetUnitAbilityDataReal(u,physical,2,107,agh2)
call YDWESetUnitAbilityDataReal(u,physical,3,107,agh3)
else
call YDWESetUnitAbilityDataReal(u,physical,1,107,normal1)
call YDWESetUnitAbilityDataReal(u,physical,2,107,normal2)
call YDWESetUnitAbilityDataReal(u,physical,3,107,normal3)
endif
set a=null
return true
endfunction
function SuijiMode_ApplyRegisteredCastRange4 takes unit u,integer normalSkill,boolean active,real normal1,real normal2,real normal3,real normal4,real agh1,real agh2,real agh3,real agh4 returns boolean
local integer physical=0
local ability a=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
set a=EXGetUnitAbility(u,physical)
if a==null then
return false
endif
if active then
call YDWESetUnitAbilityDataReal(u,physical,1,107,agh1)
call YDWESetUnitAbilityDataReal(u,physical,2,107,agh2)
call YDWESetUnitAbilityDataReal(u,physical,3,107,agh3)
call YDWESetUnitAbilityDataReal(u,physical,4,107,agh4)
else
call YDWESetUnitAbilityDataReal(u,physical,1,107,normal1)
call YDWESetUnitAbilityDataReal(u,physical,2,107,normal2)
call YDWESetUnitAbilityDataReal(u,physical,3,107,normal3)
call YDWESetUnitAbilityDataReal(u,physical,4,107,normal4)
endif
set a=null
return true
endfunction
function SuijiMode_ApplyRegisteredCastpoint takes unit u,integer normalSkill,boolean active,real normalValue,real aghValue returns boolean
local integer physical=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical==0 or GetUnitAbilityLevel(u,physical)<=0 then
return false
endif
if active then
call SuijiMode_SetExactLiveAbilityCastpoint(u,physical,aghValue)
else
call SuijiMode_SetExactLiveAbilityCastpoint(u,physical,normalValue)
endif
if normalSkill=='A0DH' or normalSkill=='A1OB' then
call MHAbility_SetCastpoint(u,physical,0.)
endif
return true
endfunction
function SuijiMode_GetEffectiveCooldownBase takes unit u,integer skill,integer level,real fallback returns real
local integer logicalSkill=LoadInteger(SUIJI_REGISTERED_COOLDOWN_TABLE,skill,StringHash("SuijiCooldownLogical"))
local integer valueKey=level
if logicalSkill==0 then
set logicalSkill=skill
endif
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 or level<1 or LoadBoolean(SUIJI_REGISTERED_COOLDOWN_TABLE,logicalSkill,StringHash("SuijiCooldownRegistered"))==false then
return fallback
endif
if SuijiMode_ScepterRegistryIsActive(u,logicalSkill) then
set valueKey=100+level
endif
if HaveSavedReal(SUIJI_REGISTERED_COOLDOWN_TABLE,logicalSkill,valueKey) then
return LoadReal(SUIJI_REGISTERED_COOLDOWN_TABLE,logicalSkill,valueKey)
endif
return fallback
endfunction
function SuijiMode_ApplyRegisteredCooldown3 takes unit u,integer normalSkill,boolean active,real normal1,real normal2,real normal3,real agh1,real agh2,real agh3 returns boolean
local integer physical=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
call NS7(GetHandleId(u),"SuijiCooldownReady"+I2S(normalSkill),false)
call SaveBoolean(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,StringHash("SuijiCooldownRegistered"),true)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,1,normal1)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,2,normal2)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,3,normal3)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,101,agh1)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,102,agh2)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,103,agh3)
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical!=0 then
call SaveInteger(SUIJI_REGISTERED_COOLDOWN_TABLE,physical,StringHash("SuijiCooldownLogical"),normalSkill)
endif
// Gameplay cooldown selection is registered above on every client.  Exact-live
// failure below may skip only the live object mirror, never the base value.
call NS7(GetHandleId(u),"SuijiCooldownReady"+I2S(normalSkill),true)
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
if active then
call MHAbility_SetCustomLevelDataReal(u,physical,1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh1)
call MHAbility_SetCustomLevelDataReal(u,physical,2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh2)
call MHAbility_SetCustomLevelDataReal(u,physical,3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh3)
else
call MHAbility_SetCustomLevelDataReal(u,physical,1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal1)
call MHAbility_SetCustomLevelDataReal(u,physical,2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal2)
call MHAbility_SetCustomLevelDataReal(u,physical,3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal3)
endif
return true
endfunction
function SuijiMode_ApplyRegisteredCooldown4 takes unit u,integer normalSkill,boolean active,real normal1,real normal2,real normal3,real normal4,real agh1,real agh2,real agh3,real agh4 returns boolean
local integer physical=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
call NS7(GetHandleId(u),"SuijiCooldownReady"+I2S(normalSkill),false)
call SaveBoolean(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,StringHash("SuijiCooldownRegistered"),true)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,1,normal1)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,2,normal2)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,3,normal3)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,4,normal4)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,101,agh1)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,102,agh2)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,103,agh3)
call SaveReal(SUIJI_REGISTERED_COOLDOWN_TABLE,normalSkill,104,agh4)
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical!=0 then
call SaveInteger(SUIJI_REGISTERED_COOLDOWN_TABLE,physical,StringHash("SuijiCooldownLogical"),normalSkill)
endif
// Keep the synchronized registry authoritative even when the optional
// per-instance MemHack mirror is unavailable on one client.
call NS7(GetHandleId(u),"SuijiCooldownReady"+I2S(normalSkill),true)
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
if active then
call MHAbility_SetCustomLevelDataReal(u,physical,1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh1)
call MHAbility_SetCustomLevelDataReal(u,physical,2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh2)
call MHAbility_SetCustomLevelDataReal(u,physical,3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh3)
call MHAbility_SetCustomLevelDataReal(u,physical,4,ABILITY_LEVEL_DEF_DATA_COOLDOWN,agh4)
else
call MHAbility_SetCustomLevelDataReal(u,physical,1,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal1)
call MHAbility_SetCustomLevelDataReal(u,physical,2,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal2)
call MHAbility_SetCustomLevelDataReal(u,physical,3,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal3)
call MHAbility_SetCustomLevelDataReal(u,physical,4,ABILITY_LEVEL_DEF_DATA_COOLDOWN,normal4)
endif
return true
endfunction
