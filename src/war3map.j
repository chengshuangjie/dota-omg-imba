function CJ7 takes nothing returns boolean
local item b1060GetManipulatedItem=GetManipulatedItem()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local integer O5=GetPlayerId(GetOwningPlayer(ZX7))
local integer id=GetUnitTypeId(ZX7)
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or ZX7==null or GetUnitTypeId(ZX7)==0 then
call KillUnit(BB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_PICKUP_ITEM and CHIYY[O5]==0 and (id!='E005' and id!='Z005' and id!='Z105' and id!='Z205') then
if GetItemTypeId(b1060GetManipulatedItem)==ZU[GC] then
call KillUnit(BB7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),CH7_2(ZX7,true),GetUnitX(ZX7),GetUnitY(ZX7),0)
call SaveUnitHandle(L7,(I97),(19),(BB7))
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_DROP_ITEM and CHIYY[O5]==0 and (id!='E005' and id!='Z005' and id!='Z105' and id!='Z205') then
if GetItemTypeId(b1060GetManipulatedItem)==ZU[GC] then
call KillUnit(BB7)
set BB7=CreateUnit(GetOwningPlayer(ZX7),CH7_2(ZX7,false),GetUnitX(ZX7),GetUnitY(ZX7),0)
call SaveUnitHandle(L7,(I97),(19),(BB7))
endif
else
call SetUnitX(BB7,GetUnitX(ZX7))
call SetUnitY(BB7,GetUnitY(ZX7))
endif
set t=null
set ZX7=null
set BB7=null
set b1060ReturnValue=false
set b1060GetManipulatedItem=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
