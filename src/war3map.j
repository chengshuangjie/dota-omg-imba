function HotKey_IsTravelItem takes item it returns boolean
	return it!=null and (GetItemTypeId(it)==ZU[RW] or GetItemTypeId(it)==ZU[it_sg] or GetItemTypeId(it)==ZU[it_sssg] or GetItemTypeId(it)==ZU[it_xjsg])
endfunction
function HotKeyDisplayStr takes integer key returns string
	if key>=65 and key<=90 then
		return SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",key-65,key-64)
	elseif key>=48 and key<=57 then
		return I2S(key-48)
	elseif key>=112 and key<=123 then
		return "F"+I2S(key-111)
	elseif key==32 then
		return "Space"
	elseif key==192 then
		return "~"
	elseif key==9 then
		return "Tab"
	elseif key==20 then
		return "Caps"
	elseif key==17 then
		return "Ctrl"
	endif
	return ""
endfunction
function HotKeyButtonClick takes nothing returns nothing
	local integer frame=DzGetTriggerUIEventFrame()
	local integer i=1
	if frame==0 then
		return
	endif
	call ClearAllEditBoxFocus()
	loop
		exitwhen i>18
		if HotKeyButton[i]==frame then
			set EditingHotKeyIndex=i
			call DzFrameShow(HotKeyButtonHighlight[i],true)
			return
		endif
		set i=i+1
	endloop
endfunction
function Get_Number_Gaijian takes integer i returns integer
	if i==1 then
		return 103
	elseif i==2 then
		return 104
	elseif i==3 then
		return 100
	elseif i==4 then
		return 101
	elseif i==5 then
		return 97
	elseif i==6 then
		return 98
	endif
	return 0
endfunction
function HotKeyQuickCastClick takes nothing returns nothing
	local integer frame=DzGetTriggerUIEventFrame()
	local integer i=1
	call ClearAllEditBoxFocus()
	if not UseChangeHotKeySystem then
		return
	endif
	loop
		exitwhen i>18
		if HotKeyQuickCastCheck[i]==frame then
			set HotKeyQuickCast[i]=1-HotKeyQuickCast[i]
			call DzFrameShow(HotKeyQuickCastHighlight[i],HotKeyQuickCast[i]==1)
			return
		endif
		set i=i+1
	endloop
endfunction
function ClearHotKeyButtonClick takes nothing returns nothing
	local integer i=1
	call ClearAllEditBoxFocus()
	loop
		exitwhen i>18
		set LocalCommandButtonHotKey[i]=0
		set HotKeyQuickCast[i]=0
		call DzFrameSetText(HotKeyButton[i],"-")
		call DzFrameShow(HotKeyQuickCastHighlight[i],false)
		set i=i+1
	endloop
endfunction
function UpdateHotKeyState takes nothing returns nothing
	local integer i=1
	loop
		exitwhen i>18
		call DzFrameSetEnable(HotKeyButton[i],UseChangeHotKeySystem)
		call DzFrameSetEnable(HotKeyQuickCastCheck[i],UseChangeHotKeySystem)
		if HotKeyQuickCastText[i]!=0 then
			if UseChangeHotKeySystem then
				call DzFrameSetTextColor(HotKeyQuickCastText[i],0xFFFCD312)
			else
				call DzFrameSetTextColor(HotKeyQuickCastText[i],0xFF737373)
			endif
		endif
		set i=i+1
	endloop
	set i=21
	loop
		exitwhen i>23
		if UIFrame__CheckBoxText[i]!=0 then
			if UseChangeHotKeySystem then
				call DzFrameSetTextColor(UIFrame__CheckBoxText[i],0xFFFCD312)
			else
				call DzFrameSetTextColor(UIFrame__CheckBoxText[i],0xFF737373)
			endif
		endif
		set i=i+1
	endloop
endfunction
function SeEditBoxKeyEvent takes nothing returns boolean
	local integer key=MHEvent_GetKey()
	local integer id=EditingHotKeyIndex
	local string s
	local integer i
	local unit selected
	local unit cursorUnit
	local integer hotkey=0
	local integer skill=-1
	local integer castType
	local integer castTypeLast
	local integer flag
	local integer orderId=0
	local item it
if B922WheelOpen or MHUI_IsChatEditBarOn() or key<=0 then
		return false
	endif
	if (key==81 and MHMsg_IsKeyDown(OSKEY_ALT)) or (key==115 and MHMsg_IsKeyDown(OSKEY_ALT)) then
		set bMenuMainPanelIsEnable=true
	endif
	if MHMsg_IsKeyDown(OSKEY_ALT) then
		return false
	endif
	if id>0 then
		if key==46 or key==8 or key==27 then
			call DzFrameSetText(HotKeyButton[id],"-")
			call DzFrameShow(HotKeyButtonHighlight[id],false)
			set LocalCommandButtonHotKey[id]=0
			set EditingHotKeyIndex=0
			if key==27 then
				call MHEvent_SetKey(-1)
			endif
			return false
		endif
		if key==79 or key==82 then
			call MHEvent_SetKey(-1)
		endif
		set s=HotKeyDisplayStr(key)
		if s=="" then
			return false
		endif
		set i=1
		loop
			exitwhen i>18
			if i!=id and LocalCommandButtonHotKey[i]==key then
				call DzFrameSetText(HotKeyButton[i],"-")
				set LocalCommandButtonHotKey[i]=0
			endif
			set i=i+1
		endloop
		call DzFrameSetText(HotKeyButton[id],s)
		call DzFrameShow(HotKeyButtonHighlight[id],false)
		set LocalCommandButtonHotKey[id]=key
		set EditingHotKeyIndex=0
		return false
	endif
	if key==27 then
		if TpSlotLocalTargeting then
			call TpSlot_SetTargetingLocal(false)
			call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,2.,"|cFFFFCC00已取消独立TP选点。|r")
		elseif IsSetUpUIEnable then
			call ClickMapSetUpReturnButton()
		elseif bMenuMainPanelIsEnable then
			set bMenuMainPanelIsEnable=false
		elseif UpdateLogIsShow then
			call DzClickFrame(UIButton__UpdateLogOK)
		endif
		return false
	elseif key==121 then
		set bMenuMainPanelIsEnable=true
	endif
	if not UseChangeHotKeySystem then
		if key==OSKEY_H then
			call OmgHoldPositionHotkey_OnKeyDown()
		elseif key==80 then
			call TpSlot_OnHotkeyP()
		elseif key==20 and IsCapsLockEnableMultiboard and IsMultiboardMinimized(T4) then
			call MultiboardMinimize(T4,false)
		endif
		return false
	endif
	if bMenuMainPanelIsEnable then
		return false
	endif
	set selected=MHPlayer_GetSelectUnit()
	if selected==null or (ItemChangeHotkeyHeroOnly and SkillChangeHotkeyHeroOnly and not IsUnitType(selected,UNIT_TYPE_HERO)) then
		set selected=null
		return false
	endif
	set i=1
	loop
		exitwhen i>18 or hotkey>0
		if key==LocalCommandButtonHotKey[i] then
			// Scope checks precede button inspection and key suppression.
			if (i<=6 and ItemChangeHotkeyHeroOnly and not IsUnitType(selected,UNIT_TYPE_HERO)) or (i>6 and SkillChangeHotkeyHeroOnly and not IsUnitType(selected,UNIT_TYPE_HERO)) or (i<=6 and UnitInventorySize(selected)==0) then
				set selected=null
				return false
			endif
			if i<=6 then
				set hotkey=i
			else
				set skill=MHUIData_GetCommandButtonAbility(MHUI_GetSkillBarButton(i-6))
				if skill=='Asud' or skill=='Asel' then
					set selected=null
					return false
				endif
				set hotkey=i
			endif
			if (key>=112 and key<=123) or (key>=48 and key<=57) or key==9 or (BanOldHotkey and (key==32 or (key>=65 and key<=90))) then
				call MHEvent_SetKey(-1)
			endif
		endif
		set i=i+1
	endloop
	if hotkey==0 then
		if key==OSKEY_H then
			call OmgHoldPositionHotkey_OnKeyDown()
		elseif key==80 then
			call TpSlot_OnHotkeyP()
		elseif key==20 and IsCapsLockEnableMultiboard and IsMultiboardMinimized(T4) then
			call MultiboardMinimize(T4,false)
		endif
		set selected=null
		return false
	endif
	if hotkey<=6 and UnitInventorySize(selected)==0 then
		set selected=null
		return false
	endif
	if IsUnitType(selected,UNIT_TYPE_HERO) and GetHeroSkillPoints(selected)>0 and (skill==0 or skill=='AHer') and (hotkey==11 or hotkey>=15) then
		set i=1
		loop
			exitwhen i>5 or orderId>0
			set skill=MHUIData_GetCommandButtonAbility(MHUI_GetSkillBarButton(i))
			if skill=='AHer' then
				if hotkey==11 then
					set orderId=5
				else
					set orderId=hotkey-14
				endif
			endif
			set i=i+1
		endloop
		if orderId>0 then
			call MHFrame_Click(MHUI_GetSkillBarButton(orderId))
			set selected=null
			return false
		endif
	endif
	if hotkey<=6 then
		set it=UnitItemInSlot(selected,hotkey-1)
		if it==null then
			set selected=null
			return false
		endif
		set skill=MHItem_GetAbilityId(it,1)
	endif
	if skill<=0 then
		set selected=null
		set it=null
		return false
	endif
	set castType=MHAbility_GetCastType(selected,skill)
	set castTypeLast=S2I(SubString(MHMath_ToHex(castType),StringLength(MHMath_ToHex(castType))-1,StringLength(MHMath_ToHex(castType))))
	if castTypeLast==0 and skill!='AHer' then
		set selected=null
		set it=null
		return false
	endif
	if castTypeLast==1 or HotKeyQuickCast[hotkey]==0 or skill=='AHer' then
		if hotkey<=6 then
			call MHMsg_PressKey(Get_Number_Gaijian(hotkey))
		else
			call MHFrame_Click(MHUI_GetSkillBarButton(hotkey-6))
		endif
	else
		set cursorUnit=MHMsg_GetCursorUnit()
		if hotkey<=6 then
			set orderId=852007+hotkey
			if HotKey_IsTravelItem(it) then
				set flag=6
			else
				set flag=4
			endif
			if MHMsg_IsKeyDown(OSKEY_SHIFT) then
				set flag=flag+1
			endif
			if cursorUnit!=null then
				call MHMsg_SendTargetOrder(cursorUnit,GetUnitX(cursorUnit),GetUnitY(cursorUnit),orderId,it,castType,flag)
			else
				call MHMsg_SendTargetOrder(null,MHMsg_GetMouseX(),MHMsg_GetMouseY(),orderId,it,castType,flag)
			endif
		else
			if key==MHAbility_GetDefDataInt(skill,ABILITY_DEF_DATA_HOTKEY) then
				call MHEvent_SetKey(-1)
			endif
			set orderId=MHAbility_GetOrder(selected,skill,1)
			set flag=4
			if MHMsg_IsKeyDown(OSKEY_SHIFT) then
				set flag=flag+1
			endif
			if cursorUnit!=null then
				call MHMsg_SendTargetOrder(cursorUnit,GetUnitX(cursorUnit),GetUnitY(cursorUnit),orderId,null,castType,flag)
			else
				call MHMsg_SendTargetOrder(null,MHMsg_GetMouseX(),MHMsg_GetMouseY(),orderId,null,castType,flag)
			endif
		endif
	endif
	set selected=null
	set cursorUnit=null
	set it=null
	return false
endfunction
function TpSlot_InitFrames takes nothing returns nothing
local player p=GetLocalPlayer()
if TpSlotButton!=0 then
set p=null
return
endif
set TpSlotIcon=DzCreateFrameByTagName("BACKDROP",null,GameUI,"template",300)
call DzFrameSetSize(TpSlotIcon,0.022,0.022)
call DzFrameClearAllPoints(TpSlotIcon)
call DzFrameSetAbsolutePoint(TpSlotIcon,4,0.571,0.190)
call DzFrameSetPriority(TpSlotIcon,94)
set TpSlotButton=DzCreateFrameByTagName("TEXTBUTTON","TpSlotButton",GameUI,"Glyph_Button",300)
call DzFrameSetSize(TpSlotButton,0.026,0.026)
call DzFrameClearAllPoints(TpSlotButton)
call DzFrameSetAbsolutePoint(TpSlotButton,4,0.571,0.190)
call DzFrameSetPriority(TpSlotButton,95)
call DzFrameSetAlpha(TpSlotButton,0)
call DzFrameSetScriptByCode(TpSlotButton,1,function TpSlot_OnFrameClick,false)
