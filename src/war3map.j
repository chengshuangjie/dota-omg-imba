call DzFrameSetPriority(TpSlotTargetText,96)
call DzFrameSetEnable(TpSlotTargetText,false)
call DzFrameSetText(TpSlotTargetText,"|cFFFFFFFFP|r")
set TpSlotCursorFrame=DzCreateFrameByTagName("BACKDROP",null,GameUI,"template",302)
call DzFrameSetSize(TpSlotCursorFrame,0.018,0.018)
call DzFrameSetTexture(TpSlotCursorFrame,"ReplaceableTextures\\CommandButtons\\BTNScrollUber.blp",0)
call DzFrameSetPriority(TpSlotCursorFrame,200)
call DzFrameSetAlpha(TpSlotCursorFrame,210)
