function JB2 takes nothing returns nothing
local integer i=0
loop
exitwhen i>UA0
call RemoveUnit(UB0[i])
set i=i+1
endloop
endfunction
function LO2 takes real x,real y returns nothing
set UB0[UA0]=CreateUnit(Player(0),'h06I',x,y,0)
set UA0=UA0+1
endfunction
function JD2 takes string S,real XN2,real XS2,real XT2,real XR2,real XP2,boolean XQ2 returns nothing
set AB4=CreateImage(S,XN2,XS2,0,XT2-(XN2/2),XR2-(XS2/2),XP2,0,0,0,2)
call SetImageRenderAlways(AB4,true)
call ShowImage(AB4,XQ2)
endfunction
function JE2 takes integer JF2,integer r,integer g,integer b,integer a,real x,real y,integer OB7 returns nothing
if StringLength(I2S(JF2))>1 then
call JD2("Fonts\\"+SubString(I2S(JF2),0,1)+".blp",90,90,x-20,y,0,true)
call SetImageColor(AB4,r,g,b,a)
call SaveImageHandle(L7,(OB7),(158),(AB4))
call JD2("Fonts\\"+SubString(I2S(JF2),1,2)+".blp",90,90,x+20,y,0,true)
call SetImageColor(AB4,r,g,b,a)
call SaveImageHandle(L7,(OB7),(159),(AB4))
else
call JD2("Fonts\\0.blp",90,90,x-20,y,0,true)
call SetImageColor(AB4,r,g,b,a)
call SaveImageHandle(L7,(OB7),(158),(AB4))
call JD2("Fonts\\"+SubString(I2S(JF2),0,1)+".blp",90,90,x+20,y,0,true)
call SetImageColor(AB4,r,g,b,a)
call SaveImageHandle(L7,(OB7),(159),(AB4))
endif
endfunction
function JG2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer DC1=(LoadInteger(L7,(OB7),(57)))
local real x=(LoadReal(L7,(OB7),(6)))
local real y=(LoadReal(L7,(OB7),(7)))
local integer NPI=GetTriggerEvalCount(t)
local integer JH2=DC1-NPI
local image JZ2=(LoadImageHandle(L7,(OB7),(158)))
local image JV2=(LoadImageHandle(L7,(OB7),(159)))
local integer r
local integer g
local integer b
local integer a
if NPI>0 then
call ShowImage(JZ2,false)
call DestroyImage(JZ2)
call ShowImage(JV2,false)
call DestroyImage(JV2)
endif
if NPI==DC1 then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
else
if JH2<6 then
set r=255
set g=0
set b=0
elseif GetLocalPlayer()==QM0 or GetLocalPlayer()==QN0 then
set r=KA4[GetPlayerId(GetLocalPlayer())]
set g=KB4[GetPlayerId(GetLocalPlayer())]
set b=KC4[GetPlayerId(GetLocalPlayer())]
else
set r=255
set g=255
set b=255
endif
if IsPlayerAlly(QM0,GetLocalPlayer())then
set a=255
else
set a=125
endif
call JE2(JH2,r,g,b,a,x,y,OB7)
endif
set t=null
set JZ2=null
set JV2=null
return false
endfunction
function JW2 takes integer DC1,real x,real y returns nothing  //显示的倒计时图案
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function JG2))
call SaveInteger(L7,(OB7),(57),(DC1))
call SaveReal(L7,(OB7),(6),((x)*1.0))
call SaveReal(L7,(OB7),(7),((y)*1.0))
call TriggerEvaluate(t)
set t=null
endfunction
