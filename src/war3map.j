call GroupRemoveUnit(LQ7,m5)
call GroupAddUnit(O5E,m5)
call NB7(OB7,"Group",O5E)
set B661_VISAGE_LONG_GROUP_ACTIVE=B661_VISAGE_LONG_GROUP_ACTIVE+1
