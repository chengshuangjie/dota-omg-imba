function CAG takes nothing returns boolean
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local integer TE9=(LoadInteger(L7,(I97),(30)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer WF8=(LoadInteger(L7,(GetHandleId(ZX7)),(737)))
local trigger CBG=(LoadTriggerHandle(L7,(GetHandleId(ZX7)),(738)))
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(ZX7) or not B1023HitLive(IH7)) then
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set CBG=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==ZX7 then
call DisableTrigger(t)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set WF8=WF8-1
if WF8==0 then
call FlushChildHashtable(L7,(GetHandleId(CBG)))
call OZ7(CBG)
call RemoveSavedHandle(L7,(GetHandleId(ZX7)),(738))
call SaveInteger(L7,(GetHandleId(ZX7)),(737),(-1))
call UnitRemoveAbility(ZX7,'A2FN')
call UnitRemoveAbility(ZX7,'B0FA')
else
call SaveInteger(L7,(GetHandleId(ZX7)),(737),(WF8))
endif
endif
else
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set IH7=null
set ZX7=null
set CBG=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function CCG takes nothing returns boolean
local unit b1060GetAttacker=B1060EventAttacker()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ATTACKED and (not B1023HitLive(b1060GetAttacker) or not B1023HitLive(b1060GetTriggerUnit)) then
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if GetTriggerEventId()!=EVENT_PLAYER_UNIT_ATTACKED then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call RemoveSavedHandle(L7,(GetHandleId(ZX7)),(738))
call SaveInteger(L7,(GetHandleId(ZX7)),(737),(-1))
call UnitRemoveAbility(ZX7,'A2FN')
call UnitRemoveAbility(ZX7,'B0FA')
elseif b1060GetAttacker==ZX7 then
set t=CreateTrigger()
set I97=GetHandleId(t)
call B1023RegisterDamage(t,b1060GetTriggerUnit)
call TriggerRegisterTimerEvent(t,2,false)
call TriggerAddCondition(t,Condition(function CAG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(b1060GetTriggerUnit))
endif
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function C3G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A2FN',false)
call XF7(IH7,'A2FN')
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterTimerEvent(t,$C,false)
call TriggerAddCondition(t,Condition(function CCG))
call SaveUnitHandle(L7,(I97),(2),(IH7))
call SaveInteger(L7,GetHandleId(IH7),737,GetUnitAbilityLevel(ZX7,'A2FQ')+1)
call SaveTriggerHandle(L7,(GetHandleId(IH7)),(738),(t))
set IH7=null
set t=null
set ZX7=null
endfunction
function C6G takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2FQ' then
call C3G()
endif
return false
endfunction
function Register_Focus takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function C6G))
set t=null
endfunction
function CLG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local unit BB7
if GetTriggerEvalCount(t)==1 then
set BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitAddAbility(BB7,'A2FW')
call B947IssueTargetOrderById("CLG @ war3map.j:213539 (B968)",BB7,$D0267,IH7)
endif
if(BC7+3)*$A<GetTriggerEvalCount(t)then
call UnitRemoveAbility(IH7,'B0FF')
call UnitRemoveAbility(IH7,'Avul')
call UnitRemoveAbility(IH7,'A04R')
call UnitRemoveAbility(IH7,'Abun')
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
call YZ8(IH7)
call YW8(IH7,0,0)
endif
set t=null
set IH7=null
set BB7=null
return false
endfunction
function C1G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call XF7(IH7,'Avul')
call XF7(IH7,'Abun')
call XF7(IH7,'A04R')
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function CLG))
call SaveInteger(L7,I97,5,GetUnitAbilityLevel(ZX7,'A2FL'))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl",IH7,"origin")))
call YZ8(IH7)
call YW8(IH7,0,0)
set t=null
set IH7=null
set ZX7=null
endfunction
function C0G takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2FL' then
call C1G()
endif
return false
endfunction
function Register_DivineIntervention takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function C0G))
set t=null
endfunction
function C5G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer BC7=GetUnitAbilityLevel(ZX7,'A2EO')
call UnitAddAbility(BB7,'A2EP')
call B947IssuePointOrderById("C5G @ war3map.j:213595 (B968)",BB7,$D0270,GetUnitX(IH7),GetUnitY(IH7))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\FrozenOrb_NoTrail.mdx",IH7,"chest"))
call B67(ZX7,IH7,1,BC7*75)
set ZX7=null
set BB7=null
set IH7=null
endfunction
function C2G takes nothing returns boolean
if B287_GetSpellAbilityId()=='A2EO' then
call C5G()
endif
return false
endfunction
function Register_Chill takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function C2G))
set t=null
endfunction
function InitCustomTeams takes nothing returns nothing
call SetPlayerTeam(Player(1),0)
call SetPlayerTeam(Player(2),0)
call SetPlayerTeam(Player(3),0)
call SetPlayerTeam(Player(4),0)
call SetPlayerTeam(Player(5),0)
call SetPlayerTeam(Player(7),1)
call SetPlayerTeam(Player(8),1)
call SetPlayerTeam(Player(9),1)
call SetPlayerTeam(Player($A),1)
call SetPlayerTeam(Player($B),1)
endfunction
function C_G takes string L4G,string L7G,integer L8G returns integer
local integer i=L8G
local string L9G=null
loop
exitwhen i==StringLength(L4G)
set L9G=SubString(L4G,i,i+1)
if(L9G==L7G)then
return i
endif
set i=i+1
endloop
return-1
endfunction
function LDG takes nothing returns nothing
local string LEG=GetEventPlayerChatString()
local integer LFG=C_G(LEG," ",0)
local integer LGG=C_G(LEG," ",LFG+1)
local integer LHG=S2I(SubString(LEG,LFG,LGG+1))
local string LIG=SubString(LEG,LGG+1,StringLength(LEG))
local boolean LJG=false
local integer i=0
set LIG="+"+LIG
if LHG<$C then
loop
exitwhen i==$E
if(LIG==GetPlayerName(Player(i)))then
set LJG=true
endif
set i=i+1
endloop
if((not LJG)and(UH4>0)and(GetPlayerController(Player(LHG))==MAP_CONTROL_COMPUTER)and(LHG!=0)and(LHG!=6)and(LHG<$C)and(StringLength(LIG)<20))then
call IL7("Renaming "+GetPlayerName(Player(LHG))+" : "+LIG)
set KZ4[LHG]=LIG
call SetPlayerName(Player(LHG),LIG)
set UH4=UH4-1
endif
endif
endfunction
function LKG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i==$E
call TriggerRegisterPlayerChatEvent(t,Player(i),"-rn ",false)
set i=i+1
endloop
call TriggerAddAction(t,function LDG)
set t=null
endfunction
function LMG takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local real dt=TimerGetElapsed(W)
local real X
local real Y
local real dx
local real dy
local group g=WS7()
local unit WX7=GetOrderedUnit()
local unit IH7
local integer i=1
local integer BC7
call IL7("LMG")
call SyncSelections()
call GroupEnumUnitsSelected(g,b1060GetTriggerPlayer,null)
set IH7=FirstOfGroup(g)
call WR7(g)
set g=null
set dx=GetUnitX(IH7)
set dy=GetUnitY(IH7)
call J_7(.1)
set dt=TimerGetElapsed(W)-dt
set X=GetUnitX(IH7)
set Y=GetUnitY(IH7)
set dx=(X-dx)/dt
set dy=(Y-dy)/dt
loop
set WX7=M7[i]
set BC7=B287_GetUnitAbilityLevel(WX7,'A06I')
if BC7==0 then
set BC7=B287_GetUnitAbilityLevel(WX7,'A2S1')
endif
if BC7>0 then
set dt=WT7(40./.03,X+dx*.3-GetUnitX(WX7),Y+dy*.3-GetUnitY(WX7),dx,dy)
if dt>0 and dt<=((400.+200.*BC7)*.03/40.)then
call B947IssuePointOrderById("LMG @ war3map.j:213709 (B968)",WX7,$D0278,X+dx*(dt+.3),Y+dy*(dt+.3))
endif
endif
set i=i+1
exitwhen i>$A
endloop
set IH7=null
set WX7=null
set b1060GetTriggerPlayer=null
endfunction
function JADDHERO2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer O5=OM7(OB7,"O5")
local integer floor=OM7(OB7,"floor")
local integer id=OM7(OB7,"id")
local player p=Player(O5)
local unit u=null
local integer WF8=GetTriggerEvalCount(t)
if WF8==1 then
    if id==4 and ZCSR==false then
        call NS7(OB7,"ISSR",true)
    endif
    if TW7(p)then
        set u=CreateUnit(p,K34[id],6261.,6048.,0)
    else
        set u=CreateUnit(p,K34[id],-6974.,-6747.,0)
    endif
    if OO7(OB7,"ISSR")==false then
        set M7[O5]=u
        call NT7(OB7,"hero",u)
        call SetUnitInvulnerable(u,true)
    endif
    call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|cFF00FF00玩家"+I2S(floor)+"增加英雄:"+GetObjectName(K34[id])+"|r")
elseif WF8==2 then
    if OO7(OB7,"ISSR") then
        set u=M7[O5]
        call NT7(OB7,"hero",u)
    endif
elseif WF8==3 then
    set u=O77(OB7,"hero")
    call SetHeroLevel(u,25,true)
    call AI_LEARN_EX_SKILL(u)
    call AICZB(O5,u,p)
    call AIXLHZB(O5,GetUnitTypeId(u),u,p)
    call AIHSJ(O5,GetUnitTypeId(u),u,p)    
    set AISZ[O5]=1
    set AISJ[O5]=1
    call TriggerExecute(QZ4)
    set SUIJI_EVENT_UNIT=u
    call ExecuteFunc("SuijiMode_OnHeroAddCurrent")
elseif WF8==4 then
    set u=O77(OB7,"hero")
    call SetUnitInvulnerable(u,false)
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
set u=null
set p=null
return false
endfunction
function JADDHERO takes nothing returns nothing
local player p=GetTriggerPlayer()
local player j8
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer floor=S2I(SubString(VH,8,10))
local integer id=S2I(SubString(VH,MHString_Find(VH , " " , 0),StringLength(VH)))
local integer O5
local trigger t
local integer OB7
if GetPlayerId(p)!=1 and GetPlayerId(p)!=7 then
call DisplayTextToPlayer(p,0,0, "只有玩家1或玩家6可以使用此命令")
set p=null
return
elseif floor<1 or floor>10 then
call DisplayTextToPlayer(p,0,0, "错误！楼层范围为1~10")
call DisplayTextToPlayer(p,0,0, "指令用法：-addhero楼层+空格+英雄编号，例如 -heroto6 66")
set p=null
return
elseif id<1 or id>115 then
call DisplayTextToPlayer(p,0,0, "错误！英雄编号为1~115")
call DisplayTextToPlayer(p,0,0, "指令用法：-addhero楼层+空格+英雄编号，例如 -heroto6 66")
set p=null
return
endif
if XM_MODE==false then
call DisplayTextToPlayer(p,0,0, "只有XM模式才能使用此命令")
set p=null
return
endif
set O5=floor
if O5>=6 then
set O5=O5+1
endif
set j8=Player(O5)
if GetPlayerSlotState(j8)!=PLAYER_SLOT_STATE_PLAYING then
call DisplayTextToPlayer(p,0,0, I2S(floor)+"楼玩家不存在")
set p=null
set j8=null
return
endif
if GetPlayerController(j8)!=MAP_CONTROL_COMPUTER then
call DisplayTextToPlayer(p,0,0, "只能给AI添加英雄")
set p=null
set j8=null
return
endif
if GetUnitLevel(M7[O5])!=25 then
call DisplayTextToPlayer(p,0,0, "AI现有英雄达到25级后才可以使用")
set p=null
set j8=null
return
endif
if AISJ[O5]==0 and UnitAlive(M7[O5]) then
call AIHSJ(O5,GetUnitTypeId(M7[O5]),M7[O5],Player(O5))
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NP7(OB7,"O5",O5)
call NP7(OB7,"floor",floor)
call NP7(OB7,"id",id)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddCondition(t,Condition(function JADDHERO2))
set p=null
set j8=null
set t=null
endfunction
function JHEROTO takes nothing returns nothing
local player p=GetTriggerPlayer()
local player j8
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer floor=S2I(SubString(VH,7,9))
local integer id=S2I(SubString(VH,MHString_Find(VH , " " , 0),StringLength(VH)))
local integer i
if SPEPLAYER[GetPlayerId(p)]!=1 and ISTEST==false then
call DisplayTextToPlayer(p,0,0, "只有在测试模式下可以使用此命令")
set p=null
return   
elseif GetPlayerId(p)!=1 and GetPlayerId(p)!=7 then
call DisplayTextToPlayer(p,0,0, "只有玩家1或玩家6可以使用此命令")
set p=null
return
elseif floor<1 or floor>10 then
call DisplayTextToPlayer(p,0,0, "错误！楼层范围为1~10")
call DisplayTextToPlayer(p,0,0, "指令用法：-heroto楼层+空格+英雄编号，例如 -heroto5 66")
set p=null
return
elseif id<1 or id>115 then
call DisplayTextToPlayer(p,0,0, "错误！英雄编号为1~115")
call DisplayTextToPlayer(p,0,0, "指令用法：-heroto楼层+空格+英雄编号，例如 -heroto5 66")
set p=null
return
endif
set i=floor
if i>=6 then
set i=i+1
endif
set j8=Player(i)
if GetPlayerSlotState(j8)!=PLAYER_SLOT_STATE_PLAYING then
call DisplayTextToPlayer(p,0,0, I2S(floor)+"楼玩家不存在")
set p=null
set j8=null
return
endif
if TW7(j8)then
call CreateUnit(j8,K34[id],6261.,6048.,0)
else
call CreateUnit(j8,K34[id],-6974.,-6747.,0)
endif
set AISZ[i]=0
set AIXLSZ[i]=0
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|cFF00FF00玩家"+I2S(floor)+"增加英雄:"+GetObjectName(K34[id])+"|r")
set p=null
set j8=null
endfunction
