function WYF takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=O77(I97,"Hero")
local integer WF8=OM7(I97,"Count")
local integer id=GetUnitTypeId(WX7)
local unit BSTX=null
set WF8=WF8+1
call NP7(I97,"Count",WF8)
if WF8>1 or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call UnitRemoveAbility(WX7,'A0WO')
call UnitRemoveAbility(WX7,'A2SX')
call UnitRemoveAbility(WX7,'B009')
call UnitRemoveAbility(WX7,'B0DP')
call NM7(I97)
call OZ7(t)
else
// B567: the native transform remains engine-owned, but the original hidden
// Command Aura books pulse their percentage bonus off for one frame roughly
// every two seconds.  Remove any stale books and let the bounded script state
// below own only the attack-bonus layer.
call UnitRemoveAbility(WX7,'A0WO')
call UnitRemoveAbility(WX7,'A2SX')
if id=='Z001' or id=='Z0CQ' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Sven_N7S_R_Caster_Point.mdl",WX7,"origin"))
set BSTX=CreateUnit(GetOwningPlayer(WX7),'h0GM',GetUnitX(WX7),GetUnitY(WX7),GetUnitFacing(WX7))
call KillUnit(BSTX)
else
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BattleCryCaster.mdx",WX7,"overhead"))
endif
endif
set BSTX=null
set WX7=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SuijiMode_GodStrengthHasScepter takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
// 16 OMG exposes one logical Scepter state to script-owned skills.  A0TK is
// the common held-item ability shared by all 119 Scepter variants in this map;
// the registry and permanent-blessing detector remain authoritative fallbacks.
return GetUnitAbilityLevel(u,'A0TK')>0 or SuijiMode_DetectAghanimSourceState(u) or SuijiMode_ScepterRegistryIsActive(u,'A1WH') or SuijiMode_ScepterRegistryIsActive(u,'X1WH')
endfunction
function SuijiMode_GodStrengthRemoveContribution takes unit target,integer sourceKey returns nothing
local integer targetHandle=0
local real applied=0.
if target==null then
return
endif
set targetHandle=GetHandleId(target)
set applied=LoadReal(L7,targetHandle,sourceKey)
if GetUnitTypeId(target)!=0 and applied!=0. then
call SetUnitState(target,UNIT_STATE_ATTACK1_DAMAGE_BONUS,GetUnitState(target,UNIT_STATE_ATTACK1_DAMAGE_BONUS)-applied)
endif
call RemoveSavedReal(L7,targetHandle,sourceKey)
endfunction
function SuijiMode_GodStrengthApplyContribution takes unit target,integer sourceKey,real rate returns nothing
local integer targetHandle=0
local real applied=0.
local real next=0.
if target==null or GetUnitTypeId(target)==0 then
return
endif
set targetHandle=GetHandleId(target)
set applied=LoadReal(L7,targetHandle,sourceKey)
set next=GetUnitState(target,UNIT_STATE_ATTACK1_DAMAGE_BASE)*rate
call SetUnitState(target,UNIT_STATE_ATTACK1_DAMAGE_BONUS,GetUnitState(target,UNIT_STATE_ATTACK1_DAMAGE_BONUS)-applied+next)
call SaveReal(L7,targetHandle,sourceKey,next)
endfunction
function SuijiMode_GodStrengthDestroyRandomState takes timer t returns nothing
local integer timerHandle=0
local integer unitHandle=0
local unit u=null
local unit member=null
local group active=null
local group scan=null
local effect fx=null
if t==null then
return
endif
set timerHandle=GetHandleId(t)
set unitHandle=LoadInteger(L7,timerHandle,1)
set u=LoadUnitHandle(L7,timerHandle,0)
set active=LoadGroupHandle(L7,timerHandle,4)
set scan=LoadGroupHandle(L7,timerHandle,5)
if active!=null then
loop
set member=FirstOfGroup(active)
exitwhen member==null
call GroupRemoveUnit(active,member)
call SuijiMode_GodStrengthRemoveContribution(member,timerHandle)
endloop
call DestroyGroup(active)
endif
if scan!=null then
call DestroyGroup(scan)
endif
if u!=null and GetUnitTypeId(u)!=0 then
if LoadTimerHandle(L7,unitHandle,StringHash("GodStrengthRandomTimer"))==t then
call RemoveSavedHandle(L7,unitHandle,StringHash("GodStrengthRandomTimer"))
endif
if LoadBoolean(L7,timerHandle,10) then
call SuijiMode_EndVisualForm(u,7)
endif
endif
set fx=LoadEffectHandle(L7,timerHandle,2)
if fx!=null then
call DestroyEffect(fx)
endif
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set fx=null
set scan=null
set active=null
set member=null
set u=null
endfunction
function SuijiMode_GodStrengthStopRandomState takes unit u returns nothing
local timer t=null
if u==null then
return
endif
set t=LoadTimerHandle(L7,GetHandleId(u),StringHash("GodStrengthRandomTimer"))
if t!=null then
call SuijiMode_GodStrengthDestroyRandomState(t)
endif
set t=null
endfunction
function SuijiMode_GodStrengthRandomStateTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local integer unitHandle=LoadInteger(L7,timerHandle,1)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local unit member=null
local group active=LoadGroupHandle(L7,timerHandle,4)
local group scan=LoadGroupHandle(L7,timerHandle,5)
local real selfRate=LoadReal(L7,timerHandle,6)
local real allyRate=LoadReal(L7,timerHandle,7)
local boolean HaveA=false
if u==null or GetUnitTypeId(u)==0 or LoadTimerHandle(L7,unitHandle,StringHash("GodStrengthRandomTimer"))!=t or UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,3) then
call SuijiMode_GodStrengthDestroyRandomState(t)
set scan=null
set active=null
set u=null
set t=null
return
endif
set HaveA=SuijiMode_GodStrengthHasScepter(u)
// Reconcile contributions in place.  Never remove the whole active group and
// re-add it in the same tick: that creates the visible attack-number pulse.
call GroupClear(scan)
loop
set member=FirstOfGroup(active)
exitwhen member==null
call GroupRemoveUnit(active,member)
call GroupAddUnit(scan,member)
endloop
loop
set member=FirstOfGroup(scan)
exitwhen member==null
call GroupRemoveUnit(scan,member)
if member==u then
call SuijiMode_GodStrengthApplyContribution(member,timerHandle,selfRate)
call GroupAddUnit(active,member)
elseif HaveA and GetUnitTypeId(member)!=0 and UnitAlive(member) and IsUnitType(member,UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(member,GetOwningPlayer(u)) and IsUnitInRange(member,u,900.) then
call SuijiMode_GodStrengthApplyContribution(member,timerHandle,allyRate)
call GroupAddUnit(active,member)
else
call SuijiMode_GodStrengthRemoveContribution(member,timerHandle)
endif
endloop
if HaveA then
call GroupEnumUnitsInRange(scan,GetUnitX(u),GetUnitY(u),900.,null)
loop
set member=FirstOfGroup(scan)
exitwhen member==null
call GroupRemoveUnit(scan,member)
if member!=u and UnitAlive(member) and IsUnitType(member,UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(member,GetOwningPlayer(u)) then
call SuijiMode_GodStrengthApplyContribution(member,timerHandle,allyRate)
call GroupAddUnit(active,member)
endif
endloop
endif
set scan=null
set active=null
set member=null
set u=null
set t=null
endfunction
function SuijiMode_StartGodStrengthState takes unit u,integer level,real duration,boolean randomModel returns nothing
local integer unitHandle=0
local integer timerHandle=0
local real selfRate=0.
local real allyRate=0.
local boolean HaveA=false
local timer t=null
local group active=null
local group scan=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
if level<1 then
return
elseif level>3 then
set level=3
endif
set HaveA=SuijiMode_GodStrengthHasScepter(u)
set selfRate=.5+.5*level
set allyRate=.5+.25*level
call SuijiMode_GodStrengthStopRandomState(u)
set t=CreateTimer()
set active=CreateGroup()
set scan=CreateGroup()
set unitHandle=GetHandleId(u)
set timerHandle=GetHandleId(t)
call SaveTimerHandle(L7,unitHandle,StringHash("GodStrengthRandomTimer"),t)
call SaveUnitHandle(L7,timerHandle,0,u)
call SaveInteger(L7,timerHandle,1,unitHandle)
call SaveEffectHandle(L7,timerHandle,2,AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl",u,"origin"))
call SaveReal(L7,timerHandle,3,TimerGetElapsed(W)+duration)
call SaveGroupHandle(L7,timerHandle,4,active)
call SaveGroupHandle(L7,timerHandle,5,scan)
call SaveReal(L7,timerHandle,6,selfRate)
call SaveReal(L7,timerHandle,7,allyRate)
call SaveStr(L7,timerHandle,8,"")
call SaveBoolean(L7,timerHandle,9,HaveA)
call SaveBoolean(L7,timerHandle,10,randomModel)
call SuijiMode_GodStrengthApplyContribution(u,timerHandle,selfRate)
call GroupAddUnit(active,u)
if randomModel then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Metamorphosis\\Metamorphosis.mdl",u,"origin"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BattleCryCaster.mdx",u,"overhead"))
call SuijiMode_SetVisualForm(u,7,"units\\demon\\Felgaurd\\Felgaurd.mdl")
endif
call TimerStart(t,.10,true,function SuijiMode_GodStrengthRandomStateTick)
set scan=null
set active=null
set t=null
endfunction
function SuijiMode_StartRandomGodStrength takes unit u returns nothing
local integer level=0
local real duration=25.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set level=B287_GetUnitAbilityLevel(u,'A1WH')
if SuijiMode_GodStrengthHasScepter(u) then
set duration=35.
endif
call SuijiMode_StartGodStrengthState(u,level,duration,true)
endfunction
