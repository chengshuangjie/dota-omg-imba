function B1060WaitOwner_MHF takes nothing returns nothing
local trigger actionOwner1060=GetTriggeringTrigger()
call B1060ActionEnter(actionOwner1060)
call MHF()
call B1060ActionLeave(actionOwner1060)
set actionOwner1060=null
endfunction
function MKF takes nothing returns boolean
return((IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO))and(not IsUnitIllusion(GetTriggerUnit()))and(GetIssuedOrderId()>$D0020)and(not KKDefense_IsWaveType(GetUnitTypeId(GetTriggerUnit()))))!=null
endfunction
function MMF takes nothing returns nothing
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local real b1060GetOrderPointX=GetOrderPointX()
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer i=GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))
if(GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)then
call MoveLocation(HC[i],GetUnitX(b1060GetOrderTargetUnit),GetUnitY(b1060GetOrderTargetUnit))
set i=b1060GetIssuedOrderId-$D0028
if((i>=0)and(i<6)and(GetPlayerController(GetOwningPlayer(b1060GetTriggerUnit))==MAP_CONTROL_NONE)and(QY4[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))]))then
set i=GetItemTypeId(UnitItemInSlot(b1060GetTriggerUnit,i))
if((i==ZU[Q1])or(i==ZU[it_fzz])or(i==ZU[D1])or(i==ZU[E1])or(i==ZU[F1])or(i==ZU[H1])or(i==ZU[it_shj]))then
call B947IssueTargetOrderById("MMF @ war3map.j:145296 (B968)",b1060GetTriggerUnit,$D000F,b1060GetOrderTargetUnit)
endif
endif
else
call MoveLocation(HC[i],b1060GetOrderPointX,b1060GetOrderPointY)
endif
set b1060GetOrderTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
//阻止电脑使用物品的屌毛函数
