function SuijiMode_ApplyScriptedTerrorbladeForm takes unit u returns nothing
local integer h=0
local integer currentType=0
local integer level=0
local integer modelType='Eevm'
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedTerrorbladeForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedTerrorbladeUnitType") then
call NP7(h,"SuijiScriptedTerrorbladeUnitType",currentType)
call NQ7(h,"SuijiScriptedTerrorbladeBaseRange",B848_FormBaseRange(u))
call NQ7(h,"SuijiScriptedTerrorbladeBaseAcquire",B1091AcquireBase(u))
endif
