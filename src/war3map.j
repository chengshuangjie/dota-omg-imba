function R6G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local integer BC7=(LoadInteger(L7,(I97),(5)))
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit Y27=(LoadUnitHandle(L7,(I97),(45)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local boolean TGD=(LoadBoolean(L7,(I97),(15)))
local group g
local integer QSG=GetTriggerEvalCount(t)
local integer suijiStaticStormMulticastCount=1
local real dur=20.
local boolexpr suijiStaticStormFilter=null
local boolean suijiStaticStormInvalid=false
if ZX7==null then
set suijiStaticStormInvalid=true
elseif GetUnitTypeId(ZX7)==0 then
set suijiStaticStormInvalid=true
elseif Y27==null then
set suijiStaticStormInvalid=true
elseif GetUnitTypeId(Y27)==0 then
set suijiStaticStormInvalid=true
elseif BB7==null then
set suijiStaticStormInvalid=true
elseif GetUnitTypeId(BB7)==0 then
set suijiStaticStormInvalid=true
endif
if suijiStaticStormInvalid then
call StopSound(VE4,false,true)
if Y27!=null and GetUnitTypeId(Y27)!=0 then
call KillUnit(Y27)
call ShowUnit(Y27,false)
endif
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call KillUnit(BB7)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set Y27=null
set BB7=null
return false
endif
if SUIJI_MODE and LoadReal(L7,GetHandleId(ZX7),StringHash("SuijiStaticStormMulticastUntil"))>=TimerGetElapsed(W) then
set suijiStaticStormMulticastCount=LoadInteger(L7,GetHandleId(ZX7),StringHash("SuijiStaticStormMulticastCount"))
if suijiStaticStormMulticastCount<1 then
set suijiStaticStormMulticastCount=1
endif
endif
if TGD then
set dur=28.
endif
if QSG>dur then
call StopSound(VE4,false,true)
call KillUnit(Y27)
call ShowUnit(Y27,false)
call KillUnit(BB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
set g=WS7()
set IN4=ZX7
set U_4=ZX7
set U24=0.25*(150+50*BC7)*(QSG/20.)*suijiStaticStormMulticastCount
set V44=false
set XTI=TGD
if ModuloInteger(QSG,4)==0 then
set V44=true
endif
set suijiStaticStormFilter=Condition(function AQ7)
call GroupEnumUnitsInRange(g,GetUnitX(Y27),GetUnitY(Y27),475,suijiStaticStormFilter)
call DestroyBoolExpr(suijiStaticStormFilter)
call ForGroup(g,function R3G)
call WR7(g)
set g=null
endif
set t=null
set ZX7=null
set Y27=null
set BB7=null
set suijiStaticStormFilter=null
return false
endfunction
function RLG takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
local real R1G=GetSpellTargetX()
local real R0G=GetSpellTargetY()
local unit Y27=null
local integer BC7=0
local unit BB7=null
local boolean TGD=false
local integer suijiStaticStormHandle=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set BC7=SuijiMode_GetPairCastLevel(ZX7,b1060B287_GetSpellAbilityId,'A1U6','A2UO')
if SUIJI_MODE then
set suijiStaticStormHandle=GetHandleId(ZX7)
if LoadReal(L7,suijiStaticStormHandle,StringHash("SuijiStaticStormBlockUntil"))>TimerGetElapsed(W) then
set ZX7=null
return
endif
