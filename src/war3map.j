if T_D!=null then
if D9==false then
call ForGroup(T_D,function TLD)
endif
call WR7(T_D)
endif
if ya!=null then
call RemoveUnit(ya)
endif
call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
call DestroyTimer(t)
set t=null
set ya=null
set WI7=null
set T_D=null
set U4D=null
set LQ7=null
return
endif
if GetUnitTypeId(WI7)==0 or GetUnitTypeId(ya)==0 or UnitAlive(WI7)==false or UnitAlive(ya)==false then
set O5=GetPlayerId(GetOwningPlayer(WI7))
if B946DetectCount>0 then
set GZ[384+O5]=B962Flag(1,384+O5,false,"T0D @ war3map.j:95128 (B968)")
else
set GZ[384+O5]=false
endif
set h4[16+O5]=null
if D9==false then
call ForGroup(T_D,function TLD)
endif
call WR7(T_D)
call RemoveUnit(ya)
call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
call DestroyTimer(t)
set t=null
set ya=null
set WI7=null
set T_D=null
set U4D=null
set LQ7=null
return
endif
set Y5=GetUnitX(ya)
set Z5=GetUnitY(ya)
set U4D=Condition(function TCD)
set LQ7=WS7()
