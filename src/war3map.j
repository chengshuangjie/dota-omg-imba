return
endif
call CND()
endfunction
function COD takes nothing returns nothing
local unit ZX7=IN4
local integer id=GetUnitTypeId(ZX7)
local trigger t
local integer skillmj
if id=='Z00E' then
    set skillmj='h10W'
elseif id=='Z10E' then
    set skillmj='h20W'
elseif id=='Z20E' then
    set skillmj='h30W'
elseif id=='Z30E' then
    set skillmj='h40W'
else
    set skillmj='h00W'
endif
set t=NHX(ZX7, GetEnumUnit(),skillmj, "CND",400, true, "")
call SaveReal(TABLE_HY, GetHandleId(t), 11, IJ4)
call SaveReal(TABLE_HY, GetHandleId(t), 12, IK4)
set t=null
set ZX7=null
