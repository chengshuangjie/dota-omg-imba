call RemoveUnit(GetEnumUnit())
endfunction
function Xw takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer v5=GetHandleId(t)
local trigger XW=OE7(v5,"mastert")
local integer tK=GetHandleId(XW)
// local trigger v7=OE7(tK,"DetectTrig")
local group Xx=OF7(tK,"g1")
local group XX=OF7(tK,"g2")
local unit TPD=O77(tK,"Wall")
local integer Xy=GetHandleId(TPD)
local integer Xv=OM7(Xy,"NumOfImages")
local integer i
local unit u
call DisableTrigger(XW)
call ForGroup(XX,function TOD)
set i=1
loop
exitwhen i>Xv
set u=O77(Xy,"Illusion"+I2S(i))
if OE7(Xy,"IllusionTrig"+I2S(i))!=null then
call DisableTrigger(OE7(Xy,"IllusionTrig"+I2S(i)))
call NM7(GetHandleId(OE7(Xy,"IllusionTrig"+I2S(i))))
call OZ7(OE7(Xy,"IllusionTrig"+I2S(i)))
endif
call RemoveSavedHandle(L7,Xy,StringHash("Illusion"+I2S(i)))
call RemoveSavedHandle(L7,Xy,StringHash("IllusionTrig"+I2S(i)))
if u!=null and GetUnitTypeId(u)!=0 and IsUnitIllusion(u)then
call B933RadianceStop(LoadTriggerHandle(L7,GetHandleId(u),StringHash("B933RadianceController")))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(u),GetUnitY(u)))
call RemoveUnit(u)
endif
set i=i+1
endloop
call NM7(v5)
call NM7(tK)
call NM7(Xy)
call RemoveUnit(TPD)
call WR7(Xx)
call WR7(XX)
call OZ7(XW)
// call OZ7(v7)
call OZ7(t)
set t=null
set XW=null
// set v7=null
set Xx=null
set XX=null
set TPD=null
set u=null
return false
endfunction
function SuijiMode_DarkSeerWallEffect takes unit WI7,real x,real y returns nothing
local real TRD
local unit TPD
local unit u
local real TV9
local real TW9
local integer i
local trigger t=CreateTrigger()
local group g1=CreateGroup()
local integer OB7=GetHandleId(t)
local group g2=CreateGroup()
local trigger XW=t
local integer BC7=IMaxBJ(B287_GetUnitAbilityLevel(WI7,'A0QK'),B287_GetUnitAbilityLevel(WI7,'A21Q'))
local boolean TGD=SuijiMode_ScepterRegistryIsActive(WI7,'A0QK')
local integer id=GetUnitTypeId(WI7)
local real a=AngleBetweenXY(GetUnitX(WI7),GetUnitY(WI7),x,y)
set TRD=a-45
if id=='Z00N' or id=='Z02X' then
set TRD=a
endif
set TPD=CreateUnit(GetOwningPlayer(WI7),'h00O',x,y,TRD)
if id=='Z00N' or id=='Z02X' then
call MHUnit_SetModel(TPD,"model\\Hero_DarkSeer_N1S_W_Wall.mdl",false)
endif
call SetUnitAbilityLevel(TPD,'A0QL',BC7)
call Y17(hR,x,y)
call NB7(OB7,"g1",g1)
call NB7(GetHandleId(TPD),"g1",g1)
call NB7(OB7,"g2",g2)
call NT7(OB7,"Wall",TPD)
call NT7(GetHandleId(TPD),"Source",WI7)
call NP7(GetHandleId(TPD),"NumOfImages",0)
set i=0
loop
exitwhen i>39
set TV9=x+(500-25*i)*Cos((TRD-45)*bj_DEGTORAD)
set TW9=y+(500-25*i)*Sin((TRD-45)*bj_DEGTORAD)
set u=CreateUnit(GetOwningPlayer(WI7),'h00P',TV9,TW9,TRD)
call SetUnitPathing(u,false)
call SetUnitX(u,TV9)
call SetUnitY(u,TW9)
call GroupAddUnit(g2,u)
call TriggerRegisterUnitInRange(t,u,17,Condition(function TO7))
set i=i+1
endloop
if TGD then
call TriggerAddCondition(t,Condition(function TJD))
else
call TriggerAddCondition(t,Condition(function TID))
endif
// set t=CreateTrigger()
// call TriggerRegisterUnitEvent(t,TPD,EVENT_UNIT_SUMMON)
// call TriggerAddCondition(t,Condition(function TMD))
// call NV7(OB7,"DetectTrig",t)
// set t=CreateTrigger()
// call TriggerRegisterUnitEvent(t,TPD,EVENT_UNIT_SUMMON)
// call TriggerAddCondition(t,Condition(function TMD))
// call NV7(OB7,"DetectTrig",t)
// set t=CreateTrigger()
// call TriggerRegisterUnitEvent(t,TPD,EVENT_UNIT_SUMMON)
// call TriggerAddCondition(t,Condition(function TMD))
// call NV7(OB7,"DetectTrig",t)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,35+0*BC7,false)
call TriggerAddCondition(t,Condition(function Xw))
call NV7(GetHandleId(t),"mastert",XW)
set WI7=null
set u=null
set t=null
set XW=null
set g1=null
set g2=null
set TPD=null
endfunction
