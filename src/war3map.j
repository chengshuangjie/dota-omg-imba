function AZD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit BB7=(LoadUnitHandle(L7,(I97),(19)))
local integer BC7=0
local integer V8D=0
local real AAD=0.
local integer VF9=0
local integer ABD=(LoadInteger(L7,(I97),(34)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call KKPassiveControllerStop(ZX7,'A029')
set ZX7=null
set BB7=null
set t=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A029')
set V8D=GetHeroAgi(ZX7,true)
set AAD=V8D*(.1+.04*BC7)
set VF9=R2I(AAD/2.+.5)
// if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()==1093677625 then
//     if ABD==1 then
//         set ABD=2
//     else
//         set ABD=1
//     endif
//     call SaveInteger(L7,(I97),(34),(ABD))
//     call UnitRemoveAbility(BB7,1093815897)
//     call UnitRemoveAbility(BB7,1093816115)
// endif
// if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()==1093677625 then
//     if ABD==1 then
//         set ABD=2
//     else
//         set ABD=1
//     endif
//     call SaveInteger(L7,(I97),(34),(ABD))
//     call UnitRemoveAbility(BB7,1093815897)
//     call UnitRemoveAbility(BB7,1093816115)
// endif
if BC7<=0 or XH7(ZX7) or ISPH(ZX7) then
if GetUnitAbilityLevel(BB7,'A2NY')>0 then
call UnitRemoveAbility(BB7,'A2NY')
endif
else
if GetUnitAbilityLevel(BB7,'A2NY')==0 then
call XF7(BB7,'A2NY')
    endif
if GetUnitAbilityLevel(BB7,'A2NY')!=VF9 then
call SetUnitAbilityLevel(BB7,'A2NY',VF9)
endif
endif
set ZX7=null
set BB7=null
set t=null
return false
endfunction
function KKTrueshotControllerStart takes unit trueshotOwner returns nothing
local trigger trueshotController=null
local integer trueshotControllerKey=0
local unit trueshotDummy=null
if trueshotOwner==null or GetUnitTypeId(trueshotOwner)==0 or LoadTriggerHandle(KKControllerOwnerTable,GetHandleId(trueshotOwner),StringHash("B820Passive"+I2S('A029')))!=null then
return
endif
set trueshotController=CreateTrigger()
set trueshotControllerKey=GetHandleId(trueshotController)
set trueshotDummy=CreateUnit(GetOwningPlayer(trueshotOwner),'e01V',0,0,0)
call SaveTriggerHandle(KKControllerOwnerTable,GetHandleId(trueshotOwner),StringHash("B820Passive"+I2S('A029')),trueshotController)
call TriggerRegisterTimerEvent(trueshotController,.1,true)
call TriggerAddCondition(trueshotController,Condition(function AZD))
call SaveUnitHandle(L7,trueshotControllerKey,2,trueshotOwner)
call SaveUnitHandle(L7,trueshotControllerKey,19,trueshotDummy)
call SaveInteger(L7,trueshotControllerKey,34,1)
call XF7(trueshotDummy,'A2NY')
set trueshotController=null
set trueshotDummy=null
endfunction
