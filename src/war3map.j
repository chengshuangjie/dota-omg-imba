call B947IssueImmediateOrderById("PGF @ war3map.j:158111 (B968)",j5,$D0278)
endif
endif
call J_7(2)
loop
exitwhen UP>$B
if h4[352+UP]==j5 then
set i1=GetUnitTypeId(M7[UP])
set X5=GetUnitCurrentOrder(M7[UP])
