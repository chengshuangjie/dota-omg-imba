function FJJ9 takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real YM7=400
local real d
if OT7((b1060GetEnumUnit),"FK9") then
call X37(GetOwningPlayer((b1060GetEnumUnit)),GetObjectName('n02M')+" "+GetUnitName((b1060GetEnumUnit))+" "+GetObjectName('n02S'))
else
    if OT7((b1060GetEnumUnit),"FK9")==false and IsUnitType((b1060GetEnumUnit),UNIT_TYPE_HERO) then
        call O37((b1060GetEnumUnit),"FK9",25)
    endif
    set d=DGH_BUFF((b1060GetEnumUnit))
    call DestroyEffect(AddSpecialEffectTarget("War3MapImported\\Unleash.mdx",(b1060GetEnumUnit),"chest"))
    if GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)<GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE) then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",(b1060GetEnumUnit),"origin"))
        call SetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE,GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)+YM7*d)
    endif
    if GetUnitState((b1060GetEnumUnit),UNIT_STATE_MANA)<GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_MANA) then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl",(b1060GetEnumUnit),"origin"))
        call SetUnitState((b1060GetEnumUnit),UNIT_STATE_MANA,GetUnitState((b1060GetEnumUnit),UNIT_STATE_MANA)+80)
    endif
endif
set b1060GetEnumUnit=null
endfunction
