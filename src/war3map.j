endfunction
function NagaSirenAghMirror_GetScepterCooldown takes unit u returns real
local real d=ReduceUnitAbilityCoolDownReal(u)
if d>0 then
return 26.67*d
endif
return 26.67
endfunction
function NagaSirenAghMirror_ApplyCooldownFix takes unit u returns nothing
local real cd
if u==null or B287_GetUnitAbilityLevel(u,'A063')<=0 or not NagaSirenAghMirror_HasScepter(u) then
return
endif
set cd=NagaSirenAghMirror_GetScepterCooldown(u)
call B287_YDWESetUnitAbilityState(u,'A063',1,cd)
call B287_MHAbility_SetCooldown(u,'A063',cd)
endfunction
function NagaSirenAghMirror_DelayedCooldownFix takes nothing returns boolean
