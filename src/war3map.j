set x1=x-n
set y1=y+n+m
set x2=x+n
set y2=y+n+m
elseif Face>=112.5 and Face<=157.5 then
set x1=x-n-m
set y1=y
set x2=x
set y2=y+n+m
elseif Face>157.5 and Face<202.5 then
set x1=x-n-m
set y1=y+n
set x2=x-n-m
set y2=y-n
elseif Face>=202.5 and Face<=247.5 then
set x1=x-n-m
set y1=y
set x2=x
set y2=y-n-m
elseif Face>247.5 and Face<292.5 then
set x1=x-n
set y1=y-n-m
set x2=x+n
set y2=y-n-m
elseif Face>=292.5 and Face<=337.5 then
set x1=x+n+m
set y1=y
set x2=x
set y2=y-n-m
endif
if id=='Z008' or id=='E115' then
set tx="model\\hero_lycan_n4s_v_target.mdl"
