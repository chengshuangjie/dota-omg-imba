function GetQSMJ takes unit u returns unit
if TV7(GetOwningPlayer(u)) then
    return JWQS
else
    return TZQS
endif
endfunction
function CreateQSMJ takes nothing returns nothing
set JWQS = CreateUnit(Z7[0],'h0GX', -7430.,-7324., 0)
set TZQS = CreateUnit(A7[0],'h0GX', 7077.,6576., 0)
endfunction
function BANPICKSF2 takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if GetIssuedOrderId()==$D0003 and GetOrderTargetItem()!=null then
if KV7(b1060GetTriggerUnit) and ED9(GetItemTypeId(GetOrderTargetItem())) then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),"飞行信使不能使用神符")
elseif (KU7(b1060GetTriggerUnit) or AS7(b1060GetTriggerUnit)) and ED99(GetItemTypeId(GetOrderTargetItem())) then
call KR7(b1060GetTriggerUnit)
call X37(GetOwningPlayer(b1060GetTriggerUnit),"动物信使或熊灵不能使用不朽之守护")
endif
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function BANPICKSF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function BANPICKSF2))
set t=null
endfunction
