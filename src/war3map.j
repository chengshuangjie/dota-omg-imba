	// 		call DzFrameSetScriptByCode(hTempFrame, 3, function LeaveButton, false)
	// 		set y = y + 1
	// 	endloop
	// 	set x = x + 1
	// endloop
//////////////////////////////////
    //技能提示
    set t=CreateTrigger()
    call TriggerAddCondition(t, Condition(function OnClickSkillButton))
    set x=1
    loop
        exitwhen x>12
        set SkillBarButton[x]=MHUI_GetSkillBarButton(x)
        call MHFrame_SetModel(MHUIData_GetCommandButtonCooldownFrame(SkillBarButton[x]),"UI\\Feedback\\Cooldown\\UI-Cooldown-Indicator.mdx",0,0)
        call MHFrameEvent_Register(t , SkillBarButton[x] , EVENT_ID_FRAME_MOUSE_CLICK)
        set x=x+1
    endloop
//////////////////////////////////
    //物品提示
//////////////////////////////////
    //物品提示
//////////////////////////////////
    //物品提示
    set t=CreateTrigger()
    call TriggerAddCondition(t, Condition(function OnClickItemButton))
	set x=1
	loop
		exitwhen x > 6
		// set ItemBarButton[x]=DzFrameGetItemBarButton(x)
		// call DzFrameSetScriptByCode(ItemBarButton[x], 2, function EntherItemCommandButtonCallback, false)
        // call DzFrameSetScriptByCode(ItemBarButton[x], 3, function LeaveItemCommandButtonCallback, false)
		// set ItemBarButton[x]=DzFrameGetItemBarButton(x)
		// call DzFrameSetScriptByCode(ItemBarButton[x], 2, function EntherItemCommandButtonCallback, false)
        // call DzFrameSetScriptByCode(ItemBarButton[x], 3, function LeaveItemCommandButtonCallback, false)
		// set ItemBarButton[x]=DzFrameGetItemBarButton(x)
		// call DzFrameSetScriptByCode(ItemBarButton[x], 2, function EntherItemCommandButtonCallback, false)
        // call DzFrameSetScriptByCode(ItemBarButton[x], 3, function LeaveItemCommandButtonCallback, false)
        set ItemBarButton[x]=MHUI_GetItemBarButton(x)
        if ItemBarButton[x] != 0 then
            call MHFrame_SetModel(MHUIData_GetCommandButtonCooldownFrame(ItemBarButton[x]),"UI\\Feedback\\Cooldown\\UI-Cooldown-Indicator.mdx",0,0)
            call MHFrameEvent_Register(t , ItemBarButton[x] , EVENT_ID_FRAME_MOUSE_CLICK)  //点击 0x20
        endif
		set x=x + 1
	endloop
    set t=null
	// 回调
	// 回调
	// 回调
	call DzFrameSetUpdateCallbackByCode(function cUpdateCallback)
	if WG7(GetLocalPlayer()) then
		call DzFrameSetEnable( GlyphFrame, false )
	endif
	// set FirstCommandBarButton = DzFrameGetCommandBarButton(0, 0)
	// set ButtonInterval = DzFrameGetCommandBarButton(1, 0) - FirstCommandBarButton
	// set FirstCommandBarButton = DzFrameGetCommandBarButton(0, 0)
	// set ButtonInterval = DzFrameGetCommandBarButton(1, 0) - FirstCommandBarButton
	// set FirstCommandBarButton = DzFrameGetCommandBarButton(0, 0)
	// set ButtonInterval = DzFrameGetCommandBarButton(1, 0) - FirstCommandBarButton
	call PauseTimer(b1060GetExpiredTimer)
	call DestroyTimer(b1060GetExpiredTimer)
set b1060GetExpiredTimer=null
endfunction
function createtower_rangeeff takes unit u returns nothing
	local effect eff = AddSpecialEffect("effects\\tower_range.mdx", GetUnitX(u), GetUnitY(u))
	set tower_rangeeff[tower_rangeint] = eff
	call SaveInteger(ExtraHT, GetHandleId(u), HTKEY_TOWER_ATTACK_RANGE_EFFECT, tower_rangeint)
	call EXSetEffectSize(tower_rangeeff[tower_rangeint], 0.01)
	set tower_rangeint = tower_rangeint + 1
	set eff = null
endfunction
function CreateNeutralsUnitsRefreshRect takes rect r, boolean high returns nothing
	local integer h = 896
	if high then
		set h = 1024
	endif
	set NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 0]= AddLightningEx("BRDR", false, GetRectMinX(r), GetRectMinY(r), h, GetRectMaxX(r), GetRectMinY(r), h)
	set NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 1]= AddLightningEx("BRDR", false, GetRectMinX(r), GetRectMaxY(r), h, GetRectMaxX(r), GetRectMaxY(r), h)
	set NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 2]= AddLightningEx("BRDR", false, GetRectMinX(r), GetRectMinY(r), h, GetRectMinX(r), GetRectMaxY(r), h)
	set NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 3]= AddLightningEx("BRDR", false, GetRectMaxX(r), GetRectMinY(r), h, GetRectMaxX(r), GetRectMaxY(r), h)
	call SetLightningColor(NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 0], 0.211, 0.87, 0, 0.0)
	call SetLightningColor(NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 1], 0.211, 0.87, 0, 0.0)
	call SetLightningColor(NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 2], 0.211, 0.87, 0, 0.0)
	call SetLightningColor(NeutralsPosTipLightning[NeutralsPosTipNumber * 4 + 3], 0.211, 0.87, 0, 0.0)
	set NeutralsPosTipNumber = NeutralsPosTipNumber + 1
endfunction
function ZOA takes nothing returns nothing
 local unit u
 local integer h
 local integer id
	if not TX7(GetTriggerPlayer()) or IsUnitIllusion(GetTriggerUnit()) then
		return
	endif
	set id=GetIssuedOrderId()
	set u=GetTriggerUnit()
	set h=GetHandleId(u)
	if id >= 852008 and id <= 852013 then
		// 黑洞 静态风暴
		//if  ( IsEffectEnabled[EFFECT_KEY_BLACKHOLE] and GetUnitAbilityLevel(u, 'B08V') > 0 ) or ( IsEffectEnabled[EFFECT_KEY_STATICSTORM] and GetUnitAbilityLevel(u, 'B0SD') > 0 ) then
		// 黑洞 静态风暴
		//if  ( IsEffectEnabled[EFFECT_KEY_BLACKHOLE] and GetUnitAbilityLevel(u, 'B08V') > 0 ) or ( IsEffectEnabled[EFFECT_KEY_STATICSTORM] and GetUnitAbilityLevel(u, 'B0SD') > 0 ) then
		if GetUnitAbilityLevel(u, 'B08V') > 0 or (IsAttackEffectEnabled[50] and GetUnitAbilityLevel(u, 'B0DL') > 0 ) then
			call X37(GetOwningPlayer(u) , "不能在锁闭状态下使用物品")
			// call EXStopUnit(u)
            call KR7(u)
		// else
		// 	call UnitIssuedItemOrder()
		// else
		// 	call UnitIssuedItemOrder()
		endif
	endif
	set u=null
endfunction
function RegisterHeroSkill takes integer i,integer skill1,integer skill2,integer skill3,integer skill4,integer skill5,integer skill6,integer skill7,integer skill8,integer skill9,integer skill10 returns nothing
    call SaveInteger(MSK,i,1,skill1)
    call SaveInteger(MSK,i,2,skill2)
    call SaveInteger(MSK,i,3,skill3)
    call SaveInteger(MSK,i,4,skill4)
    call SaveInteger(MSK,i,5,skill5)
    call SaveInteger(MSK,i,6,skill6)
    call SaveInteger(MSK,i,7,skill7)
    call SaveInteger(MSK,i,8,skill8)
    call SaveInteger(MSK,i,9,skill9)
    call SaveInteger(MSK,i,10,skill10)
endfunction
