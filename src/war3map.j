if(V77==1)then
set xlid='o105'
elseif(V77==2)then
set xlid='o106'
elseif(V77==3)then
set xlid='o107'
elseif(V77==4)then
set xlid='o10F'
endif
elseif id=='Z009' or id=='E116' then
set tx="model\\hero_lycan_n3s_v_target.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,WI7,"origin"))
if(V77==1)then
set xlid='o205'
elseif(V77==2)then
set xlid='o206'
elseif(V77==3)then
set xlid='o207'
elseif(V77==4)then
set xlid='o20F'
endif
else
set tx="Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl"
call DestroyEffect(AddSpecialEffect(tx,x1,y1))
call DestroyEffect(AddSpecialEffect(tx,x2,y2))
if(V77==1)then
set xlid='o005'
elseif(V77==2)then
set xlid='o006'
elseif(V77==3)then
set xlid='o007'
