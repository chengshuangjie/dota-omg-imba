function GWQ takes nothing returns nothing
    local unit suijiBloodseekerCaster = U22
	local unit WLE = W22
    local integer h=GetHandleId(GetTriggeringTrigger())
    local integer level=LoadInteger(TABLE_HY,h,10)
    local real ZCE = .0
	call CommonUnitAddStun(WLE, 0.01, false)
	set ZCE = level*75+25
	call B67(suijiBloodseekerCaster, WLE, 1, ZCE)
    call LINGXIA(suijiBloodseekerCaster,WLE)
    set suijiBloodseekerCaster=null
    set WLE=null
endfunction
function B582_DestroyBounceChain takes timer chainTimer returns nothing
local integer chainHandle=0
local group hitGroup=null
if chainTimer==null then
return
endif
set chainHandle=GetHandleId(chainTimer)
if HaveSavedHandle(TABLE_P,chainHandle,0)==false then
set chainTimer=null
return
endif
set hitGroup=LoadGroupHandle(TABLE_P,chainHandle,1)
if hitGroup!=null then
call WR7(hitGroup)
endif
call PauseTimer(chainTimer)
call FlushChildHashtable(TABLE_P,chainHandle)
call DestroyTimer(chainTimer)
set hitGroup=null
set chainTimer=null
endfunction
function B584_AbortBounceChain takes nothing returns nothing
local timer chainTimer=null
if B584_BOUNCE_ABORT_MISSILE_HANDLE!=0 then
set chainTimer=LoadTimerHandle(TABLE_HY,B584_BOUNCE_ABORT_MISSILE_HANDLE,StringHash("B582BounceChain"))
call B582_DestroyBounceChain(chainTimer)
endif
set chainTimer=null
endfunction
function B582_BounceChainTimeout takes nothing returns nothing
local timer chainTimer=GetExpiredTimer()
call B582_DestroyBounceChain(chainTimer)
set chainTimer=null
endfunction
function GWR takes nothing returns nothing
	local unit ZX7 = null
	local unit IH7 = W22
	local group g=null
	local group g2=null
	local unit u=null
	local real ZCE = .0
	local integer level=0
	local integer h=0
    local integer times
    local integer max
	local trigger missileTrigger=GetTriggeringTrigger()
	local trigger nextMissile=null
	local timer chainTimer=LoadTimerHandle(TABLE_HY,GetHandleId(missileTrigger),StringHash("B582BounceChain"))
	local boolexpr bounceFilter=null
	if chainTimer==null then
		set IH7=null
		set missileTrigger=null
		return
	endif
	set h=GetHandleId(chainTimer)
	set ZX7=LoadUnitHandle(TABLE_P,h,0)
	set g=LoadGroupHandle(TABLE_P,h,1)
	if ZX7==null or GetUnitTypeId(ZX7)==0 or IH7==null or GetUnitTypeId(IH7)==0 or g==null then
		call B582_DestroyBounceChain(chainTimer)
		set ZX7=null
		set IH7=null
		set g=null
		set missileTrigger=null
		set chainTimer=null
		return
	endif
	set level=LoadInteger(TABLE_P,h,2)
    set times=LoadInteger(TABLE_P,h,3)
    set max=LoadInteger(TABLE_P,h,4)
	call CommonUnitAddStun(IH7, 0.01, false)
	call GroupAddUnit(g, IH7)
	set ZCE = level*75+25
	call B67(ZX7, IH7, 1, ZCE)
    if IsUnitType(IH7,UNIT_TYPE_HERO) and IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and B287_GetUnitAbilityLevel(ZX7,'A1IQ')>0 then
        call SJTQ(ZX7,IH7)
    endif
    if times==max then
        call LINGXIA(ZX7,IH7)
    endif
    if times >0 then
		set g2 = WS7()
        set U22=ZX7
		set bounceFilter=Condition(function DKX)
		call GroupEnumUnitsInRange(g2, GetUnitX(IH7), GetUnitY(IH7), 400, bounceFilter)
		call DestroyBoolExpr(bounceFilter)
		set bounceFilter=null
		call GroupRemoveGroup(g, g2)
		set u=GroupPickRandomUnit(g2)
		if u!= null then
			set nextMissile=NHX_TANSHE(ZX7,IH7, u,'h0GH', "GWR", 1000, true, "")
			call SaveTimerHandle(TABLE_HY,GetHandleId(nextMissile),StringHash("B582BounceChain"),chainTimer)
            call SaveInteger(TABLE_P,h,3,times-1)
		else
			call B582_DestroyBounceChain(chainTimer)
		endif
		call WR7(g2)
		set g2 = null
    else
		call B582_DestroyBounceChain(chainTimer)
    endif
	set ZX7 = null
	set IH7 = null
	set u = null
	set g = null
	set missileTrigger=null
	set nextMissile=null
	set chainTimer=null
	set bounceFilter=null
endfunction
function TSFB3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger missileTrigger=null
local timer chainTimer=null
local integer chainHandle=0
    if SuijiMode_ScepterRegistryIsActive(ZX7,'A004') then
		set chainTimer=CreateTimer()
		set chainHandle=GetHandleId(chainTimer)
		call SaveUnitHandle(TABLE_P,chainHandle,0,ZX7)
		call SaveGroupHandle(TABLE_P,chainHandle,1,WS7())
		call SaveInteger(TABLE_P,chainHandle,2,B287_GetUnitAbilityLevel(ZX7,'A004'))
        // IMBA: bounce count x2 cap 8 (imbaMult gates).
        call SaveInteger(TABLE_P,chainHandle,3,IMinBJ(3*imbaMult,8))
        call SaveInteger(TABLE_P,chainHandle,4,IMinBJ(3*imbaMult,8))
		call TimerStart(chainTimer,15.,false,function B582_BounceChainTimeout)
		set missileTrigger=NHX(ZX7,IH7,'h0GH',"GWR",1000,true,"")
		call SaveTimerHandle(TABLE_HY,GetHandleId(missileTrigger),StringHash("B582BounceChain"),chainTimer)
    else
        set missileTrigger=NHX(ZX7,IH7,'h0GH',"GWQ",1000,true,"")
        call SaveInteger(TABLE_HY,GetHandleId(missileTrigger),10,B287_GetUnitAbilityLevel(ZX7,'A004'))
    endif
set ZX7=null
set IH7=null
set missileTrigger=null
set chainTimer=null
endfunction
function TSFB2 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A004' and WQ7(GetSpellTargetUnit())==false then
call TSFB3()
endif
return false
endfunction
function TSFB takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function TSFB2))
set t=null
endfunction
function U29 takes nothing returns boolean
local unit suijiWarpathUnit=GetTriggerUnit()
local integer suijiWarpathSkill=B287_GetSpellAbilityId()
local item suijiWarpathSourceItem=null
local boolean suijiWarpathCanTrigger=false
if suijiWarpathSkill=='A0GP' or suijiWarpathSkill=='A0FW' or suijiWarpathSkill=='A4E9' then
set suijiWarpathCanTrigger=true
elseif OO7(GetHandleId(suijiWarpathUnit),"SuijiWarpath") and UL7(suijiWarpathSkill) and LC7(suijiWarpathSkill)==false and L67(suijiWarpathSkill)==false and B287_GetUnitAbilityLevel(suijiWarpathUnit,suijiWarpathSkill)>0 then
set suijiWarpathSourceItem=B945SourceItem(suijiWarpathUnit,B287_GetPhysicalAbilityId(suijiWarpathUnit,suijiWarpathSkill))
set suijiWarpathCanTrigger=suijiWarpathSourceItem==null
endif
set suijiWarpathSourceItem=null
set suijiWarpathUnit=null
return suijiWarpathCanTrigger
endfunction
function U_9 takes integer V77,integer a returns integer
if a==0 then
return 1
else
return(V77-1)*5+1+a
endif
endfunction
function Ry takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='e00X'
endfunction
function RY takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function V49 takes player p returns nothing
local group g=WS7()
call GroupEnumUnitsOfPlayer(g,p,Condition(function Ry))
call ForGroup(g,function RY)
call WR7(g)
set g=null
endfunction
