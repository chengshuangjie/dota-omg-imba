set P17=UnitUseItemPoint(it,MV7(it,ZU[FF6]),GetUnitX(MD7),GetUnitY(MD7))
set P17=true
elseif(not GE7[O5])then
if GetUnitTypeId(it)=='H00J' or IsUnitIllusion(it) or not P07 then
