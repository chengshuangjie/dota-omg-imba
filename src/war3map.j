function Chat_Delay_Send2 takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer OB7=GetHandleId(t)
	local player p=LoadPlayerHandle(L7,OB7,0)
	local integer msgtype=LoadInteger(L7,OB7,10)
	local integer n
	local string VH=""
	if msgtype==StringHash("LianSha") then
		set n=M[GetPlayerId(p)]
		if n==2 then
			set VH="KILL2"
		elseif n==3 then
			set VH="KILL3"
		elseif n==4 then
			set VH="KILL4"		
		elseif n>=5 then
			set VH="KILL5"
		endif
	elseif msgtype==StringHash("ChaoShen") then
		set VH="CHAOSHEN"
	endif
	call Send_Chat_Text(p,Get_Chat_Text(p,VH))
	call RemoveSavedHandle(L7,GetHandleId(p),msgtype)
	call PauseTimer(t)
	call FlushChildHashtable(L7,OB7)
	call DestroyTimer(t)
	set t=null
	set p=null
endfunction
function Chat_Delay_Send takes player p,real d,integer Type returns nothing
	local timer t
	local integer OB7
	local integer msgtype
	local integer O5=GetPlayerId(p)
	if Type==1 then
		set msgtype=StringHash("LianSha")
	elseif Type==2 then
		set msgtype=StringHash("ChaoShen")
	else
		return
	endif
	if Type==1 and M[O5]>=5 then
		if AI_Text_Baozou_Cooldown[O5]<=GetGameTime() then
			set AI_Text_Baozou_Cooldown[O5]=GetGameTime()+10.
		else
			return
		endif
	endif
	if Type==2 then
		if AI_Text_Chaoshen_Cooldown[O5]<=GetGameTime() then
			set AI_Text_Chaoshen_Cooldown[O5]=GetGameTime()+10.
		else
			return
		endif
	endif
	if not HaveSavedHandle(L7,GetHandleId(p),msgtype) then
		set t=CreateTimer()
		set OB7=GetHandleId(t)
		call SaveTimerHandle(L7,GetHandleId(p),msgtype, t)
		call SavePlayerHandle(L7,OB7,0,p)
		call SaveInteger(L7,OB7,10,msgtype)
		call TimerStart(t,5,false,function Chat_Delay_Send2)
	endif
	set t=null
endfunction
function ISHZHS takes unit u returns boolean
return GetUnitAbilityLevel(u,'A4D9')>0
endfunction
function MV7 takes unit S4,integer n5 returns item
local integer D5
local item f5
set D5=0
loop
exitwhen D5>5
set f5=UnitItemInSlot(S4,D5)
if(f5!=null)and(GetItemTypeId(f5)==n5)then
set f5=null
return UnitItemInSlot(S4,D5)
endif
set D5=D5+1
endloop
set f5=null
return null
endfunction
// Early modules are declared before the full registry API. Read the same
// authoritative registry keys and only fall back while the first refresh is pending.
function SuijiMode_EarlyScepterRegistryIsActive takes unit u,integer normalSkill returns boolean
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
if LoadBoolean(L7,h,StringHash("SuijiScepterRegistered"+I2S(normalSkill))) then
return LoadBoolean(L7,h,StringHash("SuijiScepterActive"+I2S(normalSkill)))
endif
return LoadBoolean(L7,h,StringHash("SuijiHasScepter")) or GetUnitAbilityLevel(u,'A0TK')>0 or MV7(u,ZU[GX4])!=null or MV7(u,ZU[GK4])!=null or MV7(u,ZU[R1K])!=null or MV7(u,ZU[ANEW1])!=null or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0
endfunction
function AI_ITEM_POINT takes unit it,unit m5,integer which returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(it))
local boolean J4=true
if m5!=null then
call DisableTrigger(Q04[O5])
call UnitUseItemPoint(it,MV7(it,which),GetUnitX(m5),GetUnitY(m5))
call EnableTrigger(Q04[O5])
endif
return J4
endfunction
function AI_ITEM_LOCATION takes unit it,location b5,integer which returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(it))
local boolean J4=true
if b5==null then
	return false
endif
if b5!=null then
call DisableTrigger(Q04[O5])
call UnitUseItemPointLoc(it,MV7(it,which),b5)
call EnableTrigger(Q04[O5])
endif
return J4
endfunction
// B812: AI readiness runs from recurring tactical loops. Read the synchronized
// JAPI ability instance directly instead of following a MemHack live pointer.
// Runtime-added random carriers and inventory-provided abilities can have a
// valid native level before EXGetUnitAbility exposes a JAPI handle.  That state
// must stay castable: the engine order itself remains the final cooldown gate.
function B994UsesCombatGate takes integer skill994,string canonicalOrder994 returns boolean
return canonicalOrder994=="channel" or skill994=='A29J' or skill994=='A1MP' or skill994=='A0NS' or skill994=='A1DA'
endfunction
function B994CombatFamily takes integer skill994 returns integer
if skill994=='A2SU' then
return 'A0L3'
elseif skill994=='A0AV' then
return 'A03R'
elseif skill994=='A2SR' then
return 'A07U'
elseif skill994=='A1CS' then
return 'A0LT'
elseif skill994=='A4FR' then
return 'A0SW'
elseif skill994=='A2UX' then
return 'A0CT'
elseif skill994=='A1MP' then
return 'A29J'
elseif skill994=='A1DA' then
return 'A0NS'
endif
return skill994
endfunction
function B992ChannelUltAllowed takes unit u992,integer skill992 returns boolean
local integer h992=GetHandleId(u992)
local integer gated992=LoadInteger(L7,h992,StringHash("B992ChannelUlt"))
local integer p992=0
local integer original992=0
if gated992==0 or u992==null or GetPlayerController(GetOwningPlayer(u992))!=MAP_CONTROL_COMPUTER then
return true
endif
set original992=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill992)
if B994CombatFamily(skill992)!=B994CombatFamily(gated992) and B994CombatFamily(original992)!=B994CombatFamily(gated992) and skill992!=LoadInteger(L7,h992,StringHash("SuijiUltAbility")) and not (SUIJI_AI_CASTING and B994CombatFamily(SUIJI_AI_SKILL_ID)==B994CombatFamily(gated992)) then
return true
endif
set p992=GetPlayerId(GetOwningPlayer(u992))
return GetUnitLifePercent(u992)<50. and B992HitOwner[p992]==u992 and TimerGetElapsed(W)<B992HitUntil[p992]
endfunction
function B581_AIAbilityReady takes unit u,integer skill returns boolean
local ability a=null
local boolean ready=true
if not B992ChannelUltAllowed(u,skill) then
return false
endif
if u==null or GetUnitTypeId(u)==0 or skill==0 or GetUnitAbilityLevel(u,skill)<=0 then
return false
endif
set a=EXGetUnitAbility(u,skill)
if a!=null then
set ready=EXGetAbilityState(a,1)<=.01
endif
set a=null
return ready
endfunction
function AI_ITEM_OK takes unit u,string VH returns boolean
    local item it=null
    local integer id
    local integer skill
    if VH=="xueji" then
        set id=ZU[it_xueji]
    elseif VH=="zhzg" then
        set id=ZU[it_zhzg]
    elseif VH=="tiaodao" then
        set id=ZU[RW]
    elseif VH=="datiaodao1" then
        set id=ZU[it_sg]
    elseif VH=="datiaodao2" then
        set id=ZU[it_xjsg]
    elseif VH=="bkb" then
        set id=ZU[D0]
    elseif VH=="tiantang" then
        set id=ZU[R3]
    elseif VH=="sadan" then
        set id=ZU[it_sadan]
    elseif VH=="fls" then
        set id=ZU[it_fls]
    elseif VH=="dayun" then
        set id=ZU[U3]
    elseif VH=="renjia" then
        set id=ZU[AL]
    elseif VH=="darenjia" then
        set id=ZU[it_jjj]
    elseif VH=="dadianchui" then
        set id=ZU[it_dadianchui]
    elseif VH=="dayindao" then
        set id=ZU[RLL]
    elseif VH=="yangdao" then
        set id=ZU[it_yangdao]
    elseif VH=="shj" then
        set id=ZU[it_shj]
    elseif VH=="feixie" then
        set id=ZU[F6]
    elseif VH=="dafeixie" then
        set id=ZU[FF6]
    elseif VH=="sanshi" then
        set id=ZU[E1]
    elseif VH=="xuehou" then
        set id=ZU[it_xh]
    elseif VH=="dachuifeng" then
        set id=ZU[it_fzz]
    elseif VH=="dagen" then
        set id=ZU[N5]
    elseif VH=="xulingdao" then
        set id=ZU[E24]
    endif
    set it=MV7(u,id)
    if it!=null then
        set skill=MHItem_GetAbilityId(it,1)
        set it=null
        return B581_AIAbilityReady(u,skill)
    endif
    set it=null
    return false
endfunction
function B1120ControlBlocked takes unit controlledUnit1120 returns boolean
// Keep this read-only guard on spell AI paths. Shared order wrappers must still
// allow stop/hold, item use and lifecycle orders while their owner is paused.
if controlledUnit1120==null or GetUnitTypeId(controlledUnit1120)==0 or not UnitAlive(controlledUnit1120) then
return true
endif
if IsUnitHidden(controlledUnit1120) or IsUnitPaused(controlledUnit1120) or IsUnitType(controlledUnit1120,UNIT_TYPE_STUNNED) or IsUnitType(controlledUnit1120,UNIT_TYPE_POLYMORPHED) then
return true
endif
if LoadInteger(ExtraHT,GetHandleId(controlledUnit1120),HTKEY_UNIT_PAUSE_COUINT)>0 then
return true
endif
return MHUnit_IsFlag2(controlledUnit1120,UNIT_FLAG2_STUN)
endfunction
function AI_SKILL_OK takes unit u,integer skill returns boolean
local integer physicalSkill=skill
if u==null or skill==0 then
return false
endif
// Random AI templates still use the source hero's logical rawcodes, while the
// copied hero owns fixed Y... clones. Resolve only inside the random-AI bridge
// so ordinary native hero AI keeps its original identity and behavior.
if SUIJI_MODE and SUIJI_AI_CASTING then
set physicalSkill=B287_GetPhysicalAbilityId(u,skill)
endif
return B581_AIAbilityReady(u,physicalSkill)
endfunction
function VisageAI_FamiliarsPhysicalSkill takes unit u returns integer
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,'A1NE')
if physicalSkill!=0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
return physicalSkill
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,'A2IG')
if physicalSkill!=0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
return physicalSkill
endif
return 0
endfunction
function VisageAI_FamiliarsReady takes unit u returns boolean
local integer physicalSkill=VisageAI_FamiliarsPhysicalSkill(u)
if physicalSkill==0 then
return false
endif
if LoadReal(L7,GetHandleId(u),StringHash("VisageAI|FamiliarsReadyAt"))>TimerGetElapsed(W) then
return false
endif
return B581_AIAbilityReady(u,physicalSkill)
endfunction
function VisageAI_IssueFamiliars takes unit u returns boolean
local integer physicalSkill=VisageAI_FamiliarsPhysicalSkill(u)
local boolean issued=false
if physicalSkill==0 or VisageAI_FamiliarsReady(u)==false then
return false
endif
// A1NE/A2IG share one logical ultimate. Enabling both physical aliases from
// the high-frequency AI loop can expose a ready alias and bypass the cooldown.
call B515_SetLegacyAIAbilityAvailable(u,GetOwningPlayer(u),physicalSkill,true)
set issued=B947IssueImmediateOrderById("VisageAI_IssueFamiliars @ war3map.j:13267 (B968)",u,$D022E)
if issued then
// Cover the complete three-second paired-cooldown synchronization window.
// A one-second order lock could expire while a Scepter/clone command-card
// transition still exposed a temporarily ready physical alias.
call SaveReal(L7,GetHandleId(u),StringHash("VisageAI|FamiliarsReadyAt"),TimerGetElapsed(W)+3.25)
endif
return issued
endfunction
function SpiritBreakerAI_UltimateSkill takes unit u returns integer
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if B287_GetUnitAbilityLevel(u,'A1D8')>0 then
return 'A1D8'
endif
return 'A0G4'
endfunction
function SpiritBreakerAI_UltimateCooldown takes unit u,integer skill returns real
local integer level=GetUnitAbilityLevel(u,skill)
if level<=0 then
return 0.
elseif skill=='A1D8' then
return 45.-10.*level
endif
return 70.-10.*level
endfunction
function SpiritBreakerAI_UltimateReady takes unit u returns boolean
local integer skill=SpiritBreakerAI_UltimateSkill(u)
if skill==0 or AI_SKILL_OK(u,skill)==false then
return false
endif
return LoadReal(L7,GetHandleId(u),StringHash("SpiritBreakerAI|NetherStrikeUntil"))<=TimerGetElapsed(W)
endfunction
function SpiritBreakerAI_IssueUltimate takes unit u,unit target returns boolean
local integer skill=SpiritBreakerAI_UltimateSkill(u)
local boolean issued=false
if u==null or target==null or GetUnitTypeId(u)==0 or GetUnitTypeId(target)==0 then
return false
endif
if skill==0 or SpiritBreakerAI_UltimateReady(u)==false then
return false
endif
set issued=B947IssueTargetOrderById("SpiritBreakerAI_IssueUltimate @ war3map.j:13310 (B968)",u,$D0118,target)
if issued then
call SaveReal(L7,GetHandleId(u),StringHash("SpiritBreakerAI|NetherStrikeUntil"),TimerGetElapsed(W)+SpiritBreakerAI_UltimateCooldown(u,skill))
endif
return issued
endfunction
function AI_ITEM_RENJIA takes unit it returns boolean
local boolean J4=false
if AI_ITEM_OK(it,"darenjia") then
set TB4=true
set J4=UnitUseItem(it,MV7(it,ZU[it_jjj]))
elseif AI_ITEM_OK(it,"renjia") then
set TB4=true
set J4=UnitUseItem(it,MV7(it,ZU[AL]))  
endif
return J4
endfunction
function Get_Tiaodao takes unit u returns integer
    local integer i
    local item it
    set i=0
    loop
    exitwhen i>5
    set it=UnitItemInSlot(u,i)
    if(it!=null)and(GetItemTypeId(it)==ZU[RW] or GetItemTypeId(it)==ZU[it_sg] or GetItemTypeId(it)==ZU[it_sssg] or GetItemTypeId(it)==ZU[it_xjsg])and(B581_AIAbilityReady(u,MHItem_GetAbilityId(it,1))) then
    set it=null
    return i
    endif
    set i=i+1
    endloop
    set it=null
    return -1
endfunction
