function B999EndFreezeStart takes nothing returns nothing
// The first pass runs after the base-death callback and its nested damage events return.
call B999EndFreezeTick()
if B999EndFreezeTimer!=null then
// Keep the existing cadence to catch new units; already paused units are skipped.
call TimerStart(B999EndFreezeTimer,1.,true,function B999EndFreezeTick)
endif
endfunction
function XE7 takes nothing returns nothing
