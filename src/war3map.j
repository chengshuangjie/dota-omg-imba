if ISPH(WXX)==false and LoadBoolean(TABLE_HY,EOO,11)==false and LoadBoolean(TABLE_HY,EOO,14) and LoadBoolean(TABLE_HY,EOO,15) and B287_GetUnitAbilityLevel(WXX,'A0SS')>0 and GetUnitTypeId(YXX)!='n00L' then
        call XGSY(WXX,YXX)
    endif
endfunction
