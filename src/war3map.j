function OGv takes nothing returns boolean
local item b1060GetManipulatedItem=GetManipulatedItem()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),($E)))
local item ja=(LoadItemHandle(L7,(I97),(96)))
local group g
local integer id=0
local boolean radianceImage=LoadBoolean(L7,I97,StringHash("B933RadianceImage"))
local integer radianceSlot=0
local item radianceCandidate=null
if ZX7!=null then
set id=GetUnitTypeId(ZX7)
endif
if ZX7==null or id==0 or (radianceImage and (b1060GetTriggerEventId==EVENT_UNIT_DEATH or not UnitAlive(ZX7))) then
call B933RadianceStop(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_DROP_ITEM and b1060GetManipulatedItem==ja then
// One controller owns the aura even when several active Radiances are held.
// The dropping item may still be in the inventory during this callback.
set ja=null
loop
exitwhen radianceSlot>=UnitInventorySize(ZX7) or ja!=null
set radianceCandidate=UnitItemInSlot(ZX7,radianceSlot)
if radianceCandidate!=null and radianceCandidate!=b1060GetManipulatedItem and GetItemTypeId(radianceCandidate)==ZU[H2] then
set ja=radianceCandidate
endif
set radianceSlot=radianceSlot+1
endloop
if ja==null then
call B933RadianceStop(t)
else
call SaveItemHandle(L7,I97,96,ja)
endif
elseif not radianceImage and MV7(ZX7,ZU[H2])==null then
call B933RadianceStop(t)
elseif b1060GetTriggerEventId!=EVENT_UNIT_DROP_ITEM then
//排除背包熊
if XH7(ZX7)==false and id!='e01F' and MRPH(ZX7)==false  then
set g=WS7()
set U22=ZX7
set MH0=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),725,Condition(function DJX))
call EnableAttackEffectByTime(12, 2.)
//set bj_makeUnitRescuableUnit=CreateUnit(GetOwningPlayer(ZX7),'e00E',0,0,0)
//call UnitAddAbility(bj_makeUnitRescuableUnit,'A2Q8')
//set bj_makeUnitRescuableUnit=CreateUnit(GetOwningPlayer(ZX7),'e00E',0,0,0)
//call UnitAddAbility(bj_makeUnitRescuableUnit,'A2Q8')
//set bj_makeUnitRescuableUnit=CreateUnit(GetOwningPlayer(ZX7),'e00E',0,0,0)
//call UnitAddAbility(bj_makeUnitRescuableUnit,'A2Q8')
call ForGroup(g,function Ogv)
//call UnitRemoveAbility(bj_makeUnitRescuableUnit,'A2Q8')
call WR7(g)
set g=null
endif
endif
set t=null
set ZX7=null
set ja=null
set radianceCandidate=null
set b1060ReturnValue=false
set b1060GetManipulatedItem=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function Ohv takes unit ZX7 returns nothing
local trigger t=null
local integer I97=0
local integer radianceUnitKey=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
return
endif
set radianceUnitKey=GetHandleId(ZX7)
set t=LoadTriggerHandle(L7,radianceUnitKey,StringHash("B933RadianceController"))
if t!=null then
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveTriggerHandle(L7,radianceUnitKey,StringHash("B933RadianceController"),t)
call SaveInteger(L7,I97,StringHash("B933RadianceUnitKey"),radianceUnitKey)
call SaveBoolean(L7,I97,StringHash("B933RadianceImage"),IsUnitIllusion(ZX7))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DROP_ITEM)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function OGv))
call SaveUnitHandle(L7,(I97),($E),(ZX7))
call SaveItemHandle(L7,(I97),(96),MV7(ZX7,ZU[H2]))
set t=null
endfunction
