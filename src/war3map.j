function Start_BP takes nothing returns nothing
	local timer t=CreateTimer()
	local integer I97=GetHandleId(t)
	call XC7(GetLocalPlayer(),"Sound\\Interface\\Rescue.wav")
	// BAN提示
	call MHFrame_SetText(BAN_HERO_TIP,"当前为禁选阶段，你可以禁用2个英雄")
call MHFrame_SetTextColor(BAN_HERO_TIP,TEXT_COLOR_NORMAL,$FF0000)
call MHFrame_SetGradient(BAN_HERO_TIP,$FFFF2200,$FFFFAA00,$FFCC0000,$FFFFCC33,1,0)
	call MHFrame_SetWidth(BAN_HERO_COUNTDOWN,.2)
	call MHFrame_SetText(BAN_HERO_COUNTDOWN,"剩 余 时 间 :  20")
call MHFrame_SetTextColor(BAN_HERO_COUNTDOWN,TEXT_COLOR_NORMAL,$FF33CCFF)
call MHFrame_SetGradient(BAN_HERO_COUNTDOWN,$FF0066FF,$FF88DDFF,$FF0033AA,$FFCCEEFF,1,0)
	call MHFrame_SetTextAlign(BAN_HERO_COUNTDOWN,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_LEFT)
	call MHFrame_SetRelativePoint(BAN_HERO_COUNTDOWN,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_CENTER,0.06,-0.02)
	call SaveInteger(L7,I97,0,20)
	call TimerStart(t,1,true,function CHANGE_COUNTDOWN)
	set t=null
endfunction
