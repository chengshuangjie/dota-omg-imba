function ZHZG takes nothing returns nothing
if B287_GetSpellAbilityId()=='A2YK' then
call ZHZG2()
endif
endfunction
function SSSG2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer I97=GetHandleId(t)
    local unit u = LoadUnitHandle(L7,I97,0)
    local unit BB7
    local unit target
    local integer i
    local real x
    local real y
    local real a
    local real damage
    local group g
    if u==null or GetUnitTypeId(u)==0 then
        call FlushChildHashtable(L7,I97)
        call PauseTimer(t)
        call DestroyTimer(t)
        set u=null
        set t=null
        return
    endif
    set x=GetUnitX(u)
    set y=GetUnitY(u)
    set i=0
    loop
    set a=30*i
    set BB7=CreateUnit(GetOwningPlayer(u),'h0H7',x,y,a)
    call SetUnitTimeScale(BB7,3)
call UnitApplyTimedLife(BB7,'BTLF',1)
    set i=i+1
    exitwhen i==12
    endloop
    set damage=GetHeroStr(u,true)+200
    set g=WS7()
    set IN4=u
    call GroupEnumUnitsInRange(g,x,y,500,Condition(function AJ7_gai))
    loop
        set target=FirstOfGroup(g)
        exitwhen target==null or GetUnitTypeId(u)==0
        call GroupRemoveUnit(g,target)
        if XH7(target)==false and IsUnitEnemy(u,GetOwningPlayer(target)) and GetUnitAbilityLevel(target,'A04R')==0 and IsUnitType(target,UNIT_TYPE_STRUCTURE)==false and WF7(target)==false then
            call B67(u,target,1,damage)
            if XH7(target)==false then
                call Z57(target,'A4HT',1,4,'B0K3')
            endif
        endif
    endloop
    call WR7(g)
    // set x=GetUnitX(u)+500*Cos(0*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(0*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
