endfunction
function SRD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer OB7=0
local integer BC7=0
local unit IH7=GetSpellTargetUnit()
local real x=0.
local real y=0.
local integer id=0
local timer t
local integer I97
local unit BB7
local integer N5E=0
local real WF8
local integer skill=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set OB7=Get_Multiple_Skill_Key(ZX7,'A4A1')
set BC7=Multiple_Skill_Level(ZX7,'A4A1','A4A2')+Labike_Multiple_Skill_Level(ZX7,'A4A1')
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
set id=GetUnitTypeId(ZX7)
set N5E=(LoadInteger(MSK,(OB7),(30)))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
if N5E>0 then
    if IsUnitEnemy(IH7, GetOwningPlayer(ZX7)) and WQ7(IH7) then
        call PLK(IH7)
    else
set BB7=CreateUnit(GetOwningPlayer(ZX7),'o019',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(BB7,'BTLF',4.1)
        call OV7(IH7,"AstralImprisonmentState")
        set t=CreateTimer()
        set I97=GetHandleId(t)
        call OV7(IH7,"HideUnit")
        // call ImprisonedUnit(IH7,true)
        call B947IssueImmediateOrder("SRD @ war3map.j:93946 (B968)",IH7,"stop")
        call UnitEnterHide(IH7)
        call SetUnitInvulnerable(IH7 , true)
		call PauseUnitEx(IH7, true)
        // call HideUnit_Fix_Location(IH7,3.9)
        if id=='Z00P' then
            call NU7(I97,"FX",AddSpecialEffect("model\\hero_obsidiandestroyer_n3s_t_target.mdl",GetUnitX(IH7),GetUnitY(IH7)))
        else
            call NU7(I97,"FX",AddSpecialEffect("Abilities\\Spells\\Demon\\DarkConversion\\ZombifyTarget.mdl",GetUnitX(IH7),GetUnitY(IH7)))
        endif
        call NT7(I97,"Source",ZX7)
        call NT7(I97,"Target",IH7)
        call NQ7(I97,"TargetX",x)
        call NQ7(I97,"TargetY",y)
        call NP7(I97,"Level",BC7)
        if(IsUnitEnemy(IH7,GetOwningPlayer(ZX7))) then
            call NT7(GetHandleId(ZX7),"748",IH7)
            call DGBD(ZX7,IH7)
        endif
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        // call TriggerRegisterTimerEvent(t,4,false)
        // call TriggerAddCondition(t,Condition(function SQD))
        call TimerStart(t,4.,false,function SQD)
    endif
    call UnitRemoveAbility(ZX7,skill)
    set N5E=N5E-1
    call SaveInteger(MSK,(OB7),(30),(N5E))
    set skill=(LoadInteger(MSK,(OB7),(N5E)))
    if SuijiMode_EnsureExactLiveAbilityLevel(ZX7,skill,BC7,true) then
    call Multiple_Skill_SyncButton(ZX7,skill)
    call Reset_Skill_range(ZX7)
    endif
else
    call X377(GetOwningPlayer(ZX7),"无可用次数")
endif
if N5E==0 then
    set WF8=(LoadReal(MSK,(OB7),(50)))
    if WF8>0 then
        call Multiple_Skill_StartZeroCooldown(ZX7,skill,WF8)
    endif
endif
set BB7=null
set ZX7=null
set IH7=null
set t=null
endfunction
