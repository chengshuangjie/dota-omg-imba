function VLE takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local unit BB7=O77(OB7,"Caster")
call NM7(OB7)
call OZ7(t)
if b1060GetTriggerEventId==EVENT_WIDGET_DEATH then
call KillUnit(BB7)
endif
if GetUnitTypeId(hn)=='E015' then
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
//绑定单位会不生效
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
//call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",GetUnitX(hn),GetUnitY(hn)))
elseif GetUnitTypeId(hn)=='E115' then
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n4s_f_source_1.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n4s_f_source_2.mdl",GetUnitX(hn),GetUnitY(hn)))
elseif GetUnitTypeId(hn)=='E116' then
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n3s_f_source_1.mdl",GetUnitX(hn),GetUnitY(hn)))
call DestroyEffect(AddSpecialEffect("model\\hero_lycan_n3s_f_source_2.mdl",GetUnitX(hn),GetUnitY(hn)))
endif
call UnitRemoveAbility(hn,'A0ZC')
call UnitRemoveAbility(hn,'B00V')
if SUIJI_MODE and OO7(GetHandleId(hn),"SuijiDone") then
call UnitRemoveAbility(hn,'A2PX')
endif
call SetUnitImitateMoveSpeed(hn, 0, 0)
call C77(hn,0)
set t=null
set hn=null
set BB7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SuijiMode_RestoreScriptedWolfForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm")==false then
return
endif
if GetUnitTypeId(u)!=0 then
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiScriptedWolfBaseAttack"))
call SetUnitImitateMoveSpeed(u,0,0)
call UnitRemoveAbility(u,'ZWLA')
// Defensive cleanup for B571 and earlier direct-child states.
call UnitRemoveAbility(u,'ZWLS')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedWolfEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedWolfEffect"))
endif
call NS7(h,"SuijiScriptedWolfForm",false)
call SuijiMode_EndVisualForm(u,6)
set fx=null
endfunction
function SuijiMode_ApplyScriptedWolfForm takes unit u returns nothing
local integer h=0
local integer currentType=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedWolfUnitType") then
call NP7(h,"SuijiScriptedWolfUnitType",currentType)
call NQ7(h,"SuijiScriptedWolfBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
endif
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZWLA',1)
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,1.5)
// B579 enters the random form at CHANNEL, so the scripted lifecycle must own
// the native 650 movement override instead of relying on the later V1E path.
call SetUnitImitateMoveSpeed(u,999,650)
endfunction
function SuijiMode_ScriptedWolfFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedWolfSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,2) then
call SuijiMode_RestoreScriptedWolfForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ApplyScriptedWolfForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedWolfForm takes unit u,real duration returns nothing
local integer h=0
local integer serial=0
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 or duration<=0. then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedWolfForm") then
call SuijiMode_RestoreScriptedWolfForm(u)
endif
set serial=OM7(h,"SuijiScriptedWolfSerial")+1
call NP7(h,"SuijiScriptedWolfSerial",serial)
call NP7(h,"SuijiScriptedWolfUnitType",0)
call NS7(h,"SuijiScriptedWolfForm",true)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",u,"origin"))
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",u,"origin")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedWolfEffect"),fx)
call SuijiMode_SetVisualForm(u,6,EXGetUnitString('E015',UNIT_STRING_MODEL_PATH))
call SuijiMode_ApplyScriptedWolfForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveReal(L7,GetHandleId(t),2,TimerGetElapsed(W)+duration)
call TimerStart(t,.10,true,function SuijiMode_ScriptedWolfFormTick)
set fx=null
set t=null
endfunction
function V1E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local unit BB7=O77(OB7,"Caster")
local real bl_time=ON7(OB7,"Dur")
local integer bl_level
call NM7(OB7)
call OZ7(t)
set bl_level=B287_GetUnitAbilityLevel(hn,'A093')+GetUnitAbilityLevel(hn,'X093')+GetUnitAbilityLevel(hn,'X193')
if SUIJI_MODE and OO7(GetHandleId(hn),"SuijiDone") and GetUnitAbilityLevel(hn,'A2PX')==0 then
call UnitAddAbility(hn,'A2PX')
call UnitMakeAbilityPermanent(hn,true,'A2PX')
call SetPlayerAbilityAvailable(GetOwningPlayer(hn),'A2PX',false)
endif
call SetUnitAbilityLevel(hn,'A2PX',bl_level)
call C77(hn,300+bl_level*100)
if GetUnitTypeId(hn)=='E015' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosDone.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",hn,"origin"))
elseif GetUnitTypeId(hn)=='E115' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n4s_f_source_1.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n4s_f_source_2.mdl",hn,"overhead"))
elseif GetUnitTypeId(hn)=='E116' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n3s_f_source_1.mdl",hn,"origin"))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_lycan_n3s_f_source_2.mdl",hn,"overhead"))
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,bl_time - .1,false)
call TriggerRegisterDeathEvent(t,hn)
call TriggerAddCondition(t,Condition(function VLE))
call NT7(OB7,"Hero",hn)
call NT7(OB7,"Caster",BB7)
call SetUnitImitateMoveSpeed(hn, 999, 650)
set t=null
set hn=null
set BB7=null
return false
endfunction
//变狼
function V0E takes nothing returns nothing
local trigger t=null
local integer OB7=0
local unit hn=GetTriggerUnit()
local unit V5E=null
local real V2E
if hn==null or GetUnitTypeId(hn)==0 then
set hn=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set V5E=CreateUnit(GetOwningPlayer(hn),'e01V',0,0,0)
if V5E==null or GetUnitTypeId(V5E)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set V5E=null
set hn=null
return
endif
if SuijiMode_ScepterRegistryIsActive(hn,'A093') then
set V2E=40
else
set V2E=20
endif
if SUIJI_MODE and OO7(GetHandleId(hn),"SuijiDone") and SuijiMode_HasRandomSkill(hn,'A093') then
set V2E=V2E*SuijiMode_GetDurationMulticastCount(hn,'A093')
if OO7(GetHandleId(hn),"SuijiScriptedWolfForm")==false then
call SuijiMode_StartScriptedWolfForm(hn,V2E)
endif
endif
call XF7(V5E,'A0ZC')
call UnitApplyTimedLife(V5E,'BTLF',V2E)
if GetUnitTypeId(hn)=='U008' then
call XT7(hn,V2E,$AF)
endif
call TriggerRegisterTimerEvent(t,.1,false)
call TriggerAddCondition(t,Condition(function V1E))
call NT7(OB7,"Hero",hn)
call NT7(OB7,"Caster",V5E)
call NQ7(OB7,"Dur",V2E)
set t=null
set V5E=null
set hn=null
endfunction
function V_E takes nothing returns boolean
