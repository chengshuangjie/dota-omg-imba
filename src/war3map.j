function OPv takes nothing returns boolean
local item b1060GetManipulatedItem=GetManipulatedItem()
local unit b1060GetSummonedUnit=GetSummonedUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
