function VY9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"UnitVar")
local integer quillSourceKey1025=GetHandleId(WI7)
local unit quillTarget1025=null
local integer quillTargetKey1025=0
local integer quillStacks1025=0
local integer quillHitCount1025=LoadInteger(L7,OB7,StringHash("B1025QuillHitCount"))
local integer quillHitIndex1025=1
// Retained handles also clean removed targets, which disappear from unit groups.
loop
exitwhen quillHitIndex1025>quillHitCount1025
set quillTarget1025=LoadUnitHandle(L7,OB7,1000+quillHitIndex1025)
set quillTargetKey1025=GetHandleId(quillTarget1025)
set quillStacks1025=LoadInteger(L7,quillSourceKey1025,quillTargetKey1025)
if quillStacks1025>1 then
call SaveInteger(L7,quillSourceKey1025,quillTargetKey1025,quillStacks1025-1)
else
call RemoveSavedInteger(L7,quillSourceKey1025,quillTargetKey1025)
endif
set quillHitIndex1025=quillHitIndex1025+1
endloop
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set quillTarget1025=null
return false
endfunction
function VZ9 takes nothing returns nothing
local unit S79=GetTriggerUnit()
local group VA9=null
local trigger t=null
local unit bristlebackAghQuillSource=null
local integer bristlebackAghQuillDummyHandle=0
local integer bristlebackAghQuillLevel=0
local unit quillPreviousFilter1025=null
local unit quillTarget1025=null
local integer quillSourceKey1025=0
local integer quillTargetKey1025=0
local integer quillStacks1025=0
local integer quillHitCount1025=0
local integer quillOwnerKey1025=0
local real quillDamage1025=0.
local real quillX1025=0.
local real quillY1025=0.
if S79==null or GetUnitTypeId(S79)==0 then
set S79=null
return
endif
if IsUnitType(S79,UNIT_TYPE_HERO)==false then
set bristlebackAghQuillDummyHandle=GetHandleId(S79)
set bristlebackAghQuillSource=LoadUnitHandle(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillSource"))
set bristlebackAghQuillLevel=LoadInteger(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillLevel"))
call RemoveSavedHandle(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillSource"))
call RemoveSavedInteger(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillLevel"))
if bristlebackAghQuillSource!=null then
// An expired explicit owner must not fall back to a different hero.
set S79=bristlebackAghQuillSource
else
set S79=M7[GetPlayerId(GetOwningPlayer(S79))]
endif
endif
if S79==null or GetUnitTypeId(S79)==0 or not UnitAlive(S79) then
set S79=null
set bristlebackAghQuillSource=null
return
endif
if bristlebackAghQuillLevel<=0 then
set bristlebackAghQuillLevel=B287_GetUnitAbilityLevel(S79,'A0GP')
endif
set quillSourceKey1025=GetHandleId(S79)
set quillX1025=GetUnitX(S79)
set quillY1025=GetUnitY(S79)
set VA9=CreateGroup()
set quillPreviousFilter1025=IN4
set IN4=S79
call GroupEnumUnitsInRange(VA9,quillX1025,quillY1025,725,Condition(function AR7_gai))
set IN4=quillPreviousFilter1025
// Establish cleanup before any effect or synchronous damage can re-enter JASS.
set t=CreateTrigger()
set quillOwnerKey1025=GetHandleId(t)
call NT7(quillOwnerKey1025,"UnitVar",S79)
call SaveInteger(L7,quillOwnerKey1025,StringHash("B1025QuillHitCount"),0)
call TriggerRegisterTimerEvent(t,14.,false)
call TriggerAddCondition(t,Condition(function VY9))
// A4EK/A4EL were zero-damage Fan of Knives carriers. Play their burst model
// directly, without a temporary unit, added ability, or nested native cast.
if GetUnitTypeId(S79)=='Z018' then
call DestroyEffect(AddSpecialEffect("model\\Hero_Bristleback_N1S_R_boom.mdl",quillX1025,quillY1025))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.mdl",quillX1025,quillY1025))
endif
loop
set quillTarget1025=FirstOfGroup(VA9)
exitwhen quillTarget1025==null or GetUnitTypeId(S79)==0
call GroupRemoveUnit(VA9,quillTarget1025)
if GetUnitTypeId(quillTarget1025)!=0 and UnitAlive(quillTarget1025) then
set quillTargetKey1025=GetHandleId(quillTarget1025)
set quillStacks1025=LoadInteger(L7,quillSourceKey1025,quillTargetKey1025)
set quillDamage1025=YJ7(bristlebackAghQuillLevel*20+quillStacks1025*(bristlebackAghQuillLevel*5+25),2000)
// Reserve before B67: nested Quill must see this hit and cannot overwrite it.
set quillHitCount1025=quillHitCount1025+1
call SaveUnitHandle(L7,quillOwnerKey1025,1000+quillHitCount1025,quillTarget1025)
call SaveInteger(L7,quillOwnerKey1025,StringHash("B1025QuillHitCount"),quillHitCount1025)
call SaveInteger(L7,quillSourceKey1025,quillTargetKey1025,quillStacks1025+1)
call B67(S79,quillTarget1025,1,quillDamage1025)
if GetUnitTypeId(quillTarget1025)!=0 then
call YW7("+"+I2S(R2I(quillDamage1025)),1,quillTarget1025,.023,0,232,232,216)
endif
endif
endloop
call DestroyGroup(VA9)
if quillHitCount1025==0 then
call NM7(quillOwnerKey1025)
call OZ7(t)
endif
set t=null
set S79=null
set bristlebackAghQuillSource=null
set quillPreviousFilter1025=null
set quillTarget1025=null
set VA9=null
endfunction
