if KZ7(b1060GetManipulatedItem)==it_zhzg then
call UnitRemoveAbility(WI7,'A2YN')
endif
if KZ7(b1060GetManipulatedItem)==it_fls then
call UnitRemoveAbility(WI7,'A4E5')
endif
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PICKUP_ITEM then
