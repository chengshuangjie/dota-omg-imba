function SuijiMode_EchoSlamEffect takes unit p5,integer suijiEchoSlamSkill,boolean suijiEchoSlamEnforceLock returns nothing
local real x=0.
local real y=0.
local group g=null
local integer id=0
local integer V77=0
local integer i1=0
local integer skill
local integer skill2
local integer randomtx=0
local integer suijiEchoSlamCasterHandle=0
local boolean suijiEchoSlamScepter=false
local boolexpr b=null
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set suijiEchoSlamCasterHandle=GetHandleId(p5)
if SUIJI_MODE and suijiEchoSlamEnforceLock then
if LoadReal(L7,suijiEchoSlamCasterHandle,StringHash("SuijiEchoSlamBlockUntil"))>TimerGetElapsed(W) then
set p5=null
return
endif
call SaveReal(L7,suijiEchoSlamCasterHandle,StringHash("SuijiEchoSlamBlockUntil"),TimerGetElapsed(W)+.75)
endif
set x=GetUnitX(p5)
set y=GetUnitY(p5)
set g=WS7()
set id=GetPlayerId(GetOwningPlayer(p5))
if suijiEchoSlamSkill=='A1OB' then
set V77=B287_GetUnitAbilityLevel(p5,'A1OB')
else
set V77=B287_GetUnitAbilityLevel(p5,'A0DH')
endif
if V77<=0 then
if suijiEchoSlamSkill=='A1OB' then
set V77=B287_GetUnitAbilityLevel(p5,'A0DH')
else
set V77=B287_GetUnitAbilityLevel(p5,'A1OB')
endif
endif
if SUIJI_MODE then
set suijiEchoSlamScepter=SuijiMode_ScepterRegistryIsActive(p5,'A0DH')
else
set suijiEchoSlamScepter=suijiEchoSlamSkill=='A1OB'
endif
if V77<=0 then
call WR7(g)
set p5=null
set g=null
set b=null
return
endif
set i1=GetUnitTypeId(p5)
if i1=='Z02X' then
    set randomtx=GetRandomInt(1,3)
endif
if i1=='Ztch' or randomtx==1 then
    set skill='X1H0'
    set skill2='X0DM'
    call DestroyEffect(AddSpecialEffect("model\\Hero_EarthShaker_N3S_C_source.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif i1=='Zuch' or randomtx==2 then
    set skill='X2H0'
    set skill2='X1DM'
    call DestroyEffect(AddSpecialEffect("model\\Hero_EarthShaker_N7S_C_source.mdl",GetUnitX(p5),GetUnitY(p5)))
elseif i1=='Zvch' or randomtx==3 then
    set skill='X3H0'
    set skill2='X2DM'
    call DestroyEffect(AddSpecialEffect("AZModel\\AZ_ESFrost_C1_Caster.mdl",GetUnitX(p5),GetUnitY(p5)))
else
    set skill='A1H0'
set skill2='A0DM'
endif
set zZ[id]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
set YZ[id]=CreateUnit(GetOwningPlayer(p5),'e00E',x,y,0)
set ZZ=V77
call UnitApplyTimedLife(zZ[id],'BTLF',2.)
call UnitApplyTimedLife(YZ[id],'BTLF',2.)
call XF7(zZ[id],skill)
call SetUnitAbilityLevel(zZ[id],skill,V77)
call B947IssueImmediateOrderById("SuijiMode_EchoSlamEffect @ war3map.j:69749 (B968)",zZ[id],$D022E)
call SetUnitScale(YZ[id],.25,.25,.25)
call XF7(YZ[id],skill2)
call SetUnitAbilityLevel(YZ[id],skill2,V77)
set SuijiEchoSlamEffectCaster=p5
set b=Condition(function XM9)
call GroupEnumUnitsInRange(g,x,y,600,b)
call ForGroup(g,function XJ9)
if suijiEchoSlamScepter then
call ForGroup(g,function XK9)
endif
call DestroyBoolExpr(b)
call WR7(g)
set SuijiEchoSlamEffectCaster=null
set p5=null
set g=null
set b=null
endfunction
