endfunction
function XBD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local unit IH6=(LoadUnitHandle(L7,(I97),(16)))
local unit CJ9=(LoadUnitHandle(L7,(I97),(374)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local integer XCD=(LoadInteger(L7,(I97),($E9)))
local integer Z49=(LoadInteger(L7,(I97),($C)))
local boolean HaveA=(LoadBoolean(L7,(I97),(100)))
local unit BB7
local group g
local boolexpr suijiSoulSpearFilter=null
local real a
local real x
local real y
local integer X3D=(LoadInteger(L7,(I97),(720)))
local integer STOP=(LoadInteger(L7,(I97),(500)))
if ZX7==null or IH7==null or CJ9==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or GetUnitTypeId(CJ9)==0 then
if CJ9!=null and GetUnitTypeId(CJ9)!=0 then
call RemoveUnit(CJ9)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set IH6=null
set CJ9=null
set BB7=null
set g=null
return false
endif
if X3D>0 then //0.2秒弹一次
set X3D=X3D-1
call SaveInteger(L7,(I97),(720),(X3D))
set t=null
set ZX7=null
set IH7=null
set CJ9=null
return false
endif
if BlockUnitPass(CJ9) then
    call RemoveUnit(CJ9)
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
elseif KF7(GetUnitX(CJ9),GetUnitY(CJ9),GetUnitX(IH7),GetUnitY(IH7))>20 then 
    if STOP>0 then
        call SetUnitX(CJ9,GetUnitX(IH7))
        call SetUnitY(CJ9,GetUnitY(IH7))
    else
        set a=J77(GetUnitX(CJ9),GetUnitY(CJ9),GetUnitX(IH7),GetUnitY(IH7))
        call SetUnitFacing(CJ9,a)
        set x=GetUnitX(CJ9)+19*Cos(a*bj_DEGTORAD)
        set y=GetUnitY(CJ9)+19*Sin(a*bj_DEGTORAD)
        call SetUnitX(CJ9,x)
        call SetUnitY(CJ9,y)
    endif
else
    if UnitAlive(IH7) and IH7!=IH6 then
        call SaveUnitHandle(L7,(I97),(16),(IH7))
        if IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and WF7(IH7)==false then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,'A091')
call SetUnitAbilityLevel(BB7,'A091',BC7)
            call B947IssueTargetOrderById("XBD @ war3map.j:97137 (B968)",BB7,$D0102,IH7)
call UnitApplyTimedLife(BB7,'BTLF',1.)
        endif
        if LoadUnitHandle(L7,(I97),(88))!=null then
            call LINGXIA(ZX7,LoadUnitHandle(L7,(I97),(88)))
            call RemoveSavedHandle(L7,I97,88)
        endif
    endif
    if XCD>Z49 then
        call RemoveUnit(CJ9)
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
    else
        set g=WS7()
        set IN4=ZX7
        if HaveA then
            set suijiSoulSpearFilter=Condition(function LHSD_PD)
            call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),625,suijiSoulSpearFilter)
        else
            set suijiSoulSpearFilter=Condition(function AX7)
            call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),625,suijiSoulSpearFilter)
        endif
        call GroupRemoveUnit(g,IH7)
        if CountUnitsInGroup(g)==0 then
            if UnitAlive(IH7)==false or STOP>=100 then
                call RemoveUnit(CJ9)
                call FlushChildHashtable(L7,(I97))
                call OZ7(t)
            else
                call SetUnitX(CJ9,GetUnitX(IH7))
                call SetUnitY(CJ9,GetUnitY(IH7))
                call SaveInteger(L7,(I97),(500),(STOP+1))
            endif
        else
            set IH7=GroupPickRandomUnit(g)
            call SaveInteger(L7,(I97),(720),(10))
            call SaveInteger(L7,(I97),($E9),(XCD+1))
            call SaveUnitHandle(L7,(I97),(17),(IH7))
            call SaveInteger(L7,(I97),(500),(0))
        endif
        call WR7(g)
        call DestroyBoolExpr(suijiSoulSpearFilter)
    endif
endif
set t=null
set ZX7=null
set IH7=null
set IH6=null
set CJ9=null
set BB7=null
set g=null
set suijiSoulSpearFilter=null
return false
endfunction
function X6D takes nothing returns nothing
