if UnitAlive(IH7) and scepter and level>0 then
set BB7=CreateUnit(GetOwningPlayer(m0),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call XF7(BB7,'A4EQ')
call SetUnitAbilityLevel(BB7,'A4EQ',level)
call B947IssueTargetOrderById("H5E @ war3map.j:108010 (B968)",BB7,$D00B5,IH7)
endif
call B67(m0,IH7,2,50+50*M0)
set IH7=null
set BB7=null
endfunction
