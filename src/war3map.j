function CQD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local integer id=GetUnitTypeId(WX7)
local group g=WS7()
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A05V')
local real r
local real VW9
local real GYD
local string tx
if id=='Z00E' then
    set tx="model\\hero_necrolyte_n4s_d_source.mdl"
elseif id=='Z10E' then
    set tx="model\\hero_necrolyte_n5s_d_source.mdl"
elseif id=='Z20E' then
    set tx="model\\hero_necrolyte_n2s_d_source.mdl"
elseif id=='Z30E' then
    set tx="model\\hero_necrolyte_n3s_d_source.mdl"
else
    set tx="Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl"
endif
call DestroyEffect(AddSpecialEffectTarget(tx,WX7,"origin"))
if BC7==1 then
set VW9=125
set GYD=70
set r=500
elseif BC7==2 then
set VW9=175
set GYD=90
set r=500
elseif BC7==3 then
set VW9=225
set GYD=110
set r=500
elseif BC7==4 then
set VW9=275
set GYD=130
set r=500
endif
set IN4=WX7
set IJ4=VW9
set IK4=GYD
call GroupEnumUnitsInRange(g,GetUnitX(WX7),GetUnitY(WX7),r,Condition(function B77))
call GroupRemoveUnit(g,WX7)
call ForGroup(g,function CPD)
call WR7(g)
call SetUnitState(WX7,UNIT_STATE_LIFE,GetUnitState(WX7,UNIT_STATE_LIFE)+GYD)
set WX7=null
set g=null
endfunction
function CRD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A05V' then
call CQD()
endif
return false
endfunction
