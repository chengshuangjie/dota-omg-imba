function B1015NatureWrathRefund takes unit b1015Caster returns nothing
local trigger b1015Sync=null
local ability b1015Normal=null
local ability b1015Agh=null
local integer b1015NormalId=0
local integer b1015AghId=0
local real b1015Remaining=0.
local real b1015Now=TimerGetElapsed(W)
if b1015Caster==null or GetUnitTypeId(b1015Caster)==0 then
return
endif
set b1015NormalId=B287_GetPhysicalAbilityId(b1015Caster,'A1W8')
set b1015AghId=B287_GetPhysicalAbilityId(b1015Caster,'A1W9')
set b1015Normal=EXGetUnitAbility(b1015Caster,b1015NormalId)
set b1015Agh=EXGetUnitAbility(b1015Caster,b1015AghId)
set b1015Sync=LoadTriggerHandle(L7,GetHandleId(b1015Caster),StringHash("SuijiNatureWrathCooldownTrigger"))
if b1015Sync!=null then
// This deadline already includes held/consumed Octarine and earlier hero hits.
set b1015Remaining=RMaxBJ(0.,LoadReal(L7,GetHandleId(b1015Sync),7)-b1015Now)
else
set b1015Remaining=RMaxBJ(B582_GetAbilityCooldown(b1015Caster,b1015NormalId),B582_GetAbilityCooldown(b1015Caster,b1015AghId))
endif
set b1015Remaining=b1015Remaining*.85
if b1015Sync!=null then
call SaveReal(L7,GetHandleId(b1015Sync),7,b1015Now+b1015Remaining)
endif
if b1015Normal!=null then
call EXSetAbilityState(b1015Normal,1,b1015Remaining)
endif
if b1015Agh!=null then
call EXSetAbilityState(b1015Agh,1,b1015Remaining)
endif
set b1015Sync=null
set b1015Normal=null
set b1015Agh=null
endfunction
function NatureWrathOnDamage takes nothing returns boolean
local unit q5=MHDamageEvent_GetSource()
local integer h=0
local unit p5=null
local unit m5=MHEvent_GetUnit()
local integer skill=0
if q5==null or m5==null or GetUnitTypeId(q5)==0 or GetUnitTypeId(m5)==0 then
set q5=null
set m5=null
return false
endif
set h=GetHandleId(q5)
set p5=LoadUnitHandle(L7,h,StringHash("NatureWrathCaster"))
set skill=LoadInteger(L7,h,StringHash("NatureWrathSkill"))
if p5!=null and GetUnitTypeId(p5)!=0 and MHDamageEvent_GetDamage()>0 then
call NatureWrathApplyAtosRoot(p5,m5)
if IsUnitType(m5,UNIT_TYPE_HERO) and skill!=0 then
call B1015NatureWrathRefund(p5)
endif
endif
set q5=null
set p5=null
set m5=null
return false
endfunction
function AK9 takes nothing returns nothing
