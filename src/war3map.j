function ChenPersuasionSkill takes unit u returns integer
if u!=null and GetUnitTypeId(u)!=0 and SuijiMode_ScepterRegistryIsRegistered(u,'A28T') then
return 'A28T'
endif
if u!=null and GetUnitTypeId(u)!=0 and B287_GetUnitAbilityLevel(u,'A2S2')>0 then
return 'A2S2'
endif
return 'A28T'
endfunction
function WA9 takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local unit BB7=null
local real d=GetUnitDefaultMoveSpeed(m5)
local real d2=GetUnitDefaultMoveSpeed(p5)+I2R(U3V(p5))
if B1055IsLaneBoss(m5) and SuijiMode_ScepterRegistryIsActive(p5,'A28T') then
call SetUnitOwner(m5,GetOwningPlayer(p5),true)
else
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
call YF7(BB7,'A069',B287_GetUnitAbilityLevel(p5,'A28T')+B287_GetUnitAbilityLevel(p5,'A2S2'))
call B947IssueTargetOrderById("WA9 @ war3map.j:68607 (B968)",BB7,$D0265,m5)
endif
call WZ9(m5)
call AddHeroXP(p5,R2I(EEG(GetUnitLevel(m5))),true)
if GetUnitTypeId(m5)=='nA00' then
call UnitAddAbility(m5,'A2S7')
endif
if GetUnitTypeId(m5)=='n026' then
call UnitAddAbility(m5,'A2S7')
call UnitAddAbility(m5,'ACmi')
endif
if d2>d then
call SetUnitMoveSpeed(m5,R2I(d2))
endif
set p5=null
set m5=null
set BB7=null
endfunction
function WB9 takes nothing returns boolean
local unit suijiChenPersuasionTarget=GetSpellTargetUnit()
