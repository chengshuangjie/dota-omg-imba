//使用次数会减1次
function MGO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=(LoadUnitHandle(L7,(OB7),(2)))
local real mana=GetUnitState(WI7,UNIT_STATE_MANA)
// local integer BC7=LoadInteger(TABLE_VV,'I0BK',GetPlayerId(GetOwningPlayer(WI7)))
local integer BC7=GetItemCharges(MV7(WI7,ZU[DI4]))
local real d=DGH_BUFF(WI7)
local real recover=mana*.4*d
call SetUnitState(WI7,UNIT_STATE_MANA,GetUnitState(WI7,UNIT_STATE_MANA)-recover)
call SetUnitState(WI7,UNIT_STATE_LIFE,GetUnitState(WI7,UNIT_STATE_LIFE)+recover)
call SetItemCharges(MV7(WI7,ZU[DI4]),BC7+1)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodstoneHealTarget.mdx",WI7,"origin"))
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
//if GetUnitTypeId(WI7)==1315988077 then
//set YM4=WI7
//endif
//call KillUnit(WI7)
set WI7=null
set t=null
return false
endfunction
function MHO takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call SaveUnitHandle(L7,(OB7),(2),(WI7))
call TriggerAddCondition(t,Condition(function MGO))
call TriggerRegisterTimerEvent(t,0.01,false)
set t=null
set WI7=null
endfunction
//血精技能
function MZO takes nothing returns nothing
if B287_GetSpellAbilityId()=='A2R8' then
call MHO()
endif
endfunction
function kUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='o018' or id=='o002' or id=='o00B' or id=='o01B'
endfunction
function KUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='n00Q' or id=='n00O' or id=='n00P' or id=='n00N'
endfunction
function lUU takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return kUU(u)or KUU(u)or id=='otot'
endfunction
function Aov takes nothing returns nothing
if IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))==false then
call B67(GetTriggerUnit(),GetSpellTargetUnit(),10,999999)
endif
endfunction
function Arv takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer id=GetUnitTypeId(b1060GetSpellTargetUnit)
local integer d=0
if GetUnitAbilityLevel(b1060GetTriggerUnit,'A2VW')>0 then
set d=2
endif
call B287_SetUnitAbilityLevel(b1060GetTriggerUnit,skill,1+d)
if id=='o004' or id=='oeye' or lUU(b1060GetSpellTargetUnit) then
call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",b1060GetSpellTargetUnit,"chest"))
call Aov()
call B287_SetUnitAbilityLevel(b1060GetTriggerUnit,skill,2+d)
elseif id==0 then
call B287_SetUnitAbilityLevel(b1060GetTriggerUnit,skill,2+d)
else
call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",b1060GetSpellTargetUnit,"chest"))
call B67(b1060GetTriggerUnit,b1060GetSpellTargetUnit,3,400)
call B287_SetUnitAbilityLevel(b1060GetTriggerUnit,skill,1+d)
endif
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
function ARv takes nothing returns nothing
local integer id=GetUnitTypeId(GetSpellTargetUnit())
if id=='o004' or id=='oeye' or lUU(GetSpellTargetUnit())then
	call DestroyEffect(AddSpecialEffectTarget("tx\\dog\\N'aix_W.mdl",GetSpellTargetUnit(),"chest"))
	call Aov()
endif
endfunction
function MaO takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
//打野爪
if b1060B287_GetSpellAbilityId=='A2S0' then
call Arv()
//补刀斧
elseif b1060B287_GetSpellAbilityId=='A1FD' then
call ARv()
endif
endfunction
function B852MidasIsItem takes item midasItem returns boolean
local integer midasType=GetItemTypeId(midasItem)
return midasType=='I06D' or midasType=='I0NN' or midasType=='I01T' or midasType=='I0NP'
endfunction
function B852MidasDuration takes unit midasHero returns real
local real midasFactor=ReduceUnitAbilityCoolDownReal(midasHero)
if midasFactor<=0. then
set midasFactor=1.
endif
return RMaxBJ(.1,100.*midasFactor)
endfunction
function B852MidasSync takes nothing returns nothing
local integer midasIndex=1
local integer midasItemKey=0
local integer midasPoolKey=0
local integer midasCharges=0
local integer midasAbilityIndex=0
local real midasRemaining=0.
local item midasItem=null
local timer midasRecharge=null
local ability midasAbility=null
loop
exitwhen midasIndex>B852MidasItemCount
set midasItem=B852MidasItems[midasIndex]
set midasItemKey=GetHandleId(midasItem)
if not B852MidasIsItem(midasItem) then
call FlushChildHashtable(B852MidasTable,midasItemKey)
set B852MidasItems[midasIndex]=B852MidasItems[B852MidasItemCount]
set B852MidasItems[B852MidasItemCount]=null
set B852MidasItemCount=B852MidasItemCount-1
else
set midasPoolKey=GetHandleId(LoadUnitHandle(B852MidasTable,midasItemKey,10))
set midasCharges=LoadInteger(B852MidasTable,midasPoolKey,1)
call SetItemCharges(midasItem,midasCharges)
// Transition-local item UI reflects the current holder pool.
// Multiple Midas items on one holder share that holder pool.
if IsItemOwned(midasItem) and (GetItemTypeId(midasItem)=='I06D' or GetItemTypeId(midasItem)=='I0NN') then
set midasRemaining=0.
set midasRecharge=LoadTimerHandle(B852MidasTable,midasPoolKey,2)
if midasCharges==0 and midasRecharge!=null then
set midasRemaining=RMaxBJ(.01,TimerGetRemaining(midasRecharge))
endif
set midasAbilityIndex=1
loop
exitwhen midasAbilityIndex>MHItem_GetAbilityCount(midasItem)
if MHItem_GetAbilityId(midasItem,midasAbilityIndex)=='A28Y' then
set midasAbility=MHItem_GetAbility(midasItem,midasAbilityIndex)
if midasAbility!=null and MHAbility_GetId(midasAbility)=='A28Y' then
call MHAbility_SetAbilityCooldownEx(midasAbility,midasRemaining,RMaxBJ(midasRemaining,LoadReal(B852MidasTable,midasPoolKey,4)))
endif
endif
set midasAbilityIndex=midasAbilityIndex+1
endloop
endif
set midasIndex=midasIndex+1
endif
endloop
set midasItem=null
set midasRecharge=null
set midasAbility=null
endfunction
function B852MidasRefill takes nothing returns nothing
local timer midasTimer=GetExpiredTimer()
local integer midasTimerKey=GetHandleId(midasTimer)
local unit midasHero=LoadUnitHandle(B852MidasTable,midasTimerKey,0)
local integer midasPoolKey=GetHandleId(midasHero)
local integer midasCharges=LoadInteger(B852MidasTable,midasPoolKey,1)+1
local real midasNext=LoadReal(B852MidasTable,midasPoolKey,3)
call SaveInteger(B852MidasTable,midasPoolKey,1,IMinBJ(2,midasCharges))
call RemoveSavedReal(B852MidasTable,midasPoolKey,3)
// Arm the next queued recharge (or destroy this one) before optional UI writes.
if midasCharges<2 then
call SaveReal(B852MidasTable,midasPoolKey,4,midasNext)
call TimerStart(midasTimer,RMaxBJ(.1,midasNext),false,function B852MidasRefill)
else
call RemoveSavedHandle(B852MidasTable,midasPoolKey,2)
call FlushChildHashtable(B852MidasTable,midasTimerKey)
call PauseTimer(midasTimer)
call DestroyTimer(midasTimer)
endif
call B852MidasSync()
set midasTimer=null
set midasHero=null
endfunction
function B852MidasStart takes unit midasHero,real midasDuration returns nothing
local integer midasPoolKey=GetHandleId(midasHero)
local timer midasTimer=CreateTimer()
call SaveUnitHandle(B852MidasTable,GetHandleId(midasTimer),0,midasHero)
call SaveTimerHandle(B852MidasTable,midasPoolKey,2,midasTimer)
call SaveReal(B852MidasTable,midasPoolKey,4,midasDuration)
call TimerStart(midasTimer,midasDuration,false,function B852MidasRefill)
set midasTimer=null
endfunction
function B852MidasBind takes item midasItem,unit midasHolder returns unit
local integer midasItemKey=GetHandleId(midasItem)
local integer midasPoolKey=0
if not B852MidasIsItem(midasItem) or midasHolder==null or GetUnitTypeId(midasHolder)==0 then
return null
endif
if not UnitHasItem(midasHolder,midasItem) then
return null
endif
if not LoadBoolean(B852MidasTable,midasItemKey,13) then
if B852MidasItemCount>=8190 then
return null
endif
call SaveBoolean(B852MidasTable,midasItemKey,13,true)
set B852MidasItemCount=B852MidasItemCount+1
set B852MidasItems[B852MidasItemCount]=midasItem
endif
// Rebind the display on transfer; never move or reset the previous holder's pool.
call SaveUnitHandle(B852MidasTable,midasItemKey,10,midasHolder)
set midasPoolKey=GetHandleId(midasHolder)
if not LoadBoolean(B852MidasTable,midasPoolKey,0) then
call SaveBoolean(B852MidasTable,midasPoolKey,0,true)
call SaveInteger(B852MidasTable,midasPoolKey,1,1)
call B852MidasStart(midasHolder,B852MidasDuration(midasHolder))
endif
return midasHolder
endfunction
function B852MidasReconcile takes nothing returns nothing
local timer midasTimer=GetExpiredTimer()
local integer midasTimerKey=GetHandleId(midasTimer)
local unit midasHolder=LoadUnitHandle(B852MidasTable,midasTimerKey,11)
local integer midasSlot=0
local unit midasBound=null
local item midasSlotItem=null
local integer midasPass=LoadInteger(B852MidasTable,midasTimerKey,12)
// Two bounded passes cover inventory replacement and post-cast native charges.
if midasPass==0 then
call SaveInteger(B852MidasTable,midasTimerKey,12,1)
call TimerStart(midasTimer,.05,false,function B852MidasReconcile)
else
call FlushChildHashtable(B852MidasTable,midasTimerKey)
call PauseTimer(midasTimer)
call DestroyTimer(midasTimer)
endif
if midasHolder!=null and GetUnitTypeId(midasHolder)!=0 then
loop
exitwhen midasSlot>5
set midasSlotItem=UnitItemInSlot(midasHolder,midasSlot)
if B852MidasIsItem(midasSlotItem) then
set midasBound=B852MidasBind(midasSlotItem,midasHolder)
endif
set midasSlot=midasSlot+1
endloop
endif
call B852MidasSync()
set midasTimer=null
set midasHolder=null
set midasBound=null
set midasSlotItem=null
endfunction
function B852MidasSchedule takes unit midasHolder returns nothing
local timer midasTimer=CreateTimer()
call SaveUnitHandle(B852MidasTable,GetHandleId(midasTimer),11,midasHolder)
call TimerStart(midasTimer,0.,false,function B852MidasReconcile)
set midasTimer=null
endfunction
function B852MidasInventory takes nothing returns nothing
if B852MidasIsItem(GetManipulatedItem()) then
call B852MidasSchedule(GetTriggerUnit())
endif
endfunction
function B852MidasConsume takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local ability midasCastAbility=GetSpellAbility()
local item midasCastItem=null
local unit midasHero=null
local integer midasPoolKey=0
local integer midasCharges=0
local real midasDuration=0.
if midasCastAbility!=null then
set midasCastItem=MHAbility_GetAbilitySourceItem(midasCastAbility)
endif
set midasHero=B852MidasBind(midasCastItem,b1060GetTriggerUnit)
set midasPoolKey=GetHandleId(midasHero)
set midasCharges=LoadInteger(B852MidasTable,midasPoolKey,1)
if midasHero==null or midasCharges<=0 or SuijiMode_IsSacrificeProtectedTarget(GetSpellTargetUnit()) then
call B852MidasSchedule(b1060GetTriggerUnit)
set midasCastAbility=null
set midasCastItem=null
set midasHero=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
set midasDuration=B852MidasDuration(midasHero)
call SaveInteger(B852MidasTable,midasPoolKey,1,midasCharges-1)
if LoadTimerHandle(B852MidasTable,midasPoolKey,2)==null then
call B852MidasStart(midasHero,midasDuration)
else
call SaveReal(B852MidasTable,midasPoolKey,3,midasDuration)
endif
call B852MidasSchedule(b1060GetTriggerUnit)
set midasCastAbility=null
set midasCastItem=null
set midasHero=null
set b1060ReturnValue=true
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function B852MidasChannel takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local ability midasCastAbility=null
local item midasCastItem=null
local unit midasHero=null
if GetSpellAbilityId()=='A28Y' then
set midasCastAbility=GetSpellAbility()
if midasCastAbility!=null then
set midasCastItem=MHAbility_GetAbilitySourceItem(midasCastAbility)
endif
set midasHero=B852MidasBind(midasCastItem,b1060GetTriggerUnit)
if midasHero==null or LoadInteger(B852MidasTable,GetHandleId(midasHero),1)<=0 then
call B947IssueImmediateOrderById("B852MidasChannel @ war3map.j:178665 (B968)",b1060GetTriggerUnit,851972)
call B852MidasSchedule(b1060GetTriggerUnit)
endif
endif
set midasCastAbility=null
set midasCastItem=null
set midasHero=null
set b1060GetTriggerUnit=null
endfunction
function B852MidasInit takes nothing returns nothing
local trigger midasTrigger=CreateTrigger()
call YB7(midasTrigger,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call YB7(midasTrigger,EVENT_PLAYER_UNIT_DROP_ITEM)
call YB7(midasTrigger,EVENT_PLAYER_UNIT_PAWN_ITEM)
call TriggerAddAction(midasTrigger,function B852MidasInventory)
set midasTrigger=CreateTrigger()
call YB7(midasTrigger,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call YB7(midasTrigger,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddAction(midasTrigger,function B852MidasChannel)
set midasTrigger=null
endfunction
function EFG takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(34)))
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or (b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(IH7,'B0ES')>0) then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(IH7),GetUnitY(IH7)))
if DGFS(ZX7) then
call AddHeroXP(M7[GetPlayerId(GetOwningPlayer(ZX7))],R2I(EEG(BC7)*2.5),true)
else
call AddHeroXP(ZX7,R2I(EEG(BC7)*2.5),true)
endif
call ZQ7(GetOwningPlayer(ZX7),IH7,$BE)
set VH4[GetPlayerId(GetOwningPlayer(ZX7))]=VH4[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set EV0[GetPlayerId(GetOwningPlayer(ZX7))]=EV0[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set DJS[GetPlayerId(GetOwningPlayer(ZX7))]=DJS[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
call FlushChildHashtable(L7,(I97))
call OZ7(t)
//call KillUnit(IH7)
call SetUnitLifeBJ(IH7,20)
set imbaB67DpsExclude=true
call B67_DPS(ZX7,IH7,20,50)
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function EGG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer BC7=GetUnitLevel(IH7)
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(34),(BC7))
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call B1023RegisterDamage(t,IH7)
call TriggerAddCondition(t,Condition(function EFG))
set t=null
set ZX7=null
set IH7=null
endfunction
function EFGG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(34)))
local integer E1D=OM7(I97,"Iterations")
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEvalCount(t)>E1D then
call AddHeroXP(ZX7,R2I(EEG(BC7)*2.5),true)
//call KillUnit(IH7)
call SetUnitLifeBJ(IH7,20)
set imbaB67DpsExclude=true
call B67_DPS(ZX7,IH7,20,50)
call NM7(I97)
call OZ7(t)
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(IH7),GetUnitY(IH7)))
call ZQ7(GetOwningPlayer(ZX7),IH7,$BE)
set VH4[GetPlayerId(GetOwningPlayer(ZX7))]=VH4[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set EV0[GetPlayerId(GetOwningPlayer(ZX7))]=EV0[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
set DJS[GetPlayerId(GetOwningPlayer(ZX7))]=DJS[GetPlayerId(GetOwningPlayer(ZX7))]+$BE
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function EGGG takes integer r returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=b1060GetTriggerUnit
local unit IH7=GetSpellTargetUnit()
local integer BC7=GetUnitLevel(IH7)
if SuijiMode_IsSacrificeProtectedTarget(IH7) then
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060GetTriggerUnit=null
return
endif
if r==2 then
call YW7(GetObjectName('n0K7'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,b1060GetTriggerUnit,.03,255,0,0,255)
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(34),(BC7))
call NP7(I97,"Iterations",r)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
//call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DAMAGED)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function EFGG))
set t=null
set ZX7=null
set IH7=null
set b1060GetTriggerUnit=null
endfunction
function SuijiMulticastTemplate_IsRandomCaster takes unit suijiMulticastUnit returns boolean
local integer suijiMulticastHandle=0
if SUIJI_MODE==false or suijiMulticastUnit==null then
return false
endif
set suijiMulticastHandle=GetHandleId(suijiMulticastUnit)
return OO7(suijiMulticastHandle,"SuijiDone") and OO7(suijiMulticastHandle,"SuijiMulticast") and B287_GetUnitAbilityLevel(suijiMulticastUnit,'A088')>0
endfunction
function SuijiMulticastTemplate_IsOgreLikeCaster takes unit suijiMulticastUnit returns boolean
if suijiMulticastUnit==null then
return false
endif
return GetUnitTypeId(suijiMulticastUnit)=='Hmkg' or SuijiMulticastTemplate_IsRandomCaster(suijiMulticastUnit)
endfunction
function SuijiMulticastTemplate_IsFireblastSkill takes integer suijiMulticastSkill returns boolean
return suijiMulticastSkill=='A04W' or suijiMulticastSkill=='A08D' or suijiMulticastSkill=='A08A' or suijiMulticastSkill=='A089' or suijiMulticastSkill=='A2KQ'
endfunction
function SuijiMulticastTemplate_IsItemSkill takes integer suijiMulticastSkill returns boolean
return suijiMulticastSkill=='A02O' or suijiMulticastSkill=='A08Y' or suijiMulticastSkill=='A08Z' or suijiMulticastSkill=='A090' or suijiMulticastSkill=='A092' or suijiMulticastSkill=='AChx' or suijiMulticastSkill=='A0FD' or suijiMulticastSkill=='A32X' or suijiMulticastSkill=='A1QD' or suijiMulticastSkill=='A2EA' or suijiMulticastSkill=='A4DN' or suijiMulticastSkill=='A4pg' or suijiMulticastSkill=='A4DT'
endfunction
function EHG takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer r
if b1060B287_GetSpellAbilityId=='A28Y' then
if not B852MidasConsume() then
set b1060GetTriggerUnit=null
return
endif
if SuijiMulticastTemplate_IsOgreLikeCaster(b1060GetTriggerUnit) and B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A088')>0 and ISPH(b1060GetTriggerUnit)==false then
set r=EUD(b1060GetTriggerUnit)
if r>1 then
call EGGG(r)
else
call EGG()
endif
else
call EGG()
endif
elseif b1060B287_GetSpellAbilityId=='A02W' and B852MidasItemCount>0 then
// Refresher may clear the engine overlay, never the owner pool.
call B852MidasSchedule(b1060GetTriggerUnit)
endif
set b1060GetTriggerUnit=null
endfunction
function EIG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit Z69=(LoadUnitHandle(L7,(V07),(2)))
local real EJG=(LoadReal(L7,(V07),($F2)))
local real EKG=(LoadReal(L7,(V07),(529)))
local real EMG=(LoadReal(L7,(V07),(530)))
local real ENG=GetUnitState(Z69,UNIT_STATE_MANA)
local real EOG=GetUnitState(Z69,UNIT_STATE_MAX_MANA)
local real EPG=EJG-ENG
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
elseif GetTriggerEvalCount(t)==20*$A then
call FlushChildHashtable(L7,(V07))
call OZ7(t)
if EKG<$96 then
call SetUnitState(Z69,UNIT_STATE_MANA,ENG-($96-EKG-EMG))
endif
else
if EPG>0 then
set EKG=EKG+(EJG-ENG)
if EMG>0 then
if EPG>EMG then
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EMG)
set EMG=0
else
if EMG>(EOG-ENG)then
set EMG=EMG-(EOG-ENG)
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EOG-ENG)
else
set EMG=EMG-EPG
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+EPG)
endif
endif
endif
endif
set EJG=ENG
call SaveReal(L7,(V07),($F2),((EJG)*1.))
call SaveReal(L7,(V07),(529),((EKG)*1.))
call SaveReal(L7,(V07),(530),((EMG)*1.))
endif
set t=null
set Z69=null
return false
endfunction
function EQG takes nothing returns nothing
local unit Z69=GetTriggerUnit()
local real C7D=GetUnitState(Z69,UNIT_STATE_LIFE)
local trigger t=CreateTrigger()
local integer V07=GetHandleId(t)
local real ENG=GetUnitState(Z69,UNIT_STATE_MANA)
if C7D>$97 then
call SetUnitState(Z69,UNIT_STATE_LIFE,C7D-$96)
else
call SetUnitState(Z69,UNIT_STATE_LIFE,1)
endif
call YS7("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",Z69,"origin",2)
call SetUnitState(Z69,UNIT_STATE_MANA,ENG+$96)
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerRegisterUnitEvent(t,Z69,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function EIG))
call SaveUnitHandle(L7,(V07),(2),(Z69))
call SaveReal(L7,(V07),($F2),((GetUnitState(Z69,UNIT_STATE_MANA))*1.))
call SaveReal(L7,(V07),(529),((0)*1.))
if(ENG+$96)>GetUnitState(Z69,UNIT_STATE_MAX_MANA)then
call SaveReal(L7,(V07),(530),(((ENG+$96)-GetUnitState(Z69,UNIT_STATE_MAX_MANA))*1.))
endif
set Z69=null
set t=null
endfunction
function ERG takes nothing returns nothing
if B287_GetSpellAbilityId()=='A1Q8' then
call EQG()
endif
endfunction
function ESG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)>30 or GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(ZX7,'A1QC')
call UnitRemoveAbility(ZX7,'B0CY')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
return false
endfunction
function ETG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEvalCount(t)>30 or GetTriggerEventId()==EVENT_UNIT_DEATH or((LoadInteger(L7,(GetHandleId((ZX7))),((4256))))==1)then
call UnitRemoveAbility(ZX7,'Aetl')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set ZX7=null
set t=null
return false
endfunction
function EUG takes unit u returns nothing
local unit ZX7=u
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
call UnitAddAbility(ZX7,'Aetl')
call UnitMakeAbilityPermanent(ZX7,true,'Aetl')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'Aetl',false)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ETG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
set ZX7=null
set t=null
endfunction
function EVG takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local real d = LoadReal(TABLE_HY, h, 11)
    local trigger t
    if IsPlayerAlly(GetOwningPlayer(IH7),GetOwningPlayer(ZX7)) and ZX7!=IH7 then
        call EUG(IH7)
    elseif ZX7!=IH7 then
        set t=CreateTrigger()
        set h=GetHandleId(t)
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A1QC',false)
call UnitAddAbility(IH7,'A1QC')
call UnitMakeAbilityPermanent(IH7,true,'A1QC')
        call TriggerRegisterTimerEvent(t,.1,true)
        call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
        call TriggerAddCondition(t,Condition(function ESG))
        call SaveUnitHandle(L7,(h),(2),(IH7))
        call EUG(IH7)
        call YW7("+"+I2S(R2I(d)),2,IH7,.027,3,$D8,120,$D8)
        set E97=true
        call B67(ZX7,IH7,1,d)
        set E97=false
    endif
    call EUG(ZX7)
    set ZX7=null
    set IH7=null
    set t=null
endfunction
function EWG takes unit ZX7,unit IH7 returns nothing
local trigger t=NHX(ZX7, IH7,'h0BS', "EVG",1200, true, "")
local integer ZN9=WH7(ZX7)
local real EXG
if ZN9==2 then
set EXG=GetHeroAgi(ZX7,true)
elseif ZN9==3 then
set EXG=GetHeroStr(ZX7,true)
elseif ZN9==1 then
set EXG=GetHeroInt(ZX7,true)
endif
call SaveReal(TABLE_HY, GetHandleId(t), 11, (EXG*2.+75))
set t=null
endfunction
