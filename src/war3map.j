call SetUnitState(p5,UNIT_STATE_MANA,GetUnitState(p5,UNIT_STATE_MANA)+GetUnitState(m5,UNIT_STATE_LIFE)*(ritualLevel*.15+.1))
call NBG(m5,R2I(GetUnitState(m5,UNIT_STATE_LIFE)*(ritualLevel*.15+.1)))
call AddHeroXP(p5,R2I(EEG(BC7)),true)
call DarkRitualField_Start(p5,x,y,ritualLevel)
set Ovv=true
call B67(p5,m5,1,99999)
call B67(p5,m5,2,99999)
call B67(p5,m5,3,99999)
endif
set p5=null
set m5=null
endfunction
