if D88==null or IsUnitIllusion(p5) or IsUnitType(p5,UNIT_TYPE_HERO)==false or DGFS(p5) or LB7(GetUnitTypeId(p5)) or GetItemTypeId(D88)=='I00E' or GetItemTypeId(D88)=='I02M' or GetUnitTypeId(p5)=='Z053' then
set p5=null
set D88=null
