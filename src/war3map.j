set y=LoadReal(TABLE_XJ,(GetHandleId(N4I)),(7))
set UWO=LoadReal(TABLE_XJ,(GetHandleId(N4I)),(13))
call SaveEffectHandle(TABLE_XJ,(GetHandleId(N4I)),(33),(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_W4_Ribbon.MDX",N4I,"chest")))
call SetUnitVertexColor(N4I,150,150,150,153)
call PauseUnit(N4I,true)
call SetUnitAnimationByIndex(N4I,7)
