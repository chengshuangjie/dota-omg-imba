function IsAbilityCanDoubleTapSelfCastById takes integer iSkillId returns boolean
    return LoadBoolean(LocalHashTable, SuijiMode_ToOriginalSkill(iSkillId), KEY_USE_DOUBLECLICK_SPELL)
endfunction
function DoubleTapAbilityToSelfCast__CanTargetSelf takes unit doubleTapSourceUnit,integer doubleTapAbilityId returns boolean
    local integer doubleTapTargetAllow=0
    if doubleTapSourceUnit==null or GetUnitTypeId(doubleTapSourceUnit)==0 or doubleTapAbilityId==0 then
        return false
    endif
    // Keep the audited explicit families for scripted/special target modes.
    if IsAbilityCanDoubleTapSelfCastById(doubleTapAbilityId) then
        return true
    endif
    // All ordinary unit-targeted templates share this path.  Query the live
    // physical button so native, OMG clone, Scepter and charge-state variants
    // are accepted only when the engine itself considers the caster a legal
    // target for that exact ability.
    set doubleTapTargetAllow=MHAbility_GetTargetAllow(doubleTapSourceUnit,doubleTapAbilityId)
    return doubleTapTargetAllow!=0 and MHUnit_CheckTargetAllow(doubleTapSourceUnit,doubleTapSourceUnit,doubleTapTargetAllow)
endfunction
function DoubleTapAbilityToSelfCast__GetNativeItemKey takes integer itemSlot returns integer
    if itemSlot==0 then
        return 103
    elseif itemSlot==1 then
        return 104
    elseif itemSlot==2 then
        return 100
    elseif itemSlot==3 then
        return 101
    elseif itemSlot==4 then
        return 97
    elseif itemSlot==5 then
        return 98
    endif
    return 0
endfunction
function DoubleTapAbilityToSelfCast__OnKeyDown takes nothing returns boolean
    local integer pressedKey
    local integer abilKey
    local integer abilId
    local integer logicalAbilId
    local integer rebindKey=0
    local integer btn=1
    local integer doubleTapItemSlot=0
    local integer doubleTapOrderId=0
    local integer doubleTapCastType=0
    local integer doubleTapFlag=4
    local unit doubleTapSelectedUnit=null
    local unit doubleTapFountainUnit=null
    local item doubleTapSlotItem=null
    if B922WheelOpen or EditingHotKeyIndex>0 or MHUI_IsChatEditBarOn() or bDoubleClickSystemIsEnable==false then
        return false
    endif
    set abilId=MHUIData_GetTargetModeAbility()
    set logicalAbilId=SuijiMode_ToOriginalSkill(abilId)
    set pressedKey=MHEvent_GetKey()
    // Match the inventory-order path used by item quick cast (and Eul), rather
    // than clicking the hero portrait as if Lotus were a command-card skill.
    // The first key press opens target mode; the second sends that exact item
    // slot's use order directly to the currently selected hero.
    set doubleTapSelectedUnit=MHPlayer_GetSelectUnit()
    if doubleTapSelectedUnit!=null then
        set doubleTapItemSlot=0
        loop
            exitwhen doubleTapItemSlot>=6
            set doubleTapSlotItem=UnitItemInSlot(doubleTapSelectedUnit,doubleTapItemSlot)
            if doubleTapSlotItem!=null and MHItem_GetAbilityId(doubleTapSlotItem,1)=='A5VS' and (LocalCommandButtonHotKey[doubleTapItemSlot+1]==pressedKey or DoubleTapAbilityToSelfCast__GetNativeItemKey(doubleTapItemSlot)==pressedKey) then
                if MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) and (MHGame_GetGameStamp()-DoubleTapAbilityToSelfCast__DOUBE_TAP_TIME_THRESHOLD)<DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey] then
                    set doubleTapOrderId=852008+doubleTapItemSlot
                    set doubleTapCastType=MHAbility_GetCastType(doubleTapSelectedUnit,'A5VS')
                    if MHMsg_IsKeyDown(OSKEY_SHIFT) then
                        set doubleTapFlag=doubleTapFlag+1
                    endif
                    call MHMsg_SendTargetOrder(doubleTapSelectedUnit,GetUnitX(doubleTapSelectedUnit),GetUnitY(doubleTapSelectedUnit),doubleTapOrderId,doubleTapSlotItem,doubleTapCastType,doubleTapFlag)
                    call MHMsg_CancelIndicator()
                endif
                set DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey]=MHGame_GetGameStamp()
                set doubleTapSelectedUnit=null
                set doubleTapSlotItem=null
                return false
            endif
            set doubleTapItemSlot=doubleTapItemSlot+1
        endloop
    endif
    // Target-mode registration is the unified eligibility result: either an
    // audited special family or a live ability that can legally target self.
    if abilId!=DoubleTapAbilityToSelfCast__TargetModeAbilityId then
        set DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey]=MHGame_GetGameStamp()
        set doubleTapSelectedUnit=null
        set doubleTapSlotItem=null
        return false
    endif
    // Prefer the selected hero's live custom hotkey, then fall back to object
    // data.  This covers native blank-hotkey skills such as Chakra as well as
    // random fixed clones and temporary charge buttons.
    set abilKey=SuijiMode_GetSkillHotkey(doubleTapSelectedUnit,abilId)
    if abilKey<=0 then
        set abilKey=SuijiMode_NormalizeHotkey(MHAbility_GetDefDataInt(abilId,ABILITY_DEF_DATA_RESEARCH_HOTKEY))
    endif
    loop
        exitwhen btn>18
        if LocalCommandButtonHotKey[btn]==pressedKey then
            set rebindKey=pressedKey
            exitwhen true
        endif
        set btn=btn+1
    endloop
    // 内置改键与原始热键均支持双击对己施法
    if MHMsg_IsIndicatorOn(INDICATOR_TYPE_TARGET_MODE) and ( abilId == DoubleTapAbilityToSelfCast__TargetModeAbilityId ) and ( rebindKey == pressedKey or abilKey == pressedKey ) and ( ( MHGame_GetGameStamp() - DoubleTapAbilityToSelfCast__DOUBE_TAP_TIME_THRESHOLD ) < DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey] ) then
        if logicalAbilId=='A1RD' or logicalAbilId=='A3RD' then
            // Match Blink's double-tap retreat convention: submit the active
            // point-target indicator at this player's allied fountain.  The
            // Skewer controller still clamps the actual travel distance.
            if doubleTapSelectedUnit==null then
                set doubleTapSelectedUnit=MHPlayer_GetSelectUnit()
            endif
            if TV7(GetLocalPlayer()) then
                set doubleTapFountainUnit=IZ4
            else
                set doubleTapFountainUnit=JA4
            endif
            if doubleTapSelectedUnit!=null and doubleTapFountainUnit!=null and GetUnitTypeId(doubleTapFountainUnit)!=0 then
                set doubleTapOrderId=MHAbility_GetOrder(doubleTapSelectedUnit,abilId,1)
                set doubleTapCastType=MHAbility_GetCastType(doubleTapSelectedUnit,abilId)
                if MHMsg_IsKeyDown(OSKEY_SHIFT) then
                    set doubleTapFlag=doubleTapFlag+1
                endif
                if doubleTapOrderId!=0 then
                    call MHMsg_SendTargetOrder(null,GetUnitX(doubleTapFountainUnit),GetUnitY(doubleTapFountainUnit),doubleTapOrderId,null,doubleTapCastType,doubleTapFlag)
                    call MHMsg_CancelIndicator()
                    // B968: do not let the remapped/engine key cast again at the cursor.
                    call MHEvent_SetKey(-1)
                endif
            endif
        else
            // Unit-targeted command-card abilities use the selected portrait.
            call MHFrame_Click(MHUI_GetPortraitButton())
        endif
        // 按住shift时取消指示器
        if MHMsg_IsKeyDown(OSKEY_SHIFT) then
            call MHMsg_CancelIndicator()
        endif
    endif
    set DoubleTapAbilityToSelfCast__LastKeyPressTimestamp[pressedKey]=MHGame_GetGameStamp()
    set doubleTapSelectedUnit=null
    set doubleTapFountainUnit=null
    set doubleTapSlotItem=null
    return false
endfunction
function DoubleTapAbilityToSelfCast__OnCallTargetMode takes nothing returns boolean
    local integer abilId
    local unit doubleTapSourceUnit=null
    //获取指示器技能
    set abilId=MHMsgCallTargetModeEvent_GetAbility()
    set doubleTapSourceUnit=MHPlayer_GetSelectUnit()
    // Explicit special families remain supported; all ordinary unit-targeted
    // skills are discovered from the live engine target rules.
    if DoubleTapAbilityToSelfCast__CanTargetSelf(doubleTapSourceUnit,abilId) and B582_GetAbilityCooldown(doubleTapSourceUnit,abilId)==0 then
        set DoubleTapAbilityToSelfCast__TargetModeAbilityId=abilId
    else
        set DoubleTapAbilityToSelfCast__TargetModeAbilityId=0
    endif
    set doubleTapSourceUnit=null
    return false
endfunction
function DoubleTapAbilityToSelfCast__OnCancelIndicator takes nothing returns boolean
    set DoubleTapAbilityToSelfCast__TargetModeAbilityId=0
    return false
endfunction
//初始化双击施法
function DoubleTapAbilityToSelfCast_Init takes nothing returns nothing
    local trigger t
    call DoubleClickSkill__Init()
    //注册本地玩家按键按下事件
    //注册本地玩家按键按下事件
    set t=CreateTrigger()
    call MHMsgKeyDownEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnKeyDown))
    //注册本地玩家调起指示器事件
    //注册本地玩家调起指示器事件
    set t=CreateTrigger()
    call MHMsgCallTargetModeEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnCallTargetMode))
    //注册本地玩家取消指示器事件
    //注册本地玩家取消指示器事件
    set t=CreateTrigger()
    call MHMsgCancelIndicatorEvent_Register(t)
    call TriggerAddCondition(t, Condition(function DoubleTapAbilityToSelfCast__OnCancelIndicator))
    set t=null
endfunction
function UnitLP takes unit u, boolean b returns string
	local integer i = R2I(GetUnitLifePercent(u))
	local string s
	if b then
		set s = "|Cff00ff00"
	else
        set s = ""
	endif
	if i == 0 then
		set i = 1
	endif
	return s + I2S(i)+ "%生命|R和"
endfunction
function UnitMP takes unit u, boolean b returns string
	local integer i = R2I(GetUnitManaPercent(u))
    local string s
	if b then
		set s = "|cff87cefa"
	else
        set s = ""
	endif
	if i == 0 then
		set i = 1
	endif
	return s + I2S(i)+ "%魔法|R"
endfunction
