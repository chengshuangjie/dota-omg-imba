function FENGHUA takes nothing returns nothing
	if ISPH(WXX)==false and (B287_GetUnitAbilityLevel(WXX,'A2W1')> 0) and LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and ISPH(WXX)==false then
