endif
if B1023HitLive(attackSource1053) and B1023HitLive(attackTarget1053) and RSS4[attackOwner1053]>0 and IsUnitType(attackTarget1053,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(attackSource1053)==false and MR7(attackSource1053,ZU[RLL]) then
