function SuijiMode_ScriptedTerrorbladeFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedTerrorbladeSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,2) then
call SuijiMode_RestoreScriptedTerrorbladeForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ApplyScriptedTerrorbladeForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedTerrorbladeForm takes unit u returns nothing
local integer h=0
local integer serial=0
local integer count=1
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedTerrorbladeForm") then
call SuijiMode_RestoreScriptedTerrorbladeForm(u)
endif
set count=SuijiMode_GetDurationMulticastCount(u,'A1RI')
if count<1 then
set count=1
endif
set serial=OM7(h,"SuijiScriptedTerrorbladeSerial")+1
call NP7(h,"SuijiScriptedTerrorbladeSerial",serial)
call NP7(h,"SuijiScriptedTerrorbladeUnitType",0)
call NP7(h,"SuijiScriptedTerrorbladeVisualLevel",0)
call NS7(h,"SuijiScriptedTerrorbladeForm",true)
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Metamorphosis\\Metamorphosis.mdl",u,"origin")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedTerrorbladeEffect"),fx)
call SuijiMode_ApplyScriptedTerrorbladeForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveReal(L7,GetHandleId(t),2,TimerGetElapsed(W)+30.*count)
call TimerStart(t,.10,true,function SuijiMode_ScriptedTerrorbladeFormTick)
set fx=null
set t=null
endfunction
function SuijiMode_ClearScriptedSpiritFormButtons takes unit u returns nothing
if u==null then
return
endif
call UnitRemoveAbility(u,'A11X')
call UnitRemoveAbility(u,'A10U')
call UnitRemoveAbility(u,'A11V')
call UnitRemoveAbility(u,'A11Y')
call UnitRemoveAbility(u,'A11W')
call UnitRemoveAbility(u,'A11Z')
endfunction
function SuijiMode_UpdateScriptedSpiritForm takes unit u returns nothing
local integer h=0
local integer logicalSkill=0
local integer level=0
local integer firstSkill=0
local integer secondSkill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm")==false then
return
endif
set logicalSkill=OM7(h,"SuijiScriptedSpiritSkill")
set level=B287_GetUnitAbilityLevel(u,logicalSkill)
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==1 then
set firstSkill='A11X'
set secondSkill='A10U'
elseif level==2 then
set firstSkill='A11V'
set secondSkill='A11Y'
else
set firstSkill='A11W'
set secondSkill='A11Z'
endif
// The form timer only needs to repair a genuinely missing state button.
// Native level checks avoid two MemHack enumerations every 0.25 seconds while
// the already-correct command card is unchanged.
if level==OM7(h,"SuijiScriptedSpiritLevel") and GetUnitAbilityLevel(u,firstSkill)>0 and GetUnitAbilityLevel(u,secondSkill)>0 then
return
endif
call SuijiMode_ClearScriptedSpiritFormButtons(u)
call NP7(h,"SuijiScriptedSpiritLevel",0)
if SuijiMode_EnsureExactLiveAbilityLevel(u,firstSkill,1,true)==false then
return
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,secondSkill,1,true)==false then
call UnitRemoveAbility(u,firstSkill)
return
endif
call NP7(h,"SuijiScriptedSpiritLevel",level)
call SuijiMode_MarkUnitVisibilityDirty(u)
endfunction
function SuijiMode_RestoreScriptedSpiritForm takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm")==false then
return
endif
call SuijiMode_ClearScriptedSpiritFormButtons(u)
call UnitRemoveAbility(u,'ZKOS')
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"))
endif
call NS7(h,"SuijiScriptedSpiritForm",false)
call NP7(h,"SuijiScriptedSpiritLevel",0)
if GetUnitTypeId(u)!=0 then
call SuijiMode_MarkUnitVisibilityDirty(u)
call NS7(h,"SuijiAghForceUpdate",true)
call SuijiMode_UpdateAghSkills(u)
endif
set fx=null
endfunction
function SuijiMode_ScriptedSpiritFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if serial!=OM7(h,"SuijiScriptedSpiritSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=LoadReal(L7,timerHandle,2) then
call SuijiMode_RestoreScriptedSpiritForm(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_UpdateScriptedSpiritForm(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartScriptedSpiritForm takes unit u,integer physicalSkill returns nothing
local integer h=0
local integer logicalSkill='A11T'
local integer level=0
local integer count=1
local integer serial=0
local real duration=30.
local timer t=null
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSpiritForm") then
call SuijiMode_RestoreScriptedSpiritForm(u)
endif
set level=IMaxBJ(B287_GetUnitAbilityLevel(u,'A11T'),B287_GetUnitAbilityLevel(u,'A4AS'))
if level<1 then
return
elseif level>3 then
set level=3
endif
if level>=3 then
set duration=99999.
elseif SuijiMode_ScepterRegistryIsActive(u,'A11T') or level==2 then
set duration=40.
endif
set count=SuijiMode_GetDurationMulticastCount(u,logicalSkill)
if count>1 and duration<1000. then
set duration=duration*count
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,'ZKOS',1,true)==false then
return
endif
set serial=OM7(h,"SuijiScriptedSpiritSerial")+1
call NP7(h,"SuijiScriptedSpiritSerial",serial)
call NP7(h,"SuijiScriptedSpiritSkill",logicalSkill)
call NP7(h,"SuijiScriptedSpiritLevel",0)
call NS7(h,"SuijiScriptedSpiritForm",true)
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl",u,"overhead")
call SaveEffectHandle(L7,h,StringHash("SuijiScriptedSpiritEffect"),fx)
call SuijiMode_UpdateScriptedSpiritForm(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveReal(L7,GetHandleId(t),2,TimerGetElapsed(W)+duration)
call TimerStart(t,.25,true,function SuijiMode_ScriptedSpiritFormTick)
set fx=null
set t=null
endfunction
function SuijiMode_ChemicalRageCompatRestore takes unit u returns nothing
local integer h=0
local effect fx=null
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiChemicalRageActive")==false then
return
endif
call SuijiTest_DebugAll("CHEM-END","hero="+GetUnitName(u)+" level="+I2S(OM7(h,"SuijiChemicalRageLevel"))+" life="+R2S(GetWidgetLife(u))+" liveRegen="+R2S(MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN))+" restoreRegen="+R2S(ON7(h,"SuijiChemicalRageBaseLifeRegen")))
if GetUnitTypeId(u)!=0 then
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiChemicalRageBaseAttack"))
call MHUnit_SetData(u,UNIT_DATA_LIFE_REGEN,ON7(h,"SuijiChemicalRageBaseLifeRegen"))
call MHUnit_SetData(u,UNIT_DATA_MANA_REGEN,ON7(h,"SuijiChemicalRageBaseManaRegen"))
call UnitRemoveAbility(u,'ZCRG')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiChemicalRageEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiChemicalRageEffect"))
endif
call NS7(h,"SuijiChemicalRageActive",false)
call NP7(h,"SuijiChemicalRageVisualLevel",0)
call SuijiMode_EndVisualForm(u,5)
set fx=null
endfunction
function SuijiMode_ChemicalRageCompatApply takes unit u returns nothing
local integer h=0
local integer level=0
local integer currentType=0
local integer modelType='N01H'
local real attackCooldown=1.4
local real lifeRegen=10.
local real manaRegen=15.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiChemicalRageActive")==false then
return
endif
set level=OM7(h,"SuijiChemicalRageLevel")
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==2 then
set attackCooldown=1.2
set lifeRegen=20.
set manaRegen=25.
elseif level>=3 then
set attackCooldown=1.
set lifeRegen=30.
set manaRegen=35.
endif
if level==2 then
set modelType='N01T'
elseif level>=3 then
set modelType='N01J'
endif
if level!=OM7(h,"SuijiChemicalRageVisualLevel") then
call NP7(h,"SuijiChemicalRageVisualLevel",level)
call SuijiMode_SetVisualForm(u,5,EXGetUnitString(modelType,UNIT_STRING_MODEL_PATH))
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiChemicalRageUnitType") then
call NP7(h,"SuijiChemicalRageUnitType",currentType)
call NQ7(h,"SuijiChemicalRageBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
call NQ7(h,"SuijiChemicalRageBaseLifeRegen",MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN))
call NQ7(h,"SuijiChemicalRageBaseManaRegen",MHUnit_GetData(u,UNIT_DATA_MANA_REGEN))
call SuijiTest_DebugAll("CHEM-CAPTURE","hero="+GetUnitName(u)+" type="+I2S(currentType)+" level="+I2S(level)+" baseBAT="+R2S(ON7(h,"SuijiChemicalRageBaseAttack"))+" baseLifeRegen="+R2S(ON7(h,"SuijiChemicalRageBaseLifeRegen"))+" baseManaRegen="+R2S(ON7(h,"SuijiChemicalRageBaseManaRegen")))
endif
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZCRG',level)
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,attackCooldown)
// Native Chemical Rage transforms into unit types whose base regeneration is
// exactly 10/20/30 and 15/25/35.  Adding those values to a captured transient
// base made the random clone depend on whatever state happened to be active.
call MHUnit_SetData(u,UNIT_DATA_LIFE_REGEN,lifeRegen)
call MHUnit_SetData(u,UNIT_DATA_MANA_REGEN,manaRegen)
endfunction
function SuijiMode_ChemicalRageCompatTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer tick=LoadInteger(L7,timerHandle,2)+1
local integer unitHandle=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set unitHandle=GetHandleId(u)
call SaveInteger(L7,timerHandle,2,tick)
if serial!=OM7(unitHandle,"SuijiChemicalRageSerial") then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false or TimerGetElapsed(W)>=ON7(unitHandle,"SuijiChemicalRageEnd") then
call SuijiMode_ChemicalRageCompatRestore(u)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ChemicalRageCompatApply(u)
if SUIJI_LOG and ModuloInteger(tick,50)==0 then
call SuijiTest_DebugAll("CHEM-TICK","hero="+GetUnitName(u)+" level="+I2S(OM7(unitHandle,"SuijiChemicalRageLevel"))+" life="+R2S(GetWidgetLife(u))+"/"+R2S(GetUnitState(u,UNIT_STATE_MAX_LIFE))+" regen="+R2S(MHUnit_GetData(u,UNIT_DATA_LIFE_REGEN))+" BAT="+R2S(GetUnitState(u,UNIT_STATE_ATTACK1_COOL)))
endif
endif
set u=null
set t=null
endfunction
function SuijiMode_StartChemicalRageCompat takes unit u returns nothing
local timer t=null
local integer h=0
local integer serial=0
local integer level=0
local integer count=1
local effect fx=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiChemicalRageActive") then
call SuijiMode_ChemicalRageCompatRestore(u)
endif
set level=B287_GetUnitAbilityLevel(u,'ANcr')
if OM7(h,"SuijiUltSkill")=='ANcr' and SuijiMode_UltLevel(u)>level then
set level=SuijiMode_UltLevel(u)
endif
if level<1 then
return
elseif level>3 then
set level=3
endif
set count=SuijiMode_GetDurationMulticastCount(u,'ANcr')
if count<1 then
set count=1
endif
set serial=OM7(h,"SuijiChemicalRageSerial")+1
call NP7(h,"SuijiChemicalRageSerial",serial)
call NP7(h,"SuijiChemicalRageLevel",level)
call NP7(h,"SuijiChemicalRageUnitType",0)
call NP7(h,"SuijiChemicalRageVisualLevel",0)
call NQ7(h,"SuijiChemicalRageEnd",TimerGetElapsed(W)+25.*count)
call NS7(h,"SuijiChemicalRageActive",true)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Metamorphosis\\Metamorphosis.mdl",u,"origin"))
set fx=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl",u,"overhead")
call SaveEffectHandle(L7,h,StringHash("SuijiChemicalRageEffect"),fx)
call SuijiMode_ChemicalRageCompatApply(u)
call SuijiTest_DebugAll("CHEM-START","hero="+GetUnitName(u)+" logicalLevel="+I2S(B287_GetUnitAbilityLevel(u,'ANcr'))+" appliedLevel="+I2S(level)+" duration="+R2S(25.*count))
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,serial)
call SaveInteger(L7,GetHandleId(t),2,0)
call TimerStart(t,.10,true,function SuijiMode_ChemicalRageCompatTick)
set fx=null
set t=null
endfunction
function SuijiMode_TransformRestoreTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer serial=LoadInteger(L7,timerHandle,1)
local integer step=LoadInteger(L7,timerHandle,2)+1
local integer transformSkill=LoadInteger(L7,timerHandle,3)
local integer unitHandle=0
local integer slot=1
local integer skill=0
local integer level=0
local real cooldown=0.
local integer randomSkill=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set unitHandle=GetHandleId(u)
if serial!=LoadInteger(L7,unitHandle,StringHash("SuijiTransformSerial")) then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
loop
exitwhen slot>5
set skill=LoadInteger(L7,timerHandle,20+slot)
set level=LoadInteger(L7,timerHandle,30+slot)
// The engine owns the active transformation button while it swaps unit type.
// Restore the other hero skills, but never add/level/unhide that live button in
// the command-card rebuild window.
if skill!=0 and level>0 and SuijiMode_IsSameTransformRestoreFamily(skill,transformSkill)==false then
if SuijiMode_EnsureExactLiveAbilityLevel(u,skill,level,true) then
if SuijiMode_ShouldRestoreVisibleAbility(u,skill) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
endif
set cooldown=LoadReal(L7,timerHandle,40+slot)-TimerGetElapsed(W)
if cooldown>0. then
call SuijiMode_RestoreAbilityCooldown(u,skill,level,cooldown)
endif
endif
endif
set slot=slot+1
endloop
if OO7(unitHandle,"AlchemistUnstableCharging") then
if SuijiMode_EnsureExactLiveAbility(u,'A1NH',false) then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1NI',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1NH',true)
call Alchemist_UnstableSyncThrowButton(u)
endif
endif
if OM7(unitHandle,"SuijiSmallSkill")!=0 then
call SuijiMode_RestoreSkill(u,"SuijiSmall",SuijiMode_SmallLevel(u))
endif
if OM7(unitHandle,"SuijiUltSkill")!=0 and SuijiMode_UltLevel(u)>0 then
call SuijiMode_RestoreSkill(u,"SuijiUlt",SuijiMode_UltLevel(u))
endif
set randomSkill=LoadInteger(L7,timerHandle,60)
set cooldown=LoadReal(L7,timerHandle,62)-TimerGetElapsed(W)
if randomSkill!=0 and B287_GetUnitAbilityLevel(u,randomSkill)>0 and cooldown>0. then
call SuijiMode_RestoreAbilityCooldown(u,B287_GetPhysicalAbilityId(u,randomSkill),B287_GetUnitAbilityLevel(u,randomSkill),cooldown)
endif
set randomSkill=LoadInteger(L7,timerHandle,61)
set cooldown=LoadReal(L7,timerHandle,63)-TimerGetElapsed(W)
if randomSkill!=0 and B287_GetUnitAbilityLevel(u,randomSkill)>0 and cooldown>0. then
call SuijiMode_RestoreAbilityCooldown(u,B287_GetPhysicalAbilityId(u,randomSkill),B287_GetUnitAbilityLevel(u,randomSkill),cooldown)
endif
if step>=8 then
call SaveBoolean(L7,unitHandle,StringHash("SuijiTransformRestoring"),false)
call NS7(unitHandle,"SuijiAghForceUpdate",true)
call SuijiMode_MarkUnitVisibilityDirty(u)
call SuijiMode_UpdateLevels(u)
if LoadBoolean(L7,unitHandle,StringHash("B1116EventDeferred")) then
call SuijiMode_QueueEventReconcile(u,.10)
endif
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SaveInteger(L7,timerHandle,2,step)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartTransformRestore takes unit u,integer transformSkill returns nothing
local timer t=null
local integer timerHandle=0
local integer unitHandle=0
local integer heroIndex=0
local integer serial=0
local integer slot=1
local integer skill=0
local integer level=0
local real cooldown=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set unitHandle=GetHandleId(u)
set heroIndex=SuijiMode_GetStableHeroIndex(u)
set serial=LoadInteger(L7,unitHandle,StringHash("SuijiTransformSerial"))+1
call SaveInteger(L7,unitHandle,StringHash("SuijiTransformSerial"),serial)
call SaveBoolean(L7,unitHandle,StringHash("SuijiTransformRestoring"),true)
set t=CreateTimer()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,0,u)
call SaveInteger(L7,timerHandle,1,serial)
call SaveInteger(L7,timerHandle,2,0)
call SaveInteger(L7,timerHandle,3,transformSkill)
loop
exitwhen slot>5
set skill=SuijiMode_TransformBaseSkill(heroIndex,slot)
set level=0
if skill!=0 then
set level=GetUnitAbilityLevel(u,skill)
endif
call SaveInteger(L7,timerHandle,20+slot,skill)
call SaveInteger(L7,timerHandle,30+slot,level)
if skill!=0 and level>0 and SuijiMode_HasExactLiveAbility(u,skill) then
set cooldown=B582_GetAbilityCooldown(u,skill)
if cooldown>0. then
call SaveReal(L7,timerHandle,40+slot,TimerGetElapsed(W)+cooldown)
endif
endif
set slot=slot+1
endloop
set skill=OM7(unitHandle,"SuijiSmallSkill")
call SaveInteger(L7,timerHandle,60,skill)
if skill!=0 and B287_GetUnitAbilityLevel(u,skill)>0 then
set cooldown=B287_MHAbility_GetCooldown(u,skill)
if cooldown>0. then
call SaveReal(L7,timerHandle,62,TimerGetElapsed(W)+cooldown)
endif
endif
set skill=OM7(unitHandle,"SuijiUltSkill")
call SaveInteger(L7,timerHandle,61,skill)
if skill!=0 and B287_GetUnitAbilityLevel(u,skill)>0 then
set cooldown=B287_MHAbility_GetCooldown(u,skill)
if cooldown>0. then
call SaveReal(L7,timerHandle,63,TimerGetElapsed(W)+cooldown)
endif
endif
call TimerStart(t,.20,true,function SuijiMode_TransformRestoreTick)
set t=null
endfunction
// The 16-platform overwrite runtime owns the command entry as well as the
// transformation lifecycle.  Mirror that boundary for these three random
// forms: dispatch from the authoritative logical slot, then let SPELL_CAST and
// SPELL_EFFECT act only as guarded fallbacks.  This also covers an ANcl carrier
// whose immediate order is accepted without producing a Warcraft spell event.
function SuijiMode_StartRandomTransformByLogicalSlot takes unit u,integer logicalSkill,string entry returns boolean
local real duration=20.
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or OO7(GetHandleId(u),"SuijiDone")==false then
return false
endif
if logicalSkill=='A03G' and SuijiMode_HasRandomSkill(u,'A03G') then
if OO7(GetHandleId(u),"SuijiScriptedDragonForm") then
return false
endif
call SuijiTest_DebugAll("FORM-START","entry="+entry+" hero="+GetUnitName(u)+" skill="+GetAbilityName(logicalSkill)+" physical="+GetAbilityName(B287_GetPhysicalAbilityId(u,logicalSkill)))
call SuijiMode_StartScriptedDragonForm(u)
return true
elseif logicalSkill=='ANcr' and SuijiMode_HasRandomSkill(u,'ANcr') then
if OO7(GetHandleId(u),"SuijiChemicalRageActive") then
return false
endif
call SuijiTest_DebugAll("FORM-START","entry="+entry+" hero="+GetUnitName(u)+" skill="+GetAbilityName(logicalSkill)+" physical="+GetAbilityName(B287_GetPhysicalAbilityId(u,logicalSkill)))
call SuijiMode_StartChemicalRageCompat(u)
return true
elseif logicalSkill=='A093' and SuijiMode_HasRandomSkill(u,'A093') then
if OO7(GetHandleId(u),"SuijiScriptedWolfForm") then
return false
endif
if SuijiMode_ScepterRegistryIsActive(u,'A093') then
set duration=40.
endif
set duration=duration*SuijiMode_GetDurationMulticastCount(u,'A093')
call SuijiTest_DebugAll("FORM-START","entry="+entry+" hero="+GetUnitName(u)+" skill="+GetAbilityName(logicalSkill)+" physical="+GetAbilityName(B287_GetPhysicalAbilityId(u,logicalSkill)))
call SuijiMode_StartScriptedWolfForm(u,duration)
return true
endif
return false
endfunction
function SuijiMode_StartRandomTransformByCarrier takes unit u,integer physicalSkill,string entry returns boolean
local real duration=20.
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return false
endif
// These rawcodes exist only as random-OMG command owners.  Dispatch
// them directly so an -omgtest hero replacement cannot lose the cast through a
// stale SuijiDone flag, logical reverse lookup, or recorded ultimate slot.
if physicalSkill=='Y0BE' or physicalSkill=='YE16' then
if OO7(GetHandleId(u),"SuijiScriptedDragonForm") then
return false
endif
call SuijiTest_DebugAll("FORM-CARRIER","entry="+entry+" hero="+GetUnitName(u)+" physical="+GetAbilityName(physicalSkill)+" logical="+GetAbilityName('A03G'))
call SuijiMode_StartScriptedDragonForm(u)
return true
elseif physicalSkill=='Y0FR' then
if OO7(GetHandleId(u),"SuijiChemicalRageActive") then
return false
endif
call SuijiTest_DebugAll("FORM-CARRIER","entry="+entry+" hero="+GetUnitName(u)+" physical="+GetAbilityName(physicalSkill)+" logical="+GetAbilityName('ANcr'))
call SuijiMode_StartChemicalRageCompat(u)
return true
elseif physicalSkill=='Y0BY' or physicalSkill=='YE17' then
if OO7(GetHandleId(u),"SuijiScriptedWolfForm") then
return false
endif
if SuijiMode_ScepterRegistryIsActive(u,'A093') then
set duration=40.
endif
set duration=duration*SuijiMode_GetDurationMulticastCount(u,'A093')
call SuijiTest_DebugAll("FORM-CARRIER","entry="+entry+" hero="+GetUnitName(u)+" physical="+GetAbilityName(physicalSkill)+" logical="+GetAbilityName('A093'))
call SuijiMode_StartScriptedWolfForm(u,duration)
return true
elseif physicalSkill=='Y0HB' then
// CHANNEL owns both state transitions.  CAST/EFFECT from the same click are
// idempotent fallbacks; after a toggle-off they must not reopen the form.
if entry=="CHANNEL" then
call NS7(GetHandleId(u),"SuijiScriptedArcticCarrierClosing",false)
if OO7(GetHandleId(u),"SuijiScriptedArcticBurn") then
call SuijiMode_RestoreScriptedArcticBurn(u)
call NS7(GetHandleId(u),"SuijiScriptedArcticCarrierClosing",true)
else
call SuijiMode_StartScriptedArcticBurn(u)
endif
elseif OO7(GetHandleId(u),"SuijiScriptedArcticCarrierClosing") then
if entry=="EFFECT" then
call NS7(GetHandleId(u),"SuijiScriptedArcticCarrierClosing",false)
endif
elseif OO7(GetHandleId(u),"SuijiScriptedArcticBurn") then
// CAST/EFFECT may discover Multicast after CHANNEL entered the finite form.
call SuijiMode_UpdateScriptedArcticMulticastDuration(u)
else
// Retain CAST/EFFECT as a start fallback if this engine path misses CHANNEL.
call SuijiMode_StartScriptedArcticBurn(u)
endif
call SuijiTest_DebugAll("FORM-CARRIER","entry="+entry+" hero="+GetUnitName(u)+" physical="+GetAbilityName(physicalSkill)+" logical="+GetAbilityName('A2NE'))
return true
endif
return false
endfunction
function SuijiMode_RandomTransformChannel takes nothing returns boolean
local unit u=GetTriggerUnit()
// The 16-platform transform framework takes ownership at the Channel entry,
// before later CAST/EFFECT callbacks.  Do the same in JASS, then let the active
// lifecycle guards absorb the later callbacks without double-applying stats.
call SuijiMode_StartRandomTransformByCarrier(u,GetSpellAbilityId(),"CHANNEL")
set u=null
return false
endfunction
function SuijiMode_RandomTransformCast takes nothing returns boolean
local unit u=GetTriggerUnit()
call SuijiMode_StartRandomTransformByCarrier(u,GetSpellAbilityId(),"CAST")
set u=null
return false
endfunction
function SuijiMode_RestoreAfterSpell takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer physicalSkill=GetSpellAbilityId()
local integer skill=B287_GetSpellAbilityId()
if SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 and (physicalSkill=='Y0BE' or physicalSkill=='YE16' or physicalSkill=='Y0FR' or physicalSkill=='Y0BY' or physicalSkill=='YE17' or physicalSkill=='Y0HB') then
// The carrier lifecycle is fully script-owned.  EFFECT is the last safe
// fallback entry, and must not continue into the generic transform restorer.
call SuijiMode_StartRandomTransformByCarrier(u,physicalSkill,"EFFECT")
set u=null
return false
endif
if SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 and OO7(GetHandleId(u),"SuijiDone") then
// B540 began exact-live scanning every random button 0.20 seconds after every
// cast.  A0WQ has no transform/state button to restore; its only transition is
// the B537 hidden hunger container.  B626 applies the same B549 boundary to
// Nether Strike and Poison Nova: both are ordinary scripted effects with a
// bounded pair-cooldown synchronizer, not temporary command-card states.
// Rebuilding their base/Scepter buttons while that synchronizer is active can
// replace the cooling physical object and can duplicate Poison Nova's waves.
if skill=='A0WQ' or skill=='A0G4' or skill=='A1D8' or skill=='A013' or skill=='A0A6' then
set u=null
return false
endif
if physicalSkill=='Y0CV' or physicalSkill=='Y0DS' then
set u=null
return false
endif
if skill=='A03G' and SuijiMode_HasRandomSkill(u,'A03G') and OO7(GetHandleId(u),"SuijiScriptedDragonForm")==false then
call SuijiMode_StartScriptedDragonForm(u)
set u=null
return false
endif
if physicalSkill=='Y09R' then
call SuijiMode_StartScriptedTerrorbladeForm(u)
set u=null
return false
endif
if physicalSkill=='Y0DE' or physicalSkill=='YE18' or physicalSkill=='Y0FL' then
call SuijiMode_StartScriptedSpiritForm(u,physicalSkill)
set u=null
return false
endif
if skill=='ANcr' and SuijiMode_HasRandomSkill(u,'ANcr') and OO7(GetHandleId(u),"SuijiChemicalRageActive")==false then
call SuijiMode_StartChemicalRageCompat(u)
set u=null
return false
endif
if physicalSkill=='Y0EP' or physicalSkill=='YE1A' then
set u=null
return false
endif
if SuijiMode_IsTransformRestoreSkill(skill) then
call SuijiMode_StartTransformRestore(u,skill)
set u=null
return false
endif
// Ordinary casts do not own a command-card lifecycle transition.  B540's
// generic delayed UpdateLevels pass could level an unrelated fixed clone while
// Warcraft or MemHack was still resolving the cast; B659 crash evidence caught
// that path setting Y03U after another spell.  Keep restoration event-driven:
// transforms above, transient-state controllers, Rubick, Scepter transitions,
// level/revive/enter reconciliation, and charge-family owners remain separate.
endif
set u=null
return false
endfunction
function SuijiMode_RestoreAfterTransformFinish takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer physicalSkill=GetSpellAbilityId()
local integer skill=B287_GetSpellAbilityId()
if physicalSkill!='Y0EP' and physicalSkill!='YE1A' and physicalSkill!='Y0BE' and physicalSkill!='YE16' and physicalSkill!='Y0FR' and physicalSkill!='Y0BY' and physicalSkill!='YE17' and physicalSkill!='Y0HB' and SUIJI_MODE and u!=null and GetUnitTypeId(u)!=0 and OO7(GetHandleId(u),"SuijiDone") and SuijiMode_IsTransformRestoreSkill(skill) and OO7(GetHandleId(u),"SuijiTransformRestoring")==false then
call SuijiMode_StartTransformRestore(u,skill)
endif
set u=null
return false
endfunction
function SuijiMode_RestoreAfterSpellInit takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function SuijiMode_RandomTransformChannel))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function SuijiMode_RandomTransformCast))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiMode_RestoreAfterSpell))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_FINISH)
call TriggerAddCondition(t,Condition(function SuijiMode_RestoreAfterTransformFinish))
set t=null
endfunction
function B1111SyncLogWrite takes nothing returns nothing
local integer syncWriteRow1111=0
if GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER or B1111SyncLogPath=="" then
return
endif
call PreloadGenClear()
call PreloadStart()
call Preload(KK_RELEASE_VERSION+" SYNC diagnostic; recorder=B1111 local_slot="+I2S(GetPlayerId(GetLocalPlayer())+1)+" session="+I2S(B1111SyncLogSession)+" passive_result: -1=invalid_unit_or_skill -2=missing_live_ability 0=active 1=passive")
loop
exitwhen syncWriteRow1111>=B1111SyncLogCount
call Preload(B1111SyncLogRows[syncWriteRow1111])
set syncWriteRow1111=syncWriteRow1111+1
endloop
call PreloadGenEnd(B1111SyncLogPath)
call PreloadGenClear()
endfunction
function B1111SyncLogCapture takes string syncPhase1111 returns nothing
local integer syncPid1111=0
local integer syncTier1111=-3
local integer syncIndex1111=0
local integer syncSignature1111=0
local integer syncFallback1111=-1
local unit syncHero1111=null
local integer syncHandle1111=0
if GetPlayerController(GetLocalPlayer())!=MAP_CONTROL_USER then
return
endif
call B1111SyncLogAppend("SNAPSHOT="+syncPhase1111+" t="+R2S(TimerGetElapsed(W))+" local_month="+I2S(MHTool_GetLocalTime(SYSTEM_TIME_MONTH))+" shared_month="+I2S(CurrentMonth)+" sender="+I2S(B1111SeasonSender)+" received="+I2S(B287_BoolToInt(B1111SeasonReceived))+" done="+I2S(B287_BoolToInt(B1111SeasonDone))+" omg="+I2S(B287_BoolToInt(SUIJI_MODE)))
loop
exitwhen syncTier1111>4
set syncIndex1111=0
set syncSignature1111=0
set syncFallback1111=-1
loop
exitwhen syncIndex1111>=128 or not HaveSavedString(TABLE_Q,'DMGE'+syncTier1111,syncIndex1111)
set syncSignature1111=StringHash(I2S(syncSignature1111)+"|"+LoadStr(TABLE_Q,'DMGE'+syncTier1111,syncIndex1111)+"|"+I2S(LoadInteger(TABLE_Q,'DGGT'+syncTier1111,syncIndex1111)))
if LoadStr(TABLE_Q,'DMGE'+syncTier1111,syncIndex1111)=="SuijiMode_IllusionPassiveAttackFallback" then
set syncFallback1111=syncIndex1111
endif
set syncIndex1111=syncIndex1111+1
endloop
call B1111SyncLogAppend("ATTACK tier="+I2S(syncTier1111)+" count="+I2S(syncIndex1111)+" signature="+I2S(syncSignature1111)+" fallback_index="+I2S(syncFallback1111))
set syncTier1111=syncTier1111+1
endloop
loop
exitwhen syncPid1111>11
set syncHero1111=M7[syncPid1111]
set syncHandle1111=GetHandleId(syncHero1111)
call B1111SyncLogAppend("PLAYER slot="+I2S(syncPid1111+1)+" controller="+I2S(GetHandleId(GetPlayerController(Player(syncPid1111))))+" identity_row="+I2S(B894PlayerIdentityRow[syncPid1111])+" summer="+I2S(B287_BoolToInt(KK2026SummerEggLoaded[syncPid1111]))+"/"+I2S(B287_BoolToInt(KK2026SummerEggOwned[syncPid1111]))+" blessing="+I2S(B287_BoolToInt(KKTianxingBlessingLoaded[syncPid1111]))+"/"+I2S(B287_BoolToInt(KKTianxingBlessingOwned[syncPid1111]))+"/"+I2S(B287_BoolToInt(KKTianxingBlessingApplied[syncPid1111]))+" archive="+I2S(B287_BoolToInt(B836ArcLoaded[syncPid1111]))+"/"+I2S(B287_BoolToInt(B836ArcFault[syncPid1111]))+"/"+I2S(B287_BoolToInt(B836ArcTicket[syncPid1111])))
if syncHero1111!=null and GetUnitTypeId(syncHero1111)!=0 then
call B1111SyncLogAppend("HERO slot="+I2S(syncPid1111+1)+" unit="+I2S(syncHandle1111)+" type="+I2S(GetUnitTypeId(syncHero1111))+" stable="+I2S(SuijiMode_ReadStableHeroIndex(syncHero1111))+" cache="+I2S(LoadInteger(L7,syncHandle1111,StringHash("SuijiStableHeroIndex")))+" point="+I2S(GetUnitPointValue(syncHero1111))+" small="+I2S(OM7(syncHandle1111,"SuijiSmallSkill"))+" ult="+I2S(OM7(syncHandle1111,"SuijiUltSkill"))+" pending="+I2S(OM7(syncHandle1111,"SuijiTavernUltPendingSkill")))
endif
set syncPid1111=syncPid1111+1
endloop
set syncHero1111=null
endfunction
function B1111SyncLogTick takes nothing returns nothing
if B1111SyncLogStep==0 then
set B1111SyncLogStep=1
call TimerStart(B1111SyncLogTimer,25.,false,function B1111SyncLogTick)
call B1111SyncLogCapture("AFTER_5_SECONDS")
call B1111SyncLogWrite()
else
set B1111SyncLogEnabled=false
call PauseTimer(B1111SyncLogTimer)
call DestroyTimer(B1111SyncLogTimer)
set B1111SyncLogTimer=null
call B1111SyncLogCapture("AFTER_30_SECONDS")
call B1111SyncLogWrite()
call DisplayTimedTextToPlayer(Le,0,0,8.,"|cFFFFCC00同步诊断已采集30秒并自动关闭。日志位于游戏目录 1-miao-error 文件夹，文件名含 B1111 sync。|r")
endif
endfunction
function B1111SyncLogCommand takes nothing returns nothing
local player syncCommandPlayer1111=GetTriggerPlayer()
if Le==null or TY7(Le)==false then
call CL7()
endif
if syncCommandPlayer1111!=Le then
call DisplayTimedTextToPlayer(syncCommandPlayer1111,0,0,8.,"|cFFFFCC00只有主机可以切换 -log sync 同步诊断|r")
set syncCommandPlayer1111=null
return
endif
if B1111SyncLogEnabled then
set B1111SyncLogEnabled=false
call PauseTimer(B1111SyncLogTimer)
call DestroyTimer(B1111SyncLogTimer)
set B1111SyncLogTimer=null
call B1111SyncLogCapture("MANUAL_OFF")
call B1111SyncLogWrite()
call DisplayTimedTextToPlayer(syncCommandPlayer1111,0,0,8.,"|cFFFFCC00同步诊断已关闭|r")
else
set B1111SyncLogSession=B1111SyncLogSession+1
set B1111SyncLogStep=0
set B1111SyncLogEnabled=true
// Complete common lifecycle changes before clock reads or local file output.
set B1111SyncLogTimer=CreateTimer()
call TimerStart(B1111SyncLogTimer,5.,false,function B1111SyncLogTick)
// These local buffers never decide a shared handle's creation or lifetime.
set B1111SyncLogCount=0
set B1111SyncLogPassiveCount=0
set B1111SyncLogIllusionCount=0
set B1111SyncLogPath="1-miao-error\\"+I2S(MHTool_GetLocalTime(1))+"-"+I2S(MHTool_GetLocalTime(2))+"-"+I2S(MHTool_GetLocalTime(3))+"_"+I2S(MHTool_GetLocalTime(4))+"-"+I2S(MHTool_GetLocalTime(5))+"-"+I2S(MHTool_GetLocalTime(6))+"_p"+I2S(GetPlayerId(GetLocalPlayer())+1)+" B1111 sync_s"+I2S(B1111SyncLogSession)+".text"
call B1111SyncLogCapture("ON")
call B1111SyncLogWrite()
call DisplayTimedTextToPlayer(syncCommandPlayer1111,0,0,15.,"|cFF00FF00同步诊断开启30秒，开始、5秒和30秒各写一次快照；再次输入 -log sync 可提前关闭。|r")
endif
set syncCommandPlayer1111=null
endfunction
function B1111SyncLogInit takes nothing returns nothing
local trigger syncChatTrigger1111=CreateTrigger()
local integer syncChatPid1111=0
loop
exitwhen syncChatPid1111>11
call TriggerRegisterPlayerChatEvent(syncChatTrigger1111,Player(syncChatPid1111),"-log sync",true)
set syncChatPid1111=syncChatPid1111+1
endloop
call TriggerAddAction(syncChatTrigger1111,function B1111SyncLogCommand)
set syncChatTrigger1111=null
endfunction
function SuijiLog_Command takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer auditCount=0
if Le==null or TY7(Le)==false then
call CL7()
endif
if p!=Le then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00只有主机可以切换 -log 技能诊断日志|r")
set p=null
return
endif
set SUIJI_LOG=false
set SUIJI_CHAKRAM_LOG=false
set SUIJI_AI_FOCUS_LOG=false
set B843GooLog=not B843GooLog
set B908HealingLog=B843GooLog
call B908HealLogReset()
call KKGameTips_SetFastMode(false)
if B843GooLog then
set B843GooLogSession=B843GooLogSession+1
call DisplayTimedTextToPlayer(p,0,0,25.,"|cFF00FF00鼻液输入诊断和治疗检测已开启。治疗按来源/目标/类别每秒合并，显示基础、应恢复、实际、未恢复、恩泽与待转春潮；其它日志仍屏蔽。再次输入 -log 关闭。|r")
else
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00鼻液输入诊断和治疗检测已关闭|r")
endif
set p=null
endfunction
function B1120OrderLogCommand takes nothing returns nothing
local player tracePlayer1120=GetTriggerPlayer()
local integer traceReset1120=0
if Le==null or TY7(Le)==false then
call CL7()
endif
if tracePlayer1120!=Le then
call DisplayTimedTextToPlayer(tracePlayer1120,0,0,8.,"|cFFFFCC00只有主机可以切换 -log order 命令诊断。|r")
set tracePlayer1120=null
return
endif
if B1120OrderLogEnabled and TimerGetElapsed(W)<B1120OrderLogUntil then
set B1120OrderLogEnabled=false
call B1120OrderTraceWrite()
call DisplayTimedTextToPlayer(tracePlayer1120,0,0,8.,"|cFFFFCC00命令诊断已关闭，记录保存在 1-miao-error。|r")
else
set B1120OrderLogEnabled=true
set B1120OrderLogUntil=TimerGetElapsed(W)+30.
set B1120OrderRowCount=0
loop
exitwhen traceReset1120>=12
set B1120TraceCount[traceReset1120]=0
set B1120TraceBurst[traceReset1120]=0
set B1120TraceWindow[traceReset1120]=0.
set traceReset1120=traceReset1120+1
endloop
// Local clock/path data never controls handles, orders, or shared state.
set B1120OrderLogPath="1-miao-error\\"+I2S(MHTool_GetLocalTime(1))+"-"+I2S(MHTool_GetLocalTime(2))+"-"+I2S(MHTool_GetLocalTime(3))+"_"+I2S(MHTool_GetLocalTime(4))+"-"+I2S(MHTool_GetLocalTime(5))+"-"+I2S(MHTool_GetLocalTime(6))+"_"+I2S(MHTool_GetLocalTime(7))+"_p"+I2S(GetPlayerId(GetLocalPlayer())+1)+" "+KK_RELEASE_VERSION+" orders.text"
call B1120OrderTraceWrite()
call DisplayTimedTextToPlayer(tracePlayer1120,0,0,15.,"|cFF00FF00命令诊断开启30秒，最多128条；记录会即时保存到 1-miao-error，再次输入 -log order 可提前关闭。|r")
endif
set tracePlayer1120=null
endfunction
function SuijiLog_CommandInit takes nothing returns nothing
local trigger t=CreateTrigger()
local trigger traceChat1120=CreateTrigger()
local integer i=0
loop
exitwhen i>11
call TriggerRegisterPlayerChatEvent(t,Player(i),"-log",true)
call TriggerRegisterPlayerChatEvent(traceChat1120,Player(i),"-log order",true)
set i=i+1
endloop
call TriggerAddAction(t,function SuijiLog_Command)
call TriggerAddAction(traceChat1120,function B1120OrderLogCommand)
set traceChat1120=null
set t=null
endfunction
function SuijiTest_IsSmallPoolSkill takes integer skill returns boolean
local integer idx=KL4
if SuijiMode_IsRandomPoolExcludedSkill(skill) then
return false
endif
loop
exitwhen idx>SUIJI_POOL_MAX
if HM4[idx]==skill or HN4[idx]==skill or HO4[idx]==skill then
return true
endif
set idx=idx+1
endloop
return false
endfunction
function SuijiTest_IsUltPoolSkill takes integer skill returns boolean
local integer idx=KL4
if SuijiMode_IsRandomPoolExcludedSkill(skill) then
return false
endif
loop
exitwhen idx>SUIJI_POOL_MAX
if HP4[idx]==skill or HQ4[idx]==skill then
return true
endif
set idx=idx+1
endloop
return false
endfunction
function SuijiTest_CommandWord takes string text,integer wanted returns string
local integer length=StringLength(text)
local integer pos=0
local integer begin=0
local integer current=0
loop
exitwhen pos>=length
loop
exitwhen pos>=length
if SubString(text,pos,pos+1)==" " then
set pos=pos+1
else
exitwhen true
endif
endloop
exitwhen pos>=length
set begin=pos
loop
exitwhen pos>=length
if SubString(text,pos,pos+1)==" " then
exitwhen true
endif
set pos=pos+1
endloop
set current=current+1
if current==wanted then
return SubString(text,begin,pos)
endif
endloop
return ""
endfunction
function SuijiTest_GrantFloorOneControl takes player aiOwner returns nothing
local player controller=null
if controller==null or GetPlayerController(controller)!=MAP_CONTROL_USER then
set controller=Le
endif
if aiOwner!=null and controller!=null and aiOwner!=controller then
call SetPlayerAlliance(aiOwner,controller,ALLIANCE_SHARED_CONTROL,true)
call SetPlayerAlliance(aiOwner,controller,ALLIANCE_SHARED_ADVANCED_CONTROL,true)
endif
set controller=null
endfunction
function SuijiTest_ReplaceAIHero takes player p,boolean keepOld returns boolean
local integer pid=0
local integer hero=0
local unit old=null
local unit replacement=null
local player controller=null
local real x=0.
local real y=0.
local real facing=0.
if p==null then
return false
endif
set pid=GetPlayerId(p)
set controller=SuijiTest_PresetController(pid)
if GetPlayerController(p)!=MAP_CONTROL_COMPUTER and p!=controller then
set controller=null
return false
endif
if SuijiTest_HasPreset(pid)==false then
return false
endif
set hero=SuijiTest_PresetHero(pid)
set old=M7[pid]
if old==null or GetUnitTypeId(old)==0 then
if TV7(p) then
set x=GetRectCenterX(HD)
set y=GetRectCenterY(HD)
else
set x=GetRectCenterX(GD)
set y=GetRectCenterY(GD)
endif
set facing=bj_UNIT_FACING
else
set x=GetUnitX(old)
set y=GetUnitY(old)
set facing=GetUnitFacing(old)
if keepOld==false then
call YE7(old)
endif
endif
set M7[pid]=CreateUnit(p,hero,x,y,facing)
set replacement=M7[pid]
call XWE(pid,replacement,hero)
if p==controller then
call SetHeroLevel(replacement,20,false)
endif
// B1022: test hero creation does not grant a free Scepter.
if SUIJI_MODE then
call SuijiMode_ApplyUnit(replacement)
endif
set old=null
set replacement=null
set controller=null
return true
endfunction
