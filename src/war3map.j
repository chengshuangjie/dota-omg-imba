function B964ItemInit takes nothing returns nothing
local integer gear964player=0
loop
exitwhen gear964player>=16
call SetPlayerAbilityAvailable(Player(gear964player),'A7B0',false)
call SetPlayerAbilityAvailable(Player(gear964player),'A7B2',false)
call SetPlayerAbilityAvailable(Player(gear964player),'A4O1',false)
call SetPlayerAbilityAvailable(Player(gear964player),'A4O2',false)
set gear964player=gear964player+1
endloop
