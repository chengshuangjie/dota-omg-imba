endif
set p=A7[i]
set u=M7[GetPlayerId(p)]
if IsPlayerAlly(b1060GetTriggerPlayer,p)and b1060GetTriggerPlayer!=p and u!=null and GetOwningPlayer(u)==p then
set s=" "
