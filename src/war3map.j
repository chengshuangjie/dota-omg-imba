function MorphShift_StopPlayer takes trigger t,unit WX7,integer orderId returns nothing
local integer OB7=GetHandleId(t)
local trigger DHD=OE7(OB7,"Iterate")
local boolean b1018MorphBusy=LoadBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"))
call SaveBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"),true)
// Detach ownership before retiring a timer or touching native ability state.
call NV7(OB7,"Iterate",null)
call NP7(OB7,"LastOrder",orderId)
if DHD!=null then
call NM7(GetHandleId(DHD))
call OZ7(DHD)
endif
if WX7!=null and GetUnitTypeId(WX7)!=0 then
call UnitRemoveAbility(WX7,'A22L')
call UnitRemoveAbility(WX7,'A22T')
endif
call SaveBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"),b1018MorphBusy)
set DHD=null
endfunction
function MorphShift_StartPlayer takes trigger t,unit WX7,integer direction,integer orderId returns nothing
local integer OB7=GetHandleId(t)
local integer DED=0
local trigger DHD
local boolean b1018MorphBusy=LoadBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"))
if WX7==null or GetUnitTypeId(WX7)==0 or not UnitAlive(WX7) then
return
endif
set DED=B287_GetUnitAbilityLevel(WX7,'A0KX')
call SaveBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"),true)
call MorphShift_StopPlayer(t,WX7,0)
if DED>0 then
set DHD=CreateTrigger()
call TriggerRegisterTimerEvent(DHD,1./(5*DED),true)
if direction==1 then
call TriggerAddCondition(DHD,Condition(function DDD))
call UnitAddAbility(WX7,'A22L')
else
call TriggerAddCondition(DHD,Condition(function DFD))
call UnitAddAbility(WX7,'A22T')
endif
call NT7(GetHandleId(DHD),"Hero",WX7)
call NV7(OB7,"Iterate",DHD)
call NP7(OB7,"LastOrder",orderId)
endif
call SaveBoolean(L7,GetHandleId(WX7),StringHash("B1018MorphMutating"),b1018MorphBusy)
set DHD=null
endfunction
function B1018MorphApply takes nothing returns nothing
local timer b1018Timer=GetExpiredTimer()
local unit b1018Hero=LoadUnitHandle(L7,GetHandleId(b1018Timer),0)
local trigger b1018Controller=LoadTriggerHandle(L7,GetHandleId(b1018Timer),1)
local integer b1018Order=LoadInteger(L7,GetHandleId(b1018Controller),StringHash("B1018MorphRequested"))
call RemoveSavedBoolean(L7,GetHandleId(b1018Controller),StringHash("B1018MorphQueued"))
call RemoveSavedInteger(L7,GetHandleId(b1018Controller),StringHash("B1018MorphRequested"))
call FlushChildHashtable(L7,GetHandleId(b1018Timer))
call PauseTimer(b1018Timer)
call DestroyTimer(b1018Timer)
if b1018Controller!=null and IsTriggerEnabled(b1018Controller) and b1018Hero!=null and GetUnitTypeId(b1018Hero)!=0 then
if not UnitAlive(b1018Hero) then
call MorphShift_StopPlayer(b1018Controller,b1018Hero,0)
elseif b1018Order==$D0245 then
call MorphShift_StartPlayer(b1018Controller,b1018Hero,1,b1018Order)
elseif b1018Order==$D0242 then
call MorphShift_StartPlayer(b1018Controller,b1018Hero,0,b1018Order)
else
call MorphShift_StopPlayer(b1018Controller,b1018Hero,b1018Order)
endif
endif
set b1018Hero=null
set b1018Controller=null
set b1018Timer=null
endfunction
function DGD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=GetTriggerUnit()
local integer DID=OM7(OB7,"LastOrder")
local integer b1018Order=GetIssuedOrderId()
local timer b1018Timer=null
if WI7==null or GetUnitTypeId(WI7)==0 or not UnitAlive(WI7) or LoadBoolean(L7,GetHandleId(WI7),StringHash("B1018MorphMutating")) then
set t=null
set WI7=null
return false
endif
if LoadBoolean(L7,OB7,StringHash("B1018MorphQueued")) then
set DID=LoadInteger(L7,OB7,StringHash("B1018MorphRequested"))
endif
if GetIssuedOrderId()==$D0245 then
set b1018Order=$D0245
elseif GetIssuedOrderId()==$D0242 then
set b1018Order=$D0242
elseif GetIssuedOrderId()==$D0246 and DID==$D0245 then
set b1018Order=$D0246
elseif GetIssuedOrderId()==$D0243 and DID==$D0242 then
set b1018Order=$D0243
elseif GetIssuedOrderId()==$D0244 then
if DID==$D0245 then
set b1018Order=$D0246
else
set b1018Order=$D0245
endif
elseif GetIssuedOrderId()==$D0241 then
if DID==$D0242 then
set b1018Order=$D0243
else
set b1018Order=$D0242
endif
else
set t=null
set WI7=null
return false
endif
// Preserve toggle parity while coalescing native mutations outside the order stack.
call SaveInteger(L7,OB7,StringHash("B1018MorphRequested"),b1018Order)
if not LoadBoolean(L7,OB7,StringHash("B1018MorphQueued")) then
call SaveBoolean(L7,OB7,StringHash("B1018MorphQueued"),true)
set b1018Timer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b1018Timer),0,WI7)
call SaveTriggerHandle(L7,GetHandleId(b1018Timer),1,t)
call TimerStart(b1018Timer,0.,false,function B1018MorphApply)
endif
set b1018Timer=null
set t=null
set WI7=null
return false
endfunction
function DKD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local trigger t
local integer I97
local integer BC7=B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0KX')
local integer DID
if BC7==1 then
call SetHeroAgi(WX7,GetHeroAgi(WX7,false)+3,true)
call SetHeroStr(WX7,GetHeroStr(WX7,false)+3,true)
else
call SetHeroAgi(WX7,GetHeroAgi(WX7,false)+1,true)
call SetHeroStr(WX7,GetHeroStr(WX7,false)+1,true)
endif
if BC7==1 then
set t=CreateTrigger()
set I97=GetHandleId(t)
call XF7(WX7,'A0KW')
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function DGD))
call NV7(I97,"Iterate",null)
call NV7(GetHandleId(WX7),"MorphController",t)
else
call SetUnitAbilityLevel(WX7,'A0KW',BC7)
set t=OE7(GetHandleId(WX7),"MorphController")
if t!=null then
set DID=OM7(GetHandleId(t),"LastOrder")
if DID==$D0245 then
call MorphShift_StartPlayer(t,WX7,1,$D0245)
elseif DID==$D0242 then
call MorphShift_StartPlayer(t,WX7,0,$D0242)
endif
endif
endif
set t=null
set WX7=null
endfunction
function DMD takes nothing returns boolean
return B287_GetLearnedSkill()=='A0KX' and IsUnitIllusion(GetTriggerUnit())==false and GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTER
endfunction
