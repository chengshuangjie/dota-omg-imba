function PND takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local item sourceItem=null
local boolean canTrigger=false
if skill!='A0N5' and (B287_GetUnitAbilityLevel(u,'A0N5')>0 or (ISLABIKE(u) and ISPH(u)==false)) and B291_IsRealSpellCast(u,skill) and UL7(skill) and B287_GetUnitAbilityLevel(u,skill)>0 then
set sourceItem=B945SourceItem(u,B287_GetPhysicalAbilityId(u,skill))
set canTrigger=sourceItem==null
endif
set sourceItem=null
set u=null
return canTrigger
endfunction
function POD takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real PPD=GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)
local integer level=B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0N5')
local real VW9
local real PQD
if ISLABIKE(GetTriggerUnit()) then
	set level=4
endif
set PQD=.03+.02*level
set VW9=PPD*PQD
call UnitDamageTarget(GetTriggerUnit(),(b1060GetEnumUnit),VW9,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\ForkedLightning\\ForkedLightningTarget.mdl",(b1060GetEnumUnit),"overhead"))
set b1060GetEnumUnit=null
endfunction
function PRD takes nothing returns boolean
