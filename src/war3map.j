function N8E takes unit S68,unit m5 returns nothing
local real N9E=100*GetUnitState(m5,UNIT_STATE_LIFE)/GetUnitState(m5,UNIT_STATE_MAX_LIFE)
local real NDE=2.5*SuijiMode_GetNethertoxinLevel(S68)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call OV7(S68,"4277")
call TriggerRegisterTimerEvent(t,.35,false)
call TriggerAddCondition(t,Condition(function N7E))
call NT7(OB7,"Source",S68)
if IsUnitType(m5,UNIT_TYPE_HERO)==false then
set NDE=NDE/2
endif
if N9E>80 then
call B_7(S68,R2I(NDE))
elseif N9E>60 then
call B_7(S68,R2I(NDE*2))
elseif N9E>40 then
call B_7(S68,R2I(NDE*2*2))
elseif N9E>20 then
call B_7(S68,R2I(NDE*2*2*2))
else
call B_7(S68,R2I(NDE*2*2*2*2))
endif
set t=null
endfunction
function NEE takes nothing returns boolean
local unit b1060GetAttacker=B1060EventAttacker()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
if (B287_GetSpellAbilityId()=='A09V' or B287_GetSpellAbilityId()=='A4HO') and SuijiMode_GetNethertoxinLevel(b1060GetTriggerUnit)>0 then
call N8E(b1060GetTriggerUnit,GetSpellTargetUnit())
endif
else
if SuijiMode_GetNethertoxinLevel(b1060GetAttacker)>0 and IsUnitIllusion(b1060GetAttacker)==false and IsUnitEnemy(b1060GetAttacker,GetOwningPlayer(b1060GetTriggerUnit)) and OT7(b1060GetAttacker,"4277")==false and ISPH(b1060GetAttacker)==false then
call N8E(b1060GetAttacker,b1060GetTriggerUnit)
endif
endif
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
