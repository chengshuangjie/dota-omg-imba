function Get_Multiple_Skill_Pointer takes unit ZX7,integer skill returns integer
if skill=='A4EX' or skill=='A4EY' or skill=='A4EZ' or skill=='A0LN' or skill=='A4F0' then //白虎跳
return 10000
elseif skill=='A4F3' or skill=='A4F4' or skill=='A4F5' or skill=='A4FU' or skill=='A0LH' or skill=='A2Z9' then  //血魔大
return 20000
elseif skill=='A4BP' or skill=='A4BQ' or skill=='A01I' or skill=='A4BT' or skill=='A4BU' then  //火焰雨
return 30000
elseif skill=='A064' or skill=='A2ZR' or skill=='A2ZQ' or skill=='A2ZO' or skill=='A2ZP' then  //散弹
return 40000
elseif skill=='A4BV' or skill=='A4BW' or skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then  //小鱼跳
return 50000
elseif skill=='A4A1' or skill=='A4A2' or skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then  //黑鸟关
return 60000
elseif skill=='A2ZM' or skill=='A2ZN' or skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then  //毒狗大
return 70000
elseif skill=='A1PH' or skill=='A4L2' or skill=='A4L3' or skill=='A4L4' or skill=='A4L5' or skill=='A4L6' then  //吸魂巫术
return 80000
endif
return 0
endfunction
function Get_Multiple_Skill_Key takes unit ZX7,integer skill returns integer
local integer pointer=Get_Multiple_Skill_Pointer(ZX7,skill)
if pointer>0 then
return 0-GetHandleId(ZX7)-pointer
endif
return GetHandleId(ZX7)
endfunction
function Multiple_Skill_Level takes unit u,integer old_skill,integer new_skill returns integer
local integer level=IMaxBJ(B287_GetUnitAbilityLevel(u,old_skill),B287_GetUnitAbilityLevel(u,new_skill))
local integer pointer=Get_Multiple_Skill_Pointer(u,old_skill)
if pointer==10000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A0LN'),B287_GetUnitAbilityLevel(u,'A4F0')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A4EX'),IMaxBJ(B287_GetUnitAbilityLevel(u,'A4EY'),B287_GetUnitAbilityLevel(u,'A4EZ'))))
elseif pointer==20000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A0LH'),B287_GetUnitAbilityLevel(u,'A2Z9')),IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4F3'),B287_GetUnitAbilityLevel(u,'A4F4')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A4F5'),B287_GetUnitAbilityLevel(u,'A4FU'))))
elseif pointer==30000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4BP'),B287_GetUnitAbilityLevel(u,'A4BQ')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A01I'),IMaxBJ(B287_GetUnitAbilityLevel(u,'A4BT'),B287_GetUnitAbilityLevel(u,'A4BU'))))
elseif pointer==40000 then
return IMaxBJ(B287_GetUnitAbilityLevel(u,'A064'),IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A2ZR'),B287_GetUnitAbilityLevel(u,'A2ZQ')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A2ZO'),B287_GetUnitAbilityLevel(u,'A2ZP'))))
elseif pointer==50000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4BV'),B287_GetUnitAbilityLevel(u,'A4BW')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A1J7'),IMaxBJ(B287_GetUnitAbilityLevel(u,'A4BZ'),B287_GetUnitAbilityLevel(u,'A4C1'))))
elseif pointer==60000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4A1'),B287_GetUnitAbilityLevel(u,'A4A2')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A0OJ'),IMaxBJ(B287_GetUnitAbilityLevel(u,'A2ZY'),B287_GetUnitAbilityLevel(u,'A2ZZ'))))
elseif pointer==70000 then
return IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A2ZM'),B287_GetUnitAbilityLevel(u,'A2ZN')),IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A1SA'),B287_GetUnitAbilityLevel(u,'A2ZU')),IMaxBJ(B287_GetUnitAbilityLevel(u,'A2ZV'),B287_GetUnitAbilityLevel(u,'A2ZW'))))
elseif pointer==80000 then
return IMaxBJ(B287_GetUnitAbilityLevel(u,'A1PH'),IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4L2'),B287_GetUnitAbilityLevel(u,'A4L3')),IMaxBJ(IMaxBJ(B287_GetUnitAbilityLevel(u,'A4L4'),B287_GetUnitAbilityLevel(u,'A4L5')),B287_GetUnitAbilityLevel(u,'A4L6'))))
endif
return level
endfunction
function Multiple_Skill_ButtonSource takes unit u,integer skill returns integer
local integer pointer=Get_Multiple_Skill_Pointer(u,skill)
if pointer==10000 then
return 'A0LN'
elseif pointer==20000 then
return 'A0LH'
elseif pointer==30000 then
return 'A01I'
elseif pointer==40000 then
return 'A064'
elseif pointer==50000 then
return 'A4BV'
elseif pointer==60000 then
return 'A4A1'
elseif pointer==70000 then
return 'A2ZM'
elseif pointer==80000 then
return 'A1PH'
endif
return skill
endfunction
function Multiple_Skill_IsRandomSlotBridge takes unit u,integer bridge returns boolean
local integer h=0
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or bridge==0 then
return false
endif
set h=GetHandleId(u)
// Only the physical ability owned by an OMG random slot is a disposable
// bridge.  Native charge families use their bridge rawcode as the hero's
// learn carrier; hiding it after rank 1 prevents all later skill points.
return OM7(h,"SuijiSmallAbility")==bridge or OM7(h,"SuijiUltAbility")==bridge
endfunction
function Multiple_Skill_SyncButton takes unit u,integer skill returns nothing
local integer source=Multiple_Skill_ButtonSource(u,skill)
local integer OB7=Get_Multiple_Skill_Key(u,skill)
local integer bridge=LoadInteger(MSK,OB7,611)
if u==null or GetUnitTypeId(u)==0 or skill==0 or source==0 or SuijiMode_HasNativeAbility(u,skill)==false then
return
endif
if LoadBoolean(MSK,OB7,610) then
if SuijiMode_HasExactLiveAbility(u,skill) then
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_X,LoadInteger(MSK,OB7,600))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_Y,LoadInteger(MSK,OB7,601))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_X,LoadInteger(MSK,OB7,602))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_Y,LoadInteger(MSK,OB7,603))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY,LoadInteger(MSK,OB7,604))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNHOTKEY,LoadInteger(MSK,OB7,605))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_RESEARCH_HOTKEY,LoadInteger(MSK,OB7,606))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_RESEARCH_BUTTON_X,LoadInteger(MSK,OB7,607))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_RESEARCH_BUTTON_Y,LoadInteger(MSK,OB7,608))
endif
if bridge!=skill and Multiple_Skill_IsRandomSlotBridge(u,bridge) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),bridge,false)
endif
return
endif
if SuijiMode_HasExactLiveAbility(u,skill) and SuijiMode_HasExactLiveAbility(u,source) then
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_X,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_BUTTON_X))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_BUTTON_Y,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_BUTTON_Y))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_X,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNBUTTON_X))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNBUTTON_Y,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNBUTTON_Y))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_HOTKEY,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_HOTKEY))
call MHAbility_SetCustomDataInt(u,skill,ABILITY_DEF_DATA_UNHOTKEY,B287_MHAbility_GetCustomDataInt(u,source,ABILITY_DEF_DATA_UNHOTKEY))
endif
if bridge!=skill and Multiple_Skill_IsRandomSlotBridge(u,bridge) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),bridge,false)
endif
endfunction
function Multiple_Skill_CaptureButton takes unit u,integer familySkill,integer slotSkill returns nothing
local integer pointer=Get_Multiple_Skill_Pointer(u,familySkill)
local integer OB7
local integer N5E
local integer currentSkill
if u==null or GetUnitTypeId(u)==0 or pointer==0 or slotSkill==0 or SuijiMode_HasExactLiveAbility(u,slotSkill)==false then
return
endif
set OB7=Get_Multiple_Skill_Key(u,familySkill)
call SaveInteger(MSK,OB7,600,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_BUTTON_X))
call SaveInteger(MSK,OB7,601,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_BUTTON_Y))
call SaveInteger(MSK,OB7,602,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_UNBUTTON_X))
call SaveInteger(MSK,OB7,603,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_UNBUTTON_Y))
call SaveInteger(MSK,OB7,604,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_HOTKEY))
call SaveInteger(MSK,OB7,605,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_UNHOTKEY))
call SaveInteger(MSK,OB7,606,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_RESEARCH_HOTKEY))
call SaveInteger(MSK,OB7,607,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_X))
call SaveInteger(MSK,OB7,608,MHAbility_GetCustomDataInt(u,slotSkill,ABILITY_DEF_DATA_RESEARCH_BUTTON_Y))
call SaveInteger(MSK,OB7,611,slotSkill)
call SaveBoolean(MSK,OB7,610,true)
set N5E=LoadInteger(MSK,OB7,30)
set currentSkill=LoadInteger(MSK,OB7,N5E)
if currentSkill!=0 and GetUnitAbilityLevel(u,currentSkill)>0 then
call Multiple_Skill_SyncButton(u,currentSkill)
endif
endfunction
function Set_Labike_Multiple_Skill takes unit ZX7,string VH returns nothing
local trigger t=null
local integer OB7=GetHandleId(ZX7)
local integer POINTER
local integer i=1
local integer Multiple_Skill_Number=8 //定义充能技能种类
loop
exitwhen i>Multiple_Skill_Number
set POINTER=0-OB7-10000*i
set t=LoadTriggerHandle(MSK,(POINTER),(0))
if VH=="clear" and t!=null then
call FlushChildHashtable(MSK,(GetHandleId(t)))
call FlushChildHashtable(MSK,(POINTER))
call OZ7(t)
elseif VH=="refresh" and t!=null then
if IsTriggerEnabled(t) then
call SaveInteger(MSK,(POINTER),(500),(1))
endif
endif
set i=i+1
endloop
set t=null
endfunction
function Multiple_Skill_Tip takes integer skill returns string
local string VH1="|n|n|c00fffc01神杖升级：充能点数+1|r"
local string VH2="|n|n|c00fffc01神杖升级：充能点数+2|r"
local string VH3="|n|n|c00fffc01神杖升级：充能点数+1，增加最大距离|r"
if skill=='A2ZU' or skill=='A4F4' then
	return VH2
elseif skill=='A2ZY' or skill=='A4BT' or skill=='A4EY' then
	return VH1
elseif skill=='A4BZ' then
	return VH3
endif
return null
endfunction
function Multiple_Skill_Interval takes integer skill,integer level returns real
if skill=='A4A1' then
    return 25.-3*level
elseif skill=='A4BV' then
    return 24.-4*level
elseif skill=='A0LN' then
    return 24.-3*level
endif
return 0.
endfunction
function Multiple_Skill_ZeroCooldownActions takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(MSK,I97,2)
local integer skill=LoadInteger(MSK,I97,3)
local real cooldown=LoadReal(MSK,I97,4)
local real maxCooldown=LoadReal(MSK,I97,5)
if u!=null and GetUnitTypeId(u)!=0 and cooldown>0. and GetUnitAbilityLevel(u,skill)>0 and LoadInteger(MSK,I97,'rfE1')==LoadInteger(L7,GetHandleId(u),'rfE1') and LoadInteger(MSK,I97,'egE1')==LoadInteger(L7,GetHandleId(u),StringHash("B1094EggSkill"+I2S(skill))) then
// Preserve B541's validated grey cooldown overlay without entering the B540
// command-card enumeration path. Both writes use synchronized charge state.
call YDWESetUnitAbilityState(u,skill,1,cooldown)
call MHAbility_SetCooldownEx(u,skill,cooldown,maxCooldown)
endif
call FlushChildHashtable(MSK,I97)
call OZ7(t)
set u=null
set t=null
return false
endfunction
function Multiple_Skill_StartZeroCooldown takes unit u,integer skill,real cooldown returns nothing
local trigger t
local integer I97
local real maxCooldown
if u==null or GetUnitTypeId(u)==0 or skill==0 or cooldown<=0. then
return
endif
set maxCooldown=LoadReal(MSK,Get_Multiple_Skill_Key(u,skill),51)
if maxCooldown<cooldown then
set maxCooldown=cooldown
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveUnitHandle(MSK,I97,2,u)
call SaveInteger(MSK,I97,3,skill)
call SaveReal(MSK,I97,4,cooldown)
call SaveReal(MSK,I97,5,maxCooldown)
call SaveInteger(MSK,I97,'rfE1',LoadInteger(L7,GetHandleId(u),'rfE1'))
call SaveInteger(MSK,I97,'egE1',LoadInteger(L7,GetHandleId(u),StringHash("B1094EggSkill"+I2S(skill))))
call TriggerRegisterTimerEvent(t,0.,false)
call TriggerAddCondition(t,Condition(function Multiple_Skill_ZeroCooldownActions))
set t=null
endfunction
function Multiple_Skill_Tri takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit u=(LoadUnitHandle(MSK,(I97),(2)))
local integer id=GetUnitTypeId(u)
local integer OB7=(LoadInteger(MSK,(I97),(5)))
local integer MAX=(LoadInteger(MSK,(OB7),(20)))  //读取最大充能次数
local integer MAX_A=(LoadInteger(MSK,(OB7),(21)))  //读取神杖最大充能次数
local integer tmp1
local integer N5E=(LoadInteger(MSK,(OB7),(30)))  //读取当前可用次数
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))  //读取对应技能
local real interval=(LoadReal(MSK,(OB7),(40)))  //读取充能间隔
local real cooldown=(LoadReal(MSK,(OB7),(50)))  //读取充能倒计时
local integer old_skill=(LoadInteger(MSK,(OB7),(70)))   //读取未升级技能
local integer new_skill=(LoadInteger(MSK,(OB7),(80)))   //读取神杖升级技能
local integer skill_level
local integer level=0
local integer nextSkill=0
local real d=0.
local string VH
local string VH2
local boolean b=false
local boolean liveRestored=false
local boolean HaveA=false
if u==null or GetUnitTypeId(u)==0 then
if LoadTriggerHandle(MSK,OB7,0)==t then
call FlushChildHashtable(MSK,OB7)
endif
call FlushChildHashtable(MSK,I97)
call OZ7(t)
set t=null
set u=null
return false
endif
set level=Multiple_Skill_Level(u,old_skill,new_skill)
set d=ReduceUnitAbilityCoolDownReal(u)
set HaveA=SuijiMode_HasAghanimState(u)
if SuijiMode_ScepterRegistryIsRegistered(u,old_skill) then
set HaveA=SuijiMode_ScepterRegistryIsActive(u,old_skill)
endif
if id=='E02X' or id=='Z02X' then //如果是拉比克则增加偏移量，重新读取技能等级
set level=(LoadInteger(MSK,(OB7),(90)))
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000当前偏移量为|r"+I2S(OB7)+" 可用次数为"+I2S(N5E)+" 等级"+I2S(level))
endif
if GetUnitAbilityLevel(u,skill)<=0 then
if SuijiMode_EnsureExactLiveAbilityLevel(u,skill,level,true) then
set liveRestored=true
call Multiple_Skill_SyncButton(u,skill)
call Reset_Skill_range(u)
endif
endif
if liveRestored and N5E==0 then
call Multiple_Skill_StartZeroCooldown(u,skill,cooldown)
endif
//扔掉A时要更换充能技能，因为所有有神杖效果的技能，没有神杖时次数只有1次，可以通过当前次数判断
if HaveA==false and MAX_A>0 and N5E>1 then //如果当前技能可用次数大于1，会重置为可用次数为1次的技能(等于1或等于0都没事)
set nextSkill=LoadInteger(MSK,OB7,1)
if SuijiMode_EnsureExactLiveAbilityLevel(u,nextSkill,level,true) then
call UnitRemoveAbility(u,skill)
set N5E=1
call SaveInteger(MSK,(OB7),(30),(N5E)) //保存可用次数
set skill=nextSkill
call Multiple_Skill_SyncButton(u,skill)
call Reset_Skill_range(u)
endif
endif
//同步当前技能等级
set skill_level=GetUnitAbilityLevel(u,skill)
if skill_level>0 then
if skill_level!=level then
if SuijiMode_SetExactLiveAbilityLevel(u,skill,level) then
call Reset_Skill_range(u)
endif
endif
//判断是否增加技能提示，只增加没有神杖并且可用次数为1的技能提示，值1为修改过，否则为未修改
if HaveA==false and MAX_A>0 and N5E==1 and (LoadInteger(MSK,(OB7),(100+level)))!=1 then
set VH=LoadStr(MSK,(skill),(100+level)) //如果表里为空再从物编读取
if VH==null then
set VH=YDWEGetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP)
endif
set VH2=Multiple_Skill_Tip(skill)
call YDWESetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP,VH+VH2)
call SaveStr(MSK,(skill),(100+level),(VH))  //记录相应等级原本的技能提示
call SaveInteger(MSK,(OB7),(100+level),(1)) //记录相应等级技能已修改
endif
//判断是否还原技能提示，只还原有神杖并且可用次数为1的技能提示，值1为修改过，否则为未修改
if HaveA and MAX_A>0 and N5E==1 and (LoadInteger(MSK,(OB7),(100+level)))==1 then
set VH=LoadStr(MSK,(skill),(100+level))
set VH2=Multiple_Skill_Tip(skill)
if GetLocalPlayer()==GetOwningPlayer(u) then //其他玩家的提示不还原
set VH2=""
endif
call YDWESetUnitAbilityDataString(u,skill,level,ABILITY_DATA_UBERTIP,VH+VH2)
call SaveInteger(MSK,(OB7),(100+level),(0)) //记录相应等级技能未修改
endif
endif
//判断是否有神杖并设置当前最大充能次数
if HaveA and (MAX_A>0) then //如果有神杖并且神杖充能次数大于0
set tmp1=MAX_A
else
set tmp1=MAX
endif
if LoadInteger(MSK,(OB7),(500))==1 then //是否刷新技能
call SaveInteger(MSK,(OB7),(500),(0))
set b=true
endif
if PT4 then    //是否WTF模式
set b=true
endif
if N5E<tmp1 then  //可用次数小于当前最大充能次数，倒计时就每次减0.5
    set cooldown=cooldown-0.5
    if b then
    set cooldown=0
    endif    
    call SaveReal(MSK,(OB7),(50),(cooldown))
	if cooldown<=0 then      //当倒计时小于等于0的时候
		//如果充能间隔interval为1，表示非固定充能间隔
		if interval==1 then
			set interval=Multiple_Skill_Interval(old_skill,level)
		endif
		if d>0 then
			set cooldown=interval*d
		else
			set cooldown=interval
		endif
		call SaveReal(MSK,(OB7),(50),(cooldown)) //充能倒计时重新计算
		call SaveReal(MSK,(OB7),(51),(cooldown)) //记录本轮完整充能时间，用于零充能按钮的冷却转圈
		set nextSkill=LoadInteger(MSK,OB7,N5E+1)
		if SuijiMode_EnsureExactLiveAbilityLevel(u,nextSkill,level,true) then
			call UnitRemoveAbility(u,skill)
			set N5E=N5E+1
			call SaveInteger(MSK,(OB7),(30),(N5E)) //保存可用次数
			set skill=nextSkill
			call Multiple_Skill_SyncButton(u,skill)
			call Reset_Skill_range(u)
		else
			// Preserve the old live button/state and retry this completed recharge
			// on the next bounded controller tick.
			call SaveReal(MSK,(OB7),(50),0.)
		endif
	endif
endif
set t=null
set u=null
return false
endfunction
//充能技能(用于可变身单位会出BUG)
//单位，最大充能次数，神杖最大充能次数，充能时间(非固定时间填1)，未升级技能，神杖升级技能
function Multiple_Skill takes unit u,integer MAX,integer MAX_A,real interval,integer old_skill,integer new_skill returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer OB7=Get_Multiple_Skill_Key(u,old_skill)
local integer N5E
local real cooldown=interval
local integer skill  //读取充能技能整数
local integer id=GetUnitTypeId(u)
local real d=ReduceUnitAbilityCoolDownReal(u)
local integer sourceKey=GetHandleId(u)
local integer copyIndex=0
local integer copySkill=0
local boolean HaveA=SuijiMode_HasAghanimState(u)
if SuijiMode_ScepterRegistryIsRegistered(u,old_skill) then
set HaveA=SuijiMode_ScepterRegistryIsActive(u,old_skill)
endif
loop
exitwhen copyIndex>6
set copySkill=LoadInteger(MSK,sourceKey,copyIndex)
if copySkill!=0 then
call SaveInteger(MSK,OB7,copyIndex,copySkill)
endif
set copyIndex=copyIndex+1
endloop
if HaveA and (MAX_A>0) then //如果有神杖并且神杖充能次数大于0
set N5E=MAX_A
else
set N5E=MAX
endif
if interval==1. then //如果充能时间为非固定时间，设置充能倒计时
if id=='E02X' or id=='Z02X' then
set cooldown=Multiple_Skill_Interval(old_skill,(LoadInteger(MSK,(OB7),(90))))
else
set cooldown=Multiple_Skill_Interval(old_skill,1)
endif
endif
if d>0 then
set cooldown=cooldown*d
endif
set skill=(LoadInteger(MSK,(OB7),(N5E)))
if SuijiMode_EnsureExactLiveAbilityLevel(u,skill,Multiple_Skill_Level(u,old_skill,new_skill),true) then
call Multiple_Skill_CaptureButton(u,old_skill,B287_GetPhysicalAbilityId(u,old_skill))
call Multiple_Skill_SyncButton(u,skill)
call Reset_Skill_range(u) //重置施法距离
else
// Keep the charge controller alive.  The immediate/0.5 second ticks retry the
// exact live ability before performing any level, button, or cooldown writes.
call Multiple_Skill_CaptureButton(u,old_skill,B287_GetPhysicalAbilityId(u,old_skill))
endif
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,0.5,true)  //每0.5秒判断一次
call TriggerAddCondition(t,Condition(function Multiple_Skill_Tri))
call SaveUnitHandle(MSK,(I97),(2),(u))   //保存触发单位
call SaveInteger(MSK,(I97),(5),(OB7))   //保存触发单位句柄
call SaveInteger(MSK,(OB7),(20),(MAX))   //保存最大充能次数
call SaveInteger(MSK,(OB7),(21),(MAX_A))   //保存神杖最大充能次数
call SaveInteger(MSK,(OB7),(30),(N5E))   //保存当前可用次数
call SaveReal(MSK,(OB7),(40),(interval))   //保存充能间隔
call SaveReal(MSK,(OB7),(50),(cooldown))   //保存充能倒计时
call SaveReal(MSK,(OB7),(51),(cooldown))   //保存本轮完整充能时间
call SaveInteger(MSK,(OB7),(70),(old_skill))   //保存未升级技能
call SaveInteger(MSK,(OB7),(80),(new_skill))   //保存神杖升级技能
call SaveBoolean(MSK,(OB7),(1),(false)) //未修改可用次数为1的提示
call SaveTriggerHandle(MSK,(OB7),(0),(t))
set u=null
set t=null
endfunction
//
function QW8 takes nothing returns boolean
return(IsUnitType(GetSoldUnit(),UNIT_TYPE_HERO))!=null
endfunction
function QX8 takes nothing returns nothing
if((QA4!=null)and(IsTriggerEnabled(QA4)))then
if((GetOwningPlayer(GetSoldUnit())==QT4)and(QV4!=null))then
return
elseif((GetOwningPlayer(GetSoldUnit())==QU4)and(QW4!=null))then
return
endif
endif
call US7(GetOwningPlayer(GetSoldUnit()))
endfunction
function QY8 takes nothing returns boolean
local integer QZ8
local integer O5=1
loop
exitwhen O5>$B
if O5==6 then
set O5=7
endif
set QZ8=0
if(IsPlayerInForce(Player(O5),QX4))then
set CU4[O5]=CU4[O5]+(I2R(Y74[48+O5])/8)
set QZ8=R2I(CU4[O5])
if QZ8<0 then
set QZ8=0
endif
set CU4[O5]=CU4[O5]-I2R(QZ8)
endif
if(Y4)then
set QZ8=QZ8+2
else
set QZ8=QZ8+1
endif
call SetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(O5),PLAYER_STATE_RESOURCE_GOLD)+QZ8)
set O5=O5+1
endloop
return false
endfunction
