function Remove_Append_skill takes unit u,integer skill  returns nothing
if skill=='A21F' or skill=='A21G' then
    call SaveInteger(L7,(GetHandleId(u)),(704),(-1))
call UnitRemoveAbility(u,'A21H')
call UnitRemoveAbility(u,'ZPNK')
call UnitRemoveAbility(u,'ZPNL')
    call B287_UnitRemoveAbility(u,'A21F')
    call B287_UnitRemoveAbility(u,'A21G')
elseif skill=='A11N' then
call UnitRemoveAbility(u,'A13D')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1A8' then
call UnitRemoveAbility(u,'A2NI')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1TA' then
call SuijiMode_TetherCleanup(LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiTetherController")),"remove-skill")
call UnitRemoveAbility(u,'A1TU')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1NI' then
call UnitRemoveAbility(u,'A1NH')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1RJ' then
call UnitRemoveAbility(u,'A20N')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1YX' then
call UnitRemoveAbility(u,'A1Z2')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1YY' then
call UnitRemoveAbility(u,'A1Z3')
call UnitRemoveAbility(u,'A205')
    call UnitRemoveAbility(u,skill)
elseif skill=='A0G8' then
call UnitRemoveAbility(u,'A0GC')
    call UnitRemoveAbility(u,skill)
elseif skill=='A07U' or skill=='A2SR' then
call UnitRemoveAbility(u,'A24E')
    call B287_UnitRemoveAbility(u,'A07U')
    call B287_UnitRemoveAbility(u,'A2SR')
elseif skill=='A0RP' then
call UnitRemoveAbility(u,'A0RT')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4KJ',false)
call UnitRemoveAbility(u,'A4KJ')
    call UnitRemoveAbility(u,skill)
elseif skill=='A0RO' then
    call UnitRemoveAbility(u,skill)
call TemplarAssassin_UpdatePsiBladesRange(u)
elseif skill=='A0H9' or skill=='A4B6' then
call UnitRemoveAbility(u,'A0HA')
    call UnitRemoveAbility(u,skill)
elseif skill=='A0S9' then
call UnitRemoveAbility(u,'A0SA')
    call UnitRemoveAbility(u,skill)
elseif skill=='A085' then
call UnitRemoveAbility(u,'A121')
    call UnitRemoveAbility(u,skill)
elseif skill=='A0AK' or skill=='A1FY' then
call UnitRemoveAbility(u,'A1WF')
call UnitRemoveAbility(u,'A02T')
    call B287_UnitRemoveAbility(u,'A0AK')
    call B287_UnitRemoveAbility(u,'A1FY')
elseif skill=='A1S4' then
call UnitRemoveAbility(u,'A1S9')
    call UnitRemoveAbility(u,skill)
elseif skill=='A1S7' then
call UnitRemoveAbility(u,'A4HF')
call UnitRemoveAbility(u,'ZT01')
call UnitRemoveAbility(u,'ZT02')
call RemoveSavedInteger(L7,GetHandleId(u),StringHash("SuijiTuskSnowballActive"))
call RemoveSavedInteger(L7,GetHandleId(u),StringHash("SuijiTuskSnowballReleaseButton"))
    call B287_UnitRemoveAbility(u,skill)
elseif skill=='A1MI' or skill=='A2SE' then
call UnitRemoveAbility(u,'A1MN')
    call B287_UnitRemoveAbility(u,'A1MI')
    call B287_UnitRemoveAbility(u,'A2SE')
elseif skill=='A06K' or skill=='X06K' then
    call UnitRemoveAbility(u,skill)  //腐烂
elseif skill=='A0NE' then
    call UnitRemoveAbility(u,skill) //关闭巫毒恢复术
elseif skill=='A0MP' then
    call UnitRemoveAbility(u,skill) //关闭魔法护盾
elseif skill=='A0R0' then
call UnitRemoveAbility(u,'A2MB')
    call UnitRemoveAbility(u,skill)
elseif skill=='A2E5' or skill=='A2SH' then
    call SaveInteger(L7,(GetHandleId(u)),(704),(-1))
    call UnitRemoveAbility(u,'A2FX') //收回飞锯C
    call UnitRemoveAbility(u,'ZT07')
    call UnitRemoveAbility(u,'ZT08')
    call UnitRemoveAbility(u,'A2E5')
    call UnitRemoveAbility(u,'A2SH')
elseif skill=='A2SI' then
    call SaveInteger(L7,(GetHandleId(u)),(704),(-1))
    call UnitRemoveAbility(u,'A2E6') //收回飞锯F
    call UnitRemoveAbility(u,skill)
elseif skill=='A05G' then
    call UnitRemoveAbility(u,skill) //剑刃风暴
elseif skill=='A11N' then
call UnitRemoveAbility(u,'A13D')
    call UnitRemoveAbility(u,skill)
endif
endfunction
function ZC_Labike_Multiple_Skill takes unit ZX7,integer skill returns nothing
local integer OB7=Get_Multiple_Skill_Key(ZX7,skill)
if skill=='A4EX' or skill=='A4EY' or skill=='A4EZ' then //白虎跳
call SaveInteger(MSK,(OB7),(0),('A4EX'))
call SaveInteger(MSK,(OB7),(1),('A4EY'))
call SaveInteger(MSK,(OB7),(2),('A4EZ'))
call Multiple_Skill(ZX7,1,2,1.,'A0LN','A4F0')
elseif skill=='A4F3' or skill=='A4F4' or skill=='A4F5' or skill=='A4FU' then //血魔大
call SaveInteger(MSK,(OB7),(0),('A4F3'))
call SaveInteger(MSK,(OB7),(1),('A4F4'))
call SaveInteger(MSK,(OB7),(2),('A4F5'))
call SaveInteger(MSK,(OB7),(3),('A4FU'))
call Multiple_Skill(ZX7,1,3,50.,'A0LH','A2Z9')
elseif skill=='A01I' or skill=='A4BT' or skill=='A4BU' then //火焰雨
call SaveInteger(MSK,(OB7),(0),('A01I'))
call SaveInteger(MSK,(OB7),(1),('A4BT'))
call SaveInteger(MSK,(OB7),(2),('A4BU'))
call Multiple_Skill(ZX7,1,2,14.,'A4BP','A4BQ')
elseif skill=='A2ZR' or skill=='A2ZQ' or skill=='A2ZO' or skill=='A2ZP' then //散弹
call SaveInteger(MSK,(OB7),(0),('A2ZR'))
call SaveInteger(MSK,(OB7),(1),('A2ZQ'))
call SaveInteger(MSK,(OB7),(2),('A2ZO'))
call SaveInteger(MSK,(OB7),(3),('A2ZP'))
call Multiple_Skill(ZX7,3,0,35.,'A064',0)
elseif skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then //小鱼跳
call SaveInteger(MSK,(OB7),(0),('A1J7'))
call SaveInteger(MSK,(OB7),(1),('A4BZ'))
call SaveInteger(MSK,(OB7),(2),('A4C1'))
call Multiple_Skill(ZX7,1,2,1.,'A4BV','A4BW')
elseif skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then //黑鸟关
call SaveInteger(MSK,(OB7),(0),('A0OJ'))
call SaveInteger(MSK,(OB7),(1),('A2ZY'))
call SaveInteger(MSK,(OB7),(2),('A2ZZ'))
call Multiple_Skill(ZX7,1,2,1.,'A4A1','A4A2')
elseif skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then //毒狗大
call SaveInteger(MSK,(OB7),(0),('A1SA'))
call SaveInteger(MSK,(OB7),(1),('A2ZU'))
call SaveInteger(MSK,(OB7),(2),('A2ZV'))
call SaveInteger(MSK,(OB7),(3),('A2ZW'))
call Multiple_Skill(ZX7,1,3,50.,'A2ZM','A2ZN')
elseif skill=='A4L2' or skill=='A4L3' or skill=='A4L4' or skill=='A4L5' or skill=='A4L6' then //吸魂巫术
call SaveInteger(MSK,(OB7),(0),('A4L2'))
call SaveInteger(MSK,(OB7),(1),('A4L3'))
call SaveInteger(MSK,(OB7),(2),('A4L4'))
call SaveInteger(MSK,(OB7),(3),('A4L5'))
call SaveInteger(MSK,(OB7),(4),('A4L6'))
call Multiple_Skill(ZX7,4,0,30.,'A1PH',0)
endif
endfunction
//大概是偷取的技能释放后，在取消该技能时 离上次释放时间超过15秒，或者上一次没有释放该技能，才会删除该技能，防止技能积累过多
function VSG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer VTG=(LoadInteger(L7,(I97),(704)))
local integer VUG=(LoadInteger(L7,(I97),(713)))
if SuijiMode_RubickIsCurrentStolenSkill(ZX7,VTG) or SuijiMode_RubickHasIndependentSkill(ZX7,VTG) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif VTG==(LoadInteger(L7,(GetHandleId(ZX7)),(704)))then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif GetTriggerEvalCount(t)>($F-VUG) then
call B287_UnitRemoveAbility(ZX7,VTG)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
return false
endfunction
function VVG takes unit ZX7,integer VTG,real ZV8 returns nothing
local trigger t
local integer I97
if ZX7==null or GetUnitTypeId(ZX7)==0 or Get_Multiple_Skill_Pointer(ZX7,VTG)>0 or SuijiMode_RubickHasIndependentSkill(ZX7,VTG) then
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddCondition(t,Condition(function VSG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveInteger(L7,(I97),(704),(VTG))
//call SaveInteger(L7,(GetHandleId(ZX7)),(704),(-1))
call SaveInteger(L7,(I97),(713),(R2I((TimerGetElapsed(W))-ZV8)))
set t=null
endfunction
function SuijiMode_RubickRestoreStolenSkillAfterCast takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,2)
local integer skill=LoadInteger(L7,I97,3)
local integer level=LoadInteger(L7,I97,4)
local integer attempt=LoadInteger(L7,I97,5)
local integer pair=-1
local integer physical=0
local real cooldown=0.
local boolean pending=LoadBoolean(L7,I97,6)
local boolean retry=false
if u!=null and GetUnitTypeId(u)!=0 and UnitAlive(u) and SuijiMode_RubickIsCurrentStolenSkill(u,skill) and SuijiMode_RubickHasIndependentSkill(u,skill)==false then
set pair=RX5(skill)
if (pair<0 or (B287_GetUnitAbilityLevel(u,YTI[pair])<=0 and B287_GetUnitAbilityLevel(u,YRI[pair])<=0)) and B287_IsStateReplaceBaseSkill(skill)==false and SuijiMode_IsTransientStateButton(skill)==false and (B287_GetUnitAbilityLevel(u,skill)<=0 or pending) then
set physical=SuijiMode_GetGrantSkill(skill)
if SuijiMode_EnsureExactLiveAbility(u,physical,true) then
if SuijiMode_SetExactLiveAbilityLevel(u,physical,level)==false then
set retry=true
call SaveBoolean(L7,I97,6,true)
else
call SuijiMode_InitCopiedSkill(u,skill,level)
set physical=B287_GetPhysicalAbilityId(u,skill)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),physical,true)
set cooldown=SuijiMode_GetCooldownMaxAtLevel(u,physical,level)
if cooldown>0. then
// The EX/JAPI state is the synchronized gameplay cooldown.  MemHack below
// mirrors the command-card panel only when this client's live object is safe.
call YDWESetUnitAbilityState(u,physical,1,cooldown)
endif
if SuijiMode_HasExactLiveAbility(u,physical) then
call SuijiMode_RubickApplyStolenButton(u,skill,physical)
if cooldown>0. then
call MHAbility_SetCooldown(u,physical,cooldown)
endif
endif
call RemoveSavedBoolean(L7,I97,6)
endif
else
set retry=true
call SaveBoolean(L7,I97,6,true)
endif
endif
endif
if retry and attempt<5 then
call SaveInteger(L7,I97,5,attempt+1)
call TimerStart(t,.10,false,function SuijiMode_RubickRestoreStolenSkillAfterCast)
set u=null
set t=null
return
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function SuijiMode_RubickScheduleStolenSkillRestore takes unit u,integer skill,integer level returns nothing
local timer t=null
local integer I97=0
if SuijiMode_RubickIsCurrentStolenSkill(u,skill)==false or SuijiMode_RubickHasIndependentSkill(u,skill) or level<=0 or Get_Multiple_Skill_Pointer(u,skill)>0 then
return
endif
set t=CreateTimer()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,2,u)
call SaveInteger(L7,I97,3,skill)
call SaveInteger(L7,I97,4,level)
call TimerStart(t,.10,false,function SuijiMode_RubickRestoreStolenSkillAfterCast)
set t=null
endfunction
function Is_Switch_Skill takes integer skill returns boolean
if skill=='A21F' or skill=='A21G' or skill=='A2E5' or skill=='A2SH' or skill=='A2SI' or skill=='A1YY' then
    return true
endif
return false
endfunction
function SuijiMode_NormalizeRecordedSkill takes integer recordedSkill returns integer
local integer i=KL4
local integer logical=0
loop
exitwhen i>SUIJI_POOL_MAX
set logical=HM4[i]
if logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logical)==recordedSkill then
return logical
endif
set logical=HN4[i]
if logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logical)==recordedSkill then
return logical
endif
set logical=HO4[i]
if logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logical)==recordedSkill then
return logical
endif
set logical=HP4[i]
if logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logical)==recordedSkill then
return logical
endif
set logical=HQ4[i]
if logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logical)==recordedSkill then
return logical
endif
set i=i+1
endloop
return recordedSkill
endfunction
function SuijiMode_RubickReleaseStolenSkill takes unit rubickReleaseUnit,integer rubickReleaseSkill,integer rubickReleaseFamily returns nothing
local trigger rubickChargeTrigger=null
local integer rubickChargeIndex=0
if rubickReleaseUnit==null or GetUnitTypeId(rubickReleaseUnit)==0 or SuijiMode_RubickHasIndependentSkill(rubickReleaseUnit,rubickReleaseSkill) then
return
endif
if Get_Multiple_Skill_Pointer(rubickReleaseUnit,rubickReleaseSkill)>0 then
set rubickChargeTrigger=LoadTriggerHandle(MSK,rubickReleaseFamily,0)
if rubickChargeTrigger!=null then
loop
exitwhen rubickChargeIndex>6
call UnitRemoveAbility(rubickReleaseUnit,LoadInteger(MSK,rubickReleaseFamily,rubickChargeIndex))
set rubickChargeIndex=rubickChargeIndex+1
endloop
call DisableTrigger(rubickChargeTrigger)
endif
else
call Remove_Append_skill(rubickReleaseUnit,rubickReleaseSkill)
call B287_SetUnitAbilityAvailable(rubickReleaseUnit,rubickReleaseSkill,false)
endif
set rubickChargeTrigger=null
endfunction
function VWG takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer OB7=(LoadInteger(L7,(I97),(66)))
local integer VTG=(LoadInteger(L7,(I97),(704)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
local real ZV8=(LoadReal(L7,(I97),(411)))
local unit IH7
local integer P15
local trigger t2=LoadTriggerHandle(MSK,(OB7),(0))
local integer tmp1=0
local integer tmp2=0
local integer rubickCurrentLogical=SuijiMode_RubickCanonicalRequestedSkill(VTG)
local integer rubickRequestedLogical=0
if b1060GetTriggerEventId!=EVENT_UNIT_SPELL_EFFECT and b1060GetTriggerEventId!=EVENT_WIDGET_DEATH then
if WF8==0 then
call SaveInteger(L7,(I97),(34),(1))
call DisplayTimedTextToPlayer(GetOwningPlayer(ZX7),0,0,10,"|c00ff0303"+GetObjectName('n0LW')+"|r")
else
call SuijiMode_RubickReleaseStolenSkill(ZX7,VTG,OB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SuijiMode_RubickClearCurrentStolenSkill(ZX7,VTG)
call VVG(ZX7,VTG,ZV8)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if b1060B287_GetSpellAbilityId=='A27H' or b1060B287_GetSpellAbilityId=='A2TZ' then
set IH7=b1060GetSpellTargetUnit
set P15=(LoadInteger(L7,(GetHandleId(IH7)),(705)))
if P15==null then
set t=null
set t2=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set rubickRequestedLogical=SuijiMode_RubickCanonicalRequestedSkill(P15)
// Re-stealing a current slot refreshes that slot in place.  The matching old
// controller hands ownership to VXG without removing the shared ability.  The
// other current slot stays present now and becomes the next replacement owner.
if rubickRequestedLogical==rubickCurrentLogical then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set t2=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
elseif SuijiMode_RubickIsCurrentStolenSkill(ZX7,rubickRequestedLogical) then
call SaveInteger(L7,(I97),(88),(0))
set t=null
set t2=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if RX5(VTG)!=-1 then  
set tmp1=YRI[RX5(VTG)]
endif
if RX5(P15)!=-1 then  
set tmp2=YRI[RX5(P15)]
endif
//如果释放了两次斗转星移；如果两次偷取技能相同；如果两次神杖升级技能相同；如果两次充能技能相同；如果两次都是持续性开关技能
//如果释放了两次斗转星移；如果两次偷取技能相同；如果两次神杖升级技能相同；如果两次充能技能相同；如果两次都是持续性开关技能
if (LoadInteger(L7,(I97),(88)))==0  or VTG==P15 or (tmp1==tmp2 and (tmp1>0 or tmp2>0) ) or (Get_Multiple_Skill_Pointer(ZX7,VTG)>0 and Get_Multiple_Skill_Pointer(ZX7,VTG)==Get_Multiple_Skill_Pointer(ZX7,P15)) or (Is_Switch_Skill(VTG) and Is_Switch_Skill(P15) ) then
call SuijiMode_RubickReleaseStolenSkill(ZX7,VTG,OB7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SuijiMode_RubickClearCurrentStolenSkill(ZX7,VTG)
call VVG(ZX7,VTG,ZV8)
else
call SaveInteger(L7,(I97),(88),(0))
endif
elseif b1060B287_GetSpellAbilityId==VTG and Get_Multiple_Skill_Pointer(ZX7,VTG)==0 then
call SaveReal(L7,(I97),(411),(((TimerGetElapsed(W)))*1.))
endif
// elseif GetTriggerEventId()==EVENT_WIDGET_DEATH then
// call VRG(ZX7)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),VTG,false)
// call FlushChildHashtable(L7,(I97))
// call OZ7(t)
// call VVG(ZX7,VTG,ZV8)
// elseif GetTriggerEventId()==EVENT_WIDGET_DEATH then
// call VRG(ZX7)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),VTG,false)
// call FlushChildHashtable(L7,(I97))
// call OZ7(t)
// call VVG(ZX7,VTG,ZV8)
// elseif GetTriggerEventId()==EVENT_WIDGET_DEATH then
// call VRG(ZX7)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),VTG,false)
// call FlushChildHashtable(L7,(I97))
// call OZ7(t)
// call VVG(ZX7,VTG,ZV8)
endif
set t=null
set t2=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
//斗转星移技能
function VXG takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer VTG=(LoadInteger(L7,(I97),(704))) //偷取的技能
local integer BC7=(LoadInteger(L7,(I97),(5)))
local real VYG=60*(5+IMaxBJ(B287_GetUnitAbilityLevel(ZX7,'A27H'),B287_GetUnitAbilityLevel(ZX7,'A2TZ')))
local integer OB7=Get_Multiple_Skill_Key(ZX7,VTG)
local integer VAG=GetHandleId(IH7)
local integer pointer=Get_Multiple_Skill_Pointer(ZX7,VTG)
local trigger chargeTri=null
local integer stolenPhysicalSkill=0
local boolean rubickIndependent=SuijiMode_RubickHasIndependentSkill(ZX7,VTG)
if rubickIndependent==false then
if VTG=='A1IN' and LoadTriggerHandle(ExtraHT, 'A1IN', GetHandleId(ZX7))==null then
    call RBE(ZX7)
endif
if(OM7(VAG,"WexLevel"))>0 then
call NP7(OB7,"WexLevel",(OM7(VAG,"WexLevel")))
endif
if(OM7(VAG,"QuasLevel"))>0 then
call NP7(OB7,"QuasLevel",(OM7(VAG,"QuasLevel")))
endif
if(OM7(VAG,"ExortLevel"))>0 then
call NP7(OB7,"ExortLevel",(OM7(VAG,"ExortLevel")))
call SET_TH_TIP()
endif
if(LoadInteger(L7,(GetHandleId(IH7)),(710)))>0 then
call SaveInteger(L7,(OB7),(710),((LoadInteger(L7,(GetHandleId(IH7)),(710)))))
endif
endif
call Y17(Y64,GetUnitX(ZX7),GetUnitY(ZX7))
call YW7(GetObjectName(VTG),3.5,ZX7,.024,$AA,0,$FF,$D8)
call SaveInteger(L7,(OB7),(704),(VTG))
call SuijiMode_RubickRecordCurrentStolenSkill(ZX7,VTG,BC7)
if rubickIndependent==false then
if pointer>0 then  //如果偷取了充能技能
if not HaveSavedHandle(MSK,OB7,0) then
call SaveInteger(MSK,(OB7),(90),(BC7)) //保存偷取的技能等级
call ZC_Labike_Multiple_Skill(ZX7,VTG)              //创建拉比克充能触发
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000创建充能计时器|r")
else  //已有充能计时器则返回
call SaveInteger(MSK,(OB7),(90),(BC7))
set chargeTri=LoadTriggerHandle(MSK,OB7,0)
if chargeTri==null or OZ7_IsQueued(chargeTri) then
if chargeTri!=null then
call FlushChildHashtable(MSK,(GetHandleId(chargeTri)))
endif
call FlushChildHashtable(MSK,(OB7))
call SaveInteger(MSK,(OB7),(90),(BC7))
call ZC_Labike_Multiple_Skill(ZX7,VTG)
else
call EnableTrigger(chargeTri)
endif
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000已有充能计时器，开启触发|r"+I2S(OB7))
// set t=null
// set ZX7=null
// set IH7=null
// return
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000已有充能计时器，开启触发|r"+I2S(OB7))
// set t=null
// set ZX7=null
// set IH7=null
// return
//call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000已有充能计时器，开启触发|r"+I2S(OB7))
// set t=null
// set ZX7=null
// set IH7=null
// return
endif
//非充能技能
set stolenPhysicalSkill=LoadInteger(MSK,OB7,LoadInteger(MSK,OB7,30))
call SuijiMode_RubickApplyStolenButton(ZX7,VTG,stolenPhysicalSkill)
else
set stolenPhysicalSkill=SuijiMode_GetGrantSkill(VTG)
if SuijiMode_EnsureExactLiveAbilityLevel(ZX7,stolenPhysicalSkill,BC7,true) then
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),stolenPhysicalSkill,true)
call SuijiMode_InitCopiedSkill(ZX7,VTG,BC7)
set stolenPhysicalSkill=B287_GetPhysicalAbilityId(ZX7,VTG)
if SuijiMode_HasExactLiveAbility(ZX7,stolenPhysicalSkill) then
call SuijiMode_RubickApplyStolenButton(ZX7,VTG,stolenPhysicalSkill)
    if VTG=='A11N' then
	call ChangeUnitSkillHotKey(ZX7,stolenPhysicalSkill,"X|","C|",OSKEY_C)
	elseif VTG=='A0VK' then
		call ChangeUnitSkillHotKey(ZX7,stolenPhysicalSkill,"X|","W|",OSKEY_W)
	elseif VTG=='A0VQ' then
		call ChangeUnitSkillHotKey(ZX7,stolenPhysicalSkill,"Z|","E|",OSKEY_E)
	endif
endif
endif
endif
call SuijiMode_RubickScheduleStolenSkillRestore(ZX7,VTG,BC7)
endif
//拉比克偷取技能施法距离判断
//拉比克偷取技能施法距离判断
//拉比克偷取技能施法距离判断
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
call Change_Hero_Skill_Range(ZX7,200.)
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
call Change_Hero_Skill_Range(ZX7,150.)
else
call Change_Hero_Skill_Range(ZX7,0.)
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveInteger(L7,(I97),(34),(0))
call SaveInteger(L7,(I97),(66),(OB7))
call SaveInteger(L7,(I97),(88),(1))
call SaveInteger(L7,(I97),(704),(VTG))
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterTimerEvent(t,VYG,false)
//call TriggerRegisterDeathEvent(t,ZX7)
call TriggerRegisterTimerEvent(t,VYG-20,false)
call TriggerAddCondition(t,Condition(function VWG))
if TZ7(GetOwningPlayer(ZX7))then
call MRF(ZX7,VTG,IH7)
endif
set t=null
set ZX7=null
set IH7=null
set chargeTri=null
endfunction
function VBG takes unit ZX7,unit IH7,integer VTG,integer BC7 returns nothing
local trigger t
local integer I97
local integer id=GetUnitTypeId(ZX7)
local integer skilltx
if id=='Z02X' then
    set skilltx='h1DB'
else
    set skilltx='h0DB'
endif
set t=ZF7(IH7,ZX7,skilltx,"VXG",3000)
set I97=GetHandleId(t)
call Y17(Y34,GetUnitX(IH7),GetUnitY(IH7))
call YW7(GetObjectName(VTG),3.75,IH7,.024,$AA,0,$FF,$D8)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveInteger(L7,(I97),(704),(VTG))
call SaveInteger(L7,(I97),(5),(BC7))
set t=null
endfunction
