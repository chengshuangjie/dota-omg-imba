//先祖之魂Buff
function M1G takes unit p5,unit M9G,integer M0G,integer M5G,boolean suijiElderSpiritPrimary returns nothing
local trigger t
local integer OB7
local unit BB7
local real d=8.1
if SuijiMode_ScepterRegistryIsActive(p5,'A1A8') then
    set d=10.1
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",M9G,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"hand,left"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"hand,right"))
call ShowUnit(M9G,false)
call KillUnit(M9G)
if suijiElderSpiritPrimary then
call SaveInteger(L7,(GetHandleId((p5))),((4270)),(2))
endif
if M5G>0 or M0G>0 then
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,d,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function MLG))
call SaveUnitHandle(L7,(OB7),(2),(p5))
// set BB7=CreateUnit(GetOwningPlayer(p5),1697656901,GetUnitX(p5),GetUnitY(p5),0)
// call XF7(BB7,1093748537)
// call SetUnitAbilityLevel(BB7,1093748537,M5G)
// call IssueTargetOrderById(BB7,$D0085,p5)
// set BB7=CreateUnit(GetOwningPlayer(p5),1697656901,GetUnitX(p5),GetUnitY(p5),0)
// call XF7(BB7,1093748537)
// call SetUnitAbilityLevel(BB7,1093748537,M5G)
// call IssueTargetOrderById(BB7,$D0085,p5)
call Change_MS(p5,M5G) //移速
call B_7(p5,M0G) //攻击
call SaveEffectHandle(L7,(OB7),(32),(AddSpecialEffectTarget("war3mapImported\\RadianceHands.mdx",p5,"weapon")))
endif
set t=null
set BB7=null
endfunction
function M2G takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),M1)==false then
if IsUnitIllusion((b1060GetEnumUnit))==false then
if IsUnitType((b1060GetEnumUnit),UNIT_TYPE_HERO) then
set SI4=SI4+(SH4*$A)
set SJ4=SJ4+5
else
set SI4=SI4+(SH4*3)
set SJ4=SJ4+1
endif
endif
call GroupAddUnit(M1,(b1060GetEnumUnit))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",(b1060GetEnumUnit),"chest"))
set w1=true
set W1=true
call B67(SF4,(b1060GetEnumUnit),1,SG4)
set w1=false
set W1=false
endif
set b1060GetEnumUnit=null
endfunction
function M_G takes real N4G,real N7G,real N8G,real N9G,real NDG,real NEG returns real
local real NFG
local real NGG
local real NHG
local real NIG
local real NJG
local real NKG
local real NMG
local real NNG
local real NOG
local real NPG
local real NQG
local real NRG
local real NSG
local real NTG
local real NUG
set NPG=N8G-NDG
set NQG=N9G-NEG
set NRG=-1*NQG
set NSG=NPG
set NTG=SquareRoot(NRG*NRG+NSG*NSG)
set NRG=NRG/ NTG
set NSG=NSG/ NTG
set NFG=N4G-N8G
set NGG=N7G-N9G
set NHG=SquareRoot(NFG*NFG+NGG*NGG)
set NIG=NFG/ NHG
set NJG=NGG/ NHG
set NUG=NFG*NRG+NGG*NSG
set NKG=-1*N4G+2*N8G+2*NRG*NUG
set NMG=-1*N7G+2*N9G+2*NSG*NUG
set NNG=NDG+N8G-NKG
set NOG=NEG+N9G-NMG
return NNG
endfunction
function NVG takes real N4G,real N7G,real N8G,real N9G,real NDG,real NEG returns real
local real NFG
local real NGG
local real NHG
local real NIG
local real NJG
local real NKG
local real NMG
local real NNG
local real NOG
local real NPG
local real NQG
local real NRG
local real NSG
local real NTG
local real NUG
set NPG=N8G-NDG
set NQG=N9G-NEG
set NRG=-1*NQG
set NSG=NPG
set NTG=SquareRoot(NRG*NRG+NSG*NSG)
set NRG=NRG/ NTG
set NSG=NSG/ NTG
set NFG=N4G-N8G
set NGG=N7G-N9G
set NHG=SquareRoot(NFG*NFG+NGG*NGG)
set NIG=NFG/ NHG
set NJG=NGG/ NHG
set NUG=NFG*NRG+NGG*NSG
set NKG=-1*N4G+2*N8G+2*NRG*NUG
set NMG=-1*N7G+2*N9G+2*NSG*NUG
set NNG=NDG+N8G-NKG
set NOG=NEG+N9G-NMG
return NOG
endfunction
function NWG takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(OB7),(2)))
local unit M9G=(LoadUnitHandle(L7,(OB7),(335)))
local real x0=(LoadReal(L7,(OB7),(282)))
local real y0=(LoadReal(L7,(OB7),(283)))
local real x1=GetUnitX(p5)
local real y1=GetUnitY(p5)
local real x2=GetUnitX(M9G)
local real y2=GetUnitY(M9G)
local real x3
local real y3
local real a
local group A1D=(LoadGroupHandle(L7,(OB7),($BB)))
local group g
local integer V77=B287_GetUnitAbilityLevel(p5,'A1A8')
local real NXG=(LoadReal(L7,(OB7),(342)))
local real CP7=(TimerGetElapsed(W))
local boolean suijiElderSpiritExtra=LoadBoolean(L7,OB7,StringHash("SuijiExtraAncestralSpirit"))
local boolean suijiElderSpiritPrimary=suijiElderSpiritExtra==false
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call WR7(A1D)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call ShowUnit(M9G,false)
call KillUnit(M9G)
if suijiElderSpiritPrimary then
call SaveInteger(L7,(GetHandleId((p5))),((4270)),(2))
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1A8',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2NI',false)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and suijiElderSpiritPrimary then
if b1060B287_GetSpellAbilityId=='A2NI' then
call B947IssueImmediateOrderById("NWG @ war3map.j:185307 (B968)",M9G,$D0004)
call SaveBoolean(L7,(OB7),($F9),(true))
call SetUnitAnimationByIndex(M9G,3)
call M6G(b1060GetTriggerUnit)
elseif b1060B287_GetSpellAbilityId=='A2LK' then
if B947IssueImmediateOrderById("NWG @ war3map.j:185312 (B968)",p5,$D0265)then
call UnitRemoveAbility(M9G,'A2LK')
endif
endif
elseif KF7(x1,y1,x2,y2)<100 then
call M1G(p5,M9G,(LoadInteger(L7,(OB7),(344))),(LoadInteger(L7,(OB7),(345))),suijiElderSpiritPrimary)
call WR7(A1D)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
if suijiElderSpiritPrimary then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1A8',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2NI',false)
endif
elseif GetTriggerEvalCount(t)>400 or(LoadBoolean(L7,(OB7),($F9))) then
call XF7(M9G,'Aloc')
if GetTriggerEvalCount(t)==401 and(LoadBoolean(L7,(OB7),($F9)))==false then
call B947IssueImmediateOrderById("NWG @ war3map.j:185328 (B968)",M9G,$D0004)
call SetUnitAnimationByIndex(M9G,3)
endif
set g=WS7()
set SH4=V77
set SI4=(LoadInteger(L7,(OB7),(344)))
set SJ4=(LoadInteger(L7,(OB7),(345)))
set SG4=80+40*V77
set SF4=p5
set IN4=p5
set M1=A1D
call GroupEnumUnitsInRange(g,GetUnitX(M9G),GetUnitY(M9G),300,Condition(function AJ7_gai))
call ForGroup(g,function M2G)
call WR7(g)
set g=null
call SaveInteger(L7,(OB7),(344),(SI4))
call SaveInteger(L7,(OB7),(345),(SJ4))
if((LoadInteger(L7,(GetHandleId((p5))),((4269))))==1)==false then
set a=Atan2(y1-y2,x1-x2)
call SetUnitFacing(M9G,a*bj_RADTODEG)
set x3=GetUnitX(M9G)+$C*Cos(a)
set y3=GetUnitY(M9G)+$C*Sin(a)
call SetUnitX(M9G,X17(x3))
call SetUnitY(M9G,X07(y3))
call SaveReal(L7,(OB7),(282),((x1)*1.))
call SaveReal(L7,(OB7),(283),((y1)*1.))
endif
else
call SetUnitMoveSpeed(M9G,GetUnitMoveSpeed(p5))
call UnitRemoveAbility(M9G,'Aloc')
set g=WS7()
set SH4=V77
set SI4=(LoadInteger(L7,(OB7),(344)))
set SJ4=(LoadInteger(L7,(OB7),(345)))
set SG4=80+40*V77
set SF4=p5
set IN4=p5
set M1=A1D
call GroupEnumUnitsInRange(g,GetUnitX(M9G),GetUnitY(M9G),300,Condition(function AJ7_gai))
call ForGroup(g,function M2G)
call WR7(g)
set g=null
call SaveInteger(L7,(OB7),(344),(SI4))
call SaveInteger(L7,(OB7),(345),(SJ4))
if x0!=x1 or y0!=y1 then
set NXG=CP7
call SaveReal(L7,(OB7),(342),((NXG)*1.))
endif
if((LoadInteger(L7,(GetHandleId((p5))),((4269))))==1)==false then
if NXG==CP7 then
set x3=M_G(x0,y0,x1,y1,x2,y2)
set y3=NVG(x0,y0,x1,y1,x2,y2)
set a=Atan2(y3-y2,x3-x2)*bj_RADTODEG
call SaveReal(L7,(OB7),(282),((x1)*1.))
call SaveReal(L7,(OB7),(283),((y1)*1.))
endif
if(NXG+.3)<CP7 then
call SaveInteger(L7,(OB7),(343),(1))
elseif(NXG+.3)>CP7 and(LoadInteger(L7,(OB7),(343)))==1 then
call SaveInteger(L7,(OB7),(343),(2))
elseif(LoadInteger(L7,(OB7),(343)))==3 then
call SaveInteger(L7,(OB7),(343),(1))
endif
else
call SaveInteger(L7,(OB7),(343),(3))
endif
endif
set t=null
set p5=null
set M9G=null
set A1D=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function ElderTitanAncestralSpirit_Create takes unit suijiElderSpiritCaster,real suijiElderSpiritTargetX,real suijiElderSpiritTargetY,boolean suijiElderSpiritPrimary returns nothing
local trigger suijiElderSpiritTrigger=null
local integer suijiElderSpiritHandle=0
local real suijiElderSpiritCasterX=0.
local real suijiElderSpiritCasterY=0.
local real suijiElderSpiritAngle=0.
local real suijiElderSpiritDistance=0.
local real suijiElderSpiritSpawnX=0.
local real suijiElderSpiritSpawnY=0.
local unit suijiElderSpiritUnit=null
if suijiElderSpiritCaster==null or UnitAlive(suijiElderSpiritCaster)==false then
return
endif
set suijiElderSpiritCasterX=GetUnitX(suijiElderSpiritCaster)
set suijiElderSpiritCasterY=GetUnitY(suijiElderSpiritCaster)
if suijiElderSpiritPrimary==false and suijiElderSpiritTargetX==0. and suijiElderSpiritTargetY==0. then
set suijiElderSpiritTargetX=suijiElderSpiritCasterX+300.*Cos(GetUnitFacing(suijiElderSpiritCaster)*bj_DEGTORAD)
set suijiElderSpiritTargetY=suijiElderSpiritCasterY+300.*Sin(GetUnitFacing(suijiElderSpiritCaster)*bj_DEGTORAD)
endif
set suijiElderSpiritAngle=Atan2(suijiElderSpiritTargetY-suijiElderSpiritCasterY,suijiElderSpiritTargetX-suijiElderSpiritCasterX)
set suijiElderSpiritDistance=YK7(KF7(suijiElderSpiritCasterX,suijiElderSpiritCasterY,suijiElderSpiritTargetX,suijiElderSpiritTargetY),300)
set suijiElderSpiritSpawnX=X17(suijiElderSpiritCasterX+suijiElderSpiritDistance*Cos(suijiElderSpiritAngle))
set suijiElderSpiritSpawnY=X07(suijiElderSpiritCasterY+suijiElderSpiritDistance*Sin(suijiElderSpiritAngle))
set suijiElderSpiritUnit=CreateUnit(GetOwningPlayer(suijiElderSpiritCaster),'h07U',suijiElderSpiritSpawnX,suijiElderSpiritSpawnY,suijiElderSpiritAngle*bj_RADTODEG-180)
call SetUnitMoveSpeed(suijiElderSpiritUnit,GetUnitMoveSpeed(suijiElderSpiritCaster))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",suijiElderSpiritUnit,"chest"))
if B287_GetUnitAbilityLevel(suijiElderSpiritCaster,'A1CD')>0 then
call XF7(suijiElderSpiritUnit,'A1CQ')
endif
if B287_GetUnitAbilityLevel(suijiElderSpiritCaster,'A1AA')==0 or suijiElderSpiritPrimary==false then
call UnitRemoveAbility(suijiElderSpiritUnit,'A2LK')
endif
if suijiElderSpiritPrimary then
call UnitAddAbility(suijiElderSpiritCaster,'A2NI')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiElderSpiritCaster),'A1A8',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiElderSpiritCaster),'A2NI',true)
set SK4[GetPlayerId(GetOwningPlayer(suijiElderSpiritCaster))]=suijiElderSpiritUnit
call SaveInteger(L7,(GetHandleId((suijiElderSpiritCaster))),((4270)),(1))
endif
call XF7(suijiElderSpiritUnit,'Avul')
call XF7(suijiElderSpiritUnit,'Aetl')
set suijiElderSpiritTrigger=CreateTrigger()
set suijiElderSpiritHandle=GetHandleId(suijiElderSpiritTrigger)
if suijiElderSpiritPrimary and LoadBoolean(L7,(GetHandleId(suijiElderSpiritCaster)),(339)) then
call TriggerEvaluate((LoadTriggerHandle(L7,(suijiElderSpiritHandle),(338))))
endif
call TriggerRegisterTimerEvent(suijiElderSpiritTrigger,.02,true)
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritCaster,EVENT_UNIT_DEATH)
if suijiElderSpiritPrimary then
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritCaster,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(suijiElderSpiritTrigger,suijiElderSpiritUnit,EVENT_UNIT_SPELL_EFFECT)
else
call SaveBoolean(L7,suijiElderSpiritHandle,StringHash("SuijiExtraAncestralSpirit"),true)
endif
call TriggerAddCondition(suijiElderSpiritTrigger,Condition(function NWG))
call SaveUnitHandle(L7,(suijiElderSpiritHandle),(2),(suijiElderSpiritCaster))
call SaveUnitHandle(L7,(suijiElderSpiritHandle),(335),(suijiElderSpiritUnit))
call SaveReal(L7,(suijiElderSpiritHandle),(282),((suijiElderSpiritCasterX)*1.))
call SaveReal(L7,(suijiElderSpiritHandle),(283),((suijiElderSpiritCasterY)*1.))
call SaveGroupHandle(L7,(suijiElderSpiritHandle),($BB),(WS7()))
call SaveInteger(L7,(suijiElderSpiritHandle),(343),(2))
call SaveReal(L7,(suijiElderSpiritHandle),(342),(((TimerGetElapsed(W))-5)*1.))
call SaveBoolean(L7,(suijiElderSpiritHandle),($F9),(false))
set suijiElderSpiritUnit=null
set suijiElderSpiritTrigger=null
endfunction
function NYG takes nothing returns nothing
local unit p5=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real ILD=GetLocationX(l)
local real I1D=GetLocationY(l)
call ElderTitanAncestralSpirit_Create(p5,ILD,I1D,true)
call RemoveLocation(l)
set p5=null
set l=null
endfunction
function NZG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1A8' then
call NYG()
endif
return false
endfunction
function NM8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NZG))
call X_7('A1G9')
set t=null
endfunction
function NAG takes nothing returns boolean
if GetPlayerController(GetOwningPlayer(GetTriggerUnit()))==MAP_CONTROL_COMPUTER and(GetItemTypeId(GetManipulatedItem())==ZU[H6]or GetItemTypeId(GetManipulatedItem())==ZU[G6]or GetItemTypeId(GetManipulatedItem())==ZU[N6])then
call UnitRemoveAbility(GetTriggerUnit(),'A14A')
endif
return false
endfunction
function NBG takes unit u,integer d returns nothing
local texttag t=CreateTextTag()
call SetTextTagText(t,"+"+I2S(d)+" "+GetObjectName('n0LQ'),.03)
call SetTextTagPosUnit(t,u,0)
call SetTextTagColorBJ(t,50,75,$FF,$F)
call SetTextTagVelocity(t,0,.035)
call SetTextTagFadepoint(t,3)
call SetTextTagLifespan(t,2.5)
call SetTextTagPermanent(t,false)
call SetTextTagVisibility(t,false)
call SetTextTagVisibility(t,true)
if IsUnitVisible(u,GetLocalPlayer())or WG7(GetLocalPlayer())then
call SetTextTagVisibility(t,true)
else
call SetTextTagVisibility(t,false)
endif
set t=null
endfunction
function DarkRitualField_OnTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit caster=O77(h,"Source")
local player owner=O97(h,"Owner")
local trigger linked=null
local group g=null
local unit u=null
local integer level=OM7(h,"Level")
local real mana=0.
local real amount=0.
local effect e=null
if OO7(h,"Cancelled") or GetTriggerEvalCount(t)>6 then
set linked=OE7(GetHandleId(caster),"DarkRitualField")
if linked==t then
call NN7(GetHandleId(caster),"DarkRitualField")
endif
set e=OG7(h,"Effect")
if e!=null then
call DestroyEffect(e)
endif
call NM7(h)
call OZ7(t)
else
set g=WS7()
call GroupEnumUnitsInRange(g,ON7(h,"X"),ON7(h,"Y"),450.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
if UnitAlive(u) and IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false then
if IsUnitAlly(u,owner) then
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+GetUnitState(u,UNIT_STATE_MAX_MANA)*.02)
elseif IsUnitEnemy(u,owner) then
set mana=GetUnitState(u,UNIT_STATE_MANA)
if GetUnitState(u,UNIT_STATE_MAX_MANA)<=.5 then
call B67(caster,u,7,5.+15.*level)
elseif mana>0. then
set amount=mana*.02
call SetUnitState(u,UNIT_STATE_MANA,mana-amount)
call B67(caster,u,7,amount)
endif
endif
endif
endloop
call WR7(g)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl",ON7(h,"X"),ON7(h,"Y")))
if GetTriggerEvalCount(t)>=6 then
set linked=OE7(GetHandleId(caster),"DarkRitualField")
if linked==t then
call NN7(GetHandleId(caster),"DarkRitualField")
endif
set e=OG7(h,"Effect")
if e!=null then
call DestroyEffect(e)
endif
call NM7(h)
call OZ7(t)
endif
endif
set e=null
set u=null
set g=null
set linked=null
set owner=null
set caster=null
set t=null
return false
endfunction
function DarkRitualField_Start takes unit caster,real x,real y,integer level returns nothing
local integer casterHandle=GetHandleId(caster)
local trigger old=OE7(casterHandle,"DarkRitualField")
local trigger t=null
local integer h=0
if old!=null then
call NS7(GetHandleId(old),"Cancelled",true)
call TriggerEvaluate(old)
endif
set t=CreateTrigger()
set h=GetHandleId(t)
call NV7(casterHandle,"DarkRitualField",t)
call NT7(h,"Source",caster)
call NZ7(h,"Owner",GetOwningPlayer(caster))
call NP7(h,"Level",level)
call NQ7(h,"X",x)
call NQ7(h,"Y",y)
call NU7(h,"Effect",AddSpecialEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",x,y))
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddCondition(t,Condition(function DarkRitualField_OnTick))
set old=null
set t=null
endfunction
function XEJS2 takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer BC7=0
local integer ritualLevel=0
local real x=0.
local real y=0.
if p5==null or m5==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 then
set p5=null
set m5=null
return
endif
set BC7=GetUnitLevel(m5)
set ritualLevel=B287_GetUnitAbilityLevel(p5,'A053')
set x=GetUnitX(m5)
set y=GetUnitY(m5)
if SuijiMode_IsSacrificeProtectedTarget(m5) then
set p5=null
set m5=null
