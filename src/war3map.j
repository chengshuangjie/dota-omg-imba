function HVG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local real VW9
if BC7==1 and(GetTriggerEvalCount(t)==3 or GetTriggerEvalCount(t)==4)then
set VW9=$F
call B67(ZX7,IH7,1,VW9)
elseif BC7==2 and(GetTriggerEvalCount(t)==3 or GetTriggerEvalCount(t)==4 or GetTriggerEvalCount(t)==5)then
set VW9=20
call B67(ZX7,IH7,1,VW9)
elseif BC7==3 and(GetTriggerEvalCount(t)==3 or GetTriggerEvalCount(t)==4 or GetTriggerEvalCount(t)==5 or GetTriggerEvalCount(t)==6)then
set VW9=25
call B67(ZX7,IH7,1,VW9)
elseif BC7==4 and(GetTriggerEvalCount(t)==3 or GetTriggerEvalCount(t)==4 or GetTriggerEvalCount(t)==5 or GetTriggerEvalCount(t)==6 or GetTriggerEvalCount(t)==7)then
set VW9=30
call B67(ZX7,IH7,1,VW9)
endif
if GetTriggerEvalCount(t)==3+BC7 then
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
call UnitRemoveAbility(IH7,'A1VS')
call UnitRemoveAbility(IH7,'B0DN')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function MHBJ2 takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
    local trigger t=CreateTrigger()
    local integer I97=GetHandleId(t)
	set d =50. * level
    call B67(ZX7, IH7, 1, d)
    call CommonUnitAddStun(IH7, 2, false)
    call TriggerRegisterTimerEvent(t,1,true)
    call TriggerAddCondition(t,Condition(function HVG))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveUnitHandle(L7,(I97),(17),(IH7))
    call SaveInteger(L7,(I97),(5),(level))
    if GetUnitTypeId(ZX7)=='ZC00' then
    call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget("model\\hero_skeletonking_n7s_t_impact.mdl",IH7,"chest")))
    else
    call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget("Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl",IH7,"chest")))
    endif
call SetPlayerAbilityAvailable(GetOwningPlayer(IH7),'A1VS',false)
call XF7(IH7,'A1VS')
    call LINGXIA(ZX7,IH7)
	set ZX7 = null
	set IH7 = null
    set t = null
endfunction
function MHBJ takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
	local trigger t
	local integer h
    local integer id=GetUnitTypeId(ZX7)
    local string tx="Abilities\\Weapons\\LordofFlameMissile\\LordofFlameMissile.mdl"
    if id=='ZC00' or id=='Z02X' then
        set tx="model\\hero_skeletonking_n7s_t_misslie.mdl"
    endif
    set t=NHX(ZX7, IH7,'h0HH', "MHBJ2",1000, true, tx)
    set h=GetHandleId(t)
	call SaveInteger(TABLE_HY, h, 10, B287_GetUnitAbilityLevel(ZX7, skill))
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function HYG takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if GetUnitTypeId(b1060GetTriggerUnit)=='ZC00' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_skeletonking_n7s_t_caster.mdx",b1060GetTriggerUnit,"weapon"))
call DestroyEffect(AddSpecialEffectTarget("model\\hero_skeletonking_n7s_t_caster.mdx",b1060GetTriggerUnit,"hand"))
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl",b1060GetTriggerUnit,"weapon"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl",b1060GetTriggerUnit,"hand"))
endif
set b1060GetTriggerUnit=null
endfunction
function HZG takes nothing returns boolean
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
if B287_GetSpellAbilityId()=='XHtb' then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_CAST then
call HYG()
elseif WQ7(b1060GetSpellTargetUnit)==false then
call MHBJ()
endif
endif
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function M18 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function HZG))
set t=null
endfunction
function Refresh_Tiaodao takes unit u returns nothing
local integer T8=0
local integer U8=5
local integer Y68
local integer skill
local item it=null
local integer newitem
local player p
if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false or OO7(GetHandleId(u),"B834ReincarnationPending") then
return
endif
loop
exitwhen T8>U8
set it=UnitItemInSlot(u,T8)
set Y68=KZ7(it)
if Y68==TW or Y68==it_sgban or Y68==it_xjsgban or Y68==it_sssgban then
    if Y68==TW then
        set newitem=RW
    elseif Y68==it_sgban then
        set newitem=it_sg
    elseif Y68==it_xjsgban then
        set newitem=it_xjsg
    elseif Y68==it_sssgban then
        set newitem=it_sssg
    endif
    set p=GetItemPlayer(it)
    set IR4=p
    call RemoveItem(it)
    set HA4=AY8(u,ZU[newitem],T8)
    call SetItemPlayer(HA4,p,false)
    call SetItemUserData(HA4,1)
    set it=UnitItemInSlot(u,T8)
    set skill=MHItem_GetAbilityId(it,1)
    if B582_GetAbilityCooldown(u,skill)>0 then
        call MHAbility_SetCooldown(u, skill, 0)
    endif
endif
set T8=T8+1
endloop
set it=null
set p=null
endfunction
function Refresh_Item takes unit u returns nothing
local integer T8=0
local integer U8=5
local integer Y68
local integer skill
local item it=null
call RemoveSavedReal(L7,GetHandleId(u),StringHash("B907LightReady"))
call RemoveSavedReal(L7,GetHandleId(u),StringHash("B907CupReady"))
loop
exitwhen T8>U8
set it=UnitItemInSlot(u,T8)
set Y68=KZ7(it)
if Y68==D0 or Y68==E0 or Y68==J0 or Y68==N0 or Y68==O0 or Y68==R0 or Y68==J1 or Y68==R5 or Y68==S5 or Y68==it_silingshu3 or Y68==S6 or Y68==V6 or Y68==it_shuaxin or Y68==DD4 or Y68==F74 then
elseif Y68!=null then
    set skill=MHItem_GetAbilityId(it,1)
    if B582_GetAbilityCooldown(u,skill)>0 then
        call MHAbility_SetCooldown(u, skill, 0)
    endif
endif
set T8=T8+1
endloop
call SaveInteger(TABLE_HY, GetHandleId(u), 'echs', 0)
call SaveInteger(TABLE_HY, GetHandleId(u), 'LXCD', 0)
call SaveReal(TABLE_HY, GetHandleId(u), 'link', 0)
call SaveReal(L7,(GetHandleId(u)),(785),(((TimerGetElapsed(W)-10.))*1.))
set it=null
endfunction
function SuijiMode_RefreshTrackedSkillCooldown takes unit u,integer logicalSkill returns nothing
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return
endif
// Scepter Reincarnation refreshes the hero after revival, but it must never
// refresh its own AOre/script-owned cooldown.  Clearing A01Y/A4KM here lets a
// native Skeleton King revive a second time while the scripted ReadyAt gate is
// still cooling down, which also separates the second death from its blast.
if logicalSkill=='A01Y' or logicalSkill=='A4KM' then
return
endif
if logicalSkill=='A29J' or logicalSkill=='A1MP' then
call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(u,logicalSkill,GetUnitAbilityLevel(u,'A2YR')>0)
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return
endif
// Refresh through both synchronized cooldown paths.  The logical wrapper owns
// fixed OMG carriers, while the YDWE state write covers native hero abilities.
call B287_YDWESetUnitAbilityState(u,logicalSkill,1,0.)
call B287_MHAbility_SetCooldown(u,logicalSkill,0.)
endfunction
function SuijiMode_RefreshSkillCooldowns takes unit u returns nothing
local integer i=1
local integer idx=0
local integer h=0
local integer skill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set idx=SuijiMode_GetStableHeroIndex(u)
if idx>=KL4 and idx<=K54 then
loop
exitwhen i>10
set skill=LoadInteger(MSK,idx,i)
call SuijiMode_RefreshTrackedSkillCooldown(u,skill)
set i=i+1
endloop
endif
if SUIJI_MODE and LoadBoolean(L7,h,StringHash("SuijiDone")) then
call SuijiMode_RefreshTrackedSkillCooldown(u,LoadInteger(L7,h,StringHash("SuijiSmallSkill")))
call SuijiMode_RefreshTrackedSkillCooldown(u,LoadInteger(L7,h,StringHash("SuijiUltSkill")))
call SuijiMode_RefreshTrackedSkillCooldown(u,LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical1")))
call SuijiMode_RefreshTrackedSkillCooldown(u,LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2")))
endif
endfunction
function SuijiReincarnation_DebugCooldown takes unit u,integer logicalSkill returns real
local integer physicalSkill=0
local ability a=null
local real result=-1.
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 or B287_GetUnitAbilityLevel(u,logicalSkill)<=0 then
return result
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return result
endif
set a=EXGetUnitAbility(u,physicalSkill)
if a==null then
set a=null
return -2.
endif
set result=B582_GetAbilityCooldown(u,physicalSkill)
set a=null
return result
endfunction
function SuijiReincarnation_DebugPrint takes unit u,string tag,string msg returns nothing
local integer h=0
local integer count=0
local integer alive=0
if SUIJI_LOG==false then
return
endif
if u==null then
call SuijiTest_DebugAll(tag,"unit=null "+msg)
return
endif
set h=GetHandleId(u)
if UnitAlive(u) then
set alive=1
endif
set count=LoadInteger(L7,h,StringHash("SuijiReincarnationDebugCount"))
if count>=80 then
return
endif
call SaveInteger(L7,h,StringHash("SuijiReincarnationDebugCount"),count+1)
call SuijiTest_DebugAll(tag,"P"+I2S(GetPlayerId(GetOwningPlayer(u))+1)+" hid="+I2S(h)+" "+GetUnitName(u)+" alive="+I2S(alive)+" lv01Y="+I2S(B287_GetUnitAbilityLevel(u,'A01Y'))+" lv4KM="+I2S(B287_GetUnitAbilityLevel(u,'A4KM'))+" cd01Y="+R2S(SuijiReincarnation_DebugCooldown(u,'A01Y'))+" cd4KM="+R2S(SuijiReincarnation_DebugCooldown(u,'A4KM'))+" now="+R2S(TimerGetElapsed(W))+" ready="+R2S(ON7(h,"SuijiReincarnationReadyAt"))+" mana="+R2S(GetUnitState(u,UNIT_STATE_MANA))+" state="+I2S(LoadInteger(L7,h,StringHash("statechongsheng")))+" "+msg)
endfunction
function SuijiReincarnation_DebugProbeTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local integer h=LoadInteger(L7,I97,3)
local integer tick=LoadInteger(L7,I97,4)+1
local integer lastAlive=LoadInteger(L7,I97,5)
local integer nowAlive=0
local unit u=LoadUnitHandle(L7,I97,2)
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 or tick>100 then
if h!=0 then
call RemoveSavedHandle(L7,h,StringHash("SuijiReincarnationDebugProbe"))
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
else
if UnitAlive(u) then
set nowAlive=1
endif
if nowAlive!=lastAlive then
if nowAlive==1 then
call SuijiReincarnation_DebugPrint(u,"REVIVE-OBS","probeTick="+I2S(tick))
else
call SuijiReincarnation_DebugPrint(u,"DEATH-AGAIN","probeTick="+I2S(tick))
endif
call SaveInteger(L7,I97,5,nowAlive)
endif
call SaveInteger(L7,I97,4,tick)
endif
set u=null
set t=null
endfunction
function SuijiReincarnation_DebugStartProbe takes unit u returns nothing
local integer h=0
local integer I97=0
local timer t=null
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set t=LoadTimerHandle(L7,h,StringHash("SuijiReincarnationDebugProbe"))
if t==null then
set t=CreateTimer()
call SaveTimerHandle(L7,h,StringHash("SuijiReincarnationDebugProbe"),t)
endif
set I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,2,u)
call SaveInteger(L7,I97,3,h)
call SaveInteger(L7,I97,4,0)
call SaveInteger(L7,I97,5,0)
call TimerStart(t,.10,true,function SuijiReincarnation_DebugProbeTick)
set t=null
endfunction
function SuijiReincarnation_DebugDeath takes nothing returns boolean
local unit u=GetTriggerUnit()
if SUIJI_LOG and u!=null and (GetUnitTypeId(u)=='NC00' or GetUnitTypeId(u)=='ZC00' or B287_GetUnitAbilityLevel(u,'A01Y')>0 or B287_GetUnitAbilityLevel(u,'A4KM')>0) then
call SuijiReincarnation_DebugPrint(u,"DEATH-OBS","")
call SuijiReincarnation_DebugStartProbe(u)
endif
set u=null
return false
endfunction
function SuijiMode_ApplyReincarnationCooldownGuard takes unit u returns nothing
local integer h=0
local integer physicalSkill=0
local real remaining=0.
local real maxCooldown=0.
local ability a=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set remaining=ON7(h,"SuijiReincarnationReadyAt")-TimerGetElapsed(W)
if remaining<=.01 then
return
endif
set maxCooldown=ON7(h,"SuijiReincarnationCooldownDuration")
if maxCooldown<remaining then
set maxCooldown=remaining
endif
// Native A01Y/A4KM already receive Warcraft's own AOre cooldown event. Only
// bridge the script-owned Channel display carriers used by copied/random
// Reincarnation; their zero object-data cooldown never owns gameplay state.
set physicalSkill=B287_GetPhysicalAbilityId(u,'A01Y')
if physicalSkill=='Y0BA' and GetUnitAbilityLevel(u,physicalSkill)>0 then
set a=EXGetUnitAbility(u,physicalSkill)
if a!=null then
call EXSetAbilityState(a,1,remaining)
call MHAbility_SetCooldownEx(u,physicalSkill,remaining,maxCooldown)
endif
endif
set a=null
set physicalSkill=B287_GetPhysicalAbilityId(u,'A4KM')
if physicalSkill=='Y0FQ' and GetUnitAbilityLevel(u,physicalSkill)>0 then
set a=EXGetUnitAbility(u,physicalSkill)
if a!=null then
call EXSetAbilityState(a,1,remaining)
call MHAbility_SetCooldownEx(u,physicalSkill,remaining,maxCooldown)
endif
endif
set a=null
endfunction
function SuijiMode_ReincarnationCooldownGuardTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local integer OB7=LoadInteger(L7,I97,3)
local unit u=LoadUnitHandle(L7,I97,2)
if OB7!=0 then
call RemoveSavedHandle(L7,OB7,StringHash("SuijiReincarnationCooldownGuard"))
if ON7(OB7,"SuijiReincarnationReadyAt")<=TimerGetElapsed(W) then
call RemoveSavedReal(L7,OB7,StringHash("SuijiReincarnationCooldownDuration"))
endif
endif
if u!=null and GetUnitTypeId(u)!=0 and UnitAlive(u) and ON7(OB7,"SuijiReincarnationReadyAt")>TimerGetElapsed(W) then
call SuijiMode_ApplyReincarnationCooldownGuard(u)
endif
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function SuijiMode_StartReincarnationCooldownGuard takes unit u returns nothing
local integer OB7=0
local integer I97=0
local timer t=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set OB7=GetHandleId(u)
if ON7(OB7,"SuijiReincarnationReadyAt")<=TimerGetElapsed(W) then
call RemoveSavedReal(L7,OB7,StringHash("SuijiReincarnationCooldownDuration"))
return
endif
if B287_GetPhysicalAbilityId(u,'A01Y')!='Y0BA' and B287_GetPhysicalAbilityId(u,'A4KM')!='Y0FQ' then
return
endif
set t=LoadTimerHandle(L7,OB7,StringHash("SuijiReincarnationCooldownGuard"))
if t==null then
set t=CreateTimer()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,I97,2,u)
call SaveInteger(L7,I97,3,OB7)
call SaveTimerHandle(L7,OB7,StringHash("SuijiReincarnationCooldownGuard"),t)
// B541-proven bridge: wait one event turn for the restored command-card
// Ability, then perform one exact live-object write. Never poll metadata for
// the full Reincarnation cooldown.
call TimerStart(t,0.,false,function SuijiMode_ReincarnationCooldownGuardTick)
endif
set t=null
endfunction
function HAG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer skill=(LoadInteger(L7,(I97),(10)))
local integer scripted=(LoadInteger(L7,(I97),(11)))
local integer aghActive=(LoadInteger(L7,(I97),(12)))
local integer n=LoadInteger(TABLE_HY, GetHandleId(ZX7), 'CSJY')
local real x=LoadReal(L7,I97,6)
local real y=LoadReal(L7,I97,7)
local integer b834Retry=LoadInteger(L7,I97,13)
call SuijiReincarnation_DebugPrint(ZX7,"HAG-ENTER","skill="+I2S(skill))
// Native AOre remains intact for the original learn/Engineering Upgrade and
// AI interface.  ReviveHero is only a dead-state fallback at the same delay,
// so the engine and script can never revive the hero twice.
if ZX7!=null and GetUnitTypeId(ZX7)!=0 and UnitAlive(ZX7)==false and b834Retry==0 then
call ReviveHero(ZX7,x,y,false)
endif
// Native AOre may finish after this callback. Never rebuild Blink on a dead
// hero. Keep death ownership during at most twenty 0.1-second completion polls.
if ZX7!=null and GetUnitTypeId(ZX7)!=0 and UnitAlive(ZX7)==false and b834Retry<20 then
if b834Retry==0 then
call TriggerRegisterTimerEvent(t,.10,true)
endif
call SaveInteger(L7,I97,13,b834Retry+1)
set t=null
set ZX7=null
return false
endif
if ZX7!=null then
call RemoveSavedBoolean(L7,GetHandleId(ZX7),StringHash("SuijiRevivalPending"))
call RemoveSavedBoolean(L7,GetHandleId(ZX7),StringHash("B834ReincarnationPending"))
endif
if ZX7==null or GetUnitTypeId(ZX7)==0 or UnitAlive(ZX7)==false then
if ZX7!=null and GetUnitTypeId(ZX7)!=0 then
call OX7(ZX7,"chongsheng")
// Failure-contained recovery; never leave a hero out of every revival queue.
call VK8(ZX7,1.,false)
endif
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
return false
endif
// The death manager may relocate a dead hero handle to the fountain while the
// callback waits.  The saved death point, not the later handle position, owns
// Reincarnation's destination even when native AOre revived first.
if ZX7!=null and GetUnitTypeId(ZX7)!=0 and UnitAlive(ZX7) then
call SetUnitX(ZX7,x)
call SetUnitY(ZX7,y)
// ReviveHero can return after the global HERO_REVIVE cleanup with zero mana.
// Reincarnation promises a full-life, full-mana return on both native and
// copied paths, so restore the actual post-revive maximum explicitly.
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MAX_MANA))
endif
call SelectUnitForPlayerSingle(ZX7,GetOwningPlayer(ZX7))
call PanCameraToTimedForPlayer(GetOwningPlayer(ZX7),GetUnitX(ZX7),GetUnitY(ZX7),0)
call OX7(ZX7,"chongsheng")
call AddHeroXP(ZX7,n,true)
call SaveInteger(TABLE_HY, GetHandleId(ZX7), 'CSJY', 0) 
if D9 then
    call XF7(ZX7,'Abun')
    call UnitRemoveAbility(ZX7,'Amov')
    call MJ_USE_SKILL(ZX7,ZX7,'A2Z2',$D0267)
elseif aghActive==1 then
    call SuijiMode_RefreshSkillCooldowns(ZX7)
    call Refresh_Tiaodao(ZX7)
    call Refresh_Item(ZX7)
    call B287_MHAbility_SetCooldown(ZX7,'XHtb',0)
endif
// Copied Reincarnation uses an inert passive carrier, so revive completion must
// explicitly create its grey cooldown overlay regardless of Scepter state.
call SuijiMode_StartReincarnationCooldownGuard(ZX7)
call SuijiReincarnation_DebugPrint(ZX7,"HAG-DONE","skill="+I2S(skill))
set B1116ReconcileWakeUnit=ZX7
call ExecuteFunc("B1116ResumeEventReconcile")
if GetPlayerController(GetOwningPlayer(ZX7))==MAP_CONTROL_COMPUTER and GetRandomInt(1,2)==1 then
    call AI_ITEM_RENJIA(ZX7)
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
function HBG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer skill='A01Y'
local integer BC7=0
local real BZ7
local unit BB7
local real x=0.
local real y=0.
local real d=0.
local integer OB7=0
local integer physicalSkill=0
local integer scripted=0
local boolean aghActive=false
local real time=3.
if ZX7==null then
set t=null
return false
endif
call SuijiReincarnation_DebugPrint(ZX7,"HBG-ENTER","")
set BC7=IMaxBJ(B287_GetUnitAbilityLevel(ZX7,'A01Y'),B287_GetUnitAbilityLevel(ZX7,'A4KM'))
// Death can run before the deferred registry refresh following an item change.
// Read the authoritative held/consumed Scepter source here so a stale cached
// false cannot disable the whole Reincarnation upgrade for this lifecycle.
set aghActive=SuijiMode_DetectAghanimSourceState(ZX7)
set x=GetUnitX(ZX7)
set y=GetUnitY(ZX7)
set d=ReduceUnitAbilityCoolDownReal(ZX7)
set OB7=GetHandleId(ZX7)
if OO7(OB7,"SuijiRevivalPending") then
call SuijiReincarnation_DebugPrint(ZX7,"HBG-BLOCK","revival-pending")
set t=null
set ZX7=null
return false
endif
if SUIJI_MODE==false and B287_GetUnitAbilityLevel(ZX7,'A01Y')==0 and B287_GetUnitAbilityLevel(ZX7,'A4KM')>0 then
set skill='A4KM'
endif
if aghActive then
set time=2.
endif
if BC7<=0 then
call SuijiReincarnation_DebugPrint(ZX7,"HBG-NO-SKILL","")
set t=null
set ZX7=null
return false
endif
set physicalSkill=B287_GetPhysicalAbilityId(ZX7,skill)
if physicalSkill=='Y0BA' or physicalSkill=='Y0FQ' then
set scripted=1
endif
set BZ7=LoadReal(ZCC,-skill,BC7)
if BZ7<=0. then
    if BC7==1 then
        set BZ7=140.
    elseif BC7==2 then
        set BZ7=100.
    else
        set BZ7=60.
    endif
endif
//有不朽盾就返回
if DUN_HasAegis(ZX7) then
call SuijiReincarnation_DebugPrint(ZX7,"HBG-AEGIS","")
set t=null
set ZX7=null
return false
endif
if ON7(OB7,"SuijiReincarnationReadyAt")<=TimerGetElapsed(W) and (GetUnitState(ZX7,UNIT_STATE_MANA)>=140 or aghActive) then
    call SuijiReincarnation_DebugPrint(ZX7,"HBG-ALLOW","skill="+I2S(skill)+" level="+I2S(BC7)+" configuredCD="+R2S(BZ7))
    call NS7(OB7,"SuijiRevivalPending",true)
    call NS7(OB7,"B834ReincarnationPending",true)
    call OV7(ZX7,"chongsheng")
    if d>0 then
        //call EE5(ZX7,1093677401,true,25)
        set BZ7=BZ7*d
        call Japi_ReduceUnitAbilityCoolDown(ZX7,skill,BZ7)
    endif
    call NQ7(OB7,"SuijiReincarnationReadyAt",TimerGetElapsed(W)+BZ7)
    call NQ7(OB7,"SuijiReincarnationCooldownDuration",BZ7)
    call SuijiMode_StartReincarnationCooldownGuard(ZX7)
    if scripted==1 and aghActive==false then
        call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)-140.)
    endif
    if GetUnitTypeId(ZX7)=='ZC00' then
        call DestroyEffect(AddSpecialEffect("model\\hero_skeletonking_n7s_r_blast.mdx",x,y))
    endif
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitApplyTimedLife(BB7,'BTLF',3.)
call UnitAddAbility(BB7,'A274')
call SetUnitAbilityLevel(BB7,'A274',BC7)
    call B947IssueImmediateOrder("HBG @ war3map.j:181075 (B968)",BB7,"thunderclap")
    set t=CreateTrigger()
    set I97=GetHandleId(t)
    call TriggerRegisterTimerEvent(t,time+.01,false)
    call TriggerAddCondition(t,Condition(function HAG))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveReal(L7,I97,6,x)
    call SaveReal(L7,I97,7,y)
    call SaveInteger(L7,(I97),(10),(skill))
    call SaveInteger(L7,(I97),(11),(scripted))
    if aghActive then
    call SaveInteger(L7,(I97),(12),(1))
    endif
elseif ON7(OB7,"SuijiReincarnationReadyAt")>TimerGetElapsed(W) then
    call SuijiReincarnation_DebugPrint(ZX7,"HBG-BLOCK","remaining="+R2S(ON7(OB7,"SuijiReincarnationReadyAt")-TimerGetElapsed(W)))
    call SuijiMode_StartReincarnationCooldownGuard(ZX7)
else
    call SuijiReincarnation_DebugPrint(ZX7,"HBG-BLOCK","mana-or-condition")
endif
set t=null
set ZX7=null
set BB7=null
return false
endfunction
function SuijiMode_EnsureReincarnationTrigger takes unit ZX7 returns nothing
local integer OB7=0
local integer I97=0
local trigger t=null
if ZX7==null or GetUnitTypeId(ZX7)==0 or IsUnitIllusion(ZX7) then
return
endif
set OB7=GetHandleId(ZX7)
set t=LoadTriggerHandle(L7,OB7,StringHash("SuijiReincarnationDeathTrigger"))
if t!=null and OZ7_IsQueued(t)==false then
set t=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerAddCondition(t,Condition(function HBG))
call SaveUnitHandle(L7,I97,2,ZX7)
call SaveTriggerHandle(L7,OB7,StringHash("SuijiReincarnationDeathTrigger"),t)
set t=null
endfunction
// B595: this runs from the existing primary hero-death trigger before WU8.
// TriggerEvaluate keeps HBG authoritative while making registration order
// irrelevant; SuijiRevivalPending absorbs the unit-event tail of this death.
function SuijiRevival_GlobalDeath takes nothing returns nothing
local unit ZX7=GetDyingUnit()
local trigger t=null
local integer OB7=0
if ZX7==null or GetUnitTypeId(ZX7)==0 or IsUnitIllusion(ZX7) then
set ZX7=null
set t=null
return
endif
if DUN_HasAegis(ZX7) then
call DUN_StartAegisRevival(ZX7)
