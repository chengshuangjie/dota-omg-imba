function CHAYAN takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetSpellTargetX()
    local real y=GetSpellTargetY()
    local unit BB7
    local integer skill=B287_GetSpellAbilityId()
    local integer uid
    local integer wardCost=0
    local real d
    if skill=='A02X' then
        set uid='o004'
        set d=600.
    elseif skill=='A4SW' then
        set uid='oeye'
        set d=420. 
    elseif skill=='Y0H9' then
        set uid='o004'
        set d=600.
        set wardCost=Get_Item_Price('I05G')
    elseif skill=='Y0HA' then
        set uid='oeye'
        set d=420.
        set wardCost=Get_Item_Price('I05H')
    endif
    // Dedicated OMG courier ward skills spend the same live price as the
    // corresponding shop item.  Check before placement so a failed cast
    // neither creates a ward nor changes the player's gold.
    if wardCost>0 and (SUIJI_MODE==false or KW7(u)==false or GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<wardCost) then
        if SUIJI_MODE and KW7(u) and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<wardCost then
            call X37(p,"金币不足，无法放置守卫（需要 "+I2S(wardCost)+" 金币）")
        endif
        set u=null
        set p=null
        return
    endif
    if IsPointInRegion(oww,x,y)then //防插肉山眼
        if wardCost==0 then
            call AQ8(u,uid)
        endif
    elseif KW7(u) and PVP then
        if wardCost==0 then
            call AQ8(u,uid)
        endif
        call X37(GetOwningPlayer(u),"PVP模式下信使无法插眼")
    else
        set BB7=CreateUnit(p,uid,x,y,0)
        call SetUnitAnimation(BB7,"birth")
call UnitApplyTimedLife(BB7,'BTLF',d)
        call AN8(BB7,u)
        if wardCost>0 then
            call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-wardCost)
        endif
        call B832WardPlaced(p,BB7)
    endif
    set u=null
    set p=null
    set BB7=null
endfunction
