set YED=s+p+s+p+s+p+s+p+s+p+s+p+s
elseif YDD>70 then
set YED=s+p+s+p+s+p+s+p+s+p+s+p+c
elseif YDD>55 then
set YED=s+p+s+p+s+p+s+p+s+p+c+p+c
elseif YDD>40 then
set YED=s+p+s+p+s+p+s+p+c+p+c+p+c
