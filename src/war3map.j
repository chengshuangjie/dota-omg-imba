call SaveReal(L7,(I97),(811),((QQ5)*1.0))
endif
if YIO>QP5 then
if((LoadInteger(L7,(GetHandleId((IH7))),((4298))))==1)==false then
set UI5=UI5+YIO-QP5
call SaveReal(L7,(I97),(808),((UI5)*1.0))
else
call SetUnitState(IH7,UNIT_STATE_LIFE,YIO)
endif
endif
call SetUnitState(IH7,UNIT_STATE_LIFE,QP5)
endif
set t=null
set IH7=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
