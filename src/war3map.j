function JMG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
if OH7(OB7,"Light")!=null then
call DestroyLightning(OH7(OB7,"Light"))
endif
call NM7(OB7)
call OZ7(t)
set t=null
return false
endfunction
function JNG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit BU7=O77(OB7,"Projectile")
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real JOG=ON7(OB7,"OriginalAngle")
local real l4=Atan2(GetUnitY(m5)-GetUnitY(BU7),GetUnitX(m5)-GetUnitX(BU7))
local integer V77=OM7(OB7,"Level")
local real x=GetUnitX(BU7)+50*Cos(l4)
local real y=GetUnitY(BU7)+50*Sin(l4)
local unit BB7
local destructable d
local lightning G9E
local boolean Z18=OO7(OB7,"Active")
local real DUR=0.75+0.75*V77
local real YM7=25*V77
if GetTriggerEventId()==EVENT_UNIT_DEATH or BlockUnitPass(BU7) then
    call NM7(OB7)
    call OZ7(t)
    call KillUnit(BU7)
else
    call SetUnitX(BU7,x)
    call SetUnitY(BU7,y)
    call SetUnitFacing(BU7,l4*bj_RADTODEG)
    if KF7(x,y,GetUnitX(m5),GetUnitY(m5))<45 then
        set WV4=(LoadReal(L7,(OB7),(6)))
        set WW4=(LoadReal(L7,(OB7),(7)))
        call NM7(OB7)
        call OZ7(t)
if GetUnitTypeId(m5)!='n00L' and Z18 then
            set BB7=BW7(BU7,m5,JOG)
            set d=BT7(BU7,m5,JOG)
            if BB7!=null then
                set t=CreateTrigger()
                set OB7=GetHandleId(t)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                call B67(p5,m5,1,YM7)
                call CommonUnitAddStun(m5,DUR,false) 
                call LINGXIA(p5,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(BB7),GetUnitY(BB7),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,BB7)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(BB7),GetUnitY(BB7),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,BB7)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(BB7),GetUnitY(BB7),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,BB7)
                call B67(p5,BB7,1,YM7)
                call CommonUnitAddStun(BB7,DUR,false) 
                call TriggerRegisterTimerEvent(t,DUR,false)
                call TriggerAddCondition(t,Condition(function JMG))
                set G9E=AddLightning("MFPB",true,GetUnitX(m5),GetUnitY(m5),GetUnitX(BB7),GetUnitY(BB7))
                call SetLightningColor(G9E,.5,.5,1,1)
                call NW7(OB7,"Light",G9E)
            elseif d!=null then
                set t=CreateTrigger()
                set OB7=GetHandleId(t)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,V77+1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                call B67(p5,m5,1,YM7)
                call CommonUnitAddStun(m5,DUR,false) 
                call LINGXIA(p5,m5)
                call TriggerRegisterTimerEvent(t,DUR,false)
                call TriggerAddCondition(t,Condition(function JMG))
                set G9E=AddLightning("MFPB",true,GetUnitX(m5),GetUnitY(m5),GetDestructableX(d),GetDestructableY(d))
                call SetLightningColor(G9E,.5,.5,1,1)
                call NW7(OB7,"Light",G9E)
                call SetDestructableAnimation(d,"stand hit")
            else
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                // set AGF=CreateUnit(GetOwningPlayer(m5),1697656901,GetUnitX(m5),GetUnitY(m5),0)
                // call XF7(AGF,1093743177)
                // call SetUnitAbilityLevel(AGF,1093743177,1)
                // call IssueTargetOrderById(AGF,$D007F,m5)
                call B67(p5,m5,1,100)
                call CommonUnitAddStun(m5,1.,false) 
                call LINGXIA(p5,m5)
            endif
        endif
        call KillUnit(BU7)
    endif
endif
set t=null
set BU7=null
set m5=null
set G9E=null
set BB7=null
set d=null
return false
endfunction
function JPG takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit p5=(b1061SavedGetTriggerUnit)
local unit m5=(b1061SavedGetSpellTargetUnit)
local real l4=Atan2(GetUnitY(m5)-GetUnitY(p5),GetUnitX(m5)-GetUnitX(p5))
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BU7=CreateUnit(GetOwningPlayer(p5),'h077',GetUnitX(p5),GetUnitY(p5),l4*bj_RADTODEG)
local integer V77=B287_GetUnitAbilityLevel(p5,'A12J')
local boolean Z18=WQ7((b1061SavedGetSpellTargetUnit))==false
call NT7(OB7,"Projectile",BU7)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NP7(OB7,"Level",V77)
call NQ7(OB7,"OriginalAngle",(l4)*1.)
call NS7(OB7,"Active",Z18)
call SaveReal(L7,(OB7),(6),((GetUnitX(p5))*1.))
call SaveReal(L7,(OB7),(7),((GetUnitY(p5))*1.))
call TriggerRegisterTimerEvent(t,.033,true)
call TriggerAddCondition(t,Condition(function JNG))
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
set p5=null
set m5=null
set t=null
set BU7=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
function JQG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A12J' and WQ7(GetSpellTargetUnit())==false then
call JPG()
endif
return false
endfunction
function N78 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function JQG))
set t=null
endfunction
function JRG takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=OM7(OB7,"Level")
local integer JSG=OM7(OB7,"BonusID")
local integer durationTicks=OM7(OB7,"DurationTicks")
if durationTicks<=0 then
set durationTicks=$A*(2+V77)
endif
call DestroyEffect(AddSpecialEffect("effects\\Tornado.mdx",GetUnitX(p5),GetUnitY(p5)))
if GetTriggerEvalCount(t)>durationTicks or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call UnitRemoveAbility(p5,JSG)
call UnitRemoveAbility(p5,'B09W')
call DestroyEffect(OG7(OB7,"FX1"))
call DestroyEffect(OG7(OB7,"FX2"))
call NM7(OB7)
call OZ7(t)
endif
set t=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function JTG takes nothing returns nothing
local unit p5=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer V77=B287_GetUnitAbilityLevel(p5,'A14I')
local integer JSG
local real duration=(2.+V77)*SuijiMode_GetDurationMulticastCount(p5,'A14I')
set missiletmpunit=p5
call MHMissile_EnumInRange(GetUnitX(p5),GetUnitY(p5),2000.,function MISS_MISSILE)
if V77==1 then
set JSG='A135'
elseif V77==2 then
set JSG='A12O'
elseif V77==3 then
set JSG='A134'
elseif V77==4 then
set JSG='A139'
endif
call EnableAttackEffectByTime(0,duration)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),JSG,false)
call Z67(p5,JSG,1,duration)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function JRG))
call NT7(OB7,"Source",p5)
call NP7(OB7,"Level",V77)
call NP7(OB7,"BonusID",JSG)
call NP7(OB7,"DurationTicks",R2I(duration*10.))
call NU7(OB7,"FX1",AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,left"))
call NU7(OB7,"FX2",AddSpecialEffectTarget("effects\\Tornado.mdx",p5,"hand,right"))
set p5=null
set t=null
endfunction
function JUG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A14I' then
call JTG()
endif
return false
endfunction
function N88 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function JUG))
set t=null
endfunction
//强力击
function JVG takes unit p5,unit m5,real YM7,integer JWG,integer JXG returns nothing
call B67(p5,m5,1,(YM7)*Pow(0.9,JWG)*Pow(1.01,JXG))
endfunction
function JYG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),ZB)==false and CHUIFENG((b1060GetEnumUnit))==false then
call JVG(vc,(b1060GetEnumUnit),ec,ac,xc)
call GroupAddUnit(ZB,(b1060GetEnumUnit))
set ac=ac+1
endif
set b1060GetEnumUnit=null
endfunction
function JZG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit IJ=O77(OB7,"Projectile")
local real JDG=ON7(OB7,"TargetX")
local real JEG=ON7(OB7,"TargetY")
local real RK=ON7(OB7,"Angle")
local real YM7=ON7(OB7,"Damage")
local integer JXG=OM7(OB7,"TreeCount")
local integer JWG=OM7(OB7,"UnitCount")
local group JHG=OF7(OB7,"AlreadyHit")
local real x=X17(GetUnitX(IJ)+(60*Pow(0.9,JWG)*Pow(1.01,JXG))*Cos(RK))
local real y=X07(GetUnitY(IJ)+(60*Pow(0.9,JWG)*Pow(1.01,JXG))*Sin(RK))
local group g=WS7()
local real d
if GetTriggerEvalCount(t)>2 then
set d=175
else
set d=100
endif
call DestroyEffect(AddSpecialEffect("effects\\Tornado.mdx",x,y))
set JXG=JXG+Y67(x,y,75)
call NP7(OB7,"TreeCount",JXG)
set ZB=JHG
set vc=IJ
set ec=YM7
set xc=JXG
set ac=JWG
set IN4=IJ
call GroupEnumUnitsInRange(g,x,y,d,Condition(function AJ7_gai))
call ForGroup(g,function JYG)
call WR7(g)
call NP7(OB7,"UnitCount",ac)
call SetUnitX(IJ,x)
call SetUnitY(IJ,y)
if GetTriggerEvalCount(t)>46 or BlockUnitPass(IJ) then
call KillUnit(IJ)
call WR7(JHG)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set IJ=null
set JHG=null
set g=null
return false
endfunction
function SuijiMode_CreatePowershotProjectile takes unit p5,real targetX,real targetY,real power returns nothing
local real x2=targetX
local real y2=targetY
local real RK=Atan2(y2-GetUnitY(p5),x2-GetUnitX(p5))
local trigger t
local integer OB7
local unit IJ
local integer V77=B287_GetUnitAbilityLevel(p5,'A12K')
local real YM7=(75+75*V77)*power
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set IJ=CreateUnit(GetOwningPlayer(p5),'h078',GetUnitX(p5),GetUnitY(p5),RK*bj_RADTODEG)
set x2=GetUnitX(p5)+2600*Cos(RK)
set y2=GetUnitY(p5)+2600*Sin(RK)
call NT7(OB7,"Projectile",IJ)
call NQ7(OB7,"TargetX",x2)
call NQ7(OB7,"TargetY",y2)
call NQ7(OB7,"Angle",RK)
call NQ7(OB7,"Damage",YM7)
call NP7(OB7,"TreeCount",0)
call NP7(OB7,"UnitCount",0)
call NB7(OB7,"AlreadyHit",WS7())
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function JZG))
set p5=null
set t=null
set IJ=null
endfunction
function JAG takes nothing returns nothing
local unit p5=GetTriggerUnit()
local real x2=ON7(GetHandleId(p5),"ReverseLance|x")
local real y2=ON7(GetHandleId(p5),"ReverseLance|y")
local real JBG=YJ7(KQ7()-ON7(GetHandleId(p5),"ReverseLance|Time"),1.)
local integer count=LoadInteger(L7,GetHandleId(p5),StringHash("SuijiPowershotMulticastCount"))
local integer i=1
if LoadReal(L7,GetHandleId(p5),StringHash("SuijiPowershotMulticastUntil"))<TimerGetElapsed(W) or count<1 then
set count=1
endif
loop
exitwhen i>count
call SuijiMode_CreatePowershotProjectile(p5,x2,y2,JBG)
set i=i+1
endloop
call SaveInteger(L7,GetHandleId(p5),StringHash("SuijiPowershotMulticastCount"),1)
set p5=null
endfunction
function JCG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
call SetUnitTimeScale(WI7,1)
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
return false
endfunction
function J3G takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
call RemoveLocation(l)
call NQ7(GetHandleId(WI7),"ReverseLance|x",x)
call NQ7(GetHandleId(WI7),"ReverseLance|y",y)
call NQ7(GetHandleId(WI7),"ReverseLance|Time",KQ7())
call SetUnitTimeScale(WI7,.75)
call NT7(OB7,"Hero",WI7)
call TriggerRegisterTimerEvent(t,.75,false)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function JCG))
set l=null
set t=null
set WI7=null
endfunction
function J6G takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetSpellAbilityId()=='A12K' then
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_CAST then
call NS7(GetHandleId(b1060GetTriggerUnit),"ReverseLance|Active",false)
call J3G()
elseif b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call NS7(GetHandleId(b1060GetTriggerUnit),"ReverseLance|Active",true)
elseif OO7(GetHandleId(b1060GetTriggerUnit),"ReverseLance|Active") then
call JAG()
endif
endif
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function N98 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function J6G))
set t=null
endfunction
