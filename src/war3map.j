	call DzFrameClearAllPoints(MapSettingsShortcutButton)
	call DzFrameSetAbsolutePoint(MapSettingsShortcutButton,0,.475000,.038889)
	call DzFrameSetPriority(MapSettingsShortcutButton,95)
	call DzFrameSetAlpha(MapSettingsShortcutButton,0)
	call DzFrameSetScriptByCode(MapSettingsShortcutButton,1,function MapSettingsShortcut_OnClick,false)
