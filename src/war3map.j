local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer WF8=OM7(I97,"Count")
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='Aeat' then
call NP7(I97,"Count",16)
endif
elseif XH7(ZX7)or b1060GetTriggerEventId==EVENT_UNIT_DEATH or WF8==0 then
call UnitRemoveAbility(ZX7,'A0PV')
call UnitRemoveAbility(ZX7,'B07L')
call OX7(ZX7,"ActiveTango")
call NM7(I97)
call OZ7(t)
else
if IsUnitEnemy(b1060GetTriggerUnit,GetOwningPlayer(b1060GetSpellTargetUnit))and(GetUnitTypeId(b1060GetSpellTargetUnit)=='oeye' or GetUnitTypeId(b1060GetSpellTargetUnit)=='o004')then
call NP7(I97,"double",1)
call B67(b1060GetTriggerUnit,b1060GetSpellTargetUnit,10,999999)
endif
if OM7(I97,"double")==1 then
call SetUnitState(ZX7,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE)+230/16)
if GetUnitState(ZX7,UNIT_STATE_LIFE)!=GetUnitState(ZX7,UNIT_STATE_MAX_LIFE) then
call HXXS("+14",1,ZX7,.03)
endif
else
call SetUnitState(ZX7,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE)+115/16)
if GetUnitState(ZX7,UNIT_STATE_LIFE)!=GetUnitState(ZX7,UNIT_STATE_MAX_LIFE) then
call HXXS("+7",1,ZX7,.03)
endif
endif
call NP7(I97,"Count",WF8-1)
endif
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function BSF takes nothing returns nothing
local unit p5=GetTriggerUnit()
