function SuijiMode_ScriptedDragonSplash takes nothing returns boolean
local unit source=MHDamageEvent_GetSource()
local unit primary=MHEvent_GetUnit()
local unit target=null
local group g=null
local integer h=0
local real damage=MHDamageEvent_GetDamage()
local real distance=0.
local real factor=0.
if source==null or primary==null or damage<=0. or MHDamageEvent_IsPhysical()==false then
set source=null
set primary=null
return false
endif
if GetUnitTypeId(source)==0 or GetUnitTypeId(primary)==0 then
set source=null
set primary=null
return false
endif
set h=GetHandleId(source)
if OO7(h,"SuijiScriptedDragonForm")==false or OM7(h,"SuijiScriptedDragonLevel")<2 or OO7(h,"SuijiScriptedDragonSplashRunning") then
set source=null
set primary=null
return false
endif
call NS7(h,"SuijiScriptedDragonSplashRunning",true)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(primary),GetUnitY(primary),300.,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(primary)==0
call GroupRemoveUnit(g,target)
if target!=primary and UnitAlive(target) and IsUnitEnemy(target,GetOwningPlayer(source)) and IsUnitType(target,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(target,'Avul')==0 then
set distance=KE7(primary,target)
if distance<=150. then
set factor=1.
elseif distance<=225. then
set factor=.75
else
set factor=.50
endif
call UnitDamageTarget(source,target,damage*factor,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
endif
endloop
call DestroyGroup(g)
call NS7(h,"SuijiScriptedDragonSplashRunning",false)
set target=null
set g=null
set source=null
set primary=null
return false
endfunction
