else
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,E9,30,"  ")
call DisplayTimedTextToPlayer(GetOwningPlayer(u1),0,E9,30,"|cff99ccff你要求和以下玩家交换英雄 |r"+Q[GetPlayerId(GetOwningPlayer(u2))]+GetUnitName(u2)+"|r")
