function SuijiMode_IsEarthSpiritCompanionOwner takes unit u returns boolean
local integer unitType=0
local integer h=0
local integer logical1=0
local integer logical2=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set unitType=GetUnitTypeId(u)
if unitType=='N0MU' or unitType=='N0MV' then
return true
endif
set h=GetHandleId(u)
if B1099EarthHasSkills(u) then
return true
endif
if unitType!='E02X' and unitType!='Z02X' then
return false
endif
set logical1=LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical1"))
set logical2=LoadInteger(L7,h,StringHash("SuijiRubickStolenLogical2"))
if LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel1"))>0 and (logical1=='A2V6' or logical1=='A2V4' or logical1=='A2V5' or logical1=='A2V7') then
return true
endif
return LoadInteger(L7,h,StringHash("SuijiRubickStolenLevel2"))>0 and (logical2=='A2V6' or logical2=='A2V4' or logical2=='A2V5' or logical2=='A2V7')
endfunction
function SuijiMode_ClearEarthSpiritCompanions takes unit u returns nothing
local integer i=0
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
loop
exitwhen i>6
call UnitRemoveAbility(u,JMI[i])
call UnitRemoveAbility(u,'YS00'+i)
call UnitRemoveAbility(u,'YS10'+i)
call UnitRemoveAbility(u,'YS20'+i)
set i=i+1
endloop
call UnitRemoveAbility(u,'A2VM')
call UnitRemoveAbility(u,'A2Z4')
call RemoveSavedInteger(L7,h,800)
call RemoveSavedBoolean(L7,h,StringHash("SuijiSource58UnitInit"))
call RemoveSavedBoolean(L7,h,StringHash("B1099EarthScepterKnown"))
call RemoveSavedBoolean(L7,h,StringHash("B1099EarthScepter"))
call RemoveSavedInteger(L7,h,StringHash("B1099EarthStoneFamily"))
endfunction
function ZIQ6 takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real B18=(LoadReal(L7,(I97),(442)))
local integer N5E=(LoadInteger(L7,(GetHandleId(ZX7)),(800)))

if ZX7==null or GetUnitTypeId(ZX7)==0 or SuijiMode_IsEarthSpiritCompanionOwner(ZX7)==false then
if ZX7!=null then
call SuijiMode_ClearEarthSpiritCompanions(ZX7)
if LoadTriggerHandle(L7,GetHandleId(ZX7),StringHash("B1099EarthChargeOwner"))==t then
call RemoveSavedHandle(L7,GetHandleId(ZX7),StringHash("B1099EarthChargeOwner"))
endif
endif
call NM7(I97)
call OZ7(t)
set ZX7=null
set t=null
set b1060GetTriggerEventId=null
return false
endif
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_CAST then
if (b1060B287_GetSpellAbilityId=='A2V8' or b1060B287_GetSpellAbilityId=='A2VF' or b1060B287_GetSpellAbilityId=='A2VG' or b1060B287_GetSpellAbilityId=='A2VH' or b1060B287_GetSpellAbilityId=='A2VI' or b1060B287_GetSpellAbilityId=='A2VJ' or b1060B287_GetSpellAbilityId=='A2VK') and N5E<=0 then
call KR7(ZX7)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if b1060B287_GetSpellAbilityId=='A2V8' or b1060B287_GetSpellAbilityId=='A2VF' or b1060B287_GetSpellAbilityId=='A2VG' or b1060B287_GetSpellAbilityId=='A2VH' or b1060B287_GetSpellAbilityId=='A2VI' or b1060B287_GetSpellAbilityId=='A2VJ' or b1060B287_GetSpellAbilityId=='A2VK' or b1060B287_GetSpellAbilityId=='A2V4' then
if b1060B287_GetSpellAbilityId=='A2V4' then
call ZIS6(ZX7,null)
endif
endif
elseif N5E<6 then
set B18=B18-0.2
call SaveReal(L7,(I97),(442),((B18)*1.0))
if B18<=0.001 then
set N5E=N5E+1
call SaveInteger(L7,(GetHandleId(ZX7)),(800),(N5E))
call SaveReal(L7,I97,443,B1099EarthRechargeInterval(ZX7))
call SaveReal(L7,I97,442,LoadReal(L7,I97,443))
call B1099EarthSyncStone(ZX7,N5E)
endif
endif
set ZX7=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ZIU6 takes unit ZX7 returns nothing
local trigger t=null
local integer I97=0
if ZX7==null or GetUnitTypeId(ZX7)==0 or IsUnitIllusion(ZX7) then
return
endif
set t=LoadTriggerHandle(L7,GetHandleId(ZX7),StringHash("B1099EarthChargeOwner"))
if t!=null then
call B1099EarthSyncStone(ZX7,LoadInteger(L7,GetHandleId(ZX7),800))
set t=null
return
endif
set B1099EarthEntryUnit=ZX7
call ExecuteFunc("B1099EarthChooseStoneFamily")
set B1099EarthEntryUnit=null
call B1099EarthSetScepter(ZX7,SuijiMode_EarlyDetectAghanimSourceState(ZX7,null))
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveTriggerHandle(L7,GetHandleId(ZX7),StringHash("B1099EarthChargeOwner"),t)
call TriggerRegisterTimerEvent(t,0.2,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_CAST)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZIQ6))
call SaveUnitHandle(L7,I97,2,ZX7)
call SaveReal(L7,I97,443,B1099EarthRechargeInterval(ZX7))
call SaveReal(L7,I97,442,LoadReal(L7,I97,443))
call SaveInteger(L7,GetHandleId(ZX7),800,6)
call B1099EarthSyncStone(ZX7,6)
set t=null
endfunction
function RJ1 takes nothing returns nothing
call ZIU6(IN4)
endfunction
