set h8[leaveAIPlayerId]=h7[51]
endif
if B946DetectCount>0 then
set h8[16+leaveAIPlayerId]=B960H8(16+leaveAIPlayerId,h7[55],"KKLeaveAI_SetLane @ war3map.j:160155 (B968)")
