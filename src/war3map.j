function U_G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real a=(LoadReal(L7,(I97),($89)))
local real Y_7=(LoadReal(L7,(I97),(47)))
local real Z47=(LoadReal(L7,(I97),(48)))
local real AQ9=(LoadReal(L7,(I97),($BD)))
local real AR9=(LoadReal(L7,(I97),($BE)))
local group g
local real d=KF7(AQ9,AR9,Y_7,Z47)/25
local location l
local integer WF8=GetTriggerEvalCount(t)
local integer id=(LoadInteger(L7,(I97),(20)))
local real x=AQ9+d*WF8*Cos(a)
local real y=AR9+d*WF8*Sin(a)
local string tx
if id=='Z02X' then
    set tx="model\\Hero_GrandMagus_N1S_Z_Down.mdl"
else
    set tx="Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl"
endif
call SetUnitX(IH7,X17(x))
call SetUnitY(IH7,X07(y))
if KCD(IH7)==false then
call SetUnitFlyHeight(IH7,325-$D*WF8,0)
endif
if WF8==25 or IsHideUnit(IH7) then
if IsHideUnit(IH7)==false then
    call SetUnitX(IH7,X17(Y_7))
    call SetUnitY(IH7,X07(Z47))
    if IsPointInRegion(IU4,GetUnitX(IH7),GetUnitY(IH7)) then
    set l=YV8(GetUnitX(IH7),GetUnitY(IH7))
    call SetUnitX(IH7,X57(GetLocationX(l)))
    call SetUnitY(IH7,X27(GetLocationY(l)))
    call RemoveLocation(l)
    set l=null
    endif
    set IN4=ZX7
    set ZG4=ZX7
    set g=WS7()
    call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),350,Condition(function AJ7_gai))
    call GroupRemoveUnit(g,IH7)
    call ForGroup(g,function U2G)
    call WR7(g)
    call Y67(GetUnitX(IH7),GetUnitY(IH7),$96)
    call DestroyEffect(AddSpecialEffect(tx,GetUnitX(IH7),GetUnitY(IH7)))
endif
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
if KCD(IH7)==false then
call SetUnitFlyHeight(IH7,GetUnitDefaultFlyHeight(IH7),0)
endif
call SetUnitPathing(IH7,true)
endif
set t=null
set ZX7=null
set IH7=null
set g=null
return false
endfunction
function V4G takes unit ZX7,unit IH7,unit Target2,real V7G,real V8G,effect FX,effect V9G returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local real Y_7=V7G
local real Z47=V8G
local real a=J77(GetUnitX(IH7),GetUnitY(IH7),V7G,V8G)*bj_DEGTORAD
if KF7(GetUnitX(IH7),GetUnitY(IH7),V7G,V8G)>375 then
set Y_7=GetUnitX(IH7)+375*Cos(a)
set Z47=GetUnitY(IH7)+375*Sin(a)
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveReal(L7,(I97),($89),((a)*1.))
call SaveReal(L7,(I97),(47),((Y_7)*1.))
call SaveReal(L7,(I97),(48),((Z47)*1.))
call SaveReal(L7,(I97),($BD),((GetUnitX(IH7))*1.))
call SaveReal(L7,(I97),($BE),((GetUnitY(IH7))*1.))
call SaveEffectHandle(L7,(I97),(32),(FX))
call SaveEffectHandle(L7,(I97),($B0),(V9G))
call SaveInteger(L7,(I97),(20),((GetUnitTypeId(ZX7))))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function U_G))
set t=null
endfunction
function VDG takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
local integer Z49=(LoadInteger(L7,(I97),($C)))
local real Y_7=(LoadReal(L7,(I97),(47)))
local real Z47=(LoadReal(L7,(I97),(48)))
local integer VEG=(LoadInteger(L7,(I97),(706)))
local integer id=(LoadInteger(L7,(I97),(20)))
local real a
local string tx
if id=='Z02X' then
    set tx="model\\Hero_GrandMagus_N1S_Z_Target_Point.mdl"
else
    set tx="Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl"
endif
if b1060GetTriggerEventId==EVENT_WIDGET_DEATH or(b1060GetTriggerEventId!=EVENT_UNIT_SPELL_EFFECT and YM8(IH7)==false) or IsHideUnit(IH7) then
call SuijiMode_TelekinesisButtonEnd(ZX7)
    call V4G(ZX7,IH7,(LoadUnitHandle(L7,(I97),(711))),Y_7,Z47,(LoadEffectHandle(L7,(I97),(32))),(LoadEffectHandle(L7,(I97),($B0))))
    if id=='Z02X' then
        call DestroyEffect((LoadEffectHandle(L7,(I97),(99))))
    endif
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if b1060B287_GetSpellAbilityId=='A27X' then
        call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
        set a=J77(GetUnitX(IH7),GetUnitY(IH7),b1060GetSpellTargetX,b1060GetSpellTargetY)*bj_DEGTORAD
        if KF7(GetUnitX(IH7),GetUnitY(IH7),b1060GetSpellTargetX,b1060GetSpellTargetY)>375 then
            set Y_7=GetUnitX(IH7)+375*Cos(a)
            set Z47=GetUnitY(IH7)+375*Sin(a)
        else
            set Y_7=b1060GetSpellTargetX
            set Z47=b1060GetSpellTargetY
        endif
        call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffect(tx,Y_7,Z47)))
        call SaveReal(L7,(I97),(47),((Y_7)*1.))
        call SaveReal(L7,(I97),(48),((Z47)*1.))
        call SaveUnitHandle(L7,(I97),(711),(b1060GetSpellTargetUnit))
        call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffectTarget(tx,b1060GetSpellTargetUnit,"origin")))
    endif
else
    set WF8=WF8+1
    call SaveInteger(L7,(I97),(34),(WF8))
    call SetUnitPathing(IH7,false)
    if(LoadInteger(L7,(I97),(707)))==1 then
        set VEG=VEG+3
    else
        set VEG=VEG-3
    endif
    call SaveInteger(L7,(I97),(706),(VEG))
    if VEG==30 then
        call SaveInteger(L7,(I97),(707),(-1))
    elseif VEG==-30 then
        call SaveInteger(L7,(I97),(707),(1))
    endif
    if KCD(IH7)==false then
        if WF8<15 then
            call SetUnitFlyHeight(IH7,WF8*20,0)
        else
            call SetUnitFlyHeight(IH7,300+VEG,0)
        endif
    endif
    if WF8>(Z49-25)then
        if KCD(IH7)==false then
            call SetUnitFlyHeight(IH7,300,0)
        endif
call SuijiMode_TelekinesisButtonEnd(ZX7)
        call V4G(ZX7,IH7,(LoadUnitHandle(L7,(I97),(711))),Y_7,Z47,(LoadEffectHandle(L7,(I97),(32))),(LoadEffectHandle(L7,(I97),($B0))))
        if id=='Z02X' then
            call DestroyEffect((LoadEffectHandle(L7,(I97),(99))))
        endif
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
    endif
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function VFG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer BC7=GetUnitAbilityLevel(ZX7,'A27F')
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer id=GetUnitTypeId(ZX7)
local string tx
local string tx2
local string tx3=""
if SuijiMode_EnsureExactLiveAbility(ZX7,'A27X',true)==false then
call RemoveUnit(BB7)
call OZ7(t)
set ZX7=null
set IH7=null
set BB7=null
set t=null
return
endif
call UnitAddAbility(BB7,'A282')
call SetUnitAbilityLevel(BB7,'A282',BC7)
call B947IssueTargetOrderById("VFG @ war3map.j:207051 (B968)",BB7,$D007F,IH7)
call MHAbility_SetCustomDataInt(ZX7,'A27X',ABILITY_DEF_DATA_BUTTON_X,0)
call MHAbility_SetCustomDataInt(ZX7,'A27X',ABILITY_DEF_DATA_BUTTON_Y,2)
call SuijiMode_TelekinesisButtonBegin(ZX7)
call SetUnitPathing(IH7,false)
if KCD(IH7)==false then
call XF7(IH7,'Amrf')
call UnitRemoveAbility(IH7,'Amrf')
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveUnitHandle(L7,(I97),(711),(IH7))
call SaveInteger(L7,(I97),($C),(R2I((1.25+.25*BC7)/.02)))
call SaveInteger(L7,(I97),(34),(0))
call SaveInteger(L7,(I97),(706),(0))
call SaveInteger(L7,(I97),(707),(1))
call SaveInteger(L7,(I97),(20),(id))
call SaveReal(L7,(I97),(47),((GetUnitX(IH7))*1.))
call SaveReal(L7,(I97),(48),((GetUnitY(IH7))*1.))
if id=='Z02X' then
    set tx="model\\Hero_GrandMagus_N1S_Z_Target_Unit.mdl"
    set tx2="model\\Hero_GrandMagus_N1S_Z_Target_Point.mdl"
    if GetLocalPlayer()==GetOwningPlayer(ZX7) or WG7(GetLocalPlayer())then
        set tx3="model\\Hero_GrandMagus_N1S_Z_Circle.mdl"
    endif
    call SaveEffectHandle(L7,(I97),(99),(AddSpecialEffect(tx3,GetUnitX(IH7),GetUnitY(IH7))))
else
    set tx="war3mapImported\\AntiGravityTarget.mdx"
    set tx2="Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl"
endif
call SaveEffectHandle(L7,(I97),(32),(AddSpecialEffectTarget(tx,IH7,"origin")))
call SaveEffectHandle(L7,(I97),($B0),(AddSpecialEffect(tx2,GetUnitX(IH7),GetUnitY(IH7))))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterDeathEvent(t,IH7)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function VDG))
call LINGXIA(ZX7,IH7)
set ZX7=null
set IH7=null
set BB7=null
set t=null
endfunction
function VGG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A27F' and WQ7(GetSpellTargetUnit())==false then
call VFG()
endif
return false
endfunction
