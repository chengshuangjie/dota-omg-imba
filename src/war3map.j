function OXG takes nothing returns boolean
return (B287_GetLearnedSkill()=='A500' or B287_GetLearnedSkill()=='A501' or B287_GetLearnedSkill()=='A502' or B287_GetLearnedSkill()=='A503') and GetUnitAbilityLevel(GetTriggerUnit(),'A504')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A505')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A506')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A507')==0 and GetUnitAbilityLevel(GetTriggerUnit(),'A508')==0
endfunction
function OYG takes nothing returns boolean
return GetIssuedOrderId()==$D023F
endfunction
function OZG takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit OAG=O77(GetHandleId(t),"FormlessUnit")
local integer OBG
call B947IssueImmediateOrderById("OZG @ war3map.j:201942 (B968)",OAG,$D0240)
if GetUnitAbilityLevel(OAG,'A504')>0 then
set OBG='A509'
elseif GetUnitAbilityLevel(OAG,'A505')>0 then
set OBG='A50A'
elseif GetUnitAbilityLevel(OAG,'A506')>0 then
set OBG='A50B'
elseif GetUnitAbilityLevel(OAG,'A507')>0 then
set OBG='A50C'
elseif GetUnitAbilityLevel(OAG,'A508')>0 then
set OBG=0
endif
call UnitRemoveAbility(OAG,'A509')
call UnitRemoveAbility(OAG,'A50A')
call UnitRemoveAbility(OAG,'A50B')
call UnitRemoveAbility(OAG,'A50C')
if OBG!=0 then
call UnitAddAbility(OAG,OBG)
call SetPlayerAbilityAvailable(GetOwningPlayer(OAG),OBG,false)
endif
call NM7(GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set OAG=null
endfunction
function OCG takes nothing returns nothing
local unit OAG=GetTriggerUnit()
local timer t=CreateTimer()
call NT7(GetHandleId(t),"FormlessUnit",OAG)
call TimerStart(t,0,false,function OZG)
set OAG=null
set t=null
endfunction
function O3G takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer N0G=GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,b1060GetTriggerUnit,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function OYG))
call TriggerAddAction(t,function OCG)
if B287_GetLearnedSkill()!='A500' then
call UnitAddAbility(b1060GetTriggerUnit,'A500')
call UnitRemoveAbility(b1060GetTriggerUnit,'A500')
elseif B287_GetLearnedSkill()!='A501' then
call UnitAddAbility(b1060GetTriggerUnit,'A501')
call UnitRemoveAbility(b1060GetTriggerUnit,'A501')
elseif B287_GetLearnedSkill()!='A502' then
call UnitAddAbility(b1060GetTriggerUnit,'A502')
call UnitRemoveAbility(b1060GetTriggerUnit,'A502')
elseif B287_GetLearnedSkill()!='A503' then
call UnitAddAbility(b1060GetTriggerUnit,'A503')
call UnitRemoveAbility(b1060GetTriggerUnit,'A503')
endif
call UnitAddAbility(b1060GetTriggerUnit,'A505')
call UnitRemoveAbility(b1060GetTriggerUnit,'A505')
call UnitAddAbility(b1060GetTriggerUnit,'A506')
call UnitRemoveAbility(b1060GetTriggerUnit,'A506')
call UnitAddAbility(b1060GetTriggerUnit,'A507')
call UnitRemoveAbility(b1060GetTriggerUnit,'A507')
call UnitAddAbility(b1060GetTriggerUnit,'A508')
call UnitRemoveAbility(b1060GetTriggerUnit,'A508')
call UnitAddAbility(b1060GetTriggerUnit,'A504')
set t=null
set b1060GetTriggerUnit=null
endfunction
