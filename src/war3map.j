if P67!=null then
call KX7(P67)
endif
set PC7=CreateItem(ZU[YC],GetUnitX(it),GetUnitY(it))
set P37=UnitAddItem(it,PC7)
call J_7(.3)
else
if(MR7(it,ZU[FV]))then
set U84[O5]=bj_lastCreatedItem
set P37=true
endif
if P37 then
call DisableTrigger(H94)
call UnitRemoveItem(it,U84[O5])
call SetItemPosition(U84[O5],9999,-9999)
call EnableTrigger(H94)
set PC7=CreateItem(ZU[YC],GetUnitX(it),GetUnitY(it))
set P37=UnitAddItem(it,PC7)
set UD4[O5]=true
call J_7(.3)
endif
endif
set P67=null
if(not P37)then
call KX7(PC7)
call J_7(.2)
if((not MS7(it)))then
call UnitAddItem(it,U84[O5])
set UD4[O5]=false
set U84[O5]=null
endif
endif
if(MR7(it,ZU[YC]))then
call PZ7(it)
set P37=UnitUseItemPoint(it,MV7(it,ZU[YC]),P27,P_7)
call J_7(.5)
set PC7=null
set P17=P37
if not P17 then
call J_7(.01)
set P17=(eY[$E0+O5]>R2I(Bz)+1)
endif
endif
endif
if P17 then
set eY[$E0+O5]=R2I(Bz)+20
set eY[$D0+O5]=0
if B946DetectCount>0 then
set h8[$90+O5]=B960H8($90+O5,null,"PB7 @ war3map.j:22368 (B968)")
else
