function ADD_CONTENT takes unit u,player p,integer rJ returns nothing
local integer slot
local item KA7
local unit lotteryCircle=null
//注册释放技能事件
call TriggerRegisterUnitEvent(Tri_skill,u,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(Tri_skill,u,EVENT_UNIT_SPELL_CAST)
//查看队友技能
if IsUnitAlly(u, GetLocalPlayer()) then
	call MHUnit_EnableViewSkill(u , GetLocalPlayer())
endif
if CHOUJIANGSTATE[rJ]==1 and XOMG_IMBA_ENABLED then
set lotteryCircle=SuijiTavernB295_GetEnergyCircle(rJ)
if lotteryCircle!=null and GetUnitTypeId(lotteryCircle)!=0 then
call UnitAddAbility(lotteryCircle,'A4DK')
if GetGameTime()<17 then
call YDWESetUnitAbilityState(lotteryCircle, 'A4DK', 1, 17-GetGameTime())
endif
endif
endif
//设置皮肤DEMO，且单位不是皮肤英雄
if GetPlayerController(p)==MAP_CONTROL_USER and p==GetLocalPlayer() and XWE_PIFU(rJ,u,GetUnitTypeId(u))==false and IS11==false then
call SET_PIFU_DEMO(u,p)
call SET_PIFU_DEMO_NULL(p)
endif
//修复AI复活不买装备
if D4 and GetPlayerController(p)==MAP_CONTROL_COMPUTER and IsUnitType(u,UNIT_TYPE_HERO) then
set GE7[$E0+rJ]=false
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL16[rJ]==1 then
call XF7(u,'A2Q5')
call XF7(u,'A2Q3')
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL22[rJ]==1 then
call XF7(u,'A330')
call CHIA_SKILL(u,p)
call CHIA_TX(u,p)
call XF7(u,'A2VW')
call XF7(u,'A334')
endif
if D4 and XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and MAXLEVEL[rJ]==1 then
set AISZ[rJ]=0
set AIXLSZ[rJ]=0
endif
if CHIA[rJ]==1 then
call XF7(u,'A330')
call CHIA_SKILL(u,p)
call CHIA_TX(u,p)
endif
if CHILLX[rJ]==1 then
call XF7(u,'A2VW')
call XF7(u,'A334')
call CHILLX_SKILL(u,p)
endif
if CHIYY[rJ]==1 then
call XF7(u,'A2Q5')
call XF7(u,'A2Q3')
endif
//自动学习技能
if D4 and GetUnitLevel(u)>19 and GetPlayerController(p)==MAP_CONTROL_USER and u!=B891MiaoInstalling then
call LEARN_SKILL(u,rJ)
endif
//重置A杖效果
if D4 and CHIA[rJ]==0 and GetPlayerController(p)==MAP_CONTROL_USER and u!=B891MiaoInstalling then
set slot=FIND_SLOT(u,1)
if slot>-1 then
call RemoveItem(UnitItemInSlot(u,slot))
set KA7=UnitAddItemById(u,ZU[F59(u)])
call SetItemPlayer(KA7,GetOwningPlayer(u),false)
call SetItemUserData(KA7,1)
set KA7=null
endif
endif
//禁止自动攻击
if DISZDGJ[rJ] and GetPlayerController(p)==MAP_CONTROL_USER then
    call Disable_Unit_Auto_Attack(u,true)
endif
call CK7(u)
set lotteryCircle=null
endfunction
