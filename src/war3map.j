function B933HauntStop takes trigger hauntController returns nothing
local integer hauntKey=GetHandleId(hauntController)
local integer hauntOwnerKey=LoadInteger(L7,hauntKey,StringHash("B933HauntOwnerKey"))
local integer hauntImageKey=LoadInteger(L7,hauntKey,StringHash("B933HauntImageKey"))
call DisableTrigger(hauntController)
if hauntOwnerKey!=0 and hauntImageKey!=0 then
call RemoveSavedHandle(L7,hauntOwnerKey,StringHash("HauntTarget")+hauntImageKey)
endif
call NM7(hauntKey)
call OZ7(hauntController)
endfunction
function IZE takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit XU=O77(OB7,"HauntImage")
local unit m5=O77(OB7,"HauntTarget")
local integer IAE=OM7(OB7,"HauntPhase")
local group g
local boolexpr hP
if XU==null or GetUnitTypeId(XU)==0 or not UnitAlive(XU) then
// Cleanup uses captured integer identities, never the removed image's owner.
call B933HauntStop(t)
set t=null
set XU=null
set m5=null
set b1060GetTriggerEventId=null
return
endif
if b1060GetTriggerEventId!=EVENT_UNIT_DEATH and b1060GetTriggerEventId!=EVENT_UNIT_ISSUED_TARGET_ORDER and b1060GetTriggerEventId!=EVENT_UNIT_ISSUED_POINT_ORDER then
set IAE=IAE+1
call NP7(OB7,"HauntPhase",IAE)
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call B933HauntStop(t)
elseif IsUnitPaused(XU)==false then
if IAE==2 then
call SetUnitVertexColor(XU,$FF,$FF,$FF,$FF)
endif
if IAE>1 then
call DisableTrigger(t)
if m5!=null and GetUnitTypeId(m5)!=0 and UnitAlive(m5) then
call B947IssueTargetOrderById("IZE @ war3map.j:108801 (B968)",XU,$D000F,m5)
else
set g=WS7()
set IN4=XU
set hP=Condition(function IZE_PD)
call GroupEnumUnitsInRange(g,GetUnitX(XU),GetUnitY(XU),1000.,hP)
call DestroyBoolExpr(hP)
set m5=M59(g,GetUnitX(XU),GetUnitY(XU))
if m5!=null then
call NT7(OB7,"HauntTarget",m5)
call B947IssueTargetOrderById("IZE @ war3map.j:108811 (B968)",XU,$D000F,m5)
else
call B947IssuePointOrderById("IZE @ war3map.j:108813 (B968)",XU,$D000F,GetUnitX(XU),GetUnitY(XU))
endif
call WR7(g)
endif
if O77(OB7,"HauntImage")==XU then
call EnableTrigger(t)
endif
elseif m5!=null and GetUnitTypeId(m5)!=0 and UnitAlive(m5) then
call DisableTrigger(t)
call B947IssueTargetOrderById("IZE @ war3map.j:108822 (B968)",XU,$D0012,m5)
if O77(OB7,"HauntImage")==XU then
call EnableTrigger(t)
endif
endif
endif
set t=null
set XU=null
set m5=null
set g=null
set hP=null
set b1060GetTriggerEventId=null
endfunction
function IBE takes nothing returns boolean
return GetUnitAbilityLevel(GetSummonedUnit(),'B06L')>0
endfunction
function ICE takes nothing returns nothing
local unit b1060GetSummonedUnit=GetSummonedUnit()
local unit b1060GetSummoningUnit=GetSummoningUnit()
local unit WI7=GetTriggerUnit()
local unit oA=b1060GetSummoningUnit
local unit XU=b1060GetSummonedUnit
local unit m5=O77(GetHandleId(oA),"HauntTarget")
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0H9')
local trigger t=CreateTrigger()
if oA==null or XU==null or m5==null or GetUnitTypeId(oA)==0 or GetUnitTypeId(XU)==0 or GetUnitTypeId(m5)==0 then
if XU!=null then
call KillUnit(XU)
endif
if oA!=null then
call NM7(GetHandleId(oA))
endif
call OZ7(t)
set t=null
set m5=null
set XU=null
set oA=null
set WI7=null
set b1060GetSummonedUnit=null
set b1060GetSummoningUnit=null
return
endif
call SaveUnitHandle(L7,GetHandleId(M7[GetPlayerId(GetOwningPlayer(oA))]),StringHash("HauntTarget")+GetHandleId(XU),m5)
call SaveInteger(L7,GetHandleId(t),StringHash("B933HauntOwnerKey"),GetHandleId(M7[GetPlayerId(GetOwningPlayer(oA))]))
call SaveInteger(L7,GetHandleId(t),StringHash("B933HauntImageKey"),GetHandleId(XU))
call SetUnitPathing(XU,false)
call SetUnitMoveSpeed(XU,339+61*BC7)
call SetUnitX(XU,GetUnitX(m5))
call SetUnitY(XU,GetUnitY(m5))
call B947IssueTargetOrderById("ICE @ war3map.j:108866 (B968)",XU,$D0012,m5)
call SetUnitVertexColor(XU,$FF,$FF,$FF,50)
call TriggerRegisterUnitEvent(t,XU,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,XU,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,XU,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddAction(t,function IZE)
call DestroyEffect(AddSpecialEffect("units\\nightelf\\SpiritOfVengeance\\SpiritOfVengeance.mdl",GetUnitX(XU),GetUnitY(XU)))
call NT7(GetHandleId(t),"HauntTarget",m5)
call NT7(GetHandleId(t),"HauntImage",XU)
call NP7(GetHandleId(t),"HauntPhase",0)
if(OF7(GetHandleId(GetOwningPlayer(b1060GetSummoningUnit)),"MGrp")!=null)then
call GroupAddUnit(OF7(GetHandleId(GetOwningPlayer(b1060GetSummoningUnit)),"MGrp"),b1060GetSummonedUnit)
call SetUnitUserData(b1060GetSummonedUnit,GetPlayerId(GetOwningPlayer(O77(GetHandleId(oA),"HauntTarget"))))
endif
call NM7(GetHandleId(oA))
set t=null
set m5=null
set XU=null
set oA=null
set WI7=null
set b1060GetSummonedUnit=null
set b1060GetSummoningUnit=null
endfunction
