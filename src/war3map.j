set eY[$D0+O5]=0
if B946DetectCount>0 then
set h8[$90+O5]=B960H8($90+O5,null,"PB7 @ war3map.j:22376 (B968)")
else
set h8[$90+O5]=null
endif
endif
if U84[O5]!=null then
call DisableTrigger(H94)
call RemoveItem(MV7(it,ZU[YC]))
call UnitAddItem(it,U84[O5])
call EnableTrigger(H94)
set U84[O5]=null
set UD4[O5]=false
