call DisplayTimedTextToPlayer(p,0,0,10,"英雄需要在商店附近才可以切换")
set u=null
return
endif
if i>0 then
set WI7_ID=Get_PIFU_ID(u,i)
else
set WI7_ID=TMP_PIFU_LIST(id)
endif
if WI7_ID<0 then
call DisplayTimedTextToPlayer(p,0,0,10,"|cFF00FF00制作中，敬请期待！|r")
set u=null
return
endif
if PIFU_CONDITION(u,p)==false then
set u=null
return
endif
