    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(180*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(180*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(270*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(270*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(0*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(0*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(90*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(90*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(180*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(180*bj_DEGTORAD)
    // call YT7("Abilities\\Spells\\Undead\\Graveyard\\GraveMarker.mdl",x,y,2)
    // call UnitApplyTimedLife(BB7,1112820806,2)
    // set x=GetUnitX(u)+500*Cos(270*bj_DEGTORAD)
    // set y=GetUnitY(u)+500*Sin(270*bj_DEGTORAD)
