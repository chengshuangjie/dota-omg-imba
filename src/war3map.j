    set tx="model\\Hero_Lifestealer_N2S_R_Hand_2.mdl"
    set tx2="model\\Hero_Lifestealer_N2S_R_Hand_3.mdl"
else
    set tx="Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl"
    set tx2="Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl"
endif
call SetUnitVertexColor(WI7,$80,0,0,$FF)
