function GDD takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local trigger t=b1060GetTriggeringTrigger
local integer OB7=GetHandleId(t)
local integer B07=OM7(OB7,"TargetIndex")
local unit T37=TQ7(B07)
local integer SV9=OM7(OB7,"Count")
local integer V77=OM7(OB7,"Level")
local real ZV8=(LoadReal(L7,(OB7),(442)))
if b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ATTACKED and b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_SPELL_EFFECT then
set SV9=SV9+1
call NP7(OB7,"Count",SV9)
elseif b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId=='A01Z' and b1060GetTriggerUnit==T37 then
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call DisableTrigger(b1060GetTriggeringTrigger)
call F_D(T37,V77)
call EnableTrigger(b1060GetTriggeringTrigger)
call NP7(OB7,"Count",0)
endif
if nA(GetUnitX(T37),GetUnitY(T37),375)==false and G7D(T37)==false then
if ZV8<(TimerGetElapsed(W))or GetTriggerEvalCount(t)==1 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
endif
elseif(OO7(OB7,"NaturesGuise|Special")and SV9>($96*V77))then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
elseif OO7(OB7,"NaturesGuise|Special") and GetUnitAbilityLevel(T37,'B021')==0 and GetUnitAbilityLevel(T37,'A1GA')>0 then
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call DisableTrigger(b1060GetTriggeringTrigger)
call F_D(T37,V77)
call EnableTrigger(b1060GetTriggeringTrigger)
elseif GetUnitAbilityLevel(T37,'B021')==0 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call UnitRemoveAbility(T37,'A23O')
call UnitRemoveAbility(T37,'B0E9')
call NM7(OB7)
call OZ7(t)
else
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
endif
set t=null
set T37=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function GED takes nothing returns nothing
local unit T37=GetAttacker()
local integer T_7=GetHandleId(T37)
local trigger t=OE7(T_7,"Nature|Trg")
local integer VZ7=GetHandleId(t)
if OO7(VZ7,"NaturesGuise|Special")and GetAttacker()==T37 then
call UnitRemoveAbility(T37,'B021')
call UnitRemoveAbility(T37,'A1GA')
call NM7(VZ7)
call OZ7(t)
endif
set T37=null
set t=null
endfunction
function GFD takes nothing returns boolean
local unit b1060GetAttacker=B1060EventAttacker()
local boolean b1060ReturnValue
local unit b1010Attacker=b1060GetAttacker
local unit b1010Target=GetTriggerUnit()
local integer b1010Handle=GetHandleId(b1010Attacker)
// A new attack attempt invalidates an abandoned or missed opener.
call RemoveSavedHandle(L7,b1010Handle,StringHash("B1010GuiseTarget"))
call RemoveSavedBoolean(L7,b1010Handle,StringHash("B1010GuiseArmorIgnored"))
if GetUnitAbilityLevel(b1060GetAttacker,'B021')>0 or GetUnitAbilityLevel(b1060GetAttacker,'A1GA')>0 then
if TimerGetElapsed(W)>=LoadReal(L7,b1010Handle,StringHash("B1010GuiseReady")) and IsUnitEnemy(b1010Target,GetOwningPlayer(b1010Attacker)) then
call SaveUnitHandle(L7,b1010Handle,StringHash("B1010GuiseTarget"),b1010Target)
call SaveReal(L7,b1010Handle,StringHash("B1010GuiseUntil"),TimerGetElapsed(W)+5.)
endif
call GED()
endif
set b1010Attacker=null
set b1010Target=null
set b1060ReturnValue=false
set b1060GetAttacker=null
return b1060ReturnValue
endfunction
function B1010GuiseHit takes nothing returns boolean
local unit b1010Source=MHDamageEvent_GetSource()
local unit b1010Victim=MHEvent_GetUnit()
local integer b1010HitHandle=0
local real b1010Armor=0.
local real b1010ArmorFactor=1.
if b1010Source==null or b1010Victim==null or GetUnitTypeId(b1010Source)==0 or GetUnitTypeId(b1010Victim)==0 then
set b1010Source=null
set b1010Victim=null
return false
endif
set b1010HitHandle=GetHandleId(b1010Source)
if FKK and not Fe and MHDamageEvent_IsPhysical() and MHDamageEvent_GetDmgType()==DAMAGE_TYPE_NORMAL and MHDamageEvent_GetDamage()>0. and LoadUnitHandle(L7,b1010HitHandle,StringHash("B1010GuiseTarget"))==b1010Victim and TimerGetElapsed(W)<=LoadReal(L7,b1010HitHandle,StringHash("B1010GuiseUntil")) then
// Consume before any root/order callback can re-enter the damage pipeline.
call RemoveSavedHandle(L7,b1010HitHandle,StringHash("B1010GuiseTarget"))
// Undo only the armor multiplier on this hit; never change the target's armor.
set b1010Armor=GetUnitState(b1010Victim,UNIT_STATE_ARMOR)
if b1010Armor>=0. then
set b1010ArmorFactor=1./(1.+.06*b1010Armor)
else
set b1010ArmorFactor=2.-Pow(.94,-b1010Armor)
endif
if not LoadBoolean(L7,b1010HitHandle,StringHash("B1010GuiseArmorIgnored")) then
call MHDamageEvent_SetDamage(MHDamageEvent_GetDamage()/b1010ArmorFactor)
endif
call RemoveSavedBoolean(L7,b1010HitHandle,StringHash("B1010GuiseArmorIgnored"))
if UnitAlive(b1010Victim) and not IsUnitType(b1010Victim,UNIT_TYPE_STRUCTURE) and not IsMagicImmuneUnit(b1010Victim) then
call NatureWrathApplyAtosRoot(b1010Source,b1010Victim)
endif
endif
set b1010Source=null
set b1010Victim=null
return false
endfunction
function GGD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetTriggerEventId()!=EVENT_WIDGET_DEATH then
if GetUnitAbilityLevel(ZX7,'B021')>0 then
call XF7(ZX7,'A1GA')
endif
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
return false
endfunction
function GHD takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t
local integer OB7
call SaveReal(L7,GetHandleId(b1060GetSpellTargetUnit),StringHash("B1010GuiseReady"),TimerGetElapsed(W)+2.)
call RemoveSavedHandle(L7,GetHandleId(b1060GetSpellTargetUnit),StringHash("B1010GuiseTarget"))
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NP7(OB7,"TargetIndex",TS7(b1060GetSpellTargetUnit))
call NP7(OB7,"Level",B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A01Z'))
call NP7(OB7,"Count",0)
call SaveReal(L7,(OB7),(442),(((TimerGetElapsed(W))+1.)*1.))
call TriggerAddCondition(t,Condition(function GDD))
call TriggerRegisterTimerEvent(t,.1,true)
call XF7(b1060GetSpellTargetUnit,'A23O')
call SetPlayerAbilityAvailable(GetOwningPlayer(b1060GetSpellTargetUnit),'A23O',false)
if b1060GetTriggerUnit==b1060GetSpellTargetUnit then
call NS7(OB7,"NaturesGuise|Special",true)
call NV7(GetHandleId(b1060GetSpellTargetUnit),"Nature|Trg",t)
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
set t=CreateTrigger()
call SaveUnitHandle(L7,(GetHandleId(t)),(2),(b1060GetTriggerUnit))
call TriggerAddCondition(t,Condition(function GGD))
call TriggerRegisterTimerEvent(t,2,false)
call TriggerRegisterDeathEvent(t,b1060GetTriggerUnit)
endif
set t=null
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
