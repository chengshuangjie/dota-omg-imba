elseif Y68==it_xjsg then
set disabledIndex=it_xjsgban
endif
if disabledIndex!=0 then
call DisableTrigger(H94)
set IR4=GetItemPlayer(A28)
call RemoveItem(A28)
set HA4=AY8(WI7,ZU[disabledIndex],i)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
call EnableTrigger(H94)
endif
set i=i+1
endloop
set WI7=null
set A28=null
endfunction
