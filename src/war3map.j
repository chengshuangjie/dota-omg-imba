if B287_GetSpellAbilityId()=='A4DQ' then
    if B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0N8')>0 then
        call YJHY3()
    else
        call X37(GetOwningPlayer(b1060GetTriggerUnit),"你还没有学习忽悠")
