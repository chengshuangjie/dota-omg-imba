set YTF=YTF+1
call NP7(GetHandleId(X_8),"DeliveryIndex",YTF)
call NT7(GetHandleId(X_8),"DeliveryTarget"+I2S(YTF),(WX7))
endif
call NQ7(I97,"DeliveryTargetX",(GetUnitX(WX7)*1.))
call NQ7(I97,"DeliveryTargetY",(GetUnitY(WX7)*1.))
