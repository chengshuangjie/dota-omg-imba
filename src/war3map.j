call DestroyEffect(AddSpecialEffectTarget(DAG,ZX7,"hand right"))
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function DWG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
