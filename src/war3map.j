function MiaoAI_Think takes unit mdHero returns boolean
local integer mdHandle=GetHandleId(mdHero)
local integer mdPlayer=GetPlayerId(GetOwningPlayer(mdHero))
local unit mdEnemy=null
local timer mdState=null
local boolean mdIssued=false
local real mdRange=0.
local integer scan988=0
local integer enemies988=0
local integer allies988=0
local integer close988=0
local unit other988=null
local real health988=GetUnitLifePercent(mdHero)
local real direction988=0.
local boolean retreat988=false
local boolean threat988=false
local boolean controlled988=false
if MiaoStarted==false or LoadBoolean(MiaoTable,mdHandle,100)==false or IsUnitIllusion(mdHero) or GetPlayerController(GetOwningPlayer(mdHero))!=MAP_CONTROL_COMPUTER or UnitAlive(mdHero)==false or SUIJI_AI_CASTING then
return false
endif
if B835AIChannelBlocked(mdHero) or LoadReal(MiaoTable,mdHandle,110)>GetGameTime() then
return true
endif
if IsUnitPaused(mdHero) or IsUnitType(mdHero,UNIT_TYPE_STUNNED) or IsUnitType(mdHero,UNIT_TYPE_POLYMORPHED) or not K57(mdHero) then
return false
endif
if LoadReal(MiaoTable,mdHandle,111)>GetGameTime() then
return false
endif
call SaveReal(MiaoTable,mdHandle,111,GetGameTime()+.2)
set mdEnemy=LoadUnitHandle(MiaoTable,mdHandle,148)
if mdEnemy==null or not UnitAlive(mdEnemy) or not IsUnitEnemy(mdEnemy,GetOwningPlayer(mdHero)) or not IsUnitVisible(mdEnemy,GetOwningPlayer(mdHero)) or not IsUnitInRange(mdHero,mdEnemy,1000.) then
set mdEnemy=SuijiAI_PickHeroTarget(mdHero,h4[mdPlayer])
endif
if mdEnemy==null or not UnitAlive(mdEnemy) or not IsUnitEnemy(mdEnemy,GetOwningPlayer(mdHero)) or not IsUnitVisible(mdEnemy,GetOwningPlayer(mdHero)) or IsUnitIllusion(mdEnemy) or MHUnit_IsInvulnerable(mdEnemy) or not IsUnitInRange(mdHero,mdEnemy,1000.) then
call RemoveSavedHandle(MiaoTable,mdHandle,148)
set mdEnemy=null
return false
endif
call SaveUnitHandle(MiaoTable,mdHandle,148,mdEnemy)
set mdRange=KE7(mdHero,mdEnemy)
set mdState=LoadTimerHandle(MiaoTable,mdHandle,101)
if mdState!=null and LoadBoolean(MiaoTable,GetHandleId(mdState),2) then
set mdEnemy=null
set mdState=null
return true
endif
// Bounded main-hero count; no new group or periodic timer.
loop
exitwhen scan988>=12
set other988=M7[scan988]
if other988!=null and UnitAlive(other988) and IsUnitInRange(mdHero,other988,700.) then
if IsUnitAlly(other988,GetOwningPlayer(mdHero)) then
set allies988=allies988+1
elseif IsUnitVisible(other988,GetOwningPlayer(mdHero)) then
set enemies988=enemies988+1
if IsUnitInRange(mdHero,other988,350.) then
set close988=close988+1
if GetUnitCurrentOrder(other988)==OrderId("attack") and MHUnit_GetAttackTargetUnit(other988)==mdHero then
set threat988=true
endif
endif
endif
endif
set scan988=scan988+1
endloop
set retreat988=health988<30. or (G0[32+mdPlayer] and health988<55.) or (enemies988>allies988+1 and health988<50.)
set controlled988=IsUnitType(mdEnemy,UNIT_TYPE_STUNNED) or IsUnitType(mdEnemy,UNIT_TYPE_SNARED) or IsUnitPaused(mdEnemy)
// The dedicated combo runs before generic items; give BKB its own safe window.
if not IsMagicImmuneUnit(mdHero) and (mdRange<=600. or (retreat988 and mdRange<=900.)) and LoadReal(MiaoTable,mdHandle,149)<=GetGameTime() then
call SaveReal(MiaoTable,mdHandle,149,GetGameTime()+1.)
call SaveReal(MiaoTable,mdHandle,110,GetGameTime()+.35)
set mdIssued=MC7(mdHero,ZU[D0])
if mdIssued then
set other988=null
set mdEnemy=null
set mdState=null
return true
endif
call SaveReal(MiaoTable,mdHandle,110,0.)
endif
if MHUnit_GetSilenceCount(mdHero)>0 then
set other988=null
set mdEnemy=null
set mdState=null
return false
endif
// Own the command window before issuing: order events are synchronous.
call SaveReal(MiaoTable,mdHandle,110,GetGameTime()+.35)
if retreat988 and SuijiAI_CanPayAndCastNormally(mdHero,'AMdD') then
if h9[mdPlayer]!=null and not IsUnitInRange(mdHero,h9[mdPlayer],150.) then
set direction988=Atan2(GetUnitY(h9[mdPlayer])-GetUnitY(mdHero),GetUnitX(h9[mdPlayer])-GetUnitX(mdHero))
else
set direction988=Atan2(GetUnitY(mdHero)-GetUnitY(mdEnemy),GetUnitX(mdHero)-GetUnitX(mdEnemy))
endif
call SaveReal(MiaoTable,mdHandle,145,direction988)
call SaveReal(MiaoTable,mdHandle,146,GetGameTime()+1.)
set mdIssued=B947IssueImmediateOrder("MiaoAI retreat step B988",mdHero,"fanofknives")
elseif threat988 and GetUnitAbilityLevel(mdHero,'BMdW')==0 and LoadReal(MiaoTable,mdHandle,105)<=GetGameTime() and SuijiAI_CanPayAndCastNormally(mdHero,'AMdW') then
set mdIssued=B947IssueImmediateOrder("MiaoAI timed counter B988",mdHero,"berserk")
elseif retreat988 then
// Let the normal retreat controller move; do not start a new offensive chain.
set mdIssued=false
elseif mdRange<=300. and GetUnitAbilityLevel(mdHero,'A1N7')==0 and SuijiAI_CanPayAndCastNormally(mdHero,'A1P9') then
set mdIssued=SuijiAI_CastByOrder(mdHero,mdEnemy,'A1P9',OP7(mdHandle,"SuijiSmallOrder"))
elseif mdRange<=250. and not OT7(mdHero,"WalrusPunch|Active") and SuijiAI_CanPayAndCastNormally(mdHero,'A1YQ') then
set mdIssued=SuijiAI_CastByOrder(mdHero,mdEnemy,'A1YQ',OP7(mdHandle,"SuijiUltOrder"))
elseif mdState!=null and mdRange<=350. and (controlled988 or mdRange<=180. or close988>=2) and (LoadInteger(MiaoTable,mdHandle,102)>=25+25*LoadInteger(MiaoTable,mdHandle,103) or LoadReal(MiaoTable,GetHandleId(mdState),1)<2.2 or GetUnitLifePercent(mdEnemy)<30.) and SuijiAI_CanPayAndCastNormally(mdHero,'AMdT') then
set mdIssued=B947IssueImmediateOrder("MiaoAI_Think @ war3map.j:123966 (B968)",mdHero,"doom")
elseif mdState!=null and LoadReal(MiaoTable,mdHandle,135)>0. and mdRange<=250. then
set mdIssued=B947IssueTargetOrder("MiaoAI consume step attack B988",mdHero,"attack",mdEnemy)
elseif mdState==null and mdRange>400. and mdRange<=900. and SuijiAI_CanPayAndCastNormally(mdHero,'AMdE') then
set mdIssued=B947IssuePointOrder("MiaoAI opening wave B988",mdHero,"shockwave",GetUnitX(mdEnemy),GetUnitY(mdEnemy))
elseif mdRange<=600. and mdState==null and health988>=50. and enemies988<=allies988+1 and GetUnitState(mdHero,UNIT_STATE_MANA)>=85. and SuijiAI_CanPayAndCastNormally(mdHero,'AMdR') then
set mdIssued=B947IssueImmediateOrder("MiaoAI_Think @ war3map.j:123968 (B968)",mdHero,"thunderclap")
elseif mdState!=null and mdRange>200. and mdRange<=600. and enemies988<=allies988+1 and SuijiAI_CanPayAndCastNormally(mdHero,'AMdF') then
set mdIssued=B947IssueTargetOrder("MiaoAI close gap B988",mdHero,"earthquake",mdEnemy)
elseif mdRange<=380. and SuijiAI_CanPayAndCastNormally(mdHero,'AMdQ') then
set mdIssued=B947IssueImmediateOrder("MiaoAI_Think @ war3map.j:123973 (B968)",mdHero,"stomp")
elseif mdRange<=900. and SuijiAI_CanPayAndCastNormally(mdHero,'AMdE') then
set mdIssued=B947IssuePointOrder("MiaoAI_Think @ war3map.j:123975 (B968)",mdHero,"shockwave",GetUnitX(mdEnemy),GetUnitY(mdEnemy))
elseif mdState!=null and mdRange<=220. and health988>=50. and enemies988<=allies988 and SuijiMode_ScepterRegistryIsActive(mdHero,'AMdE') and LoadReal(MiaoTable,mdHandle,134)<=GetGameTime() and LoadReal(MiaoTable,mdHandle,135)<=0. and SuijiAI_CanPayAndCastNormally(mdHero,'AMdD') then
call SaveReal(MiaoTable,mdHandle,145,Atan2(GetUnitY(mdEnemy)-GetUnitY(mdHero),GetUnitX(mdEnemy)-GetUnitX(mdHero)))
call SaveReal(MiaoTable,mdHandle,146,GetGameTime()+1.)
set mdIssued=B947IssueImmediateOrder("MiaoAI empowered step B988",mdHero,"fanofknives")
endif
if not mdIssued then
call SaveReal(MiaoTable,mdHandle,110,0.)
call SaveReal(MiaoTable,mdHandle,146,0.)
endif
set other988=null
set mdEnemy=null
set mdState=null
return mdIssued
endfunction
function LunaAI_Think takes unit lunaAIUnit returns boolean
local integer lunaAIHandle=0
local integer lunaAIPlayer=0
local integer lunaAIBlinkSlot=-1
local unit lunaAITarget=null
local real lunaAINow=0.
local real lunaAIDistance=0.
local real lunaAIAngle=0.
local real lunaAIX=0.
local real lunaAIY=0.
local real lunaAIHold=.20
local boolean lunaAIDone=false
local boolean lunaAIRetreat=false
// Reuse the existing bounded AI dispatch; no Miao-only idle timer.
if B991Think(lunaAIUnit) then
return true
endif
if MiaoStarted and lunaAIUnit!=null and GetUnitPointValue(lunaAIUnit)==117 then
return MiaoAI_Think(lunaAIUnit)
endif
if lunaAIUnit==null or GetUnitTypeId(lunaAIUnit)!='Z061' or GetPlayerController(GetOwningPlayer(lunaAIUnit))!=MAP_CONTROL_COMPUTER or IsUnitIllusion(lunaAIUnit) or SUIJI_AI_CASTING then
return false
endif
set lunaAIHandle=GetHandleId(lunaAIUnit)
if not UnitAlive(lunaAIUnit) then
call RemoveSavedReal(L7,lunaAIHandle,StringHash("LunaAIHoldUntil"))
call RemoveSavedReal(L7,lunaAIHandle,StringHash("LunaAINextThink"))
call RemoveSavedHandle(L7,lunaAIHandle,StringHash("LunaAITarget"))
return false
endif
// Do not replace a channel, a dash in flight, or an uncompleted spell order.
if B835AIChannelBlocked(lunaAIUnit) or OO7(lunaAIHandle,"LunaDashActive") or OO7(lunaAIHandle,"LunaPassiveDashActive") then
return true
endif
set lunaAINow=TimerGetElapsed(W)
if lunaAINow<ON7(lunaAIHandle,"LunaAIHoldUntil") then
return true
endif
// Idle debounce is separate from command ownership: false still permits random skills.
if lunaAINow<ON7(lunaAIHandle,"LunaAINextThink") then
return false
endif
call NQ7(lunaAIHandle,"LunaAINextThink",lunaAINow+.20)
if IsUnitPaused(lunaAIUnit) or IsUnitType(lunaAIUnit,UNIT_TYPE_STUNNED) or IsUnitType(lunaAIUnit,UNIT_TYPE_POLYMORPHED) or MHUnit_GetSilenceCount(lunaAIUnit)>0 or not K57(lunaAIUnit) then
return false
endif
set lunaAIPlayer=GetPlayerId(GetOwningPlayer(lunaAIUnit))
set lunaAITarget=O77(lunaAIHandle,"LunaAITarget")
if not LunaAI_TargetValid(lunaAIUnit,lunaAITarget) then
set lunaAITarget=SuijiAI_PickHeroTarget(lunaAIUnit,h4[lunaAIPlayer])
endif
if not LunaAI_TargetValid(lunaAIUnit,lunaAITarget) then
call RemoveSavedHandle(L7,lunaAIHandle,StringHash("LunaAITarget"))
set lunaAITarget=null
return false
endif
call NT7(lunaAIHandle,"LunaAITarget",lunaAITarget)
set lunaAIDistance=KE7(lunaAIUnit,lunaAITarget)
set lunaAIRetreat=GetUnitLifePercent(lunaAIUnit)<30. or G0[32+lunaAIPlayer]
// Order events run synchronously. Own this short window before issuing any
// spell/item/attack order, so a reactive AI callback cannot enter recursively.
call NQ7(lunaAIHandle,"LunaAIHoldUntil",lunaAINow+.20)
if lunaAIRetreat then
// E buys a shield and a stun; R then goes toward the existing retreat anchor.
// Escaping is the sole case where an unmarked R is intentionally allowed.
if lunaAIDistance<=380. and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L2') and (not SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L3') or LunaAI_ReserveDash(lunaAIUnit,'A6L2')) then
set lunaAIDone=N97(lunaAIUnit,OrderId("stomp"),'A6L2')
elseif lunaAIDistance<=700. and h9[lunaAIPlayer]!=null and not IsUnitInRange(lunaAIUnit,h9[lunaAIPlayer],500.) and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L3') then
set lunaAIAngle=Atan2(GetUnitY(h9[lunaAIPlayer])-GetUnitY(lunaAIUnit),GetUnitX(h9[lunaAIPlayer])-GetUnitX(lunaAIUnit))
set lunaAIX=X57(GetUnitX(lunaAIUnit)+700.*Cos(lunaAIAngle))
set lunaAIY=X27(GetUnitY(lunaAIUnit)+700.*Sin(lunaAIAngle))
if not IsTerrainPathable(lunaAIX,lunaAIY,PATHING_TYPE_WALKABILITY) then
set lunaAIDone=N47(lunaAIUnit,OrderId("blink"),'A6L3',0,lunaAIX,lunaAIY)
set lunaAIHold=.40
endif
endif
elseif LunaAI_SafeApproach(lunaAIUnit,lunaAITarget) then
// Consume an existing mark before spending another marking skill. A short
// landing beyond the target keeps E and melee attacks in range after R.
if OO7(GetHandleId(lunaAITarget),"LunaMarked") and lunaAIDistance<=700. and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L3') then
set lunaAIAngle=Atan2(GetUnitY(lunaAITarget)-GetUnitY(lunaAIUnit),GetUnitX(lunaAITarget)-GetUnitX(lunaAIUnit))
set lunaAIX=X57(GetUnitX(lunaAITarget)+65.*Cos(lunaAIAngle))
set lunaAIY=X27(GetUnitY(lunaAITarget)+65.*Sin(lunaAIAngle))
if not IsTerrainPathable(lunaAIX,lunaAIY,PATHING_TYPE_WALKABILITY) then
set lunaAIDone=N47(lunaAIUnit,OrderId("blink"),'A6L3',0,lunaAIX,lunaAIY)
set lunaAIHold=.35
endif
elseif lunaAIDistance<=380. and not OO7(GetHandleId(lunaAITarget),"LunaMarked") and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L2') and LunaAI_ReserveDash(lunaAIUnit,'A6L2') then
set lunaAIDone=N97(lunaAIUnit,OrderId("stomp"),'A6L2')
elseif lunaAIDistance<=900. and not OO7(GetHandleId(lunaAITarget),"LunaMarked") and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L1') and LunaAI_ReserveDash(lunaAIUnit,'A6L1') then
set lunaAIDone=N47(lunaAIUnit,OrderId("flare"),'A6L1',0,GetUnitX(lunaAITarget),GetUnitY(lunaAITarget))
// Wait for the real wave to arrive. A missed wave never authorizes R.
set lunaAIHold=lunaAIDistance/1400.+.15
elseif lunaAIDistance>500. and lunaAIDistance<=1000. and GetUnitLifePercent(lunaAIUnit)>55. and SuijiAI_CanPayAndCastNormally(lunaAIUnit,'A6L2') and LunaAI_ReserveDash(lunaAIUnit,'A6L2') then
// Optional item initiation follows Slardar's item/skill pattern, but uses
// Luna's E mark and shield, followed by marked R instead of Crush/Amplify.
set lunaAIBlinkSlot=Get_Tiaodao(lunaAIUnit)
if lunaAIBlinkSlot>=0 and not IsTerrainPathable(GetUnitX(lunaAITarget),GetUnitY(lunaAITarget),PATHING_TYPE_WALKABILITY) then
set lunaAIDone=UnitUseItemPoint(lunaAIUnit,UnitItemInSlot(lunaAIUnit,lunaAIBlinkSlot),GetUnitX(lunaAITarget),GetUnitY(lunaAITarget))
endif
endif
if not lunaAIDone and lunaAIDistance<=500. and GetUnitAbilityLevel(lunaAIUnit,'A6L0')>0 then
// Preserve attack windups. Third-hit marks come from actual damage events;
// never increment LunaAttackCount or synthesize a mark from an issued order.
if GetUnitCurrentOrder(lunaAIUnit)!=OrderId("attack") and GetUnitCurrentOrder(lunaAIUnit)!=OrderId("smart") then
set lunaAIDone=B947IssueTargetOrder("LunaAI_Think @ war3map.j:124089 (B968)",lunaAIUnit,"attack",lunaAITarget)
endif
endif
endif
if lunaAIDone then
call NQ7(lunaAIHandle,"LunaAIHoldUntil",lunaAINow+lunaAIHold)
else
call RemoveSavedReal(L7,lunaAIHandle,StringHash("LunaAIHoldUntil"))
endif
set lunaAITarget=null
return lunaAIDone
endfunction
function SuijiAI_PulseRandomCasts takes nothing returns boolean
local integer i=0
call SuijiAI_RecoverStaleCastLock()
loop
exitwhen i>$B
call B835AIChannelPruneSlot(i)
if M7[i]!=null and not LunaAI_Think(M7[i]) then
call SuijiAI_TryPulseUnit(M7[i])
endif
set i=i+1
endloop
return false
endfunction
function SuijiAI_FocusSpellEffect takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer logicalSkill=B287_GetSpellAbilityId()
local integer nativeSkill=GetSpellAbilityId()
if SUIJI_AI_FOCUS_LOG and u!=null and GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and SuijiAI_IsFocusSkill(logicalSkill) and SuijiMode_HasRandomSkill(u,logicalSkill) then
call SuijiAI_FocusLog(u,logicalSkill,"效果事件","logical="+I2S(logicalSkill)+" native="+I2S(nativeSkill)+" target="+I2S(GetHandleId(GetSpellTargetUnit()))+" point="+I2S(R2I(GetSpellTargetX()))+","+I2S(R2I(GetSpellTargetY())))
endif
set u=null
return false
endfunction
function SuijiAI_PulseInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerAddCondition(t,Condition(function B991Damage))
call MHDamageEvent_Register(t)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.70,true)
call TriggerAddCondition(t,Condition(function SuijiAI_PulseRandomCasts))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SuijiAI_FocusSpellEffect))
set t=null
endfunction
// B1021: native Skywrath owns a bounded, single-target combo. No global scan
// or permanent timer: one trigger observes actual effects and ticks only while active.
function B1021SkyTarget takes unit sky1021,unit foe1021 returns boolean
return sky1021!=null and foe1021!=null and GetUnitTypeId(sky1021)=='H0DO' and GetUnitTypeId(foe1021)!=0 and UnitAlive(sky1021) and UnitAlive(foe1021) and IsUnitEnemy(foe1021,GetOwningPlayer(sky1021)) and IsUnitType(foe1021,UNIT_TYPE_HERO) and not IsUnitIllusion(foe1021) and IsUnitVisible(foe1021,GetOwningPlayer(sky1021)) and not IsHideUnit(foe1021) and not MHUnit_IsInvulnerable(foe1021) and not IsMagicImmuneUnit(foe1021) and not CHUIFENG(foe1021) and IsUnitInRange(sky1021,foe1021,850.)
endfunction
function B1021SkyHeld takes unit foe1021 returns boolean
return IsUnitType(foe1021,UNIT_TYPE_STUNNED) or IsUnitType(foe1021,UNIT_TYPE_SNARED) or IsUnitType(foe1021,UNIT_TYPE_POLYMORPHED)
endfunction
function B1021SkyCrowd takes unit sky1021,unit foe1021 returns integer
local group nearby1021=CreateGroup()
local unit other1021=null
local integer count1021=0
call GroupEnumUnitsInRange(nearby1021,GetUnitX(foe1021),GetUnitY(foe1021),200.,null)
loop
set other1021=FirstOfGroup(nearby1021)
exitwhen other1021==null
call GroupRemoveUnit(nearby1021,other1021)
if other1021!=foe1021 and UnitAlive(other1021) and IsUnitType(other1021,UNIT_TYPE_HERO) and not IsUnitIllusion(other1021) and IsUnitEnemy(other1021,GetOwningPlayer(sky1021)) and IsUnitVisible(other1021,GetOwningPlayer(sky1021)) then
set count1021=count1021+1
endif
endloop
call DestroyGroup(nearby1021)
set nearby1021=null
return count1021
endfunction
function B1021SkyFinish takes trigger combo1021 returns nothing
local integer key1021=GetHandleId(combo1021)
local unit sky1021=LoadUnitHandle(L7,key1021,1)
if LoadTriggerHandle(L7,GetHandleId(sky1021),StringHash("B1021Combo"))==combo1021 then
call RemoveSavedHandle(L7,GetHandleId(sky1021),StringHash("B1021Combo"))
call RemoveSavedReal(L7,GetHandleId(sky1021),StringHash("B1021Hold"))
call RemoveSavedBoolean(L7,GetHandleId(sky1021),StringHash("B1021Issuing"))
call SaveReal(L7,GetHandleId(sky1021),StringHash("B1021Retry"),TimerGetElapsed(W)+2.)
endif
call FlushChildHashtable(L7,key1021)
call OZ7(combo1021)
set sky1021=null
endfunction
function B1021SkyItemCost takes unit sky1021,integer item1021 returns integer
local item held1021=MV7(sky1021,ZU[item1021])
local integer spell1021=0
if held1021!=null then
set spell1021=MHItem_GetAbilityId(held1021,1)
endif
set held1021=null
return B945DefinitionMana(spell1021,GetUnitAbilityLevel(sky1021,spell1021))
endfunction
function B1021SkyAtosReady takes unit sky1021 returns boolean
local item held1021=MV7(sky1021,ZU[FC])
local boolean ready1021=false
if held1021!=null then
set ready1021=B581_AIAbilityReady(sky1021,MHItem_GetAbilityId(held1021,1))
endif
set held1021=null
return ready1021
endfunction
function B1021SkyComboEvent takes nothing returns boolean
local trigger combo1021=GetTriggeringTrigger()
local integer key1021=GetHandleId(combo1021)
local unit sky1021=LoadUnitHandle(L7,key1021,1)
local unit foe1021=LoadUnitHandle(L7,key1021,2)
local integer owner1021=GetHandleId(sky1021)
local integer step1021=LoadInteger(L7,key1021,3)
local integer skill1021=0
local integer item1021=0
local integer order1021=0
local item held1021=null
local real now1021=TimerGetElapsed(W)
local boolean sent1021=false
if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
if GetSpellAbilityId()==LoadInteger(L7,key1021,4) and not LoadBoolean(L7,owner1021,StringHash("SuijiMulticastCasting")) and not LoadBoolean(L7,owner1021,StringHash("LotusReflecting")) then
call SaveBoolean(L7,key1021,5,true)
endif
elseif not B1021SkyTarget(sky1021,foe1021) or M7[GetPlayerId(GetOwningPlayer(sky1021))]!=sky1021 or GetPlayerController(GetOwningPlayer(sky1021))!=MAP_CONTROL_COMPUTER or now1021>=LoadReal(L7,owner1021,StringHash("B1021Hold")) or IsUnitPaused(sky1021) or IsUnitType(sky1021,UNIT_TYPE_STUNNED) or IsUnitType(sky1021,UNIT_TYPE_POLYMORPHED) or UC6(sky1021) or UC7(sky1021) then
call B1021SkyFinish(combo1021)
elseif LoadInteger(L7,key1021,4)!=0 then
// Accepted orders are not successful casts. Wait for this exact SPELL_EFFECT.
if LoadBoolean(L7,key1021,5) then
set sent1021=true
if step1021==1 then
set sent1021=not WQ7(foe1021)
elseif step1021==2 then
set sent1021=B1021SkyHeld(foe1021) or GetUnitAbilityLevel(foe1021,'B0FU')>0
elseif step1021==5 then
// A1QC is attached by the real Etherblast projectile impact callback.
set sent1021=GetUnitAbilityLevel(foe1021,'A1QC')>0
endif
if sent1021 and now1021>=LoadReal(L7,key1021,7) then
call SaveInteger(L7,key1021,3,step1021+1)
call SaveInteger(L7,key1021,4,0)
call SaveBoolean(L7,key1021,5,false)
elseif now1021>LoadReal(L7,key1021,6) then
call B1021SkyFinish(combo1021)
endif
elseif now1021>LoadReal(L7,key1021,6) then
call B1021SkyFinish(combo1021)
endif
else
// 0 protection, 1 spell block, 2 control, 3 seal, 4 veil, 5 ethereal,
// 6 flare, 7 bolt, 8 dagon. Missing optional items do not stall the combo.
if step1021==0 then
if AI_ITEM_OK(sky1021,"bkb") then
set item1021=D0
endif
elseif step1021==1 then
if WQ7(foe1021) then
set skill1021='A2BE'
set order1021=852119
endif
elseif step1021==2 then
if AI_ITEM_OK(sky1021,"yangdao") then
set item1021=it_yangdao
elseif B1021SkyAtosReady(sky1021) then
set item1021=FC
elseif not B1021SkyHeld(foe1021) then
call B1021SkyFinish(combo1021)
set combo1021=null
endif
elseif step1021==3 then
set skill1021='A2HN'
set order1021=852668
elseif step1021==4 then
if AI_ITEM_OK(sky1021,"zhzg") then
set item1021=it_zhzg
endif
elseif step1021==5 then
if AI_ITEM_OK(sky1021,"xulingdao") then
set item1021=E24
endif
elseif step1021==6 then
if not B1021SkyHeld(foe1021) and GetUnitAbilityLevel(foe1021,'A1QC')==0 and GetUnitAbilityLevel(foe1021,'B0FU')==0 then
call B1021SkyFinish(combo1021)
set combo1021=null
else
set skill1021=B287_GetPhysicalAbilityId(sky1021,'A2BG')
set order1021=852662
endif
elseif step1021==7 then
if AI_SKILL_OK(sky1021,'A2BE') then
set skill1021='A2BE'
set order1021=852119
endif
elseif step1021==8 then
if AI_ITEM_OK(sky1021,"dagen") then
set item1021=N5
endif
else
call B1021SkyFinish(combo1021)
set combo1021=null
endif
if combo1021!=null then
if item1021!=0 then
set held1021=MV7(sky1021,ZU[item1021])
set skill1021=MHItem_GetAbilityId(held1021,1)
endif
if skill1021==0 then
call SaveInteger(L7,key1021,3,step1021+1)
elseif not B581_AIAbilityReady(sky1021,skill1021) or GetUnitState(sky1021,UNIT_STATE_MANA)<B945DefinitionMana(skill1021,GetUnitAbilityLevel(sky1021,skill1021)) then
call B1021SkyFinish(combo1021)
else
call SaveInteger(L7,key1021,4,skill1021)
call SaveReal(L7,key1021,6,now1021+1.25)
call SaveReal(L7,key1021,7,now1021+.15)
call SaveBoolean(L7,owner1021,StringHash("B1021Issuing"),true)
if item1021==D0 then
set sent1021=UnitUseItem(sky1021,held1021)
elseif item1021==it_zhzg then
set sent1021=UnitUseItemPoint(sky1021,held1021,GetUnitX(foe1021),GetUnitY(foe1021))
elseif item1021!=0 then
set sent1021=UnitUseItemTarget(sky1021,held1021,foe1021)
elseif step1021==6 then
set sent1021=N47(sky1021,order1021,'A2BG','A2SA',GetUnitX(foe1021),GetUnitY(foe1021))
else
set sent1021=M57(sky1021,order1021,skill1021,foe1021)
endif
call RemoveSavedBoolean(L7,owner1021,StringHash("B1021Issuing"))
if not sent1021 then
call B1021SkyFinish(combo1021)
endif
endif
endif
endif
set held1021=null
set sky1021=null
set foe1021=null
set combo1021=null
return false
endfunction
function B1021SkyThink takes unit sky1021 returns boolean
local integer owner1021=GetHandleId(sky1021)
local integer player1021=0
local integer flare1021=0
local integer mana1021=0
local unit foe1021=null
local unit pick1021=null
local group scan1021=null
local trigger combo1021=null
local real best1021=100000000.
local real score1021=0.
if GetUnitTypeId(sky1021)!='H0DO' or GetPlayerController(GetOwningPlayer(sky1021))!=MAP_CONTROL_COMPUTER or not UnitAlive(sky1021) or IsUnitIllusion(sky1021) then
return false
endif
if LoadReal(L7,owner1021,StringHash("B1021Hold"))>TimerGetElapsed(W) then
return true
endif
set player1021=GetPlayerId(GetOwningPlayer(sky1021))
if M7[player1021]!=sky1021 or SUIJI_AI_CASTING or B835AIChannelBlocked(sky1021) or TimerGetElapsed(W)<LoadReal(L7,owner1021,StringHash("B1021Retry")) or IsUnitPaused(sky1021) or UC6(sky1021) or UC7(sky1021) or GetUnitLifePercent(sky1021)<35. then
return false
endif
set flare1021=B287_GetPhysicalAbilityId(sky1021,'A2BG')
