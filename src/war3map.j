function B1099EarthSyncStone takes unit earthUnit1099,integer earthCharges1099 returns nothing
local integer earthIndex1099=0
local integer earthFamily1099=0
local integer earthPhysical1099=B1099EarthStoneAbility(earthUnit1099,earthCharges1099)
local integer earthOther1099=0
loop
exitwhen earthIndex1099>6
if JMI[earthIndex1099]!=earthPhysical1099 and GetUnitAbilityLevel(earthUnit1099,JMI[earthIndex1099])>0 then
call UnitRemoveAbility(earthUnit1099,JMI[earthIndex1099])
endif
set earthFamily1099=0
loop
exitwhen earthFamily1099>2
set earthOther1099='YS00'+earthFamily1099*256+earthIndex1099
if earthOther1099!=earthPhysical1099 and GetUnitAbilityLevel(earthUnit1099,earthOther1099)>0 then
call UnitRemoveAbility(earthUnit1099,earthOther1099)
endif
set earthFamily1099=earthFamily1099+1
endloop
set earthIndex1099=earthIndex1099+1
endloop
if GetUnitAbilityLevel(earthUnit1099,earthPhysical1099)==0 then
call XF7(earthUnit1099,earthPhysical1099)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(earthUnit1099),earthPhysical1099,true)
call B1099EarthScheduleZero(earthUnit1099)
endfunction
