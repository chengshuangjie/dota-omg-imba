function YF5 takes nothing returns nothing
local unit IH7=GetEnumUnit()
if IsUnitInGroup(IH7,WXI)==false then
call GroupAddUnit(WXI,IH7)
// if IsUnitType(IH7, UNIT_TYPE_HERO)==false and IsUnitIllusion(IH7)==false and AS7(IH7)==false and IH7!=V4 and IsUnitType(IH7,UNIT_TYPE_ANCIENT)==false then
// set WJI=WJI*2
// endif
// if IsUnitType(IH7, UNIT_TYPE_HERO)==false and IsUnitIllusion(IH7)==false and AS7(IH7)==false and IH7!=V4 and IsUnitType(IH7,UNIT_TYPE_ANCIENT)==false then
// set WJI=WJI*2
// endif
// if IsUnitType(IH7, UNIT_TYPE_HERO)==false and IsUnitIllusion(IH7)==false and AS7(IH7)==false and IH7!=V4 and IsUnitType(IH7,UNIT_TYPE_ANCIENT)==false then
// set WJI=WJI*2
// endif
call B67(WYI,IH7,7,WJI)
endif
set IH7=null
endfunction
function YG5 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IJ=(LoadUnitHandle(L7,(OB7),(45)))
local group BQ9=(LoadGroupHandle(L7,(OB7),(22)))
local real a=(LoadReal(L7,(OB7),(137)))
local real DVD=0.
local real Il=0.
local real IL=0.
local group g
local real r=0.
local real YM7=(LoadReal(L7,(OB7),(50)))
local integer length=(LoadInteger(L7,(OB7),(10)))
if WI7==null or IJ==null or UnitAlive(IJ)==false then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
if BQ9!=null then
call WR7(BQ9)
endif
set BQ9=null
set t=null
set WI7=null
set IJ=null
return false
endif
set DVD=KE7(WI7,IJ)
set Il=GetUnitX(IJ)+1100*0.02*Cos(a*bj_DEGTORAD)
set IL=GetUnitY(IJ)+1100*0.02*Sin(a*bj_DEGTORAD)
set r=100+350*DVD/900
//if DVD>900 then
if DVD>length or BlockUnitPass(IJ) then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call WR7(BQ9)
call KillUnit(IJ)
else
call SetUnitX(IJ,Il)
call SetUnitY(IJ,IL)
set IN4=WI7
set WYI=WI7
set WXI=BQ9
set WJI=YM7
set g=WS7()
call GroupEnumUnitsInRange(g,Il,IL,r,Condition(function AJ7_gai))
call ForGroup(g,function YF5)
call WR7(g)
set g=null
endif
set BQ9=null
set t=null
set WI7=null
set IJ=null
return false
endfunction
function YH5 takes nothing returns nothing
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit WI7=(b1061SavedGetTriggerUnit)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit IJ=CreateUnit(GetOwningPlayer(WI7),'h0HK',GetUnitX(WI7),GetUnitY(WI7),GetUnitFacing(WI7))
local real x=(b1061SavedGetSpellTargetX)
local real y=(b1061SavedGetSpellTargetY)
local real a=J77(GetUnitX(WI7),GetUnitY(WI7),x,y)
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(WI7,'A4DJ')+GetUnitAbilityLevel(WI7,'A4DZ')
local integer ZZMF=0
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A28R')
local real YM7
call UnitApplyTimedLife(IJ,'BTLF',3.)
if SuijiMode_ScepterRegistryIsActive(WI7,'A28R') then
set YM7=225+125*BC7
else
set YM7=200+90*BC7
endif
if ZZMF_level>0 then
    set ZZMF=50*ZZMF_level
endif
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
set length=1100+ZZMF
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
set length=1050+ZZMF
else
set length=900+ZZMF
endif
call TriggerRegisterTimerEvent(t,0.02,true)
call TriggerAddCondition(t,Condition(function YG5))
call SaveUnitHandle(L7,(OB7),(2),(WI7))
call SaveUnitHandle(L7,(OB7),(45),(IJ))
call SaveGroupHandle(L7,(OB7),(22),(WS7()))
call SaveReal(L7,(OB7),(137),((a)*1.0))
call SaveReal(L7,(OB7),(50),(YM7))
call SaveInteger(L7,(OB7),(10),(length))
set WI7=null
set t=null
set IJ=null
set b1061SavedGetTriggerUnit=null
endfunction
function YZ5 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A28R' or B287_GetSpellAbilityId()=='A28S' then
call YH5()
endif
return false
endfunction
function NZA takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function YZ5))
set t=null
endfunction
function R43 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,I97,2))
local unit IH7=LoadUnitHandle(L7,I97,3)
local real r=LoadReal(L7,I97,0)-.1
local unit BB7
local boolean b=LoadBoolean(L7,I97,10)
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST or GetTriggerEventId()==EVENT_WIDGET_DEATH then
call SuijiMode_ShackleScheduleCleanup(IH7,ZX7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif r<=0 then
call KR7(ZX7)
call SuijiMode_ShackleScheduleCleanup(IH7,ZX7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
    call SaveReal(L7,I97,0,r)
    call B67(ZX7,IH7,1,LoadReal(L7,I97,1))
    if GetUnitAbilityLevel(IH7,'Bdet')==0 then
        set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
        call UnitAddAbility(BB7,'A2XN')
        call B947IssueImmediateOrderById("R43 @ war3map.j:117193 (B968)",BB7,$D0291)
        call UnitApplyTimedLife(BB7,'BTLF',1.)
        set BB7=null
    endif
    if b then
        call SaveBoolean(L7,I97,10,false)
        call LINGXIA(ZX7,IH7)
    endif
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function SuijiMode_RhastaAerialShackleSpawnScepterWards takes unit suijiRhastaScepterCaster,unit suijiRhastaScepterTarget returns nothing
local integer suijiRhastaScepterLevel=0
local boolean suijiRhastaScepterHaveA=false
local integer suijiRhastaScepterCasterId=0
local integer suijiRhastaScepterWardId=0
local real suijiRhastaScepterTargetX=0.
local real suijiRhastaScepterTargetY=0.
local unit suijiRhastaScepterWard=null
if suijiRhastaScepterCaster==null or suijiRhastaScepterTarget==null then
return
endif
set suijiRhastaScepterLevel=B287_GetUnitAbilityLevel(suijiRhastaScepterCaster,'A00H')
if suijiRhastaScepterLevel==0 then
set suijiRhastaScepterLevel=B287_GetUnitAbilityLevel(suijiRhastaScepterCaster,'A0A1')
endif
// A copied Shackles owner may legitimately have no Mass Serpent Ward skill.
// Use Shackles' own level to select the Scepter ward tier in that case.
if suijiRhastaScepterLevel==0 then
set suijiRhastaScepterLevel=B287_GetUnitAbilityLevel(suijiRhastaScepterCaster,'A00P')+B287_GetUnitAbilityLevel(suijiRhastaScepterCaster,'X00P')+B287_GetUnitAbilityLevel(suijiRhastaScepterCaster,'X10P')
// Only C/D/E ward objects exist, so level 4 must use the strongest E tier.
if suijiRhastaScepterLevel>3 then
set suijiRhastaScepterLevel=3
endif
endif
if SuijiMode_ScepterRegistryIsActive(suijiRhastaScepterCaster,'A00P') or SuijiMode_ScepterRegistryIsActive(suijiRhastaScepterCaster,'X00P') or SuijiMode_ScepterRegistryIsActive(suijiRhastaScepterCaster,'X10P') then
set suijiRhastaScepterHaveA=true
endif
if suijiRhastaScepterHaveA==false or (suijiRhastaScepterLevel<=0 and ISLABIKE(suijiRhastaScepterCaster)==false) then
return
endif
set suijiRhastaScepterCasterId=GetUnitTypeId(suijiRhastaScepterCaster)
if suijiRhastaScepterCasterId=='Zrkn' then
set suijiRhastaScepterWardId='o11B'+suijiRhastaScepterLevel
elseif suijiRhastaScepterCasterId=='Zskn' then
set suijiRhastaScepterWardId='o21B'+suijiRhastaScepterLevel
else
set suijiRhastaScepterWardId='o01B'+suijiRhastaScepterLevel
endif
if ISLABIKE(suijiRhastaScepterCaster) and suijiRhastaScepterLevel==0 then
if GetUnitLevel(suijiRhastaScepterCaster)>=16 then
set suijiRhastaScepterWardId='o01E'
elseif GetUnitLevel(suijiRhastaScepterCaster)>=11 then
set suijiRhastaScepterWardId='o01D'
elseif GetUnitLevel(suijiRhastaScepterCaster)>=6 then
set suijiRhastaScepterWardId='o01C'
else
return
endif
endif
set suijiRhastaScepterTargetX=GetUnitX(suijiRhastaScepterTarget)
set suijiRhastaScepterTargetY=GetUnitY(suijiRhastaScepterTarget)
set suijiRhastaScepterWard=CreateUnit(GetOwningPlayer(suijiRhastaScepterCaster),suijiRhastaScepterWardId,suijiRhastaScepterTargetX,suijiRhastaScepterTargetY+50,0)
call B947IssueTargetOrderById("SuijiMode_RhastaAerialShackleSpawnScepterWards @ war3map.j:117259 (B968)",suijiRhastaScepterWard,$D000F,suijiRhastaScepterTarget)
call UnitApplyTimedLife(suijiRhastaScepterWard,'BTLF',5)
set suijiRhastaScepterWard=CreateUnit(GetOwningPlayer(suijiRhastaScepterCaster),suijiRhastaScepterWardId,suijiRhastaScepterTargetX,suijiRhastaScepterTargetY-50,0)
call B947IssueTargetOrderById("SuijiMode_RhastaAerialShackleSpawnScepterWards @ war3map.j:117262 (B968)",suijiRhastaScepterWard,$D000F,suijiRhastaScepterTarget)
call UnitApplyTimedLife(suijiRhastaScepterWard,'BTLF',5)
set suijiRhastaScepterWard=CreateUnit(GetOwningPlayer(suijiRhastaScepterCaster),suijiRhastaScepterWardId,suijiRhastaScepterTargetX+50,suijiRhastaScepterTargetY,0)
call B947IssueTargetOrderById("SuijiMode_RhastaAerialShackleSpawnScepterWards @ war3map.j:117265 (B968)",suijiRhastaScepterWard,$D000F,suijiRhastaScepterTarget)
call UnitApplyTimedLife(suijiRhastaScepterWard,'BTLF',5)
set suijiRhastaScepterWard=CreateUnit(GetOwningPlayer(suijiRhastaScepterCaster),suijiRhastaScepterWardId,suijiRhastaScepterTargetX-50,suijiRhastaScepterTargetY,0)
call B947IssueTargetOrderById("SuijiMode_RhastaAerialShackleSpawnScepterWards @ war3map.j:117268 (B968)",suijiRhastaScepterWard,$D000F,suijiRhastaScepterTarget)
call UnitApplyTimedLife(suijiRhastaScepterWard,'BTLF',5)
set suijiRhastaScepterWard=null
endfunction
function XYJS takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A00P')+GetUnitAbilityLevel(ZX7,'X00P')+GetUnitAbilityLevel(ZX7,'X10P')
local real YM7=(40.+80.*BC7)/(2.+.75*BC7)/10.
local unit BB7
call TriggerRegisterTimerEvent(t,.1,true)
call SaveReal(L7,I97,0,2.75+.75*BC7)
call SaveReal(L7,I97,1,YM7)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterDeathEvent(t,ZX7)
call TriggerRegisterDeathEvent(t,IH7)
call TriggerAddCondition(t,Condition(function R43))
call SaveUnitHandle(L7,I97,2,(ZX7))
call SaveUnitHandle(L7,I97,3,IH7)
call SaveBoolean(L7,I97,10,true)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call UnitAddAbility(BB7,'A2XN')
call B947IssueImmediateOrderById("XYJS @ war3map.j:117292 (B968)",BB7,$D0291)
call UnitApplyTimedLife(BB7,'BTLF',1.)
call SuijiMode_RhastaAerialShackleSpawnScepterWards(ZX7,IH7)
set BB7=null
set IH7=null
set ZX7=null
set t=null
endfunction
