function Get_Chat_Text takes player p,string VH returns string
	local integer O5=GetPlayerId(p)
	local integer n
	local string s=""
	if TZ7(p)==false or FUN==false then
		return s
	endif
	if VH=="FB" then
		set n=GetRandomInt(1,30)
		if n==1 then
			set s="就这？"
		elseif n==2 then
			set s="我还以为你多厉害呢"
		elseif n==3 then
			set s="你会不会玩？"
		elseif n==4 then
			set s="你这水平再去练练吧"
		elseif n==5 then
			set s="想笑！"
		elseif n==6 then
			set s="开局送一血，笑麻了"
		elseif n==7 then
			set s="菜得抠脚啊你"
		elseif n==8 then
			set s="这就是人类的操作？"
		elseif n==9 then
			set s="你的队友已经想举报你了"
		elseif n==10 then
			set s="免费送你回城"
		elseif n==11 then
			set s="菜！"
		elseif n==12 then
			set s="你的操作，狗看了都摇头"
		elseif n==13 then
			set s="人机都打不过，建议去玩连连看"
		elseif n==14 then
			set s="杀你比补个兵还简单"
		elseif n==15 then
			set s="你成功地逗笑我了"
		elseif n==16 then
			set s="这种水平也敢来打AI？"
		elseif n==17 then
			set s="这操作别出来丢人现眼了"
		elseif n==18 then
			set s="一不小心捏死了一只蚂蚁"
		elseif n==19 then
			set s="一血是我的了"
		elseif n==20 then
			set s="无解肥开局"
		elseif n==21 then
			set s="你就只有这种水平吗？"
		elseif n==22 then
			set s="你的走位是来搞笑的吗？"
		elseif n==23 then
			set s="你这操作，我奶奶看了都摇头"
		elseif n==24 then
			set s="你的操作，我可以用来做菜鸡集锦"
		elseif n==25 then
			set s="你和野怪的区别是什么？野怪还会跑"
		elseif n==26 then
			set s="你这反应速度，是拨号上网吗？"
		elseif n==27 then
			set s="给我死小菜鸡"
		elseif n==28 then
			set s="你是不是故意送的？"
		elseif n==29 then
			set s="你这水平，杀了你我都不好意思炫耀"
		elseif n==30 then
			set s="怎么我看了眼手机你就死了"
		endif
	elseif VH=="KILL2" then
		set n=GetRandomInt(1,40)
		if n==1 then
			set s="买一送一，谢谢老板"
		elseif n==2 then
			set s="两个而已，不够我热身的"
		elseif n==3 then
			set s="双双带走，你还想跑？"
		elseif n==4 then
			set s="两个一起上？结果一样"
		elseif n==5 then
			set s="才杀了两个，手都不抖"
		elseif n==6 then
			set s="两个菜鸟，一次搞定"
		elseif n==7 then
			set s="双杀而已，别大惊小怪"
		elseif n==8 then
			set s="双杀音效好听吗？再听一次？"
		elseif n==9 then
			set s="两个打一个被反杀，你们会不会玩？"
		elseif n==10 then
			set s="下一个是谁？自己过来送"
		elseif n==11 then
			set s="两个人头，双份快乐"
		elseif n==12 then
			set s="你们一个是卧龙，一个是凤雏"
		elseif n==13 then
			set s="别着急，一个一个死，排好队"
		elseif n==14 then
			set s="技能都没交全，你们就没了？"
		elseif n==15 then
			set s="两个大汉欺负我一个电脑？结果呢？"
		elseif n==16 then
			set s="一穿二，就这么简单"
		elseif n==17 then
			set s="双杀就像喝凉水，你们就像送水工"
		elseif n==18 then
			set s="一石二鸟，一箭双雕，一人双杀"
		elseif n==19 then
			set s="这波双杀，我给你们的演技打零分"
		elseif n==20 then
			set s="两个一起送，省得我一个个找"
		elseif n==21 then
			set s="你们的配合天衣无缝——送得天衣无缝"
		elseif n==22 then
			set s="杀你们比杀小兵还轻松"
		elseif n==23 then
			set s="双杀不解释"
		elseif n==24 then
			set s="你救他？你把自己也搭进去了"
		elseif n==25 then
			set s="两个菜鸟，一起凉凉"
		elseif n==26 then
			set s="你们的墓碑可以刻同一行字：‘来送的’"
		elseif n==27 then
			set s="两个人头，两份经验，零分智商"
		elseif n==28 then
			set s="你们俩的手速加起来还没我延迟高"
		elseif n==29 then
			set s="你俩是商量好一起送的吗？"
		elseif n==30 then
			set s="你们的操作看得我尴尬"
		elseif n==31 then
			set s="杀你们俩就跟呼吸一样简单"
		elseif n==32 then
			set s="我看你们的水平，连人机都不如"
		elseif n==33 then
			set s="我边喝水边双杀，你们边喝水边读秒"
		elseif n==34 then
			set s="我平A都能双杀，你们用技能都打不过我？"
		elseif n==35 then
			set s="一个菜得抠脚，另一个菜得离谱"
		elseif n==36 then
			set s="你们的操作，像是用脚玩的"
		elseif n==37 then
			set s="双杀你们，跟扫地板一样轻松"
		elseif n==38 then
			set s="你们是不是在打假赛？演得真像"
		elseif n==39 then
			set s="你们的操作，还不如我家的防御塔会打人"
		elseif n==40 then
			set s="双杀！下一个"
		endif
	elseif VH=="KILL3" then
		set n=GetRandomInt(1,30)
		if n==1 then
			set s="三杀到手，你们继续送"
		elseif n==2 then
			set s="别挣扎了，你们打不过我的"
		elseif n==3 then
			set s="三个打一个被反杀，你们会不会玩？"
		elseif n==4 then
			set s="你们是不是觉得电脑不会反杀？现在知道了？"
		elseif n==5 then
			set s="三个人打不过一个电脑？想笑！"
		elseif n==6 then
			set s="三杀就像吃自助餐，管够"
		elseif n==7 then
			set s="才杀三个，手都没热"
		elseif n==8 then
			set s="三杀就像下饺子，一个接一个浮上来"
		elseif n==9 then
			set s="葫芦娃救爷爷是吧，三连送"
		elseif n==10 then
			set s="三个菜鸟，三杀到手"
		elseif n==11 then
			set s="就这？动动手指就三杀了"
		elseif n==12 then
			set s="三个人打一个？笑死"
		elseif n==13 then
			set s="你们三个一起上也不够打啊"
		elseif n==14 then
			set s="也就三杀而已，别激动"
		elseif n==15 then
			set s="你们三个是来搞笑的吧"
		elseif n==16 then
			set s="别送了行吗？"
		elseif n==17 then
			set s="三个打不过我一个，绝了"
		elseif n==18 then
			set s="这波三杀我笑了"
		elseif n==19 then
			set s="三杀，你们服不服？"
		elseif n==20 then
			set s="三杀，舒服了呀"
		elseif n==21 then
			set s="三杀而已，洒洒水啦"
		elseif n==22 then
			set s="三个送得整整齐齐"
		elseif n==23 then
			set s="我边玩手机边玩游戏，你信吗？"
		elseif n==24 then
			set s="你们三个的配合，就是轮流送"
		elseif n==25 then
			set s="杀三个跟杀一个有什么区别？都是秒"
		elseif n==26 then
			set s="我技能乱放都能三杀"
		elseif n==27 then
			set s="三个人凑不出一个像样的操作"
		elseif n==28 then
			set s="你们的水平，打简单人机都费劲"
		elseif n==29 then
			set s="我打个喷嚏的功夫，你们三个就死了"
		elseif n==30 then
			set s="你们三个是不是约好了一起送人头？"
		endif	
	elseif VH=="KILL4" then
		set n=GetRandomInt(1,25)
		if n==1 then
			set s="四个了，下一个"
		elseif n==2 then
			set s="别急，马上送最后一个跟你们陪葬"
		elseif n==3 then
			set s="我已经在计算你们的心理阴影面积了"
		elseif n==4 then
			set s="有没有好心的哥哥姐姐送我暴走呀？"
		elseif n==5 then
			set s="来来来，继续送"
		elseif n==6 then
			set s="一个个送，真有你们的"
		elseif n==7 then
			set s="四个人头到手，爽"
		elseif n==8 then
			set s="四个都打不过我？别玩了"
		elseif n==9 then
			set s="四个菜鸡，想笑！"
		elseif n==10 then
			set s="我服了，你们真能送"
		elseif n==11 then
			set s="这波疯狂杀戮，帅不"
		elseif n==12 then
			set s="四个了，还差一个暴走"
		elseif n==13 then
			set s="疯狂杀戮，舒服了呀兄弟们"
		elseif n==14 then
			set s="四个送完了，第五个呢？"
		elseif n==15 then
			set s="四个人都换不掉我？笑死"
		elseif n==16 then
			set s="四个送得整整齐齐，感人"
		elseif n==17 then
			set s="疯狂杀戮，你们的配合呢？哦，没有配合"
		elseif n==18 then
			set s="杀了四个，第五个出来领死"
		elseif n==19 then
			set s="随便随便就四杀了好烦啊"
		elseif n==20 then
			set s="疯狂杀戮了，基本操作啦"
		elseif n==21 then
			set s="四个？再来一个凑一桌"
		elseif n==22 then
			set s="四杀？我的奶奶来都能做到"
		elseif n==23 then
			set s="一个人杀四个，你们服不服？"
		elseif n==24 then
			set s="四个人打一个被反杀，经典"
		elseif n==25 then
			set s="再来一个送暴走"
		endif	
	elseif VH=="KILL5" then
		set n=GetRandomInt(1,25)
		if n==1 then
			set s="你们全队都不够我杀的"
		elseif n==2 then
			set s="五杀暴走，拿什么赢我？"
		elseif n==3 then
			set s="谁能来阻止我？哦，你们都死光了"
		elseif n==4 then
			set s="还有谁？"
		elseif n==5 then
			set s="老子一打五"
		elseif n==6 then
			set s="把6扣在公屏上"
		elseif n==7 then
			set s="哎呀，基本操作啦"
		elseif n==8 then
			set s="轻松暴走，想笑！"
		elseif n==9 then
			set s="好烦啊，怎么一不小心就暴走了呢"
		elseif n==10 then
			set s="这就是作者[小生我怕怕]制作的超强AI"
		elseif n==11 then
			set s="暴走就像呼吸，自然而然地发生了"
		elseif n==12 then
			set s="五个人都打不过我，建议卸载游戏"
		elseif n==13 then
			set s="我看了眼手机怎么就暴走了，想笑！"
		elseif n==14 then
			set s="我就A个地板而已，怎么就暴走了呢"
		elseif n==15 then
			set s="五个打一个被团灭，经典"
		elseif n==16 then
			set s="五个都死了，就问你们服不服？"
		elseif n==17 then
			set s="送你们回泉水泡温泉"
		elseif n==18 then
			set s="暴走，一打五就这？"
		elseif n==19 then
			set s="这也能让我暴走？"
		elseif n==20 then
			set s="有个小技巧，你们可以按F10，然后再按EXX"
		elseif n==21 then
			set s="你们五个是商量好轮流送的吗？"
		elseif n==22 then
			set s="你们5个送得这么整齐，练过的？"
		elseif n==23 then
			set s="暴走，我一个人就够了"
		elseif n==24 then
			set s="五个菜鸡，一锅端"
		elseif n==25 then
			set s="五个打不过一个，别玩了"
		endif	
	elseif VH=="CHAOSHEN" then
		set n=GetRandomInt(1,50)
		if n==1 then
			set s="轻松超神，想笑！"
		elseif n==2 then
			set s="凡人，你们对力量一无所知"
		elseif n==3 then
			set s="让我数数……杀了你们多少次了？算了，手指头数不过来"
		elseif n==4 then
			set s="求求你们杀我一次吧？可惜你们做不到"
		elseif n==5 then
			set s="我的屏幕有点卡——原来是杀太多卡了"
		elseif n==6 then
			set s="我都没用键盘，只用鼠标点点就超神了"
		elseif n==7 then
			set s="这游戏太简单了，没难度啊"
		elseif n==8 then
			set s="哎呀，我好想死啊，怎么死不掉啊"
		elseif n==9 then
			set s="超神了，这把稳了兄弟们"
		elseif n==10 then
			set s="我看看谁能杀了我？"
		elseif n==11 then
			set s="连我都杀不掉？你们退了吧"
		elseif n==12 then
			set s="活着很难吗？对我而言挺简单的"
		elseif n==13 then
			set s="你们五个是来给我刷数据的吧"
		elseif n==14 then
			set s="我泉水都没回过，你们信吗？"
		elseif n==15 then
			set s="你们的技能是用来刮痧的？"
		elseif n==16 then
			set s="这游戏对你们来说是不是太难了？"
		elseif n==17 then
			set s="你们这样送，我都不好意思杀了"
		elseif n==18 then
			set s="我杀多少个了？我数不清了"
		elseif n==19 then
			set s="你们能不能争气点？杀我一次就行"
		elseif n==20 then
			set s="我怀疑你们在演我，但我没证据"
		elseif n==21 then
			set s="实在不行就开秘籍把我杀了吧，不丢人"
		elseif n==22 then
			set s="我都不好意思继续杀了，但我偏要杀"
		elseif n==23 then
			set s="这把打完我得看看回放，你们怎么打的这么能送"
		elseif n==24 then
			set s="你们杀我一次行不行？求求了"
		elseif n==25 then
			set s="这战绩，我自己都不信"
		elseif n==26 then
			set s="你们五个能不能一起上？算了，一起上也打不过我"
		elseif n==27 then
			set s="别送了行吗？我都超神了"
		elseif n==28 then
