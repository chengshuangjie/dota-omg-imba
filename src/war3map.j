call TriggerAddCondition(t,Condition(function BSG))
call SaveUnitHandle(L7,(I97),(45),(Y27))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveReal(L7,(I97),(6),((x)*1.0))
call SaveReal(L7,(I97),(7),((y)*1.0))
call SaveInteger(L7,(I97),(33),(0))
call SaveGroupHandle(L7,(I97),(187),(WS7()))
call BT1(ZX7)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2E5',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2SH',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),chakramReturnSkill,true)
call SuijiMode_ChakramDebugSchedule(ZX7,2,.05)
call SuijiMode_ChakramDebugSchedule(ZX7,3,.60)
set ZX7=null
set t=null
set Y27=null
endfunction
