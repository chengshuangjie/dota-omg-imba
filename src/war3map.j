//盛势闪光
function SSSG takes unit u returns nothing
    local timer t=CreateTimer()
    local integer I97=GetHandleId(t)
    call SaveUnitHandle(L7,I97,0,u)
    call TimerStart(t,0,false,function SSSG2)
    set t=null
endfunction
//迅疾闪光
function XJSG2 takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer hu = GetHandleId(u)
	local real X_A = LoadReal(TABLE_HY, h, 0)
	if GetTriggerEventId()== EVENT_WIDGET_DEATH or(GetUnitAbilityLevel(u,'B0K4')== 0 and GetTriggerEvalCount(t)> 2) or GetGameTime()>= X_A then
		call RemoveSavedHandle(TABLE_HY, hu,'A4HS')
		call SetUnitPhaseMove( u, false )
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
	endif
	set t = null
	set u = null
endfunction
function XJSG takes unit u returns nothing
	local trigger t
	local integer h
	local integer hu = GetHandleId(u)
    call Z57(u,'A4HU',1,5,'B0K4')
    call Z57(u,'A4HV',1,5,0)
	if HaveSavedHandle(TABLE_HY, hu,'A4HS') then
		set t = LoadTriggerHandle(TABLE_HY, hu,'A4HS')
		set h = GetHandleId(t)
	else
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call SetUnitPhaseMove( u, true )
		call TriggerRegisterTimerEvent(t, .02, true)
		call TriggerRegisterDeathEvent(t, u)
		call TriggerAddCondition(t, Condition(function XJSG2))
		call SaveTriggerHandle(TABLE_HY, hu,'A4HS', t)
		call SaveUnitHandle(TABLE_HY, h, 0, u)
	endif
	call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 5.)
	set t = null
endfunction
function GetHeroCast takes unit u returns real
    local real herocast=0
	if HaveSavedReal(TABLE_U, GetUnitTypeId(u),'CAST')==false then
        set herocast = MHUnit_GetDefDataReal(GetUnitTypeId(u),UNIT_DEF_DATA_CAST_POINT)
		call SaveReal(TABLE_U, GetUnitTypeId(u),'CAST', herocast)
	else
		set herocast = LoadReal(TABLE_U, GetUnitTypeId(u),'CAST')
	endif
    return herocast
endfunction
function GetHeroSkill takes unit u,integer i returns integer
    return LoadInteger(MSK,GetUnitPointValue(u),i)
endfunction
function SuijiMode_ApplyRequiemArcaneBlinkCastpoint takes unit u,integer logicalSkill,boolean active returns nothing
local integer physicalSkill=0
local real targetCastpoint=0.
if u==null or GetUnitTypeId(u)==0 or (logicalSkill!='A29J' and logicalSkill!='A1MP') then
return
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if physicalSkill==0 or GetUnitAbilityLevel(u,physicalSkill)<=0 then
return
endif
set targetCastpoint=1.+GetHeroCast(u)
if active then
set targetCastpoint=targetCastpoint*.5
endif
if RAbsBJ(SuijiMode_GetExactLiveAbilityCastpoint(u,physicalSkill)-targetCastpoint)>.001 then
call SuijiMode_SetExactLiveAbilityCastpoint(u,physicalSkill,targetCastpoint)
endif
endfunction
//排除已设置过前摇的技能
function BAN_Skill_Cast takes integer skill returns boolean
if skill=='YE1I' or skill=='A14I' then
return false
endif
if skill=='A020' or skill=='Y00P' or skill=='YD52' or skill=='A06V' or skill=='Y02O' or skill=='YD1D' or skill=='A06W' or skill=='Y02P' or skill=='YD02' then
return false
endif
    if skill=='A01O' or skill=='Y00M' then
        return false
    endif
    if skill=='AMdQ' or skill=='AMdW' or skill=='AMdE' or skill=='AMdR' or skill=='AMdD' or skill=='AMdT' or skill=='AMdF' then
        return false
    endif
    return skill!='A3RD' and skill!='A0RP' and skill!='A0RT' and skill!='A04P' and skill!='A1AU' and skill!='A2W7' and skill!='A4IT' and skill!='A4KK' and skill!='A0SB' and skill!='A4LZ' and skill!='A0DH' and skill!='A1OB' and skill!='A0GP' and skill!='A14P' and skill!='A2KU' and skill!='A00J' and skill!='A4K2' and skill!='A2FK' and skill!='A29J' and skill!='A1MP' and skill!='A6L1' and skill!='A6L2' and skill!='A6L3' and skill!='Y0L1' and skill!='Y0L2' and skill!='Y0L3' and skill!='YE02'
endfunction
function SetSkillCast takes unit u,boolean b returns nothing
    local integer i=1
    local integer skill
    local real skillcast
    local real herocast=GetHeroCast(u)
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000默认施法前摇是|r"+R2S(herocast))
    loop
    exitwhen i>10
        set skill=GetHeroSkill(u,i)
        if skill!=0 and GetUnitAbilityLevel(u,skill)>0 and herocast>0 and BAN_Skill_Cast(skill) and (skill!='A1RD' or SuijiMode_ScepterRegistryIsActive(u,'A1RD')==false) then
        set skillcast=SuijiMode_GetExactLiveAbilityCastpoint(u,skill)
        if skillcast>0 then
            if b then
                if skillcast==herocast then
                    call SuijiMode_SetExactLiveAbilityCastpoint(u,skill,herocast*.5)
                endif
            else
                if skillcast<herocast then
                    call SuijiMode_SetExactLiveAbilityCastpoint(u,skill,herocast)
                endif
            endif
        endif
        endif
        set i=i+1
    endloop
    call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(u,'A29J',b)
    call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(u,'A1MP',b)
endfunction
function SuijiMode_RequiemCastpointOnLearn takes nothing returns boolean
local integer skill=B287_GetLearnedSkill()
if skill=='A29J' or skill=='A1MP' then
call SuijiMode_ApplyRequiemArcaneBlinkCastpoint(GetTriggerUnit(),skill,GetUnitAbilityLevel(GetTriggerUnit(),'A2YR')>0)
endif
return false
endfunction
function MASG_TRI2 takes nothing returns nothing
local unit ZX7=GetEnumUnit()
local integer h=0
local boolean active=false
local boolean known=false
if IsUnitType(ZX7,UNIT_TYPE_HERO) and IsUnitIllusion(ZX7)==false then
    set h=GetHandleId(ZX7)
    set active=GetUnitAbilityLevel(ZX7,'A2YR')>0
    set known=OO7(h,"MASGArcaneBlinkStateKnown")
    // The old one-second loop enumerated all ten live hero abilities even
    // while Arcane Blink state was unchanged.  Reconcile only the actual item
    // transition; random-skill add/restore paths already repair recreated
    // physical buttons at their own bounded lifecycle events.
    if active and (known==false or OO7(h,"MASGArcaneBlinkActive")==false) then
        call SetSkillCast(ZX7,true)
    elseif active==false and known and OO7(h,"MASGArcaneBlinkActive") then
        call SetSkillCast(ZX7,false)
    endif
    call NS7(h,"MASGArcaneBlinkStateKnown",true)
    call NS7(h,"MASGArcaneBlinkActive",active)
endif
set ZX7=null
endfunction
function MASG_TRI takes nothing returns boolean
local group g=WS7()
call GroupAddGroup(KKPeriodicHeroItemGroup,g)
call ForGroup(g,function MASG_TRI2)
call WR7(g)
// Reuse the existing one-second pulse: at most 12 selected heroes, no I/O.
call ExecuteFunc("B1039Pulse")
set g=null
return false
endfunction
