function Miao_Say takes unit mvUnit, integer mvLine, integer mvPriority returns nothing
local real mvNow=GetGameTime()
local real mvX=0.
local real mvY=0.
// B885: complete approved voice set; handles are initialized synchronously.
if mvLine<1 or mvLine>21 then
return
endif
if mvUnit==null or GetUnitTypeId(mvUnit)!='HMD0' or IsUnitIllusion(mvUnit) then
return
endif
if OO7(GetHandleId(mvUnit),"SuijiMulticastCasting") or OO7(GetHandleId(mvUnit),"LotusReflecting") then
return
endif
if mvPriority==0 and GetLocalPlayer()!=GetOwningPlayer(mvUnit) then
return
endif
if mvPriority>0 then
if IsUnitVisible(mvUnit,GetLocalPlayer())==false then
return
endif
set mvX=GetUnitX(mvUnit)-GetCameraTargetPositionX()
set mvY=GetUnitY(mvUnit)-GetCameraTargetPositionY()
if mvX*mvX+mvY*mvY>2560000. then
return
endif
endif
// No handles, random numbers, orders or gameplay table writes below this point.
if mvPriority==0 and mvNow<MiaoVoiceUntil+.7 then
return
endif
if mvPriority>0 and mvPriority<MiaoVoicePriority and mvNow<MiaoVoiceUntil then
return
endif
if MiaoVoicePlaying!=null then
call StopSound(MiaoVoicePlaying,false,false)
endif
set MiaoVoicePlaying=MiaoVoiceSounds[mvLine]
set MiaoVoicePriority=mvPriority
set MiaoVoiceUntil=mvNow+I2R(GetSoundDuration(MiaoVoicePlaying))*.001
call StartSound(MiaoVoicePlaying)
endfunction
function Miao_VoiceCommand takes nothing returns boolean
local unit mvUnit=GetTriggerUnit()
local integer mvOrder=0
local integer mvLine=0
if GetLocalPlayer()==GetOwningPlayer(mvUnit) and UnitAlive(mvUnit) then
set MiaoVoiceEvents=MiaoVoiceEvents+1
if GetTriggerEventId()==EVENT_UNIT_SELECTED then
set MiaoVoiceSerial=MiaoVoiceSerial+1
set mvLine=1+ModuloInteger(MiaoVoiceSerial,3)
if ModuloInteger(MiaoVoiceSerial,8)==0 then
set mvLine=20+ModuloInteger(MiaoVoiceSerial/8,2)
endif
elseif GetTriggerEventId()==EVENT_UNIT_HERO_REVIVE_FINISH then
set mvLine=18
else
set mvOrder=GetIssuedOrderId()
if mvOrder==OrderId("attack") or mvOrder==OrderId("attackground") then
set MiaoVoiceSerial=MiaoVoiceSerial+1
set mvLine=7+ModuloInteger(MiaoVoiceSerial,3)
elseif mvOrder==OrderId("move") or mvOrder==OrderId("patrol") or mvOrder==OrderId("smart") then
set MiaoVoiceSerial=MiaoVoiceSerial+1
set mvLine=4+ModuloInteger(MiaoVoiceSerial,3)
endif
endif
if mvLine>0 then
call Miao_Say(mvUnit,mvLine,0)
endif
endif
set mvUnit=null
return false
endfunction
function Miao_VoiceDebug takes nothing returns nothing
local string b1060GetEventPlayerChatString=GetEventPlayerChatString()
local player mvPlayer=GetTriggerPlayer()
if GetLocalPlayer()==mvPlayer then
call DisplayTimedTextToPlayer(mvPlayer,0,0,20.,"[MIAO-VOICE MP3] probe="+I2S(GetHandleId(MiaoVoiceProbe))+" events="+I2S(MiaoVoiceEvents)+" handle="+I2S(GetHandleId(MiaoVoiceSounds[1]))+" fileMs="+I2S(GetSoundFileDuration("Sounds\\Miao\\select1.mp3")))
if MiaoVoicePlaying!=null then
call StopSound(MiaoVoicePlaying,false,false)
endif
if b1060GetEventPlayerChatString=="-miaosound" then
call StopSound(MiaoVoiceProbe,false,false)
call StartSound(MiaoVoiceProbe)
else
set MiaoVoicePlaying=MiaoVoiceSounds[1]
call StopSound(MiaoVoicePlaying,false,false)
call SetSoundVolume(MiaoVoicePlaying,110)
call SetSoundPitch(MiaoVoicePlaying,1.)
call StartSound(MiaoVoicePlaying)
endif
set MiaoVoiceUntil=GetGameTime()+1.5
endif
set mvPlayer=null
endfunction
function Miao_VoiceDebugInit takes nothing returns nothing
local trigger mvTrigger=CreateTrigger()
local integer mvPid=0
loop
exitwhen mvPid>11
call TriggerRegisterPlayerChatEvent(mvTrigger,Player(mvPid),"-miaovoice",true)
call TriggerRegisterPlayerChatEvent(mvTrigger,Player(mvPid),"-miaosound",true)
set mvPid=mvPid+1
endloop
call TriggerAddAction(mvTrigger,function Miao_VoiceDebug)
set mvTrigger=null
endfunction
function Miao_IsOwner takes unit mdUnit returns boolean
return mdUnit!=null and GetUnitTypeId(mdUnit)!=0 and IsUnitIllusion(mdUnit)==false and LoadBoolean(MiaoTable,GetHandleId(mdUnit),100)
endfunction
function Miao_IsEnemy takes unit mdCaster,unit mdTarget returns boolean
return mdCaster!=null and GetUnitTypeId(mdCaster)!=0 and mdTarget!=null and GetUnitTypeId(mdTarget)!=0 and UnitAlive(mdTarget) and IsUnitEnemy(mdTarget,GetOwningPlayer(mdCaster))
endfunction
function Miao_EndTimer takes timer mdTimer returns nothing
call FlushChildHashtable(MiaoTable,GetHandleId(mdTimer))
call PauseTimer(mdTimer)
call DestroyTimer(mdTimer)
endfunction
function Miao_Cleanse takes unit mdUnit returns nothing
call UnitRemoveBuffsEx(mdUnit,false,true,true,true,false,false,false)
call YW8(mdUnit,0,0)
endfunction
function Miao_Unlock takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local unit mdUnit=LoadUnitHandle(MiaoTable,GetHandleId(mdTimer),0)
if mdUnit!=null and GetUnitTypeId(mdUnit)!=0 then
call PauseUnitEx(mdUnit,false)
call SetUnitTimeScale(mdUnit,1.)
if LoadBoolean(MiaoTable,GetHandleId(mdTimer),1) and UnitAlive(mdUnit) then
call Miao_Cleanse(mdUnit)
endif
endif
call Miao_EndTimer(mdTimer)
set mdUnit=null
set mdTimer=null
endfunction
function Miao_Lock takes unit mdUnit,real mdDuration,string mdAnimation,boolean mdCleanse returns nothing
local timer mdTimer=CreateTimer()
// IMBA: pause/stun control duration x2 cap 5s.
if XOMG_IMBA_ENABLED then
set mdDuration=RMinBJ(mdDuration*IMBA_POWER,5.)
endif
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdUnit)
call SaveBoolean(MiaoTable,GetHandleId(mdTimer),1,mdCleanse)
call TimerStart(mdTimer,mdDuration,false,function Miao_Unlock)
call PauseUnitEx(mdUnit,true)
call SetUnitAnimation(mdUnit,mdAnimation)
set mdTimer=null
endfunction
function Miao_Visual takes unit mdCaster,integer mdId,real mdX,real mdY,real mdFacing,real mdHeight,real mdDuration returns unit
local unit mdVisual=CreateUnit(GetOwningPlayer(mdCaster),mdId,mdX,mdY,mdFacing)
call SetUnitFlyHeight(mdVisual,mdHeight,0.)
call UnitApplyTimedLife(mdVisual,'BTLF',mdDuration)
return mdVisual
endfunction
function Miao_SetCooldown takes unit mdCaster,integer mdSkill,real mdRemain returns nothing
if mdCaster!=null and GetUnitTypeId(mdCaster)!=0 and GetUnitAbilityLevel(mdCaster,mdSkill)>0 then
call YDWESetUnitAbilityState(mdCaster,mdSkill,1,RMaxBJ(0.,mdRemain))
call MHAbility_SetCooldownEx(mdCaster,mdSkill,RMaxBJ(0.,mdRemain),RMaxBJ(.01,mdRemain))
endif
endfunction
function Miao_ClearStepAttack takes unit mdCaster returns nothing
call SaveReal(MiaoTable,GetHandleId(mdCaster),135,0.)
call UnitRemoveAbility(mdCaster,'ZMdD')
call UnitRemoveAbility(mdCaster,'ZMdP')
endfunction
function Miao_StopShield takes unit mdCaster returns nothing
local timer mdTimer=LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),136)
call RemoveSavedHandle(MiaoTable,GetHandleId(mdCaster),136)
call SaveReal(MiaoTable,GetHandleId(mdCaster),132,0.)
if mdTimer!=null then
call Miao_EndTimer(mdTimer)
endif
if mdCaster!=null and GetUnitTypeId(mdCaster)!=0 then
call UnitRemoveAbility(mdCaster,'ZMdW')
call UnitRemoveAbility(mdCaster,'ZMdS')
call UnitRemoveAbility(mdCaster,'BMdS')
endif
set mdTimer=null
endfunction
function Miao_ShieldTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
if Miao_IsOwner(mdCaster)==false or UnitAlive(mdCaster)==false or GetGameTime()>=LoadReal(MiaoTable,GetHandleId(mdCaster),132) or SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdW')==false or (GetUnitAbilityLevel(mdCaster,'BMdS')==0 and GetGameTime()>=LoadReal(MiaoTable,mdKey,1)) then
call Miao_StopShield(mdCaster)
endif
set mdCaster=null
set mdTimer=null
endfunction
function Miao_StartShield takes unit mdCaster returns nothing
local timer mdTimer=null
call Miao_StopShield(mdCaster)
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdCaster)
call SaveReal(MiaoTable,GetHandleId(mdTimer),1,GetGameTime()+.25)
call SaveTimerHandle(MiaoTable,GetHandleId(mdCaster),136,mdTimer)
call SaveReal(MiaoTable,GetHandleId(mdCaster),132,GetGameTime()+8.)
call TimerStart(mdTimer,.05,true,function Miao_ShieldTick)
call SetPlayerAbilityAvailable(GetOwningPlayer(mdCaster),'ZMdW',false)
call UnitAddAbility(mdCaster,'ZMdW')
call UnitMakeAbilityPermanent(mdCaster,true,'ZMdW')
set mdTimer=null
endfunction
function Miao_ScepterReconcile takes nothing returns nothing
local unit mdCaster=MiaoEntryUnit
set MiaoEntryUnit=null
if Miao_IsOwner(mdCaster) then
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdQ')==false then
call SaveReal(MiaoTable,GetHandleId(mdCaster),130,0.)
endif
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdW')==false and LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),136)!=null then
call Miao_StopShield(mdCaster)
endif
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE')==false and LoadReal(MiaoTable,GetHandleId(mdCaster),135)>0. then
call Miao_ClearStepAttack(mdCaster)
endif
endif
set mdCaster=null
endfunction
function Miao_QRefresh takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local unit mdCaster=LoadUnitHandle(MiaoTable,GetHandleId(mdTimer),0)
local integer mdChance=0
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,GetHandleId(mdTimer),9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) and GetUnitAbilityLevel(mdCaster,'AMdQ')>0 and SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdQ') then
set mdChance=20+10*GetUnitAbilityLevel(mdCaster,'AMdR')
if LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),101)!=null then
set mdChance=30+15*GetUnitAbilityLevel(mdCaster,'AMdR')
endif
if GetRandomInt(1,100)<=mdChance then
call Miao_SetCooldown(mdCaster,'AMdQ',0.)
call SetUnitState(mdCaster,UNIT_STATE_MANA,GetUnitState(mdCaster,UNIT_STATE_MANA)+GetUnitState(mdCaster,UNIT_STATE_MAX_MANA)*.15)
call SaveReal(MiaoTable,GetHandleId(mdCaster),130,LoadReal(MiaoTable,GetHandleId(mdCaster),130)+.25)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",mdCaster,"origin"))
else
call SaveReal(MiaoTable,GetHandleId(mdCaster),130,0.)
endif
endif
call Miao_EndTimer(mdTimer)
set mdCaster=null
set mdTimer=null
endfunction
function Miao_WRefresh takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local unit mdCaster=LoadUnitHandle(MiaoTable,GetHandleId(mdTimer),0)
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,GetHandleId(mdTimer),9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) and SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdR') then
call Miao_SetCooldown(mdCaster,'AMdW',0.)
endif
call Miao_EndTimer(mdTimer)
set mdCaster=null
set mdTimer=null
endfunction
function Miao_ShadowHit takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local unit mdTarget=LoadUnitHandle(MiaoTable,mdKey,1)
local boolean mdWasSpell=Fe
if Miao_IsOwner(mdCaster) and Miao_IsEnemy(mdCaster,mdTarget) then
// Damage was already mitigated/amplified on the real attack. Do not amplify twice.
call SaveBoolean(MiaoTable,GetHandleId(mdCaster),141,true)
// Match the source's chaos/universal replay; B67(7) would compensate fort armor twice.
set Fe=true
call UnitDamageTarget(mdCaster,mdTarget,LoadReal(MiaoTable,mdKey,2),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
set Fe=mdWasSpell
call SaveBoolean(MiaoTable,GetHandleId(mdCaster),141,false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
endif
call Miao_EndTimer(mdTimer)
set mdTarget=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_QTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local integer mdCount=LoadInteger(MiaoTable,mdKey,1)
local group mdGroup=null
local unit mdTarget=null
local unit mdVisual=null
local real mdBonus=0.
local integer mdDamageType=2
local timer mdRefresh=null
if mdCount<2 and Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,mdKey,9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) then
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdQ') then
set mdBonus=LoadReal(MiaoTable,GetHandleId(mdCaster),130)
if mdBonus>=1. then
set mdDamageType=7
endif
endif
set mdGroup=CreateGroup()
call GroupEnumUnitsInRange(mdGroup,GetUnitX(mdCaster),GetUnitY(mdCaster),528.,null)
loop
set mdTarget=FirstOfGroup(mdGroup)
exitwhen mdTarget==null
call GroupRemoveUnit(mdGroup,mdTarget)
if Miao_IsEnemy(mdCaster,mdTarget) and IsUnitInRange(mdCaster,mdTarget,400.) then
call SaveBoolean(MiaoTable,mdKey,3,true)
call B67(mdCaster,mdTarget,mdDamageType,LoadReal(MiaoTable,mdKey,2)*(1.+mdBonus))
if UnitAlive(mdTarget) and IsUnitType(mdTarget,UNIT_TYPE_ANCIENT)==false then
call CommonUnitAddStun(mdTarget,.9,false)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
endif
endloop
call DestroyGroup(mdGroup)
set mdVisual=Miao_Visual(mdCaster,'eMdQ',GetUnitX(mdCaster),GetUnitY(mdCaster),GetUnitFacing(mdCaster)+60.,128.,.5)
call SetUnitVertexColor(mdVisual,200,200,200,255)
set mdCount=mdCount+1
else
set mdCount=3
endif
if mdCount>=3 then
if LoadBoolean(MiaoTable,mdKey,3) and LoadBoolean(MiaoTable,mdKey,4)==false and Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdQ') then
set mdRefresh=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdRefresh),0,mdCaster)
call SaveInteger(MiaoTable,GetHandleId(mdRefresh),9,LoadInteger(MiaoTable,mdKey,9))
// Source: empty third damage tick at .24, then a .5-second refresh delay.
call TimerStart(mdRefresh,.5,false,function Miao_QRefresh)
endif
call Miao_EndTimer(mdTimer)
else
call SaveInteger(MiaoTable,mdKey,1,mdCount)
call TimerStart(mdTimer,.12,false,function Miao_QTick)
endif
set mdVisual=null
set mdRefresh=null
set mdTarget=null
set mdGroup=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_QStopTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local integer mdStep=LoadInteger(MiaoTable,mdKey,1)
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,mdKey,9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) and mdStep<25 then
call B947IssueImmediateOrder("Miao_QStopTick @ war3map.j:188097 (B968)",mdCaster,"stop")
call SaveInteger(MiaoTable,mdKey,1,mdStep+1)
else
if mdCaster!=null and GetUnitTypeId(mdCaster)!=0 then
call SetUnitTimeScale(mdCaster,1.)
endif
call Miao_EndTimer(mdTimer)
endif
set mdCaster=null
set mdTimer=null
endfunction
function Miao_Counter takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local unit mdCaster=LoadUnitHandle(MiaoTable,GetHandleId(mdTimer),0)
local unit mdTarget=null
local unit mdVisual=null
local group mdGroup=null
local integer mdSlots=3
local real mdLevel=0.
local real mdAgi=0.
local real mdFacing=0.
local real mdX=0.
local real mdY=0.
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,GetHandleId(mdTimer),9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) then
set mdLevel=I2R(GetUnitAbilityLevel(mdCaster,'AMdW'))
set mdAgi=I2R(GetHeroAgi(mdCaster,true))
set mdFacing=GetUnitFacing(mdCaster)*bj_DEGTORAD
set mdX=GetUnitX(mdCaster)+64.*Cos(mdFacing)
set mdY=GetUnitY(mdCaster)+64.*Sin(mdFacing)
set mdVisual=Miao_Visual(mdCaster,'eMdW',mdX,mdY,GetUnitFacing(mdCaster),100.,.7)
call SetUnitVertexColor(mdVisual,150,200,250,255)
call SetUnitTimeScale(mdVisual,1.5)
call SetUnitAnimation(mdVisual,"spell one")
set mdGroup=CreateGroup()
call GroupEnumUnitsInRange(mdGroup,mdX,mdY,488.,null)
loop
set mdTarget=FirstOfGroup(mdGroup)
exitwhen mdTarget==null
call GroupRemoveUnit(mdGroup,mdTarget)
if Miao_IsEnemy(mdCaster,mdTarget) and IsUnitInRangeXY(mdTarget,mdX,mdY,360.) then
if mdSlots>0 and (GetUnitX(mdTarget)-GetUnitX(mdCaster))*Cos(mdFacing)+(GetUnitY(mdTarget)-GetUnitY(mdCaster))*Sin(mdFacing)>=0. then
set mdSlots=mdSlots-1
call B67(mdCaster,mdTarget,7,50.+60.*mdLevel+mdAgi*1.25)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\blood-boom体.mdx",mdTarget,"chest"))
else
call B67(mdCaster,mdTarget,1,30.+32.5*mdLevel+mdAgi*.5)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
if UnitAlive(mdTarget) and IsUnitType(mdTarget,UNIT_TYPE_ANCIENT)==false then
call CommonUnitAddStun(mdTarget,1.5,false)
endif
endif
endloop
call DestroyGroup(mdGroup)
endif
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,GetHandleId(mdTimer),9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) and SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE') then
set MiaoEntryUnit=mdCaster
call ExecuteFunc("Miao_CounterWave")
endif
call Miao_EndTimer(mdTimer)
set mdGroup=null
set mdTarget=null
set mdVisual=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_OnDamaging takes nothing returns boolean
local real mdDamage1060=MHDamagingEvent_GetDamage()
local unit mdTarget=MHEvent_GetUnit()
local unit mdSource=MHDamagingEvent_GetSource()
local integer mdKey=0
local integer mdLevel=0
local timer mdTimer=null
local real mdHealFactor=1.
local real mdUpgrade=0.
local boolean mdPerfect=false
if Miao_IsOwner(mdSource) and LoadTimerHandle(MiaoTable,GetHandleId(mdSource),101)!=null and LoadBoolean(MiaoTable,GetHandleId(mdSource),141)==false and SuijiMode_ScepterRegistryIsActive(mdSource,'AMdR') then
set mdDamage1060=mdDamage1060*(1.+.1*LoadInteger(MiaoTable,GetHandleId(mdSource),103))
call MHDamagingEvent_SetDamage(mdDamage1060)
endif
if Miao_IsOwner(mdTarget) and UnitAlive(mdTarget) and mdDamage1060>0. then
set mdKey=GetHandleId(mdTarget)
// Source GuardPoint blocks follow-up damage before another W counter can fire.
if LoadReal(MiaoTable,mdKey,105)>GetGameTime() then
set mdDamage1060=0.
call MHDamagingEvent_SetDamage(mdDamage1060)
elseif mdSource!=mdTarget and LoadReal(MiaoTable,mdKey,104)>GetGameTime() and GetUnitAbilityLevel(mdTarget,'BMdW')>0 then
if SuijiMode_ScepterRegistryIsActive(mdTarget,'AMdW') then
set mdUpgrade=1.
set mdPerfect=GetGameTime()<=LoadReal(MiaoTable,mdKey,104)-.5
if mdPerfect then
set mdHealFactor=2.
call Miao_SetCooldown(mdTarget,'AMdR',B582_GetAbilityCooldown(mdTarget,'AMdR')-10.)
endif
if GetGameTime()>=LoadReal(MiaoTable,mdKey,131) then
call SaveReal(MiaoTable,mdKey,131,GetGameTime()+20.)
call Miao_StartShield(mdTarget)
endif
endif
call SaveReal(MiaoTable,mdKey,104,0.)
call SaveReal(MiaoTable,mdKey,105,GetGameTime()+.1)
call UnitRemoveAbility(mdTarget,'BMdW')
set mdDamage1060=0.
call MHDamagingEvent_SetDamage(mdDamage1060)
set mdLevel=GetUnitAbilityLevel(mdTarget,'AMdW')
call SetWidgetLife(mdTarget,RMinBJ(GetUnitState(mdTarget,UNIT_STATE_MAX_LIFE),GetWidgetLife(mdTarget)+GetUnitState(mdTarget,UNIT_STATE_MAX_LIFE)*(.05+.05*mdLevel+.05*mdUpgrade)*mdHealFactor))
call SetUnitState(mdTarget,UNIT_STATE_MANA,GetUnitState(mdTarget,UNIT_STATE_MANA)+(5.+5.*mdLevel+5.*mdUpgrade)*mdHealFactor)
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdTarget)
call SaveInteger(MiaoTable,GetHandleId(mdTimer),9,LoadInteger(MiaoTable,mdKey,120))
call TimerStart(mdTimer,.3,false,function Miao_Counter)
call Miao_Say(mdTarget,15,3)
call Miao_Lock(mdTarget,.5,"spell two",true)
call SetUnitTimeScale(mdTarget,1.5)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(mdTarget),GetUnitY(mdTarget)))
if LoadTimerHandle(MiaoTable,mdKey,101)!=null and SuijiMode_ScepterRegistryIsActive(mdTarget,'AMdR') then
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdTarget)
call SaveInteger(MiaoTable,GetHandleId(mdTimer),9,LoadInteger(MiaoTable,mdKey,120))
call TimerStart(mdTimer,2.,false,function Miao_WRefresh)
endif
elseif LoadReal(MiaoTable,mdKey,132)>GetGameTime() and SuijiMode_ScepterRegistryIsActive(mdTarget,'AMdW') then
set mdDamage1060=mdDamage1060*.5
call MHDamagingEvent_SetDamage(mdDamage1060)
endif
endif
set mdTimer=null
set mdTarget=null
set mdSource=null
return false
endfunction
function Miao_OnDamage takes nothing returns boolean
local boolean mdPhysical1060=MHDamageEvent_IsPhysical()
// Keep the event snapshot as an integer: MemHack may return the sentinel -1.
local integer mdType1060=MHDamageEvent_GetDmgTypeInt()
local real mdDamage1060=MHDamageEvent_GetDamage()
local unit mdSource=MHDamageEvent_GetSource()
local unit mdTarget=MHEvent_GetUnit()
local timer mdState=null
local integer mdKey=0
local integer mdHits=0
local integer mdMax=0
local texttag mdText=null
local integer mdAdded=1
local timer mdEcho=null
local unit mdVisual=null
// Final-stage guard also covers modifiers that alter damage after Damaging.
if Miao_IsOwner(mdTarget) and LoadReal(MiaoTable,GetHandleId(mdTarget),105)>GetGameTime() then
set mdDamage1060=0.
call MHDamageEvent_SetDamage(mdDamage1060)
endif
if Miao_IsOwner(mdSource) and Miao_IsEnemy(mdSource,mdTarget) and mdDamage1060>0. then
set mdKey=GetHandleId(mdSource)
set mdState=LoadTimerHandle(MiaoTable,mdKey,101)
if Fe==false and mdPhysical1060 and mdType1060==GetHandleId(DAMAGE_TYPE_NORMAL) and LoadBoolean(MiaoTable,mdKey,141)==false then
if LoadReal(MiaoTable,mdKey,135)>0. and SuijiMode_ScepterRegistryIsActive(mdSource,'AMdE') then
call SaveReal(MiaoTable,mdKey,134,GetGameTime()+20.)
call Miao_ClearStepAttack(mdSource)
if UnitAlive(mdTarget) and IsUnitType(mdTarget,UNIT_TYPE_ANCIENT)==false then
call CommonUnitAddStun(mdTarget,1.,false)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl",mdTarget,"origin"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\bloodbath体.mdx",mdTarget,"origin"))
endif
if mdState!=null and SuijiMode_ScepterRegistryIsActive(mdSource,'AMdR') then
set mdEcho=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdEcho),0,mdSource)
call SaveUnitHandle(MiaoTable,GetHandleId(mdEcho),1,mdTarget)
call SaveReal(MiaoTable,GetHandleId(mdEcho),2,mdDamage1060*.5)
set mdDamage1060=mdDamage1060*.5
call MHDamageEvent_SetDamage(mdDamage1060)
call TimerStart(mdEcho,.2,false,function Miao_ShadowHit)
set mdVisual=Miao_Visual(mdSource,'eMdS',GetUnitX(mdSource),GetUnitY(mdSource),GetUnitFacing(mdSource),GetUnitFlyHeight(mdSource),.3)
call SetUnitVertexColor(mdVisual,255,255,255,100)
call SetUnitTimeScale(mdVisual,1.6)
call SetUnitAnimation(mdVisual,"attack")
endif
endif
if mdState!=null and LoadBoolean(MiaoTable,GetHandleId(mdState),2)==false then
set mdMax=25+25*LoadInteger(MiaoTable,mdKey,103)
if SuijiMode_ScepterRegistryIsActive(mdSource,'AMdR') and IsUnitType(mdTarget,UNIT_TYPE_HERO) and GetRandomInt(1,100)<=90 then
set mdAdded=2
if GetRandomInt(1,3)==1 then
set mdAdded=3
endif
endif
set mdHits=IMinBJ(mdMax,LoadInteger(MiaoTable,mdKey,102)+mdAdded)
call SaveInteger(MiaoTable,mdKey,102,mdHits)
// One tag per owner, updated per event, instead of an unbounded tag stream.
set mdText=LoadTextTagHandle(MiaoTable,GetHandleId(mdState),6)
if mdText!=null then
call SetTextTagText(mdText,I2S(mdHits)+" HIT",.022)
endif
endif
endif
set mdText=null
set mdEcho=null
set mdVisual=null
set mdState=null
set mdSource=null
set mdTarget=null
return false
endfunction
function Miao_ETargetTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local unit mdTarget=LoadUnitHandle(MiaoTable,mdKey,1)
local integer mdLeft=LoadInteger(MiaoTable,mdKey,2)
if Miao_IsOwner(mdCaster) and mdTarget!=null and GetUnitTypeId(mdTarget)!=0 and UnitAlive(mdTarget) and mdLeft>0 then
call B67(mdCaster,mdTarget,2,LoadReal(MiaoTable,mdKey,3))
// Damage can remove a summoned victim or the caster synchronously.
if GetUnitTypeId(mdTarget)!=0 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
endif
set mdLeft=mdLeft-1
if Miao_IsOwner(mdCaster) and GetUnitTypeId(mdTarget)!=0 and UnitAlive(mdTarget) then
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE') then
call SaveReal(MiaoTable,mdKey,3,LoadReal(MiaoTable,mdKey,3)*1.05)
endif
else
set mdLeft=0
endif
else
set mdLeft=0
endif
if mdLeft<=0 then
call Miao_EndTimer(mdTimer)
else
call SaveInteger(MiaoTable,mdKey,2,mdLeft)
endif
set mdTarget=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_EWaveTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local unit mdVisual=LoadUnitHandle(MiaoTable,mdKey,1)
local group mdSeen=LoadGroupHandle(MiaoTable,mdKey,2)
local integer mdStep=LoadInteger(MiaoTable,mdKey,3)+1
local real mdAngle=LoadReal(MiaoTable,mdKey,4)
local real mdRadius=165.+3.*mdStep
local real mdDistance=0.
local real mdDamage=0.
local integer mdHits=3
local group mdGroup=null
local unit mdTarget=null
local timer mdHitTimer=null
if mdStep<=23 and Miao_IsOwner(mdCaster) and mdVisual!=null and GetUnitTypeId(mdVisual)!=0 and UnitAlive(mdVisual) then
if mdStep<=20 then
set mdGroup=CreateGroup()
call GroupEnumUnitsInRange(mdGroup,GetUnitX(mdVisual),GetUnitY(mdVisual),mdRadius+128.,null)
loop
set mdTarget=FirstOfGroup(mdGroup)
exitwhen mdTarget==null
call GroupRemoveUnit(mdGroup,mdTarget)
if Miao_IsEnemy(mdCaster,mdTarget) and IsUnitInGroup(mdTarget,mdSeen)==false and IsUnitInRangeXY(mdTarget,GetUnitX(mdVisual),GetUnitY(mdVisual),mdRadius) then
call GroupAddUnit(mdSeen,mdTarget)
set mdDistance=RAbsBJ((GetUnitX(mdTarget)-LoadReal(MiaoTable,mdKey,5))*Cos(mdAngle)+(GetUnitY(mdTarget)-LoadReal(MiaoTable,mdKey,6))*Sin(mdAngle))
set mdHits=3
if mdDistance>650. then
set mdHits=9
elseif mdDistance>350. then
set mdHits=6
endif
set mdDamage=LoadReal(MiaoTable,mdKey,7)
if LoadBoolean(MiaoTable,mdKey,8)==false then
call SaveBoolean(MiaoTable,mdKey,8,true)
set mdDamage=mdDamage*3.
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE') then
set mdDamage=LoadReal(MiaoTable,mdKey,7)*4.
endif
endif
set mdHitTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdHitTimer),0,mdCaster)
call SaveUnitHandle(MiaoTable,GetHandleId(mdHitTimer),1,mdTarget)
call SaveInteger(MiaoTable,GetHandleId(mdHitTimer),2,mdHits)
call SaveReal(MiaoTable,GetHandleId(mdHitTimer),3,mdDamage)
call TimerStart(mdHitTimer,.05,true,function Miao_ETargetTick)
endif
endloop
call DestroyGroup(mdGroup)
endif
call SetUnitX(mdVisual,GetUnitX(mdVisual)+40.*Cos(mdAngle))
call SetUnitY(mdVisual,GetUnitY(mdVisual)+40.*Sin(mdAngle))
call SetUnitScale(mdVisual,1.+.03*mdStep,1.,1.)
call SaveInteger(MiaoTable,mdKey,3,mdStep)
else
call DestroyGroup(mdSeen)
// Timed life owns the dead wave's disappearance animation.
if mdVisual!=null and UnitAlive(mdVisual) then
call RemoveUnit(mdVisual)
endif
call Miao_EndTimer(mdTimer)
endif
set mdHitTimer=null
set mdTarget=null
set mdGroup=null
set mdSeen=null
set mdVisual=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_StartE takes unit mdCaster,real mdAngle,real mdScale returns nothing
local unit mdVisual=Miao_Visual(mdCaster,'eMdE',GetUnitX(mdCaster)+100.*Cos(mdAngle),GetUnitY(mdCaster)+100.*Sin(mdAngle),mdAngle*bj_RADTODEG,0.,.45)
local timer mdTimer=CreateTimer()
local integer mdKey=GetHandleId(mdTimer)
call SaveUnitHandle(MiaoTable,mdKey,0,mdCaster)
call SaveUnitHandle(MiaoTable,mdKey,1,mdVisual)
call SaveGroupHandle(MiaoTable,mdKey,2,CreateGroup())
call SaveReal(MiaoTable,mdKey,4,mdAngle)
call SaveReal(MiaoTable,mdKey,5,GetUnitX(mdCaster))
call SaveReal(MiaoTable,mdKey,6,GetUnitY(mdCaster))
call SaveReal(MiaoTable,mdKey,7,(1.5+3.*GetUnitAbilityLevel(mdCaster,'AMdE')+GetHeroAgi(mdCaster,true)*.1)*mdScale)
call TimerStart(mdTimer,.02,true,function Miao_EWaveTick)
set mdTimer=null
set mdVisual=null
endfunction
function Miao_CounterWave takes nothing returns nothing
local unit mdCaster=MiaoEntryUnit
set MiaoEntryUnit=null
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE') then
call Miao_StartE(mdCaster,GetUnitFacing(mdCaster)*bj_DEGTORAD,.7)
endif
set mdCaster=null
endfunction
function Miao_DTick takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local integer mdKey=GetHandleId(mdTimer)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local integer mdStep=LoadInteger(MiaoTable,mdKey,1)+1
local real mdAngle=LoadReal(MiaoTable,mdKey,2)
local real mdSpeed=RMinBJ(LoadReal(MiaoTable,mdKey,3),LoadReal(MiaoTable,mdKey,4))
local real mdDistance=LoadReal(MiaoTable,mdKey,4)
local real mdX=0.
local real mdY=0.
local real mdCooldown=6.
local real mdCooldownFactor=0.
// B876: the scripted stop can leave both the native and Channel carriers without
// a committed engine cooldown. Own D's cooldown on the first movement tick,
// after Warcraft's spell-effect callback has finished, and preserve normal CDR.
if mdStep==1 and Miao_IsOwner(mdCaster) and LoadInteger(MiaoTable,mdKey,10)==LoadInteger(MiaoTable,GetHandleId(mdCaster),121) then
set mdCooldownFactor=ReduceUnitAbilityCoolDownReal(mdCaster)
if mdCooldownFactor>0. then
set mdCooldown=mdCooldown*mdCooldownFactor
endif
call Miao_SetCooldown(mdCaster,'AMdD',mdCooldown)
endif
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and LoadInteger(MiaoTable,mdKey,9)==LoadInteger(MiaoTable,GetHandleId(mdCaster),120) then
if mdDistance>0. and mdSpeed>0. and LoadInteger(MiaoTable,mdKey,10)==LoadInteger(MiaoTable,GetHandleId(mdCaster),121) then
set mdX=X57(GetUnitX(mdCaster)+mdSpeed*Cos(mdAngle))
set mdY=X27(GetUnitY(mdCaster)+mdSpeed*Sin(mdAngle))
if IsTerrainPathable(mdX,GetUnitY(mdCaster),PATHING_TYPE_FLYABILITY) then
set mdX=GetUnitX(mdCaster)
endif
if IsTerrainPathable(GetUnitX(mdCaster),mdY,PATHING_TYPE_FLYABILITY) then
set mdY=GetUnitY(mdCaster)
endif
if IsTerrainPathable(mdX,mdY,PATHING_TYPE_FLYABILITY)==false then
if IsTerrainPathable(mdX,GetUnitY(mdCaster),PATHING_TYPE_WALKABILITY) then
set mdX=GetUnitX(mdCaster)
endif
if IsTerrainPathable(GetUnitX(mdCaster),mdY,PATHING_TYPE_WALKABILITY) then
set mdY=GetUnitY(mdCaster)
endif
if IsTerrainPathable(mdX,mdY,PATHING_TYPE_WALKABILITY)==false then
// Direct coordinates already bypass unit collision; do not overwrite another skill's pathing state.
call SetUnitX(mdCaster,mdX)
call SetUnitY(mdCaster,mdY)
else
set mdDistance=0.
endif
else
set mdDistance=0.
endif
call SaveReal(MiaoTable,mdKey,3,mdSpeed-8.)
call SaveReal(MiaoTable,mdKey,4,mdDistance-mdSpeed)
endif
else
set mdStep=25
endif
if mdStep>=25 then
if mdCaster!=null and GetUnitTypeId(mdCaster)!=0 then
call SetUnitInvulnerableEx(mdCaster,false)
endif
call Miao_EndTimer(mdTimer)
else
call SaveInteger(MiaoTable,mdKey,1,mdStep)
endif
set mdCaster=null
set mdTimer=null
endfunction
function Miao_EndR takes unit mdCaster,timer mdState returns nothing
local integer mdStateKey=GetHandleId(mdState)
local integer mdUnitKey=GetHandleId(mdCaster)
local unit mdBar=LoadUnitHandle(MiaoTable,mdStateKey,5)
local texttag mdText=LoadTextTagHandle(MiaoTable,mdStateKey,6)
if mdState==null or LoadTimerHandle(MiaoTable,mdUnitKey,101)!=mdState then
set mdText=null
set mdBar=null
return
endif
// Destroy controller ownership before command-card mutations.
call RemoveSavedHandle(MiaoTable,mdUnitKey,101)
call SaveInteger(MiaoTable,mdUnitKey,102,0)
if mdText!=null then
call DestroyTextTag(mdText)
endif
if mdBar!=null then
call RemoveUnit(mdBar)
endif
call Miao_EndTimer(mdState)
if mdCaster!=null and GetUnitTypeId(mdCaster)!=0 then
call UnitRemoveAbility(mdCaster,'AMdT')
call UnitRemoveAbility(mdCaster,'AMdF')
call UnitRemoveAbility(mdCaster,'ZMdC')
call UnitRemoveAbility(mdCaster,'AMdA')
call UnitRemoveAbility(mdCaster,'AMdI')
call UnitRemoveAbility(mdCaster,'ZMdR')
call UnitRemoveAbility(mdCaster,'BMdR')
call MHAbility_Disable(mdCaster,'AMdR',false,true)
endif
set mdText=null
set mdBar=null
endfunction
function Miao_FinishR takes unit mdCaster,timer mdState returns nothing
local integer mdKey=GetHandleId(mdState)
local real mdBase=LoadReal(MiaoTable,mdKey,3)
local real mdFactor=LoadReal(MiaoTable,mdKey,4)
local group mdGroup=CreateGroup()
local unit mdTarget=null
local unit mdVisual=null
call GroupEnumUnitsInRange(mdGroup,GetUnitX(mdCaster),GetUnitY(mdCaster),728.,null)
loop
set mdTarget=FirstOfGroup(mdGroup)
exitwhen mdTarget==null
call GroupRemoveUnit(mdGroup,mdTarget)
if Miao_IsEnemy(mdCaster,mdTarget) and IsUnitInRange(mdCaster,mdTarget,600.) then
if IsUnitInRange(mdCaster,mdTarget,200.) then
call B67(mdCaster,mdTarget,7,mdBase*1.5)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\blood-boom体.mdx",mdTarget,"chest"))
else
call B67(mdCaster,mdTarget,2,mdBase)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
endif
if UnitAlive(mdTarget) and IsUnitType(mdTarget,UNIT_TYPE_ANCIENT)==false then
call CommonUnitAddStun(mdTarget,mdFactor,false)
endif
endif
endloop
call DestroyGroup(mdGroup)
set mdVisual=Miao_Visual(mdCaster,'eMdR',GetUnitX(mdCaster),GetUnitY(mdCaster),0.,0.,2.)
call Miao_EndR(mdCaster,mdState)
set mdVisual=null
set mdTarget=null
set mdGroup=null
endfunction
function Miao_RTick takes nothing returns nothing
local timer mdState=GetExpiredTimer()
local integer mdKey=GetHandleId(mdState)
local unit mdCaster=LoadUnitHandle(MiaoTable,mdKey,0)
local unit mdBar=LoadUnitHandle(MiaoTable,mdKey,5)
local real mdLeft=LoadReal(MiaoTable,mdKey,1)
local boolean mdFinal=LoadBoolean(MiaoTable,mdKey,2)
local texttag mdText=LoadTextTagHandle(MiaoTable,mdKey,6)
local integer mdTicks=LoadInteger(MiaoTable,mdKey,10)
// AMdI is a control marker, not magic immunity. Keep cleansing on the
// existing controller, including Tian Duan's preparation, without clearing
// pause counters owned by our own cast animations or other controllers.
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and GetUnitAbilityLevel(mdCaster,'AMdI')>0 and GetGameTime()>=LoadReal(MiaoTable,mdKey,14) then
call SaveReal(MiaoTable,mdKey,14,GetGameTime()+.05)
call Miao_Cleanse(mdCaster)
endif
if Miao_IsOwner(mdCaster)==false or UnitAlive(mdCaster)==false or (GetUnitAbilityLevel(mdCaster,'BMdR')==0 and GetGameTime()>=LoadReal(MiaoTable,mdKey,13)) then
call Miao_EndR(mdCaster,mdState)
elseif mdFinal then
if GetGameTime()>=LoadReal(MiaoTable,mdKey,7) then
call Miao_FinishR(mdCaster,mdState)
endif
else
set mdTicks=mdTicks-1
set mdLeft=I2R(mdTicks)*.01
if mdLeft<=0. then
call Miao_EndR(mdCaster,mdState)
else
call SaveReal(MiaoTable,mdKey,1,mdLeft)
call SaveInteger(MiaoTable,mdKey,10,mdTicks)
call SetUnitX(mdBar,GetUnitX(mdCaster))
call SetUnitY(mdBar,GetUnitY(mdCaster))
call SetUnitFlyHeight(mdBar,GetUnitFlyHeight(mdCaster)+250.,0.)
call SetUnitAnimationByIndex(mdBar,R2I(mdLeft/LoadReal(MiaoTable,mdKey,8)*100.))
if mdTicks<=300 and ModuloInteger(mdTicks,25)==0 then
if LoadBoolean(MiaoTable,mdKey,11) then
call SetUnitColor(mdBar,PLAYER_COLOR_LIGHT_BLUE)
call SaveBoolean(MiaoTable,mdKey,11,false)
else
call SetUnitColor(mdBar,PLAYER_COLOR_RED)
call SaveBoolean(MiaoTable,mdKey,11,true)
endif
endif
call SetTextTagPosUnit(mdText,mdCaster,90.)
endif
endif
set mdText=null
set mdBar=null
set mdCaster=null
set mdState=null
endfunction
function Miao_RCooldown takes nothing returns nothing
local timer mdTimer=GetExpiredTimer()
local unit mdCaster=LoadUnitHandle(MiaoTable,GetHandleId(mdTimer),0)
local timer mdState=LoadTimerHandle(MiaoTable,GetHandleId(mdTimer),1)
local real mdCooldown=0.
if Miao_IsOwner(mdCaster) and UnitAlive(mdCaster) and mdState!=null and LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),101)==mdState and GetUnitAbilityLevel(mdCaster,'AMdR')>0 then
// Leave SPELL_EFFECT first so the native AHtc can commit its cooldown.
set mdCooldown=B582_GetAbilityCooldown(mdCaster,'AMdR')
if mdCooldown<=0. then
set mdCooldown=75.
if ReduceUnitAbilityCoolDownReal(mdCaster)>0. then
set mdCooldown=mdCooldown*ReduceUnitAbilityCoolDownReal(mdCaster)
endif
endif
// Preserve the committed cooldown across this one owned command-card transition.
call MHAbility_Disable(mdCaster,'AMdR',true,true)
call Miao_SetCooldown(mdCaster,'AMdR',mdCooldown)
endif
call Miao_EndTimer(mdTimer)
set mdState=null
set mdCaster=null
set mdTimer=null
endfunction
function Miao_OnSpell takes nothing returns boolean
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local unit mdCaster=GetTriggerUnit()
local unit mdTarget=GetSpellTargetUnit()
local integer mdSkill=GetSpellAbilityId()
local integer mdKey=GetHandleId(mdCaster)
local real mdLevel=I2R(GetUnitAbilityLevel(mdCaster,mdSkill))
local real mdAgi=I2R(GetHeroAgi(mdCaster,true))
local real mdAngle=0.
local timer mdTimer=null
local integer mdTimerKey=0
local unit mdVisual=null
local texttag mdText=null
if Miao_IsOwner(mdCaster)==false or UnitAlive(mdCaster)==false then
set mdCaster=null
set mdTarget=null
return false
endif
if GetPlayerController(GetOwningPlayer(mdCaster))==MAP_CONTROL_COMPUTER and not OO7(mdKey,"SuijiMulticastCasting") and not OO7(mdKey,"LotusReflecting") then
if mdSkill=='AMdT' then
call SaveReal(MiaoTable,mdKey,147,GetGameTime()+1.8)
elseif mdSkill=='AMdQ' or mdSkill=='AMdD' then
call SaveReal(MiaoTable,mdKey,147,GetGameTime()+.3)
elseif mdSkill=='AMdW' then
call SaveReal(MiaoTable,mdKey,147,GetGameTime()+.6)
elseif mdSkill=='AMdR' or mdSkill=='AMdF' or mdSkill=='AMdE' then
call SaveReal(MiaoTable,mdKey,147,GetGameTime()+.15)
endif
endif
if mdSkill=='AMdQ' then
call Miao_Say(mdCaster,10,2)
set mdTimer=CreateTimer()
set mdTimerKey=GetHandleId(mdTimer)
call SaveUnitHandle(MiaoTable,mdTimerKey,0,mdCaster)
call SaveReal(MiaoTable,mdTimerKey,2,(100.+35.*mdLevel+mdAgi*2.)*.25)
call SaveBoolean(MiaoTable,mdTimerKey,4,OO7(mdKey,"SuijiMulticastCasting") or OO7(mdKey,"LotusReflecting"))
call SaveInteger(MiaoTable,mdTimerKey,9,LoadInteger(MiaoTable,mdKey,120))
call TimerStart(mdTimer,0.,false,function Miao_QTick)
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdCaster)
call SaveInteger(MiaoTable,GetHandleId(mdTimer),9,LoadInteger(MiaoTable,mdKey,120))
call TimerStart(mdTimer,.01,true,function Miao_QStopTick)
call SetUnitAnimation(mdCaster,"attack slam")
call SetUnitTimeScale(mdCaster,2.)
elseif mdSkill=='AMdW' then
call Miao_Say(mdCaster,11,2)
call SaveReal(MiaoTable,mdKey,104,GetGameTime()+.6)
call B947IssueImmediateOrder("Miao_OnSpell @ war3map.j:188643 (B968)",mdCaster,"stop")
call SetUnitAnimation(mdCaster,"stand ready")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",mdCaster,"origin"))
elseif mdSkill=='AMdE' then
call Miao_Say(mdCaster,12,2)
set mdAngle=Atan2(b1060GetSpellTargetY-GetUnitY(mdCaster),b1060GetSpellTargetX-GetUnitX(mdCaster))
call SetUnitAnimation(mdCaster,"spell two")
call Miao_StartE(mdCaster,mdAngle,1.)
elseif mdSkill=='AMdD' then
call Miao_Say(mdCaster,14,2)
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdCaster)
call SaveReal(MiaoTable,GetHandleId(mdTimer),2,GetUnitFacing(mdCaster)*bj_DEGTORAD)
if GetPlayerController(GetOwningPlayer(mdCaster))==MAP_CONTROL_COMPUTER and LoadReal(MiaoTable,mdKey,146)>GetGameTime() then
call SaveReal(MiaoTable,GetHandleId(mdTimer),2,LoadReal(MiaoTable,mdKey,145))
call SetUnitFacing(mdCaster,LoadReal(MiaoTable,mdKey,145)*bj_RADTODEG)
endif
call SaveReal(MiaoTable,mdKey,146,0.)
call SaveReal(MiaoTable,GetHandleId(mdTimer),3,80.)
call SaveReal(MiaoTable,GetHandleId(mdTimer),4,400.)
call SaveInteger(MiaoTable,mdKey,121,LoadInteger(MiaoTable,mdKey,121)+1)
call SaveInteger(MiaoTable,GetHandleId(mdTimer),10,LoadInteger(MiaoTable,mdKey,121))
call SaveInteger(MiaoTable,GetHandleId(mdTimer),9,LoadInteger(MiaoTable,mdKey,120))
call TimerStart(mdTimer,.02,true,function Miao_DTick)
call SetUnitInvulnerableEx(mdCaster,true)
call B947IssueImmediateOrder("Miao_OnSpell @ war3map.j:188663 (B968)",mdCaster,"stop")
call SetUnitAnimation(mdCaster,"stand ready")
if SuijiMode_ScepterRegistryIsActive(mdCaster,'AMdE') and GetGameTime()>=LoadReal(MiaoTable,mdKey,134) then
call SetPlayerAbilityAvailable(GetOwningPlayer(mdCaster),'ZMdD',false)
call UnitAddAbility(mdCaster,'ZMdD')
call UnitMakeAbilityPermanent(mdCaster,true,'ZMdD')
if GetUnitAbilityLevel(mdCaster,'ZMdP')>0 then
call YDWESetUnitAbilityDataInteger(mdCaster,'ZMdP',1,ABILITY_DATA_DATA_A,R2I(50.+1.5*mdAgi))
call YDWESetUnitAbilityDataInteger(mdCaster,'ZMdP',2,ABILITY_DATA_DATA_A,R2I(50.+1.5*mdAgi))
call SetUnitAbilityLevel(mdCaster,'ZMdP',2)
call SetUnitAbilityLevel(mdCaster,'ZMdP',1)
call UnitMakeAbilityPermanent(mdCaster,true,'ZMdP')
call SaveReal(MiaoTable,mdKey,135,I2R(R2I(50.+1.5*mdAgi)))
endif
endif
elseif mdSkill=='AMdR' then
if LoadTimerHandle(MiaoTable,mdKey,101)==null then
call Miao_Say(mdCaster,13,2)
set mdTimer=CreateTimer()
set mdTimerKey=GetHandleId(mdTimer)
set mdVisual=CreateUnit(GetOwningPlayer(mdCaster),'eMdB',GetUnitX(mdCaster),GetUnitY(mdCaster),0.)
call SetUnitColor(mdVisual,PLAYER_COLOR_LIGHT_BLUE)
set mdText=CreateTextTag()
call SetTextTagText(mdText,"0 HIT",.022)
call SetTextTagPosUnit(mdText,mdCaster,90.)
call SaveUnitHandle(MiaoTable,mdTimerKey,0,mdCaster)
call SaveReal(MiaoTable,mdTimerKey,1,6.+2.*mdLevel)
call SaveReal(MiaoTable,mdTimerKey,8,6.+2.*mdLevel)
call SaveInteger(MiaoTable,mdTimerKey,10,600+200*R2I(mdLevel))
call SaveReal(MiaoTable,mdTimerKey,13,GetGameTime()+.25)
call SaveUnitHandle(MiaoTable,mdTimerKey,5,mdVisual)
call SaveTextTagHandle(MiaoTable,mdTimerKey,6,mdText)
call SaveTimerHandle(MiaoTable,mdKey,101,mdTimer)
call SaveInteger(MiaoTable,mdKey,102,0)
call SaveInteger(MiaoTable,mdKey,103,R2I(mdLevel))
call TimerStart(mdTimer,.01,true,function Miao_RTick)
call Miao_Cleanse(mdCaster)
call SetUnitAnimation(mdCaster,"stand ready")
// The disabled spellbook owns helper visibility; children keep legal coordinates.
call SetPlayerAbilityAvailable(GetOwningPlayer(mdCaster),'ZMdC',false)
call UnitAddAbility(mdCaster,'ZMdC')
call UnitMakeAbilityPermanent(mdCaster,true,'ZMdC')
call SetUnitAbilityLevel(mdCaster,'AMdA',R2I(mdLevel))
call UnitAddAbility(mdCaster,'AMdT')
call SetUnitAbilityLevel(mdCaster,'AMdT',R2I(mdLevel))
call UnitAddAbility(mdCaster,'AMdF')
call UnitMakeAbilityPermanent(mdCaster,true,'AMdI')
call UnitMakeAbilityPermanent(mdCaster,true,'AMdA')
call UnitMakeAbilityPermanent(mdCaster,true,'AMdT')
call UnitMakeAbilityPermanent(mdCaster,true,'AMdF')
set mdTimer=CreateTimer()
call SaveUnitHandle(MiaoTable,GetHandleId(mdTimer),0,mdCaster)
call SaveTimerHandle(MiaoTable,GetHandleId(mdTimer),1,LoadTimerHandle(MiaoTable,mdKey,101))
call TimerStart(mdTimer,0.,false,function Miao_RCooldown)
endif
elseif mdSkill=='AMdT' then
set mdTimer=LoadTimerHandle(MiaoTable,mdKey,101)
if mdTimer!=null and LoadBoolean(MiaoTable,GetHandleId(mdTimer),2)==false then
call Miao_Say(mdCaster,16,2)
set mdTimerKey=GetHandleId(mdTimer)
set mdLevel=I2R(LoadInteger(MiaoTable,mdKey,103))
call SaveBoolean(MiaoTable,mdTimerKey,2,true)
call SaveReal(MiaoTable,mdTimerKey,3,(75.*mdLevel+mdAgi*(.2+.1*mdLevel))*(1.+.005*LoadInteger(MiaoTable,mdKey,102)))
call SaveReal(MiaoTable,mdTimerKey,4,.75+.75*mdLevel)
call SaveReal(MiaoTable,mdTimerKey,7,GetGameTime()+1.7)
call Miao_Lock(mdCaster,1.7,"spell one",false)
endif
elseif mdSkill=='AMdF' and LoadTimerHandle(MiaoTable,mdKey,101)!=null and Miao_IsEnemy(mdCaster,mdTarget) then
call Miao_Say(mdCaster,17,2)
set mdAngle=Atan2(GetUnitY(mdCaster)-GetUnitY(mdTarget),GetUnitX(mdCaster)-GetUnitX(mdTarget))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(mdCaster),GetUnitY(mdCaster)))
call SetUnitX(mdCaster,X57(GetUnitX(mdTarget)+128.*Cos(mdAngle)))
call SetUnitY(mdCaster,X27(GetUnitY(mdTarget)+128.*Sin(mdAngle)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",GetUnitX(mdCaster),GetUnitY(mdCaster)))
call B947IssueTargetOrder("Miao_OnSpell @ war3map.j:188737 (B968)",mdCaster,"attack",mdTarget)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",mdTarget,"chest"))
call B67(mdCaster,mdTarget,2,.9*I2R(R2I(RMaxBJ(0.,GetUnitState(mdCaster,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(mdCaster,UNIT_STATE_ATTACK1_DAMAGE_BONUS)))))
endif
set mdText=null
set mdVisual=null
set mdTimer=null
set mdTarget=null
set mdCaster=null
return false
endfunction
function Miao_OnDeath takes nothing returns boolean
local unit mdCaster=GetTriggerUnit()
local timer mdState=LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),101)
call Miao_Say(mdCaster,19,4)
call SaveReal(MiaoTable,GetHandleId(mdCaster),147,0.)
call SaveReal(MiaoTable,GetHandleId(mdCaster),146,0.)
call RemoveSavedHandle(MiaoTable,GetHandleId(mdCaster),148)
call SaveInteger(MiaoTable,GetHandleId(mdCaster),120,LoadInteger(MiaoTable,GetHandleId(mdCaster),120)+1)
call SaveReal(MiaoTable,GetHandleId(mdCaster),104,0.)
call SaveReal(MiaoTable,GetHandleId(mdCaster),105,0.)
call SaveReal(MiaoTable,GetHandleId(mdCaster),130,0.)
if LoadTimerHandle(MiaoTable,GetHandleId(mdCaster),136)!=null then
call Miao_StopShield(mdCaster)
endif
if LoadReal(MiaoTable,GetHandleId(mdCaster),135)>0. then
call Miao_ClearStepAttack(mdCaster)
endif
if mdState!=null then
call Miao_EndR(mdCaster,mdState)
endif
set mdState=null
set mdCaster=null
return false
endfunction
// Called only for permanent Tempest removal, not ordinary hero death/revival.
function B1027MiaoRetireCurrent takes nothing returns nothing
local unit retired1027=MiaoEntryUnit
local integer retiredKey1027=GetHandleId(retired1027)
local timer state1027=null
set MiaoEntryUnit=null
if MiaoTable==null or retired1027==null or not LoadBoolean(MiaoTable,retiredKey1027,100) then
set retired1027=null
return
endif
// Existing delayed wave/hit controllers stop through Miao_IsOwner on their next tick.
call SaveBoolean(MiaoTable,retiredKey1027,100,false)
set state1027=LoadTimerHandle(MiaoTable,retiredKey1027,101)
if state1027!=null then
call Miao_EndR(retired1027,state1027)
endif
if LoadTimerHandle(MiaoTable,retiredKey1027,136)!=null then
call Miao_StopShield(retired1027)
endif
if GetUnitTypeId(retired1027)!=0 and LoadReal(MiaoTable,retiredKey1027,135)>0. then
call Miao_ClearStepAttack(retired1027)
endif
call FlushChildHashtable(MiaoTable,retiredKey1027)
set state1027=null
set retired1027=null
endfunction
function Miao_RegisterCurrent takes nothing returns nothing
local unit mdCaster=MiaoEntryUnit
local trigger mdTrigger=null
local integer mdLevel=1
set MiaoEntryUnit=null
if mdCaster==null or GetUnitTypeId(mdCaster)!='HMD0' or IsUnitIllusion(mdCaster) then
set mdCaster=null
return
endif
if MiaoStarted==false then
set MiaoStarted=true
set MiaoTable=InitHashtable()
call Miao_VoiceInit()
loop
exitwhen mdLevel>4
call SaveReal(ZCC,-'AMdQ',mdLevel,15.-2.*mdLevel)
call SaveReal(ZCC,-'AMdW',mdLevel,10.)
call SaveReal(ZCC,-'AMdE',mdLevel,17.-mdLevel)
if mdLevel<=3 then
call SaveReal(ZCC,-'AMdR',mdLevel,75.)
call SaveReal(ZCC,-'AMdT',mdLevel,75.)
endif
set mdLevel=mdLevel+1
endloop
call SaveReal(ZCC,-'AMdD',1,6.)
call SaveReal(ZCC,-'AMdF',1,1.)
set mdTrigger=CreateTrigger()
call TriggerAddCondition(mdTrigger,Condition(function Miao_OnDamaging))
call MHDamagingEvent_Register(mdTrigger)
set mdTrigger=CreateTrigger()
call TriggerAddCondition(mdTrigger,Condition(function Miao_OnDamage))
call MHDamageEvent_Register(mdTrigger)
endif
if LoadBoolean(MiaoTable,GetHandleId(mdCaster),100)==false then
call SaveBoolean(MiaoTable,GetHandleId(mdCaster),100,true)
call UnitMakeAbilityPermanent(mdCaster,true,'AMdD')
set mdTrigger=CreateTrigger()
call B1027TempestTrackListener(mdCaster,mdTrigger)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(mdTrigger,Condition(function Miao_OnSpell))
set mdTrigger=CreateTrigger()
call B1027TempestTrackListener(mdCaster,mdTrigger)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_DEATH)
call TriggerAddCondition(mdTrigger,Condition(function Miao_OnDeath))
set mdTrigger=CreateTrigger()
call B1027TempestTrackListener(mdCaster,mdTrigger)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_SELECTED)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(mdTrigger,mdCaster,EVENT_UNIT_HERO_REVIVE_FINISH)
call TriggerAddCondition(mdTrigger,Condition(function Miao_VoiceCommand))
call Miao_Say(mdCaster,18,0)
endif
set mdTrigger=null
set mdCaster=null
endfunction
function Luna_ShieldCleanseTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit u=LoadUnitHandle(L7,th,0)
local integer generation=LoadInteger(L7,th,1)
local integer ticks=LoadInteger(L7,th,2)
local boolean finished=u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false
if finished==false and (OM7(GetHandleId(u),"LunaShieldGeneration")!=generation or ON7(GetHandleId(u),"LunaShield")<=0.) then
set finished=true
endif
if finished==false then
call UnitRemoveBuffs(u,false,true)
call YW8(u,0,0)
set ticks=ticks+1
call SaveInteger(L7,th,2,ticks)
if ticks>=5 then
set finished=true
endif
endif
if finished then
call FlushChildHashtable(L7,th)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function Luna_ApplyShield takes unit u,real amount returns nothing
local integer h=GetHandleId(u)
local integer generation=OM7(h,"LunaShieldGeneration")+1
local timer t=CreateTimer()
local timer cleanseTimer=CreateTimer()
local effect e=OG7(h,"LunaShieldEffect")
call NP7(h,"LunaShieldGeneration",generation)
call NQ7(h,"LunaShield",amount)
if e!=null then
call DestroyEffect(e)
endif
call NU7(h,"LunaShieldEffect",AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl",u,"origin"))
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,generation)
// IMBA: shield duration x2 cap 30s.
if XOMG_IMBA_ENABLED then
call TimerStart(t,RMinBJ(5.*IMBA_POWER,30.),false,function Luna_ShieldExpire)
else
call TimerStart(t,5.,false,function Luna_ShieldExpire)
endif
call SaveUnitHandle(L7,GetHandleId(cleanseTimer),0,u)
call SaveInteger(L7,GetHandleId(cleanseTimer),1,generation)
call TimerStart(cleanseTimer,1.,true,function Luna_ShieldCleanseTick)
set t=null
set cleanseTimer=null
set e=null
endfunction
function Luna_OnDamaging takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local integer h=0
local real damage=MHDamagingEvent_GetDamage()
local real shield=0.
local effect e=null
if target!=null and damage>0. then
set h=GetHandleId(target)
set shield=ON7(h,"LunaShield")
if shield>0. then
if damage>=shield then
call MHDamagingEvent_SetDamage(damage-shield)
call RemoveSavedReal(L7,h,StringHash("LunaShield"))
set e=OG7(h,"LunaShieldEffect")
if e!=null then
call DestroyEffect(e)
call NN7(h,"LunaShieldEffect")
endif
else
call NQ7(h,"LunaShield",shield-damage)
call MHDamagingEvent_SetDamage(0.)
endif
endif
endif
set e=null
set target=null
return false
endfunction
function Luna_CrescentWaveHit takes nothing returns nothing
local unit caster=Wave_Sou
local unit target=Wave_U
if Luna_IsValidEnemy(caster,target) then
call B67(caster,target,13,40.+60.*Wave_LV+Luna_GetAttackDamageBonus(caster))
call Luna_ApplyMark(target)
endif
set target=null
set caster=null
endfunction
function Luna_CrescentVisualPeriodic takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer th=GetHandleId(t)
local player owner=LoadPlayerHandle(L7,th,0)
local real ax=LoadReal(L7,th,1)
local real ay=LoadReal(L7,th,2)
local real angle=LoadReal(L7,th,3)
local real traveled=112.*GetTriggerEvalCount(t)
local unit wave=null
local boolean finished=false
// The great-cleave death model extends substantially ahead of its unit origin.
// Stop at the eighth 112-range step so its visible front ends with the hidden
// 1000-range damage wave instead of drawing one extra model beyond the hit path.
if traveled>=896. then
set traveled=896.
set finished=true
endif
set wave=CreateUnit(owner,'h0GG',X57(ax+traveled*Cos(angle)),X27(ay+traveled*Sin(angle)),angle*bj_RADTODEG)
call KillUnit(wave)
if finished then
call FlushChildHashtable(L7,th)
call OZ7(t)
endif
set wave=null
set owner=null
set t=null
return false
endfunction
function Luna_StartCrescentVisual takes unit caster,real ax,real ay,real angle returns nothing
local trigger t=CreateTrigger()
local integer th=GetHandleId(t)
local unit wave=CreateUnit(GetOwningPlayer(caster),'h0GG',ax,ay,angle*bj_RADTODEG)
call KillUnit(wave)
call SavePlayerHandle(L7,th,0,GetOwningPlayer(caster))
call SaveReal(L7,th,1,ax)
call SaveReal(L7,th,2,ay)
call SaveReal(L7,th,3,angle)
call TriggerRegisterTimerEvent(t,.08,true)
call TriggerAddCondition(t,Condition(function Luna_CrescentVisualPeriodic))
set wave=null
set t=null
endfunction
function Luna_PassiveDashPeriodic takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer th=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,th,0)
local unit target=LoadUnitHandle(L7,th,1)
local real dx=0.
local real dy=0.
local real dist=0.
local real step=0.
local real angle=0.
local boolean finished=b1060GetTriggerEventId==EVENT_UNIT_DEATH
if caster==null or target==null or GetUnitTypeId(caster)==0 or GetUnitTypeId(target)==0 or UnitAlive(caster)==false or UnitAlive(target)==false or Luna_GetLevel(caster,'A6L0','Y0L0')<=0 or OO7(GetHandleId(caster),"LunaDashActive") or OO7(GetHandleId(caster),"LunaPassiveDashCancel") or GetTriggerEvalCount(t)>25 then
set finished=true
elseif finished==false then
set dx=GetUnitX(target)-GetUnitX(caster)
set dy=GetUnitY(target)-GetUnitY(caster)
set dist=SquareRoot(dx*dx+dy*dy)
if dist<=60. or dist>600. then
set finished=true
else
set step=RMinBJ(96.,dist-60.)
set angle=Atan2(dy,dx)
call SetUnitX(caster,X57(GetUnitX(caster)+step*Cos(angle)))
call SetUnitY(caster,X27(GetUnitY(caster)+step*Sin(angle)))
call MHUnit_SetFacing(caster,angle*bj_RADTODEG,true)
if ModuloInteger(GetTriggerEvalCount(t),3)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(caster),GetUnitY(caster)))
endif
endif
endif
if finished then
call DestroyEffect(LoadEffectHandle(L7,th,2))
if caster!=null and GetUnitTypeId(caster)!=0 then
if LoadBoolean(L7,th,10) then
call SetUnitInvulnerableEx(caster,false)
endif
call NS7(GetHandleId(caster),"LunaPassiveDashActive",false)
call NS7(GetHandleId(caster),"LunaPassiveDashCancel",false)
if OO7(GetHandleId(caster),"LunaDashActive")==false then
call SetUnitAnimationByIndex(caster,0)
call SetUnitTimeScale(caster,1.)
call SetUnitPhaseMove(caster,false)
if b1060GetTriggerEventId!=EVENT_UNIT_DEATH and UnitAlive(caster) and IsTerrainPathable(GetUnitX(caster),GetUnitY(caster),PATHING_TYPE_WALKABILITY) then
call SetUnitPosition(caster,GetUnitX(caster),GetUnitY(caster))
endif
endif
endif
call FlushChildHashtable(L7,th)
call OZ7(t)
endif
set target=null
set caster=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function Luna_StartPassiveDash takes unit caster,unit target returns nothing
local trigger t=null
local integer th=0
local real dx=0.
local real dy=0.
local real dist=0.
if caster==null or target==null or GetUnitTypeId(caster)==0 or GetUnitTypeId(target)==0 or OO7(GetHandleId(caster),"LunaPassiveDashActive") or OO7(GetHandleId(caster),"LunaDashActive") then
return
endif
set dx=GetUnitX(target)-GetUnitX(caster)
set dy=GetUnitY(target)-GetUnitY(caster)
set dist=SquareRoot(dx*dx+dy*dy)
if dist<=60. or dist>500. then
return
endif
set t=CreateTrigger()
set th=GetHandleId(t)
call SaveUnitHandle(L7,th,0,caster)
call SaveUnitHandle(L7,th,1,target)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,caster,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Luna_PassiveDashPeriodic))
call NS7(GetHandleId(caster),"LunaPassiveDashCancel",false)
call NS7(GetHandleId(caster),"LunaPassiveDashActive",true)
call SetUnitInvulnerableEx(caster,true)
call SaveBoolean(L7,th,10,true)
call SetUnitPhaseMove(caster,true)
call SetUnitAnimationByIndex(caster,3)
call SetUnitTimeScale(caster,1.5)
call SaveEffectHandle(L7,th,2,AddSpecialEffectTarget("war3mapImported\\SkewerTuskGlow_1.mdx",caster,"head"))
set t=null
endfunction
function Luna_OnAttackTargetOrder takes nothing returns boolean
local unit caster=GetTriggerUnit()
local unit target=GetOrderTargetUnit()
local integer orderId=GetIssuedOrderId()
local integer level=0
local integer h=0
if (orderId==851983 or orderId==851971) and caster!=null and target!=null and GetUnitTypeId(caster)!=0 and GetUnitTypeId(target)!=0 then
set level=Luna_GetLevel(caster,'A6L0','Y0L0')
if level>0 and Luna_IsValidEnemy(caster,target) and IsUnitIllusion(caster)==false then
set h=GetHandleId(caster)
if OM7(h,"LunaAttackCount")==0 and OO7(h,"LunaDashActive")==false then
call Luna_StartPassiveDash(caster,target)
endif
endif
endif
set target=null
set caster=null
return false
endfunction
function Luna_OnAttackStart takes nothing returns boolean
local unit target=GetTriggerUnit()
local unit caster=GetAttacker()
local integer level=0
local integer h=0
if caster!=null and target!=null and GetUnitTypeId(caster)!=0 and GetUnitTypeId(target)!=0 then
set level=Luna_GetLevel(caster,'A6L0','Y0L0')
if level>0 and Luna_IsValidEnemy(caster,target) and IsUnitIllusion(caster)==false then
set h=GetHandleId(caster)
if OM7(h,"LunaAttackCount")==0 and OO7(h,"LunaDashActive")==false then
call Luna_StartPassiveDash(caster,target)
endif
endif
endif
set target=null
set caster=null
return false
endfunction
function Luna_OnAttackDamage takes nothing returns boolean
local unit target=MHEvent_GetUnit()
local unit caster=MHDamageEvent_GetSource()
local integer level=0
local integer h=0
local integer count=0
local group g=null
local unit u=null
local real b1030LunaCenterX=0.
local real b1030LunaCenterY=0.
if Fe==false and caster!=null and target!=null and GetUnitTypeId(caster)!=0 and GetUnitTypeId(target)!=0 and MHDamageEvent_GetDamage()>0. and MHDamageEvent_IsPhysical() then
set level=Luna_GetLevel(caster,'A6L0','Y0L0')
if level>0 and Luna_IsValidEnemy(caster,target) and IsUnitIllusion(caster)==false then
set h=GetHandleId(caster)
set count=OM7(h,"LunaAttackCount")+1
if count>=3 then
set count=0
// Commit before dealing damage: nested events must see the consumed third hit.
call NP7(h,"LunaAttackCount",count)
set b1030LunaCenterX=GetUnitX(target)
set b1030LunaCenterY=GetUnitY(target)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,b1030LunaCenterX,b1030LunaCenterY,250.,null)
loop
set u=FirstOfGroup(g)
exitwhen u==null or GetUnitTypeId(caster)==0
call GroupRemoveUnit(g,u)
if Luna_IsValidEnemy(caster,u) then
call B67(caster,u,13,40.+40.*level+Luna_GetAttackDamageBonus(caster))
if GetUnitTypeId(caster)!=0 and Luna_IsValidEnemy(caster,u) then
call Luna_ApplyMark(u)
endif
endif
endloop
call DestroyGroup(g)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdl",b1030LunaCenterX,b1030LunaCenterY))
else
call NP7(h,"LunaAttackCount",count)
endif
endif
endif
set u=null
set g=null
set target=null
set caster=null
return false
endfunction
function Luna_DashPeriodic takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer th=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,th,0)
local real ax=LoadReal(L7,th,1)
local real ay=LoadReal(L7,th,2)
local real angle=LoadReal(L7,th,3)
local real distance=LoadReal(L7,th,4)
local real speed=LoadReal(L7,th,5)
local real traveled=speed*GetTriggerEvalCount(t)
local real x=0.
local real y=0.
local boolean refreshed=LoadBoolean(L7,th,6)
local boolean finished=b1060GetTriggerEventId==EVENT_UNIT_DEATH
local group hitGroup=LoadGroupHandle(L7,th,9)
local group scanGroup=null
local unit target=null
if caster==null or GetUnitTypeId(caster)==0 then
set finished=true
elseif finished==false then
if traveled>=distance then
set traveled=distance
set finished=true
endif
set x=X57(ax+traveled*Cos(angle))
set y=X27(ay+traveled*Sin(angle))
call SetUnitX(caster,x)
call SetUnitY(caster,y)
call MHUnit_SetFacing(caster,angle*bj_RADTODEG,true)
set scanGroup=CreateGroup()
call GroupEnumUnitsInRange(scanGroup,x,y,120.,null)
loop
set target=FirstOfGroup(scanGroup)
exitwhen target==null
call GroupRemoveUnit(scanGroup,target)
if IsUnitInGroup(target,hitGroup)==false and Luna_IsValidEnemy(caster,target) then
call GroupAddUnit(hitGroup,target)
call B67(caster,target,13,50.+50.*LoadInteger(L7,th,7)+Luna_GetAttackDamageBonus(caster))
if OO7(GetHandleId(target),"LunaMarked") then
call Luna_ClearMark(target)
set refreshed=true
call SaveBoolean(L7,th,6,true)
endif
endif
endloop
call DestroyGroup(scanGroup)
if ModuloInteger(GetTriggerEvalCount(t),3)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
endif
endif
if finished then
call DestroyEffect(LoadEffectHandle(L7,th,8))
if caster!=null and GetUnitTypeId(caster)!=0 then
if LoadBoolean(L7,th,10) then
call SetUnitInvulnerableEx(caster,false)
endif
call SetUnitAnimationByIndex(caster,0)
call SetUnitTimeScale(caster,1.)
call SetUnitPhaseMove(caster,false)
call NS7(GetHandleId(caster),"LunaDashActive",false)
if b1060GetTriggerEventId!=EVENT_UNIT_DEATH and UnitAlive(caster) and IsTerrainPathable(GetUnitX(caster),GetUnitY(caster),PATHING_TYPE_WALKABILITY) then
call SetUnitPosition(caster,GetUnitX(caster),GetUnitY(caster))
endif
if refreshed and b1060GetTriggerEventId!=EVENT_UNIT_DEATH then
call SuijiMode_RefreshTrackedSkillCooldown(caster,'A6L3')
endif
endif
if hitGroup!=null then
call DestroyGroup(hitGroup)
endif
call FlushChildHashtable(L7,th)
call OZ7(t)
endif
set target=null
set scanGroup=null
set hitGroup=null
set caster=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function Luna_MoonlightComboCooldownApply takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer th=GetHandleId(t)
local unit caster=LoadUnitHandle(L7,th,0)
local real cooldown=LoadReal(L7,th,1)
if caster!=null and GetUnitTypeId(caster)!=0 and cooldown>=0. then
// Defer beyond the native spell-effect cooldown write and the generic item-CDR
// handler.  The logical id resolves to A6L3 for Luna and Y0L3 for a random owner.
call Japi_ReduceUnitAbilityCoolDown(caster,'A6L3',cooldown)
endif
call FlushChildHashtable(L7,th)
call OZ7(t)
set caster=null
set t=null
return false
endfunction
function Luna_StartMoonlightComboCooldown takes unit caster,integer level returns nothing
local trigger t=null
local integer th=0
local real cooldown=15.
local real factor=1.
// X67 is the map's Night Stalker day test.  The authoritative source detector
// accepts both a currently held Scepter and a consumed blessing, but immediately
// rejects a dropped, sold or transferred ordinary Scepter.
if caster==null or GetUnitTypeId(caster)==0 or X67() or SuijiMode_DetectAghanimSourceState(caster)==false then
return
endif
if level<=1 then
set cooldown=25.
elseif level==2 then
set cooldown=20.
endif
set factor=ReduceUnitAbilityCoolDownReal(caster)
if factor<=0. then
set factor=1.
endif
set cooldown=cooldown*.40*factor
set t=CreateTrigger()
set th=GetHandleId(t)
call SaveUnitHandle(L7,th,0,caster)
call SaveReal(L7,th,1,cooldown)
call TriggerRegisterTimerEvent(t,.05,false)
call TriggerAddCondition(t,Condition(function Luna_MoonlightComboCooldownApply))
set t=null
endfunction
function Luna_StartDash takes unit caster,integer level,real ax,real ay,real bx,real by returns nothing
local trigger t=null
local integer th=0
local real angle=Atan2(by-ay,bx-ax)
local real distance=SquareRoot((bx-ax)*(bx-ax)+(by-ay)*(by-ay))
local group hitGroup=null
if caster==null or GetUnitTypeId(caster)==0 or distance<=0. or OO7(GetHandleId(caster),"LunaDashActive") then
return
endif
set t=CreateTrigger()
set th=GetHandleId(t)
set hitGroup=CreateGroup()
call SaveUnitHandle(L7,th,0,caster)
call SaveReal(L7,th,1,ax)
call SaveReal(L7,th,2,ay)
call SaveReal(L7,th,3,angle)
call SaveReal(L7,th,4,distance)
call SaveReal(L7,th,5,64.)
call SaveBoolean(L7,th,6,false)
call SaveInteger(L7,th,7,level)
call SaveGroupHandle(L7,th,9,hitGroup)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,caster,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function Luna_DashPeriodic))
call NS7(GetHandleId(caster),"LunaDashActive",true)
call SetUnitInvulnerableEx(caster,true)
call SaveBoolean(L7,th,10,true)
call SetUnitPhaseMove(caster,true)
call SetUnitAnimationByIndex(caster,3)
call SetUnitTimeScale(caster,1.5)
call SaveEffectHandle(L7,th,8,AddSpecialEffectTarget("war3mapImported\\SkewerTuskGlow_1.mdx",caster,"head"))
set hitGroup=null
set t=null
endfunction
function Luna_OnSpell takes nothing returns boolean
local unit caster=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
local integer level=GetUnitAbilityLevel(caster,skill)
local real ax=GetUnitX(caster)
local real ay=GetUnitY(caster)
local real bx=GetSpellTargetX()
local real by=GetSpellTargetY()
local real angle=Atan2(by-ay,bx-ax)
local real dist=0.
local group g=null
local unit target=null
if caster!=null and GetUnitTypeId(caster)!=0 and OO7(GetHandleId(caster),"LunaPassiveDashActive") then
call NS7(GetHandleId(caster),"LunaPassiveDashCancel",true)
endif
if skill=='A6L1' or skill=='Y0L1' then
set bx=ax+1000.*Cos(angle)
set by=ay+1000.*Sin(angle)
call Wave(caster,'h0GG',0.,1000.,150.,150.,ax,ay,bx,by,1400.,0,false,"Luna_CrescentWaveHit",level)
if IRR!=null then
call ShowUnit(IRR,false)
set IRR=null
endif
call Luna_StartCrescentVisual(caster,ax,ay,angle)
elseif skill=='A6L2' or skill=='Y0L2' then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,ax,ay,400.,null)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if Luna_IsValidEnemy(caster,target) then
call SetUnitX(target,ax+90.*Cos(Atan2(GetUnitY(target)-ay,GetUnitX(target)-ax)))
call SetUnitY(target,ay+90.*Sin(Atan2(GetUnitY(target)-ay,GetUnitX(target)-ax)))
call B67(caster,target,13,30.+40.*level+Luna_GetAttackDamageBonus(caster))
call CommonUnitAddStun(target,1.,false)
call Luna_ApplyMark(target)
endif
endloop
call DestroyGroup(g)
call Luna_ApplyShield(caster,200.+100.*level)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",ax,ay))
elseif skill=='A6L3' or skill=='Y0L3' then
set dist=SquareRoot((bx-ax)*(bx-ax)+(by-ay)*(by-ay))
if dist>800. then
set bx=ax+800.*Cos(angle)
set by=ay+800.*Sin(angle)
endif
call Luna_StartMoonlightComboCooldown(caster,level)
call Luna_StartDash(caster,level,ax,ay,bx,by)
endif
set target=null
set g=null
set caster=null
return false
endfunction
function Luna_Activate takes nothing returns nothing
local trigger t=null
if OO7(0,"LunaSystemInitialized") then
return
endif
call NS7(0,"LunaSystemInitialized",true)
call SaveReal(ZCC,-'A6L1',1,8.)
call SaveReal(ZCC,-'A6L1',2,8.)
call SaveReal(ZCC,-'A6L1',3,8.)
call SaveReal(ZCC,-'A6L1',4,8.)
call SaveReal(ZCC,-'A6L2',1,12.)
call SaveReal(ZCC,-'A6L2',2,12.)
call SaveReal(ZCC,-'A6L2',3,12.)
call SaveReal(ZCC,-'A6L2',4,12.)
call SaveReal(ZCC,-'A6L3',1,25.)
call SaveReal(ZCC,-'A6L3',2,20.)
call SaveReal(ZCC,-'A6L3',3,15.)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function Luna_OnAttackTargetOrder))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(t,Condition(function Luna_OnAttackStart))
set t=CreateTrigger()
call TriggerAddCondition(t,Condition(function Luna_OnAttackDamage))
call MHDamageEvent_Register(t)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Luna_OnSpell))
set t=CreateTrigger()
call TriggerAddCondition(t,Condition(function Luna_OnDamaging))
call MHDamagingEvent_Register(t)
set t=null
endfunction
function SuijiMode_InitCopiedSkill takes unit u,integer skill,integer level returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
if skill=='AIcd' or skill=='XIcd' or skill=='XIce' or skill=='XIcf' then
call B900AtrophyInitUnit(u)
endif
call SuijiMode_InitCopiedInvokerSkill(u,skill,level)
if skill=='A6L0' or skill=='A6L1' or skill=='A6L2' or skill=='A6L3' then
call Luna_Activate()
endif
call SuijiMode_InitAttackPassiveEvents(skill)
call SuijiMode_InitCrossRangeOrb(u,skill)
if skill=='A2NE' then
call ArcticBurn_RegisterAttack(u)
if B287_GetPhysicalAbilityId(u,'A2NE')=='Y0HB' then
call SuijiMode_ApplyRegisteredCooldown4(u,'A2NE',SuijiMode_ScepterRegistryIsActive(u,'A2NE'),50.,40.,30.,20.,0.,0.,0.,0.)
call SuijiMode_ApplyRegisteredManaCost4(u,'A2NE',SuijiMode_ScepterRegistryIsActive(u,'A2NE'),120,110,100,90,0,0,0,0)
endif
endif
if skill=='A2V6' or skill=='A2V4' or skill=='A2V5' or skill=='A2V7' or skill=='A2Z3' then
call SuijiMode_InitEarthSpiritCopiedUnit(u)
endif
if skill=='A1NA' then
call VisageSoulAssumption_InitUnit(u)
elseif skill=='A0VX' then
call VisageGravekeeperCloak_InitUnit(u,level)
elseif skill=='A1NE' or skill=='A2IG' then
call XF7(u,'A4AV')
call XF7(u,'A4JO')
endif
if skill=='A0S9' then
if SuijiMode_EnsureExactLiveAbility(u,'A0SA',true) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0SA',false)
endif
elseif skill=='A1NI' then
call SuijiMode_RemoveIdleTransientButton(u,'A1NH')
elseif skill=='A11N' then
call SuijiMode_RemoveIdleTransientButton(u,'A13D')
elseif skill=='A13T' then
call KunkkaTidebringer_InitUnit(u)
elseif skill=='A0MB' then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A0MB',level,true)
elseif skill=='A0AK' or skill=='A1FY' then
if SuijiMode_EnsureExactLiveAbility(u,'A0WF',true) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0WF',false)
endif
elseif skill=='A0RP' then
if SuijiMode_EnsureExactLiveAbility(u,'A0RT',true) then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0RT',false)
call SuijiMode_SetExactLiveAbilityCastpoint(u,B287_GetPhysicalAbilityId(u,'A0RP'),.01)
call SuijiMode_SetExactLiveAbilityCastpoint(u,'A0RT',.01)
endif
call TemplarAssassin_EnsureTrapScepter(u)
elseif skill=='A0RO' then
call TemplarAssassin_UpdatePsiBladesRange(u)
elseif skill=='A0H9' then
if SuijiMode_EnsureExactLiveAbility(u,'A0HA',true) then
// Reality must remain visible for every random Haunt owner, not only Spectre.
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0HA',true)
endif
elseif skill=='A0BE' and OO7(GetHandleId(u),"SuijiScriptedBerserkerCaptured")==false then
call SuijiMode_ApplyScriptedBerserkerRemote(u)
endif
if skill=='A2E4' then
set SUIJI_REACTIVE_ARMOR_UNIT=u
call ExecuteFunc("SuijiMode_ReactiveArmorInitCurrent")
set SUIJI_REACTIVE_ARMOR_UNIT=null
endif
if skill=='A4DJ' or skill=='A4DZ' then
call Reset_Skill_range(u)
endif
if skill=='A0DJ' then
call NS7(GetHandleId(u),"SuijiAftershock",true)
call NP7(GetHandleId(u),"SuijiAftershockLevel",level)
endif
if skill=='ACac' then
call SuijiMode_InitACac(u)
endif
if skill=='AHab' then
call SuijiMode_InitAHab(u)
endif
if skill=='A0DZ' then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A0MB',B287_GetUnitAbilityLevel(u,'A0DZ'),true)
endif
if skill=='A0LV' then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A2MC',B287_GetUnitAbilityLevel(u,'A0LV'),true)
endif
if skill=='A00J' or skill=='A4K2' then
call B287_MHAbility_SetCastpoint(u,'A00J',.01)
call B287_MHAbility_SetCastpoint(u,'A4K2',.01)
endif
if skill=='A062' and OO7(GetHandleId(u),"SuijiA062TechInit")==false then
call NS7(GetHandleId(u),"SuijiA062TechInit",true)
call SetPlayerTechResearched(GetOwningPlayer(u),'R00I',1)
endif
if skill=='A03U' then
call SuijiMode_SyncRandomTakeAim(u,level)
endif
if skill=='A064' then
call SuijiMode_InitA064(u)
endif
if skill=='A04P' or skill=='A1AU' then
call SET_HQJJ2(u,skill)
endif
if skill=='A2RA' then
call SuijiMode_InitA2RA(u)
endif
if skill=='A0BE' then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A09E',level,true)
endif
if skill=='A0O0' then
call XF7(u,'A4HN')
endif
if skill=='A0MX' then
call BrewmasterBrawler_RegisterDamage(u)
endif
if skill=='A0CL' then
call SuijiMode_SyncRandomDragonBlood(u,level)
endif
if skill=='A0AR' then
call W_9(u)
endif
if skill=='A0KY' then
if level>0 then
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZAMR',level)
else
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZAMR',B287_GetUnitAbilityLevel(u,'A0KY'))
endif
endif
if skill=='A029' then
call SuijiMode_InitA029(u)
endif
if skill=='A0O8' then
call SuijiMode_InitA0O8(u)
endif
if skill=='A03P' then
call SuijiMode_InitA03P(u)
endif
if skill=='A2W7' then
call B287_MHAbility_SetCastpoint(u,'A2W7',.01)
endif
if skill=='A086' then
call LVD(u,'A086')
endif
if skill=='A0MM' then
call SuijiMode_InitA0MM(u)
endif
if skill=='A0I8' then
call SuijiMode_InitA0I8(u)
endif
if skill=='A0LH' then
call SuijiMode_InitA0LH(u)
endif
if skill=='A01I' or skill=='A4BT' or skill=='A4BU' then
call SuijiMode_InitA01I(u)
endif
if skill=='A0LN' or skill=='A4F0' then
call SuijiMode_InitA0LN(u)
endif
// OMG grants the cast family A1J7/A4BZ/A4C1 (physical Y09I), not the native
// learn books A4BV/A4BW. Without Multiple_Skill init, SRE sees N5E=0 and the
// cast only enters cooldown without performing the jump or owning charges.
if skill=='A4BV' or skill=='A4BW' or skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then
call SuijiMode_InitA4BV(u)
endif
if skill=='A4A1' or skill=='A4A2' or skill=='A0OJ' or skill=='A2ZY' or skill=='A2ZZ' then
call SuijiMode_InitA4A1(u)
endif
if skill=='A2ZM' or skill=='A2ZN' or skill=='A1SA' or skill=='A2ZU' or skill=='A2ZV' or skill=='A2ZW' then
call SuijiMode_InitA2ZM(u)
endif
if skill=='A1PH' then
call SuijiMode_InitA1PH(u)
endif
if skill=='A0SB' then
call B287_MHAbility_SetCastpoint(u,'A0SB',.01)
endif
if skill=='A0S1' then
call SuijiMode_InitA0S1(u)
elseif skill=='A28Q' then
call SaveUnitHandle(L7,StringHash("SuijiIoOverchargeInitDeferred"),0,u)
call ExecuteFunc("IoOvercharge_InitCopiedDeferred")
endif
if (skill=='A01Y' or skill=='A4KM') and IsUnitIllusion(u)==false then
call SuijiMode_InitA01Y(u)
endif
if skill=='A1HR' then
call SuijiMode_InitA1HR(u)
endif
if skill=='A088' then
call NS7(GetHandleId(u),"SuijiMulticast",true)
endif
if skill=='A0DY' or skill=='A1WB' then
call NS7(GetHandleId(u),"SuijiHeartstopper",true)
call Y99(u,true)
elseif skill=='A18X' then
elseif skill=='A0LZ' then
if OO7(GetHandleId(u),"SuijiA0LZInit")==false then
call NS7(GetHandleId(u),"SuijiA0LZInit",true)
if SuijiMode_IsMeleeOrbCarrier(u)==false then
call G_D(u,true)
endif
endif
call SilencerStealInt_InitUnit(u)
elseif skill=='A1CD' then
if OO7(GetHandleId(u),"SuijiA1CDInit")==false then
call NS7(GetHandleId(u),"SuijiA1CDInit",true)
call MJG(u,true)
endif
elseif skill=='A19Q' then
if OO7(GetHandleId(u),"SuijiA19QInit")==false then
call NS7(GetHandleId(u),"SuijiA19QInit",true)
call MAD(u,true)
endif
elseif skill=='A0M3' then
if OO7(GetHandleId(u),"SuijiA0M3Init")==false then
call NS7(GetHandleId(u),"SuijiA0M3Init",true)
call VP9(u,true)
endif
elseif skill=='A0FV' then
call NS7(GetHandleId(u),"SuijiWarpath",true)
if OO7(GetHandleId(u),"SuijiA0FVInit")==false then
call NS7(GetHandleId(u),"SuijiA0FVInit",true)
call VG9(u,true)
endif
elseif skill=='A1IQ' then
if OO7(GetHandleId(u),"SuijiA1IQInit")==false then
call NS7(GetHandleId(u),"SuijiA1IQInit",true)
call UZ9(u,true)
endif
elseif skill=='A0QW' then
call NS7(GetHandleId(u),"SuijiOverload",true)
if OO7(GetHandleId(u),"SuijiA0QWInit")==false then
call NS7(GetHandleId(u),"SuijiA0QWInit",true)
call IAD(u,true)
endif
elseif skill=='A0QN' then
if OO7(GetHandleId(u),"SuijiA0QNInit")==false then
call NS7(GetHandleId(u),"SuijiA0QNInit",true)
if SuijiMode_IsMeleeOrbCarrier(u)==false then
call A89(u,true)
endif
endif
elseif skill=='A0QQ' then
if OO7(GetHandleId(u),"SuijiA0QQInit")==false then
call NS7(GetHandleId(u),"SuijiA0QQInit",true)
call AH9(u,true)
endif
elseif skill=='A1EA' then
if OO7(GetHandleId(u),"SuijiA1EAInit")==false then
call NS7(GetHandleId(u),"SuijiA1EAInit",true)
call NLD(u)
endif
elseif skill=='A03E' then
call W7E(u,true)
elseif skill=='A0BG' then
call RXD(u,true)
elseif skill=='A0CZ' then
if OO7(GetHandleId(u),"SuijiA0CZInit")==false then
call NS7(GetHandleId(u),"SuijiA0CZInit",true)
call TXD(u,true)
endif
elseif skill=='A081' then
elseif skill=='A1E6' then
call FLE(u,true)
elseif skill=='A0SS' then
elseif skill=='A04E' then
if OO7(GetHandleId(u),"SuijiA04EInit")==false then
