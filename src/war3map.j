// 	if GetItemTypeId(it)== LoadInteger(TABLE_P,'ITEM', TME) and GetGameTime()-LoadReal(TABLE_P,'ITEM', TME)< 11. and Alreay_Use(it)==false then
// 		set t = CreateTimer()
