function ChenIsHero takes unit u returns boolean
if u==null then
return false
endif
return IsUnitType(u,UNIT_TYPE_HERO) and (B287_GetUnitAbilityLevel(u,'A0KM')>0 or B287_GetUnitAbilityLevel(u,'A0LV')>0 or B287_GetUnitAbilityLevel(u,'A28T')>0 or B287_GetUnitAbilityLevel(u,'A2S2')>0 or B287_GetUnitAbilityLevel(u,'A0LT')>0 or B287_GetUnitAbilityLevel(u,'A1CS')>0)
endfunction
function ChenIsPersuadedUnit takes unit u returns boolean
if u==null then
return false
endif
return GetWidgetLife(u)>.405 and IsUnitType(u,UNIT_TYPE_HERO)==false and GetUnitTypeId(u)!='ncop' and GetUnitAbilityLevel(u,'Aeth')==1 and (GetUnitAbilityLevel(u,'A0KO')==1 or GetUnitAbilityLevel(u,'A0KQ')==1 or GetUnitAbilityLevel(u,'A0KR')==1 or GetUnitAbilityLevel(u,'A0KP')==1)
endfunction
function ChenIsOwnedPersuaded takes unit u,unit st returns boolean
if st==null then
return false
endif
return ChenIsPersuadedUnit(u) and GetOwningPlayer(u)==GetOwningPlayer(st)
endfunction
function ChenPenitenceDamage takes unit st,unit target,integer V77 returns nothing
local real d=10+10*V77+.2*I2R(GetHeroInt(st,true))
if st!=null and target!=null and d>0 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",target,"chest"))
call B67(st,target,3,d)
endif
endfunction
function WF9 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local integer V77=OM7(OB7,"Level")
local unit st=O77(OB7,"Chen")
local unit src=GetEventDamageSource()
local unit target=GetTriggerUnit()
local real so
local boolean isPhys=false
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamage()>$A then
set isPhys=YDWEIsEventPhysicalDamage()
set so=GetEventDamage()*(.05*V77+.1)
call DisableTrigger(t)
call B67(src,target,11,so)
if isPhys and (src==st or ChenIsOwnedPersuaded(src,st)) then
call ChenPenitenceDamage(st,target,V77)
endif
call EnableTrigger(t)
endif
else
call NM7(OB7)
call OZ7(t)
endif
set st=null
set src=null
set target=null
set t=null
return false
endfunction
