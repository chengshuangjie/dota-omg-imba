set M2D=null
set N9D=null
set NDD=null
set NED=null
set t=null
set BB7=null
endfunction
function NGD takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
if b1060B287_GetSpellAbilityId=='A21M' then
call NFD()
elseif b1060B287_GetSpellAbilityId=='A21N' then
call M_D()
endif
return false
endfunction
// B820: explicit ownership; ordinary death/temporary physical absence is not retirement.
function KKPassiveControllerStop takes unit passiveOwner,integer passiveSkill returns nothing
local integer passiveOwnerKey=GetHandleId(passiveOwner)
local integer passiveRegistryKey=StringHash("B820Passive"+I2S(passiveSkill))
local trigger passiveController=LoadTriggerHandle(KKControllerOwnerTable,passiveOwnerKey,passiveRegistryKey)
local integer passiveControllerKey=GetHandleId(passiveController)
local unit passiveDummy=LoadUnitHandle(L7,passiveControllerKey,19)
if passiveController!=null then
call RemoveSavedHandle(KKControllerOwnerTable,passiveOwnerKey,passiveRegistryKey)
call DisableTrigger(passiveController)
if passiveDummy!=null then
call RemoveUnit(passiveDummy)
endif
call FlushChildHashtable(L7,passiveControllerKey)
call OZ7(passiveController)
endif
if passiveSkill=='A0VC' then
call RemoveSavedBoolean(L7,passiveOwnerKey,StringHash("SuijiA0VCInit"))
elseif passiveSkill=='A029' then
call RemoveSavedBoolean(L7,passiveOwnerKey,StringHash("SuijiA029Init"))
endif
if passiveOwner!=null and GetUnitTypeId(passiveOwner)!=0 then
if passiveSkill=='A0VC' then
call UnitRemoveAbility(passiveOwner,'A2NX')
call UnitRemoveAbility(passiveOwner,'S3UR')
elseif passiveSkill=='A21L' then
call UnitRemoveAbility(passiveOwner,'A21N')
call UnitRemoveAbility(passiveOwner,'A21M')
endif
endif
set passiveController=null
set passiveDummy=null
endfunction
function NHD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer BC7=0
local player p=(LoadPlayerHandle(L7,(I97),(54)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call KKPassiveControllerStop(ZX7,'A21L')
set t=null
set ZX7=null
set p=null
return false
endif
set BC7=GetUnitAbilityLevel(ZX7,'A21L')
if BC7<=0 then
set t=null
set ZX7=null
set p=null
return false
endif
if GetUnitTypeId(ZX7)=='N017' or GetUnitTypeId(ZX7)=='N200' or GetUnitTypeId(ZX7)=='N201' or GetUnitTypeId(ZX7)=='N02B' then
if((LoadInteger(L7,(GetHandleId((ZX7))),((4416))))==1)==false or p!=GetOwningPlayer(ZX7)then
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21N',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21M',false)
call SaveInteger(L7,(GetHandleId((ZX7))),((4416)),(1))
call SaveInteger(L7,(GetHandleId((ZX7))),((4417)),(2))
if p!=GetOwningPlayer(ZX7)then
call SavePlayerHandle(L7,(I97),(54),(GetOwningPlayer(ZX7)))
endif
endif
if GetUnitAbilityLevel(ZX7,'A21N')!=BC7 then
call SetUnitAbilityLevel(ZX7,'A21N',BC7)
endif
elseif GetUnitTypeId(ZX7)=='N016' then
if((LoadInteger(L7,(GetHandleId((ZX7))),((4417))))==1)==false or p!=GetOwningPlayer(ZX7)then
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21N',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21M',true)
call SaveInteger(L7,(GetHandleId((ZX7))),((4417)),(1))
call SaveInteger(L7,(GetHandleId((ZX7))),((4416)),(2))
if p!=GetOwningPlayer(ZX7)then
call SavePlayerHandle(L7,(I97),(54),(GetOwningPlayer(ZX7)))
endif
endif
if B287_GetUnitAbilityLevel(ZX7,'A21M')!=BC7 then
call B287_SetUnitAbilityLevel(ZX7,'A21M',BC7)
endif
endif
set t=null
set ZX7=null
return false
endfunction
function NID takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 or LoadTriggerHandle(KKControllerOwnerTable,GetHandleId(ZX7),StringHash("B820Passive"+I2S('A21L')))!=null then
set ZX7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveTriggerHandle(KKControllerOwnerTable,GetHandleId(ZX7),StringHash("B820Passive"+I2S('A21L')),t)
call XF7(ZX7,'A21N')
call XF7(ZX7,'A21M')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21N',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A21M',false)
call SaveInteger(L7,(GetHandleId((ZX7))),((4416)),(2))
call SaveInteger(L7,(GetHandleId((ZX7))),((4417)),(2))
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function NHD))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SavePlayerHandle(L7,(I97),(54),(GetOwningPlayer(ZX7)))
set t=null
set ZX7=null
endfunction
function NJD takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetLearnedSkill()=='A21L' and IsUnitIllusion(b1060GetTriggerUnit)==false and GetUnitAbilityLevel(b1060GetTriggerUnit,'A21L')==1 then
call NID()
endif
if B287_GetLearnedSkill()=='A0O0' and IsUnitIllusion(b1060GetTriggerUnit)==false and B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0O0')==1 then
call XF7(b1060GetTriggerUnit,'A4HN')
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function GL8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function NJD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NGD))
set t=null
endfunction
function NKD takes nothing returns nothing
local unit target=GetEnumUnit()
local real duration=R34
if GetEnumUnit()==GetTriggerUnit()then
set duration=R34*2
endif
call Z57(target,'A0XE',R64,duration,'B00B')
set target=null
endfunction
function NMD takes nothing returns nothing
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local group g=WS7()
local unit u=(b1061SavedGetTriggerUnit)
local boolexpr suijiBattleTranceFilter=Condition(function BO7)
local integer suijiBattleTranceHandle=0
if u==null or GetUnitTypeId(u)==0 then
call WR7(g)
call DestroyBoolExpr(suijiBattleTranceFilter)
set g=null
set u=null
set suijiBattleTranceFilter=null
set b1061SavedGetTriggerUnit=null
return
endif
if SUIJI_MODE then
set suijiBattleTranceHandle=GetHandleId(u)
if LoadReal(L7,suijiBattleTranceHandle,StringHash("SuijiBattleTranceBlockUntil"))>TimerGetElapsed(W) then
call WR7(g)
call DestroyBoolExpr(suijiBattleTranceFilter)
set g=null
set u=null
set suijiBattleTranceFilter=null
set b1061SavedGetTriggerUnit=null
return
endif
call SaveReal(L7,suijiBattleTranceHandle,StringHash("SuijiBattleTranceBlockUntil"),TimerGetElapsed(W)+.45)
endif
set R64=B287_GetUnitAbilityLevel(u,'A1EJ')
set R34=5*SuijiMode_GetDurationMulticastCount(u,'A1EJ')
set IN4=u
call GroupEnumUnitsInRange(g,0,0,99999,suijiBattleTranceFilter)
call ForGroup(g,function NKD)
call DestroyBoolExpr(suijiBattleTranceFilter)
call WR7(g)
set g=null
set u=null
set suijiBattleTranceFilter=null
set b1061SavedGetTriggerUnit=null
endfunction
function NND takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1EJ' then
call NMD()
endif
return false
endfunction
function G18 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NND))
set t=null
endfunction
// Random ANcl transformation buttons cannot use the native ANcr/Abrf UnitID
// transition because an OMG hero may have any unit type.  Mirror the 16
// platform's overwrite-form lifecycle: capture the real hero model once,
// let the most recently entered form own the presentation, and fall back to
// another still-active form (or the original model) when that owner ends.
// Model writes happen only on a real form transition, never on the 0.10 tick.
function B1039Notify takes unit skinUnit1039 returns nothing
// Late-added skin system removed.
return
endfunction
function B1039NativeForm takes integer skinType1039 returns boolean
// Native alternate units from the existing transformation objects. Keep their
// skill appearance until they return; permanent growth is not a temporary form.
return skinType1039=='H00F' or skinType1039=='H00E' or skinType1039=='H00G' or skinType1039=='N01H' or skinType1039=='N01T' or skinType1039=='N01J' or skinType1039=='E015' or skinType1039=='E115' or skinType1039=='E116' or skinType1039=='H07I' or skinType1039=='Z07I' or skinType1039=='Eevm' or skinType1039=='E02V' or skinType1039=='E02W' or skinType1039=='E02U' or skinType1039=='E02O' or skinType1039=='H0CQ' or skinType1039=='Z0CQ' or skinType1039=='N013' or skinType1039=='N014' or skinType1039=='N015' or skinType1039=='N017' or skinType1039=='N200' or skinType1039=='N201' or skinType1039=='N02B' or skinType1039=='H08D' or skinType1039=='H08C' or skinType1039=='H084' or skinType1039=='H08B' or skinType1039=='H06X' or skinType1039=='H06Y' or skinType1039=='H06W' or skinType1039=='O017' or skinType1039=='N0MB' or skinType1039=='N0MC' or skinType1039=='N0MO' or skinType1039=='N0MA' or skinType1039=='N1MB' or skinType1039=='N1MC' or skinType1039=='N1MO' or skinType1039=='N1MA' or skinType1039=='Udrf' or skinType1039=='N0EJ' or skinType1039=='N0EK' or skinType1039=='N0EI' or skinType1039=='N0EM' or skinType1039=='H0E3' or skinType1039=='H0E4' or skinType1039=='H0E5'
endfunction
function B1039VisualFree takes unit skinUnit1039 returns boolean
return not IsUnitType(skinUnit1039,UNIT_TYPE_POLYMORPHED) and not OO7(GetHandleId(skinUnit1039),"SuijiVisualFormCaptured") and not B1039NativeForm(GetUnitTypeId(skinUnit1039))
endfunction
function SuijiMode_RefreshVisualForm takes unit u returns nothing
local integer h=0
local integer status=1
local integer epoch=0
local integer bestEpoch=0
local integer bestStatus=0
local integer currentStatus=0
local string model=""
local string currentModel=""
local string baseModel=""
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiVisualFormCaptured")==false then
return
endif
loop
exitwhen status>8
set epoch=LoadInteger(L7,h,StringHash("SuijiVisualFormEpoch")+status)
if epoch>bestEpoch then
set bestEpoch=epoch
set bestStatus=status
set model=LoadStr(L7,h,StringHash("SuijiVisualFormModel")+status)
endif
set status=status+1
endloop
set currentStatus=OM7(h,"SuijiVisualCurrentStatus")
set currentModel=LoadStr(L7,h,StringHash("SuijiVisualCurrentModel"))
if bestStatus==0 then
set baseModel=LoadStr(L7,h,StringHash("SuijiVisualBaseModel"))
if GetUnitTypeId(u)!=0 then
if currentStatus==5 then
call AddUnitAnimationProperties(u,"alternate",false)
endif
if baseModel!="" and currentModel!=baseModel then
call SetUnitAnimation(u,"morph")
call MHUnit_SetModel(u,baseModel,false)
call QueueUnitAnimation(u,"stand")
elseif currentStatus!=0 then
call SetUnitAnimation(u,"stand")
endif
endif
call NS7(h,"SuijiVisualFormCaptured",false)
call NP7(h,"SuijiVisualCurrentStatus",0)
call SaveStr(L7,h,StringHash("SuijiVisualBaseModel"),"")
call SaveStr(L7,h,StringHash("SuijiVisualCurrentModel"),"")
call B1039Notify(u)
elseif GetUnitTypeId(u)!=0 and (bestStatus!=currentStatus or model!=currentModel) then
if currentStatus==5 and bestStatus!=5 then
call AddUnitAnimationProperties(u,"alternate",false)
endif
call SetUnitAnimation(u,"morph")
call MHUnit_SetModel(u,model,false)
if bestStatus==5 then
call AddUnitAnimationProperties(u,"alternate",true)
endif
call QueueUnitAnimation(u,"stand")
call NP7(h,"SuijiVisualCurrentStatus",bestStatus)
call SaveStr(L7,h,StringHash("SuijiVisualCurrentModel"),model)
call B1039Notify(u)
endif
set model=""
set currentModel=""
set baseModel=""
endfunction
function SuijiMode_SetVisualForm takes unit u,integer status,string model returns nothing
local integer h=0
local integer epoch=0
if u==null or GetUnitTypeId(u)==0 or status<1 or status>8 or model=="" then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiVisualFormCaptured")==false then
call NS7(h,"SuijiVisualFormCaptured",true)
call SaveStr(L7,h,StringHash("SuijiVisualBaseModel"),EXGetUnitString(GetUnitTypeId(u),UNIT_STRING_MODEL_PATH))
call SaveStr(L7,h,StringHash("SuijiVisualCurrentModel"),EXGetUnitString(GetUnitTypeId(u),UNIT_STRING_MODEL_PATH))
// An equipped skin is the base appearance underneath scripted forms.
if LoadInteger(L7,h,StringHash("B1039SkinType"))==GetUnitTypeId(u) and HaveSavedString(L7,h,StringHash("B1039SkinModel")) then
call SaveStr(L7,h,StringHash("SuijiVisualBaseModel"),LoadStr(L7,h,StringHash("B1039SkinModel")))
call SaveStr(L7,h,StringHash("SuijiVisualCurrentModel"),LoadStr(L7,h,StringHash("B1039SkinModel")))
endif
call NP7(h,"SuijiVisualCurrentStatus",0)
endif
if LoadInteger(L7,h,StringHash("SuijiVisualFormEpoch")+status)==0 then
set epoch=OM7(h,"SuijiVisualEpochCounter")+1
call NP7(h,"SuijiVisualEpochCounter",epoch)
call SaveInteger(L7,h,StringHash("SuijiVisualFormEpoch")+status,epoch)
endif
call SaveStr(L7,h,StringHash("SuijiVisualFormModel")+status,model)
call SuijiMode_RefreshVisualForm(u)
set model=""
endfunction
function SuijiMode_EndVisualForm takes unit u,integer status returns nothing
local integer h=0
if u==null or status<1 or status>8 then
return
endif
set h=GetHandleId(u)
call SaveInteger(L7,h,StringHash("SuijiVisualFormEpoch")+status,0)
call SaveStr(L7,h,StringHash("SuijiVisualFormModel")+status,"")
call SuijiMode_RefreshVisualForm(u)
endfunction
function SuijiMode_BerserkerStateButtonBegin takes unit u returns nothing
local integer level=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set level=B287_GetUnitAbilityLevel(u,'A0BE')
if level<1 then
set level=GetUnitAbilityLevel(u,'Y03N')
endif
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
if GetUnitAbilityLevel(u,'ZBRR')==0 then
call XF7(u,'ZBRR')
call UnitMakeAbilityPermanent(u,true,'ZBRR')
endif
call SetUnitAbilityLevel(u,'ZBRR',level)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'ZBRR',true)
endfunction
function SuijiMode_BerserkerStateButtonEnd takes unit u returns nothing
if u==null then
return
endif
call UnitRemoveAbility(u,'ZBRR')
endfunction
// The 16-platform implementation owns separate ranged and melee templates.
// Keep the live OMG hero type stable, but mirror the template boundary by
// switching weapon mode together with range/BAT and by retaining an exact
// baseline for skill deletion.  These unit-data writes happen only on the
// explicit toggle lifecycle; no periodic command-card or ability scan is used.
function SuijiMode_CaptureScriptedBerserkerBase takes unit u returns nothing
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedBerserkerCaptured") then
return
endif
call NS7(h,"SuijiScriptedBerserkerCaptured",true)
call NP7(h,"SuijiScriptedBerserkerBaseWeapon",MHUnit_GetAtkDataInt(u,UNIT_ATK_DATA_WEAPON_TYPE1))
call NQ7(h,"SuijiScriptedBerserkerBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
call NQ7(h,"SuijiScriptedBerserkerBaseRange",B848_FormBaseRange(u))
call NQ7(h,"SuijiScriptedBerserkerBaseAcquire",B1091AcquireBase(u))
endfunction
function SuijiMode_ApplyScriptedBerserkerRemote takes unit u returns nothing
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
call SuijiMode_CaptureScriptedBerserkerBase(u)
call NS7(h,"SuijiScriptedBerserkerRemote",true)
call MHUnit_SetAtkDataInt(u,UNIT_ATK_DATA_WEAPON_TYPE1,UNIT_WEAPON_TYPE_MISSILE)
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,1.95)
call B848_SetFormRange(u,500.)
call B1091SetAcquireBase(u,800.)
call SuijiMode_SetVisualForm(u,1,EXGetUnitString('N016',UNIT_STRING_MODEL_PATH))
endfunction
function SuijiMode_ScriptedMeleeFormActive takes integer h,integer status returns boolean
if status==1 then
return OO7(h,"SuijiScriptedBerserkerForm")
endif
return OO7(h,"SuijiScriptedBearForm")
endfunction
function SuijiMode_ScriptedMeleeFormRefresh takes unit u returns nothing
local integer h=0
local integer currentType=0
local integer level=0
local real attackCooldown=1.6
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedBerserkerForm")==false and OO7(h,"SuijiScriptedBearForm")==false then
return
endif
set currentType=GetUnitTypeId(u)
if currentType!=OM7(h,"SuijiScriptedMeleeUnitType") then
call NP7(h,"SuijiScriptedMeleeUnitType",currentType)
call NQ7(h,"SuijiScriptedMeleeBaseAttack",GetUnitState(u,UNIT_STATE_ATTACK1_COOL))
call NQ7(h,"SuijiScriptedMeleeBaseRange",B848_FormBaseRange(u))
endif
if OO7(h,"SuijiScriptedBerserkerForm") then
set attackCooldown=1.55
set level=GetUnitAbilityLevel(u,'Y03N')
if level<1 then
set level=1
elseif level>4 then
set level=4
endif
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZBRM',level)
if GetUnitAbilityLevel(u,'A09E')!=level then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A09E',level,true)
endif
if GetUnitAbilityLevel(u,'A09E')>0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A09E',false)
endif
call SuijiMode_SetVisualForm(u,1,EXGetUnitString('N017',UNIT_STRING_MODEL_PATH))
endif
if OO7(h,"SuijiScriptedBearForm") then
set level=GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,'A0AG'))
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
call SuijiMode_EnsureHiddenRuntimeContainerLevel(u,'ZLHA',level)
if GetUnitAbilityLevel(u,'A1EC')!=level then
call SuijiMode_EnsureExactLiveAbilityLevel(u,'A1EC',level,true)
endif
endif
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,attackCooldown)
call B848_SetFormRange(u,150.)
endfunction
function SuijiMode_EndScriptedMeleeForm takes unit u,integer status returns nothing
local integer h=0
local boolean restoreBerserkerButton=false
if u==null then
return
endif
set h=GetHandleId(u)
if SuijiMode_ScriptedMeleeFormActive(h,status)==false then
return
endif
if status==1 then
call NS7(h,"SuijiScriptedBerserkerForm",false)
call UnitRemoveAbility(u,'ZBRD')
call UnitRemoveAbility(u,'ZBRH')
call UnitRemoveAbility(u,'ZBRA')
call UnitRemoveAbility(u,'ZBRM')
call UnitRemoveAbility(u,'A09E')
call SuijiMode_BerserkerStateButtonEnd(u)
set restoreBerserkerButton=true
else
call NS7(h,"SuijiScriptedBearForm",false)
call UnitRemoveAbility(u,'ZLHB')
call UnitRemoveAbility(u,'ZLHA')
call UnitRemoveAbility(u,'ZLHM')
call UnitRemoveAbility(u,'A1EC')
endif
if GetUnitTypeId(u)!=0 then
if OO7(h,"SuijiScriptedBerserkerForm") or OO7(h,"SuijiScriptedBearForm") then
call SuijiMode_ScriptedMeleeFormRefresh(u)
elseif status==1 then
call SuijiMode_ApplyScriptedBerserkerRemote(u)
else
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiScriptedMeleeBaseAttack"))
call B848_SetFormRange(u,ON7(h,"SuijiScriptedMeleeBaseRange"))
call NP7(h,"SuijiScriptedMeleeUnitType",0)
endif
endif
// Keep the player-availability write last. Some 1.27 platform builds may end
// the current event thread at this native, so all form cleanup must precede it.
if restoreBerserkerButton and GetUnitTypeId(u)!=0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0BE',true)
endif
endfunction
function SuijiMode_RestoreScriptedBerserkerBase takes unit u returns nothing
local integer h=0
if u==null then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedBerserkerCaptured")==false then
return
endif
call NS7(h,"SuijiScriptedBerserkerForm",false)
call NS7(h,"SuijiScriptedBerserkerRemote",false)
call NP7(h,"SuijiScriptedBerserkerSerial",OM7(h,"SuijiScriptedBerserkerSerial")+1)
call UnitRemoveAbility(u,'ZBRD')
call UnitRemoveAbility(u,'ZBRH')
call UnitRemoveAbility(u,'ZBRA')
call UnitRemoveAbility(u,'ZBRM')
call UnitRemoveAbility(u,'A09E')
call SuijiMode_BerserkerStateButtonEnd(u)
if GetUnitTypeId(u)!=0 then
call MHUnit_SetAtkDataInt(u,UNIT_ATK_DATA_WEAPON_TYPE1,OM7(h,"SuijiScriptedBerserkerBaseWeapon"))
call SetUnitState(u,UNIT_STATE_ATTACK1_COOL,ON7(h,"SuijiScriptedBerserkerBaseAttack"))
call B848_SetFormRange(u,ON7(h,"SuijiScriptedBerserkerBaseRange"))
call B1091SetAcquireBase(u,ON7(h,"SuijiScriptedBerserkerBaseAcquire"))
call NQ7(h,"SuijiScriptedMeleeBaseAttack",ON7(h,"SuijiScriptedBerserkerBaseAttack"))
call NQ7(h,"SuijiScriptedMeleeBaseRange",ON7(h,"SuijiScriptedBerserkerBaseRange"))
call SuijiMode_EndVisualForm(u,1)
endif
call NS7(h,"SuijiScriptedBerserkerCaptured",false)
if OO7(h,"SuijiScriptedBearForm") then
call SuijiMode_ScriptedMeleeFormRefresh(u)
else
call NP7(h,"SuijiScriptedMeleeUnitType",0)
endif
endfunction
function SuijiMode_ScriptedMeleeFormTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer status=LoadInteger(L7,timerHandle,1)
local integer serial=LoadInteger(L7,timerHandle,2)
local integer h=0
local integer currentSerial=0
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
set h=GetHandleId(u)
if status==1 then
set currentSerial=OM7(h,"SuijiScriptedBerserkerSerial")
else
set currentSerial=OM7(h,"SuijiScriptedBearSerial")
endif
if serial!=currentSerial or SuijiMode_ScriptedMeleeFormActive(h,status)==false then
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
return
endif
if UnitAlive(u)==false then
call SuijiMode_EndScriptedMeleeForm(u,status)
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_ScriptedMeleeFormRefresh(u)
endif
set u=null
set t=null
endfunction
function SuijiMode_ToggleScriptedMeleeForm takes unit u,integer status returns nothing
local integer h=0
local integer serial=0
local timer t=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if SuijiMode_ScriptedMeleeFormActive(h,status) then
call SuijiMode_EndScriptedMeleeForm(u,status)
return
endif
if OO7(h,"SuijiScriptedBerserkerForm")==false and OO7(h,"SuijiScriptedBearForm")==false then
call NP7(h,"SuijiScriptedMeleeUnitType",0)
endif
if status==1 then
set serial=OM7(h,"SuijiScriptedBerserkerSerial")+1
call NP7(h,"SuijiScriptedBerserkerSerial",serial)
call NS7(h,"SuijiScriptedBerserkerForm",true)
call NS7(h,"SuijiScriptedBerserkerRemote",false)
call SuijiMode_CaptureScriptedBerserkerBase(u)
call MHUnit_SetAtkDataInt(u,UNIT_ATK_DATA_WEAPON_TYPE1,UNIT_WEAPON_TYPE_MELEE)
call B1091SetAcquireBase(u,800.)
call SuijiMode_BerserkerStateButtonBegin(u)
call SuijiMode_SetVisualForm(u,1,EXGetUnitString('N017',UNIT_STRING_MODEL_PATH))
else
set serial=OM7(h,"SuijiScriptedBearSerial")+1
call NP7(h,"SuijiScriptedBearSerial",serial)
call NS7(h,"SuijiScriptedBearForm",true)
endif
call SuijiMode_ScriptedMeleeFormRefresh(u)
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
call SaveInteger(L7,GetHandleId(t),1,status)
call SaveInteger(L7,GetHandleId(t),2,serial)
call TimerStart(t,.10,true,function SuijiMode_ScriptedMeleeFormTick)
set t=null
// As above, the visibility native is intentionally the final transition.
if status==1 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0BE',false)
endif
endfunction
function NOD takes nothing returns boolean
local unit u=GetTriggerUnit()
local boolean result=B287_GetSpellAbilityId()=='A0BE' or B287_GetSpellAbilityId()=='A0AG' or GetSpellAbilityId()=='ZBRR'
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH and u!=null then
set result=OO7(GetHandleId(u),"SuijiScriptedBerserkerForm") or OO7(GetHandleId(u),"SuijiScriptedBearForm")
endif
set u=null
return result
endfunction
function NPD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SetUnitAbilityLevel(ZX7,'A09E',B287_GetUnitAbilityLevel(ZX7,'A0BE'))
call UnitRemoveAbility(ZX7,'B09Y')
set t=null
set ZX7=null
return false
endfunction
function NQD takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit ZX7=GetTriggerUnit()
local trigger t=null
local integer I97=0
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_DEATH then
call SuijiMode_EndScriptedMeleeForm(ZX7,2)
call SuijiMode_EndScriptedMeleeForm(ZX7,1)
set ZX7=null
set b1060GetTriggerEventId=null
return
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SPELL_EFFECT then
if b1060GetSpellAbilityId=='Y03N' then
call SuijiMode_ToggleScriptedMeleeForm(ZX7,1)
set ZX7=null
set b1060GetTriggerEventId=null
return
elseif b1060GetSpellAbilityId=='ZBRR' then
call SuijiMode_EndScriptedMeleeForm(ZX7,1)
set ZX7=null
set b1060GetTriggerEventId=null
return
elseif b1060GetSpellAbilityId=='Y0C6' or b1060GetSpellAbilityId=='YE00' then
call SuijiMode_ToggleScriptedMeleeForm(ZX7,2)
set ZX7=null
set b1060GetTriggerEventId=null
return
endif
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
if b1060B287_GetSpellAbilityId!='A0BE' then
call DestroyTrigger(t)
set t=null
set ZX7=null
set b1060GetTriggerEventId=null
return
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function NPD))
set t=null
set ZX7=null
set b1060GetTriggerEventId=null
endfunction
function GC8 takes nothing returns nothing
set Dc=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Dc,EVENT_PLAYER_UNIT_SPELL_FINISH)
call TriggerRegisterAnyUnitEventBJ(Dc,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerRegisterAnyUnitEventBJ(Dc,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(Dc,Condition(function NOD))
call TriggerAddAction(Dc,function NQD)
call X_7('A0NZ')
endfunction
function NRD takes nothing returns boolean
return B287_GetLearnedSkill()=='A0BE' and IsUnitIllusion(GetTriggerUnit())==false
endfunction
function NSD takes nothing returns nothing
call SetUnitAbilityLevel(GetTriggerUnit(),'A09E',B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0BE'))
endfunction
function G38 takes nothing returns nothing
set DC=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(DC,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(DC,Condition(function NRD))
call TriggerAddAction(DC,function NSD)
endfunction
function B5I takes real xxc, real xxt, real x, real yyc, real yyt, real y returns boolean
	return((y -yyc)*(xxt -xxc)-(x -xxc)*(yyt -yyc)> 0)
endfunction
function B6I takes unit u, real B7I, real B8I, real B9I, real CVI, real CEI, real CXI, real COI, real CRI returns boolean
	local real aa1 = GetWidgetX(u)
	local real aa2 = GetWidgetY(u)
	return B5I(B7I, B8I, aa1, CEI, CXI, aa2)== false and B5I(B9I, CVI, aa1, COI, CRI, aa2) and B5I(B7I, B9I, aa1, CEI, COI, aa2) and B5I(B8I, CVI, aa1, CXI, CRI, aa2)== false
endfunction
function TemplarAssassin_HasScepter takes unit templarScepterUnit returns boolean
if templarScepterUnit==null then
return false
endif
if SuijiMode_ScepterRegistryIsRegistered(templarScepterUnit,'A0RO') then
return SuijiMode_ScepterRegistryIsActive(templarScepterUnit,'A0RO')
endif
if SuijiMode_ScepterRegistryIsRegistered(templarScepterUnit,'A0RP') then
return SuijiMode_ScepterRegistryIsActive(templarScepterUnit,'A0RP')
endif
return SuijiMode_HasAghanimState(templarScepterUnit)
endfunction
function SuijiMode_HasRandomSkill takes unit u,integer skill returns boolean
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
set h=GetHandleId(u)
return skill!=0 and (OM7(h,"SuijiSmallSkill")==skill or OM7(h,"SuijiUltSkill")==skill)
endfunction
function SuijiMode_SyncRandomAttackRange takes unit u returns nothing
local integer h=0
local real previousBonus=0.
local real bonus=0.
local real currentRange=0.
local real baseRange=0.
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set bonus=B848_RangeBonus(u)
set currentRange=GetUnitState(u,UNIT_STATE_ATTACK1_RANGE)
if OO7(h,"SuijiRandomRangeApplied") then
set previousBonus=ON7(h,"SuijiRandomRangeBonus")
set baseRange=ON7(h,"SuijiRandomRangeBase")
if OM7(h,"B848RangeType")!=GetUnitTypeId(u) then
set baseRange=currentRange-B848_EngineNativeRange(u)
elseif RAbsBJ(currentRange-(baseRange+previousBonus))>.5 then
set baseRange=currentRange-previousBonus
endif
else
set baseRange=currentRange-B848_EngineNativeRange(u)
call NS7(h,"SuijiRandomRangeApplied",true)
endif
call NP7(h,"B848RangeType",GetUnitTypeId(u))
if RAbsBJ(ON7(h,"SuijiRandomRangeBase")-baseRange)>.01 then
call NQ7(h,"SuijiRandomRangeBase",baseRange)
endif
if RAbsBJ(ON7(h,"SuijiRandomRangeBonus")-bonus)>.01 then
call NQ7(h,"SuijiRandomRangeBonus",bonus)
endif
if RAbsBJ(currentRange-(baseRange+bonus))>.5 then
call Unit_Setrange(u,baseRange+bonus)
else
call B1091SyncAcquire(u)
endif
endfunction
function SuijiMode_SyncRandomTakeAim takes unit u,integer level returns nothing
call SuijiMode_SyncRandomAttackRange(u)
endfunction
function SuijiMode_ApplyLanceRangeTech takes unit u,integer tech,real delta returns nothing
local real lanceRangeBefore=GetUnitState(u,UNIT_STATE_ATTACK1_RANGE)
local integer lanceRangeHandle=GetHandleId(u)
local integer lanceTechBefore=GetPlayerTechCount(GetOwningPlayer(u),tech,true)
// Warcraft range technologies rebuild the engine range and can discard the
// script-owned Psi/Take Aim layer. Preserve the complete live value across
// this known +/-140 transaction, rather than learning a false new base.
call SetPlayerTechResearched(GetOwningPlayer(u),tech,lanceTechBefore+1)
// Melee heroes without the ranged upgrade must not gain a new Lance bonus.
if IsUnitType(u,UNIT_TYPE_RANGED_ATTACKER) and GetPlayerTechCount(GetOwningPlayer(u),tech,true)>lanceTechBefore and OO7(lanceRangeHandle,"SuijiRandomRangeApplied") and ON7(lanceRangeHandle,"SuijiRandomRangeBonus")>0. then
call Unit_Setrange(u,lanceRangeBefore+delta)
call NQ7(lanceRangeHandle,"SuijiRandomRangeBase",lanceRangeBefore+delta-ON7(lanceRangeHandle,"SuijiRandomRangeBonus"))
endif
call B1091SyncAcquire(u)
endfunction
function TemplarAssassin_UpdatePsiBladesRange takes unit templarPsiBladesUnit returns nothing
local real psiBaseBefore=0.
if templarPsiBladesUnit==null then
return
endif
// InitCopiedSkill runs before the random-slot record is saved. Identify its
// already-owned physical clone too; never write native player technology for
// a foreign copy or reset it again during every restoration.
if GetUnitAbilityLevel(templarPsiBladesUnit,'Y07E')>0 or (SUIJI_MODE and SuijiMode_HasRandomSkill(templarPsiBladesUnit,'A0RO')) then
call SuijiMode_SyncRandomAttackRange(templarPsiBladesUnit)
elseif GetPlayerTechCount(GetOwningPlayer(templarPsiBladesUnit),'Repb',true)!=B287_GetUnitAbilityLevel(templarPsiBladesUnit,'A0RO') then
set psiBaseBefore=B848_FormBaseRange(templarPsiBladesUnit)
call SetPlayerTechResearched(GetOwningPlayer(templarPsiBladesUnit),'Repb',B287_GetUnitAbilityLevel(templarPsiBladesUnit,'A0RO'))
call B848_SetFormRange(templarPsiBladesUnit,psiBaseBefore)
endif
set templarPsiBladesUnit=null
endfunction
function TemplarAssassin_EnsureTrapScepter takes unit templarTrapScepterUnit returns nothing
local player templarTrapScepterPlayer=null
if templarTrapScepterUnit==null then
return
endif
set templarTrapScepterPlayer=GetOwningPlayer(templarTrapScepterUnit)
if TemplarAssassin_HasScepter(templarTrapScepterUnit) and B287_GetUnitAbilityLevel(templarTrapScepterUnit,'A0RP')>0 then
if GetUnitAbilityLevel(templarTrapScepterUnit,'A4KJ')==0 then
call XF7(templarTrapScepterUnit,'A4KJ')
call UnitMakeAbilityPermanent(templarTrapScepterUnit,true,'A4KJ')
endif
call SetPlayerAbilityAvailable(templarTrapScepterPlayer,'A4KJ',true)
else
call SetPlayerAbilityAvailable(templarTrapScepterPlayer,'A4KJ',false)
if GetUnitAbilityLevel(templarTrapScepterUnit,'A4KJ')>0 then
call UnitRemoveAbility(templarTrapScepterUnit,'A4KJ')
endif
endif
set templarTrapScepterPlayer=null
set templarTrapScepterUnit=null
endfunction
function CII takes nothing returns boolean
	local unit t = GetFilterUnit()
	if UnitAlive(t) and IsUnitEnemy(Temp__ArrayUnit[0], GetOwningPlayer(t)) and GetUnitAbilityLevel(t,'A04R')==0 and IsUnitType(t, UNIT_TYPE_STRUCTURE)==false and t != GetTriggerUnit() then
		if B6I(t, Temp__ArrayReal[0], Temp__ArrayReal[1], Temp__ArrayReal[2], Temp__ArrayReal[3], Temp__ArrayReal[4], Temp__ArrayReal[5], Temp__ArrayReal[6], Temp__ArrayReal[7]) then
			call B67(Temp__ArrayUnit[0], t, 10, Temp__ArrayReal[8])
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PriestMissile\\PriestMissile.mdl", t, "chest"))
		endif
	endif
	set t = null
	return false
endfunction
function SZ_YINNI_TRI takes nothing returns boolean
	local unit t = GetFilterUnit()
local integer level=B287_GetUnitAbilityLevel(Temp__ArrayUnit[0],'A0RV')
	if UnitAlive(t) and IsUnitEnemy(Temp__ArrayUnit[0], GetOwningPlayer(t)) and GetUnitAbilityLevel(t,'A04R')==0 and IsUnitType(t, UNIT_TYPE_STRUCTURE)==false and t != GetTriggerUnit() then
		if B6I(t, Temp__ArrayReal[0], Temp__ArrayReal[1], Temp__ArrayReal[2], Temp__ArrayReal[3], Temp__ArrayReal[4], Temp__ArrayReal[5], Temp__ArrayReal[6], Temp__ArrayReal[7]) then
        	call Z57(t,'A0RC',level,7,0)
	        call Z57(t,'A4KP',1,7,'B0KM')
			call B67(Temp__ArrayUnit[0], t, 2, Temp__ArrayReal[8])
            call YW7("+"+I2S(50+50*level),1.,t,.025,$FF,0,0,$FF)
		endif
	endif
	set t = null
	return false
endfunction
function CAI takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer WFV = GetHandleId(t)
	local integer UYX = LoadInteger(TABLE_P, WFV, 0)
	local integer WVV
	local integer a = 0
	if GetLocalPlayer()== LoadPlayerHandle(TABLE_P, WFV, 4) then
		set a = 1
	endif
	if UYX ==10 then
		call DestroyLightning(LoadLightningHandle(TABLE_P, WFV, 3))
		call DestroyLightning(LoadLightningHandle(TABLE_P, WFV, 2))
		call DestroyLightning(LoadLightningHandle(TABLE_P, WFV, 1))
		call DestroyLightning(LoadLightningHandle(TABLE_P, WFV, 0))
        call PauseTimer(t)
        call FlushChildHashtable(TABLE_P, GetHandleId(t))
        call DestroyTimer(t)
		set t = null
		return
	endif
	set WVV = 0
	call SaveInteger(TABLE_P, WFV, 0, UYX + 1)
	set UYX = 65 + 15* UYX
	loop
	exitwhen WVV == 4
		call SetLightningColor(LoadLightningHandle(TABLE_P, WFV, WVV), UYX, UYX, UYX, a)
		set WVV = WVV + 1
	endloop
	set t = null
endfunction
function CNI takes player p returns nothing
	local lightning l = null
	local timer t = CreateTimer()
	local integer WFV = GetHandleId(t)
	local integer a = 0
	if GetLocalPlayer()== p then
		set a = 1
	endif
	call SaveInteger(TABLE_P, WFV, 0, 0)
	set l = AddLightning("DRAB", false, Temp__ArrayReal[0], Temp__ArrayReal[4], Temp__ArrayReal[1], Temp__ArrayReal[5])
	call SetLightningColor(l, 50, 50, 50, a)
	call SaveLightningHandle(TABLE_P, WFV, 0, l)
	set l = AddLightning("DRAB", false, Temp__ArrayReal[0], Temp__ArrayReal[4], Temp__ArrayReal[2], Temp__ArrayReal[6])
	call SetLightningColor(l, 50, 50, 50, a)
	call SaveLightningHandle(TABLE_P, WFV, 1, l)
	set l = AddLightning("DRAB", false, Temp__ArrayReal[2], Temp__ArrayReal[6], Temp__ArrayReal[3], Temp__ArrayReal[7])
	call SetLightningColor(l, 50, 50, 50, a)
	call SaveLightningHandle(TABLE_P, WFV, 2, l)
	set l = AddLightning("DRAB", false, Temp__ArrayReal[3], Temp__ArrayReal[7], Temp__ArrayReal[1], Temp__ArrayReal[5])
	call SetLightningColor(l, 50, 50, 50, a)
	call SaveLightningHandle(TABLE_P, WFV, 3, l)
	call SavePlayerHandle(TABLE_P, WFV, 4, p)
	call TimerStart(t, .03, true, function CAI)
	set l = null
	set t = null
endfunction
function CBI takes unit u, real ZRO, real I3X, real CJR, real x, real y, boolean IS_YINNI returns nothing
	local player p = GetOwningPlayer(u)
	local real aa1 = I3X + bj_PI / 2
	local real aa2 = I3X -bj_PI / 2
	local real B7I = x + 110 * Cos(aa1)
	local real CEI = y + 110 * Sin(aa1)
	local real B9I = x + 110 * Cos(aa2)
	local real COI = y + 110 * Sin(aa2)
	local real B8I
	local real CXI
	local real CVI
	local real CRI
	set aa1 = ZRO * Cos(I3X)
	set aa2 = ZRO * Sin(I3X)
	set B8I = B7I + aa1
	set CXI = CEI + aa2
	set CVI = B9I + aa1
	set CRI = COI + aa2
	set Temp__ArrayUnit[0]= u
	set Temp__ArrayReal[0]= B7I
	set Temp__ArrayReal[1]= B8I
	set Temp__ArrayReal[2]= B9I
	set Temp__ArrayReal[3]= CVI
	set Temp__ArrayReal[4]= CEI
	set Temp__ArrayReal[5]= CXI
	set Temp__ArrayReal[6]= COI
	set Temp__ArrayReal[7]= CRI
	set Temp__ArrayReal[8]= CJR
	if LoadBoolean(TABLE_P, GetHandleId(p),'A0RO')==false and IS_YINNI==false then
		call CNI(p)
	endif
    if IS_YINNI then
        call GroupEnumUnitsInRange(LNZR_GROUP, x, y, ZRO, Condition(function SZ_YINNI_TRI))
    else
	    call GroupEnumUnitsInRange(LNZR_GROUP, x, y, ZRO, Condition(function CII))
    endif
    call GroupClear(LNZR_GROUP)
	set p = null
endfunction
function LNZR takes unit u , unit t, real damage, boolean IS_YINNI returns nothing
	local real x = GetWidgetX(t)
	local real y = GetWidgetY(t)
	call CBI(u, 575 +(B287_GetUnitAbilityLevel(u,'A0RO'))* 40, Atan2(y -GetWidgetY(u), x -GetWidgetX(u)), damage, x, y, IS_YINNI)
endfunction
function ZCLNZR takes nothing returns nothing
	if ZXX > 1 and B287_GetUnitAbilityLevel(WXX,'A0RO') > 0 and ISPH(WXX)==false and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)==false then
		call LNZR(WXX, YXX, ZXX,false)
	endif
endfunction
function NVD2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real r = GetUnitState(WI7, UNIT_STATE_ATTACK1_RANGE) 
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamageSource()==WI7 then
call NM7(OB7)
call OZ7(t)
call Unit_Setrange(WI7, r - 300)
endif
else
call NM7(OB7)
call OZ7(t)
call Unit_Setrange(WI7, r - 300)
endif
set WI7=null
set t=null
endfunction
function NVD takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit IH7=GetTriggerUnit()
local integer level=B287_GetUnitAbilityLevel(WI7,'A0RV')
local real YM7=50+50*level
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
    if GetEventDamageSource()==WI7 and YDWEIsEventPhysicalDamage() then
        call NM7(OB7)
        call OZ7(t)
        // call Z57(IH7,'A0RC',level,7,0)
        // call Z57(IH7,'A4KP',1,7,'B0KM')
        // call Z57(IH7,'A0RC',level,7,0)
        // call Z57(IH7,'A4KP',1,7,'B0KM')
        // call Z57(IH7,'A0RC',level,7,0)
        // call Z57(IH7,'A4KP',1,7,'B0KM')
        call B67(WI7,IH7,2,YM7)
        call YW7("+"+I2S(50+50*level),1.,IH7,.025,$FF,0,0,$FF)
        if B287_GetUnitAbilityLevel(WI7,'A0RO')>0 and ISPH(WI7)==false and TemplarAssassin_HasScepter(WI7) then
            call LNZR(WI7, IH7, YM7,true)
        endif
    endif
else
    call NM7(OB7)
    call OZ7(t)
endif
set WI7=null
set IH7=null
set t=null
endfunction
function HERO_Visible takes nothing returns boolean
return (IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitVisible(GetFilterUnit(),GetOwningPlayer(IN4)) and (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false) and IsUnitType(GetFilterUnit(),UNIT_TYPE_ANCIENT)==false or Z_7(GetFilterUnit()))!=null
endfunction
//隐匿
function NWD takes nothing returns nothing
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local trigger t=GetTriggeringTrigger()
local trigger t2=null
local trigger t3
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local unit NXD=null
local unit NUD=b1060GetOrderTargetUnit
local real r = GetUnitState(WI7, UNIT_STATE_ATTACK1_RANGE)
local group g
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER and b1060GetIssuedOrderId==851983 then
set g=WS7()
set IN4=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),r+25,Condition(function HERO_Visible))
set NXD=M59(g,GetUnitX(WI7),GetUnitY(WI7))
if NXD!=null then
call KR7(WI7)
call B947IssueTargetOrderById("NWD @ war3map.j:88524 (B968)",WI7,$D000F,NXD)
else
call KR7(WI7)
call X37(GetOwningPlayer(WI7),"攻击范围内没有敌方英雄")
endif
call WR7(g)
set g=null
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER and IsUnitEnemy(b1060GetOrderTargetUnit,GetOwningPlayer(WI7))and(b1060GetIssuedOrderId==851983or b1060GetIssuedOrderId==$D0003)then
if KF7(x,y,GetUnitX(NUD),GetUnitY(NUD)) < 25+r then
call UnitRemoveAbility(WI7,'B08K')
call O37(WI7,"TAD",.1)
call NM7(OB7)
call OZ7(t)
if IsUnitType(b1060GetOrderTargetUnit,UNIT_TYPE_STRUCTURE)==false then
set t2=CreateTrigger()
call B1023RegisterDamage(t2,NUD)
call TriggerRegisterTimerEvent(t2,2,false)
set OB7=GetHandleId(t2)
call NT7(OB7,"Hero",WI7)
call TriggerAddAction(t2,function NVD)
endif
set t3=CreateTrigger()
call B1023RegisterDamage(t3,NUD)
call TriggerRegisterTimerEvent(t3,.4,false)
set OB7=GetHandleId(t3)
call NT7(OB7,"Hero",WI7)
call TriggerAddAction(t3,function NVD2)
set t3=null
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_CAST or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call UnitRemoveAbility(WI7,'B08K')
call Unit_Setrange(WI7, r - 300)
call NM7(OB7)
call OZ7(t)
else
if x!=GetUnitX(WI7)or y!=GetUnitY(WI7)then
call UnitRemoveAbility(WI7,'B08K')
call Unit_Setrange(WI7, r - 300)
call NM7(OB7)
call OZ7(t)
endif
endif
set NXD=null
set WI7=null
set t2=null
set t=null
set NUD=null
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
endfunction
function NYD takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real r = GetUnitState(WX7, UNIT_STATE_ATTACK1_RANGE) 
call Unit_Setrange(WX7, r + 300)
call DestroyEffect(AddSpecialEffectTarget("effects\\PurpleAura.mdx",WX7,"origin"))
call Y17(aO,GetUnitX(WX7),GetUnitY(WX7))
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_SPELL_CAST)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(t,function NWD)
call NT7(OB7,"Hero",WX7)
call NQ7(OB7,"x",GetUnitX(WX7))
call NQ7(OB7,"y",GetUnitY(WX7))
call B947IssueImmediateOrderById("NYD @ war3map.j:88589 (B968)",WX7,$D0019)
set t=null
set WX7=null
endfunction
function NZD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0RV' then
call NYD()
endif
return false
endfunction
function M78 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NZD))
set t=null
endfunction
function NAD takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit WI7=GetTriggerUnit()
local integer OB7=GetHandleId(WI7)
local integer NBD=OM7(OB7,"RefractionPrevent_Remaining")
if NBD>0 and GetTriggerEventId()!=EVENT_UNIT_DEATH then
    if b1060GetEventDamage>5 then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PriestMissile\\PriestMissile.mdl",WI7,"right hand"))
        call YN7(WI7,b1060GetEventDamage)
        set NBD=NBD-1
        call NP7(OB7,"RefractionPrevent_Remaining",NBD)
        if NBD==0 then
            call UnitRemoveAbility(WI7,'A0RN')
            call UnitRemoveAbility(WI7,'B08J')  
        endif
    endif
else
    call UnitRemoveAbility(WI7,'A0RN')
    call UnitRemoveAbility(WI7,'B08J')
    call NP7(OB7,"RefractionPrevent_Remaining",0)
endif
set WI7=null
return false
endfunction
function NCD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local unit WX7=O77(GetHandleId(t),"Hero")
local unit refractionDamageTarget=null
local integer I97=0
local integer Y48=0
if WX7==null or GetUnitTypeId(WX7)==0 then
set t=null
set WX7=null
return false
endif
set I97=GetHandleId(WX7)
set Y48=OM7(I97,"RefractionDamage_Remaining")
if GetTriggerEventId()!=EVENT_UNIT_DEATH then
set refractionDamageTarget=MHEvent_GetUnit()
endif
// if GetTriggerEventId()==EVENT_UNIT_DEATH or(GetTriggerEventId()==EVENT_PLAYER_UNIT_ATTACKED and GetAttacker()==WX7 and IsUnitAlly(GetAttacker(),GetOwningPlayer(GetTriggerUnit()))==false)then
if GetTriggerEventId()==EVENT_UNIT_DEATH or(refractionDamageTarget!=null and GetUnitTypeId(refractionDamageTarget)!=0 and MHDamageEvent_IsPhysical() and MHDamageEvent_GetSource()==WX7 and IsUnitAlly(WX7,GetOwningPlayer(refractionDamageTarget))==false)then
    if GetTriggerEventId()!=EVENT_UNIT_DEATH and Y48>0 and MHDamageEvent_GetDamage()>0 then
        set Y48=Y48-1
        call NP7(I97,"RefractionDamage_Remaining",Y48)
        if Y48==0 then
call UnitRemoveAbility(WX7,'A0RF')
            call UnitRemoveAbility(WX7,'A0RM')
            call UnitRemoveAbility(WX7,'B08I')
        endif
    else
call UnitRemoveAbility(WX7,'A0RF')
        call UnitRemoveAbility(WX7,'A0RM')
        call UnitRemoveAbility(WX7,'B08I')
        call NP7(I97,"RefractionDamage_Remaining",0)
    endif
endif
set t=null
set WX7=null
set refractionDamageTarget=null
return false
endfunction
function N3D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local unit WX7=O77(GetHandleId(t),"Hero")
local integer I97=GetHandleId(WX7)
local integer OB7 = GetHandleId(t)
local integer n=LoadInteger(L7, OB7, 0)
set n=n+1
call SaveInteger(L7, OB7, 0, n)
if n==17 then
    call NP7(I97,"RefractionPrevent_Remaining",0)
    call NP7(I97,"RefractionDamage_Remaining",0)
call UnitRemoveAbility(WX7,'A0RF')
    call UnitRemoveAbility(WX7,'A0RM')
    call UnitRemoveAbility(WX7,'A0RN')
    call UnitRemoveAbility(WX7,'B08J')
    call UnitRemoveAbility(WX7,'B08I')
    call RemoveSavedHandle(TABLE_HY, I97,'A1EA')
    call NM7(GetHandleId(t))
    call OZ7(t)
endif
set t=null
set WX7=null
return false
endfunction
function N6D takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local integer I97=GetHandleId(WX7)
local trigger t
local integer OB7
local integer level=B287_GetUnitAbilityLevel(WX7,'A1EA')
if HaveSavedHandle(TABLE_HY, I97,'A1EA') then
    set t = LoadTriggerHandle(TABLE_HY, I97,'A1EA')
    set OB7 = GetHandleId(t)
else
    set t=CreateTrigger()
    set OB7 = GetHandleId(t)
    call SaveTriggerHandle(TABLE_HY, I97,'A1EA', t)
    call TriggerRegisterTimerEvent(t,1,true)
    call TriggerAddCondition(t,Condition(function N3D))
endif
call SaveInteger(L7, OB7, 0, 0)
call NT7(OB7,"Hero",WX7)
call Y17(DP,GetUnitX(WX7),GetUnitY(WX7))
call XF7(WX7,'A0RN')
call NP7(I97,"RefractionPrevent_Remaining",level+2)
call XF7(WX7,'A0RF')
call SetUnitAbilityLevel(WX7,'A0RF',level)
call XF7(WX7,'A0RM')
call NP7(I97,"RefractionDamage_Remaining",level+2)
set WX7=null
set t=null
endfunction
function NLD takes unit WX7 returns nothing
local trigger t
set t=CreateTrigger()
call B1027TempestTrackListener(WX7,t)
call B1023RegisterDamage(t,WX7)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function NAD))
call NP7(GetHandleId(WX7),"RefractionPrevent_Remaining",0)
set t=CreateTrigger()
call B1027TempestTrackListener(WX7,t)
// call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call MHDamageEvent_Register(t)
call TriggerRegisterUnitEvent(t,WX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function NCD))
call NT7(GetHandleId(t),"Hero",WX7)
call NP7(GetHandleId(WX7),"RefractionDamage_Remaining",0)
set t=null
endfunction
function N1D takes nothing returns boolean
if B287_GetLearnedSkill()=='A1EA' and IsUnitIllusion(GetTriggerUnit())==false and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A1EA')==1 then
call NLD(GetTriggerUnit())
endif
return false
endfunction
function N0D takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1EA' then
call N6D()
endif
return false
endfunction
function M88 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function N0D))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function N1D))
set t=null
endfunction
