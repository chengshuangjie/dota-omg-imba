function U4G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer ZK7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(ZK7),(2)))
local unit U2E=(LoadUnitHandle(L7,(ZK7),(17)))
local unit U7G=(LoadUnitHandle(L7,(ZK7),(45)))
local real U8G=(LoadReal(L7,(ZK7),(683)))
local real U9G=(LoadReal(L7,(ZK7),(684)))
local real TLG=GetUnitX(U7G)
local real T1G=GetUnitY(U7G)
local real UDG=Atan2(U9G-T1G,U8G-TLG)
local real speed=28
local real UEG=TLG+speed*Cos(UDG)
local real UFG=T1G+speed*Sin(UDG)
local group UGG=(LoadGroupHandle(L7,(ZK7),($85)))
local integer R1G=GetUnitAbilityLevel(ZX7,'A1YO')
local group g=WS7()
local boolean b=(LoadBoolean(L7,(ZK7),(10)))
set IN4=ZX7
set XJ4=ZX7
set XN4=UGG
set XM4=R1G
call GroupEnumUnitsInRange(g,UEG,UFG,225,Condition(function AJ7_gai))
call ForGroup(g,function T_G)
call WR7(g)
call SetUnitPosition(U7G,UEG,UFG)
if KF7(UEG,UFG,U8G,U9G)<40 or BlockUnitPass(U7G) then
    call Y67(UEG,UFG,300)
    call KillUnit(U7G)
    call ShowUnit(U7G,false)
    call SetUnitPathing(U7G,true)
    call T6G(ZX7,b,UEG,UFG,UDG*bj_RADTODEG)
    call WR7(UGG)
    call FlushChildHashtable(L7,(ZK7))
    call OZ7(t)
endif
set t=null
set U7G=null
set UGG=null
set g=null
return false
endfunction
function UHG takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit ZX7=(b1061SavedGetTriggerUnit)
local unit IH7=(b1061SavedGetSpellTargetUnit)
local trigger t=CreateTrigger()
local integer ZK7=GetHandleId(t)
local unit U7G=CreateUnit(GetOwningPlayer(ZX7),'h0CS',GetUnitX(ZX7),GetUnitY(ZX7),0)
local real SourcetX=GetUnitX(ZX7)
local real SourcetY=GetUnitY(ZX7)
local real TargetX
local real TargetY
local real a
local real d=1600.
local boolean b=false
if IH7!=null then
    set TargetX=GetUnitX(IH7)
    set TargetY=GetUnitY(IH7)
else
    set TargetX=X17((b1061SavedGetSpellTargetX))
    set TargetY=X07((b1061SavedGetSpellTargetY))
endif
set a=Atan2(TargetY-SourcetY,TargetX-SourcetX)
if KF7(SourcetX,SourcetY,TargetX,TargetY)>d then
    set TargetX=X17(SourcetX+d*Cos(a))
    set TargetY=X07(SourcetY+d*Sin(a))
endif
if SuijiMode_HasAghanimState(ZX7) then
    set b=true
endif
call SetUnitFacing(U7G,a*bj_RADTODEG)
call SetUnitPathing(U7G,false)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function U4G))
call SaveUnitHandle(L7,(ZK7),(2),(ZX7))
call SaveReal(L7,(ZK7),(683),((TargetX)*1.))
call SaveReal(L7,(ZK7),(684),((TargetY)*1.))
call SaveReal(L7,(ZK7),($D),((a)*1.))
call SaveBoolean(L7,(ZK7),(10),((b)))
call SaveUnitHandle(L7,(ZK7),(45),(U7G))
call SaveGroupHandle(L7,(ZK7),($85),(WS7()))
set ZX7=null
set IH7=null
set U7G=null
set t=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
