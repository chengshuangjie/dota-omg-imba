endfunction
function UG3 takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local boolean HaveA = LoadBoolean(TABLE_HY, h, 11)
	local real d
	set d =50+75*level
    call B67(ZX7,IH7,1,d)
	if HaveA and UnitAlive(IH7) then
		call CommonUnitAddStun(IH7,.5,false)
	endif
	set ZX7 = null
