function S3D takes nothing returns nothing
local unit S79=GetTriggerUnit()
local integer id=GetUnitTypeId(S79)
local integer WP9=B287_GetUnitAbilityLevel(S79,'A0OK')
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local group VA9=WS7()
local integer P59=0
local unit S6D=(O77(GetHandleId(S79),"748"))
local string tx
local string tx2
local string tx3
if id=='Z00P' then
set tx="model\\hero_obsidiandestroyer_n3s_c_target.mdl"
set tx2="model\\hero_obsidiandestroyer_n3s_c_target_2.mdl"
set tx3="model\\hero_obsidiandestroyer_n3s_c_target_3.mdl"
else
set tx="Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl"
endif
call DestroyEffect(AddSpecialEffect(tx,x,y))
if id=='Z00P' then
call DestroyEffect(AddSpecialEffect(tx2,x,y))
call DestroyEffect(AddSpecialEffect(tx3,x,y))
endif
loop
exitwhen P59>=360
call DestroyEffect(AddSpecialEffect(tx,x+($C8+WP9*50)*Cos(P59*bj_DEGTORAD),y+($C8+WP9*50)*Sin(P59*bj_DEGTORAD)))
if id=='Z00P' then
call DestroyEffect(AddSpecialEffect(tx3,x+($C8+WP9*50)*Cos(P59*bj_DEGTORAD),y+($C8+WP9*50)*Sin(P59*bj_DEGTORAD)))
endif
set P59=P59+45
endloop
call GroupEnumUnitsInRange(VA9,x,y,300+WP9*100,Condition(function SCD))
if S6D!=null and KF7(x,y,GetUnitX(S6D),GetUnitY(S6D))<(300+WP9*100)then
call SetUnitInvulnerable(S6D,false)
call GroupAddUnit(VA9,S6D)
endif
call ForGroup(VA9,function SXD)
if S6D!=null and XH7(S6D)==false then
call SetUnitInvulnerable(S6D,true)
endif
call WR7(VA9)
set S79=null
set VA9=null
endfunction
function JZ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SWD))
call TriggerAddAction(t,function S3D)
set t=null
endfunction
function SLD takes nothing returns nothing
call B67(RL4,GetEnumUnit(),16,R14)
endfunction
function S1D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local unit ZX7=O77(I97,"Source")
local group g
local integer WF8=OM7(I97,"Count")
local integer durationTicks=OM7(I97,"DurationTicks")
local real d=0
local integer HaveA=OM7(I97,"HaveA")
local integer skilltx=OM7(I97,"Effect")
if durationTicks<=0 then
set durationTicks=250
endif
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(IH7)==false or GetTriggerEvalCount(t)>durationTicks or GetTriggerEventId()==EVENT_UNIT_DEATH or (GetTriggerEvalCount(t)>1 and GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT and B287_GetSpellAbilityId()=='A0QG' and GetSpellTargetUnit()==IH7) then
call NM7(I97)
call OZ7(t)
else
set WF8=WF8+1
call NP7(I97,"Count",WF8)
set g=WS7()
set IN4=ZX7
set RL4=ZX7
if HaveA==1 then
set d=GetHeroInt(ZX7,true)*.03
endif
set R14=1.+2.*B287_GetUnitAbilityLevel(ZX7,'A0QG')+d
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),275,Condition(function AJ7_gai))
call GroupRemoveUnit(g,IH7)
call ForGroup(g,function SLD)
call WR7(g)
if WF8==1 then
    call LINGXIA(ZX7,IH7)
endif
endif
set IH7=null
set t=null
set ZX7=null
set g=null
return false
endfunction
function S0D takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer id=0
local integer skilltx
local integer durationCount=1
local real duration=25.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set id=GetUnitTypeId(ZX7)
set durationCount=SuijiMode_GetDurationMulticastCount(ZX7,'A0QG')
set duration=25.*durationCount
if id=='Z00N' then
    set skilltx='A4KQ'
else
    set skilltx='A4KR'
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call Z57(IH7,skilltx,1,duration,0)
call Y17(JO,GetUnitX(IH7),GetUnitY(IH7))
call NT7(I97,"Source",ZX7)
call NT7(I97,"Target",IH7)
call NP7(I97,"Effect",skilltx)
call NP7(I97,"DurationTicks",250*durationCount)
if SuijiMode_ScepterRegistryIsActive(ZX7,'A0QG') then
call NP7(I97,"HaveA",1)
endif
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function S1D))
set t=null
set ZX7=null
set IH7=null
endfunction
function S5D takes nothing returns boolean
local unit suijiIonShellCaster=GetTriggerUnit()
local unit suijiIonShellTarget=GetSpellTargetUnit()
if B287_GetSpellAbilityId()=='A0QG' and suijiIonShellCaster!=null and suijiIonShellTarget!=null and GetUnitTypeId(suijiIonShellCaster)!=0 and GetUnitTypeId(suijiIonShellTarget)!=0 then
    if (IsUnitAlly(suijiIonShellTarget,GetOwningPlayer(suijiIonShellCaster)) or WQ7(suijiIonShellTarget)==false) then
        call S0D()
    elseif WQ7(suijiIonShellTarget) then
        call PLK(suijiIonShellTarget)
    endif
endif
set suijiIonShellCaster=null
set suijiIonShellTarget=null
return false
endfunction
function KO8 takes nothing returns nothing
