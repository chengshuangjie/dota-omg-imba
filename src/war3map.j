//// B1023: transient attack effects share one damage event, never register on a live target.
// Each proc retains its own timer and FIFO node: no merging of successful procs.
function B1023HitLive takes unit hitUnit1023 returns boolean
if hitUnit1023==null then
return false
endif
return GetUnitTypeId(hitUnit1023)!=0 and UnitAlive(hitUnit1023)
endfunction
function B1023HitAppend takes timer hitTimer1023 returns nothing
local integer hitKey1023=GetHandleId(hitTimer1023)
local integer hitSourceKey1023=GetHandleId(LoadUnitHandle(L7,hitKey1023,2))
local integer hitTargetKey1023=GetHandleId(LoadUnitHandle(L7,hitKey1023,17))
local timer hitTail1023=LoadTimerHandle(B1023HitPairs,hitSourceKey1023,hitTargetKey1023)
call RemoveSavedHandle(L7,hitKey1023,18)
if hitTail1023==null then
call SaveTimerHandle(B1023HitPairs,hitSourceKey1023,hitTargetKey1023,hitTimer1023)
else
loop
exitwhen LoadTimerHandle(L7,GetHandleId(hitTail1023),18)==null
set hitTail1023=LoadTimerHandle(L7,GetHandleId(hitTail1023),18)
endloop
call SaveTimerHandle(L7,GetHandleId(hitTail1023),18,hitTimer1023)
endif
set hitTail1023=null
endfunction
function B1023HitDestroy takes timer hitTimer1023 returns nothing
call FlushChildHashtable(L7,GetHandleId(hitTimer1023))
call PauseTimer(hitTimer1023)
call DestroyTimer(hitTimer1023)
endfunction
function B1023HitExpire takes nothing returns nothing
local timer hitExpired1023=GetExpiredTimer()
local integer hitKey1023=GetHandleId(hitExpired1023)
local integer hitSourceKey1023=GetHandleId(LoadUnitHandle(L7,hitKey1023,2))
local integer hitTargetKey1023=GetHandleId(LoadUnitHandle(L7,hitKey1023,17))
local timer hitNode1023=LoadTimerHandle(B1023HitPairs,hitSourceKey1023,hitTargetKey1023)
local timer hitPrevious1023=null
local timer hitNext1023=LoadTimerHandle(L7,hitKey1023,18)
loop
exitwhen hitNode1023==null or hitNode1023==hitExpired1023
set hitPrevious1023=hitNode1023
set hitNode1023=LoadTimerHandle(L7,GetHandleId(hitNode1023),18)
endloop
if hitNode1023==hitExpired1023 then
if hitPrevious1023==null then
if hitNext1023==null then
call RemoveSavedHandle(B1023HitPairs,hitSourceKey1023,hitTargetKey1023)
else
call SaveTimerHandle(B1023HitPairs,hitSourceKey1023,hitTargetKey1023,hitNext1023)
endif
elseif hitNext1023==null then
call RemoveSavedHandle(L7,GetHandleId(hitPrevious1023),18)
else
call SaveTimerHandle(L7,GetHandleId(hitPrevious1023),18,hitNext1023)
endif
endif
call B1023HitDestroy(hitExpired1023)
set hitExpired1023=null
set hitNode1023=null
set hitPrevious1023=null
set hitNext1023=null
endfunction
function B1023HitArm takes unit hitSource1023,unit hitTarget1023,integer hitKind1023,real hitWindow1023 returns nothing
local timer hitTimer1023=null
local integer hitKey1023=0
if B1023HitLive(hitSource1023) and B1023HitLive(hitTarget1023) then
set hitTimer1023=CreateTimer()
set hitKey1023=GetHandleId(hitTimer1023)
call SaveUnitHandle(L7,hitKey1023,2,hitSource1023)
call SaveUnitHandle(L7,hitKey1023,17,hitTarget1023)
call SaveInteger(L7,hitKey1023,19,hitKind1023)
call B1023HitAppend(hitTimer1023)
call TimerStart(hitTimer1023,hitWindow1023,false,function B1023HitExpire)
endif
set hitTimer1023=null
endfunction
