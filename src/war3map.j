function C6D_BUFF takes nothing returns nothing
	local unit u = Wave_U
    if not IsUnitType(u, UNIT_TYPE_MAGIC_IMMUNE) then
        call Z57(u,'A4JK', 1, 5,'B04Q')
    endif
	set u = null
endfunction
function C6D takes unit u,integer CLD returns nothing
local integer C1D=CLD
local integer i
local integer k
local integer BC7=0
local real a
local real x=0.
local real y=0.
local real r
local player p=null
local boolean b=false
local integer id=0
local real length=1000.
if u==null or GetUnitTypeId(u)==0 then
return
endif
if SUIJI_MODE then
set b=SuijiMode_ScepterRegistryIsActive(u,'A29J')
else
set b=B287_GetUnitAbilityLevel(u,'A1MP')>0
endif
if b then
set BC7=B287_GetUnitAbilityLevel(u,'A1MP')
else
set BC7=B287_GetUnitAbilityLevel(u,'A29J')
endif
if BC7<=0 then
if b then
set BC7=B287_GetUnitAbilityLevel(u,'A29J')
else
set BC7=B287_GetUnitAbilityLevel(u,'A1MP')
endif
endif
set p=GetOwningPlayer(u)
set id=GetUnitTypeId(u)
// Rubick has no native soul counter, so stolen Requiem always uses full souls.
if id=='E02X' or id=='Z02X' then
set CLD=37
set C1D=37
elseif CLD<2 and SUIJI_MODE and SuijiMode_HasRandomSkill(u,'A29J') and B287_GetUnitAbilityLevel(u,'A0BR')==0 and B287_GetUnitAbilityLevel(u,'A0FU')==0 then
set CLD=37
set C1D=37
endif
if CLD<2 then
set p=null
return
endif
if CLD==37 then
	call Send_Chat_Text(p,Get_Skill_Text(p,"SF_DA"))
endif
if id=='Zhir' then
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_ShadowFiend_N4S_R_Wing.mdx",u,"origin"))
endif
set x=GetUnitX(u)
set y=GetUnitY(u)
set C1D=C1D/2
set a=360./(C1D*1.)
set i=1
set k=C1D
loop
exitwhen i>k
set r=i*a*bj_DEGTORAD
call Wave(u,'h0HN', 50 + 50 * BC7, length, 125, 450, x, y, x+50*Cos(r), y+50*Sin(r), 700, 1, false, "C6D_BUFF", BC7)
set i=i+1
endloop
if b then
call R7n(u,CLD,BC7)
endif
set p=null
endfunction
function SuijiMode_NevermoreRequiemSpellAllowed takes unit suijiRequiemUnit,integer suijiRequiemSkill returns boolean
if suijiRequiemSkill!='A29J' and suijiRequiemSkill!='A1MP' then
return false
endif
if suijiRequiemUnit==null or GetUnitTypeId(suijiRequiemUnit)==0 then
return false
endif
if SUIJI_MODE then
if suijiRequiemSkill=='A1MP' and B287_GetUnitAbilityLevel(suijiRequiemUnit,'A29J')>0 then
return false
endif
elseif SuijiMode_UsesAghPairVariant(suijiRequiemUnit,suijiRequiemSkill,'A29J','A1MP')==false then
return false
endif
if SUIJI_MODE and (OM7(GetHandleId(suijiRequiemUnit),"SuijiSmallSource")==80 or OM7(GetHandleId(suijiRequiemUnit),"SuijiUltSource")==80) then
return suijiRequiemSkill==OM7(GetHandleId(suijiRequiemUnit),"SuijiUltSkill")
endif
return true
endfunction
function SuijiMode_NevermoreCooldownSyncTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,2)
local integer skill=LoadInteger(L7,timerHandle,3)
local integer casterHandle=0
local integer level=0
local real cooldown=0.
local real maxCooldown=0.
local real factor=0.
if u!=null and GetUnitTypeId(u)!=0 then
set casterHandle=GetHandleId(u)
set level=SuijiMode_GetPairCastLevel(u,skill,'A29J','A1MP')
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==1 then
set maxCooldown=100.
elseif level==2 then
set maxCooldown=90.
else
set maxCooldown=80.
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set maxCooldown=maxCooldown*factor
endif
set cooldown=B582_GetAbilityCooldown(u,skill)
if cooldown<=.01 or cooldown>maxCooldown then
set cooldown=maxCooldown
endif
if B287_GetUnitAbilityLevel(u,'A29J')>0 then
call B287_YDWESetUnitAbilityState(u,'A29J',1,cooldown)
endif
if B287_GetUnitAbilityLevel(u,'A1MP')>0 then
call B287_YDWESetUnitAbilityState(u,'A1MP',1,cooldown)
endif
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownTrigger"))
endif
call NM7(timerHandle)
call OZ7(t)
set u=null
set t=null
return false
endfunction
function SuijiMode_StartNevermoreCooldownSync takes unit u,integer skill returns nothing
local trigger t=null
local integer casterHandle=0
local integer timerHandle=0
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return
endif
if skill!='A29J' and skill!='A1MP' then
return
endif
set casterHandle=GetHandleId(u)
if LoadTriggerHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownTrigger"))!=null then
return
endif
set t=CreateTrigger()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,2,u)
call SaveInteger(L7,timerHandle,3,skill)
call SaveTriggerHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownTrigger"),t)
call TriggerRegisterTimerEvent(t,.10,false)
call TriggerAddCondition(t,Condition(function SuijiMode_NevermoreCooldownSyncTick))
set t=null
endfunction
function SuijiMode_SetNevermoreCooldownState takes unit u,real cooldown returns nothing
local ability normalAbility=null
local ability aghAbility=null
if u==null or GetUnitTypeId(u)==0 or cooldown<=.01 then
return
endif
set normalAbility=EXGetUnitAbility(u,'A29J')
set aghAbility=EXGetUnitAbility(u,'A1MP')
if normalAbility!=null then
call EXSetAbilityState(normalAbility,1,cooldown)
endif
if aghAbility!=null then
call EXSetAbilityState(aghAbility,1,cooldown)
endif
set normalAbility=null
set aghAbility=null
endfunction
function SuijiMode_NevermoreCooldownGuardTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,0)
local integer casterHandle=LoadInteger(L7,timerHandle,1)
local integer left=LoadInteger(L7,timerHandle,2)
local real remaining=LoadReal(L7,timerHandle,3)-TimerGetElapsed(W)
if u==null or GetUnitTypeId(u)==0 or left<=0 or remaining<=.01 then
if casterHandle>0 then
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownGuard"))
endif
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
else
call SuijiMode_NormalizeNativeNevermoreAgh(u)
call SuijiMode_SetNevermoreCooldownState(u,remaining)
call SaveInteger(L7,timerHandle,2,left-1)
endif
set u=null
set t=null
endfunction
function SuijiMode_StartNevermoreCooldownGuard takes unit u,integer skill returns nothing
local timer t=null
local timer oldTimer=null
local integer timerHandle=0
local integer oldTimerHandle=0
local integer casterHandle=0
local integer level=0
local real cooldown=100.
local real factor=0.
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or (skill!='A29J' and skill!='A1MP') then
return
endif
set casterHandle=GetHandleId(u)
set oldTimer=LoadTimerHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownGuard"))
if oldTimer!=null then
set oldTimerHandle=GetHandleId(oldTimer)
call FlushChildHashtable(L7,oldTimerHandle)
call PauseTimer(oldTimer)
call DestroyTimer(oldTimer)
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownGuard"))
endif
set level=SuijiMode_GetPairCastLevel(u,skill,'A29J','A1MP')
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
if level==2 then
set cooldown=90.
elseif level==3 then
set cooldown=80.
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set cooldown=cooldown*factor
endif
call SuijiMode_NormalizeNativeNevermoreAgh(u)
call SuijiMode_SetNevermoreCooldownState(u,cooldown)
set t=CreateTimer()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,0,u)
call SaveInteger(L7,timerHandle,1,casterHandle)
call SaveInteger(L7,timerHandle,2,30)
call SaveReal(L7,timerHandle,3,TimerGetElapsed(W)+cooldown)
call SaveTimerHandle(L7,casterHandle,StringHash("SuijiNevermoreCooldownGuard"),t)
call TimerStart(t,.10,true,function SuijiMode_NevermoreCooldownGuardTick)
set oldTimer=null
set t=null
endfunction
function SuijiMode_NevermoreRequiemMulticastExtra takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
return
endif
call C6D(u,LoadInteger(L7,GetHandleId(u),710))
endfunction
function C3D takes nothing returns nothing
local unit suijiRequiemCaster=GetTriggerUnit()
local integer suijiRequiemSkill=B287_GetSpellAbilityId()
if SuijiMode_NevermoreRequiemSpellAllowed(suijiRequiemCaster,suijiRequiemSkill) then
if suijiRequiemCaster!=null and GetUnitTypeId(suijiRequiemCaster)!=0 then
	set BREAKLBK[GetPlayerId(GetOwningPlayer(suijiRequiemCaster))]=0
    call SuijiMode_StartNevermoreCooldownSync(suijiRequiemCaster,suijiRequiemSkill)
    call SuijiMode_StartNevermoreCooldownGuard(suijiRequiemCaster,suijiRequiemSkill)
    call C6D(suijiRequiemCaster,LoadInteger(L7,(GetHandleId(suijiRequiemCaster)),710))
endif
endif
set suijiRequiemCaster=null
endfunction
function C3DD takes nothing returns nothing
