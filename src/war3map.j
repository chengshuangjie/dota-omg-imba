function KNE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=GetEventDamageSource()
local integer BC7=0
local real d=GetEventDamage()
local real RM8=ON7(OB7,"KrakenShell|Damage")
local real KOE=ON7(OB7,"KrakenShell|LastTime")
local real suijiKrakenShellPurgeUntil=ON7(OB7,"KrakenShell|PurgeUntil")
local real suijiKrakenShellNow=TimerGetElapsed(W)
local real I45=0.
if p5==null or m5==null then
set t=null
set p5=null
set m5=null
return false
endif
if GetUnitTypeId(p5)==0 or GetUnitTypeId(m5)==0 or UnitAlive(p5)==false then
set t=null
set p5=null
set m5=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(p5,'A04E')
// A stale random-skill damage trigger must not synthesize Kraken Shell from
// hero level after the actual random skill has been replaced.
if BC7<1 and SUIJI_MODE and (OM7(GetHandleId(p5),"SuijiSmallSkill")=='A04E' or OM7(GetHandleId(p5),"SuijiUltSkill")=='A04E') then
set BC7=R2I(I2R(GetHeroLevel(p5))/4.)+1
if BC7<1 then
set BC7=1
endif
if BC7>4 then
set BC7=4
endif
endif
if BC7<1 then
set t=null
set p5=null
set m5=null
return false
endif
set I45=650-50*BC7
if TX7(GetOwningPlayer(m5))then
if(KOE+M2)<(KQ7())then
set RM8=0
endif
set KOE=(KQ7())
set RM8=RM8+d
if RM8>I45 and (GetUnitAbilityLevel(p5,'BNdo')==0 and ISPH(p5)==false) then
if suijiKrakenShellPurgeUntil<=suijiKrakenShellNow then
set RM8=0
call NQ7(OB7,"KrakenShell|PurgeUntil",suijiKrakenShellNow+.30)
call YZ8(p5)
call YW8(p5,0,0)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",p5,"origin"))
else
// Merge a burst of threshold crossings into the next eligible purge instead
// of repeatedly running the full debuff cleanup in the same damage frame.
set RM8=I45
endif
endif
call NQ7(OB7,"KrakenShell|Damage",RM8)
call NQ7(OB7,"KrakenShell|LastTime",KOE)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function KPE takes unit p5,boolean UA9 returns nothing
local trigger t=null
local integer OB7=0
local integer suijiKrakenShellCasterHandle=0
local integer suijiKrakenShellPlayerIndex=0
local trigger suijiKrakenShellExistingTrigger=null
local boolean suijiKrakenShellRandomUnit=false
if p5==null then
return
endif
if UA9 then
set suijiKrakenShellCasterHandle=GetHandleId(p5)
set suijiKrakenShellPlayerIndex=GetPlayerId(GetOwningPlayer(p5))
if SUIJI_MODE and (OO7(suijiKrakenShellCasterHandle,"SuijiDone") or OO7(suijiKrakenShellCasterHandle,"SuijiA04EInit")) then
set suijiKrakenShellRandomUnit=true
set suijiKrakenShellExistingTrigger=LoadTriggerHandle(L7,suijiKrakenShellCasterHandle,StringHash("SuijiA04ETrigger"))
if suijiKrakenShellExistingTrigger!=null then
set suijiKrakenShellExistingTrigger=null
set p5=null
return
endif
endif
endif
set t=CreateTrigger()
call B1027TempestTrackListener(p5,t)
set OB7=GetHandleId(t)
call B1023RegisterDamage(t,p5)
call TriggerAddCondition(t,Condition(function KNE))
call NT7(OB7,"Source",p5)
call NQ7(OB7,"KrakenShell|Damage",0)
call NQ7(OB7,"KrakenShell|LastTime",KQ7())
if UA9 then
if suijiKrakenShellRandomUnit then
call SaveTriggerHandle(L7,suijiKrakenShellCasterHandle,StringHash("SuijiA04ETrigger"),t)
else
if not DGFS(p5) then
set aj[suijiKrakenShellPlayerIndex]=t
endif
endif
endif
set p5=null
set t=null
set suijiKrakenShellExistingTrigger=null
endfunction
