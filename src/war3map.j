function MXD takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local location l=GetSpellTargetLoc()
local unit oA=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(WI7),GetUnitY(WI7),0)
local integer V77=B287_GetUnitAbilityLevel(WI7,'A0LL')
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local integer id=GetUnitTypeId(WI7)
local integer mjskill='A10M'
if id=='Zcrl' or id=='Z01X' then
set mjskill='X10M'
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n9s_v_stone1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterWenli.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Zdrl' or id=='Z11X' then
set mjskill='X20M'
call DestroyEffect(AddSpecialEffect("model\\hero_giantstone_n3s_v_stone1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterWenli.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Zerl' or id=='Z21X' then
set mjskill='X30M'
call DestroyEffect(AddSpecialEffect("effects\\ThunderclapCasterWenli.mdl",GetUnitX(WI7),GetUnitY(WI7)))
endif
call XF7(oA,mjskill)
call SetUnitAbilityLevel(oA,mjskill,V77)
call B947IssuePointOrderById("MXD @ war3map.j:87052 (B968)",oA,$D02AC,x,y)
call TriggerRegisterTimerEvent(t,.25,true)
call TriggerAddCondition(t,Condition(function MWD))
call NT7(OB7,"Hero",WI7)
call NQ7(OB7,"x",x)
call NQ7(OB7,"y",y)
call NP7(OB7,"level",V77)
call TriggerEvaluate(t)
call RemoveLocation(l)
set WI7=null
set l=null
set t=null
set oA=null
endfunction
