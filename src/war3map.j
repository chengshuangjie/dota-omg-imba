call J_7(.1)
if(U84[O5]!=null)and(not UnitHasItem(j5,U84[O5]))then
if MR7(j5,ZU[YC])then
call RemoveItem(bj_lastCreatedItem)
endif
if UnitAddItem(j5,U84[O5])then
set U84[O5]=null
endif
endif
endif
if PFF=='A1R5' or PFF=='A137' or PFF=='A231' or PFF=='A2Q6' or PFF=='A01O' or PFF=='A0HA' then
call J_7(.1)
call UQ7("PGF @ war3map.j:158104 (B968)",j5)
