// KK B684: 王者荣耀露娜。控制器仅在原生/随机技能实际出现后启用。
function Luna_GetLevel takes unit u,integer logicalSkill,integer fixedSkill returns integer
return IMaxBJ(GetUnitAbilityLevel(u,logicalSkill),GetUnitAbilityLevel(u,fixedSkill))
endfunction
function Luna_IsValidEnemy takes unit u,unit target returns boolean
return target!=null and GetUnitTypeId(target)!=0 and UnitAlive(target) and IsUnitEnemy(target,GetOwningPlayer(u)) and IsUnitType(target,UNIT_TYPE_STRUCTURE)==false
endfunction
function Luna_GetAttackDamageBonus takes unit u returns real
if u==null or GetUnitTypeId(u)==0 then
return 0.
endif
return RMaxBJ(0.,(GetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(u,UNIT_STATE_ATTACK1_DAMAGE_BONUS))*.20)
endfunction
function Luna_MarkExpire takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit target=LoadUnitHandle(L7,th,0)
local effect e=null
if target!=null and LoadTimerHandle(L7,GetHandleId(target),StringHash("LunaMarkTimer"))==t then
set e=OG7(GetHandleId(target),"LunaMarkEffect")
if e!=null then
call DestroyEffect(e)
call NN7(GetHandleId(target),"LunaMarkEffect")
endif
call RemoveSavedHandle(L7,GetHandleId(target),StringHash("LunaMarkTimer"))
call NS7(GetHandleId(target),"LunaMarked",false)
endif
call FlushChildHashtable(L7,th)
call PauseTimer(t)
call DestroyTimer(t)
set e=null
set target=null
set t=null
endfunction
function Luna_ClearMark takes unit target returns nothing
local integer h=GetHandleId(target)
local timer old=LoadTimerHandle(L7,h,StringHash("LunaMarkTimer"))
local effect e=OG7(h,"LunaMarkEffect")
if old!=null then
call FlushChildHashtable(L7,GetHandleId(old))
call PauseTimer(old)
call DestroyTimer(old)
call RemoveSavedHandle(L7,h,StringHash("LunaMarkTimer"))
endif
if e!=null then
call DestroyEffect(e)
call NN7(h,"LunaMarkEffect")
endif
call NS7(h,"LunaMarked",false)
set old=null
set e=null
endfunction
function Luna_ApplyMark takes unit target returns nothing
local integer h=GetHandleId(target)
local timer old=LoadTimerHandle(L7,h,StringHash("LunaMarkTimer"))
local timer t=CreateTimer()
local effect e=OG7(h,"LunaMarkEffect")
if old!=null then
call FlushChildHashtable(L7,GetHandleId(old))
call PauseTimer(old)
call DestroyTimer(old)
endif
if e!=null then
call DestroyEffect(e)
endif
call NS7(h,"LunaMarked",true)
call NU7(h,"LunaMarkEffect",AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieFire\\FaerieFireTarget.mdl",target,"overhead"))
call SaveTimerHandle(L7,h,StringHash("LunaMarkTimer"),t)
call SaveUnitHandle(L7,GetHandleId(t),0,target)
// IMBA: mark duration x2 cap 30s.
if XOMG_IMBA_ENABLED then
call TimerStart(t,RMinBJ(5.*IMBA_POWER,30.),false,function Luna_MarkExpire)
else
call TimerStart(t,5.,false,function Luna_MarkExpire)
endif
set old=null
set t=null
set e=null
endfunction
function Luna_ShieldExpire takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer th=GetHandleId(t)
local unit u=LoadUnitHandle(L7,th,0)
local integer generation=LoadInteger(L7,th,1)
local effect e=null
if u!=null and GetUnitTypeId(u)!=0 and OM7(GetHandleId(u),"LunaShieldGeneration")==generation then
call RemoveSavedReal(L7,GetHandleId(u),StringHash("LunaShield"))
set e=OG7(GetHandleId(u),"LunaShieldEffect")
if e!=null then
call DestroyEffect(e)
call NN7(GetHandleId(u),"LunaShieldEffect")
endif
endif
call FlushChildHashtable(L7,th)
call PauseTimer(t)
call DestroyTimer(t)
set e=null
set u=null
set t=null
endfunction
