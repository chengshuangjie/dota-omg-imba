function ZHZG3 takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if YS8((b1060GetEnumUnit))==false then
if GetUnitAbilityLevel((b1060GetEnumUnit),'B0EQ')>0 then
call UnitRemoveAbility((b1060GetEnumUnit),'B0EQ')
call UnitRemoveAbility((b1060GetEnumUnit),'A28G')
call UnitRemoveAbility((b1060GetEnumUnit),'A28E')
call UnitRemoveAbility((b1060GetEnumUnit),'A28H')
call UnitRemoveAbility((b1060GetEnumUnit),'A28F')
endif
call SetPlayerAbilityAvailable(GetOwningPlayer((b1060GetEnumUnit)),'A2YQ',false)
call Z57((b1060GetEnumUnit),'A2YQ',1,ZP4,'B1EQ')
endif
set b1060GetEnumUnit=null
endfunction
function ZHZG2 takes nothing returns nothing
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit ZX7=(b1061SavedGetTriggerUnit)
local group g=WS7()
local real x=(b1061SavedGetSpellTargetX)
local real y=(b1061SavedGetSpellTargetY)
call GroupEnumUnitsInRange(g,x,y,700,Condition(function AW7))
call ForGroup(g,function ZHZG3)
call WR7(g)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkLightningNova.mdx",x,y))
set ZX7=null
set g=null
set b1061SavedGetTriggerUnit=null
endfunction
