// Invalid-source termination has the same cleanup as expiry/target death.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or GetTriggerEventId()==EVENT_WIDGET_DEATH or UnitAlive(IH7)==false or WF8>120 or WF7(IH7) then
