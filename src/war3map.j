function SuijiMode_GetPairCastLevel takes unit u,integer castSkill,integer normalSkill,integer aghSkill returns integer
local integer level=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
if castSkill==aghSkill then
set level=B287_GetUnitAbilityLevel(u,aghSkill)
else
set level=B287_GetUnitAbilityLevel(u,normalSkill)
endif
if level<=0 then
if castSkill==aghSkill then
set level=B287_GetUnitAbilityLevel(u,normalSkill)
else
set level=B287_GetUnitAbilityLevel(u,aghSkill)
endif
endif
return level
endfunction
