set n=n+1
set UpdateLog[n]="\n|c00FF0000DotA AI 6.9R|r\n- 所有英雄现在都拥有神杖效果\n- 禁用保存游戏以避免保存崩溃\n- 关闭自动攻击的情况下，输入 -aa 可以开启A地板自动攻击\n- 一键购买的物品10秒内可原价卖出\n- 增加AI谜团、程双杰、蓝胖丝滑小连招\n- 降低了电脑后期出林肯概率\n- 略微延长AI吃宝石的间隔\n- 略微提升抽奖概率\n- 略微增加小兵金钱，略微降低野怪金钱\n- 攻城车由每7波改为每6波出现\n- 新增装备魂之披风\n- 魂之灵龛合成配方更改\n- 重做了幻影斧虚影斧的分身效果，不会再驱散正面buff和冰魂大\n- 否决和散魂剑的锁闭效果，取消弹道变为瞬发\n- 大推推可以对魔免单位使用"
