function SuijiMode_ApplyRegisteredIntegerDefinitionField takes unit u,integer normalSkill,integer aghSkill,boolean active,integer dataType,integer levels,string fieldMark returns boolean
local integer h=0
local integer cacheKey=0
local integer physical=0
local integer level=1
local integer value=0
local unit sample=null
if u==null or GetUnitTypeId(u)==0 or aghSkill==0 or levels<1 then
return false
endif
set h=GetHandleId(u)
set cacheKey=StringHash("SuijiPairInt"+fieldMark+I2S(normalSkill))
if LoadBoolean(L7,h,cacheKey)==false then
// Read object-owned integer fields on a disposable non-hero.  Sampling by
// adding/removing the pair on the real hero can destroy a native learn slot.
set sample=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'hfoo',GetRectMaxX(bj_mapInitialPlayableArea)-128.,GetRectMaxY(bj_mapInitialPlayableArea)-128.,0.)
if sample==null then
return false
endif
call UnitAddAbility(sample,normalSkill)
loop
exitwhen level>levels
call SaveInteger(L7,h,cacheKey+level,YDWEGetUnitAbilityDataInteger(sample,normalSkill,level,dataType))
set level=level+1
endloop
call UnitRemoveAbility(sample,normalSkill)
call UnitAddAbility(sample,aghSkill)
set level=1
loop
exitwhen level>levels
call SaveInteger(L7,h,cacheKey+100+level,YDWEGetUnitAbilityDataInteger(sample,aghSkill,level,dataType))
set level=level+1
endloop
call RemoveUnit(sample)
set sample=null
call SaveBoolean(L7,h,cacheKey,true)
endif
set physical=SuijiMode_ScepterRegistryPhysical(u,normalSkill)
if physical==0 then
set physical=B287_GetPhysicalAbilityId(u,normalSkill)
endif
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
set level=1
loop
exitwhen level>levels
if active then
set value=LoadInteger(L7,h,cacheKey+100+level)
else
set value=LoadInteger(L7,h,cacheKey+level)
endif
call YDWESetUnitAbilityDataInteger(u,physical,level,dataType,value)
set level=level+1
endloop
set sample=null
return true
endfunction
function SuijiMode_IsNativeInvokerUnit takes unit suijiInvokerUnit returns boolean
local integer suijiInvokerUnitId=0
if suijiInvokerUnit==null then
return false
endif
set suijiInvokerUnitId=GetUnitTypeId(suijiInvokerUnit)
return suijiInvokerUnitId=='H00U' or suijiInvokerUnitId=='Z00U' or suijiInvokerUnitId=='Z10U' or suijiInvokerUnitId=='Z20U'
endfunction
function SuijiMode_ApplyRegisteredInvokeFields takes unit u,boolean active returns boolean
local integer physical=0
local integer level=1
local integer manaCost=20
local real cooldown=16.
if u==null or GetUnitTypeId(u)==0 then
return false
endif
// Native Invoker already owns the audited A21Y/A1GU learnable pair. Its
// static objects carry the normal and Scepter mana/cooldown fields, so avoid
// client-local MemHack field writes during this command-card transition.
if SuijiMode_IsNativeInvokerUnit(u) then
return true
endif
set physical=B287_GetPhysicalAbilityId(u,'A21Y')
if physical==0 or SuijiMode_HasExactLiveAbility(u,physical)==false then
return false
endif
loop
exitwhen level>4
if active then
set manaCost=0
if level==1 then
set cooldown=16.
elseif level==2 then
set cooldown=8.
elseif level==3 then
set cooldown=4.
else
set cooldown=0.
endif
else
set manaCost=20*level
set cooldown=20.-4.*level
endif
call MHAbility_SetCustomLevelDataInt(u,physical,level,ABILITY_LEVEL_DEF_DATA_MANA_COST,manaCost)
call MHAbility_SetCustomLevelDataReal(u,physical,level,ABILITY_LEVEL_DEF_DATA_COOLDOWN,cooldown)
set level=level+1
endloop
return true
endfunction
function SuijiMode_FlakSideGunnerEligible takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
return IsUnitType(u,UNIT_TYPE_HERO) and IsUnitIllusion(u)==false and B287_GetUnitAbilityLevel(u,'A229')>0 and SuijiMode_DetectAghanimSourceState(u)
endfunction
function SuijiMode_FlakSideGunnerRemoveCompanion takes unit u returns nothing
if u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,'ZSG1')>0 then
call UnitRemoveAbility(u,'ZSG1')
endif
endfunction
function SuijiMode_FlakSideGunnerDestroyAttackTimer takes unit u returns nothing
local integer h=0
local timer t=null
if u==null then
return
endif
set h=GetHandleId(u)
set t=LoadTimerHandle(L7,h,StringHash("SuijiFlakSideGunnerAttackTimer"))
