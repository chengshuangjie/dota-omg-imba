function MVE2 takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit IH7 = LoadUnitHandle(TABLE_HY, h, 2)
    local integer armor=OM7(GetHandleId(IH7),"BZJJ")
    local integer last = LoadInteger(TABLE_HY, h, 10)
    local integer d
    if GetTriggerEventId()== EVENT_WIDGET_DEATH then
        call NP7(GetHandleId(IH7),"BZJJ",0)
        call BZJJ(IH7,0)
        call UnitRemoveAbility(IH7,'A4JV')
		call UnitRemoveAbility(IH7,'B0KP')
    else
        set d=IMaxBJ(armor-last,0)
        call NP7(GetHandleId(IH7),"BZJJ",d)
        call BZJJ(IH7,d)
        if d==0 then
            call UnitRemoveAbility(IH7,'A4JV')
			call UnitRemoveAbility(IH7,'B0KP')
        endif
    endif
    call FlushChildHashtable(TABLE_HY, h)
    call OZ7(t)
    set t=null
    set IH7=null
    return false
endfunction
function MVE takes nothing returns nothing
    local unit IH7=GetEnumUnit()
    local integer armor=OM7(GetHandleId(IH7),"BZJJ")
    local trigger t=CreateTrigger()
    local integer h=GetHandleId(t)
    if armor==0 then
        call XF7(IH7,'A4JV')
    endif
    set armor=armor+AL4
    call NP7(GetHandleId(IH7),"BZJJ",armor)
    call BZJJ(IH7,armor)
    call SaveInteger(TABLE_HY, h, 10, AL4)
    call SaveUnitHandle(TABLE_HY, h, 2, IH7)
	call TriggerRegisterTimerEvent(t, 8. , false)
	call TriggerRegisterDeathEvent(t, IH7)
    call TriggerAddCondition(t, Condition(function MVE2))
    set IH7=null
    set t=null
    endfunction
function MWE takes nothing returns nothing
    local unit ZX7=GetTriggerUnit()
    local group g=WS7()
    local real x=GetUnitX(ZX7)
    local real y=GetUnitY(ZX7)
    local integer level=B287_GetUnitAbilityLevel(ZX7,'A10Q')
	if ISLABIKE(ZX7) then
		if GetUnitLevel(ZX7)>=16 then
			set level=3
		elseif GetUnitLevel(ZX7)>=11 then
			set level=2
		elseif GetUnitLevel(ZX7)>=6 then
			set level=1
		endif
	endif
    set AL4=level
    set U22=ZX7
    call GroupEnumUnitsInRange(g,x,y,1200,Condition(function DHX))
    call ForGroup(g,function MVE)
    call WR7(g)
    set ZX7=null
    set g=null
endfunction
