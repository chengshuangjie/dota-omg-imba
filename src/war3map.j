function QUG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real a=J77(GetUnitX(ZX7),GetUnitY(ZX7),x,y)*bj_DEGTORAD
local unit Y27=CreateUnit(GetOwningPlayer(ZX7),'h0C2',GetUnitX(ZX7),GetUnitY(ZX7),a*bj_RADTODEG)
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(ZX7,'A4DJ')+GetUnitAbilityLevel(ZX7,'A4DZ')
local integer ZZMF=0
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerAddCondition(t,Condition(function QRG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(45),(Y27))
call SaveReal(L7,(I97),($89),((a)*1.))
call SaveGroupHandle(L7,(I97),($85),(WS7()))
if ZZMF_level==1 then
    set ZZMF=2
elseif ZZMF_level==2 then
    set ZZMF=5
elseif ZZMF_level==3 then
    set ZZMF=7
elseif ZZMF_level==4 then
    set ZZMF=10
endif
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
set length=85+ZZMF
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
set length=82+ZZMF
else
set length=75+ZZMF
endif
call SaveInteger(L7,(I97),(10),(length))
call XF7(ZX7,'A1S9')
set t=null
set ZX7=null
set Y27=null
endfunction
