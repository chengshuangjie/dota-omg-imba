function Bingo takes nothing returns boolean
local string VH
local integer spring=2
if GetDyingUnit()==IZ4_MJ or GetDyingUnit()==JA4_MJ then
if CurrentMonth==spring then
set VH="新春快乐！！！"
else
set VH="圣诞快乐！！！"
endif
call VV7(bj_FORCE_ALL_PLAYERS,20.,"|cFF00FF00"+VH+"|r")
call VV7(bj_FORCE_ALL_PLAYERS,20.,"|cFF00FF00"+VH+"|r")
call VV7(bj_FORCE_ALL_PLAYERS,20.,"|cFF00FF00"+VH+"|r")
call VV7(bj_FORCE_ALL_PLAYERS,20.,"使用 -music off 可关闭音乐")
call VV7(bj_FORCE_ALL_PLAYERS,20.,"使用 -weather off 可关闭下雪")
call StopMusic(true)
if CurrentMonth==spring then
call PlayMusic("sounds\\gxfc.mp3")
else
call PlayMusic("sounds\\Jingle_Bells.mp3")
call EnableWeatherEffect(bo,true)
call EnableWeatherEffect(Bo,false)
call EnableWeatherEffect(fL,false)
call EnableWeatherEffect(FL,false)
endif
endif
return false
endfunction
//可拆分的物品
function Bke takes item it returns boolean
	local integer id = KY7(it)
	if id == Y3 or id == C3 or id == E6 or id == it_bingjia or id == DQ4 or id == it_dadianchui or id == F74 or id == J1 or id == O1 or id == Y0 or id == B0 or id == E24 or id == LB or id == U1 or id == JC or id == NC or id == U3 or id == it_hyzr or id == DS4 or id == H6 or id == G6 or id == N6 or id == R0A or id == R11 or id == R03 or id == R00 or id == H2 or id == P2 or id == it_yt or id == WL or id == ZL or id == LL or id == R3 or id == P1 or id == it_fj or id == FC or id == D84 or id == D94 or id==it_yangdao or (id==VC and GetItemCharges(it)>1) or (id==WC and GetItemCharges(it)>1) or (id==B5 and GetGameTime()-BUYSJTIME[GetPlayerId(GetItemPlayer(it))]<10.) then
		return true
	endif
	return false
endfunction
function BMe takes nothing returns nothing
	local trigger trg = GetTriggeringTrigger()
	local integer key = GetHandleId(trg)
	local unit u = LoadUnitHandle(TABLE_HY, key, 0)
	call RemoveSavedHandle( ExtraHT, GetHandleId(u), HTKEY_UNIT_SPLIT_ITEM0_5 + LoadInteger(TABLE_HY, key, 0) )
	call FlushChildHashtable(TABLE_HY, key)
	call OZ7(trg)
	set u = null
	set trg = null
endfunction
// 右键双击物品
function RightDoubleClickItem takes unit u, item it, integer BC7 returns nothing
	local trigger trg = null
	local integer key
	if not Bke(it) then
		return
	endif
	if HaveSavedHandle( ExtraHT, GetHandleId(u), HTKEY_UNIT_SPLIT_ITEM0_5 + BC7 ) then
		set trg = LoadTriggerHandle(ExtraHT, GetHandleId(u), HTKEY_UNIT_SPLIT_ITEM0_5 + BC7)
		set key = GetHandleId(trg)
		if BC7 == LoadInteger(TABLE_HY, key, 0) and it == LoadItemHandle(TABLE_HY, key, 1) then
			call FlushChildHashtable(TABLE_HY, key)
			call OZ7(trg)
			call RemoveSavedHandle(ExtraHT, GetHandleId(u), HTKEY_UNIT_SPLIT_ITEM0_5 + BC7)
			call NEWCF(u , it)
		endif
	else
		set trg = CreateTrigger()
		set key = GetHandleId(trg)
		call SaveUnitHandle(TABLE_HY, key, 0, u)
		call SaveItemHandle(TABLE_HY, key, 1, it)
		call SaveInteger(TABLE_HY, key, 0, BC7)
		call SaveTriggerHandle(ExtraHT, GetHandleId(u), HTKEY_UNIT_SPLIT_ITEM0_5 + BC7,  trg)
		call TriggerRegisterTimerEvent(trg, 1, false)
		call TriggerAddCondition(trg, Condition(function BMe))
	endif
	set trg = null
endfunction
function Y_A takes nothing returns nothing
	local integer id = GetIssuedOrderId()
	if id >= 852002 and id <= 852007 then
		if GetOrderTargetItem()== UnitItemInSlot(GetTriggerUnit(), id -852002) then
			call RightDoubleClickItem(GetTriggerUnit(), GetOrderTargetItem(), id -852002)
		endif
	endif
endfunction
function Y0A takes nothing returns nothing
	local trigger t = CreateTrigger()
	call YB7(t, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
	call TriggerAddCondition(t, Condition(function Y_A))
	set t = null
endfunction
//限制消息频率
function GetChat_times takes integer i returns boolean
	local real time = GetGameTime()
	local real interval = 3
		if Chat_times[i] == 0 then
			set Chat_times[i] = time
			set Chat_twice[i] = 1
			return true
		elseif(time - Chat_times[i] ) > interval then
			set Chat_times[i] = time
			set Chat_twice[i] = 1
			return true
		elseif Chat_twice[i] == 1 then
			set Chat_twice[i] = 0
			return true
		endif
	return false
endfunction
function Click_UI_HeroBarButton takes nothing returns nothing
	local integer i = GetPlayerId(DzGetTriggerKeyPlayer())
	if DzIsKeyDown(18) and GetChat_times(i) then
		call DzSyncData("p", "2")
	endif
endfunction
function SendAbilityState takes integer i,item it,integer abilId returns nothing
	local unit u= MHPlayer_GetSelectUnit()
	local integer level
	local real cooldown
	local integer manaCost
	local integer maxLevel
	local integer needMana
	local string data
	local string name
	if it == null then
		set name=GetObjectName(abilId)
	else
		set name=GetObjectName(GetItemTypeId(it))
		set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
	endif
	if abilId != 0 then
		set level=GetUnitAbilityLevel(u, abilId)
		set cooldown=B582_GetAbilityCooldown(u , abilId)
		set manaCost=B945DefinitionMana(abilId , level )
		set maxLevel=MHAbility_GetDefDataInt(abilId , ABILITY_DEF_DATA_MAX_LEVEL)
		set needMana=R2I(GetUnitState(u, UNIT_STATE_MANA)) - manaCost
		set data=null
		if it != null and GetItemCharges(it) > 1 then
			set name=name + " [" + I2S(GetItemCharges(it)) + "]"
		endif
        if MRPH(u) then
            set data="|c00FF0000已被禁用|r"
        elseif cooldown > 0. then
			set data="还剩 |c00FF0000" + I2S(R2I(cooldown)) + "|r 秒"
		elseif needMana < 0 then
			set data="还差 |c00FF0000" + I2S(IAbsBJ(needMana)) + "|r 点魔法"
		else
			set data="已准备就绪"
		endif
	else
		set data="已准备就绪"
	endif
    set name = "|c00fffc01" + name + "|r"
	if IsUnitOwnedByPlayer(u, GetLocalPlayer()) then
		// 自己的单位
		set data= name + " > " + data
	else
		// 对队友建议
        set data=GetUnitName(u) + " > " + name + " > " + data
	endif
	if GetChat_times(i) then
		call DzSyncData("t", data)
	endif
    set u=null
endfunction
    // 物品栏 0 ~ 5
function onClickItemCommandButton takes integer i,integer index returns nothing
    local unit u= MHPlayer_GetSelectUnit()
    local item it= UnitItemInSlot(u, index)
    local integer abilCode= MHItem_GetAbilityId(it , 1)
        if abilCode != 0 then
            call SendAbilityState(i, it , abilCode)
        endif
        set u=null
        set it=null
endfunction
