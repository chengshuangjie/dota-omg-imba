return b1060ReturnValue
endif
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0) or b1060GetTriggerEventId==EVENT_WIDGET_DEATH or (GetUnitAbilityLevel(m5,skill)==0 and GetTriggerEvalCount(t)>1) then
    // call UnitRemoveAbility(m5,skillbuff)
    call UnitRemoveAbility(m5,skill)
    call FlushChildHashtable(L7,OB7)
    call OZ7(t)
    call RemoveSavedHandle(Dvv,GetHandleId(m5),0-skill)
endif
set t=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
//自定义属性 攻击力模板AIat
function Set_Unit_Shuxing_Time takes unit m5,integer skill,real d,real DUR returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+DUR
if XH7(m5) or SuijiMode_EnsureExactLiveAbilityLevel(m5,skill,1,true)==false then
return
endif
if MHAbility_SetCustomLevelDataReal(m5,skill,1,ABILITY_LEVEL_DEF_DATA_DATA_A,d)==false then
// The live field write is optional here.  Never roll back synchronized native
// ownership because one client failed to resolve its MemHack Ability object.
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-skill)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-skill)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,skill)
call SaveInteger(L7,OB7,61,GetHandleId(m5))
// call SaveInteger(L7,OB7,60,skillbuff)
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function Set_Unit_Shuxing_Time2))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-skill,t)
endif
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
call SuijiMode_SetExactLiveAbilityLevel(m5,skill,2)
call SuijiMode_SetExactLiveAbilityLevel(m5,skill,1)
set t=null
endfunction
function Z07 takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=LoadUnitHandle(L7,OB7,17)
local integer o6=LoadInteger(L7,OB7,59)
local integer Z17=LoadInteger(L7,OB7,60)
local integer unitHandle=LoadInteger(L7,OB7,61)
if m5==null or GetUnitTypeId(m5)==0 then
call FlushChildHashtable(L7,OB7)
call OZ7(t)
call RemoveSavedHandle(Dvv,unitHandle,0-o6)
set m5=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if TimerGetElapsed(W)>=LoadReal(L7,OB7,0)or b1060GetTriggerEventId==EVENT_WIDGET_DEATH or LoadBoolean(L7,OB7,0) or (GetUnitAbilityLevel(m5,o6)==0 and GetTriggerEvalCount(t)>1) then
call SaveBoolean(L7,OB7,0,true)
call UnitRemoveAbility(m5,Z17)
call UnitRemoveAbility(m5,o6)
call FlushChildHashtable(L7,OB7)
call OZ7(t)
call RemoveSavedHandle(Dvv,GetHandleId(m5),0-o6)
endif
set m5=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function Z57 takes unit m5,integer o6,integer V77,real Z27,integer Z17 returns nothing
local trigger t
local integer OB7
local real hyy
local real Hyy=TimerGetElapsed(W)+Z27
if XH7(m5) or SuijiMode_EnsureExactLiveAbilityLevel(m5,o6,V77,true)==false then
return
endif
if HaveSavedHandle(Dvv,GetHandleId(m5),0-o6)then
set t=LoadTriggerHandle(Dvv,GetHandleId(m5),0-o6)
set OB7=GetHandleId(t)
else
set t=CreateTrigger()
set OB7=GetHandleId(t)
call FlushChildHashtable(L7,OB7)
call SaveUnitHandle(L7,OB7,17,m5)
call SaveInteger(L7,OB7,59,o6)
call SaveInteger(L7,OB7,60,Z17)
call SaveInteger(L7,OB7,61,GetHandleId(m5))
call SaveReal(L7,OB7,0,0)
call TriggerRegisterDeathEvent(t,m5)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function Z07))
call SaveTriggerHandle(Dvv,GetHandleId(m5),0-o6,t)
endif
call SaveBoolean(L7,OB7,0,false)
set hyy=LoadReal(L7,OB7,0)
if hyy<Hyy then
call SaveReal(L7,OB7,0,Hyy)
endif
set t=null
endfunction
function SuijiMode_DurationMulticastSkillMatches takes integer savedSkill,integer requestedSkill returns boolean
if savedSkill==requestedSkill then
return true
endif
if (savedSkill=='A054' and requestedSkill=='A00U') or (savedSkill=='A00U' and requestedSkill=='A054') then
return true
endif
if (savedSkill=='A2XO' and requestedSkill=='A0O8') or (savedSkill=='A0O8' and requestedSkill=='A2XO') then
return true
endif
if (savedSkill=='A4J4' and requestedSkill=='A0Q7') or (savedSkill=='A0Q7' and requestedSkill=='A4J4') then
return true
endif
if (savedSkill=='A0LC' and requestedSkill=='A4CB') or (savedSkill=='A4CB' and requestedSkill=='A0LC') then
return true
endif
if (savedSkill=='A0LH' or savedSkill=='A2Z9' or savedSkill=='A4F3' or savedSkill=='A4F4' or savedSkill=='A4F5' or savedSkill=='A4FU') and (requestedSkill=='A0LH' or requestedSkill=='A2Z9' or requestedSkill=='A4F3' or requestedSkill=='A4F4' or requestedSkill=='A4F5' or requestedSkill=='A4FU') then
return true
endif
return false
endfunction
function SuijiMode_GetDurationMulticastCount takes unit u,integer skill returns integer
local integer h=0
local integer savedSkill=0
local integer count=1
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return 1
endif
set h=GetHandleId(u)
if LoadReal(L7,h,StringHash("SuijiDurationMulticastUntil"))<TimerGetElapsed(W) then
return 1
endif
set savedSkill=LoadInteger(L7,h,StringHash("SuijiDurationMulticastSkill"))
if SuijiMode_DurationMulticastSkillMatches(savedSkill,skill)==false then
return 1
endif
set count=LoadInteger(L7,h,StringHash("SuijiDurationMulticastCount"))
if count<1 then
return 1
endif
return count
endfunction
function SuijiMode_DurationBuffTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit target=LoadUnitHandle(L7,h,0)
local integer buff1=LoadInteger(L7,h,1)
local integer buff2=LoadInteger(L7,h,2)
local real duration=LoadReal(L7,h,3)
local integer tries=LoadInteger(L7,h,4)+1
local boolean applied=false
if target!=null and GetUnitTypeId(target)!=0 then
if buff1!=0 and GetUnitAbilityLevel(target,buff1)>0 then
call MHBuff_SetRemain(target,buff1,duration)
set applied=true
endif
if buff2!=0 and GetUnitAbilityLevel(target,buff2)>0 then
call MHBuff_SetRemain(target,buff2,duration)
set applied=true
endif
endif
if applied or tries>=20 or target==null or GetUnitTypeId(target)==0 then
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
else
call SaveInteger(L7,h,4,tries)
endif
set target=null
set t=null
endfunction
function SuijiMode_ScheduleDurationBuff takes unit target,integer buff1,integer buff2,real duration returns nothing
local timer t=null
local integer h=0
if target==null or GetUnitTypeId(target)==0 or duration<=0. then
return
endif
set t=CreateTimer()
set h=GetHandleId(t)
call SaveUnitHandle(L7,h,0,target)
call SaveInteger(L7,h,1,buff1)
call SaveInteger(L7,h,2,buff2)
call SaveReal(L7,h,3,duration)
call SaveInteger(L7,h,4,0)
call TimerStart(t,.03,true,function SuijiMode_DurationBuffTimer)
set t=null
endfunction
