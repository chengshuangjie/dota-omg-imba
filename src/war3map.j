function SuijiMode_RunHeroSideEffects takes unit WI7 returns nothing
local integer D28=0
local unit D_8=null
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false then
return
endif
set D28=GetUnitPointValue(WI7)
if D28==4 then
set ZCSR=true
call SetUnitPathing(WI7,false)
set O74=true
set D_8=CreateUnit(GetOwningPlayer(WI7),GetUnitTypeId(WI7),GetUnitX(WI7),GetUnitY(WI7),GetUnitFacing(WI7))
call NS7(GetHandleId(D_8),"EnteredAlready",true)
set M7[GetPlayerId(GetOwningPlayer(WI7))]=D_8
call SetUnitPathing(D_8,false)
call SetUnitPosition(D_8,GetUnitX(WI7),GetUnitY(WI7))
if D4 then
call SetHeroXP(D_8,GetHeroXP(WI7),false)
call UnitAddItem(D_8,UnitItemInSlot(WI7,0))
call UnitAddItem(D_8,UnitItemInSlot(WI7,1))
call UnitAddItem(D_8,UnitItemInSlot(WI7,2))
call UnitAddItem(D_8,UnitItemInSlot(WI7,3))
call UnitAddItem(D_8,UnitItemInSlot(WI7,4))
call UnitAddItem(D_8,UnitItemInSlot(WI7,5))
endif
call YE7(WI7)
call SetUnitPathing(D_8,true)
call ClearSelectionForPlayer(GetOwningPlayer(D_8))
call SelectUnitAddForPlayer(D_8,GetOwningPlayer(D_8))
set IN4=D_8
call ExecuteFunc("ZCEXSR")
elseif D28==58 then
set IN4=WI7
call ExecuteFunc("RJ1")
endif
set D_8=null
endfunction
function SuijiMode_RunHeroSideEffectsCurrent takes nothing returns nothing
call SuijiMode_RunHeroSideEffects(IN4)
endfunction
function SuijiMode_SmallLevel takes unit u returns integer
local integer level=R2I(I2R(GetHeroLevel(u))/4.)+1
if level<1 then
set level=1
endif
if u!=null and OM7(GetHandleId(u),"SuijiSmallSkill")=='A0MP' then
return IMinBJ(5,level)
endif
if level>4 then
set level=4
endif
return level
endfunction
function SuijiMode_UltLevel takes unit u returns integer
local integer level=R2I(I2R(GetHeroLevel(u))/5.)
if level<0 then
set level=0
endif
if level>3 then
set level=3
endif
return level
endfunction
function SuijiMode_InitAttackPassiveEvents takes integer skill returns nothing
if skill=='ABcr' or skill=='A03Q' or skill=='A03N' or skill=='A00K' or skill=='A2PX' or skill=='A1OY' then
if ZCBJ==false then
call RegisterUnitAttackEvent("MNBJ_PD",0)
set ZCBJ=true
endif
endif
if skill=='A0JJ' or skill=='A081' or skill=='A09E' or skill=='A0BE' or skill=='A0WR' then
if JGBX==false then
call RegisterUnitAttackEvent("TPA",2)
call RegisterUnitAttackEvent("ODO",2)
set JGBX=true
endif
endif
if skill=='A01K' or skill=='A037' or skill=='A4C8' then
if ZCFL==false then
call RegisterUnitAttackEvent("MNFL_PD",0)
set ZCFL=true
endif
endif
// These attack callbacks used to be installed only when the original hero
// happened to enter the game.  Random copies must register them themselves.
if skill=='A0BK' then
call RegisterUnitAttackEvent("HWI",3)
endif
if skill=='A0SS' then
call RegisterUnitAttackEvent("ZCXGSY",3)
endif
if skill=='A4EU' then
call RegisterUnitAttackEvent("ZCXGZN",0)
endif
if skill=='A0OI' then
call RegisterUnitAttackEvent("JX8",4)
endif
endfunction
function SuijiMode_IsCrossRangeOrbSkill takes integer skill returns boolean
return skill=='A09V' or skill=='AHfa' or skill=='A0LZ' or skill=='A0OI' or skill=='A0QN'
endfunction
function SuijiMode_IsMeleeOrbCarrier takes unit u returns boolean
// A few melee heroes (for example Lifestealer) use 150 attack range.
return u!=null and GetUnitTypeId(u)!=0 and GetUnitState(u,UNIT_STATE_ATTACK1_RANGE)<=200.
endfunction
function SuijiMode_CrossRangeOrbHasMultiple takes unit u returns boolean
local integer count=0
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if B287_GetUnitAbilityLevel(u,'A026')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'A09V')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'A0DY')>0 or B287_GetUnitAbilityLevel(u,'A1WB')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'AHfa')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'A0LZ')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'A0OI')>0 then
set count=count+1
endif
if B287_GetUnitAbilityLevel(u,'A0QN')>0 then
set count=count+1
endif
if SUIJI_UNIFIED_ORB_PASSIVE then
return count>0
endif
return count>1
endfunction
function SuijiMode_CrossRangeOrbClear takes trigger t returns nothing
local integer h=GetHandleId(t)
call DisableTrigger(t)
call FlushChildHashtable(L7,h)
call OZ7(t)
set t=null
endfunction
function SuijiMode_CrossRangeOrbDamage takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer h=GetHandleId(t)
local unit source=O77(h,"Source")
local unit target=b1060GetTriggerUnit
local unit dummy=null
local integer skill=OM7(h,"Skill")
local integer level=0
local real cost=0.
local real damage=0.
local boolean nativeCast=false
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(source) or not B1023HitLive(target)) then
call SuijiMode_CrossRangeOrbClear(t)
set t=null
set source=null
set target=null
set dummy=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT then
if b1060GetTriggerUnit==source and b1060B287_GetSpellAbilityId==skill then
call NS7(h,"NativeCast",true)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==source and source!=null and target!=null and GetUnitTypeId(source)!=0 and GetUnitTypeId(target)!=0 then
set nativeCast=OO7(h,"NativeCast")
call SuijiMode_CrossRangeOrbClear(t)
if B287_GetUnitAbilityLevel(source,skill)<=0 then
set source=null
set target=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if skill!='AHfa' and IsUnitType(target,UNIT_TYPE_STRUCTURE) then
set source=null
set target=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
set level=B287_GetUnitAbilityLevel(source,skill)
if nativeCast==false then
if skill=='A0QN' then
set cost=15.
if GetUnitState(source,UNIT_STATE_LIFE)<=cost then
set source=null
set target=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
call SetUnitState(source,UNIT_STATE_LIFE,GetUnitState(source,UNIT_STATE_LIFE)-cost)
else
if skill=='A09V' then
set cost=20.
elseif skill=='AHfa' then
set cost=10.
elseif skill=='A0LZ' then
set cost=15.
elseif skill=='A0OI' then
set cost=80.+20.*I2R(level)
endif
if GetUnitState(source,UNIT_STATE_MANA)<cost then
set source=null
set target=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
call SetUnitState(source,UNIT_STATE_MANA,GetUnitState(source,UNIT_STATE_MANA)-cost)
endif
endif
if skill=='A09V' then
set dummy=CreateUnit(GetOwningPlayer(source),'e00E',GetUnitX(target),GetUnitY(target),0.)
call UnitAddAbility(dummy,'Y03F')
call SetUnitAbilityLevel(dummy,'Y03F',level)
call SetUnitState(dummy,UNIT_STATE_MANA,100.)
// $D011F is poisonarrows (toggle on), not poisonarrowstarg.
// A target order with it is discarded by Warcraft.  $D011E is the
// poisonarrowstarg target order (852254).
call B947IssueTargetOrderById("SuijiMode_CrossRangeOrbDamage @ war3map.j:187065 (B968)",dummy,$D011E,target)
call UnitApplyTimedLife(dummy,'BTLF',1.)
elseif skill=='AHfa' then
set damage=20.+10.*I2R(level)
call B67(source,target,3,damage)
elseif skill=='A0LZ' then
set damage=(.15+.15*I2R(level))*GetHeroInt(source,true)
call YW7("+"+I2S(R2I(damage)),1,target,.023,3,$D8,$D8,$D8)
call B67(source,target,3,damage)
elseif skill=='A0OI' then
call XB(source,target)
elseif skill=='A0QN' then
call Z29(source,target)
endif
endif
else
call SuijiMode_CrossRangeOrbClear(t)
endif
set dummy=null
set source=null
set target=null
set t=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiMode_CrossRangeOrbEvent takes nothing returns boolean
local unit b1060GetAttacker=B1060EventAttacker()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger ownerTrigger=GetTriggeringTrigger()
local integer ownerHandle=GetHandleId(ownerTrigger)
local unit source=O77(ownerHandle,"Hero")
local unit target
local trigger damageTrigger
local integer skill=OM7(ownerHandle,"Skill")
local integer order=GetIssuedOrderId()
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED and (not B1023HitLive(b1060GetAttacker) or not B1023HitLive(b1060GetTriggerUnit)) then
set ownerTrigger=null
set source=null
set target=null
set damageTrigger=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER then
if skill=='AHfa' then
if order==$D00CE then
call NS7(ownerHandle,"OrbOn",true)
elseif order==$D00CF then
call NS7(ownerHandle,"OrbOn",false)
endif
elseif order==$D011F then
call NS7(ownerHandle,"OrbOn",true)
elseif order==$D0120 then
call NS7(ownerHandle,"OrbOn",false)
endif
elseif b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED and b1060GetAttacker==source and OO7(ownerHandle,"OrbOn") and B287_GetUnitAbilityLevel(source,skill)>0 then
if SuijiMode_CrossRangeOrbHasMultiple(source) then
set source=null
set ownerTrigger=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
set target=b1060GetTriggerUnit
if skill=='AHfa' or IsUnitType(target,UNIT_TYPE_STRUCTURE)==false then
set damageTrigger=CreateTrigger()
call NT7(GetHandleId(damageTrigger),"Source",source)
call NP7(GetHandleId(damageTrigger),"Skill",skill)
call NS7(GetHandleId(damageTrigger),"NativeCast",false)
call TriggerRegisterUnitEvent(damageTrigger,source,EVENT_UNIT_SPELL_EFFECT)
call B1023RegisterDamage(damageTrigger,target)
call TriggerRegisterTimerEvent(damageTrigger,3.,false)
call TriggerAddCondition(damageTrigger,Condition(function SuijiMode_CrossRangeOrbDamage))
set damageTrigger=null
endif
endif
set source=null
set target=null
set ownerTrigger=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function SuijiMode_InitCrossRangeOrb takes unit u,integer skill returns nothing
local trigger t
local integer h
if SuijiMode_IsCrossRangeOrbSkill(skill)==false then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiCrossRangeOrb"+I2S(skill)) then
return
endif
call NS7(h,"SuijiCrossRangeOrb"+I2S(skill),true)
set t=CreateTrigger()
call B1027TempestTrackListener(u,t)
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddCondition(t,Condition(function SuijiMode_CrossRangeOrbEvent))
call NT7(GetHandleId(t),"Hero",u)
call NP7(GetHandleId(t),"Skill",skill)
call NS7(GetHandleId(t),"OrbOn",true)
set t=null
endfunction
function SuijiMode_InitA06D takes unit u returns nothing
