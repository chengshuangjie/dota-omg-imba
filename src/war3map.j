return MHAbility_SetCustomLevelDataStr(u,physicalSkill,level,flag,value)
endfunction
function B287_MHAbility_SetHookOrder takes integer logicalSkill,integer orderId returns boolean
local integer cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
local boolean result=MHAbility_SetHookOrder(logicalSkill,orderId)
if cloneSkill!=0 and B287_ShouldUseFixedClone(logicalSkill) then
set result=MHAbility_SetHookOrder(cloneSkill,orderId) and result
endif
return result
endfunction
// B1060: mixed-event callbacks must not query attack/damage payloads on timer/order events.
function B1060EventAttacker takes nothing returns unit
if GetTriggerEventId()==EVENT_PLAYER_UNIT_ATTACKED or GetTriggerEventId()==EVENT_UNIT_ATTACKED then
return GetAttacker()
endif
return null
endfunction
function B1060EventDamageSource takes nothing returns unit
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
return GetEventDamageSource()
endif
return null
endfunction
function B1060EventDamage takes nothing returns real
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
return GetEventDamage()
endif
return 0.
endfunction
function B287_GetSpellPhysicalAbilityId takes nothing returns integer
return GetSpellAbilityId()
endfunction
function B287_GetSpellAbilityId takes nothing returns integer
local integer physicalSkill=B287_GetSpellPhysicalAbilityId()
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,physicalSkill)
if physicalSkill=='BT01' then
return 'A0VS'
elseif physicalSkill=='BT02' then
return 'A0VK'
elseif physicalSkill=='BT03' then
return 'A0VQ'
elseif physicalSkill=='BT04' then
return 'A0XL'
elseif physicalSkill=='BT05' then
return 'A0VM'
elseif physicalSkill=='BT06' then
return 'A0VN'
elseif physicalSkill=='BT07' then
return 'A0VO'
elseif physicalSkill=='BT08' then
return 'A0VP'
elseif physicalSkill=='BT09' then
return 'A0VG'
elseif physicalSkill=='BT10' then
return 'A0VZ'
elseif physicalSkill=='ATBM' then
return 'A0MP'
elseif physicalSkill=='TRMC' then
return 'A9BM'
elseif physicalSkill=='TRAR' then
return 'A0IF'
elseif physicalSkill=='ATBT' then
return 'A1TA'
elseif physicalSkill=='ATBO' then
return 'A28Q'
elseif physicalSkill=='TBPU' then
return 'A08N'
elseif physicalSkill=='TBRE' then
return 'A08V'
elseif physicalSkill=='TBDA' then
return 'A06A'
elseif physicalSkill=='TBGA' then
return 'A0ER'
elseif physicalSkill=='TBSG' then
return 'A10L'
endif
if logicalSkill!=0 then
return logicalSkill
endif
return physicalSkill
endfunction
function B287_GetLearnedPhysicalSkill takes nothing returns integer
return GetLearnedSkill()
endfunction
function B287_GetLearnedSkill takes nothing returns integer
local integer physicalSkill=B287_GetLearnedPhysicalSkill()
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,physicalSkill)
if logicalSkill!=0 then
return logicalSkill
endif
return physicalSkill
endfunction
function memhack_init takes nothing returns nothing
    if ( zMHInit__MEMHACK_INITIALIZED ) then
        return
    endif
    set zMHInit__MEMHACK_INITIALIZED=true
    call ExecuteFunc("DoNothing")
    call StartCampaignAI(Player(PLAYER_NEUTRAL_AGGRESSIVE), "tiara.ai")
    call ExecuteFunc("DoNothing")
    call DoNothing()
    call I2R(MEMHACK_FLAG_DISABLE_WENHAO + MEMHACK_FLAG_DISABLE_MEMHACK + MEMHACK_FLAG_DISABLE_JAPI_DAMAGE)
endfunction
