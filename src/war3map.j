function B373_InitEnemyHalfBlackMask takes nothing returns nothing
local integer slice=0
local integer sliceCount=48
local real minX=GetRectMinX(bj_mapInitialPlayableArea)
local real maxX=GetRectMaxX(bj_mapInitialPlayableArea)
local real minY=GetRectMinY(bj_mapInitialPlayableArea)
local real maxY=GetRectMaxY(bj_mapInitialPlayableArea)
local real sliceWidth=(maxX-minX)/I2R(sliceCount)
local real x0
local real x1
local real splitY
local rect sentinelRect
local rect scourgeRect
call FogEnable(true)
call FogMaskEnable(true)
loop
exitwhen slice>=sliceCount
set x0=minX+sliceWidth*I2R(slice)
set x1=x0+sliceWidth
set splitY=-(x0+x1)*.5
if splitY<minY then
set splitY=minY
elseif splitY>maxY then
set splitY=maxY
endif
set sentinelRect=null
set scourgeRect=null
if splitY>minY then
set sentinelRect=Rect(x0,minY,x1,splitY)
endif
if splitY<maxY then
set scourgeRect=Rect(x0,splitY,x1,maxY)
endif
call B373_ExploreOwnHalfSlice(sentinelRect,scourgeRect)
if sentinelRect!=null then
call RemoveRect(sentinelRect)
endif
if scourgeRect!=null then
call RemoveRect(scourgeRect)
endif
set slice=slice+1
endloop
set sentinelRect=null
set scourgeRect=null
endfunction
