if B287_GetSpellAbilityId()=='A0BH' and suijiBroodSpawnTarget!=null and GetUnitTypeId(suijiBroodSpawnTarget)!=0 and WQ7(suijiBroodSpawnTarget)==false and SuijiMode_IsSacrificeProtectedTarget(suijiBroodSpawnTarget)==false then
