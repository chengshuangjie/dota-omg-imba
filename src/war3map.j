set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if(b1060GetTriggerEventId==EVENT_PLAYER_UNIT_DROP_ITEM and GetItemType(D88)!=ITEM_TYPE_PURCHASABLE)or b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PAWN_ITEM then
call N6G(D88,p5,false)
call C27("DRI_"+I2S(GetPlayerId(GetOwningPlayer(p5))),ZU[Y38(KY7(D88))])
elseif b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PICKUP_ITEM then
call N6G(D88,p5,true)
call C27("PUI_"+I2S(GetPlayerId(GetOwningPlayer(p5))),ZU[Y38(KY7(D88))])
endif
set p5=null
set D88=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
