//local integer Y_9=OM7(I97,"Counter")
//local integer Y48=OM7(GetHandleId(NXE),"Remaining")
//local integer Y_9=OM7(I97,"Counter")
//local integer Y48=OM7(GetHandleId(NXE),"Remaining")
if GetTriggerEventId()==EVENT_UNIT_DEATH or NXE==null or GetUnitTypeId(NXE)==0 or not UnitAlive(NXE) then
if NXE!=null then
call GroupRemoveUnit(B1052FamiliarUnits,NXE)
if LoadTriggerHandle(L7,GetHandleId(NXE),StringHash("B1052FamiliarListener"))==t then
call RemoveSavedHandle(L7,GetHandleId(NXE),StringHash("B1052FamiliarListener"))
call RemoveSavedHandle(L7,GetHandleId(NXE),StringHash("B1052FamiliarDamage"))
endif
endif
if familiarDamageListener1052!=null then
call FlushChildHashtable(L7,GetHandleId(familiarDamageListener1052))
call OZ7(familiarDamageListener1052)
endif
call NM7(I97)
call OZ7(t)
else
if GetUnitTypeId(NXE)=='u017' or GetUnitTypeId(NXE)=='u019' or GetUnitTypeId(NXE)=='u018' or GetUnitTypeId(NXE)=='u01A' or GetUnitTypeId(NXE)=='u01B' or GetUnitTypeId(NXE)=='u01C' or GetUnitTypeId(NXE)=='u01U' or GetUnitTypeId(NXE)=='u01V' or GetUnitTypeId(NXE)=='u01W' then
call SetUnitState(NXE,UNIT_STATE_LIFE,GetUnitState(NXE,UNIT_STATE_LIFE)+31.25+18.75*BC7)
endif
endif
set t=null
set NXE=null
set familiarDamageListener1052=null
return false
endfunction
function NBE takes nothing returns boolean
if GetUnitTypeId(GetFilterUnit())=='u014' or GetUnitTypeId(GetFilterUnit())=='u015' or GetUnitTypeId(GetFilterUnit())=='u016' or GetUnitTypeId(GetFilterUnit())=='u01D' or GetUnitTypeId(GetFilterUnit())=='u01E' or GetUnitTypeId(GetFilterUnit())=='u01F' or GetUnitTypeId(GetFilterUnit())=='u01R' or GetUnitTypeId(GetFilterUnit())=='u01S' or GetUnitTypeId(GetFilterUnit())=='u01T' or GetUnitTypeId(GetFilterUnit())=='u017' or GetUnitTypeId(GetFilterUnit())=='u019' or GetUnitTypeId(GetFilterUnit())=='u018' or GetUnitTypeId(GetFilterUnit())=='u01A' or GetUnitTypeId(GetFilterUnit())=='u01B' or GetUnitTypeId(GetFilterUnit())=='u01C' or GetUnitTypeId(GetFilterUnit())=='u01U' or GetUnitTypeId(GetFilterUnit())=='u01V' or GetUnitTypeId(GetFilterUnit())=='u01W' then
call KillUnit(GetFilterUnit())
endif
return false
endfunction
//召唤佣兽
function VisageSummonFamiliars_Register takes unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarLevel returns nothing
local trigger suijiVisageFamiliarTrigger
local integer suijiVisageFamiliarTriggerHandle
if suijiVisageFamiliarUnit==null or GetUnitTypeId(suijiVisageFamiliarUnit)==0 or not UnitAlive(suijiVisageFamiliarUnit) then
return
endif
set suijiVisageFamiliarTrigger=LoadTriggerHandle(L7,GetHandleId(suijiVisageFamiliarUnit),StringHash("B1052FamiliarListener"))
if suijiVisageFamiliarTrigger!=null and IsTriggerEnabled(suijiVisageFamiliarTrigger) then
call NP7(GetHandleId(suijiVisageFamiliarTrigger),"Level",suijiVisageFamiliarLevel)
call NP7(GetHandleId(suijiVisageFamiliarUnit),"Level",suijiVisageFamiliarLevel)
set suijiVisageFamiliarTrigger=null
return
endif
if B1052FamiliarUnits==null then
set B1052FamiliarUnits=CreateGroup()
endif
call GroupAddUnit(B1052FamiliarUnits,suijiVisageFamiliarUnit)
set suijiVisageFamiliarTrigger=CreateTrigger()
set suijiVisageFamiliarTriggerHandle=GetHandleId(suijiVisageFamiliarTrigger)
call SaveTriggerHandle(L7,GetHandleId(suijiVisageFamiliarUnit),StringHash("B1052FamiliarListener"),suijiVisageFamiliarTrigger)
call TriggerRegisterTimerEvent(suijiVisageFamiliarTrigger,1,true)
call TriggerRegisterUnitEvent(suijiVisageFamiliarTrigger,suijiVisageFamiliarUnit,EVENT_UNIT_DEATH)
call TriggerAddCondition(suijiVisageFamiliarTrigger,Condition(function NAE))
call NT7(suijiVisageFamiliarTriggerHandle,"Source",suijiVisageFamiliarUnit)
call NP7(suijiVisageFamiliarTriggerHandle,"Level",suijiVisageFamiliarLevel)
call NP7(GetHandleId(suijiVisageFamiliarUnit),"Level",suijiVisageFamiliarLevel)
call ZCZHYS(suijiVisageFamiliarUnit)
call SaveTriggerHandle(L7,suijiVisageFamiliarTriggerHandle,StringHash("B1052FamiliarDamage"),LoadTriggerHandle(L7,GetHandleId(suijiVisageFamiliarUnit),StringHash("B1052FamiliarDamage")))
set suijiVisageFamiliarTrigger=null
endfunction
function VisageSummonFamiliars_AddLifeBonus takes unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarLifeBonus returns nothing
local integer suijiVisageFamiliarLifeBit=0
loop
exitwhen suijiVisageFamiliarLifeBonus<=0 or suijiVisageFamiliarLifeBit>13
if ModuloInteger(suijiVisageFamiliarLifeBonus,2)==1 then
call XF7(suijiVisageFamiliarUnit,VISAGE_FAMILIAR_LIFE_BONUS[suijiVisageFamiliarLifeBit])
endif
set suijiVisageFamiliarLifeBonus=suijiVisageFamiliarLifeBonus/2
set suijiVisageFamiliarLifeBit=suijiVisageFamiliarLifeBit+1
endloop
endfunction
function VisageSummonFamiliars_AddArmorBonus takes unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarArmorBonus returns nothing
local integer suijiVisageFamiliarArmorBit=0
loop
exitwhen suijiVisageFamiliarArmorBonus<=0 or suijiVisageFamiliarArmorBit>7
if ModuloInteger(suijiVisageFamiliarArmorBonus,2)==1 then
call XF7(suijiVisageFamiliarUnit,VISAGE_FAMILIAR_ARMOR_BONUS[suijiVisageFamiliarArmorBit])
endif
set suijiVisageFamiliarArmorBonus=suijiVisageFamiliarArmorBonus/2
set suijiVisageFamiliarArmorBit=suijiVisageFamiliarArmorBit+1
endloop
endfunction
function VisageSummonFamiliars_ApplyHeroStats takes unit suijiVisageSummonCaster,unit suijiVisageFamiliarUnit returns nothing
local integer suijiVisageFamiliarLifeBonus=0
local integer suijiVisageFamiliarArmorBonus=0
local integer suijiVisageFamiliarDamageBonus=0
if suijiVisageSummonCaster==null or GetUnitTypeId(suijiVisageSummonCaster)==0 or suijiVisageFamiliarUnit==null or GetUnitTypeId(suijiVisageFamiliarUnit)==0 then
return
endif
set suijiVisageFamiliarLifeBonus=IMinBJ(R2I(RMaxBJ(GetUnitState(suijiVisageSummonCaster,UNIT_STATE_MAX_LIFE)*.20,0.)+.5),16383)
set suijiVisageFamiliarArmorBonus=IMinBJ(R2I(RMaxBJ(GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ARMOR)*.20,0.)+.5),255)
set suijiVisageFamiliarDamageBonus=IMinBJ(R2I(RMaxBJ((GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ATTACK1_DAMAGE_BONUS))*.20,0.)+.5),4095)
call VisageSummonFamiliars_AddLifeBonus(suijiVisageFamiliarUnit,suijiVisageFamiliarLifeBonus)
call VisageSummonFamiliars_AddArmorBonus(suijiVisageFamiliarUnit,suijiVisageFamiliarArmorBonus)
call YLG2(suijiVisageFamiliarUnit,suijiVisageFamiliarDamageBonus)
call SetUnitState(suijiVisageFamiliarUnit,UNIT_STATE_LIFE,GetUnitState(suijiVisageFamiliarUnit,UNIT_STATE_MAX_LIFE))
endfunction
function VisageSummonFamiliars_Prepare takes unit suijiVisageSummonCaster,unit suijiVisageFamiliarUnit,integer suijiVisageFamiliarLevel,integer familiarLife1052,integer familiarArmor1052,integer familiarDamage1052 returns nothing
if suijiVisageFamiliarUnit==null or GetUnitTypeId(suijiVisageFamiliarUnit)==0 or not UnitAlive(suijiVisageFamiliarUnit) then
return
endif
call VisageSummonFamiliars_AddLifeBonus(suijiVisageFamiliarUnit,familiarLife1052)
call VisageSummonFamiliars_AddArmorBonus(suijiVisageFamiliarUnit,familiarArmor1052)
call YLG2(suijiVisageFamiliarUnit,familiarDamage1052)
call SetUnitState(suijiVisageFamiliarUnit,UNIT_STATE_LIFE,GetUnitState(suijiVisageFamiliarUnit,UNIT_STATE_MAX_LIFE))
if Ab[GetPlayerId(GetOwningPlayer(suijiVisageSummonCaster))]then
call SelectUnitAddForPlayer(suijiVisageFamiliarUnit,GetOwningPlayer(suijiVisageSummonCaster))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",suijiVisageFamiliarUnit,"origin"))
call VisageSummonFamiliars_Register(suijiVisageFamiliarUnit,suijiVisageFamiliarLevel)
endfunction
function B1052FamiliarSpawn takes nothing returns nothing
local timer familiarClock1052=GetExpiredTimer()
local integer familiarClockKey1052=GetHandleId(familiarClock1052)
local unit familiarCaster1052=LoadUnitHandle(L7,familiarClockKey1052,0)
local unit familiarNew1052=null
local integer familiarSlot1052=LoadInteger(L7,familiarClockKey1052,1)
local integer familiarLevel1052=LoadInteger(L7,familiarClockKey1052,2)
local integer familiarType1052=0
local real familiarX1052=LoadReal(L7,familiarClockKey1052,3)
local real familiarY1052=LoadReal(L7,familiarClockKey1052,4)
if familiarCaster1052!=null and GetUnitTypeId(familiarCaster1052)!=0 then
if LoadInteger(L7,familiarClockKey1052,6)==LoadInteger(L7,GetHandleId(familiarCaster1052),StringHash("B1052FamiliarSequence")) then
if familiarSlot1052==1 then
set familiarX1052=familiarX1052+75
set familiarY1052=familiarY1052+75
if familiarLevel1052==1 then
set familiarType1052='u014'
elseif familiarLevel1052==2 then
set familiarType1052='u015'
else
set familiarType1052='u016'
endif
elseif familiarSlot1052==2 then
set familiarX1052=familiarX1052-75
set familiarY1052=familiarY1052-75
if familiarLevel1052==1 then
set familiarType1052='u01D'
elseif familiarLevel1052==2 then
set familiarType1052='u01E'
else
set familiarType1052='u01F'
endif
else
set familiarX1052=familiarX1052+75
if familiarLevel1052==1 then
set familiarType1052='u01R'
elseif familiarLevel1052==2 then
set familiarType1052='u01S'
else
set familiarType1052='u01T'
endif
endif
set familiarNew1052=CreateUnit(LoadPlayerHandle(L7,familiarClockKey1052,10),familiarType1052,familiarX1052,familiarY1052,LoadReal(L7,familiarClockKey1052,5))
call VisageSummonFamiliars_Prepare(familiarCaster1052,familiarNew1052,familiarLevel1052,LoadInteger(L7,familiarClockKey1052,7),LoadInteger(L7,familiarClockKey1052,8),LoadInteger(L7,familiarClockKey1052,9))
if familiarSlot1052<LoadInteger(L7,familiarClockKey1052,11) then
call SaveInteger(L7,familiarClockKey1052,1,familiarSlot1052+1)
call TimerStart(familiarClock1052,.03,false,function B1052FamiliarSpawn)
set familiarNew1052=null
set familiarCaster1052=null
set familiarClock1052=null
return
endif
endif
endif
call FlushChildHashtable(L7,familiarClockKey1052)
call PauseTimer(familiarClock1052)
call DestroyTimer(familiarClock1052)
set familiarNew1052=null
set familiarCaster1052=null
set familiarClock1052=null
endfunction
function VisageSummonFamiliars_Create takes unit suijiVisageSummonCaster,boolean suijiVisageSummonClearExisting returns nothing
local group familiarSnapshot1052=null
local unit familiarOld1052=null
local timer familiarClock1052=null
local integer familiarClockKey1052=0
local integer familiarLevel1052=0
local integer familiarOwnerKey1052=0
local integer familiarCount1052=2
if suijiVisageSummonCaster==null or GetUnitTypeId(suijiVisageSummonCaster)==0 then
return
endif
set familiarLevel1052=B287_GetUnitAbilityLevel(suijiVisageSummonCaster,'A1NE')
if familiarLevel1052==0 then
set familiarLevel1052=B287_GetUnitAbilityLevel(suijiVisageSummonCaster,'A2IG')
endif
if familiarLevel1052<1 or familiarLevel1052>3 then
return
endif
if suijiVisageSummonClearExisting and B1052FamiliarUnits!=null then
// Snapshot only registered familiars; death callbacks may mutate the live group.
set familiarSnapshot1052=CreateGroup()
call GroupAddGroup(B1052FamiliarUnits,familiarSnapshot1052)
loop
set familiarOld1052=FirstOfGroup(familiarSnapshot1052)
exitwhen familiarOld1052==null
call GroupRemoveUnit(familiarSnapshot1052,familiarOld1052)
if GetUnitTypeId(familiarOld1052)==0 or not UnitAlive(familiarOld1052) then
call GroupRemoveUnit(B1052FamiliarUnits,familiarOld1052)
elseif GetOwningPlayer(familiarOld1052)==GetOwningPlayer(suijiVisageSummonCaster) then
call KillUnit(familiarOld1052)
endif
endloop
call DestroyGroup(familiarSnapshot1052)
endif
if SuijiMode_ScepterRegistryIsActive(suijiVisageSummonCaster,'A1NE') then
set familiarCount1052=3
endif
set familiarOwnerKey1052=GetHandleId(suijiVisageSummonCaster)
call SaveInteger(L7,familiarOwnerKey1052,StringHash("B1052FamiliarSequence"),LoadInteger(L7,familiarOwnerKey1052,StringHash("B1052FamiliarSequence"))+1)
set familiarClock1052=CreateTimer()
set familiarClockKey1052=GetHandleId(familiarClock1052)
call SaveUnitHandle(L7,familiarClockKey1052,0,suijiVisageSummonCaster)
call SaveInteger(L7,familiarClockKey1052,1,1)
call SaveInteger(L7,familiarClockKey1052,2,familiarLevel1052)
call SaveReal(L7,familiarClockKey1052,3,GetUnitX(suijiVisageSummonCaster))
call SaveReal(L7,familiarClockKey1052,4,GetUnitY(suijiVisageSummonCaster))
call SaveReal(L7,familiarClockKey1052,5,GetUnitFacing(suijiVisageSummonCaster))
call SaveInteger(L7,familiarClockKey1052,6,LoadInteger(L7,familiarOwnerKey1052,StringHash("B1052FamiliarSequence")))
call SaveInteger(L7,familiarClockKey1052,7,IMinBJ(R2I(RMaxBJ(GetUnitState(suijiVisageSummonCaster,UNIT_STATE_MAX_LIFE)*.20,0.)+.5),16383))
call SaveInteger(L7,familiarClockKey1052,8,IMinBJ(R2I(RMaxBJ(GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ARMOR)*.20,0.)+.5),255))
call SaveInteger(L7,familiarClockKey1052,9,IMinBJ(R2I(RMaxBJ((GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(suijiVisageSummonCaster,UNIT_STATE_ATTACK1_DAMAGE_BONUS))*.20,0.)+.5),4095))
call SavePlayerHandle(L7,familiarClockKey1052,10,GetOwningPlayer(suijiVisageSummonCaster))
call SaveInteger(L7,familiarClockKey1052,11,familiarCount1052)
// One complete familiar per callback, at 0, 30 and 60 ms. No idle timer.
call TimerStart(familiarClock1052,0.,false,function B1052FamiliarSpawn)
set familiarSnapshot1052=null
set familiarOld1052=null
set familiarClock1052=null
endfunction
function NCE takes nothing returns nothing
local unit suijiVisageSummonCaster=GetTriggerUnit()
local integer suijiVisageSummonSkill=B287_GetSpellAbilityId()
local integer suijiVisageSummonHandle=GetHandleId(suijiVisageSummonCaster)
// A1NE and its ANeg-upgraded A2IG face share one order.  During an engine
// replacement window Warcraft can report both effect events for the same cast.
// The spell has a 30-second cooldown, so a short logical-cast gate safely keeps
// one real cast to one replacement set (two familiars, or three with Scepter).
if ON7(suijiVisageSummonHandle,"SuijiVisageFamiliarsEffectUntil")>TimerGetElapsed(W) then
set suijiVisageSummonCaster=null
return
endif
call NQ7(suijiVisageSummonHandle,"SuijiVisageFamiliarsEffectUntil",TimerGetElapsed(W)+.25)
call VisageSummonFamiliars_Create(suijiVisageSummonCaster,true)
call SuijiMode_StartPairCooldownSync(suijiVisageSummonCaster,suijiVisageSummonSkill,'A1NE','A2IG',"SuijiVisageFamiliarsCooldown",30.,30.,30.,30.,30.,30.)
set suijiVisageSummonCaster=null
endfunction
function N1E takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
if b1060B287_GetSpellAbilityId=='A1NE' or b1060B287_GetSpellAbilityId=='A2IG' then
call NCE()
elseif b1060B287_GetSpellAbilityId=='A1NB' or b1060B287_GetSpellAbilityId=='A1NC' or b1060B287_GetSpellAbilityId=='A1ND' or b1060B287_GetSpellAbilityId=='A1NL' or b1060B287_GetSpellAbilityId=='A1NM' or b1060B287_GetSpellAbilityId=='A1NN' or b1060B287_GetSpellAbilityId=='A2IZ' or b1060B287_GetSpellAbilityId=='A2J0' or b1060B287_GetSpellAbilityId=='A2J1' then
call NVE()
endif
return false
endfunction
