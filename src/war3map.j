function LQA takes nothing returns boolean
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit WUE =(LoadUnitHandle(TABLE_HY, h, 2))
	local integer CVX =(LoadInteger(TABLE_HY, h, 59))
	call FlushChildHashtable(TABLE_HY, h)
	call OZ7(t)
	call UnitRemoveAbility(WUE, CVX)
	call UnitRemoveAbility(WUE,'B0FJ')
	call UnitRemoveAbility(WUE,'B0FK')
	set t = null
	set WUE = null
	return false
endfunction
function LSA takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local unit u = LoadUnitHandle(TABLE_HY, GetHandleId(t), 0)
	call UnitRemoveAbility(u,'A2GD')
	call UnitRemoveAbility(u,'A2GE')
	call UnitRemoveAbility(u,'A2GF')
	call UnitRemoveAbility(u,'A2GC')
	call UnitRemoveAbility(u,'B0FJ')
	call UnitRemoveAbility(u,'B0FK')
	call FlushChildHashtable(TABLE_HY, GetHandleId(t))
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function LTA takes unit u, unit WLE returns nothing
	local timer t = CreateTimer()
	call TimerStart(t, 0.3, false, function LSA)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, u)
	set t = null
endfunction
function LUA takes unit R8X,unit WLE returns nothing
	local trigger t
	local integer h
	local integer BC7 = GetUnitAbilityLevel(WLE,'A2EY')
	local integer id
	local integer probability = 25
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	// if IsUnitType(R8X, UNIT_TYPE_HERO) then
	// 	set probability = 35
	// endif
	if GetPrdRandom(WLE,'A2EY', IMinBJ(probability*imbaMult,100)) then
        if GetUnitAbilityLevel(WLE,'A2VW')>0 then
            call O37(WLE,"4316",.75*(3.2-0.6*BC7))
        else
            call O37(WLE,"4316",3.2-0.6*BC7)
        endif
		// call YDWESetUnitAbilityState(WLE,'QP1O', 1, 3.31 - BC7 * 0.6)
		if BC7 == 1 then
			set id ='A2GD'
		elseif BC7 == 2 then
			set id ='A2GE'
		elseif BC7 == 3 then
			set id ='A2GF'
		elseif BC7 == 4 then
			set id ='A2GC'
		endif
		call XF7(WLE, id)
		call SetPlayerAbilityAvailable(GetOwningPlayer(WLE), id, false)
		set t = CreateTrigger()
		set h = GetHandleId(t)
		call TriggerRegisterDeathEvent(t, WLE)
		call TriggerRegisterTimerEvent(t, 1., false)
		call TriggerAddCondition(t, Condition(function LQA))
		call SaveUnitHandle(TABLE_HY, h, 2, WLE)
		call SaveInteger(TABLE_HY, h, 59, id)
		set t = null
	endif
endfunction
function TDA takes nothing returns nothing
	if GetUnitAbilityLevel(YXX,'A2EY')> 0 and OT7(YXX,"4316")==false and IsUnitEnemy(YXX, GetOwningPlayer(WXX)) and ISPH(YXX)==false then
		call LUA(WXX,YXX)
	endif
endfunction
function SFA takes nothing returns nothing
	if LoadInteger(TABLE_HY, EOO, 120)> 0 and(GetUnitAbilityLevel(WXX,'A2GD')> 0 or GetUnitAbilityLevel(WXX,'A2GE')> 0 or GetUnitAbilityLevel(WXX,'A2GF')> 0 or GetUnitAbilityLevel(WXX,'A2GC')> 0) then
		call SaveInteger(TABLE_HY, EOO, 120, LoadInteger(TABLE_HY, EOO, 120)-1)
		call LTA(WXX, YXX)
	endif
endfunction
function SGA takes nothing returns nothing
	call SaveBoolean(TABLE_HY, EOO, 120, GetUnitAbilityLevel(WXX,'B0FJ')> 0)
	if GetUnitAbilityLevel(WXX,'B0FJ')> 0 then
		call SaveInteger(TABLE_HY, EOO, 120, LoadInteger(TABLE_HY, EOO, 120)+ 1)
	endif
endfunction
//决斗
function Y1G takes unit ZX7,integer BC7,unit IH7,boolean b returns nothing
local integer I97=GetHandleId(ZX7)
local integer Y0G=(LoadInteger(L7,(I97),(739)))
local integer O5=GetPlayerId(GetOwningPlayer(ZX7))
if IsUnitType(IH7,UNIT_TYPE_HERO) then
set JTJD[O5]=JTJD[O5]+8+4*BC7
set Y0G=Y0G+8+4*BC7
call SaveInteger(L7,(I97),(739),(Y0G))
if SPEPLAYER[GetPlayerId(GetOwningPlayer(ZX7))]==1 and ISLABIKE(ZX7) then
    call YW7("我才是军团！",5,ZX7,.03,$FF,$FF,0,$FF)
else
    call YW7(GetUnitName(ZX7)+" Winner!!",5,ZX7,.03,$FF,$FF,0,$FF)
endif
call YLG(ZX7,Y0G)
call SuijiMode_MarkUnitVisibilityDirty(ZX7)
if IS_AI(ZX7) and IS_HUMAN(IH7) then
	if b then
		call Send_Chat_Text(GetOwningPlayer(ZX7),Get_Skill_Text(GetOwningPlayer(ZX7),"JueDouWin"))
	else
		call Send_Chat_Text(GetOwningPlayer(ZX7),Get_Skill_Text(GetOwningPlayer(ZX7),"JueDouLose"))
	endif
endif
endif
endfunction
function Y2G takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
