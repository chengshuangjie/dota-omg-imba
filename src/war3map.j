local boolean b1060EnumReturn
if IsUnitInGroup((b1060GetEnumUnit),WL4)==false and WF7((b1060GetEnumUnit))==false then
call GroupAddUnit(WL4,(b1060GetEnumUnit))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\FireBlast.mdx",(b1060GetEnumUnit),"chest"))
call SBE(W04,(b1060GetEnumUnit),W14)
endif
