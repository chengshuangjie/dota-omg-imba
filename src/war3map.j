function SuijiMode_EarlyDetectAghanimSourceState takes unit u,item excluded returns boolean
local integer slot=0
local integer ownItemIndex=0
local item it=null
if u==null or GetUnitTypeId(u)==0 then
return false
endif
loop
exitwhen slot>5
set it=UnitItemInSlot(u,slot)
if it!=null and it!=excluded and Y_82(it) then
set it=null
return true
endif
set slot=slot+1
endloop
set ownItemIndex=F59(u)
set it=null
return (ownItemIndex>=0 and Lost_A_PD(u,ZU[ownItemIndex],excluded)!=null) or Lost_A_PD(u,ZU[GX4],excluded)!=null or Lost_A_PD(u,ZU[R1K],excluded)!=null or CHIA[GetPlayerId(GetOwningPlayer(u))]==1 or GetUnitAbilityLevel(u,'A330')>0
endfunction
// B1099: one logical charge family, with foreign point-order carriers.
function B1099EarthStoneAbility takes unit earthUnit1099,integer earthCharges1099 returns integer
local integer earthFamily1099=LoadInteger(L7,GetHandleId(earthUnit1099),StringHash("B1099EarthStoneFamily"))
set earthCharges1099=IMinBJ(6,IMaxBJ(0,earthCharges1099))
if earthFamily1099==1 then
return 'YS00'+earthCharges1099
elseif earthFamily1099==2 then
return 'YS10'+earthCharges1099
elseif earthFamily1099==3 then
return 'YS20'+earthCharges1099
endif
return JMI[earthCharges1099]
endfunction
function B1099EarthHasSkills takes unit earthUnit1099 returns boolean
local integer earthType1099=GetUnitTypeId(earthUnit1099)
if earthUnit1099==null or earthType1099==0 or IsUnitIllusion(earthUnit1099) then
return false
endif
return earthType1099=='N0MU' or earthType1099=='N0MV' or OM7(GetHandleId(earthUnit1099),"SuijiSmallSource")==58 or OM7(GetHandleId(earthUnit1099),"SuijiUltSource")==58 or B287_GetUnitAbilityLevel(earthUnit1099,'A2V6')>0 or B287_GetUnitAbilityLevel(earthUnit1099,'A2V4')>0 or B287_GetUnitAbilityLevel(earthUnit1099,'A2V5')>0 or B287_GetUnitAbilityLevel(earthUnit1099,'A2V7')>0 or B287_GetUnitAbilityLevel(earthUnit1099,'A2Z3')>0
endfunction
function B1099EarthZeroCooldown takes nothing returns nothing
local timer earthTimer1099=GetExpiredTimer()
local integer earthTimerHandle1099=GetHandleId(earthTimer1099)
local unit earthUnit1099=LoadUnitHandle(L7,earthTimerHandle1099,0)
local trigger earthController1099=null
local integer earthPhysical1099=0
local ability earthAbility1099=null
local real earthRemaining1099=0.
if earthUnit1099!=null and GetUnitTypeId(earthUnit1099)!=0 and LoadInteger(L7,GetHandleId(earthUnit1099),800)==0 then
set earthController1099=LoadTriggerHandle(L7,GetHandleId(earthUnit1099),StringHash("B1099EarthChargeOwner"))
set earthPhysical1099=B1099EarthStoneAbility(earthUnit1099,0)
if earthController1099!=null and GetUnitAbilityLevel(earthUnit1099,earthPhysical1099)>0 then
set earthRemaining1099=RMaxBJ(0.,LoadReal(L7,GetHandleId(earthController1099),442))
// This is a bounded zero-charge face transition, never a periodic card scan.
set earthAbility1099=MHAbility_GetAbility(earthUnit1099,earthPhysical1099)
if earthAbility1099!=null and MHAbility_GetId(earthAbility1099)==earthPhysical1099 then
call EXSetAbilityState(earthAbility1099,1,earthRemaining1099)
call MHAbility_SetCooldownEx(earthUnit1099,earthPhysical1099,earthRemaining1099,LoadReal(L7,GetHandleId(earthController1099),443))
endif
endif
endif
call FlushChildHashtable(L7,earthTimerHandle1099)
call PauseTimer(earthTimer1099)
call DestroyTimer(earthTimer1099)
set earthUnit1099=null
set earthController1099=null
set earthAbility1099=null
set earthTimer1099=null
endfunction
function B1099EarthScheduleZero takes unit earthUnit1099 returns nothing
local timer earthTimer1099=null
if LoadInteger(L7,GetHandleId(earthUnit1099),800)==0 then
set earthTimer1099=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(earthTimer1099),0,earthUnit1099)
call TimerStart(earthTimer1099,0.,false,function B1099EarthZeroCooldown)
endif
set earthTimer1099=null
endfunction
function B1099EarthRechargeInterval takes unit earthUnit1099 returns real
local real earthInterval1099=JWI
if LoadBoolean(L7,GetHandleId(earthUnit1099),StringHash("B1099EarthScepter")) then
set earthInterval1099=8.
endif
if GetUnitAbilityLevel(earthUnit1099,'A2VW')>0 then
set earthInterval1099=earthInterval1099*.75
endif
return earthInterval1099
endfunction
function B1099EarthSetScepter takes unit earthUnit1099,boolean earthActive1099 returns nothing
local integer earthOwner1099=GetHandleId(earthUnit1099)
local trigger earthController1099=null
local real earthOldInterval1099=0.
local real earthNewInterval1099=0.
local real earthRemaining1099=0.
local boolean earthChanged1099=false
if not B1099EarthHasSkills(earthUnit1099) then
return
endif
set earthChanged1099=not LoadBoolean(L7,earthOwner1099,StringHash("B1099EarthScepterKnown")) or LoadBoolean(L7,earthOwner1099,StringHash("B1099EarthScepter"))!=earthActive1099
call SaveBoolean(L7,earthOwner1099,StringHash("B1099EarthScepterKnown"),true)
call SaveBoolean(L7,earthOwner1099,StringHash("B1099EarthScepter"),earthActive1099)
set earthController1099=LoadTriggerHandle(L7,earthOwner1099,StringHash("B1099EarthChargeOwner"))
if earthController1099!=null then
set earthOldInterval1099=LoadReal(L7,GetHandleId(earthController1099),443)
set earthNewInterval1099=B1099EarthRechargeInterval(earthUnit1099)
if earthChanged1099 or earthOldInterval1099!=earthNewInterval1099 then
set earthRemaining1099=LoadReal(L7,GetHandleId(earthController1099),442)
if earthOldInterval1099>0. then
set earthRemaining1099=earthRemaining1099*earthNewInterval1099/earthOldInterval1099
else
set earthRemaining1099=earthNewInterval1099
endif
call SaveReal(L7,GetHandleId(earthController1099),442,earthRemaining1099)
call SaveReal(L7,GetHandleId(earthController1099),443,earthNewInterval1099)
call B1099EarthScheduleZero(earthUnit1099)
endif
endif
set earthController1099=null
endfunction
// Scepter-only buttons must be removed with their last authoritative source,
// but their running cooldown must survive a drop/pick cycle.
function SuijiMode_SyncNativeAghCompanion takes unit u,integer skill,integer level,boolean active,boolean visible returns nothing
local integer h=0
local integer key=0
local real cooldown=0.
local real expire=0.
local real now=0.
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return
endif
set h=GetHandleId(u)
set key=StringHash("SuijiNativeAghCompanionCooldown"+I2S(skill))
set now=TimerGetElapsed(W)
if active then
if SuijiMode_HasExactLiveAbility(u,skill) then
set cooldown=B582_GetAbilityCooldown(u,skill)
endif
if SuijiMode_EnsureExactLiveAbilityLevel(u,skill,level,true)==false then
return
endif
call SuijiMode_SyncStateReplaceBaseSlot(u,skill)
if cooldown<=0. then
set expire=LoadReal(L7,h,key)
set cooldown=expire-now
endif
if cooldown>0. then
if SuijiMode_HasExactLiveAbility(u,skill) then
call MHAbility_SetCooldown(u,skill,cooldown)
endif
endif
call RemoveSavedReal(L7,h,key)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,visible)
else
if SuijiMode_HasExactLiveAbility(u,skill) then
set cooldown=B582_GetAbilityCooldown(u,skill)
if cooldown>0. then
call SaveReal(L7,h,key,now+cooldown)
endif
endif
// Scepter ownership is synchronized; exact-live inspection only preserves an
// optional cooldown snapshot and must never decide companion removal.
call SetPlayerAbilityAvailable(GetOwningPlayer(u),skill,false)
if GetUnitAbilityLevel(u,skill)>0 then
call UnitRemoveAbility(u,skill)
endif
endif
endfunction
// Reconcile only native hero Scepter companion buttons. Held Scepters and
// permanent blessings are the authoritative sources, never the button itself.
function SuijiMode_ReconcileNativeAghCompanions takes unit u,item excluded returns nothing
local integer id=0
local integer level=1
local boolean active=false
if u==null or GetUnitTypeId(u)==0 then
return
endif
set id=GetUnitTypeId(u)
set active=SuijiMode_EarlyDetectAghanimSourceState(u,excluded)
call B1099EarthSetScepter(u,active)
if id=='U00C' or id=='Z00C' then
call SuijiMode_SyncNativeAghCompanion(u,'A194',1,active,true)
if active and id=='U00C' then
call XF7(u,'A4EV')
call XF7(u,'A4EW')
elseif not active then
call UnitRemoveAbility(u,'A4EV')
call UnitRemoveAbility(u,'A4EW')
endif
elseif id=='N0M7' or id=='N1MB' or id=='N1MC' or id=='N1MO' or id=='N1MA' then
set level=IMaxBJ(GetUnitAbilityLevel(u,'A2NE'),GetUnitAbilityLevel(u,'A3NF'))
if active then
call XF7(u,'A2Y6')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2Y6',false)
else
call UnitRemoveAbility(u,'A2Y6')
endif
call SuijiMode_SyncNativeAghCompanion(u,'A3NE',level,active and level>0,true)
elseif id=='UC76' then
call SuijiMode_SyncNativeAghCompanion(u,'A4L7',1,active,true)
elseif id=='N0MU' or id=='N0MV' then
call SuijiMode_SyncNativeAghCompanion(u,'A2VM',1,active,true)
elseif id=='E01B' or id=='Z01B' or id=='Z11B' or id=='Z21B' or id=='Z31B' then
call SuijiMode_SyncNativeAghCompanion(u,'A4B6',1,active,true)
elseif id=='Ogrh' then
call SuijiMode_SyncNativeAghCompanion(u,'A0D7',1,active,true)
elseif id=='E02I' then
call SuijiMode_SyncNativeAghCompanion(u,'A4HI',1,active,true)
elseif id=='Otch' or id=='Ztch' or id=='Zuch' or id=='Zvch' then
set level=B287_GetUnitAbilityLevel(u,'A0DL')
if level<1 then
set level=1
endif
call SuijiMode_SyncNativeAghCompanion(u,'A4LZ',level,active,true)
if active and SuijiMode_HasExactLiveAbility(u,'A4LZ') then
call B1000TotemLeapCastpoint(u)
endif
elseif id=='Udea' then
call SuijiMode_SyncNativeAghCompanion(u,'A4LQ',1,active,true)
elseif id=='Hamg' then
call SuijiMode_SyncNativeAghCompanion(u,'A1G7',1,active,true)
elseif id=='E01Y' or id=='Z01Y' then
call SuijiMode_SyncNativeAghCompanion(u,'A4KJ',1,active,true)
elseif id=='O015' then
call SuijiMode_SyncNativeAghCompanion(u,'A4KK',1,active,true)
if active and SuijiMode_HasExactLiveAbility(u,'A4KK') then
call SuijiMode_SetExactLiveAbilityCastpoint(u,'A4KK',.7)
endif
elseif id=='H001' or id=='H0CQ' or id=='Z001' or id=='Z0CQ' then
set level=B287_GetUnitAbilityLevel(u,'A190')
if level<1 then
set level=1
endif
call SuijiMode_SyncNativeAghCompanion(u,'A4IL',level,active,true)
elseif id=='Hmbr' then
call SuijiMode_SyncNativeAghCompanion(u,'A3NB',1,active,true)
endif
endfunction
function CHIA_SKILL_OTHERS takes unit u,player p,integer id,boolean CHIA returns nothing
local integer i=GetPlayerId(p)
local unit m5=null
//德鲁伊
if CHIA==true then
if id=='N01O' or id=='N013' or id=='N014' or id=='N015' then
	set R6c=R6c+1
	set R6d[i]=R6d[i]+1
