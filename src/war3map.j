// All vote state and handles are shared; DialogDisplay targets only its player.
function B902SlCleanup takes nothing returns nothing
local integer slIndex=0
set B902SlActive=false
if B902SlTimer!=null then
call PauseTimer(B902SlTimer)
call DestroyTimer(B902SlTimer)
set B902SlTimer=null
endif
if B902SlClickTrigger!=null then
call OZ7(B902SlClickTrigger)
set B902SlClickTrigger=null
endif
if B902SlLeaveTrigger!=null then
call OZ7(B902SlLeaveTrigger)
set B902SlLeaveTrigger=null
endif
loop
exitwhen slIndex>11
if B902SlDialog[slIndex]!=null then
call DialogDisplay(Player(slIndex),B902SlDialog[slIndex],false)
call DialogClear(B902SlDialog[slIndex])
call DialogDestroy(B902SlDialog[slIndex])
set B902SlDialog[slIndex]=null
endif
set B902SlYes[slIndex]=null
set B902SlNo[slIndex]=null
set B902SlVoter[slIndex]=false
set B902SlAnswered[slIndex]=false
set slIndex=slIndex+1
endloop
set B902SlHost=null
set B902SlRemaining=0
set B902SlTarget=0
set B902SlOriginal=0
endfunction
function B902SlReject takes string slReason returns nothing
call B902SlCleanup()
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cffff8000人头数投票未通过："+slReason+"。当前上限仍为 "+I2S(killers)+"。|r")
endfunction
function B902SlEnd takes nothing returns nothing
if B902SlActive then
call B902SlCleanup()
endif
endfunction
function B902SlTimeout takes nothing returns nothing
if B902SlActive then
call B902SlReject("20秒已到，未投票视为不同意")
endif
endfunction
function B902SlLeave takes nothing returns nothing
if B902SlActive then
call B902SlReject("房主或参与投票的玩家离开游戏")
endif
endfunction
function B902SlAccept takes nothing returns nothing
local integer slIndex=0
local integer slNewLimit=B902SlTarget
if D9 or killers!=B902SlOriginal or GetPlayerSlotState(B902SlHost)!=PLAYER_SLOT_STATE_PLAYING then
call B902SlReject("对局已结束或原有设置已变化")
return
endif
loop
exitwhen slIndex>11
if B902SlVoter[slIndex] then
if not B902SlAnswered[slIndex] or GetPlayerSlotState(Player(slIndex))!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(Player(slIndex))!=MAP_CONTROL_USER then
call B902SlReject("未获得全部在线真人玩家的同意")
return
endif
endif
set slIndex=slIndex+1
endloop
call B902SlCleanup()
set killers=slNewLimit
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cff00ff00人头数调整通过，当前上限为："+I2S(killers)+"（任意一方达到即可获胜）。|r")
endfunction
function B902SlClick takes nothing returns nothing
local button b1060GetClickedButton=GetClickedButton()
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local integer slPid=GetPlayerId(b1060GetTriggerPlayer)
if not B902SlActive or slPid<0 or slPid>11 then
set b1060GetClickedButton=null
set b1060GetTriggerPlayer=null
return
endif
if not B902SlVoter[slPid] or B902SlAnswered[slPid] or GetClickedDialog()!=B902SlDialog[slPid] then
set b1060GetClickedButton=null
set b1060GetTriggerPlayer=null
return
endif
if TimerGetRemaining(B902SlTimer)<=0. then
call B902SlTimeout()
set b1060GetClickedButton=null
set b1060GetTriggerPlayer=null
return
endif
if b1060GetClickedButton==B902SlNo[slPid] then
call B902SlReject(GetPlayerName(b1060GetTriggerPlayer)+"选择了拒绝")
elseif b1060GetClickedButton==B902SlYes[slPid] then
set B902SlAnswered[slPid]=true
set B902SlRemaining=B902SlRemaining-1
call DialogDisplay(b1060GetTriggerPlayer,B902SlDialog[slPid],false)
if B902SlRemaining==0 then
call B902SlAccept()
endif
endif
set b1060GetClickedButton=null
set b1060GetTriggerPlayer=null
endfunction
function B902SlStart takes player slRequester, integer slRequestedLimit returns nothing
local integer slIndex=0
set B902SlActive=true
set B902SlHost=slRequester
set B902SlTarget=slRequestedLimit
set B902SlOriginal=killers
set B902SlRemaining=0
loop
exitwhen slIndex>11
if Player(slIndex)!=slRequester and GetPlayerSlotState(Player(slIndex))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(slIndex))==MAP_CONTROL_USER then
set B902SlVoter[slIndex]=true
set B902SlRemaining=B902SlRemaining+1
endif
set slIndex=slIndex+1
endloop
if B902SlRemaining==0 then
call B902SlAccept()
return
endif
set B902SlClickTrigger=CreateTrigger()
call TriggerAddAction(B902SlClickTrigger,function B902SlClick)
set B902SlLeaveTrigger=CreateTrigger()
call TriggerAddAction(B902SlLeaveTrigger,function B902SlLeave)
call TriggerRegisterPlayerEvent(B902SlLeaveTrigger,slRequester,EVENT_PLAYER_LEAVE)
set B902SlTimer=CreateTimer()
call TimerStart(B902SlTimer,20.,false,function B902SlTimeout)
call VV7(bj_FORCE_ALL_PLAYERS,20.,"|cffffff00房主申请将人头上限从 "+I2S(killers)+" 调整到 "+I2S(slRequestedLimit)+"；其他在线真人须在20秒内全部同意，未投票视为不同意。投票期间仍按原上限结算。|r")
set slIndex=0
loop
exitwhen slIndex>11
if B902SlVoter[slIndex] then
set B902SlDialog[slIndex]=DialogCreate()
call DialogSetMessage(B902SlDialog[slIndex],"人头上限 "+I2S(killers)+" → "+I2S(slRequestedLimit)+"？\n20秒内选择；不投票默认不同意")
set B902SlYes[slIndex]=DialogAddButton(B902SlDialog[slIndex],"同意",0)
set B902SlNo[slIndex]=DialogAddButton(B902SlDialog[slIndex],"拒绝",0)
call TriggerRegisterDialogEvent(B902SlClickTrigger,B902SlDialog[slIndex])
call TriggerRegisterPlayerEvent(B902SlLeaveTrigger,Player(slIndex),EVENT_PLAYER_LEAVE)
call DialogDisplay(Player(slIndex),B902SlDialog[slIndex],true)
endif
set slIndex=slIndex+1
endloop
endfunction
function Func_sl takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer i
local integer n
if b1060GetTriggerPlayer!=Le or D9 then
set b1060GetTriggerPlayer=null
return
endif
if B902SlActive then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"人头数投票正在进行，请等待本次结果。")
set b1060GetTriggerPlayer=null
return
endif
if TV7(b1060GetTriggerPlayer) then
	set n=T[0]
else
	set n=T[6]
endif
if SubString(VH,0,4)=="-sl " then
set i=S2I(SubString(VH,4,StringLength(VH)))
if i>0 then
    if Bz>60. then
        if i<=killers then
            call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入错误，人头数需要大于"+I2S(killers))
		elseif i<=n then
            call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入错误，人头数需要大于已击杀数量"+I2S(n))
        else
            if i>200 then
                call B902SlStart(b1060GetTriggerPlayer,i)
                set b1060GetTriggerPlayer=null
                return
            endif
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已调整人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        endif
    else
        if i>200 then
            call B902SlStart(b1060GetTriggerPlayer,i)
            set b1060GetTriggerPlayer=null
            return
        endif
        if killers>0 then
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已调整人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        else
            set killers=i
            call VV7(bj_FORCE_ALL_PLAYERS,$A,"|cFF00FF00已开启杀戮模式，人头数为：|r|c00FF0000"+I2S(killers)+"|r  (任意一方杀完即可获胜)")
        endif
    endif
else
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入错误")
endif
endif
set b1060GetTriggerPlayer=null
endfunction
