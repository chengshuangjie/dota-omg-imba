    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复锯齿飞轮|r")
elseif id=='Ekee' or id=='Zkee' or id=='Zkef' or id=='Zkeg' then
    set t=LoadTriggerHandle(L7,(GetHandleId(u)),('A21H'))
    if t!=null then
        call UnitRemoveAbility(u,'A4FX')
        call UnitRemoveAbility(u,'A4FY')
        call UnitRemoveAbility(u,'A4FZ')
        call NM7(GetHandleId(t))
        call OZ7(t)
        call OX7(u,"AI|PulseNova")
        call RemoveSavedHandle(L7,(GetHandleId(u)),('A21H'))
        set t=null
    endif
call SuijiMode_PulseNovaCloseButtonEnd(u)
call B287_SetPlayerAbilityAvailable(p,'A21F',true)
call B287_SetPlayerAbilityAvailable(p,'A21G',true)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复脉冲新星|r")
elseif id=='N0HP' then
call B287_SetPlayerAbilityAvailable(p,'A1MI',true)
call B287_SetPlayerAbilityAvailable(p,'A2SE',true)
call SetPlayerAbilityAvailable(p,'A1MN',false)
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复冰晶爆轰|r")
elseif id=='E02I' then
	call SuijiMode_SnowballButtonEnd(u)
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复雪球|r")
elseif id=='Hblm' or id=='H06X' or id=='H06Y' or id=='H06W' then
	call SetPlayerAbilityAvailable(p,'A121',false)
	call B287_SetPlayerAbilityAvailable(p,'A085',true)
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复启明|r")
endif
set u=null
set p=null
set b1060GetTriggerPlayer=null
endfunction
function JSETSKILL takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local string VH1=SubString(VH,0,15)
local string VH2=SubString(VH,0,16)
local integer i
local integer skill
local boolean b=true
if VH1=="-setskillenable" then
    set i=S2I(SubString(VH,15,16))
    set b=true
elseif VH2=="-setskilldisable" then
    set i=S2I(SubString(VH,16,17))
    set b=false
endif
if i>5 then
    set i=i+1
endif
set skill=MHString_ToId(MHString_Replace( MHString_Sub(VH , MHString_Find(VH , "'" , 0) , StringLength(VH)) ,"'" ,"" ))
if b then
    call SetPlayerAbilityAvailable(Player(i),skill,true)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, I2S(i)+"楼启用技能 "+GetObjectName(skill))
else
    call SetPlayerAbilityAvailable(Player(i),skill,false)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, I2S(i)+"楼禁用技能 "+GetObjectName(skill))
endif
set b1060GetTriggerPlayer=null
endfunction
function DEBUG_ORDER takes nothing returns nothing
    call DisplayTextToPlayer(Player(1), 0, 0, I2S(( GetIssuedOrderId() )))
endfunction
function SHOW_XIELOU takes nothing returns nothing
call MHDebug_ShowLeakMessage()
endfunction
function SHOW_XIELOU_TRI takes nothing returns nothing
local timer t=CreateTimer()
call TimerStart(t,1.0,true,function SHOW_XIELOU)
set t=null
endfunction
