function SuijiMode_IsLunaEclipseRandomCaster takes unit suijiLunaEclipseUnit returns boolean
local integer suijiLunaEclipseHandle=0
if SUIJI_MODE==false or suijiLunaEclipseUnit==null then
return false
endif
set suijiLunaEclipseHandle=GetHandleId(suijiLunaEclipseUnit)
return OO7(suijiLunaEclipseHandle,"SuijiDone") and (OM7(suijiLunaEclipseHandle,"SuijiSmallSkill")=='A054' or OM7(suijiLunaEclipseHandle,"SuijiUltSkill")=='A054' or OM7(suijiLunaEclipseHandle,"SuijiSmallSkill")=='A00U' or OM7(suijiLunaEclipseHandle,"SuijiUltSkill")=='A00U')
endfunction
function SuijiMode_IsLunaBeamRandomCaster takes unit suijiLunaBeamUnit returns boolean
local integer suijiLunaBeamHandle=0
