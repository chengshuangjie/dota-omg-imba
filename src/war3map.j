function IsFortDefenseTypeUnit takes unit u returns boolean
	local integer i = GetUnitTypeId(u)
	return i =='umtw' or i =='ebal' or i =='u00R' or i =='e026' or i == 'n003'
endfunction
//计算伤害
function Attack_Damage takes unit attackUnit, unit targetUnit,real d returns real
	local real targetUnitArmor = GetUnitState(targetUnit, UNIT_STATE_ARMOR)
	local real reduceRatio = 1
	local real damage = d * (GetUnitState(attackUnit, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(attackUnit, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
    if d>2 then
        set damage=d
    endif
	if IsFortDefenseTypeUnit(targetUnit) then
		set damage = damage * .5
	endif
	if targetUnitArmor >= 0 then
		set reduceRatio = 0.06 * targetUnitArmor / (0.06 * targetUnitArmor + 1)
		set reduceRatio = 1 - reduceRatio
	elseif targetUnitArmor < 0 then
		set reduceRatio = 2 - Pow(1 -0.06, -targetUnitArmor)
	endif
	set damage = damage * reduceRatio
	if IsUnitIllusion(targetUnit) then
		set damage = damage * GetIllusionUnitData(targetUnit)
	endif
	return damage
endfunction
//计算攻速
function Attack_Speed takes unit u returns real
	local real cool=GetUnitState(u, UNIT_STATE_ATTACK1_COOL)
	local real speed=RMinBJ(GetUnitState(u, UNIT_STATE_ATTACK1_SPEED),5)
	local real d=cool/speed
	return d
endfunction
//设置单位移动方式
function SetUnitPathingEx takes unit u,boolean flag returns nothing
    local integer h= GetHandleId(u)
    local boolean infestPath1054=LoadInteger(L7,h,4310)==1 and LoadBoolean(L7,h,StringHash("SuijiDogInfestMoveOwned"))
    // The contained caster remains live/castable; other movement cleanup
    // must not return it to collision while Infest owns containment.
    // B968: remember other effects' latest request while scripted flight owns terrain traversal.
    if LoadBoolean(L7,h,StringHash("B968FlightPath")) then
        call SaveBoolean(L7,h,StringHash("B968FlightResumePathing"),flag)
        set flag=false
    endif
    if infestPath1054 then
        set flag=false
    endif
    if flag and LoadBoolean(UnitDataHashTable, h, UNIT_PATHING) then
        if IsUnitType(u, UNIT_TYPE_FLYING) then
            call MHUnit_SetPathType(u , UNIT_PATH_TYPE_FLY)
            call MHUnit_SetCollisionType(u , UNIT_COLLISION_TYPE_AIR , UNIT_COLLISION_TYPE_NONE)
        elseif IsUnitType(u, UNIT_TYPE_GROUND) then
            call MHUnit_SetPathType(u , UNIT_PATH_TYPE_FOOT)
            call MHUnit_SetCollisionType(u , UNIT_COLLISION_TYPE_FOOT , UNIT_COLLISION_TYPE_GROUND)
        endif
        call RemoveSavedBoolean(UnitDataHashTable, h, UNIT_PATHING)
        call SetUnitPathing(u, true)
        //保持原有的相位状态
        if GetUnitAbilityLevel( u, 'B09Y' )>0 or HaveSavedHandle(TABLE_HY, GetHandleId(u),'A05C') or HaveSavedHandle(TABLE_HY, GetHandleId(u),'A4HS') or HaveSavedHandle(TABLE_HY, GetHandleId(u),'A4IE') or LoadInteger(L7,GetHandleId(u),'BFLY')>0 then
            call SetUnitPhaseMove( u, true )
        endif
    elseif not flag and (not LoadBoolean(UnitDataHashTable, h, UNIT_PATHING) or infestPath1054) then
        call MHUnit_SetPathType(u , UNIT_PATH_TYPE_FLY)
        call MHUnit_SetCollisionType(u , UNIT_COLLISION_TYPE_AIR , UNIT_COLLISION_TYPE_NONE)
        call SaveBoolean(UnitDataHashTable, h, UNIT_PATHING, true)
        call SetUnitPathing(u, false)
    endif
endfunction
function FlushUnitData takes unit whichUnit returns nothing
    if whichUnit == null then
        return
    endif
    call FlushChildHashtable(UnitDataHashTable, GetHandleId(whichUnit))
endfunction
//飞行英雄单位
function KCD takes unit u returns boolean
local integer id=GetUnitTypeId(u)
if id=='H10G' or id=='O017' or id=='Udrf' then //龙骑 蝙蝠 夜魔
    return true 
elseif id=='N0MB' or id=='N0MC' or id=='N0MO' or id=='N0MA' or id=='N1MB' or id=='N1MC' or id=='N1MO' or id=='N1MA' then //冰龙
    return true
endif
    return false
endfunction
//-------------------------------------------------------------------------------
function JJY takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string chat = StringCase(GetEventPlayerChatString(),false)
local integer id
local player target_player
local integer player_id
local string name
if SubString(chat, 0, 4) != "-jy " then
set b1060GetTriggerPlayer=null
return
endif
set id = S2I(SubString(chat, 4, StringLength(chat)))
if id <= 0 or id > 10  then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00请指定一个楼层为[1-10]的有效玩家|r")
set b1060GetTriggerPlayer=null
return
endif
if id <= 5 then
set target_player = Z7[id]
else
set target_player = A7[id - 5]
endif
if target_player == null or GetPlayerSlotState(target_player)!=PLAYER_SLOT_STATE_PLAYING then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00请指定一个楼层为[1-10]的有效玩家|r")
set b1060GetTriggerPlayer=null
return
endif
set name = GetPlayerName(target_player)
if b1060GetTriggerPlayer == GetLocalPlayer() then
set player_id = GetPlayerId(target_player)
set HAS_JY[player_id] = not HAS_JY[player_id]
if HAS_JY[player_id] then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00你将不会再看到 " + name + " 的发言。再次输入该指令取消。（你依然可以在聊天记录里看到他的发言。）|r")
set WJMC[player_id] = name
set name = jy_temp_string + name
else
//set name = SubString(GetPlayerName(target_player), 200, StringLength(GetPlayerName(target_player)))
set name = WJMC[player_id]
set WJMC[player_id] = null
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00你现在可以看到 " + name + " 的发言了。|r")
endif
endif
call SetPlayerName(target_player, name)
set target_player = null
set b1060GetTriggerPlayer=null
endfunction
function JJYALL takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string chat = StringCase(GetEventPlayerChatString(),false)
local integer id
local player target_player
local integer player_id
local string name
local boolean jyallts=false
if chat != "-jyall" then
set b1060GetTriggerPlayer=null
return
endif
set id=1
loop
exitwhen id>11
if id <= 5 then
set target_player = Z7[id]
else
set target_player = A7[id - 5]
endif
if target_player != null then
set name = GetPlayerName(target_player)
if b1060GetTriggerPlayer == GetLocalPlayer() then
set player_id = GetPlayerId(target_player)
set HAS_JY[player_id] = not HAS_JY[player_id]
if HAS_JY[player_id] then
set jyallts=true
set WJMC[player_id] = name
set name = jy_temp_string + name
else
//set name = SubString(GetPlayerName(target_player), 200, StringLength(GetPlayerName(target_player)))
set name = WJMC[player_id]
set WJMC[player_id] = null
endif
endif
call SetPlayerName(target_player, name)
endif
set id=id+1
endloop
if jyallts then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00你将不会再看到所有人的发言。再次输入该指令取消。（你依然可以在聊天记录里看到所有人的发言。）|r")
else
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer, 0, 0, 10, "|cffffcc00你现在可以看到所有人的发言了。|r")
endif
set target_player = null
set b1060GetTriggerPlayer=null
endfunction
function InitializeJY takes nothing returns nothing
local trigger trg
local integer i = 0
set trg = CreateTrigger()
loop
call TriggerRegisterPlayerChatEvent(trg, Player(i), "-JY ", false)
set i = i + 1
exitwhen i > 15
endloop
call TriggerAddCondition(trg, Condition(function JJY))
set trg = null
set trg = CreateTrigger()
set i=0
loop
call TriggerRegisterPlayerChatEvent(trg, Player(i), "-JYALL", false)
set i = i + 1
exitwhen i > 15
endloop
call TriggerAddCondition(trg, Condition(function JJYALL))
set trg = null
set i = 1
loop
set jy_temp_string = jy_temp_string + "|r"
set i = i + 1
exitwhen i > 100
endloop
endfunction
//单位经验值
function EEG takes integer BC7 returns integer
if BC7==1 then
return 25
elseif BC7==2 then
return 41
elseif BC7==3 then
return 62
elseif BC7==4 then
return 88
elseif BC7==5 then
return 119
elseif BC7==6 then
return 155
endif
return 25
endfunction
function GetLastEnumedGroup takes nothing returns group
return HQ7
endfunction
function R7i takes nothing returns nothing
local timer t=GetExpiredTimer()
set R6A=false
call FlushChildHashtable(L7,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function R7j takes real r returns nothing
if R7k==null then
set R7k=CreateTimer()
endif
if r>TimerGetRemaining(R7k)then
call TimerStart(R7k,r,false,function R7i)
endif
set R6A=true
endfunction
function Xav takes nothing returns nothing
local timer t=GetExpiredTimer()
call UnitRemoveAbility(LoadUnitHandle(L7,GetHandleId(t),0),'BEim')
call FlushChildHashtable(L7,GetHandleId(t))
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function Xnv takes nothing returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,GetTriggerUnit())
call TimerStart(t,0,false,function Xav)
set t=null
endfunction
function SuijiMode_ShackleRemoveChainBuffs takes unit u returns nothing
if u==null then
return
endif
call UnitRemoveAbility(u,'B090')
call UnitRemoveAbility(u,'B008')
call UnitRemoveAbility(u,'B108')
call UnitRemoveAbility(u,'B208')
call UnitRemoveAbility(u,'Bmlc')
call UnitRemoveAbility(u,'Bmlt')
endfunction
function R3A takes unit u returns nothing
call SuijiMode_ShackleRemoveChainBuffs(u)
if LoadReal(L7,GetHandleId(u),'Abtb')+$C<TimerGetElapsed(W)then
call UnitRemoveAbility(u,'Bdet')
endif
endfunction
function SuijiMode_ShackleBuffCleanupTick takes nothing returns nothing
local timer suijiShackleCleanupTimer=GetExpiredTimer()
local integer suijiShackleCleanupHandle=GetHandleId(suijiShackleCleanupTimer)
local unit suijiShackleCleanupTarget=LoadUnitHandle(L7,suijiShackleCleanupHandle,0)
local unit suijiShackleCleanupCaster=LoadUnitHandle(L7,suijiShackleCleanupHandle,2)
local integer suijiShackleCleanupLeft=LoadInteger(L7,suijiShackleCleanupHandle,1)-1
if suijiShackleCleanupTarget!=null then
call R3A(suijiShackleCleanupTarget)
endif
if suijiShackleCleanupCaster!=null then
call SuijiMode_ShackleRemoveChainBuffs(suijiShackleCleanupCaster)
endif
if suijiShackleCleanupLeft<=0 or suijiShackleCleanupTarget==null or GetWidgetLife(suijiShackleCleanupTarget)<=.405 then
call FlushChildHashtable(L7,suijiShackleCleanupHandle)
call PauseTimer(suijiShackleCleanupTimer)
call DestroyTimer(suijiShackleCleanupTimer)
else
call SaveInteger(L7,suijiShackleCleanupHandle,1,suijiShackleCleanupLeft)
endif
set suijiShackleCleanupTarget=null
set suijiShackleCleanupCaster=null
set suijiShackleCleanupTimer=null
endfunction
function SuijiMode_ShackleScheduleCleanup takes unit suijiShackleCleanupTarget,unit suijiShackleCleanupCaster returns nothing
local timer suijiShackleCleanupTimer=CreateTimer()
local integer suijiShackleCleanupHandle=GetHandleId(suijiShackleCleanupTimer)
call SaveUnitHandle(L7,suijiShackleCleanupHandle,0,suijiShackleCleanupTarget)
call SaveUnitHandle(L7,suijiShackleCleanupHandle,2,suijiShackleCleanupCaster)
call SaveInteger(L7,suijiShackleCleanupHandle,1,8)
call R3A(suijiShackleCleanupTarget)
if suijiShackleCleanupCaster!=null then
call SuijiMode_ShackleRemoveChainBuffs(suijiShackleCleanupCaster)
endif
call TimerStart(suijiShackleCleanupTimer,.15,true,function SuijiMode_ShackleBuffCleanupTick)
set suijiShackleCleanupTimer=null
endfunction
function R1X takes integer suijiRegisterHeroTypeId,integer a11,integer a22,integer a33,integer a44,integer a55 returns nothing
call SaveInteger(R1Y,suijiRegisterHeroTypeId,1,a11)
call SaveInteger(R1Y,suijiRegisterHeroTypeId,2,a22)
call SaveInteger(R1Y,suijiRegisterHeroTypeId,3,a33)
call SaveInteger(R1Y,suijiRegisterHeroTypeId,4,a44)
call SaveInteger(R1Y,suijiRegisterHeroTypeId,5,a55)
endfunction
