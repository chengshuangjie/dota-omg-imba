function OmgDeleteSkill_IsProtectedAbility takes integer abilityId returns boolean
return abilityId==0 or abilityId=='Amov' or abilityId=='Aatk' or abilityId=='AInv' or abilityId=='AHer' or abilityId=='Aneu' or abilityId=='Asud' or abilityId=='Asel' or abilityId=='Aloc' or abilityId=='Aeth' or abilityId=='Aall'
endfunction
function OmgDeleteSkill_ClearRandomSlot takes unit u,string mark returns integer
local integer h=GetHandleId(u)
local integer logicalSkill=OM7(h,mark+"Skill")
local integer physicalSkill=OM7(h,mark+"Ability")
if logicalSkill==0 then
set mark=""
return 0
endif
if physicalSkill==0 then
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
endif
// Deleting Infest while contained must close the script-owned lifecycle
// before its physical button disappears; otherwise invulnerability, pathing,
// host helpers and the per-instance trigger can survive the removed skill.
if (logicalSkill=='A0SW' or logicalSkill=='A4FR') and LoadInteger(L7,h,4310)==1 then
call SuijiMode_DogInfestForceCleanup(u)
endif
if logicalSkill=='A0BE' then
call SuijiMode_RestoreScriptedBerserkerBase(u)
endif
if logicalSkill=='A0VC' or logicalSkill=='A029' or logicalSkill=='A21L' then
call KKPassiveControllerStop(u,logicalSkill)
endif
if physicalSkill!=0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
call UnitRemoveAbility(u,physicalSkill)
endif
if logicalSkill!=physicalSkill and GetUnitAbilityLevel(u,logicalSkill)>0 and SuijiMode_IsNativeRegisteredSkill(u,logicalSkill)==false then
call UnitRemoveAbility(u,logicalSkill)
endif
call NP7(h,mark+"Skill",0)
call NP7(h,mark+"Ability",0)
call NP7(h,mark+"Helper",0)
call NP7(h,mark+"Source",0)
call NP7(h,mark+"SourceType",0)
call NR7(h,mark+"Order","")
call NS7(h,"SuijiAghForceUpdate",true)
call SuijiMode_ForcePassiveOrbs(u)
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_CleanupUnexpectedPoolSkills(u)
call SuijiMode_MarkUnitVisibilityDirty(u)
set mark=""
return logicalSkill
endfunction
function OmgDeleteSkill_OnSync takes nothing returns nothing
local player p=DzGetTriggerSyncPlayer()
local integer pid=GetPlayerId(p)
local unit u=M7[pid]
local integer selectedSkill=S2I(DzGetTriggerSyncData())
local integer logicalSkill=SuijiMode_ToOriginalSkill(selectedSkill)
local integer h=0
local integer removedSkill=0
local string removedName=""
if LoadBoolean(L7,StringHash("OmgDeleteSkillPending"),pid)==false then
set u=null
set p=null
return
endif
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 or GetOwningPlayer(u)!=p then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00删除技能：主英雄状态无效，请稍后重新点击技能栏。|r")
set u=null
set p=null
return
endif
set h=GetHandleId(u)
if selectedSkill==OM7(h,"SuijiSmallAbility") or logicalSkill==OM7(h,"SuijiSmallSkill") then
set removedSkill=OmgDeleteSkill_ClearRandomSlot(u,"SuijiSmall")
elseif selectedSkill==OM7(h,"SuijiUltAbility") or logicalSkill==OM7(h,"SuijiUltSkill") then
set removedSkill=OmgDeleteSkill_ClearRandomSlot(u,"SuijiUlt")
elseif OmgDeleteSkill_IsProtectedAbility(selectedSkill) then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00删除技能：该按钮属于英雄基础命令，不能删除，请重新选择技能。|r")
elseif GetUnitAbilityLevel(u,selectedSkill)<=0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00删除技能：英雄当前没有该技能，请重新选择。|r")
else
set removedSkill=selectedSkill
if logicalSkill=='A0VC' or logicalSkill=='A029' or logicalSkill=='A21L' then
call KKPassiveControllerStop(u,logicalSkill)
endif
call UnitRemoveAbility(u,selectedSkill)
call NS7(h,"SuijiAghForceUpdate",true)
call SuijiMode_UpdateAghSkills(u)
call SuijiMode_MarkUnitVisibilityDirty(u)
endif
if removedSkill!=0 then
set removedName=GetAbilityName(removedSkill)
if removedName==null or removedName=="" then
set removedName="指定技能"
endif
call RemoveSavedBoolean(L7,StringHash("OmgDeleteSkillPending"),pid)
call DisplayTimedTextToPlayer(p,0,0,12.,"|cFF00FF00删除技能：已删除 |cFFFFCC00"+removedName+"|r|cFF00FF00。|r")
endif
set removedName=""
set u=null
set p=null
endfunction
