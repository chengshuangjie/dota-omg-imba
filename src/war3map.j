function Query_Use_Group takes player p returns nothing
local integer i=0
local integer n=0
loop
exitwhen i>=240
if TM4[i]==true then
    set n=n+1
endif
set i=i+1
endloop
call DisplayTextToPlayer(p,0,0,"|c00FF8000公共组占用：|r"+I2S(n)+" |c0080FFFF剧毒新星：|r"+I2S(B661_POISON_NOVA_ACTIVE)+" |c0080FFFF潮汐毁灭：|r"+I2S(B661_TIDE_RAVAGE_ACTIVE)+" |c0080FFFF死灵龙长期组：|r"+I2S(B661_VISAGE_LONG_GROUP_ACTIVE))
endfunction
function WR7 takes group g returns nothing
local integer i=-1
if g==null then
return
endif
set i=LoadInteger(L7,GetHandleId(g),StringHash("B661GroupPoolIndex"))-1
if i<0 or i>=240 or TN4[i]!=g then
set TQ4=true
    if KBAI then
        call DisplayTextToPlayer(Player(KBAIID),0,0, "|c00FF0000WR7 TQ4 true，i值"+I2S(i)+"|r")
    endif
call DestroyGroup(g)
else
call GroupClear(g)
if TM4[i] then
set TM4[i]=false
set TP4=i
endif
endif
endfunction
function WS7 takes nothing returns group
local integer i=TP4
local integer scanned=0
loop
exitwhen scanned>=240
if TM4[i]==false then
set TP4=i+1
if TP4==240 then
set TP4=0
endif
set TM4[i]=true
return TN4[i]
endif
set scanned=scanned+1
set i=i+1
if i==240 then
set i=0
endif
endloop
if GroupErrorLog<10 then
set GroupErrorLog=GroupErrorLog+1
call WP7(L8,5.,"|c00ff0303错误：找不到可用组|r")
endif
return CreateGroup()
endfunction
function WT7 takes real WU7,real dx,real dy,real Vx,real Vy returns real
local real a
local real b
local real d
set a=WU7*WU7-Vx*Vx-Vy*Vy
set b=Vx*dx+Vy*dy
if a==0 then
if b>0 then
return .0
endif
return(dx*dx+dy*dy)/2/b
endif
set d=b*b+a*(dx*dx+dy*dy)
if d<0 then
return .0
endif
set d=SquareRoot(d)
if b<d then
return(b+d)/a
endif
return(b-d)/a
endfunction
function WV7 takes real x,real y returns boolean
return( not(x<GetRectMinX(bj_mapInitialPlayableArea)+75))and( not(x>GetRectMaxX(bj_mapInitialPlayableArea)-75))and( not(y<GetRectMinY(bj_mapInitialPlayableArea)+75))and( not(y>GetRectMaxY(bj_mapInitialPlayableArea)-75))
endfunction
function WW7 takes unit WX7,unit IH7,real X,real Y,real r,boolexpr HV7 returns boolean
local group g=WS7()
local real Hx=GetUnitX(WX7)
local real Hy=GetUnitY(WX7)
local player p=GetOwningPlayer(WX7)
local real dx=(X-Hx)*.5
local real dy=(Y-Hy)*.5
local real R=SquareRoot(dx*dx+dy*dy)
local unit u
local real d
local real WY7=99999.
local real WZ7=.0
local real KD7
call GroupEnumUnitsInRange(g,Hx+dx,Hy+dy,R,HV7)
set bj_lastReplacedUnit=null
set bj_lastLoadedUnit=null
set bj_forLoopAIndex=0
loop
set u=FirstOfGroup(g)
exitwhen u==null
call GroupRemoveUnit(g,u)
set d=((GetUnitX(u)-Hx)*dy-(GetUnitY(u)-Hy)*dx)/R
if u!=WX7 and u!=IH7 and IsUnitVisible(u,p)and d*d<=r*r then
set KD7=KE7(WX7,u)
if KD7<WY7 then
set WY7=KD7
set bj_lastReplacedUnit=u
endif
if KD7>WZ7 then
set WZ7=KD7
set bj_lastLoadedUnit=u
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endif
endloop
call WR7(g)
set g=null
set p=null
return bj_forLoopAIndex==0
endfunction
function WA7 takes unit WX7,unit IH7,real WU7,real WB7,real R57 returns location
local real dt=TimerGetElapsed(W)
local real X
local real Y
local real dx=GetUnitX(IH7)
local real dy=GetUnitY(IH7)
if WX7==null or IH7==null or not UnitAlive(WX7) or not UnitAlive(IH7) then
return null
endif
call J_7(.1)
if not UnitAlive(WX7) or not UnitAlive(IH7) then
return null
endif
set dt=TimerGetElapsed(W)-dt
if dt<=0. then
return null
endif
set X=GetUnitX(IH7)
set Y=GetUnitY(IH7)
if X==dx and Y==dy then
call MoveLocation(DH7,X,Y)
return DH7
endif
set dx=(X-dx)/dt
set dy=(Y-dy)/dt
set dt=WT7(WU7,X+dx*WB7-GetUnitX(WX7),Y+dy*WB7-GetUnitY(WX7),dx,dy)
if dt==0 then
return null
endif
call MoveLocation(DH7,X+dx*(dt+WB7),Y+dy*(dt+WB7))
if WV7(GetLocationX(DH7),GetLocationY(DH7))then
return DH7
endif
return null
endfunction
function WC7 takes unit I_7,unit MD7,real W37,real R57 returns location
local real P27=GetUnitX(MD7)
local real P_7=GetUnitY(MD7)
local real W67=TimerGetElapsed(W)
local real WL7=0
local real W17=0
if I_7==null or MD7==null or not UnitAlive(I_7) or not UnitAlive(MD7) then
return null
endif
call J_7(.1)
if not UnitAlive(I_7) or not UnitAlive(MD7) then
return null
endif
set W67=TimerGetElapsed(W)-W67
if W67<=0. then
return null
endif
set W67=1./W67
set WL7=(GetUnitX(MD7)-P27)*W67
set W17=(GetUnitY(MD7)-P_7)*W67
if not(WL7==0 and W17==0)then
set P27=P27+WL7*W37
set P_7=P_7+W17*W37
endif
if KF7(GetUnitX(I_7),GetUnitY(I_7),P27,P_7)<=R57 then
call MoveLocation(DH7,P27,P_7)
if WV7(GetLocationX(DH7),GetLocationY(DH7))then
return DH7
endif
endif
return null
endfunction
function W07 takes location O07,real W57,real W27 returns location
local real x=GetLocationX(O07)+W57*Cos(W27*bj_DEGTORAD)
local real y=GetLocationY(O07)+W57*Sin(W27*bj_DEGTORAD)
call MoveLocation(HA,x,y)
return HA
endfunction
function W_7 takes nothing returns boolean
