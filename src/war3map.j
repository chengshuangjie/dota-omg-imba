set BC7=B287_GetUnitAbilityLevel(ZX7,'A21G')
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A21F')==false then
if BC7==1 then
set Y94=100
elseif BC7==2 then
set Y94=130
else
set Y94=160
endif
else
if BC7==1 then
set Y94=160
elseif BC7==2 then
set Y94=190
else
set Y94=220
endif
