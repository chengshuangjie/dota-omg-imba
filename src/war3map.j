function F92_70 takes nothing returns nothing
local unit ZX7=IN4
local unit IH7=GetEnumUnit()
local integer level=0
local real d=0
local real TotalDamge=0
local real damage=0
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
set ZX7=null
set IH7=null
return
endif
set level=GetUnitAbilityLevel(ZX7,'A4CO')
set d=1.2+.2*level
set TotalDamge=(GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS)) * d
set damage=Attack_Damage(ZX7,IH7,d)
call CommonUnitAddStun(IH7, 0.5*level, false)
call B67(ZX7,IH7,2,TotalDamge)
if GetUnitAbilityLevel(ZX7,'A4CU')>0 then
    call JinguMastery_reduce(ZX7,IH7,damage,false)
elseif IsUnitType(IH7,UNIT_TYPE_HERO) then
    call JinguMastery_add(ZX7,IH7)
endif
set ZX7=null
set IH7=null
endfunction
function FA2_70 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer i=0
local real XGI=0
local real XHI=0
local real a=0
local real XZI=0
local real XVI=0
local real x
local real y
local group g=null
local group g2=null
local boolean b=false
local integer length=10
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set XGI=GetUnitX(ZX7)
set XHI=GetUnitY(ZX7)
set a=AngleBetweenXY(XGI,XHI,GetSpellTargetX(),GetSpellTargetY())
set XZI=XGI+1*Cos(a*bj_DEGTORAD)
set XVI=XHI+1*Sin(a*bj_DEGTORAD)
set g=WS7()
set g2=WS7()
if MV7(ZX7,ZU[E2])!=null then
    set length=20
endif
if GetUnitAbilityLevel(ZX7,'A2YK')>0 then
set length=length+2
elseif GetUnitAbilityLevel(ZX7,'A2YJ')>0 then
set length=length+1
endif
call KillUnit(CreateUnit(GetOwningPlayer(ZX7),'h0GN',XGI,XHI,a))
loop
exitwhen i>length
set x=CoordinateX50(XGI+i*100*Cos(a*bj_DEGTORAD))
set y=CoordinateY50(XHI+i*100*Sin(a*bj_DEGTORAD))
set IN4=ZX7
call GroupEnumUnitsInRange(g2,x,y,150,Condition(function AJ7_gai))
call GroupAddGroup(g2,g)
call GroupClear(g2)
call DestroyEffect(AddSpecialEffect("tx\\qtds\\HeroMonkeyking_Q_blast.mdl",x,y))
set i=i+1
endloop
if GetUnitAbilityLevel(ZX7,'A4CU')>0 then
    set b=true
endif
set IN4=ZX7
call ForGroup(g,function F92_70)
call WR7(g)
call WR7(g2)
if b then
    call JinguMastery_reduce(ZX7,ZX7,0,true)
endif
set ZX7=null
set g=null
set g2=null
endfunction
function FB2_70 takes nothing returns boolean
if B287_GetSpellAbilityId()=='A4CO' then
call FA2_70()
endif
return false
endfunction
