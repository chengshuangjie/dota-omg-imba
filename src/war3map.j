call O37(u,"LUNZ",.1)
call XF7(u,'A2SI')
call SetUnitAbilityLevel(u,'A2SI',GetUnitAbilityLevel(u,'A2E5')+GetUnitAbilityLevel(u,'A2SH'))
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2SI',true)
endif
