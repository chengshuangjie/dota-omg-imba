function RC8 takes nothing returns boolean
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if oz or IsUnitAlly(GetTriggerUnit(),GetOwningPlayer(GetEventDamageSource())) then
set JY=JY+GetEventDamage()
else
if IsUnitIllusion(GetEventDamageSource()) then
call SetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE,GetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE)+.9*GetEventDamage())
endif
endif
else
call OZ7(b1060GetTriggeringTrigger)
endif
set b1060ReturnValue=false
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
