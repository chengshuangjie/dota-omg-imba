function AYTX_TRI takes nothing returns nothing
local unit ZX7 = U22
local unit IH7 = W22
local integer h = GetHandleId(GetTriggeringTrigger())
local integer level = LoadInteger(TABLE_HY, h, 10)
local boolean b = LoadBoolean(TABLE_HY, h, 100)
local integer durationCount = LoadInteger(TABLE_HY, h, 101)
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
if durationCount<=0 then
set durationCount=1
endif
call UnitApplyTimedLife(BB7,'BTLF',1.)
if b and GetUnitAbilityLevel(IH7,'BEsh')>0 then
call XF7(BB7,'A04A')
call SetUnitAbilityLevel(BB7,'A04A',level)
call B947IssueImmediateOrderById("AYTX_TRI @ war3map.j:116964 (B968)",BB7,$D022E)
endif
call XF7(BB7,'A4FD')
call SetUnitAbilityLevel(BB7,'A4FD',level)
call B947IssueTargetOrderById("AYTX_TRI @ war3map.j:116968 (B968)",BB7,$D022F,IH7)
call SuijiMode_ScheduleDurationBuff(IH7,'BEsh',0,15.*durationCount)
if b then
    call LINGXIA(ZX7,IH7)
endif
set ZX7=null
set IH7=null
set BB7=null
endfunction
