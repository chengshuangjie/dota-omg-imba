set TpSlotCastRequestSerial[tp1120Player]=0
set TpSlotCastRequestUnit[tp1120Player]=null
set TpSlotCastRequestUntil[tp1120Player]=0.
set TpSlotCastMode[tp1120Player]=0
set TpSlotForcedTarget[tp1120Player]=null
set TpSlotCastX[tp1120Player]=0.
set TpSlotCastY[tp1120Player]=0.
endfunction
function tp_texttag takes nothing returns nothing
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit tri_u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer id = GetPlayerId(GetOwningPlayer(tri_u))
	local real tp_second = LoadReal(TABLE_HY, h, 0)
	local real tri_ec = GetTriggerEvalCount(t)* .5 -0.5
	local texttag tt
	if (GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST and not (B287_GetSpellAbilityId()=='A4T0' and TpSlotChannelActive[id] and TpSlotPreserveChannel[id] and not TpSlotStopRequested[id] and GetWidgetLife(tri_u)>.405)) or tri_ec >= tp_second then
		call FlushChildHashtable(TABLE_HY, h)
		call OZ7(t)
        if GetLocalPlayer()==GetOwningPlayer(tri_u) then
            call OX7(tri_u,"DISRB")
        endif
	else
		set tt = CreateTextTag()
		call SetTextTagText(tt, R2SW(tp_second -tri_ec, 1, 1), .03)
		call SetTextTagPosUnit(tt, tri_u, 0)
		call SetTextTagColorBJ(tt, 0, 60, 200, 0)
		call SetTextTagVelocity(tt, 0, .035)
		call SetTextTagFadepoint(tt, 3)
		call SetTextTagLifespan(tt, .5)
		call SetTextTagPermanent(tt, false)
		call SetTextTagVisibility(tt, IsUnitAlly(tri_u, GetLocalPlayer()) or WG7(GetLocalPlayer()))
	endif
	set tt = null
	set t = null
	set tri_u = null
endfunction
function B0F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=(LoadUnitHandle(L7,(OB7),($E)))
local real x=(LoadReal(L7,(OB7),(6)))
local real y=(LoadReal(L7,(OB7),(7)))
local unit B5F=null
local unit B2F=(LoadUnitHandle(L7,(OB7),(447)))
local ubersplat B_F=(LoadUbersplatHandle(L7,(OB7),($83)))
local integer U38=(LoadInteger(L7,(OB7),(34)))
local real Z27=(LoadReal(L7,(OB7),(57)))
local real CP7=ON7(OB7,"OriginalTime")
local integer id=GetPlayerId(GetOwningPlayer(WI7))
local boolean C4F=false
// The dedicated-slot stop flag may remain set after hero death.  It must not
// cancel a later inventory TP or Boots of Travel cast.
local boolean tpSlotCancel=TpSlotChannelActive[id] and TpSlotStopRequested[id]
if HaveSavedHandle(L7,(OB7),(448)) then
set B5F=LoadUnitHandle(L7,(OB7),(448))
endif
if GetTriggerEventId()==EVENT_UNIT_SPELL_ENDCAST then
// The inventory TP channel can end just before its simultaneous three-second
// scripted timer.  Complete only in the final engine ticks; real early stops,
// disables and caster death still cancel normally.
if (B287_GetSpellAbilityId()=='A1R5' or B287_GetSpellAbilityId()=='A137') and TimerGetElapsed(W)-CP7>=Z27-.15 and GetWidgetLife(WI7)>.405 then
set U38=2
set C4F=true
elseif B287_GetSpellAbilityId()=='A4T0' then
if not TpSlotChannelActive[id] or not TpSlotPreserveChannel[id] or TpSlotStopRequested[id] or GetWidgetLife(WI7)<=.405 then
set C4F=true
endif
elseif B287_GetSpellAbilityId()=='A1R5' or B287_GetSpellAbilityId()=='A137' then
set C4F=true
endif
else
if TpSlotStopRequested[id] then
set C4F=true
else
set U38=U38+1
call SaveInteger(L7,(OB7),(34),(U38))
if U38==1 then
if Z27>3 then
    if B5F!=null then
        call SetUnitAnimationByIndex(B5F,1)
    endif
call SetUnitAnimationByIndex(B2F,1)
endif
elseif U38==2 then
set C4F=true
endif
endif
endif
if C4F then
call DisableTrigger(t)
if TpSlotChannelActive[id] and WI7==M7[id] then
set TpSlotChannelActive[id]=false
set TpSlotStopRequested[id]=false
set TpSlotOrderGuard[id]=false
set TpSlotPreserveChannel[id]=false
endif
call SaveInteger(L7,(GetHandleId((WI7))),((4256)),(2))
    if B5F!=null then
        call KillUnit(B5F)
    endif
call KillUnit(B2F)
call DestroyEffect((LoadEffectHandle(L7,(OB7),($AF))))
call DestroyEffect((LoadEffectHandle(L7,(OB7),($B0))))
call DestroyUbersplat(B_F)
if GetLocalPlayer()==GetOwningPlayer(WI7) then
	call OX7(WI7,"DISRB")
endif
if U38==2 and not tpSlotCancel then
if SPEPLAYER[id]==0 then
call DestroyEffect(AddSpecialEffect(BAF(id),GetUnitX(WI7),GetUnitY(WI7)))
call DestroyEffect(AddSpecialEffect(BZF(id),x,y))
endif
call SetUnitX(WI7,x)
call SetUnitY(WI7,y)
call TpSlot_TraceController(t,WI7,"tp-pause-before")
call PauseUnit(WI7,true)
call PauseUnit(WI7,false)
call TpSlot_TraceController(t,WI7,"tp-pause-after")
if SPEPLAYER[id]>0 then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_Goods_TP_Target_effect(3).mdl",GetUnitX(WI7),GetUnitY(WI7)))
endif
call Y67(x,y,$F0)
endif
call TpSlot_ReleaseController(t)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
endif
set hq[832+GetPlayerId(GetOwningPlayer(WI7))]=0
set t=null
set WI7=null
set B5F=null
set B2F=null
set B_F=null
return false
endfunction
function C8F takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit WX7=(LoadUnitHandle(L7,(I97),($E)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real x=(LoadReal(L7,(I97),(6)))
local real y=(LoadReal(L7,(I97),(7)))
local unit C9F=(LoadUnitHandle(L7,(I97),(448)))
local unit CDF=(LoadUnitHandle(L7,(I97),(447)))
local ubersplat ML9=(LoadUbersplatHandle(L7,(I97),($83)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
local real BZ7=(LoadReal(L7,(I97),(57)))
local real VM8=(LoadReal(L7,(I97),(442)))
local integer id=GetPlayerId(GetOwningPlayer(WX7))
// The dedicated-slot stop flag may remain set after hero death.  It must not
// cancel a later inventory Boots of Travel cast.
local boolean tpSlotCancel=TpSlotChannelActive[id] and TpSlotStopRequested[id]
local boolean travelEndComplete=false
local boolean tp1120Closing=false
// The native Boots of Travel channel and this scripted completion timer both
// expire at three seconds.  Treat a valid endcast in the final engine ticks as
// completion so A231/A2Q6 cannot clean up the trigger just before it teleports.
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and (B287_GetSpellAbilityId()=='A231' or B287_GetSpellAbilityId()=='A2Q6') and TimerGetElapsed(W)-VM8>=BZ7-.15 and GetWidgetLife(WX7)>.405 and IH7!=null and GetUnitTypeId(IH7)!=0 and GetWidgetLife(IH7)>.405 then
set travelEndComplete=true
endif
if b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and not travelEndComplete then
if B287_GetSpellAbilityId()=='A231' or B287_GetSpellAbilityId()=='A2Q6' or (B287_GetSpellAbilityId()=='A4T0' and (not TpSlotChannelActive[id] or not TpSlotPreserveChannel[id] or TpSlotStopRequested[id] or GetWidgetLife(WX7)<=.405)) then
set tp1120Closing=true
call DisableTrigger(t)
if B287_GetSpellAbilityId()=='A4T0' then
set TpSlotChannelActive[id]=false
set TpSlotStopRequested[id]=false
set TpSlotOrderGuard[id]=false
set TpSlotPreserveChannel[id]=false
endif
call DestroyEffect((LoadEffectHandle(L7,(I97),($AF))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B1))))
call UnitRemoveAbility(WX7,'A4ML')
call UnitRemoveAbility(WX7,'A4MM')
call UnitRemoveAbility(IH7,'A4ML')
call UnitRemoveAbility(IH7,'A4MO')
call SaveInteger(L7,(GetHandleId((WX7))),((4256)),(2))
call KillUnit(C9F)
call KillUnit(CDF)
call DestroyUbersplat(ML9)
call UnitRemoveType(IH7,UNIT_TYPE_PEON)
if B946DetectCount>0 then
set h8[$B0+id]=B960H8($B0+id,null,"C8F @ war3map.j:172099 (B968)")
else
set h8[$B0+id]=null
endif
if GetLocalPlayer()==GetOwningPlayer(WX7) then
	call OX7(WX7,"DISRB")
endif
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH then
set tp1120Closing=true
call DisableTrigger(t)
if TpSlotChannelActive[id] and WX7==M7[id] then
set TpSlotChannelActive[id]=false
set TpSlotStopRequested[id]=false
set TpSlotOrderGuard[id]=false
set TpSlotPreserveChannel[id]=false
endif
call DestroyEffect((LoadEffectHandle(L7,(I97),($AF))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B1))))
call UnitRemoveAbility(WX7,'A4ML')
call UnitRemoveAbility(WX7,'A4MM')
call UnitRemoveAbility(IH7,'A4ML')
call UnitRemoveAbility(IH7,'A4MO')
call UnitRemoveType(IH7,UNIT_TYPE_PEON)
call SaveInteger(L7,(GetHandleId((WX7))),((4256)),(2))
call KillUnit(C9F)
call KillUnit(CDF)
call DestroyUbersplat(ML9)
if B946DetectCount>0 then
set h8[$B0+id]=B960H8($B0+id,null,"C8F @ war3map.j:172129 (B968)")
else
set h8[$B0+id]=null
endif
if GetLocalPlayer()==GetOwningPlayer(WX7) then
	call OX7(WX7,"DISRB")
endif
if TZ7(GetOwningPlayer(WX7)) then
	call B947IssueImmediateOrder("C8F @ war3map.j:172137 (B968)",WX7,"stop")
endif
else
set tp1120Closing=true
call DisableTrigger(t)
if TpSlotChannelActive[id] and WX7==M7[id] then
set TpSlotChannelActive[id]=false
set TpSlotStopRequested[id]=false
set TpSlotOrderGuard[id]=false
set TpSlotPreserveChannel[id]=false
endif
call DestroyEffect((LoadEffectHandle(L7,(I97),($AF))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B0))))
call DestroyEffect((LoadEffectHandle(L7,(I97),($B1))))
call UnitRemoveAbility(WX7,'A4ML')
call UnitRemoveAbility(WX7,'A4MM')
call UnitRemoveAbility(IH7,'A4ML')
call UnitRemoveAbility(IH7,'A4MO')
if SPEPLAYER[id]==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",GetUnitX(WX7),GetUnitY(WX7)))
endif
call SaveInteger(L7,(GetHandleId((WX7))),((4256)),(2))
call KillUnit(C9F)
call KillUnit(CDF)
call DestroyUbersplat(ML9)
call UnitRemoveType(IH7,UNIT_TYPE_PEON)
if not tpSlotCancel then
if IH7==JW_JD then
call Y67(x,y,$F0)
call SetUnitPosition(WX7,x,y)
else
call Y67(GetUnitX(IH7)-1,GetUnitY(IH7)-1,$F0)
call SetUnitX(WX7,GetUnitX(IH7)-1)
call SetUnitY(WX7,GetUnitY(IH7)-1)
endif
call TpSlot_TraceController(t,WX7,"tp-pause-before")
call PauseUnit(WX7,true)
call PauseUnit(WX7,false)
call TpSlot_TraceController(t,WX7,"tp-pause-after")
if SPEPLAYER[id]>0 then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_Goods_TP_Target_effect(3).mdl",GetUnitX(WX7),GetUnitY(WX7)))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",GetUnitX(WX7),GetUnitY(WX7)))
endif
endif
if B946DetectCount>0 then
set h8[$B0+id]=B960H8($B0+id,null,"C8F @ war3map.j:172181 (B968)")
else
set h8[$B0+id]=null
endif
if GetLocalPlayer()==GetOwningPlayer(WX7) then
    call OX7(WX7,"DISRB")
endif
endif
if tp1120Closing then
call TpSlot_ReleaseController(t)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
endif
set t=null
set WX7=null
set C9F=null
set CDF=null
set ML9=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
//回城卷轴
function CEF takes nothing returns nothing
local real b1060LocationX=GetSpellTargetX()
local real b1060LocationY=GetSpellTargetY()
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit WI7=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local location l
local location tpCastleLanding=null
local real x
local real y
local real a
local trigger t
local integer OB7
local unit B5F
local unit B2F
local ubersplat B_F
local integer id=GetPlayerId(GetOwningPlayer(WI7))
local real CFF
local trigger tt
if WY4 and b1060B287_GetSpellAbilityId=='A137' then
set WY4=false
call SetUnitState(WI7,UNIT_STATE_MANA,GetUnitState(WI7,UNIT_STATE_MANA)+75)
return
endif
if GetLocalPlayer()==GetOwningPlayer(WI7) and TPFZ[GetPlayerId(GetOwningPlayer(WI7))] then
    call OV7(WI7,"DISRB")
endif
set tt = CreateTrigger()
call TriggerRegisterTimerEvent(tt, .5, true)
call TriggerRegisterTimerEvent(tt, 0, false)
call SaveUnitHandle(TABLE_HY, GetHandleId(tt), 0, WI7)
call SaveReal(TABLE_HY, GetHandleId(tt), 0, 3)	
call TriggerAddCondition(tt, Condition(function tp_texttag))
call TriggerRegisterUnitEvent(tt, WI7, EVENT_UNIT_SPELL_ENDCAST)
set tt = null
set t=CreateTrigger()
set OB7=GetHandleId(t)
call TpSlot_AcquireController(t,WI7)
call SaveInteger(L7,(GetHandleId((WI7))),((4256)),(1))
if b1060B287_GetSpellAbilityId=='A4T0' then
set x=TpSlotCastX[id]
set y=TpSlotCastY[id]
set m5=BCF(WI7,x,y)
elseif m5==null then
set l=Location(b1060LocationX,b1060LocationY)
set x=GetLocationX(l)
set y=GetLocationY(l)
if b1060B287_GetSpellAbilityId=='A1R5' then
if (x==TW4[id] and y==TX4[id]) or (x==TW4FX[id] and y==TX4FX[id]) or (x==TW4DFX[id] and y==TX4DFX[id]) or (x==0 and y==0) then
if TV7(GetOwningPlayer(WI7))then
set x=GetUnitX(IZ4)
set y=GetUnitY(IZ4)
else
set x=GetUnitX(JA4)
set y=GetUnitY(JA4)
endif
endif
endif
set m5=BCF(WI7,x,y)
call RemoveLocation(l)
else
set x=GetUnitX(m5)
set y=GetUnitY(m5)
endif
if KF7(x,y,GetUnitX(m5),GetUnitY(m5))>o4 then
set a=Atan2(y-GetUnitY(m5),x-GetUnitX(m5))
set x=GetUnitX(m5)+o4*Cos(a)
set y=GetUnitY(m5)+o4*Sin(a)
elseif KF7(x,y,GetUnitX(m5),GetUnitY(m5))<50 then
set a=Atan2(y-GetUnitY(m5),x-GetUnitX(m5))
set x=GetUnitX(m5)+120*Cos(a)
set y=GetUnitY(m5)+120*Sin(a)
endif
if IsPointInRegion(IU4,x,y) then
set a=Atan2(y-GetUnitY(m5),x-GetUnitX(m5))
set x=GetUnitX(m5)+$C8*Cos(a)
set y=GetUnitY(m5)+$C8*Sin(a)
endif
if m5==JW_JD then
set tpCastleLanding=TpSlot_GetCastleLanding(WI7,m5,x,y)
set x=GetLocationX(tpCastleLanding)
set y=GetLocationY(tpCastleLanding)
call RemoveLocation(tpCastleLanding)
set tpCastleLanding=null
endif
set x=X17(x)
set y=X07(y)
if(IsUnitAlly(WI7,GetLocalPlayer())and GetLocalPlayer()!=GetOwningPlayer(WI7))or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
call PingMinimapEx(x,y,3,$FF,$FF,$FF,false)
endif
set B2F=CreateUnit(GetOwningPlayer(WI7),BWF(id),x,y,0)
if SPEPLAYER[id]>0 then
call SaveEffectHandle(L7,(OB7),($AF),(AddSpecialEffect("AZModel\\AZ_Goods_TP_Caster(3).mdl",GetUnitX(WI7),GetUnitY(WI7))))
call SaveEffectHandle(L7,(OB7),($B0),(AddSpecialEffect("AZModel\\AZ_Goods_TP_Caster_effect(3).mdl",GetUnitX(WI7),GetUnitY(WI7))))
else
set B5F=CreateUnit(GetOwningPlayer(WI7),BYF(id),GetUnitX(WI7),GetUnitY(WI7),0)
call SaveUnitHandle(L7,(OB7),(448),(B5F))
endif
set B_F=CreateUbersplat(GetUnitX(WI7),GetUnitY(WI7),"SCTP",$FF,$FF,$FF,$FF,false,false)
if IsUnitVisible(WI7,GetLocalPlayer()) then
call SetUbersplatRenderAlways(B_F,true)
else
call SetUbersplatRenderAlways(B_F,false)
endif
call BUF(GetPlayerId(GetOwningPlayer(WI7)),x,y)
set CFF=3
call TriggerRegisterTimerEvent(t,CFF-3,false)
call TriggerRegisterTimerEvent(t,CFF,false)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerAddCondition(t,Condition(function B0F))
call Y57(GetOwningPlayer(WI7),CFF,x,y,$C8)
call SaveUnitHandle(L7,(OB7),(447),(B2F))
call SaveReal(L7,(OB7),(6),((x)*1.))
call SaveReal(L7,(OB7),(7),((y)*1.))
call NQ7(OB7,"OriginalTime",TimerGetElapsed(W))
call SaveReal(L7,(OB7),(57),((CFF)*1.))
call SaveUbersplatHandle(L7,(OB7),($83),(B_F))
call SaveUnitHandle(L7,(OB7),($E),(WI7))
call SaveInteger(L7,(OB7),(34),(0))
call ZW7(WI7,VS4,x,y,$960)
if B946DetectCount>0 then
set h8[$B0+id]=B960H8($B0+id,m5,"CEF @ war3map.j:172315 (B968)")
else
set h8[$B0+id]=m5
endif
set WI7=null
set m5=null
set B5F=null
set B2F=null
set l=null
set tpCastleLanding=null
set t=null
set B_F=null
endfunction
//飞鞋
function CGF takes nothing returns nothing
local real b1060LocationX=GetSpellTargetX()
local real b1060LocationY=GetSpellTargetY()
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit WX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local location l
