    if Firstcamp==1 then
        call VV7(bj_FORCE_ALL_PLAYERS,15.00,"从 "+Q[GetPlayerId(Z7[0])]+"达拉然势力|r"+" 开始，双方第一位玩家各BAN两名英雄")
    else
