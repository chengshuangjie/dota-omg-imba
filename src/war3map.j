call SaveUnitHandle(L7,OB7,0,WI7)
call SaveInteger(L7,I97,'BFLY',LoadInteger(L7,I97,'BFLY')+1)
call Z57(WI7,'A2R2',1,3,'B0GU')
call SetUnitPhaseMove( WI7, true )
set t=null
set WI7=null
endfunction
