function XMTowerAddHP takes nothing returns nothing
local integer ulife
local integer ulifeadd
local integer i=1
local real n
local unit array uTower
if D4 then
	set n=.2
else
	set n=.15
endif
set uTower[1]=JW_1ST
set uTower[2]=JW_1ZT
set uTower[3]=JW_1XT
set uTower[4]=TZ_1ST
set uTower[5]=TZ_1ZT
set uTower[6]=TZ_1XT
set uTower[7]=JW_2ST
set uTower[8]=JW_2ZT
set uTower[9]=JW_2XT
set uTower[10]=TZ_2ST
set uTower[11]=TZ_2ZT
set uTower[12]=TZ_2XT
set uTower[13]=JW_3ST
set uTower[14]=JW_3ZT
set uTower[15]=JW_3XT
set uTower[16]=TZ_3ST
set uTower[17]=TZ_3ZT
set uTower[18]=TZ_3XT
set uTower[19]=JW_4LT
set uTower[20]=JW_4RT
set uTower[21]=TZ_4LT
set uTower[22]=TZ_4RT
set uTower[23]=JS4
set uTower[24]=JT4
set uTower[25]=JU4
set uTower[26]=KD4
set uTower[27]=KE4
set uTower[28]=KF4
set uTower[29]=JV4
set uTower[30]=JW4
set uTower[31]=JX4
set uTower[32]=KG4
set uTower[33]=KH4
set uTower[34]=KI4
set uTower[35]=JW_JD
set uTower[36]=TZ_JD
loop
exitwhen i>36
if uTower[i]!=null then
set ulife=R2I(GetUnitState(uTower[i],UNIT_STATE_MAX_LIFE))
set ulifeadd=R2I(ulife*n)
call C77(uTower[i],ulifeadd)
call SetUnitState(uTower[i],UNIT_STATE_LIFE,ulife+ulifeadd)
endif
set uTower[i]=null
set i=i+1
endloop
endfunction
function CREATE_BLACK_LIST_TIP takes nothing returns nothing
set BLACK_LIST_TIP = MHFrame_CreateEx("TEXT","TooltipText","",MHUI_GetGameUI(),0,0)
call MHFrame_SetTextFlag(BLACK_LIST_TIP,TEXT_FLAG_NO_WRAP)
call MHFrame_SetWidth(BLACK_LIST_TIP,.7)
call MHFrame_SetText(BLACK_LIST_TIP,"温馨提醒：请保持良好的游戏环境，并与队友友善协作。")
call MHFrame_SetFont(BLACK_LIST_TIP,"Fonts\\dfst-m3u.ttf",1,TEXT_TYPE_NORMAL)
call MHFrame_SetTextColor(BLACK_LIST_TIP,TEXT_COLOR_NORMAL,$FFFF0000)
call MHFrame_SetGradient(BLACK_LIST_TIP,$FFCC0000,$FFFF6600,$FF990000,$FFFFAA00,1,.5)
call MHFrame_SetOutline(BLACK_LIST_TIP,$FF000000,1)
call MHFrame_SetTextAlign(BLACK_LIST_TIP,TEXT_VERTEX_ALIGN_CENTER,TEXT_HORIZON_ALIGN_CENTER)
call MHFrame_SetRelativePoint(BLACK_LIST_TIP,ANCHOR_CENTER,MHUI_GetGameUI(),ANCHOR_TOP,0,-0.08)
call MHFrame_Disable(BLACK_LIST_TIP,true)
endfunction
function AI_LOWEST_LEVEL_PD takes unit ZX7 returns boolean
    local real d=TimerGetElapsed(W)-M_4
    local integer level=GetUnitLevel(ZX7)
    // Keep the existing five-second, one-level-at-a-time promotion path.
    // A configured -cg game starts its level-25 catch-up 13 minutes earlier;
    // more than 70 Dalaran kills unlocks the same gentle catch-up immediately.
    if XM_CG and level<25 and (d>60*17 or T[GetPlayerId(Z7[0])]>70) then
        return true
    elseif level==1 and d>60*3 then
        return true
    elseif level==2 and d>60*5 then
        return true
    elseif level==3 and d>60*7 then
        return true
    elseif level==4 and d>60*9 then
        return true
    elseif level==5 and d>60*10 then
        return true
    elseif level==6 and d>60*11 then
        return true
    elseif level==7 and d>60*12 then
        return true
    elseif level==8 and d>60*13 then
        return true
    elseif level==9 and d>60*14 then
        return true
    elseif level==10 and d>60*15 then
        return true
    elseif level==11 and d>60*16 then
        return true
    elseif level==12 and d>60*17 then
        return true
    elseif level==13 and d>60*18 then
        return true
    elseif level==14 and d>60*19 then
        return true
    elseif level==15 and d>60*20 then
        return true
    elseif level==16 and d>60*21 then
        return true
    elseif level==17 and d>60*22 then
        return true
    elseif level==18 and d>60*23 then
        return true
    elseif level==19 and d>60*24 then
        return true
    elseif level==20 and d>60*25 then
        return true
    elseif level==21 and d>60*26 then
        return true
    elseif level==22 and d>60*27 then
        return true
    elseif level==23 and d>60*28 then
        return true
    elseif level==24 and d>60*30 then
        return true
    endif
    return false
endfunction
