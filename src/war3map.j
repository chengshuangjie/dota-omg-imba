set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function R_E takes nothing returns nothing
local trigger t=null
local unit IH7=GetTriggerUnit()
local unit ZX7=GetAttacker()
