function AI_LEARN_EX_SKILL takes unit ZX7 returns nothing
local integer id=GetUnitTypeId(ZX7)
local integer skill
local integer skill2
local integer n=1
if id=='H071' then
    set skill='A4BV'
    set skill2='A4BW'
elseif id=='U00P' then
    set skill='A4A1'
    set skill2='A4A2'
elseif id=='N00R' then
    set skill='A4BP'
    set skill2='A4BQ'
elseif id=='N01V' then
    set skill='A0LN'
    set skill2='A4F0'
elseif id=='Hvsh' then
    set skill='A0LH'
    set skill2='A2Z9'
elseif id=='E02H' then
    set skill='A2ZM'
    set skill2='A2ZN'
elseif id=='Ofar' then
    set skill='A29I'
    set skill2='A2UL'
elseif id=='U00K' then
    set skill='A06O'
    set skill2='A4I2'
elseif id=='Hvwd' then
    set skill='A02A'
    set skill2='A4J2'
elseif id=='UC01' then
    set skill='A0Q7'
    set skill2='A4J4'
elseif id=='Ntin' then
	set skill='A2UR'
    set skill2='A2US'
else
    return
endif
loop
exitwhen n>4
    call SelectHeroSkill(ZX7,skill)
    call SelectHeroSkill(ZX7,skill2)
set n=n+1
endloop
endfunction
function AICZB takes integer O5,unit it,player p returns nothing
if XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and GetUnitLevel(it)>15 and GetUnitAbilityLevel(it,'A2Q5')==0 then
call XF7(it,'A2Q5')
call XF7(it,'A2Q3')
endif
if XM_MODE and GetPlayerController(p)==MAP_CONTROL_COMPUTER and GetUnitLevel(it)>21 and GetUnitAbilityLevel(it,'A330')==0 then
call AI_LEARN_EX_SKILL(it)
call XF7(it,'A330')
call CHIA_SKILL(it,p)
call CHIA_TX(it,p)
call XF7(it,'A2VW')
call XF7(it,'A334')
call CHILLX_SKILL(it,p)
set CHIA[O5]=1
set CHILLX[O5]=1
endif
if FORCE_AICZB then
call XF7(it,'A2Q5')
call XF7(it,'A2Q3')
call XF7(it,'A330')
call CHIA_SKILL(it,p)
call CHIA_TX(it,p)
call XF7(it,'A2VW')
call XF7(it,'A334')
call CHILLX_SKILL(it,p)
set CHIA[O5]=1
set CHILLX[O5]=1
endif
endfunction
function AI_RepairStaleBroadsword takes integer O5,unit it returns nothing
local item sword=null
local integer h=0
local integer pending=0
local integer trackedPending=0
local real now=0.
local real since=0.
if it==null or GetUnitTypeId(it)==0 or GetPlayerController(Player(O5))!=MAP_CONTROL_COMPUTER then
return
endif
set h=GetHandleId(it)
set sword=MV7(it,ZU[TV])
if Bz<1800 or sword==null then
call RemoveSavedReal(L7,h,StringHash("AIStaleBroadswordSince"))
call RemoveSavedInteger(L7,h,StringHash("AIStaleBroadswordPending"))
set sword=null
return
endif
set now=TimerGetElapsed(W)
set pending=G97[96+O5]
set trackedPending=LoadInteger(L7,h,StringHash("AIStaleBroadswordPending"))
set since=LoadReal(L7,h,StringHash("AIStaleBroadswordSince"))
if since<=0. or trackedPending!=pending then
call SaveReal(L7,h,StringHash("AIStaleBroadswordSince"),now)
call SaveInteger(L7,h,StringHash("AIStaleBroadswordPending"),pending)
elseif now-since>=180. then
// Recover a late-game AI slot only after the same build state has made no
// progress for three minutes; normal short-term component saving is untouched.
call ZAE(O5,it,sword,TV)
call RemoveSavedReal(L7,h,StringHash("AIStaleBroadswordSince"))
call RemoveSavedInteger(L7,h,StringHash("AIStaleBroadswordPending"))
endif
set sword=null
endfunction
