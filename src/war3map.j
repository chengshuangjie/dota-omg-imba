function NightmareAftershock_SilenceEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer h=GetHandleId(t)
local unit u=LoadUnitHandle(L7,h,0)
if u!=null and GetUnitTypeId(u)!=0 then
call MHUnit_Silence(u,false)
endif
call FlushChildHashtable(L7,h)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set t=null
endfunction
function NightmareAftershock_Apply takes unit u returns nothing
local timer t=null
if u==null or GetUnitTypeId(u)==0 or UnitAlive(u)==false then
return
endif
call MHUnit_Silence(u,true)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",u,"overhead"))
call Z57(u,'A4FF',1,3.,'BNab')
set t=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(t),0,u)
// IMBA: nightmare aftershock debuff x2 cap 30s.
if XOMG_IMBA_ENABLED then
call TimerStart(t,RMinBJ(2.*IMBA_POWER,30.),false,function NightmareAftershock_SilenceEnd)
else
call TimerStart(t,2.,false,function NightmareAftershock_SilenceEnd)
endif
set t=null
endfunction
function NightmareDeep_OnDamaging takes nothing returns boolean
local unit target=MHEvent_GetUnit()
if target!=null and GetUnitTypeId(target)!=0 and LoadInteger(L7,GetHandleId(target),791)!=0 and ON7(GetHandleId(target),"NightmareDeepUntil")>TimerGetElapsed(W) and MHDamagingEvent_GetDamage()>0. then
call MHDamagingEvent_SetDamage(0.)
endif
set target=null
return false
endfunction
function SuijiMode_ClearRhastaShackleResidue takes unit suijiRhastaShackleTarget returns nothing
local integer h=0
local effect e=null
if suijiRhastaShackleTarget==null then
return
endif
set h=GetHandleId(suijiRhastaShackleTarget)
set e=OG7(h,"NightmareSleepEffect")
if e!=null then
call DestroyEffect(e)
call NN7(h,"NightmareSleepEffect")
endif
call UnitRemoveAbility(suijiRhastaShackleTarget,'B02F')
call UnitRemoveAbility(suijiRhastaShackleTarget,'BUsp')
call UnitRemoveAbility(suijiRhastaShackleTarget,'Bust')
call UnitRemoveAbility(suijiRhastaShackleTarget,'A2O9')
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(suijiRhastaShackleTarget),'A04Y',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiRhastaShackleTarget),'A2O9',false)
call SaveInteger(L7,h,791,0)
call RemoveSavedReal(L7,h,StringHash("NightmareDeepUntil"))
set e=null
endfunction
function QAD takes nothing returns boolean
local unit b1060GetAttacker=B1060EventAttacker()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local unit p5=O77(OB7,"Source")
local player p=O97(OB7,"p")
local integer V77=OM7(OB7,"Level")
local unit oA
local boolean suijiRhastaShackleActive=LoadInteger(L7,GetHandleId(m5),791)==OB7
if suijiRhastaShackleActive==false then
call NM7(OB7)
call OZ7(t)
elseif GetUnitAbilityLevel(m5,'B02F')==0 then
if suijiRhastaShackleActive then
if TimerGetElapsed(W)+.25>=ON7(OB7,"NightmareNaturalEnd") and UnitAlive(m5) then
call NightmareAftershock_Apply(m5)
endif
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call NM7(OB7)
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH then
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call NM7(OB7)
call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_ATTACKED and b1060GetTriggerUnit==m5 then
if ON7(GetHandleId(m5),"NightmareDeepUntil")>TimerGetElapsed(W) then
if((IsUnitType(b1060GetAttacker,UNIT_TYPE_HERO))and(GetPlayerController(GetOwningPlayer(b1060GetAttacker))==MAP_CONTROL_COMPUTER))then
call B947IssuePointOrderById("QAD @ war3map.j:91912 (B968)",b1060GetAttacker,$D0012,GetUnitX(b1060GetAttacker)+GetRandomReal(0,150.)-75.,GetUnitY(b1060GetAttacker)+GetRandomReal(0,150.)-75.)
endif
else
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
if((IsUnitType(b1060GetAttacker,UNIT_TYPE_HERO))and(GetPlayerController(GetOwningPlayer(b1060GetAttacker))==MAP_CONTROL_COMPUTER))then
call B947IssuePointOrderById("QAD @ war3map.j:91919 (B968)",b1060GetAttacker,$D0012,GetUnitX(b1060GetAttacker)+GetRandomReal(0,150.)-75.,GetUnitY(b1060GetAttacker)+GetRandomReal(0,150.)-75.)
else
set oA=CreateUnit(p,'e00E',GetUnitX(m5),GetUnitY(m5),0)
call XF7(oA,'A04Y')
call B287_SetUnitAbilityLevel(oA,'A04Y',V77)
call B947IssueTargetOrderById("QAD @ war3map.j:91924 (B968)",oA,$D0103,b1060GetAttacker)
call UnitApplyTimedLife(oA,'BTLF',2.)
call NM7(OB7)
call OZ7(t)
endif
endif
elseif b1060GetTriggerEventId!=EVENT_UNIT_ATTACKED then
if GetUnitState(m5,UNIT_STATE_LIFE)>21 then
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)-20)
else
if suijiRhastaShackleActive then
call SuijiMode_ClearRhastaShackleResidue(m5)
endif
call B67(p5,m5,1,50)
call NM7(OB7)
call OZ7(t)
endif
endif
set t=null
set p=null
set oA=null
set m5=null
set p5=null
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function QBD takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer targetHandle=GetHandleId(m5)
local effect sleepEffect=OG7(targetHandle,"NightmareSleepEffect")
set OB7=GetHandleId(t)
if sleepEffect!=null then
call DestroyEffect(sleepEffect)
call NN7(targetHandle,"NightmareSleepEffect")
endif
call NU7(targetHandle,"NightmareSleepEffect",AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Sleep\\SleepTarget.mdl",m5,"overhead"))
call NT7(OB7,"Target",m5)
call NT7(OB7,"Source",p5)
call NZ7(OB7,"p",GetOwningPlayer(p5))
call NP7(OB7,"Level",B287_GetUnitAbilityLevel(p5,'A04Y'))
call NQ7(OB7,"NightmareNaturalEnd",TimerGetElapsed(W)+3.+B287_GetUnitAbilityLevel(p5,'A04Y'))
call NQ7(GetHandleId(m5),"NightmareDeepUntil",TimerGetElapsed(W)+1.)
call SaveInteger(L7,GetHandleId(m5),791,OB7)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_ATTACKED)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function QAD))
if B287_GetUnitAbilityLevel(m5,'A04Y')>0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A04Y',false)
call XF7(m5,'A2O9')
call SetPlayerAbilityAvailable(GetOwningPlayer(m5),'A2O9',true)
endif
set V14=true
call B67(p5,m5,2,0)
set V14=false
set p5=null
set m5=null
set t=null
set sleepEffect=null
endfunction
function QCD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A04Y' and ((KW7(GetSpellTargetUnit())==false and IsUnitAlly(GetSpellTargetUnit(),GetOwningPlayer(GetTriggerUnit()))) or WQ7(GetSpellTargetUnit())==false) then
call QBD()
endif
return false
