local fogmodifier sleightFog1097=LoadFogModifierHandle(L7,sleightRoundHandle1097,42)
call DestroyGroup(LoadGroupHandle(L7,sleightRoundHandle1097,22))
call FogModifierStop(sleightFog1097)
call DestroyFogModifier(sleightFog1097)
call FlushChildHashtable(L7,sleightRoundHandle1097)
call DestroyTrigger(sleightRound1097)
set sleightFog1097=null
endfunction
function B1097SleightEnd takes trigger sleightController1097 returns nothing
local integer sleightHandle1097=GetHandleId(sleightController1097)
local unit sleightUnit1097=LoadUnitHandle(L7,sleightHandle1097,2)
local integer sleightOwner1097=GetHandleId(sleightUnit1097)
local trigger sleightRound1097=LoadTriggerHandle(L7,sleightHandle1097,'H109')
local trigger sleightNext1097=null
loop
exitwhen sleightRound1097==null
set sleightNext1097=LoadTriggerHandle(L7,GetHandleId(sleightRound1097),'N109')
call B1097SleightDropRound(sleightRound1097)
set sleightRound1097=sleightNext1097
endloop
call RemoveUnit(LoadUnitHandle(L7,sleightHandle1097,19))
if LoadTriggerHandle(L7,sleightOwner1097,'S109')==sleightController1097 then
call RemoveSavedHandle(L7,sleightOwner1097,'S109')
call SaveInteger(L7,sleightOwner1097,4360,0)
call SaveInteger(L7,sleightOwner1097,4318,2)
if GetUnitTypeId(sleightUnit1097)!=0 then
if UnitAlive(sleightUnit1097) and LoadInteger(L7,sleightOwner1097,4319)!=1 then
call SetUnitX(sleightUnit1097,LoadReal(L7,sleightHandle1097,6))
call SetUnitY(sleightUnit1097,LoadReal(L7,sleightHandle1097,7))
endif
call DisarmUnit(sleightUnit1097,false,'A4LR',0,0)
if not LoadBoolean(L7,sleightHandle1097,10) then
call UnitRemoveAbility(sleightUnit1097,'A04R')
endif
call SetUnitInvulnerable(sleightUnit1097,LoadBoolean(L7,sleightHandle1097,11) or LoadInteger(ExtraHT,sleightOwner1097,HTKEY_UNIT_INVELNERABLE_COUINT)>0)
call SetUnitPathingEx(sleightUnit1097,LoadBoolean(L7,sleightHandle1097,12))
else
// B1098: a removed handle cannot receive ability/path writes. Still release
// our shared disarm count so a recycled unit handle never inherits the lock.
if LoadInteger(ExtraHT,sleightOwner1097,'A4LR')>1 then
call SaveInteger(ExtraHT,sleightOwner1097,'A4LR',LoadInteger(ExtraHT,sleightOwner1097,'A4LR')-1)
else
call RemoveSavedInteger(ExtraHT,sleightOwner1097,'A4LR')
endif
call FlushChildHashtable(UnitDataHashTable,sleightOwner1097)
endif
endif
call FlushChildHashtable(L7,sleightHandle1097)
call OZ7(sleightController1097)
set sleightUnit1097=null
set sleightRound1097=null
set sleightNext1097=null
endfunction
function B1097SleightTick takes nothing returns boolean
local trigger sleightController1097=GetTriggeringTrigger()
local integer sleightHandle1097=GetHandleId(sleightController1097)
local unit sleightUnit1097=LoadUnitHandle(L7,sleightHandle1097,2)
local integer sleightOwner1097=GetHandleId(sleightUnit1097)
local trigger sleightRound1097=LoadTriggerHandle(L7,sleightHandle1097,'H109')
local trigger sleightLast1097=LoadTriggerHandle(L7,sleightHandle1097,'T109')
local trigger sleightPrevious1097=null
local trigger sleightNext1097=null
local boolean sleightStop1097=false
local group sleightGroup1097=null
local unit sleightTarget1097=null
local real sleightAngle1097=0.
if GetUnitTypeId(sleightUnit1097)==0 or not UnitAlive(sleightUnit1097) or B287_GetUnitAbilityLevel(sleightUnit1097,'A2H0')<=0 or LoadInteger(L7,sleightOwner1097,4319)==1 then
call B1097SleightEnd(sleightController1097)
else
// Each live cast advances once per original .2 cadence; a recast appended by
// an attack callback starts next tick instead of extending this dispatch loop.
loop
exitwhen sleightRound1097==null or sleightStop1097
set sleightStop1097=sleightRound1097==sleightLast1097
set sleightNext1097=LoadTriggerHandle(L7,GetHandleId(sleightRound1097),'N109')
set sleightGroup1097=LoadGroupHandle(L7,GetHandleId(sleightRound1097),22)
loop
set sleightTarget1097=FirstOfGroup(sleightGroup1097)
exitwhen sleightTarget1097==null
call GroupRemoveUnit(sleightGroup1097,sleightTarget1097)
exitwhen B1097SleightTarget(sleightUnit1097,sleightTarget1097)
set sleightTarget1097=null
endloop
if sleightTarget1097==null then
if sleightPrevious1097==null then
call SaveTriggerHandle(L7,sleightHandle1097,'H109',sleightNext1097)
else
call SaveTriggerHandle(L7,GetHandleId(sleightPrevious1097),'N109',sleightNext1097)
endif
if LoadTriggerHandle(L7,sleightHandle1097,'T109')==sleightRound1097 then
call SaveTriggerHandle(L7,sleightHandle1097,'T109',sleightPrevious1097)
endif
call SaveInteger(L7,sleightOwner1097,4360,IMaxBJ(0,LoadInteger(L7,sleightOwner1097,4360)-1))
call B1097SleightDropRound(sleightRound1097)
else
set sleightAngle1097=GetRandomReal(0.,360.)*bj_DEGTORAD
call SetUnitPosition(sleightUnit1097,GetUnitX(sleightTarget1097)+50.*Cos(sleightAngle1097),GetUnitY(sleightTarget1097)+50.*Sin(sleightAngle1097))
call SetUnitFacing(sleightUnit1097,bj_RADTODEG*Atan2(GetUnitY(sleightTarget1097)-GetUnitY(sleightUnit1097),GetUnitX(sleightTarget1097)-GetUnitX(sleightUnit1097)))
call SetUnitAnimation(sleightUnit1097,"Attack")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Fire_Blink_2.mdx",sleightUnit1097,"chest"))
set B1097SleightEntryUnit=sleightUnit1097
set B1097SleightEntryTarget=sleightTarget1097
set B1097SleightEntryLevel=LoadInteger(L7,GetHandleId(sleightRound1097),3)
call ExecuteFunc("B1097SleightAttack")
set B1097SleightEntryUnit=null
set B1097SleightEntryTarget=null
set B1097SleightEntryLevel=0
set sleightPrevious1097=sleightRound1097
endif
set sleightRound1097=sleightNext1097
exitwhen GetUnitTypeId(sleightUnit1097)==0 or not UnitAlive(sleightUnit1097) or LoadInteger(L7,sleightOwner1097,4319)==1
endloop
if LoadTriggerHandle(L7,sleightHandle1097,'H109')==null or GetUnitTypeId(sleightUnit1097)==0 or not UnitAlive(sleightUnit1097) or LoadInteger(L7,sleightOwner1097,4319)==1 then
call B1097SleightEnd(sleightController1097)
endif
endif
set sleightController1097=null
set sleightUnit1097=null
set sleightRound1097=null
set sleightLast1097=null
set sleightPrevious1097=null
set sleightNext1097=null
set sleightGroup1097=null
set sleightTarget1097=null
return false
endfunction
function B1097SleightStart takes unit sleightUnit1097,real sleightX1097,real sleightY1097,integer sleightLevel1097 returns nothing
local integer sleightOwner1097=GetHandleId(sleightUnit1097)
local trigger sleightController1097=LoadTriggerHandle(L7,sleightOwner1097,'S109')
local boolean sleightFirst1097=sleightController1097==null
local integer sleightHandle1097=0
local trigger sleightRound1097=CreateTrigger()
local integer sleightRoundHandle1097=GetHandleId(sleightRound1097)
local trigger sleightTail1097=null
local group sleightGroup1097=CreateGroup()
local unit sleightSavedFilter1097=IN4
local fogmodifier sleightFog1097=CreateFogModifierRadius(GetOwningPlayer(sleightUnit1097),FOG_OF_WAR_VISIBLE,sleightX1097,sleightY1097,625.,true,true)
call FogModifierStart(sleightFog1097)
set IN4=sleightUnit1097
call GroupEnumUnitsInRange(sleightGroup1097,sleightX1097,sleightY1097,175.+100.*sleightLevel1097,Condition(function A87))
set IN4=sleightSavedFilter1097
call SaveGroupHandle(L7,sleightRoundHandle1097,22,sleightGroup1097)
call SaveFogModifierHandle(L7,sleightRoundHandle1097,42,sleightFog1097)
call SaveInteger(L7,sleightRoundHandle1097,3,sleightLevel1097)
if sleightFirst1097 then
set sleightController1097=CreateTrigger()
set sleightHandle1097=GetHandleId(sleightController1097)
call SaveTriggerHandle(L7,sleightOwner1097,'S109',sleightController1097)
call SaveUnitHandle(L7,sleightHandle1097,2,sleightUnit1097)
call SaveReal(L7,sleightHandle1097,6,GetUnitX(sleightUnit1097))
call SaveReal(L7,sleightHandle1097,7,GetUnitY(sleightUnit1097))
call SaveBoolean(L7,sleightHandle1097,10,GetUnitAbilityLevel(sleightUnit1097,'A04R')>0)
call SaveBoolean(L7,sleightHandle1097,11,MHUnit_IsInvulnerable(sleightUnit1097))
call SaveBoolean(L7,sleightHandle1097,12,not LoadBoolean(UnitDataHashTable,sleightOwner1097,UNIT_PATHING))
call SaveUnitHandle(L7,sleightHandle1097,19,CreateUnit(GetOwningPlayer(sleightUnit1097),'h0E7',GetUnitX(sleightUnit1097),GetUnitY(sleightUnit1097),GetUnitFacing(sleightUnit1097)))
call SetUnitVertexColor(LoadUnitHandle(L7,sleightHandle1097,19),255,255,255,100)
call SaveTriggerHandle(L7,sleightHandle1097,'H109',sleightRound1097)
call SaveInteger(L7,sleightOwner1097,4318,1)
call SaveReal(L7,sleightOwner1097,4361,GetUnitX(sleightUnit1097))
call SaveReal(L7,sleightOwner1097,4362,GetUnitY(sleightUnit1097))
call AG7(sleightUnit1097)
call WNG(sleightUnit1097)
call DisarmUnit(sleightUnit1097,true,'A4LR',0,0)
call SetUnitPathingEx(sleightUnit1097,false)
call SetUnitInvulnerable(sleightUnit1097,true)
call XF7(sleightUnit1097,'A04R')
call TriggerRegisterTimerEvent(sleightController1097,.2,true)
call TriggerAddCondition(sleightController1097,Condition(function B1097SleightTick))
else
set sleightHandle1097=GetHandleId(sleightController1097)
set sleightTail1097=LoadTriggerHandle(L7,sleightHandle1097,'T109')
call SaveTriggerHandle(L7,GetHandleId(sleightTail1097),'N109',sleightRound1097)
endif
call SaveTriggerHandle(L7,sleightHandle1097,'T109',sleightRound1097)
call SaveInteger(L7,sleightOwner1097,4360,LoadInteger(L7,sleightOwner1097,4360)+1)
if sleightFirst1097 and B1078AttackSource==null then
call TriggerEvaluate(sleightController1097)
endif
set sleightController1097=null
set sleightRound1097=null
set sleightTail1097=null
set sleightGroup1097=null
set sleightSavedFilter1097=null
set sleightFog1097=null
endfunction
function WUG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local trigger t=null
local integer I97=0
local integer H97=GetHandleId(ZX7)
local fogmodifier Q0D=null
local unit BB7=null
local group g=null
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A2H0')
if GetUnitTypeId(ZX7)!='N0M0' and GetUnitTypeId(ZX7)!='N0MH' then
call B1097SleightStart(ZX7,x,y,BC7)
set ZX7=null
return
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
set Q0D=CreateFogModifierRadius(GetOwningPlayer(ZX7),FOG_OF_WAR_VISIBLE,x,y,625,true,true)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0E7',GetUnitX(ZX7),GetUnitY(ZX7),GetUnitFacing(ZX7))
set g=WS7()
call SetUnitVertexColor(BB7,$FF,$FF,$FF,100)
call FogModifierStart(Q0D)
call SaveInteger(L7,(GetHandleId((ZX7))),((4318)),(1))
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,$96+100*BC7+25,Condition(function A87))
call AG7(ZX7)
call WNG(ZX7)
call UnitAddAbility(ZX7,'A2H1')
call UnitRemoveAbility(ZX7,'A2H1')
call SuijiMode_RestoreWarpathBonus(ZX7)
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,125)
call SetUnitPathing(ZX7,false)
call SetUnitInvulnerable(ZX7,true)
call XF7(ZX7,'A04R')
call SetUnitTimeScale(ZX7,3)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddCondition(t,Condition(function WTG))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveReal(L7,(I97),(6),((x)*1.))
call SaveReal(L7,(I97),(7),((y)*1.))
if LoadInteger(L7,H97,4360)==0 then
call SaveReal(L7,H97,4361,GetUnitX(ZX7))
call SaveReal(L7,H97,4362,GetUnitY(ZX7))
endif
call SaveInteger(L7,H97,4360,LoadInteger(L7,H97,4360)+1)
call SaveReal(L7,(I97),($BD),LoadReal(L7,H97,4361))
call SaveReal(L7,(I97),($BE),LoadReal(L7,H97,4362))
call SaveGroupHandle(L7,(I97),($BB),(WS7()))
call SaveGroupHandle(L7,(I97),(22),(g))
call SaveFogModifierHandle(L7,(I97),(42),(Q0D))
call SaveUnitHandle(L7,(I97),(19),(BB7))
call WQG(ZX7)
call TriggerEvaluate(t)
set ZX7=null
set t=null
set Q0D=null
set BB7=null
set g=null
endfunction
function WVG takes nothing returns boolean
