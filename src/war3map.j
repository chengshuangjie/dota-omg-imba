endif
if B946DetectCount>0 then
set h8[16+leaveAIPlayerId]=B960H8(16+leaveAIPlayerId,h7[$E],"KKLeaveAI_SetLane @ war3map.j:160133 (B968)")
else
set h8[16+leaveAIPlayerId]=h7[$E]
endif
elseif leaveAILaneIndex==1 then
if B946DetectCount>0 then
set h8[leaveAIPlayerId]=B960H8(leaveAIPlayerId,h7[31],"KKLeaveAI_SetLane @ war3map.j:160139 (B968)")
else
set h8[leaveAIPlayerId]=h7[31]
endif
if B946DetectCount>0 then
set h8[16+leaveAIPlayerId]=B960H8(16+leaveAIPlayerId,h7[35],"KKLeaveAI_SetLane @ war3map.j:160144 (B968)")
else
set h8[16+leaveAIPlayerId]=h7[35]
endif
else
if B946DetectCount>0 then
set h8[leaveAIPlayerId]=B960H8(leaveAIPlayerId,h7[51],"KKLeaveAI_SetLane @ war3map.j:160150 (B968)")
