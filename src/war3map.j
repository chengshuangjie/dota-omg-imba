function SuijiMode_ClearFreezingFieldActive takes unit suijiFreezingFieldUnit,trigger suijiFreezingFieldTrigger returns nothing
local integer suijiFreezingFieldCasterHandle=0
if suijiFreezingFieldUnit==null then
return
endif
if SUIJI_MODE then
set suijiFreezingFieldCasterHandle=GetHandleId(suijiFreezingFieldUnit)
if LoadTriggerHandle(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldTrigger"))==suijiFreezingFieldTrigger then
call RemoveSavedHandle(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldTrigger"))
call RemoveSavedReal(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldActiveUntil"))
endif
endif
endfunction
function B835FreezingFieldOrder takes integer b835Physical returns integer
local integer b835Logical=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,b835Physical)
if b835Logical!=0 and LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,b835Logical)==b835Physical then
return OrderId(LoadStr(SUIJI_FIXED_CLONE_TABLE,3,b835Logical))
endif
return $D0278
endfunction
function SuijiMode_ShouldStopFreezingField takes unit suijiFreezingFieldUnit,integer suijiFreezingFieldTriggerHandle returns boolean
local integer suijiFreezingFieldCasterHandle=0
local eventid suijiFreezingFieldEventId=GetTriggerEventId()
local real suijiFreezingFieldElapsed=0.
local integer b835FieldOrder=LoadInteger(L7,suijiFreezingFieldTriggerHandle,StringHash("B835FreezingFieldOrder"))
if SUIJI_MODE==false or suijiFreezingFieldUnit==null then
return false
endif
set suijiFreezingFieldCasterHandle=GetHandleId(suijiFreezingFieldUnit)
if b835FieldOrder==0 then
set b835FieldOrder=$D0278
endif
if UnitAlive(suijiFreezingFieldUnit)==false then
return true
endif
if suijiFreezingFieldEventId==EVENT_UNIT_ISSUED_ORDER or suijiFreezingFieldEventId==EVENT_UNIT_ISSUED_POINT_ORDER or suijiFreezingFieldEventId==EVENT_UNIT_ISSUED_TARGET_ORDER then
return GetIssuedOrderId()!=b835FieldOrder
endif
set suijiFreezingFieldElapsed=TimerGetElapsed(W)-LoadReal(L7,suijiFreezingFieldTriggerHandle,StringHash("SuijiFreezingFieldStartedAt"))
if suijiFreezingFieldElapsed>8.5 then
return true
endif
if suijiFreezingFieldElapsed>.45 and GetUnitCurrentOrder(suijiFreezingFieldUnit)!=b835FieldOrder then
return true
endif
return false
endfunction
function W19 takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit BB7=O77(OB7,"BB7")
local integer V77=OM7(OB7,"Level")
local string tx=OP7(OB7,"TX")
local integer W09=ModuloInteger(GetTriggerEvalCount(t),4)+1
local real a
local real d
local real x
local real y
//local group g=WS7()
//set IN4=WI7
//call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),860,Condition(function AJ7_gai))
//call ForGroup(g,function WL9)
//call WR7(g)
//local group g=WS7()
//set IN4=WI7
//call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),860,Condition(function AJ7_gai))
//call ForGroup(g,function WL9)
//call WR7(g)
//local group g=WS7()
//set IN4=WI7
//call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),860,Condition(function AJ7_gai))
//call ForGroup(g,function WL9)
//call WR7(g)
if WI7==null or GetUnitTypeId(WI7)==0 then
if BB7!=null then
call UnitRemoveAbility(BB7,'A347')
call RemoveUnit(BB7)
endif
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set BB7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if W09==1 then
set a=GetRandomReal(0,120)
elseif W09==2 then
set a=GetRandomReal(120,$F0)
elseif W09==3 then
set a=GetRandomReal($F0,360)
else
set a=GetRandomReal(360,480)
endif
set d=GetRandomReal($A0,825)
if b1060GetTriggerEventId==EVENT_WIDGET_DEATH or b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and (b1060B287_GetSpellAbilityId=='A03R' or b1060B287_GetSpellAbilityId=='A0AV') or SuijiMode_ShouldStopFreezingField(WI7,OB7) then
set BREAKLBK[GetPlayerId(GetOwningPlayer(WI7))]=0
call DestroyEffect(OG7(OB7,"FX"))
if BB7!=null then
call UnitRemoveAbility(BB7,'A347')
call RemoveUnit(BB7)
endif
call SuijiMode_ClearFreezingFieldActive(WI7,t)
call NM7(OB7)
call OZ7(t)
call StopSound(vX,false,true)
call StopSound(vX2,false,true)
else
set x=GetUnitX(WI7)+d*Cos(a*bj_DEGTORAD)
set y=GetUnitY(WI7)+d*Sin(a*bj_DEGTORAD)
call DestroyEffect(AddSpecialEffect(tx,x,y))
call W69(WI7,x,y,V77)
endif
set t=null
//set g=null
set WI7=null
set BB7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function W59 takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local unit WI7=GetTriggerUnit()
local trigger t=null
local integer OB7=0
local integer V77=0
local integer id=0
local unit BB7=null
local integer suijiFreezingFieldCasterHandle=0
if WI7==null or GetUnitTypeId(WI7)==0 then
set WI7=null
return
endif
set id=GetUnitTypeId(WI7)
set suijiFreezingFieldCasterHandle=GetHandleId(WI7)
if SUIJI_MODE then
if LoadTriggerHandle(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldTrigger"))!=null or LoadReal(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldActiveUntil"))>TimerGetElapsed(W) then
set WI7=null
return
endif
call SaveReal(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldActiveUntil"),TimerGetElapsed(W)+9.)
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(WI7),GetUnitY(WI7),0)
call UnitApplyTimedLife(BB7,'BTLF',12.)
call Send_Chat_Text(GetOwningPlayer(WI7),Get_Skill_Text(GetOwningPlayer(WI7),"BingNvDA"))
call Y17(vX,GetUnitX(WI7),GetUnitY(WI7))
call XF7(BB7,'A347')
set V77=SuijiMode_GetPairCastLevel(WI7,b1060B287_GetSpellAbilityId,'A03R','A0AV')
set SUIJI_FREEZING_FIELD_COOLDOWN_UNIT=WI7
set SUIJI_FREEZING_FIELD_COOLDOWN_SKILL=b1060B287_GetSpellAbilityId
call ExecuteFunc("SuijiMode_StartFreezingFieldCooldownSync")
if SuijiMode_ScepterRegistryIsActive(WI7,'A03R') then
call SetUnitAbilityLevel(BB7,'A347',2)
set V77=V77+1
endif
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterDeathEvent(t,WI7)
if SUIJI_MODE then
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(t,WI7,EVENT_UNIT_ISSUED_TARGET_ORDER)
call SaveReal(L7,OB7,StringHash("SuijiFreezingFieldStartedAt"),TimerGetElapsed(W))
call SaveInteger(L7,OB7,StringHash("B835FreezingFieldOrder"),B835FreezingFieldOrder(b1060GetSpellAbilityId))
call SaveTriggerHandle(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldTrigger"),t)
call SaveReal(L7,suijiFreezingFieldCasterHandle,StringHash("SuijiFreezingFieldActiveUntil"),TimerGetElapsed(W)+9.)
endif
call TriggerAddCondition(t,Condition(function W19))
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"BB7",BB7)
call NP7(OB7,"Level",V77)
if id=='Zjai' then
call StartSound(vX2)
call NR7(OB7,"TX","model\\hero_crystalmaiden_n5_f_blizzard.mdx")
call NU7(OB7,"FX",(AddSpecialEffectTarget("model\\hero_crystalmaiden_n5_f_maga.mdl",WI7,"origin")))
elseif id=='Zjaj' then
call NR7(OB7,"TX","model\\hero_crystalmaiden_n8_f_blizzard.mdx")
call NU7(OB7,"FX",(AddSpecialEffectTarget("model\\hero_crystalmaiden_n8_f_maga.mdl",WI7,"origin")))
elseif id=='Zjak' or id=='Z02X' then
call NR7(OB7,"TX","model\\hero_crystalmaiden_n9_f_blizzard.mdx")
call NU7(OB7,"FX",(AddSpecialEffectTarget("model\\hero_crystalmaiden_n9_f_maga.mdl",WI7,"origin")))
else
call NR7(OB7,"TX","effects\\SnowyBlizzardTarget.mdx")
call NU7(OB7,"FX",(AddSpecialEffectTarget("effects\\Freezing Field.mdx",WI7,"chest")))
endif
set t=null
set WI7=null
set BB7=null
endfunction
function R22 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit ZX7=LoadUnitHandle(L7,I97,0)
local unit IH7=LoadUnitHandle(L7,I97,1)
if GetUnitAbilityLevel(IH7,'B017')>0 or GetUnitAbilityLevel(IH7,'B0IA')>0 or GetUnitAbilityLevel(IH7,'B0ID')>0 or GetUnitAbilityLevel(IH7,'B0IF')>0 then
call B67(ZX7,IH7,1,50)
else
call UnitRemoveAbility(IH7,'A2WG')
call FlushChildHashtable(L7,I97)
call PauseTimer(t)
call DestroyTimer(t)
