    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品2 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 2)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品3 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 3)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品4 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 4)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品5 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 5)))
