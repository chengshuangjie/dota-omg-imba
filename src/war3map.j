function UnifiedOrbToggle_InitFrames takes nothing returns nothing
local player orbTogglePlayer=GetLocalPlayer()
if UnifiedOrbToggleButton!=0 then
set orbTogglePlayer=null
return
endif
set UnifiedOrbToggleIcon=DzCreateFrameByTagName("BACKDROP",null,GameUI,"template",310)
call DzFrameSetSize(UnifiedOrbToggleIcon,0.022,0.022)
call DzFrameClearAllPoints(UnifiedOrbToggleIcon)
call DzFrameSetAbsolutePoint(UnifiedOrbToggleIcon,4,0.542,0.190)
call DzFrameSetPriority(UnifiedOrbToggleIcon,94)
set UnifiedOrbToggleButton=DzCreateFrameByTagName("TEXTBUTTON","UnifiedOrbToggleButton",GameUI,"Glyph_Button",310)
call DzFrameSetSize(UnifiedOrbToggleButton,0.026,0.026)
call DzFrameClearAllPoints(UnifiedOrbToggleButton)
call DzFrameSetAbsolutePoint(UnifiedOrbToggleButton,4,0.542,0.190)
call DzFrameSetPriority(UnifiedOrbToggleButton,95)
call DzFrameSetAlpha(UnifiedOrbToggleButton,0)
call DzFrameSetScriptByCode(UnifiedOrbToggleButton,1,function UnifiedOrbToggle_OnFrameClick,false)
call SetFrameToolTip(UnifiedOrbToggleButton,"统一法球总开关","默认开启。关闭后，你拥有的英雄不会触发冰箭、毒性攻击、推进、灼热之箭、智慧之刃、秘法天球和沸血之矛的统一法球效果，也不会产生对应的魔法或生命消耗。再次点击可恢复。")
set UnifiedOrbToggleStateText=DzCreateFrameByTagName("TEXT",null,UnifiedOrbToggleIcon,"CheckBox_Text",310)
call DzFrameSetPoint(UnifiedOrbToggleStateText,8,UnifiedOrbToggleIcon,8,0.,0.)
call DzFrameSetPriority(UnifiedOrbToggleStateText,96)
call DzFrameSetEnable(UnifiedOrbToggleStateText,false)
call DzFrameShow(UnifiedOrbToggleIcon,GetPlayerController(orbTogglePlayer)==MAP_CONTROL_USER)
call DzFrameShow(UnifiedOrbToggleButton,GetPlayerController(orbTogglePlayer)==MAP_CONTROL_USER)
call DzFrameShow(UnifiedOrbToggleStateText,GetPlayerController(orbTogglePlayer)==MAP_CONTROL_USER)
call UnifiedOrbToggle_RefreshLocal(orbTogglePlayer)
set orbTogglePlayer=null
endfunction
// 关闭更新日志
function InitSetUpHotKeyEditFrame takes nothing returns nothing
	local integer index=1
	local integer row=0
	local integer column=0
	local integer quickText
	local trigger t
	set HotKeyEditBoxFrame=DzCreateFrameByTagName("FRAME",null,UIFrame__SetUp,null,0)
	call DzFrameSetPriority(HotKeyEditBoxFrame,-1)
	call DzFrameSetSize(HotKeyEditBoxFrame,0.30,0.20)
	loop
		set HotKeyButton[index]=DzCreateFrameByTagName("TEXTBUTTON",null,HotKeyEditBoxFrame,"HotKeyButton__Template",0)
		call DzFrameSetText(HotKeyButton[index],"-")
		call DzFrameSetAbsolutePoint(HotKeyButton[index],4,0.51+0.05*row,0.504-0.045*column)
		call DzFrameSetScriptByCode(HotKeyButton[index],1,function HotKeyButtonClick,false)
		set HotKeyButtonHighlight[index]=DzCreateFrameByTagName("BACKDROP",null,HotKeyButton[index],"HotKeyHighlight__Template",0)
		call DzFrameSetAllPoints(HotKeyButtonHighlight[index],HotKeyButton[index])
		call DzFrameShow(HotKeyButtonHighlight[index],false)
		set HotKeyQuickCastCheck[index]=DzCreateFrameByTagName("GLUECHECKBOX",null,HotKeyEditBoxFrame,"SetUp_CheckBox",0)
		call SetFrameToolTip(HotKeyQuickCastCheck[index],"快速施法","快捷键按下时在鼠标指针位置立刻释放技能。")
		call DzFrameSetSize(HotKeyQuickCastCheck[index],0.015,0.015)
		call DzFrameSetPoint(HotKeyQuickCastCheck[index],4,HotKeyButton[index],7,-0.015,-0.007)
		call DzFrameSetScriptByCode(HotKeyQuickCastCheck[index],7,function HotKeyQuickCastClick,false)
		call DzFrameSetScriptByCode(HotKeyQuickCastCheck[index],8,function HotKeyQuickCastClick,false)
		set HotKeyQuickCastHighlight[index]=DzCreateFrameByTagName("HIGHLIGHT",null,HotKeyQuickCastCheck[index],"SetUp_CheckBox_Highlight",0)
		call DzFrameSetAllPoints(HotKeyQuickCastHighlight[index],HotKeyQuickCastCheck[index])
		call DzFrameShow(HotKeyQuickCastHighlight[index],false)
		set quickText=DzCreateFrameByTagName("TEXT",null,HotKeyQuickCastCheck[index],"CheckBox_Text",0)
		call DzFrameSetPoint(quickText,3,HotKeyQuickCastCheck[index],5,0.,0.)
		call DzFrameSetText(quickText,"快速施法")
		set HotKeyQuickCastText[index]=quickText
		if ModuloInteger(index,2)==0 then
			set column=column+1
			set row=0
		else
			set row=row+1
		endif
		exitwhen index==6
		set index=index+1
	endloop
	set index=7
	set row=0
	set column=0
	loop
		set HotKeyButton[index]=DzCreateFrameByTagName("TEXTBUTTON",null,HotKeyEditBoxFrame,"HotKeyButton__Template",0)
		call DzFrameSetText(HotKeyButton[index],"-")
		call DzFrameSetAbsolutePoint(HotKeyButton[index],4,0.46+0.05*row,0.35-0.045*column)
		call DzFrameSetScriptByCode(HotKeyButton[index],1,function HotKeyButtonClick,false)
		set HotKeyButtonHighlight[index]=DzCreateFrameByTagName("BACKDROP",null,HotKeyButton[index],"HotKeyHighlight__Template",0)
		call DzFrameSetAllPoints(HotKeyButtonHighlight[index],HotKeyButton[index])
		call DzFrameShow(HotKeyButtonHighlight[index],false)
		set HotKeyQuickCastCheck[index]=DzCreateFrameByTagName("GLUECHECKBOX",null,HotKeyEditBoxFrame,"SetUp_CheckBox",0)
		call SetFrameToolTip(HotKeyQuickCastCheck[index],"快速施法","快捷键按下时在鼠标指针位置立刻释放技能。")
		call DzFrameSetSize(HotKeyQuickCastCheck[index],0.015,0.015)
		call DzFrameSetPoint(HotKeyQuickCastCheck[index],4,HotKeyButton[index],7,-0.015,-0.007)
		call DzFrameSetScriptByCode(HotKeyQuickCastCheck[index],7,function HotKeyQuickCastClick,false)
		call DzFrameSetScriptByCode(HotKeyQuickCastCheck[index],8,function HotKeyQuickCastClick,false)
		set HotKeyQuickCastHighlight[index]=DzCreateFrameByTagName("HIGHLIGHT",null,HotKeyQuickCastCheck[index],"SetUp_CheckBox_Highlight",0)
		call DzFrameSetAllPoints(HotKeyQuickCastHighlight[index],HotKeyQuickCastCheck[index])
		call DzFrameShow(HotKeyQuickCastHighlight[index],false)
		set quickText=DzCreateFrameByTagName("TEXT",null,HotKeyQuickCastCheck[index],"CheckBox_Text",0)
		call DzFrameSetPoint(quickText,3,HotKeyQuickCastCheck[index],5,0.,0.)
		call DzFrameSetText(quickText,"快速施法")
		set HotKeyQuickCastText[index]=quickText
		if ModuloInteger(index-7,4)==3 then
			set column=column+1
			set row=0
		else
			set row=row+1
		endif
		exitwhen index==18
		set index=index+1
	endloop
	set t=CreateTrigger()
	call TriggerAddCondition(t,Condition(function SeEditBoxKeyEvent))
	call MHMsgKeyDownEvent_Register(t)
	call UpdateHotKeyState()
	set t=null
endfunction
function Click_OKButton_Script takes nothing returns nothing
	set UpdateLogIsShow = false
	call DzFrameShow( UIFrame__UpdateLog , false)
endfunction
function Click_SetUp_GlueCheckBox_Actions takes integer id returns nothing
	if id == 0 then //显示蓝条
		set XSLT = UIFrame__IsCheckBoxEnable[id]
        call MHUI_EnableDrawMPBar(XSLT)
		call GetSetUpText("显示蓝条", XSLT)
        if XSLT==false and XSLTOnlyFriend then 
            set UIFrame__IsCheckBoxEnable[1] = not UIFrame__IsCheckBoxEnable[1]
            call DzFrameShow( UIFrame__HighLight[1], UIFrame__IsCheckBoxEnable[1] )
            set XSLTOnlyFriend = UIFrame__IsCheckBoxEnable[1]
            call MHUI_OnlyDrawAllyMPBar(XSLTOnlyFriend)
        endif
	elseif id == 1 then //仅显示友方蓝条
		set XSLTOnlyFriend = UIFrame__IsCheckBoxEnable[id]
        if XSLT == false and XSLTOnlyFriend then 
            set UIFrame__IsCheckBoxEnable[0] = not UIFrame__IsCheckBoxEnable[0]
            call DzFrameShow( UIFrame__HighLight[0], UIFrame__IsCheckBoxEnable[0] )
            call Click_SetUp_GlueCheckBox_Actions(0)
        endif
        call MHUI_OnlyDrawAllyMPBar(XSLTOnlyFriend)
		call GetSetUpText("仅显示友方蓝条", XSLTOnlyFriend)	
	elseif id == 2 then
        set bDoubleClickSystemIsEnable = UIFrame__IsCheckBoxEnable[id]
        call GetSetUpText("双击对己施法", bDoubleClickSystemIsEnable)
	elseif id == 12 then
        set IsCapsLockEnableMultiboard = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("CapsLock键开启多面板", UIFrame__IsCheckBoxEnable[id])
    elseif id == 13 then
        call DzEnableWideScreen(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("宽屏模式", UIFrame__IsCheckBoxEnable[id])
	elseif id == 14 then
        set AltShowAttackRange = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("Alt显示防御塔攻击范围", UIFrame__IsCheckBoxEnable[id])
	elseif id == 15 then
        set AltShowRefreshRange = UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("Alt显示野怪刷新范围", UIFrame__IsCheckBoxEnable[id])
	elseif id == 16 then
        call MHUI_EnableDrawAbilsHotkey(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启技能热键显示", UIFrame__IsCheckBoxEnable[id])
	elseif id == 17 then
        call MHUI_EnableDrawAbilsCooldown(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启技能冷却显示", UIFrame__IsCheckBoxEnable[id])
	elseif id == 18 then
        call MHUI_EnableDrawItemsCooldown(UIFrame__IsCheckBoxEnable[id])
		call GetSetUpText("开启物品冷却显示", UIFrame__IsCheckBoxEnable[id])
	elseif id == 20 then
		set UseChangeHotKeySystem=UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("开启改键",UseChangeHotKeySystem)
		call UpdateHotKeyState()
	elseif id == 21 then
		set ItemChangeHotkeyHeroOnly=UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("物品改键仅限英雄",ItemChangeHotkeyHeroOnly)
	elseif id == 22 then
		set SkillChangeHotkeyHeroOnly=UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("技能改键仅限英雄",SkillChangeHotkeyHeroOnly)
	elseif id == 23 then
		set BanOldHotkey=UIFrame__IsCheckBoxEnable[id]
		call GetSetUpText("改键屏蔽原始按键",BanOldHotkey)
    else //其他都需要同步
        call DzSyncData("setup", I2S(id))
    endif
endfunction
//初始勾选的复选框回调
function Click_SetUp_GlueCheckBox_true takes nothing returns nothing
    local integer id = R2I(((DzGetTriggerUIEventFrame() - FirstCheckBox) / Frame_X ))
	call ClearAllEditBoxFocus()
	if (id==21 or id==22 or id==23) and not UseChangeHotKeySystem then
		return
	endif
    set UIFrame__IsCheckBoxEnable[id] = not UIFrame__IsCheckBoxEnable[id]
    call DzFrameShow( UIFrame__HighLight[id], UIFrame__IsCheckBoxEnable[id] )
	call Click_SetUp_GlueCheckBox_Actions(id)
endfunction
// 创建复选框 id为序号,xy的值是UI的绝对位置,b为是否初始勾选
function Create__CheckBox takes integer id, string tip, boolean b returns string
    local real x
    local real y 
    if id > 9 then
        set x = CheckBox_WidthInitialValue + CheckBox_WidthSpacing
        set y = CheckBox_HeightInitialValue - CheckBox_HeightSpacing * (id - 10)
    else
        set x = CheckBox_WidthInitialValue
        set y = CheckBox_HeightInitialValue - CheckBox_HeightSpacing * id
    endif
    // 复选框,父UI为"地图设置"
    set UIFrame__CheckBox[id] = DzCreateFrameByTagName("GLUECHECKBOX", "name", UIFrame__OrderSetUp, "SetUp_CheckBox", id)
    call DzFrameSetAbsolutePoint( UIFrame__CheckBox[id], 4, x, y )
    set UIFrame__IsCheckBoxEnable[id] = b
	set Default_SetUp[id] = b
    set UIFrame__HighLight[id] = DzCreateFrameByTagName("HIGHLIGHT", "name", UIFrame__CheckBox[id], "SetUp_CheckBox_Highlight", id)
    call DzFrameSetAllPoints( UIFrame__HighLight[id], UIFrame__CheckBox[id] )
    if not b then
        call DzFrameShow(UIFrame__HighLight[id], false)
    endif
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    // 初始勾选的复选框回调与初始不勾选不同,需脚本来控制高亮模型隐藏/显示
    // 事件Id,  7是勾选复选框,8是取消勾选
    call DzFrameSetScriptByCode( UIFrame__CheckBox[id], 7, function Click_SetUp_GlueCheckBox_true, false)
    call DzFrameSetScriptByCode( UIFrame__CheckBox[id], 8, function Click_SetUp_GlueCheckBox_true, false)
    // 复选框注释
    set UIFrame__CheckBoxText[id] = DzCreateFrameByTagName("TEXT", "name", UIFrame__CheckBox[id], "CheckBox_Text", id)
    call DzFrameSetPoint( UIFrame__CheckBoxText[id], 3, UIFrame__CheckBox[id], 5, 0.005, 0.0 )
    call DzFrameSetText( UIFrame__CheckBoxText[id], tip)
	return tip
endfunction
function CapsLock0 takes nothing returns nothing
	if IsCapsLockEnableMultiboard then
		call MultiboardMinimize(T4, true)
	endif
endfunction
function CapsLock1 takes nothing returns nothing
	if IsCapsLockEnableMultiboard then
		if IsMultiboardMinimized(T4) then
			call MultiboardMinimize(T4, false)
		endif
	endif
endfunction
