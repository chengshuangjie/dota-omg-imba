call YZ8(ZX7)
call YW8(ZX7,0,0)
call SetUnitVertexColor(b1060GetTriggerUnit,200,0,0,$FF)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call B1023RegisterDamage(t,ZX7)
call TriggerAddCondition(t,Condition(function OLD))
call NT7(OB7,"Source",ZX7)
call NP7(OB7,"Skill",skill)
call NP7(OB7,"Level",level)
call O37(ZX7,"JINU",7.*SuijiMode_GetDurationMulticastCount(ZX7,skill))
set t=null
set ZX7=null
set b1060GetTriggerUnit=null
endfunction
