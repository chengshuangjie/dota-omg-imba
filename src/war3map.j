function JGS takes nothing returns nothing
	local player p=GetTriggerPlayer()
	local integer id=GetPlayerId(p)
	local unit u=M7[id]
	local real cool=GetUnitState(u, UNIT_STATE_ATTACK1_COOL)
	local real speed=GetUnitState(u, UNIT_STATE_ATTACK1_SPEED)
	local real d
	call DisplayTimedTextToPlayer(p,0,0,10,GetUnitName(u)+" 基础攻击间隔为："+SubString(R2S(cool),0,3))
	call DisplayTimedTextToPlayer(p,0,0,10,"当前攻击速度为："+I2S(R2I(speed*100))+ "  (上限500，超出按500计算)")
	set speed=RMinBJ(speed,5)
	set d=cool/speed
	call DisplayTimedTextToPlayer(p,0,0,10,"相当于 "+R2S(d)+" 秒攻击一次")
	set p=null
	set u=null
endfunction
