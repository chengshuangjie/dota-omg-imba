endfunction
// B908 diagnostics only: no gameplay state is written and no health is polled.
function B908HealLogReset takes nothing returns nothing
local integer healLogSlot=1
if B908HealLogTimer!=null then
call PauseTimer(B908HealLogTimer)
call DestroyTimer(B908HealLogTimer)
set B908HealLogTimer=null
endif
loop
exitwhen healLogSlot>B908HealLogSize
set B908HealLogSource[healLogSlot]=null
set B908HealLogTarget[healLogSlot]=null
set healLogSlot=healLogSlot+1
endloop
set B908HealLogSize=0
set B908HealLogOverflow=0
set B908HealLogOverflowAmount=0.
endfunction
function B908HealLogUnit takes unit healLogUnit returns string
if healLogUnit==null or GetUnitTypeId(healLogUnit)==0 then
return "无来源/已移除"
endif
return GetUnitName(healLogUnit)+"#"+I2S(GetHandleId(healLogUnit))
endfunction
function B908HealLogFlush takes nothing returns nothing
local integer healLogSlot=1
local string healLogLabel=""
if B908HealingLog then
loop
exitwhen healLogSlot>B908HealLogSize
if B908HealLogKind[healLogSlot]==1 then
set healLogLabel="技能治疗"
elseif B908HealLogKind[healLogSlot]==2 then
set healLogLabel="生命连接-技能份额"
elseif B908HealLogKind[healLogSlot]==3 then
set healLogLabel="圣光法杖"
elseif B908HealLogKind[healLogSlot]==4 then
set healLogLabel="回春圣枝主动"
else
set healLogLabel="春潮"
endif
call BJDebugMsg("|cFF66FF99[治疗检测:"+healLogLabel+"]|r "+B908HealLogUnit(B908HealLogSource[healLogSlot])+" -> "+B908HealLogUnit(B908HealLogTarget[healLogSlot])+" 次数="+I2S(B908HealLogCount[healLogSlot])+" 基础="+R2S(B908HealLogBase[healLogSlot])+" 应恢复="+R2S(B908HealLogRequested[healLogSlot])+" 实际="+R2S(B908HealLogEffective[healLogSlot])+" 未恢复="+R2S(RMaxBJ(0.,B908HealLogRequested[healLogSlot]-B908HealLogEffective[healLogSlot]))+" 首次血量="+R2S(B908HealLogBefore[healLogSlot])+" 末次血量="+R2S(B908HealLogAfter[healLogSlot])+" 恩泽="+R2S(B908HealLogGrace[healLogSlot])+" 待转春潮="+R2S(B908HealLogSpring[healLogSlot]))
set healLogSlot=healLogSlot+1
endloop
if B908HealLogOverflow>0 then
call BJDebugMsg("|cFF66FF99[治疗检测:限流]|r 本窗口另有"+I2S(B908HealLogOverflow)+"次治疗未展开，实际恢复合计="+R2S(B908HealLogOverflowAmount)+"；每来源最多8组、全局最多32组/秒。")
endif
endif
call B908HealLogReset()
endfunction
function B908RecordHeal takes unit healLogSource,unit healLogTarget,integer healLogKind,real healLogBase,real healLogRequested,real healLogBefore,real healLogAfter returns nothing
local integer healLogSlot=1
local integer healLogSourceGroups=0
if not B908HealingLog then
return
endif
loop
exitwhen healLogSlot>B908HealLogSize
exitwhen B908HealLogSource[healLogSlot]==healLogSource and B908HealLogTarget[healLogSlot]==healLogTarget and B908HealLogKind[healLogSlot]==healLogKind
if B908HealLogSource[healLogSlot]==healLogSource then
set healLogSourceGroups=healLogSourceGroups+1
endif
set healLogSlot=healLogSlot+1
endloop
if healLogSlot>B908HealLogSize then
if B908HealLogSize>=32 or healLogSourceGroups>=8 then
set B908HealLogOverflow=B908HealLogOverflow+1
set B908HealLogOverflowAmount=B908HealLogOverflowAmount+RMaxBJ(0.,healLogAfter-healLogBefore)
return
endif
set B908HealLogSize=healLogSlot
set B908HealLogSource[healLogSlot]=healLogSource
set B908HealLogTarget[healLogSlot]=healLogTarget
set B908HealLogKind[healLogSlot]=healLogKind
set B908HealLogCount[healLogSlot]=0
set B908HealLogBase[healLogSlot]=0.
set B908HealLogRequested[healLogSlot]=0.
set B908HealLogEffective[healLogSlot]=0.
set B908HealLogBefore[healLogSlot]=healLogBefore
endif
set B908HealLogCount[healLogSlot]=B908HealLogCount[healLogSlot]+1
set B908HealLogBase[healLogSlot]=B908HealLogBase[healLogSlot]+healLogBase
set B908HealLogRequested[healLogSlot]=B908HealLogRequested[healLogSlot]+healLogRequested
set B908HealLogEffective[healLogSlot]=B908HealLogEffective[healLogSlot]+RMaxBJ(0.,healLogAfter-healLogBefore)
set B908HealLogAfter[healLogSlot]=healLogAfter
set B908HealLogGrace[healLogSlot]=LoadReal(L7,GetHandleId(healLogSource),StringHash("B907Grace"))
set B908HealLogSpring[healLogSlot]=LoadReal(L7,GetHandleId(healLogSource),StringHash("B907Spring"))*.25
if B908HealLogTimer==null then
set B908HealLogTimer=CreateTimer()
call TimerStart(B908HealLogTimer,1.,false,function B908HealLogFlush)
endif
endfunction
// Only audited skill-heal callsites enter here. Damage refunds and item heals do not.
function B907ApplySkillHeal takes unit healSource,unit healTarget,real healAmount,boolean healTagTether returns nothing
local real healBefore=0.
local real healEffective=0.
local real healBaseEffective=0.
local real healLogBase=healAmount
local integer healLogKind=1
local boolean healBranch=false
local boolean healCup=false
local integer healKey=0
if healTarget==null or GetUnitTypeId(healTarget)==0 or not UnitAlive(healTarget) or healAmount<=0. then
return
endif
// IMBA: skill heal x IMBA_POWER once, before overheal clamp and the 1.15 spring branch.
if XOMG_IMBA_ENABLED then
set healAmount=healAmount*IMBA_POWER
endif
if healSource!=healTarget and B907RealHero(healSource) and B907RealHero(healTarget) and IsUnitAlly(healTarget,GetOwningPlayer(healSource)) then
set healBranch=B907HasItem(healSource,'I7AA')
set healCup=B907HasItem(healSource,'I7AG')
endif
set healBefore=GetWidgetLife(healTarget)
set healBaseEffective=RMaxBJ(0.,RMinBJ(healAmount,GetUnitState(healTarget,UNIT_STATE_MAX_LIFE)-healBefore))
if healBranch then
set healAmount=healAmount*1.15
endif
call SetUnitState(healTarget,UNIT_STATE_LIFE,healBefore+healAmount)
set healEffective=RMaxBJ(0.,GetWidgetLife(healTarget)-healBefore)
// Tag only the base skill heal; equipment amplification/secondary heals never relay.
if healTagTether and healBaseEffective>0. and B907RealHero(healSource) and B907RealHero(healTarget) and IsUnitAlly(healTarget,GetOwningPlayer(healSource)) and LoadBoolean(L7,GetHandleId(healTarget),StringHash("SuijiTetherActive")) then
call SaveReal(L7,GetHandleId(healTarget),StringHash("B907TetherHeal"),LoadReal(L7,GetHandleId(healTarget),StringHash("B907TetherHeal"))+RMinBJ(healBaseEffective,healEffective))
endif
if healEffective>0. and (healBranch or healCup) then
set healKey=GetHandleId(healSource)
if B907Healers!=null then
call GroupAddUnit(B907Healers,healSource)
endif
if healBranch then
call SaveReal(L7,healKey,StringHash("B907Spring"),RMinBJ(1000.,LoadReal(L7,healKey,StringHash("B907Spring"))+healEffective))
endif
if healCup then
call SaveReal(L7,healKey,StringHash("B907Grace"),RMinBJ(600.,LoadReal(L7,healKey,StringHash("B907Grace"))+healEffective*.2))
call SaveReal(L7,healKey,StringHash("B907LastHeal"),GetGameTime())
endif
endif
if B908HealingLog then
if not healTagTether then
set healLogKind=2
endif
call B908RecordHeal(healSource,healTarget,healLogKind,healLogBase,healAmount,healBefore,GetWidgetLife(healTarget))
endif
endfunction
function B907SkillHeal takes unit healSource,unit healTarget,real healAmount returns nothing
call B907ApplySkillHeal(healSource,healTarget,healAmount,true)
endfunction
