function QZE takes nothing returns nothing
local unit m5=GetEnumUnit()
local integer id=GetPlayerId(GetOwningPlayer(m5))
local real CP7=(TimerGetElapsed(W))
local real mp
local real hp
local real DUR=LoadReal(TABLE_HY, GetHandleId(m5),StringHash("DUR"))
local real LIFE=LoadReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE"))
local unit ZX7=LoadUnitHandle(TABLE_HY, GetHandleId(m5),StringHash("SOURCE"))
local integer level=LoadInteger(TABLE_HY, GetHandleId(m5),StringHash("LEVEL"))
local integer interval
if m5!=null and UnitAlive(m5) and GetUnitAbilityLevel(m5,'B0CD')==0 and DUR>CP7 then
	call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("DUR"),0)
endif
if m5!=null and UnitAlive(m5) and GetUnitAbilityLevel(m5,'B0CD')>0 then
	if DUR>CP7 then
		set hp=GetUnitState(m5,UNIT_STATE_LIFE)
		set mp=GetUnitState(m5,UNIT_STATE_MANA)
		if hp<LIFE then
			call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE"),hp)
		endif
		call SetUnitState(m5,UNIT_STATE_LIFE,LoadReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE")))
		set interval=LoadInteger(TABLE_HY, GetHandleId(m5),StringHash("INTERVAL"))
		set interval=interval+1
		if interval==$A then
			set interval=0
			if level==1 then
				call B67(ZX7,m5,1,12.5)
			elseif level==2 then
				call B67(ZX7,m5,1,20)
			elseif level==3 then
				call B67(ZX7,m5,1,32)
			endif
		endif
		call SaveInteger(TABLE_HY, GetHandleId(m5),StringHash("INTERVAL"),interval)
	elseif DUR>CP7 and UnitAlive(m5)==false then
		call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("DUR"),0)
		call SaveReal(TABLE_HY, GetHandleId(m5),StringHash("LIFE"),99999)
	endif
if GetUnitAbilityLevel(m5,'B0CD')>0 and DUR<CP7 then
call UnitRemoveAbility(m5,'A1JA')
call UnitRemoveAbility(m5,'B0CD')
call UnitRemoveAbility(m5,'A1LD')
