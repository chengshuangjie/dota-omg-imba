call XPE(O5,'A21W','A21X','A21V','A21Y','A1GU',1,1)
elseif i1=='N0EG' then
call XPE(O5,'A12J','A12K','A14I','A12P','A1D6',1,1)
elseif i1=='E02N' then
call XPE(O5,'A1SO','A1SQ','A229','A1T5','A235',1,1)
elseif i1=='O01F' then
call XPE(O5,'A1TA','A1T8','A28Q','A1TB',0,1,1)
elseif i1=='H00S' then
call XPE(O5,'A14P','A14R','A0QW','A14O','A2Z6',1,1)
elseif i1=='O016' then
call XPE(O5,'A1EL','A19V','A19Z','A19O','A1MV',1,1)
elseif i1=='E02H' then
call XPE(O5,'A1S8','A1SB','A1S4','A2ZM','A2ZN',1,1)
elseif i1=='N0M0' then
call XPE(O5,'A2H3','A2H0','A2HS','A2JK','A3JK',1,1)
elseif i1=='E02K' then
call XPE(O5,'A2JB','A2J2','A2EY','A2CI','A2SB',1,1)
elseif i1=='H0DO' then
call XPE(O5,'A2BE','A2IT','A2HN','A2BG','A2SA',1,1)
elseif i1=='E032' then
call XPE(O5,'A2FK','A2E3','A2E4','A2E5','A2SI',1,1)
elseif(i1=='N0MD')then
call XPE(O5,'A2V1','A2V2','A2V3','A2V0','A2XP',1,1)
elseif(i1=='N0MU')then
call XPE(O5,'A2V6','A2V4','A2V5','A2V7','A2Z3',1,1)
elseif(i1=='Z052')then
call XPE(O5,'A4CO','A4CP','A4CQ','A4CR','A4DA',1,1)
elseif(i1=='Z01U')then
call XPE(O5,'A4ID','A4IE','A4II','A4IK',0,1,1)
elseif(i1=='Z060')then
call XPE(O5,'A4IU','A4IS','A4IT','A4IX',0,1,1)
elseif i1=='Z061' then
call XPE(O5,'A6L0','A6L1','A6L2','A6L3',0,8,1)
//单位不在皮肤英雄中会被设置默认技能表
elseif XWE_PIFU(O5,it,i1)==false then
call XPE(O5,HM4[GetUnitPointValue(it)],HN4[GetUnitPointValue(it)],HO4[GetUnitPointValue(it)],HP4[GetUnitPointValue(it)],HQ4[GetUnitPointValue(it)],1,1)
endif
set bj_forLoopAIndex=O5
call XNE(i1)
endfunction
function XWE_SWAP takes nothing returns nothing
call XWE(GetPlayerId(GetOwningPlayer(U22)),U22,GetUnitTypeId(U22))
endfunction
function XXE takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
call GQ9(b1060GetTriggerUnit)
if(GetPlayerController(GetOwningPlayer(b1060GetTriggerUnit))==MAP_CONTROL_COMPUTER)then
if GetUnitTypeId(b1060GetTriggerUnit)!='H00J' then
call ExecuteFunc("UD")
else
call ExecuteFunc("xh")
endif
elseif GetUnitTypeId(b1060GetTriggerUnit)!='H00J' then
if not(((QA4!=null)and(IsTriggerEnabled(QA4)))and(((GetOwningPlayer(b1060GetTriggerUnit)==QT4)and(QV4!=null))or((GetOwningPlayer(b1060GetTriggerUnit)==QU4)and(QW4!=null))))then
set bj_lastLoadedUnit=b1060GetTriggerUnit
call XWE(GetPlayerId(GetOwningPlayer(bj_lastLoadedUnit)),bj_lastLoadedUnit,GetUnitTypeId(bj_lastLoadedUnit))
call ExecuteFunc("XYE")
endif
endif
set b1060GetTriggerUnit=null
endfunction
function SuijiTest_ModeText takes nothing returns string
if SUIJI_MODE then
return " SUIJI=1"
endif
return " SUIJI=0"
