set IH7=null
set C9F=null
set CDF=null
set l=null
set tpCastleLanding=null
set t=null
set ML9=null
set fx=null
endfunction
function TpSlot_OnSpellEffect takes nothing returns nothing
local unit hero=GetTriggerUnit()
local player p=GetOwningPlayer(hero)
local integer pid=GetPlayerId(p)
local integer mode=TpSlotCastMode[pid]
local unit target=TpSlotForcedTarget[pid]
local integer tp1120Request=TpSlotCastRequestSerial[pid]
if GetPlayerController(p)!=MAP_CONTROL_USER or hero!=M7[pid] or hero!=TpSlotCastRequestUnit[pid] or tp1120Request==0 or mode<1 or mode>3 then
call B947IssueImmediateOrderById("TpSlot_OnSpellEffect invalid request B1120",hero,$D0004)
set target=null
set hero=null
set p=null
return
endif
// Consume the request once, before any native work can reenter the effect.
set TpSlotCastRequestSerial[pid]=0
set TpSlotCastRequestUnit[pid]=null
set TpSlotCastRequestUntil[pid]=0.
set TpSlotCastMode[pid]=0
set TpSlotActiveRequestSerial[pid]=tp1120Request
if mode==1 then
if TpSlotCharges[pid]>0 then
set TpSlotCharges[pid]=TpSlotCharges[pid]-1
set TpSlotCooldownRemaining[pid]=30
set TpSlotChannelActive[pid]=true
set TpSlotStopRequested[pid]=false
set TpSlotOrderGuard[pid]=false
set TpSlotPreserveChannel[pid]=false
call TpSlot_RefreshLocal(p)
call CEF()
else
call B947IssueImmediateOrderById("TpSlot_OnSpellEffect @ war3map.j:172469 (B968)",hero,$D0004)
endif
else
if target!=null and GetUnitTypeId(target)!=0 and GetWidgetLife(target)>.405 and IsUnitAlly(target,p) and target!=hero then
if mode==2 then
set TpSlotCooldownRemaining[pid]=20
else
set TpSlotCooldownRemaining[pid]=15
endif
set TpSlotChannelActive[pid]=true
set TpSlotStopRequested[pid]=false
set TpSlotOrderGuard[pid]=false
set TpSlotPreserveChannel[pid]=false
call TpSlot_RefreshLocal(p)
call CGF()
else
call B947IssueImmediateOrderById("TpSlot_OnSpellEffect @ war3map.j:172485 (B968)",hero,$D0004)
endif
endif
set TpSlotForcedTarget[pid]=null
set TpSlotCastX[pid]=0.
set TpSlotCastY[pid]=0.
set TpSlotActiveRequestSerial[pid]=0
set target=null
set hero=null
set p=null
endfunction
function TpSlot_OnCastEnd takes nothing returns nothing
local unit tp1120Hero=GetTriggerUnit()
local integer tp1120Player=GetPlayerId(GetOwningPlayer(tp1120Hero))
if B287_GetSpellAbilityId()=='A4T0' and tp1120Hero==TpSlotCastRequestUnit[tp1120Player] and not TpSlotChannelActive[tp1120Player] then
call TpSlot_ClearRequest(tp1120Player)
endif
if B287_GetSpellAbilityId()=='A4T0' and tp1120Hero==TpSlotCancelledRequestUnit[tp1120Player] then
set TpSlotCancelledRequestUnit[tp1120Player]=null
endif
set tp1120Hero=null
endfunction
function CIF takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
if b1060B287_GetSpellAbilityId=='A4T0' then
call TpSlot_OnSpellEffect()
elseif (b1060B287_GetSpellAbilityId=='A1R5' or b1060B287_GetSpellAbilityId=='A137') and KW7(b1060GetTriggerUnit)==false then
call CEF()
elseif b1060B287_GetSpellAbilityId=='A231' or b1060B287_GetSpellAbilityId=='A2Q6' then
call CGF()
endif
set b1060GetTriggerUnit=null
endfunction
function CJF takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if B287_GetSpellAbilityId()=='A137' and GetSpellTargetItem()!=null then
call B947IssueImmediateOrderById("CJF @ war3map.j:172506 (B968)",b1060GetTriggerUnit,$D0004)
if TV7(GetOwningPlayer(b1060GetTriggerUnit))then
call UnitUseItemTarget(b1060GetTriggerUnit,MV7(b1060GetTriggerUnit,YC),IZ4)
set WY4=true
else
call UnitUseItemTarget(b1060GetTriggerUnit,MV7(b1060GetTriggerUnit,YC),JA4)
set WY4=true
endif
endif
set b1060GetTriggerUnit=null
endfunction
function CKF takes nothing returns nothing
if E_7==(LoadInteger(L7,(GetHandleId(GetEnumUnit())),(784)))then
call KillUnit(GetEnumUnit())
endif
endfunction
function CMF takes nothing returns boolean
local integer i=GetUnitTypeId(GetFilterUnit())
return i=='n00H' or i=='n00G' or i=='n00K' or i=='n00J' or i=='n00A' or i=='n006'
endfunction
function CNF takes nothing returns nothing
local integer b1061SavedB287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit ZX7=(b1061SavedGetTriggerUnit)
local unit COF
local unit CPF
local integer CQF
local integer CRF
local group g=WS7()
local real a=GetUnitFacing(ZX7)*bj_DEGTORAD
local real x1=GetUnitX(ZX7)+50*Cos(a)
local real y1=GetUnitY(ZX7)+50*Sin(a)
local real x2=GetUnitX(ZX7)+50*Cos(a)
local real y2=GetUnitY(ZX7)+50*Sin(a)
if (b1061SavedB287_GetSpellAbilityId)=='A0HB' then
set CQF='n00H'
set CRF='n00J'
elseif (b1061SavedB287_GetSpellAbilityId)=='A0D3' then
set CQF='n00G'
set CRF='n00A'
elseif (b1061SavedB287_GetSpellAbilityId)=='A0DF' then
set CQF='n00K'
set CRF='n006'
endif
set E_7=GetUnitTypeId(ZX7)
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer((b1061SavedGetTriggerUnit)),Condition(function CMF))
call ForGroup(g,function CKF)
call WR7(g)
set COF=CreateUnit(GetOwningPlayer(ZX7),CQF,x1,y1,GetUnitFacing(ZX7))
call SaveInteger(L7,(GetHandleId(COF)),(784),(E_7))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",COF,"origin"))
call UnitApplyTimedLife(COF,'BTLF',35)
if TPFZ[GetPlayerId(GetOwningPlayer(ZX7))]then
call SelectUnitAddForPlayer(COF,GetOwningPlayer(ZX7))
endif
set CPF=CreateUnit(GetOwningPlayer(ZX7),CRF,x2,y2,GetUnitFacing(ZX7))
call SaveInteger(L7,(GetHandleId(CPF)),(784),(E_7))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl",CPF,"origin"))
call UnitApplyTimedLife(CPF,'BTLF',35)
if TPFZ[GetPlayerId(GetOwningPlayer(ZX7))]then
call SelectUnitAddForPlayer(CPF,GetOwningPlayer(ZX7))
endif
set g=null
set COF=null
set CPF=null
set ZX7=null
set b1061SavedGetTriggerUnit=null
endfunction
function CSF takes nothing returns nothing
if B287_GetSpellAbilityId()=='A0HB' or B287_GetSpellAbilityId()=='A0D3' or B287_GetSpellAbilityId()=='A0DF' then
call CNF()
endif
endfunction
function CTF takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
if B287_GetSpellAbilityId()=='A1FP' then
call YS7("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",b1060GetTriggerUnit,"origin",4)
call Z67(b1060GetTriggerUnit,'A1CN',1,4)
endif
set b1060GetTriggerUnit=null
endfunction
function CUF takes nothing returns boolean
return(OT7(GetFilterUnit(),"4323"))
endfunction
function YP77 takes unit hn returns nothing
local integer hnlife=R2I(GetUnitState(hn,UNIT_STATE_MAX_LIFE))
local integer SED
if hnlife<1400 then
set SED=1400-hnlife
call C77(hn,SED)
call SetUnitState(hn,UNIT_STATE_LIFE,hnlife+SED)
else
call SetUnitState(hn,UNIT_STATE_LIFE,GetUnitState(hn,UNIT_STATE_MAX_LIFE))
endif
call SetUnitState(hn,UNIT_STATE_MANA,GetUnitState(hn,UNIT_STATE_MAX_MANA))
endfunction
function CVF takes nothing returns nothing
local group g
local unit u
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local integer id=GetUnitTypeId(IH7)
local real d=GetUnitDefaultMoveSpeed(IH7)
local real d2=GetUnitDefaultMoveSpeed(ZX7)+I2R(U3V(ZX7))
if B287_GetSpellAbilityId()=='ACch' then
set g=WS7()
call GroupEnumUnitsOfPlayer(g,GetOwningPlayer(ZX7),Condition(function CUF))
set u=FirstOfGroup(g)
call WR7(g)
if u!=null then
call KillUnit(u)
endif
call OV7(IH7,"4323")
call UnitAddAbility(IH7,'Aeth')
call YP77(IH7)
call AddHeroXP(ZX7,R2I(EEGG(GetUnitLevel(IH7))),true)
if id=='nA00' then
call UnitAddAbility(IH7,'A2S7')
elseif id=='n026' then
call UnitAddAbility(IH7,'A2S7')
call UnitAddAbility(IH7,'ACmi')
endif
if d2>d then
call SetUnitMoveSpeed(IH7,R2I(d2))
endif
set g=null
set u=null
set ZX7=null
set IH7=null
endif
endfunction
