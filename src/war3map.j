function K19 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=O77(OB7,"Unit")
local integer n=0
local unit S4
//local integer i1=GetUnitTypeId(ZX7)
local integer i1=GetUnitPointValue(ZX7)
local real array d
local texttag tt
if GetTriggerEvalCount(t)==5 then
    call SetUnitPosition(ZX7,-7017.,6683.)
    call PauseUnitEx(ZX7,true)
    call SetUnitInvulnerable(ZX7,true)
    call DisplayTimedTextToPlayer(GetOwningPlayer(ZX7),0,0,10,"|cFF00FF00正在使用重建指令，请耐久等待30秒|r")
endif
if GetTriggerEvalCount(t)>5 and GetTriggerEvalCount(t)<36 then
set tt=CreateTextTag()
call SetTextTagText(tt,I2S(36-GetTriggerEvalCount(t)),.03)
call SetTextTagPosUnit(tt,ZX7,0)
call SetTextTagColorBJ(tt,0,29,$FF,$F)
call SetTextTagVelocity(tt,0,.035)
call SetTextTagFadepoint(tt,3)
call SetTextTagLifespan(tt,.9)
call SetTextTagPermanent(tt,false)
call SetTextTagVisibility(tt,true)
endif
if GetTriggerEvalCount(t)>35 then
    set S4=CreateUnit(GetOwningPlayer(ZX7),K34[i1],GetUnitX(ZX7),GetUnitY(ZX7),bj_UNIT_FACING)
    call SetHeroXP(S4,GetHeroXP(ZX7),false)
    set n=0
    loop
    exitwhen n>5
    set d[n]=B582_GetAbilityCooldown(ZX7,MHItem_GetAbilityId(UnitItemInSlot(ZX7, n),1))
    set n=n+1
    endloop
    call GAIN_ITEM(S4,ZX7)
    set n=0
    loop
    exitwhen n>5
    if d[n]>0 then
    call Set_Item_Drop(UnitItemInSlot(S4,n),d[n])
    endif
    set n=n+1
    endloop
    call CHANGE_HERO_SYNC(S4,ZX7,GetPlayerId(GetOwningPlayer(ZX7)))
    call YE7(ZX7)
    set M7[GetPlayerId(GetOwningPlayer(S4))]=S4
    call DisplayTimedTextToPlayer(GetOwningPlayer(ZX7),0,0,10,"|cFF00FF00已重建英雄|r")
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
set tt=null
set S4=null
set ZX7=null
endfunction
function K29 takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=M7[GetPlayerId(b1060GetTriggerPlayer)]
// call UnitAddAbility(ZX7,1093682761)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function K19))
call NT7(OB7,"Unit",ZX7)
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,30, "|cFF00FF00将在5秒后开始重建英雄|r")
set t=null
set ZX7=null
set b1060GetTriggerPlayer=null
endfunction
function IB9 takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local player p=b1060GetTriggerPlayer
local unit u=M7[GetPlayerId(p)]
if u==null then
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "英雄不存在，无法重建")
    set u=null
    set p=null
    set b1060GetTriggerPlayer=null
    return
endif
if UnitAlive(u)==false then
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "英雄已死亡，无法重建")
    set u=null
    set p=null
    set b1060GetTriggerPlayer=null
    return
endif
if LoadReal(TABLE_HY,GetHandleId(p),'FIXH')>GetGameTime() and SPEPLAYER[GetPlayerId(p)]!=1 then
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00该指令有2分钟使用间隔，请勿滥用该指令|r")
    set u=null
    set p=null
    set b1060GetTriggerPlayer=null
    return
endif
call SaveReal(TABLE_HY,GetHandleId(p),'FIXH',GetGameTime()+120.)
call K29()
set u=null
set p=null
set b1060GetTriggerPlayer=null
endfunction
///////////////////////////一键购买
function E4O takes unit u returns nothing
	local integer i = 0
	local item it
	local integer TME = GetPlayerId(GetOwningPlayer(u))
	local region r = CreateRegion()
	local boolean b = KW7(u) or GetUnitTypeId(u)=='ncop'
    local string name
	if TV7(GetOwningPlayer(u)) then
		call RegionAddRect(r, WAA)
	else
		call RegionAddRect(r, YAA)
	endif
	loop
	exitwhen i > 5
		set it = UnitItemInSlot(u, i)
		if it != null then
			set it = UnitRemoveItemFromSlot(u, i)
			call SetItemPosition(it,GetUnitX(u),GetUnitY(u))
			if b == false then
                set name=GetItemName(it)
                set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
				call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 7, "|c00ffff00" + name+ "|r 已被放置在你的能量圈中")
			endif
			if(GetUnitTypeId(u)=='ncop' or IsUnitInRegion(r, u)) and IsPlayerAlly(GetItemPlayer(it), GetOwningPlayer(u)) then //判断购买物品的单位是能量圈或者马甲单位在矩形区域中
				set TME = GetPlayerId(GetItemPlayer(it))
				call SetItemPosition(it, KV4[TME], KW4[TME])
			endif
		endif
		set i = i + 1
	endloop
	call RemoveRegion(r)
	set it = null
	set r = null
endfunction
function E5O takes unit u, integer id returns nothing
	local player p = GetOwningPlayer(u)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
    local integer index=Y38(id)
    local integer RTF=0
	local integer O5=GetPlayerId(p)
    if index==188 then
        set RTF=6
    elseif index==108 then
        set RTF=8
    endif
	call Y0F(p, u, GetSellingUnit(), index, x, y, RTF, 0)
	call Record_Buy_Item(p,O5,id)
	set p = null
endfunction
function E6O takes unit u returns unit
	local unit d = null
	local player p = GetOwningPlayer(u)
	if HaveSavedHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)== false or not UnitAlive(LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)) then
		set d = CreateUnit(p,'e00E', GetUnitX(KU4[GetPlayerId(p)]), GetUnitY(KU4[GetPlayerId(p)]), 0)
		call XF7(d,'AInv')
		call SaveUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1, d)
		call UnitPauseTimedLife(d, true)
	elseif HaveSavedHandle(TABLE_K, GetHandleId(p),'COUR'+ 1) then
		set d = LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR'+ 1)
		if p != GetOwningPlayer(d) then
			call SetUnitOwner(d, p, true)
			call SetUnitPosition(d, GetUnitX(KU4[GetPlayerId(p)]), GetUnitY(KU4[GetPlayerId(p)]))
		endif     
	endif
	set d = null
	set p = null
	return LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(u)),'COUR'+ 1)
endfunction
//神秘商店物品，不需要
// function E7O takes integer id returns boolean
// 	return id == NZV or id == I3V or id == X0V or id == X1V or id == OOV or id == OKV or id == X7V or id == OBV or id == RXV or id == OIV or id == X2V /or id == OCV or id == OUV or id == OTV
// endfunction
function E8O takes unit u, integer id returns boolean
	local unit d = E6O(u)
	local integer TBX = Get_Item_Price(ZU[id])
	local player p = GetOwningPlayer(u)
	local boolean b = false
    local string name
    set name=GetObjectName(ZU[id])
    set name=MHString_Sub(name , 0 , MHString_Find(name , "|n" , 0))
	if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)>= TBX then
		set b = true
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)-TBX)
		call E5O(d, id)
        call DisplayTimedTextToPlayer(p, 0,0,7, "已自动购买 "+"|c00fffc01"+name+"|r")
	else
		call DisplayTimedTextToPlayer(p, 0, 0, 7, L87("没有足够的金币来购买 $item", "$item", "|c00ffff00" + name+ "|r"))
	endif
	set d = null
	set p = null
	return b
endfunction
function E9O takes nothing returns boolean
	if Q22 < 12 and GetItemPlayer(GetFilterItem())== E33 and GetItemUserData(GetFilterItem())>= 0 and GetWidgetLife(GetFilterItem())> 1 then
		set Q22 = Q22 + 1
		return true
	endif
	return false
endfunction
function XVO takes nothing returns nothing
	call SaveItemHandle(TABLE_VV,'ITEM', Q22, GetEnumItem())
endfunction
function XWO takes integer i returns boolean
    return (LoadInteger(TABLE_HY,'ITEM', 0)==i or LoadInteger(TABLE_HY,'ITEM', 1)==i or LoadInteger(TABLE_HY,'ITEM', 2)==i or LoadInteger(TABLE_HY,'ITEM', 3)==i or LoadInteger(TABLE_HY,'ITEM', 4)==i or LoadInteger(TABLE_HY,'ITEM', 5)==i or LoadInteger(TABLE_HY,'ITEM', 6)==i or LoadInteger(TABLE_HY,'ITEM', 7)==i or LoadInteger(TABLE_HY,'ITEM', 8)==i or LoadInteger(TABLE_HY,'ITEM', 9)==i or LoadInteger(TABLE_HY,'ITEM', 10)==i or LoadInteger(TABLE_HY,'ITEM', 11)==i)
endfunction
