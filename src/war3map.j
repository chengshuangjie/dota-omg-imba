function SuijiMode_ChannelAIResponseLocked takes unit suijiChannelAIUnit,string suijiChannelAIKey,real suijiChannelAIDuration returns boolean
local integer suijiChannelAIHandle=0
local real suijiChannelAINow=TimerGetElapsed(W)
if SUIJI_MODE==false or suijiChannelAIUnit==null then
return false
endif
set suijiChannelAIHandle=GetHandleId(suijiChannelAIUnit)
if OO7(suijiChannelAIHandle,"SuijiDone")==false then
return false
endif
if ON7(suijiChannelAIHandle,suijiChannelAIKey)>suijiChannelAINow then
return true
endif
call NQ7(suijiChannelAIHandle,suijiChannelAIKey,suijiChannelAINow+suijiChannelAIDuration)
return false
endfunction
