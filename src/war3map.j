function SuijiMode_InitA1PH takes unit suijiA1PHUnit returns nothing
local integer suijiA1PHHandle=0
if suijiA1PHUnit==null or GetUnitTypeId(suijiA1PHUnit)==0 then
return
endif
set suijiA1PHHandle=GetHandleId(suijiA1PHUnit)
if OO7(suijiA1PHHandle,"SuijiA1PHInit") then
return
endif
call NS7(suijiA1PHHandle,"SuijiA1PHInit",true)
call SaveInteger(MSK,suijiA1PHHandle,0,'A4L2')
call SaveInteger(MSK,suijiA1PHHandle,1,'A4L3')
call SaveInteger(MSK,suijiA1PHHandle,2,'A4L4')
call SaveInteger(MSK,suijiA1PHHandle,3,'A4L5')
call SaveInteger(MSK,suijiA1PHHandle,4,'A4L6')
call Multiple_Skill(suijiA1PHUnit,4,0,30.,'A1PH',0)
endfunction
function SuijiReincarnation_CommandDebugPrint takes unit u,integer physicalSkill returns nothing
local integer h=0
local integer count=0
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 then
return
endif
if GetUnitAbilityLevel(u,'Y0BA')<=0 and GetUnitAbilityLevel(u,'Y0FQ')<=0 then
return
endif
set h=GetHandleId(u)
set count=LoadInteger(L7,h,StringHash("SuijiReincarnationCommandDebugCount"))
if count>=40 then
return
endif
call SaveInteger(L7,h,StringHash("SuijiReincarnationCommandDebugCount"),count+1)
call SuijiTest_DebugAll("REINC-CMD","P"+I2S(GetPlayerId(GetOwningPlayer(u))+1)+" hid="+I2S(h)+" spell="+I2S(physicalSkill)+" order="+I2S(GetUnitCurrentOrder(u))+" lvY0BA="+I2S(GetUnitAbilityLevel(u,'Y0BA'))+" lvY0FQ="+I2S(GetUnitAbilityLevel(u,'Y0FQ'))+" ready="+R2S(ON7(h,"SuijiReincarnationReadyAt")))
endfunction
function SuijiMode_ReincarnationCarrierCastGuard takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer physicalSkill=GetSpellAbilityId()
local ability a=null
call SuijiReincarnation_CommandDebugPrint(u,physicalSkill)
if u!=null and GetUnitTypeId(u)!=0 and (physicalSkill=='Y0BA' or physicalSkill=='Y0FQ') then
// Y0BA/Y0FQ are clickable only because Warcraft draws cooldown overlays on
// active-class buttons. Consume their dedicated order before CAST/EFFECT so a
// click can never become gameplay, Multicast, or an AI spell action.
call B947IssueImmediateOrder("SuijiMode_ReincarnationCarrierCastGuard @ war3map.j:187443 (B968)",u,"stop")
set a=EXGetUnitAbility(u,physicalSkill)
if a!=null then
call EXSetAbilityState(a,1,0.)
call MHAbility_SetCooldownEx(u,physicalSkill,0.,0.)
endif
if ON7(GetHandleId(u),"SuijiReincarnationReadyAt")>TimerGetElapsed(W) then
call SuijiMode_StartReincarnationCooldownGuard(u)
endif
endif
set a=null
set u=null
return false
endfunction
function SuijiMode_EnsureReincarnationCarrierCastGuard takes nothing returns nothing
local integer key=StringHash("SuijiReincarnationCarrierCastGuard")
local trigger t=LoadTriggerHandle(L7,key,0)
if t!=null then
set t=null
return
endif
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function SuijiMode_ReincarnationCarrierCastGuard))
call SaveTriggerHandle(L7,key,0,t)
set t=null
endfunction
function SuijiMode_InitA01Y takes unit suijiA01YUnit returns nothing
local integer suijiA01YHandle=0
if suijiA01YUnit==null or GetUnitTypeId(suijiA01YUnit)==0 then
return
endif
set suijiA01YHandle=GetHandleId(suijiA01YUnit)
if OO7(suijiA01YHandle,"SuijiA01YInit") then
return
endif
call NS7(suijiA01YHandle,"SuijiA01YInit",true)
call SuijiMode_EnsureReincarnationTrigger(suijiA01YUnit)
if GetUnitAbilityLevel(suijiA01YUnit,'Y0BA')>0 or GetUnitAbilityLevel(suijiA01YUnit,'Y0FQ')>0 then
call SuijiMode_EnsureReincarnationCarrierCastGuard()
endif
endfunction
function SuijiMode_A0S1Status takes nothing returns boolean
local trigger suijiA0S1StatusTrigger=GetTriggeringTrigger()
local integer suijiA0S1StatusHandle=GetHandleId(suijiA0S1StatusTrigger)
local unit suijiA0S1StatusUnit=LoadUnitHandle(L7,suijiA0S1StatusHandle,2)
if suijiA0S1StatusUnit==null or GetUnitTypeId(suijiA0S1StatusUnit)==0 or UnitAlive(suijiA0S1StatusUnit)==false or B287_GetUnitAbilityLevel(suijiA0S1StatusUnit,'A0S1')<=0 then
call FlushChildHashtable(L7,suijiA0S1StatusHandle)
call OZ7(suijiA0S1StatusTrigger)
else
call QJD()
endif
set suijiA0S1StatusUnit=null
set suijiA0S1StatusTrigger=null
return false
endfunction
function SuijiMode_InitA0S1 takes unit suijiA0S1Unit returns nothing
local trigger suijiA0S1Trigger
local integer suijiA0S1TriggerHandle=0
local integer suijiA0S1Handle=0
if suijiA0S1Unit==null or GetUnitTypeId(suijiA0S1Unit)==0 then
return
endif
set suijiA0S1Handle=GetHandleId(suijiA0S1Unit)
if OO7(suijiA0S1Handle,"SuijiA0S1Init") then
return
endif
call NS7(suijiA0S1Handle,"SuijiA0S1Init",true)
set suijiA0S1Trigger=CreateTrigger()
set suijiA0S1TriggerHandle=GetHandleId(suijiA0S1Trigger)
call TriggerRegisterTimerEvent(suijiA0S1Trigger,.1,true)
call TriggerRegisterDeathEvent(suijiA0S1Trigger,suijiA0S1Unit)
call TriggerAddCondition(suijiA0S1Trigger,Condition(function SuijiMode_A0S1Status))
call SaveUnitHandle(L7,suijiA0S1TriggerHandle,2,suijiA0S1Unit)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AR',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AS',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AU',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AT',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AQ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(suijiA0S1Unit),'A2AP',false)
set suijiA0S1Trigger=null
endfunction
