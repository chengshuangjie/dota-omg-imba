if (B287_GetSpellAbilityId()=='A4F3' or B287_GetSpellAbilityId()=='A4F4' or B287_GetSpellAbilityId()=='A4F5' or B287_GetSpellAbilityId()=='A4FU') then
call xp()
endif
return false
endfunction
function XXGL takes nothing returns boolean
local unit u=GetTriggerUnit()
local integer OB7=GetHandleId(u)
if (B287_GetLearnedSkill()=='A0LH' or B287_GetLearnedSkill()=='A2Z9') and IsUnitIllusion(u)==false then
if (B287_GetUnitAbilityLevel(u,'A0LH')==1 or B287_GetUnitAbilityLevel(u,'A2Z9')==1) then
call SaveInteger(MSK,(OB7),(0),('A4F3'))
call SaveInteger(MSK,(OB7),(1),('A4F4'))
call SaveInteger(MSK,(OB7),(2),('A4F5'))
call SaveInteger(MSK,(OB7),(3),('A4FU'))
call Multiple_Skill(u,1,3,50.,'A0LH','A2Z9')
endif
