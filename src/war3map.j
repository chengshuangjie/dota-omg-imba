function PGR_Reduce takes nothing returns real
	local real d=TimerGetElapsed(W)-M_4
	if d<1200 then
		return 0.33
	elseif d<1800 then
		return 0.5
	elseif d<2100 then
		return 0.66
	else
		return 1.
	endif
endfunction
function B1077IsCurrentAIHero takes unit earlyHero1077 returns boolean
local integer earlyPid1077=0
if earlyHero1077==null or GetUnitTypeId(earlyHero1077)==0 then
return false
endif
set earlyPid1077=GetPlayerId(GetOwningPlayer(earlyHero1077))
if earlyPid1077<0 or earlyPid1077>=12 then
return false
endif
return M7[earlyPid1077]==earlyHero1077 and GetPlayerController(Player(earlyPid1077))==MAP_CONTROL_COMPUTER and IsUnitType(earlyHero1077,UNIT_TYPE_HERO) and not IsUnitIllusion(earlyHero1077) and not DGFS(earlyHero1077)
endfunction
function B1077OnAIDeath takes nothing returns nothing
local unit earlyDead1077=GetTriggerUnit()
local integer earlyPid1077=0
local integer earlyLevel1077=0
if B1077IsCurrentAIHero(earlyDead1077) then
set earlyPid1077=GetPlayerId(GetOwningPlayer(earlyDead1077))
set earlyLevel1077=GetHeroLevel(earlyDead1077)
if not XM_CG or B1077DeathHero[earlyPid1077]!=earlyDead1077 or B1077DeathLevel[earlyPid1077]!=earlyLevel1077 or earlyLevel1077<1 or earlyLevel1077>=12 then
set B1077SameLevelDeaths[earlyPid1077]=0
set B1077ReviveBonusPending[earlyPid1077]=false
endif
set B1077DeathHero[earlyPid1077]=earlyDead1077
set B1077DeathLevel[earlyPid1077]=earlyLevel1077
if XM_CG and earlyLevel1077>=1 and earlyLevel1077<12 then
set B1077SameLevelDeaths[earlyPid1077]=B1077SameLevelDeaths[earlyPid1077]+1
if B1077SameLevelDeaths[earlyPid1077]>=2 then
set B1077ReviveBonusPending[earlyPid1077]=true
endif
endif
endif
set earlyDead1077=null
endfunction
function B1077ApplyReviveBonus takes nothing returns nothing
local timer earlyTimer1077=GetExpiredTimer()
local integer earlyKey1077=GetHandleId(earlyTimer1077)
local unit earlyRevived1077=LoadUnitHandle(L7,earlyKey1077,0)
local integer earlyPid1077=LoadInteger(L7,earlyKey1077,1)
local integer earlyLevel1077=LoadInteger(L7,earlyKey1077,2)
// Retire the timer even when the saved hero was removed or died again.
call FlushChildHashtable(L7,earlyKey1077)
call PauseTimer(earlyTimer1077)
call DestroyTimer(earlyTimer1077)
if not XM_CG and B1077DeathHero[earlyPid1077]==earlyRevived1077 then
set B1077ReviveBonusPending[earlyPid1077]=false
set B1077SameLevelDeaths[earlyPid1077]=0
endif
if B1077IsCurrentAIHero(earlyRevived1077) then
if XM_CG and UnitAlive(earlyRevived1077) and GetPlayerId(GetOwningPlayer(earlyRevived1077))==earlyPid1077 and B1077DeathHero[earlyPid1077]==earlyRevived1077 and B1077ReviveBonusPending[earlyPid1077] then
// Clear before SetHeroLevel: level-up callbacks may re-enter game systems.
set B1077ReviveBonusPending[earlyPid1077]=false
set B1077SameLevelDeaths[earlyPid1077]=0
if earlyLevel1077>=1 and earlyLevel1077<12 and B1077DeathLevel[earlyPid1077]==earlyLevel1077 and GetHeroLevel(earlyRevived1077)==earlyLevel1077 then
call SetHeroLevel(earlyRevived1077,earlyLevel1077+1,true)
if B1077IsCurrentAIHero(earlyRevived1077) then
if UnitAlive(earlyRevived1077) and GetHeroLevel(earlyRevived1077)==earlyLevel1077+1 then
call SetPlayerState(Player(earlyPid1077),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(earlyPid1077),PLAYER_STATE_RESOURCE_GOLD)+1000)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,8.,"CG模式AI前期补偿："+GetPlayerName(Player(earlyPid1077))+" 的 "+GetUnitName(earlyRevived1077)+" 连续两次在 "+I2S(earlyLevel1077)+" 级阵亡，复活后升至 "+I2S(earlyLevel1077+1)+" 级，并获得1000金币。")
endif
endif
endif
endif
endif
set earlyRevived1077=null
set earlyTimer1077=null
endfunction
function B1077OnAIRevive takes nothing returns nothing
local unit earlyRevived1077=GetTriggerUnit()
local integer earlyPid1077=0
local timer earlyTimer1077=null
if B1077IsCurrentAIHero(earlyRevived1077) then
set earlyPid1077=GetPlayerId(GetOwningPlayer(earlyRevived1077))
if not XM_CG then
set B1077ReviveBonusPending[earlyPid1077]=false
set B1077SameLevelDeaths[earlyPid1077]=0
elseif B1077DeathHero[earlyPid1077]==earlyRevived1077 and B1077ReviveBonusPending[earlyPid1077] then
// Run after the native revive stack; revalidate all saved state on expiry.
set earlyTimer1077=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(earlyTimer1077),0,earlyRevived1077)
call SaveInteger(L7,GetHandleId(earlyTimer1077),1,earlyPid1077)
call SaveInteger(L7,GetHandleId(earlyTimer1077),2,B1077DeathLevel[earlyPid1077])
call TimerStart(earlyTimer1077,.10,false,function B1077ApplyReviveBonus)
endif
endif
set earlyRevived1077=null
set earlyTimer1077=null
endfunction
