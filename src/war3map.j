function HAR takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	local integer hu = LoadInteger(TABLE_HY, h, 0)
	local integer HNR = LoadInteger(TABLE_HY, hu,'A0Fw')
	call RemoveSavedHandle(TABLE_HY, hu,'A0FW')
	call RemoveSavedInteger(TABLE_HY, hu,'A0FW')
	call RemoveSavedInteger(TABLE_HY, hu,'A0Fw')
	if GetHandleId(u)!= 0 then
		call UnitRemoveAbility(u, HNR)
		call UnitRemoveAbility(u,'B02U')
	endif
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function HBR takes nothing returns nothing
	local unit suijiBloodseekerCaster = U22
	local unit WLE = W22
	local integer level = IMinBJ(4,IMaxBJ(B287_GetUnitAbilityLevel(suijiBloodseekerCaster,'A0FW'),B287_GetUnitAbilityLevel(suijiBloodseekerCaster,'A4E9')))
	local integer HCR
	local integer HDR
	local integer HFR
	local timer t
	local integer hu = GetHandleId(WLE)
    local integer id=GetUnitTypeId(suijiBloodseekerCaster)
    if id=='Z018' then
        set HCR ='X4EC'-1 + level
    else
	    set HCR ='A4EC'-1 + level
    endif
	set HDR ='X4AA'+ 4 *(level -1)-1
	if GetUnitAbilityLevel(WLE,'B02U')== 0 then
		set HFR = 0
	else
		set HFR = LoadInteger(TABLE_HY, hu,'A0FW')
	endif
	if level > 0 then
		if HFR > 0 then
			call UnitRemoveAbility(WLE,'A4EC')
			call UnitRemoveAbility(WLE,'A4ED')
			call UnitRemoveAbility(WLE,'A4EE')
			call UnitRemoveAbility(WLE,'A4EF')
			call UnitRemoveAbility(WLE,'X4EC')
			call UnitRemoveAbility(WLE,'X4ED')
			call UnitRemoveAbility(WLE,'X4EE')
			call UnitRemoveAbility(WLE,'X4EF')
			call UnitRemoveAbility(WLE, LoadInteger(TABLE_HY, hu,'A0Fw'))
			call UnitRemoveAbility(WLE,'B02U')
		endif
		if HaveSavedHandle(TABLE_HY, hu,'A0FW') then
			set t = LoadTimerHandle(TABLE_HY, hu,'A0FW')
		else
			set t = CreateTimer()
			call SaveTimerHandle(TABLE_HY, hu,'A0FW', t)
			call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, WLE)
			call SaveInteger(TABLE_HY, GetHandleId(t), 0, hu)
		endif
		call SaveInteger(TABLE_HY, hu,'A0FW', IMinBJ(4, HFR + 1))
		call TimerStart(t, 5., false, function HAR)
		set t = null
		set HDR = HDR + IMinBJ(4, HFR + 1)
		call UnitAddPermanentAbility(WLE, HDR)
		call SaveInteger(TABLE_HY, hu,'A0Fw', HDR)
		call Z57(WLE, HCR, IMinBJ(4, HFR + 1), 5, 0)
	endif
    if B287_GetUnitAbilityLevel(suijiBloodseekerCaster,'A0FW')>0 then
        call LINGXIA(suijiBloodseekerCaster,WLE)
    endif
	set t = null
	set suijiBloodseekerCaster = null
	set WLE = null
endfunction
function Y8V takes unit ZX7 returns nothing
	local group g = WS7()
	local unit u
    local integer id=GetUnitTypeId(ZX7)
    local integer skillmj
    if id=='Z018' then
        set skillmj='h0GZ'
    else
        set skillmj='h0GY'
    endif
	set U22 = ZX7
	call GroupEnumUnitsInRange(g, GetUnitX(U22), GetUnitY(U22), 700+25, Condition(function DJX))
	loop
		set u = FirstOfGroup(g)
	exitwhen u == null
		call NHX(ZX7, u, skillmj, "HBR", 1000, true, "")
		call GroupRemoveUnit(g, u)
	endloop
	call WR7(g)
    set g=null
endfunction
function Y7V takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer skillmj
if b1060B287_GetSpellAbilityId=='A0FW' then
	if SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A0FW') then
        call Y8V(b1060GetTriggerUnit)
	elseif WQ7(b1060GetSpellTargetUnit)==false then
        if GetUnitTypeId(b1060GetTriggerUnit)=='Z018' then
            set skillmj='h0GZ'
        else
            set skillmj='h0GY'
        endif
		call NHX(b1060GetTriggerUnit, b1060GetSpellTargetUnit,skillmj , "HBR", 1000, true, "")
	endif
elseif b1060B287_GetSpellAbilityId=='A4E9' then
    call Y8V(b1060GetTriggerUnit)
endif
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
function EP8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function Y7V)
set t=null
endfunction
function VK9 takes nothing returns boolean
return(IsUnitType(GetEventDamageSource(),UNIT_TYPE_STRUCTURE)==false and ISPH(GetTriggerUnit())==false)!=null
endfunction
function BristlebackAghActive_QuillLevel takes unit bristlebackAghQuillUnit returns integer
local integer bristlebackAghQuillLevel=B287_GetUnitAbilityLevel(bristlebackAghQuillUnit,'A0GP')
if bristlebackAghQuillLevel>4 then
return 4
endif
if bristlebackAghQuillLevel>0 then
return bristlebackAghQuillLevel
endif
set bristlebackAghQuillLevel=B287_GetUnitAbilityLevel(bristlebackAghQuillUnit,'A0M3')
if bristlebackAghQuillLevel>4 then
return 4
elseif bristlebackAghQuillLevel>0 then
return bristlebackAghQuillLevel
endif
return 1
endfunction
function BristlebackAghActive_FireQuill takes unit bristlebackAghQuillSource returns nothing
local integer bristlebackAghQuillDummyHandle=0
local integer bristlebackAghQuillLevel=0
local unit bristlebackAghQuillDummy=null
if bristlebackAghQuillSource==null or GetUnitTypeId(bristlebackAghQuillSource)==0 or UnitAlive(bristlebackAghQuillSource)==false then
return
endif
set bristlebackAghQuillLevel=BristlebackAghActive_QuillLevel(bristlebackAghQuillSource)
set bristlebackAghQuillDummy=CreateUnit(GetOwningPlayer(bristlebackAghQuillSource),'e00E',GetUnitX(bristlebackAghQuillSource),GetUnitY(bristlebackAghQuillSource),0)
set bristlebackAghQuillDummyHandle=GetHandleId(bristlebackAghQuillDummy)
call SaveUnitHandle(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillSource"),bristlebackAghQuillSource)
call SaveInteger(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillLevel"),bristlebackAghQuillLevel)
call XF7(bristlebackAghQuillDummy,'A0GP')
call B287_SetUnitAbilityLevel(bristlebackAghQuillDummy,'A0GP',bristlebackAghQuillLevel)
call B947IssueImmediateOrderById("BristlebackAghActive_FireQuill @ war3map.j:66871 (B968)",bristlebackAghQuillDummy,OrderId("creepdevour"))
// Spell events from issued orders are synchronous.  The effect handler has
// already consumed these overrides on success; removing them again also
// closes the failed-order path without leaving per-dummy hashtable entries.
call RemoveSavedHandle(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillSource"))
call RemoveSavedInteger(L7,bristlebackAghQuillDummyHandle,StringHash("BristlebackAghQuillLevel"))
call UnitApplyTimedLife(bristlebackAghQuillDummy,'BTLF',1.)
set bristlebackAghQuillDummy=null
endfunction
function BristlebackAghActive_Debug takes unit bristlebackAghDebugUnit,string bristlebackAghDebugTag,string bristlebackAghDebugText returns nothing
local integer bristlebackAghDebugHandle=0
local integer bristlebackAghDebugCount=0
if SUIJI_CHAKRAM_LOG==false or bristlebackAghDebugUnit==null or GetUnitTypeId(bristlebackAghDebugUnit)==0 then
return
endif
set bristlebackAghDebugHandle=GetHandleId(bristlebackAghDebugUnit)
set bristlebackAghDebugCount=LoadInteger(L7,bristlebackAghDebugHandle,StringHash("BristlebackAghDebugCount"))
if bristlebackAghDebugCount>=48 then
return
endif
call SaveInteger(L7,bristlebackAghDebugHandle,StringHash("BristlebackAghDebugCount"),bristlebackAghDebugCount+1)
call BJDebugMsg("|cFF99CCFF[BB16-"+bristlebackAghDebugTag+"]|r hero="+GetUnitName(bristlebackAghDebugUnit)+"#"+I2S(bristlebackAghDebugHandle)+" "+bristlebackAghDebugText)
endfunction
// Opt-in input evidence only. Counters are local UI data, never gameplay state.
function B843GooLogEnabled takes unit u returns boolean
if B843GooLog==false or GetLocalPlayer()!=Le or u==null then
return false
endif
return GetUnitTypeId(u)=='H008' or GetUnitTypeId(u)=='Z018'
endfunction
function B843GooLogCooldown takes unit u,integer raw returns real
if GetUnitAbilityLevel(u,raw)<=0 then
return -1.
endif
return YDWEGetUnitAbilityState(u,raw,1)
endfunction
function B843GooLogEvent takes unit u,string phase,integer raw,integer order returns nothing
local integer key=StringHash("B843GooEvent"+I2S(B843GooLogSession))
local integer count=0
if B843GooLogEnabled(u)==false then
return
endif
set count=LoadInteger(LocalHashTable,GetHandleId(u),key)
if count>=40 then
return
endif
call SaveInteger(LocalHashTable,GetHandleId(u),key,count+1)
call DisplayTimedTextToPlayer(Le,0,0,25.,"[GOO-"+phase+"] raw="+AbilityId2String(raw)+" order="+I2S(order)+" FW/E9/BB="+I2S(GetUnitAbilityLevel(u,'A0FW'))+"/"+I2S(GetUnitAbilityLevel(u,'A4E9'))+"/"+I2S(GetUnitAbilityLevel(u,'ZBBA'))+" cdFW/E9/BB="+R2S(B843GooLogCooldown(u,'A0FW'))+"/"+R2S(B843GooLogCooldown(u,'A4E9'))+"/"+R2S(B843GooLogCooldown(u,'ZBBA')))
endfunction
function B843GooLogClick takes integer gooClickedButton returns nothing
local unit u=null
local integer key=StringHash("B843GooClick"+I2S(B843GooLogSession))
local integer count=0
local integer i=1
local integer entry=0
local string line=""
if B843GooLog==false or GetLocalPlayer()!=Le or gooClickedButton==0 then
return
endif
set u=MHPlayer_GetSelectUnit()
if B843GooLogEnabled(u)==false then
set u=null
return
endif
set count=LoadInteger(LocalHashTable,GetHandleId(u),key)
if count>=12 then
set u=null
return
endif
call SaveInteger(LocalHashTable,GetHandleId(u),key,count+1)
call DisplayTimedTextToPlayer(Le,0,0,25.,"[GOO-CLICK] raw="+AbilityId2String(MHUIData_GetCommandButtonAbility(gooClickedButton))+" order="+I2S(MHUIData_GetCommandButtonOrderId(gooClickedButton))+" type="+I2S(MHUIData_GetCommandButtonCastType(gooClickedButton))+" xy="+I2S(MHUIData_GetCommandButtonX(gooClickedButton))+","+I2S(MHUIData_GetCommandButtonY(gooClickedButton))+" key="+I2S(MHUIData_GetCommandButtonHotkey(gooClickedButton)))
// First two clicks capture the full card, including hidden/engine occupants.
if count<2 then
loop
exitwhen i>12
set entry=MHUI_GetSkillBarButton(i)
if entry!=0 then
set line=line+" #"+I2S(i)+":"+AbilityId2String(MHUIData_GetCommandButtonAbility(entry))+"/"+I2S(MHUIData_GetCommandButtonOrderId(entry))+"/"+I2S(MHUIData_GetCommandButtonX(entry))+","+I2S(MHUIData_GetCommandButtonY(entry))
endif
if ModuloInteger(i,4)==0 then
call DisplayTimedTextToPlayer(Le,0,0,25.,"[GOO-CARD]"+line)
set line=""
endif
set i=i+1
endloop
endif
set u=null
endfunction
function BristlebackAghActive_OnRawOrder takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local real b1060GetOrderPointX=GetOrderPointX()
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local boolean b1060ReturnValue
local unit bristlebackAghRawOrderUnit=GetTriggerUnit()
local unit bristlebackAghRawOrderTarget=null
local trigger bristlebackAghRawOrderController=null
local eventid bristlebackAghRawOrderEvent=GetTriggerEventId()
local integer bristlebackAghRawOrderId=0
local integer bristlebackAghRawOrderGuard=0
local string bristlebackAghRawOrderKind="IMMEDIATE"
local string bristlebackAghRawOrderExtra=""
if B843GooLog then
call B843GooLogEvent(bristlebackAghRawOrderUnit,"ORDER",0,b1060GetIssuedOrderId)
endif
if SUIJI_CHAKRAM_LOG==false or bristlebackAghRawOrderUnit==null or GetUnitTypeId(bristlebackAghRawOrderUnit)==0 or GetUnitAbilityLevel(bristlebackAghRawOrderUnit,'ZBBA')<=0 then
set bristlebackAghRawOrderUnit=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
return b1060ReturnValue
endif
set bristlebackAghRawOrderId=b1060GetIssuedOrderId
set bristlebackAghRawOrderController=LoadTriggerHandle(L7,GetHandleId(bristlebackAghRawOrderUnit),StringHash("BristlebackAghController"))
if bristlebackAghRawOrderController!=null and LoadBoolean(L7,GetHandleId(bristlebackAghRawOrderController),StringHash("BristlebackAghOrderGuard")) then
set bristlebackAghRawOrderGuard=1
endif
if bristlebackAghRawOrderEvent==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER then
set bristlebackAghRawOrderKind="POINT"
set bristlebackAghRawOrderExtra=" point="+R2S(b1060GetOrderPointX)+","+R2S(b1060GetOrderPointY)
elseif bristlebackAghRawOrderEvent==EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER then
set bristlebackAghRawOrderKind="TARGET"
set bristlebackAghRawOrderTarget=b1060GetOrderTargetUnit
set bristlebackAghRawOrderExtra=" target="+I2S(GetHandleId(bristlebackAghRawOrderTarget))
endif
call BristlebackAghActive_Debug(bristlebackAghRawOrderUnit,"ORDER",bristlebackAghRawOrderKind+" issued="+I2S(bristlebackAghRawOrderId)+" current="+I2S(GetUnitCurrentOrder(bristlebackAghRawOrderUnit))+" guard="+I2S(bristlebackAghRawOrderGuard)+" controller="+I2S(GetHandleId(bristlebackAghRawOrderController))+bristlebackAghRawOrderExtra)
set bristlebackAghRawOrderUnit=null
set bristlebackAghRawOrderTarget=null
set bristlebackAghRawOrderController=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
return b1060ReturnValue
endfunction
function BristlebackAghActive_CooldownTick takes nothing returns nothing
local timer bristlebackAghCooldownTimer=GetExpiredTimer()
local integer bristlebackAghCooldownTimerHandle=GetHandleId(bristlebackAghCooldownTimer)
local unit bristlebackAghCooldownUnit=LoadUnitHandle(L7,bristlebackAghCooldownTimerHandle,StringHash("BristlebackAghCooldownUnit"))
local real bristlebackAghCooldownDuration=LoadReal(L7,bristlebackAghCooldownTimerHandle,StringHash("BristlebackAghCooldownDuration"))
if bristlebackAghCooldownUnit!=null and GetUnitTypeId(bristlebackAghCooldownUnit)!=0 and GetUnitAbilityLevel(bristlebackAghCooldownUnit,'ZBBA')>0 and bristlebackAghCooldownDuration>.01 then
call YDWESetUnitAbilityState(bristlebackAghCooldownUnit,'ZBBA',1,bristlebackAghCooldownDuration)
call MHAbility_SetCooldownEx(bristlebackAghCooldownUnit,'ZBBA',bristlebackAghCooldownDuration,bristlebackAghCooldownDuration)
call BristlebackAghActive_Debug(bristlebackAghCooldownUnit,"COOLDOWN","duration="+R2S(bristlebackAghCooldownDuration)+" ex="+R2S(B582_GetAbilityCooldown(bristlebackAghCooldownUnit,'ZBBA')))
endif
call FlushChildHashtable(L7,bristlebackAghCooldownTimerHandle)
call PauseTimer(bristlebackAghCooldownTimer)
call DestroyTimer(bristlebackAghCooldownTimer)
set bristlebackAghCooldownUnit=null
set bristlebackAghCooldownTimer=null
endfunction
function BristlebackAghActive_StartCooldown takes unit bristlebackAghCooldownUnit returns nothing
local timer bristlebackAghCooldownTimer=null
local real bristlebackAghCooldownDuration=20.
local real bristlebackAghCooldownFactor=0.
if bristlebackAghCooldownUnit==null or GetUnitTypeId(bristlebackAghCooldownUnit)==0 or GetUnitAbilityLevel(bristlebackAghCooldownUnit,'ZBBA')<=0 then
return
endif
set bristlebackAghCooldownFactor=ReduceUnitAbilityCoolDownReal(bristlebackAghCooldownUnit)
if bristlebackAghCooldownFactor>0. then
set bristlebackAghCooldownDuration=bristlebackAghCooldownDuration*bristlebackAghCooldownFactor
endif
set bristlebackAghCooldownTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(bristlebackAghCooldownTimer),StringHash("BristlebackAghCooldownUnit"),bristlebackAghCooldownUnit)
call SaveReal(L7,GetHandleId(bristlebackAghCooldownTimer),StringHash("BristlebackAghCooldownDuration"),bristlebackAghCooldownDuration)
call TimerStart(bristlebackAghCooldownTimer,0.,false,function BristlebackAghActive_CooldownTick)
set bristlebackAghCooldownTimer=null
endfunction
function BristlebackAghActive_Cleanup takes trigger bristlebackAghController returns nothing
local integer bristlebackAghControllerHandle=0
local integer bristlebackAghCasterHandle=0
local real bristlebackAghResumeX=0.
local real bristlebackAghResumeY=0.
local unit bristlebackAghCaster=null
if bristlebackAghController==null then
return
endif
set bristlebackAghControllerHandle=GetHandleId(bristlebackAghController)
set bristlebackAghCaster=LoadUnitHandle(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghCaster"))
if bristlebackAghCaster!=null then
set bristlebackAghCasterHandle=GetHandleId(bristlebackAghCaster)
call BristlebackAghActive_Debug(bristlebackAghCaster,"CLEAN","controller="+I2S(bristlebackAghControllerHandle)+" tick="+I2S(LoadInteger(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghTick")))+" moving="+I2S(B287_BoolToInt(LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving"))))+" saved="+I2S(B287_BoolToInt(LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveCommandSaved")))))
if LoadTriggerHandle(L7,bristlebackAghCasterHandle,StringHash("BristlebackAghController"))==bristlebackAghController then
call RemoveSavedHandle(L7,bristlebackAghCasterHandle,StringHash("BristlebackAghController"))
endif
if LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving")) then
call ResetUnitAnimation(bristlebackAghCaster)
endif
// The 16-platform controller preserves the accepted move/smart destination
// while it supplies the reverse displacement.  Resume that unfinished move
// only when no stop, attack, spell, or replacement order cleared it.
if UnitAlive(bristlebackAghCaster) and LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveCommandSaved")) then
set bristlebackAghResumeX=LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetX"))
set bristlebackAghResumeY=LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetY"))
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghOrderGuard"),true)
call B947IssuePointOrderById("BristlebackAghActive_Cleanup @ war3map.j:67054 (B968)",bristlebackAghCaster,OrderId("move"),bristlebackAghResumeX,bristlebackAghResumeY)
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghOrderGuard"),false)
endif
endif
call FlushChildHashtable(L7,bristlebackAghControllerHandle)
call OZ7(bristlebackAghController)
set bristlebackAghCaster=null
endfunction
function BristlebackAghActive_OnControllerEvent takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local real b1060GetOrderPointX=GetOrderPointX()
local real b1060GetOrderPointY=GetOrderPointY()
local unit b1060GetOrderTargetUnit=GetOrderTargetUnit()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger bristlebackAghController=GetTriggeringTrigger()
local integer bristlebackAghControllerHandle=GetHandleId(bristlebackAghController)
local integer bristlebackAghOrderId=0
local integer bristlebackAghTick=0
local real bristlebackAghMoveAngle=0.
local real bristlebackAghMoveDistance=0.
local real bristlebackAghMoveDeltaX=0.
local real bristlebackAghMoveDeltaY=0.
local real bristlebackAghMoveTargetX=0.
local real bristlebackAghMoveTargetY=0.
local real bristlebackAghLogBeforeX=0.
local real bristlebackAghLogBeforeY=0.
local unit bristlebackAghCaster=LoadUnitHandle(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghCaster"))
local unit bristlebackAghOrderTarget=null
if bristlebackAghCaster==null or GetUnitTypeId(bristlebackAghCaster)==0 or UnitAlive(bristlebackAghCaster)==false or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call BristlebackAghActive_Cleanup(bristlebackAghController)
set bristlebackAghController=null
set bristlebackAghCaster=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER or b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER then
if LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghOrderGuard")) then
set bristlebackAghController=null
set bristlebackAghCaster=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set bristlebackAghOrderId=b1060GetIssuedOrderId
call BristlebackAghActive_Debug(bristlebackAghCaster,"CTRL-ORDER","controller="+I2S(bristlebackAghControllerHandle)+" event="+I2S(GetHandleId(b1060GetTriggerEventId))+" issued="+I2S(bristlebackAghOrderId)+" guard=0")
// An instant Channel cast emits one native stop after ENDCAST.  It arrives
// after the controller is registered but before its first .03 second pulse,
// so treating it as a player cancellation prevents all reverse movement.
// Ignore only that one startup stop; any intervening command consumes the
// exemption and every stop from tick one onward remains a real cancellation.
if bristlebackAghOrderId==OrderId("stop") and LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghIgnoreInitialStop")) and LoadInteger(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghTick"))==0 then
call RemoveSavedBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghIgnoreInitialStop"))
call BristlebackAghActive_Debug(bristlebackAghCaster,"AUTO-STOP-IGNORED","controller="+I2S(bristlebackAghControllerHandle)+" issued="+I2S(bristlebackAghOrderId))
set bristlebackAghController=null
set bristlebackAghCaster=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
call RemoveSavedBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghIgnoreInitialStop"))
if bristlebackAghOrderId==OrderId("move") or bristlebackAghOrderId==OrderId("smart") then
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER then
set bristlebackAghMoveTargetX=b1060GetOrderPointX
set bristlebackAghMoveTargetY=b1060GetOrderPointY
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_TARGET_ORDER then
set bristlebackAghOrderTarget=b1060GetOrderTargetUnit
if bristlebackAghOrderTarget!=null then
set bristlebackAghMoveTargetX=GetUnitX(bristlebackAghOrderTarget)
set bristlebackAghMoveTargetY=GetUnitY(bristlebackAghOrderTarget)
endif
endif
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_POINT_ORDER or bristlebackAghOrderTarget!=null then
call SaveReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetX"),bristlebackAghMoveTargetX)
call SaveReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetY"),bristlebackAghMoveTargetY)
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving"),true)
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveCommandSaved"),true)
// Match the 16-platform zero-delay hold-position handoff: accept and save the
// player's destination first, then suppress Warcraft's forward path on the
// next bounded controller pulse.  This keeps the command cursor/order stack
// outside the synchronous issued-order callback.
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghHoldPending"),true)
call BristlebackAghActive_Debug(bristlebackAghCaster,"MOVE-SAVE","controller="+I2S(bristlebackAghControllerHandle)+" order="+I2S(bristlebackAghOrderId)+" target="+R2S(bristlebackAghMoveTargetX)+","+R2S(bristlebackAghMoveTargetY))
endif
else
if LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving")) then
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving"),false)
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghHoldPending"),false)
call ResetUnitAnimation(bristlebackAghCaster)
endif
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveCommandSaved"),false)
endif
set bristlebackAghOrderTarget=null
set bristlebackAghController=null
set bristlebackAghCaster=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set bristlebackAghTick=LoadInteger(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghTick"))+1
call SaveInteger(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghTick"),bristlebackAghTick)
if bristlebackAghTick==1 then
call RemoveSavedBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghIgnoreInitialStop"))
endif
if bristlebackAghTick==1 or bristlebackAghTick==12 or bristlebackAghTick==17 or bristlebackAghTick==40 or bristlebackAghTick==64 or bristlebackAghTick==87 then
set bristlebackAghLogBeforeX=GetUnitX(bristlebackAghCaster)
set bristlebackAghLogBeforeY=GetUnitY(bristlebackAghCaster)
endif
if LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving")) and LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghHoldPending")) then
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghHoldPending"),false)
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghOrderGuard"),true)
call B947IssueImmediateOrderById("BristlebackAghActive_OnControllerEvent @ war3map.j:67152 (B968)",bristlebackAghCaster,OrderId("holdposition"))
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghOrderGuard"),false)
call SetUnitAnimation(bristlebackAghCaster,"walk")
endif
// Lock the back direction recorded by the original spell-target click for the
// complete active window.  Later move/smart clicks may change displacement,
// but never overwrite this angle; suppress their temporary forward pathing
// order above, then restore the original facing on every controller pulse.
call SetUnitFacing(bristlebackAghCaster,LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghFacing")))
if LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving")) and IsUnitPaused(bristlebackAghCaster)==false and IsUnitType(bristlebackAghCaster,UNIT_TYPE_STUNNED)==false and IsUnitType(bristlebackAghCaster,UNIT_TYPE_SNARED)==false and IsUnitType(bristlebackAghCaster,UNIT_TYPE_POLYMORPHED)==false then
set bristlebackAghMoveTargetX=LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetX"))
set bristlebackAghMoveTargetY=LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetY"))
set bristlebackAghMoveDeltaX=bristlebackAghMoveTargetX-GetUnitX(bristlebackAghCaster)
set bristlebackAghMoveDeltaY=bristlebackAghMoveTargetY-GetUnitY(bristlebackAghCaster)
set bristlebackAghMoveDistance=SquareRoot(bristlebackAghMoveDeltaX*bristlebackAghMoveDeltaX+bristlebackAghMoveDeltaY*bristlebackAghMoveDeltaY)
if bristlebackAghMoveDistance>1. then
set bristlebackAghMoveAngle=Atan2(bristlebackAghMoveDeltaY,bristlebackAghMoveDeltaX)
if GetUnitMoveSpeed(bristlebackAghCaster)*.03<bristlebackAghMoveDistance then
set bristlebackAghMoveDistance=GetUnitMoveSpeed(bristlebackAghCaster)*.03
endif
// Match the 16-platform set_position(target, false, false) path: direct
// coordinate writes bypass pathing/collision and, critically, do not emit the
// native stop order that SetUnitPosition produces after every displacement.
call SetUnitX(bristlebackAghCaster,GetUnitX(bristlebackAghCaster)+bristlebackAghMoveDistance*Cos(bristlebackAghMoveAngle))
call SetUnitY(bristlebackAghCaster,GetUnitY(bristlebackAghCaster)+bristlebackAghMoveDistance*Sin(bristlebackAghMoveAngle))
else
call SaveBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving"),false)
call ResetUnitAnimation(bristlebackAghCaster)
endif
endif
// 16-platform timing: .5 second turn-back delay, then four sprays at .7
// second spacing.  The .03 controller pulse keeps these boundaries bounded
// and deterministic without introducing a second high-frequency scanner.
if bristlebackAghTick==17 or bristlebackAghTick==40 or bristlebackAghTick==64 or bristlebackAghTick==87 then
call BristlebackAghActive_FireQuill(bristlebackAghCaster)
endif
if bristlebackAghTick==1 or bristlebackAghTick==12 or bristlebackAghTick==17 or bristlebackAghTick==40 or bristlebackAghTick==64 or bristlebackAghTick==87 then
call BristlebackAghActive_Debug(bristlebackAghCaster,"TICK","controller="+I2S(bristlebackAghControllerHandle)+" tick="+I2S(bristlebackAghTick)+" before="+R2S(bristlebackAghLogBeforeX)+","+R2S(bristlebackAghLogBeforeY)+" after="+R2S(GetUnitX(bristlebackAghCaster))+","+R2S(GetUnitY(bristlebackAghCaster))+" target="+R2S(LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetX")))+","+R2S(LoadReal(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoveTargetY")))+" moving="+I2S(B287_BoolToInt(LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghMoving"))))+" hold="+I2S(B287_BoolToInt(LoadBoolean(L7,bristlebackAghControllerHandle,StringHash("BristlebackAghHoldPending"))))+" current="+I2S(GetUnitCurrentOrder(bristlebackAghCaster)))
endif
if bristlebackAghTick>=87 then
call BristlebackAghActive_Cleanup(bristlebackAghController)
endif
set bristlebackAghController=null
set bristlebackAghCaster=null
set b1060ReturnValue=false
set b1060GetOrderTargetUnit=null
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function BristlebackAghActive_Start takes unit bristlebackAghCaster,real bristlebackAghFacing,real bristlebackAghInitialTargetX,real bristlebackAghInitialTargetY returns nothing
local integer bristlebackAghCasterHandle=0
local trigger bristlebackAghController=null
local trigger bristlebackAghPreviousController=null
if bristlebackAghCaster==null or GetUnitTypeId(bristlebackAghCaster)==0 or UnitAlive(bristlebackAghCaster)==false then
return
endif
set bristlebackAghCasterHandle=GetHandleId(bristlebackAghCaster)
set bristlebackAghPreviousController=LoadTriggerHandle(L7,bristlebackAghCasterHandle,StringHash("BristlebackAghController"))
call BristlebackAghActive_Debug(bristlebackAghCaster,"START-BEFORE","previous="+I2S(GetHandleId(bristlebackAghPreviousController))+" facing="+R2S(bristlebackAghFacing)+" xy="+R2S(GetUnitX(bristlebackAghCaster))+","+R2S(GetUnitY(bristlebackAghCaster))+" current="+I2S(GetUnitCurrentOrder(bristlebackAghCaster)))
if bristlebackAghPreviousController!=null then
call BristlebackAghActive_Cleanup(bristlebackAghPreviousController)
endif
set bristlebackAghController=CreateTrigger()
call SaveUnitHandle(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghCaster"),bristlebackAghCaster)
call SaveReal(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghFacing"),bristlebackAghFacing)
call SaveReal(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghMoveTargetX"),bristlebackAghInitialTargetX)
call SaveReal(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghMoveTargetY"),bristlebackAghInitialTargetY)
call SaveBoolean(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghMoving"),true)
call SaveBoolean(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghMoveCommandSaved"),false)
call SaveBoolean(L7,GetHandleId(bristlebackAghController),StringHash("BristlebackAghIgnoreInitialStop"),true)
call SaveTriggerHandle(L7,bristlebackAghCasterHandle,StringHash("BristlebackAghController"),bristlebackAghController)
// 16-platform begins from hold position and performs reverse displacement on
// a 30 ms private controller; it never leaves a normal forward move running.
call B947IssueImmediateOrderById("BristlebackAghActive_Start @ war3map.j:67222 (B968)",bristlebackAghCaster,OrderId("holdposition"))
call SetUnitFacing(bristlebackAghCaster,bristlebackAghFacing)
call SetUnitAnimation(bristlebackAghCaster,"walk")
call BristlebackAghActive_Debug(bristlebackAghCaster,"START-AFTER","controller="+I2S(GetHandleId(bristlebackAghController))+" current="+I2S(GetUnitCurrentOrder(bristlebackAghCaster))+" initial="+R2S(bristlebackAghInitialTargetX)+","+R2S(bristlebackAghInitialTargetY)+" moving=1")
call TriggerRegisterTimerEvent(bristlebackAghController,.03,true)
call TriggerRegisterUnitEvent(bristlebackAghController,bristlebackAghCaster,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(bristlebackAghController,bristlebackAghCaster,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(bristlebackAghController,bristlebackAghCaster,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(bristlebackAghController,bristlebackAghCaster,EVENT_UNIT_DEATH)
call TriggerAddCondition(bristlebackAghController,Condition(function BristlebackAghActive_OnControllerEvent))
set bristlebackAghController=null
set bristlebackAghPreviousController=null
endfunction
function BristlebackAghActive_AIActivateTick takes nothing returns nothing
local timer bristlebackAghAITimer=GetExpiredTimer()
local integer bristlebackAghAITimerHandle=GetHandleId(bristlebackAghAITimer)
local integer bristlebackAghAIUnitHandle=0
local integer bristlebackAghAIPlayerId=0
local real bristlebackAghAITargetX=LoadReal(L7,bristlebackAghAITimerHandle,StringHash("BristlebackAghAITargetX"))
local real bristlebackAghAITargetY=LoadReal(L7,bristlebackAghAITimerHandle,StringHash("BristlebackAghAITargetY"))
local real bristlebackAghAIDeltaX=0.
local real bristlebackAghAIDeltaY=0.
local real bristlebackAghAIFacing=0.
local unit bristlebackAghAIUnit=LoadUnitHandle(L7,bristlebackAghAITimerHandle,StringHash("BristlebackAghAIUnit"))
if bristlebackAghAIUnit!=null then
set bristlebackAghAIUnitHandle=GetHandleId(bristlebackAghAIUnit)
call RemoveSavedBoolean(L7,bristlebackAghAIUnitHandle,StringHash("BristlebackAghAIActivatePending"))
endif
if bristlebackAghAIUnit!=null and GetUnitTypeId(bristlebackAghAIUnit)!=0 and UnitAlive(bristlebackAghAIUnit) and IsUnitIllusion(bristlebackAghAIUnit)==false then
set bristlebackAghAIPlayerId=GetPlayerId(GetOwningPlayer(bristlebackAghAIUnit))
set bristlebackAghAIDeltaX=bristlebackAghAITargetX-GetUnitX(bristlebackAghAIUnit)
set bristlebackAghAIDeltaY=bristlebackAghAITargetY-GetUnitY(bristlebackAghAIUnit)
if (GetPlayerController(GetOwningPlayer(bristlebackAghAIUnit))==MAP_CONTROL_COMPUTER or KKLeaveAI_Active[bristlebackAghAIPlayerId]) and B287_GetUnitAbilityLevel(bristlebackAghAIUnit,'A0M3')>0 and SuijiMode_ScepterRegistryIsActive(bristlebackAghAIUnit,'A0M3') and GetUnitAbilityLevel(bristlebackAghAIUnit,'ZBBA')>0 and B581_AIAbilityReady(bristlebackAghAIUnit,'ZBBA') and GetUnitState(bristlebackAghAIUnit,UNIT_STATE_MANA)>=100. and IsUnitPaused(bristlebackAghAIUnit)==false and IsUnitType(bristlebackAghAIUnit,UNIT_TYPE_STUNNED)==false and IsUnitType(bristlebackAghAIUnit,UNIT_TYPE_POLYMORPHED)==false and MHUnit_GetSilenceCount(bristlebackAghAIUnit)<=0 and LoadTriggerHandle(L7,bristlebackAghAIUnitHandle,StringHash("BristlebackAghController"))==null and bristlebackAghAIDeltaX*bristlebackAghAIDeltaX+bristlebackAghAIDeltaY*bristlebackAghAIDeltaY>1. then
set bristlebackAghAIFacing=Atan2(bristlebackAghAIDeltaY,bristlebackAghAIDeltaX)*bj_RADTODEG+180.
call SetUnitState(bristlebackAghAIUnit,UNIT_STATE_MANA,GetUnitState(bristlebackAghAIUnit,UNIT_STATE_MANA)-100.)
call BristlebackAghActive_Start(bristlebackAghAIUnit,bristlebackAghAIFacing,bristlebackAghAITargetX,bristlebackAghAITargetY)
call BristlebackAghActive_StartCooldown(bristlebackAghAIUnit)
call BristlebackAghActive_Debug(bristlebackAghAIUnit,"AI-START","target="+R2S(bristlebackAghAITargetX)+","+R2S(bristlebackAghAITargetY)+" facing="+R2S(bristlebackAghAIFacing))
endif
endif
call FlushChildHashtable(L7,bristlebackAghAITimerHandle)
call PauseTimer(bristlebackAghAITimer)
call DestroyTimer(bristlebackAghAITimer)
set bristlebackAghAIUnit=null
set bristlebackAghAITimer=null
endfunction
function BristlebackAghActive_QueueAIActivate takes unit bristlebackAghAIUnit,real bristlebackAghAITargetX,real bristlebackAghAITargetY returns boolean
local integer bristlebackAghAIUnitHandle=0
local integer bristlebackAghAIPlayerId=0
local real bristlebackAghAIDeltaX=0.
local real bristlebackAghAIDeltaY=0.
local timer bristlebackAghAITimer=null
if bristlebackAghAIUnit==null or GetUnitTypeId(bristlebackAghAIUnit)==0 or UnitAlive(bristlebackAghAIUnit)==false or IsUnitIllusion(bristlebackAghAIUnit) then
return false
endif
set bristlebackAghAIUnitHandle=GetHandleId(bristlebackAghAIUnit)
set bristlebackAghAIPlayerId=GetPlayerId(GetOwningPlayer(bristlebackAghAIUnit))
if (GetPlayerController(GetOwningPlayer(bristlebackAghAIUnit))!=MAP_CONTROL_COMPUTER and KKLeaveAI_Active[bristlebackAghAIPlayerId]==false) or B287_GetUnitAbilityLevel(bristlebackAghAIUnit,'A0M3')<=0 or SuijiMode_ScepterRegistryIsActive(bristlebackAghAIUnit,'A0M3')==false or GetUnitAbilityLevel(bristlebackAghAIUnit,'ZBBA')<=0 or B581_AIAbilityReady(bristlebackAghAIUnit,'ZBBA')==false then
return false
endif
if GetUnitState(bristlebackAghAIUnit,UNIT_STATE_MANA)<100. or IsUnitPaused(bristlebackAghAIUnit) or IsUnitType(bristlebackAghAIUnit,UNIT_TYPE_STUNNED) or IsUnitType(bristlebackAghAIUnit,UNIT_TYPE_POLYMORPHED) or MHUnit_GetSilenceCount(bristlebackAghAIUnit)>0 or LoadTriggerHandle(L7,bristlebackAghAIUnitHandle,StringHash("BristlebackAghController"))!=null then
return false
endif
if LoadBoolean(L7,bristlebackAghAIUnitHandle,StringHash("BristlebackAghAIActivatePending")) then
return true
endif
set bristlebackAghAIDeltaX=bristlebackAghAITargetX-GetUnitX(bristlebackAghAIUnit)
set bristlebackAghAIDeltaY=bristlebackAghAITargetY-GetUnitY(bristlebackAghAIUnit)
if bristlebackAghAIDeltaX*bristlebackAghAIDeltaX+bristlebackAghAIDeltaY*bristlebackAghAIDeltaY<=1. then
return false
endif
set bristlebackAghAITimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(bristlebackAghAITimer),StringHash("BristlebackAghAIUnit"),bristlebackAghAIUnit)
call SaveReal(L7,GetHandleId(bristlebackAghAITimer),StringHash("BristlebackAghAITargetX"),bristlebackAghAITargetX)
call SaveReal(L7,GetHandleId(bristlebackAghAITimer),StringHash("BristlebackAghAITargetY"),bristlebackAghAITargetY)
call SaveBoolean(L7,bristlebackAghAIUnitHandle,StringHash("BristlebackAghAIActivatePending"),true)
call TimerStart(bristlebackAghAITimer,0.,false,function BristlebackAghActive_AIActivateTick)
call BristlebackAghActive_Debug(bristlebackAghAIUnit,"AI-QUEUE","target="+R2S(bristlebackAghAITargetX)+","+R2S(bristlebackAghAITargetY))
set bristlebackAghAITimer=null
return true
endfunction
function BristlebackAghActive_OnSpell takes nothing returns boolean
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local real b1060GetSpellTargetX=GetSpellTargetX()
local real b1060GetSpellTargetY=GetSpellTargetY()
local real bristlebackAghFacing=0.
local real bristlebackAghSpellTargetX=0.
local real bristlebackAghSpellTargetY=0.
local unit bristlebackAghCaster=GetTriggerUnit()
local eventid bristlebackAghSpellEvent=GetTriggerEventId()
local string bristlebackAghSpellPhase="OTHER"
if B843GooLog then
if bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_CHANNEL then
set bristlebackAghSpellPhase="CHANNEL"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_CAST then
set bristlebackAghSpellPhase="CAST"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_EFFECT then
set bristlebackAghSpellPhase="EFFECT"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_ENDCAST then
set bristlebackAghSpellPhase="ENDCAST"
endif
call B843GooLogEvent(bristlebackAghCaster,bristlebackAghSpellPhase,b1060GetSpellAbilityId,GetUnitCurrentOrder(bristlebackAghCaster))
endif
if b1060GetSpellAbilityId!='ZBBA' or bristlebackAghCaster==null or GetUnitTypeId(bristlebackAghCaster)==0 or SuijiMode_ScepterRegistryIsActive(bristlebackAghCaster,'A0M3')==false then
set bristlebackAghCaster=null
return false
endif
set bristlebackAghSpellTargetX=b1060GetSpellTargetX
set bristlebackAghSpellTargetY=b1060GetSpellTargetY
if bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_CHANNEL then
set bristlebackAghSpellPhase="CHANNEL"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_CAST then
set bristlebackAghSpellPhase="CAST"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_EFFECT then
set bristlebackAghSpellPhase="EFFECT"
elseif bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_ENDCAST then
set bristlebackAghSpellPhase="ENDCAST"
endif
call BristlebackAghActive_Debug(bristlebackAghCaster,"SPELL-"+bristlebackAghSpellPhase,"ability="+I2S(b1060GetSpellAbilityId)+" target="+R2S(bristlebackAghSpellTargetX)+","+R2S(bristlebackAghSpellTargetY)+" xy="+R2S(GetUnitX(bristlebackAghCaster))+","+R2S(GetUnitY(bristlebackAghCaster))+" current="+I2S(GetUnitCurrentOrder(bristlebackAghCaster))+" active="+I2S(B287_BoolToInt(SuijiMode_ScepterRegistryIsActive(bristlebackAghCaster,'A0M3'))))
set bristlebackAghFacing=Atan2(bristlebackAghSpellTargetY-GetUnitY(bristlebackAghCaster),bristlebackAghSpellTargetX-GetUnitX(bristlebackAghCaster))*bj_RADTODEG+180.
if bristlebackAghSpellEvent!=EVENT_PLAYER_UNIT_SPELL_ENDCAST then
call SetUnitFacing(bristlebackAghCaster,bristlebackAghFacing)
endif
if bristlebackAghSpellEvent==EVENT_PLAYER_UNIT_SPELL_EFFECT then
call BristlebackAghActive_Start(bristlebackAghCaster,bristlebackAghFacing,bristlebackAghSpellTargetX,bristlebackAghSpellTargetY)
call BristlebackAghActive_StartCooldown(bristlebackAghCaster)
endif
set bristlebackAghCaster=null
return false
endfunction
function BristlebackAghActive_TryAIDamageResponse takes unit bristlebackAghDamageTarget,unit bristlebackAghDamageSource,real bristlebackAghDamageAmount returns nothing
local integer bristlebackAghDamagePlayerId=0
local integer bristlebackAghDamageHandle=0
local real bristlebackAghDamageNow=0.
local boolean bristlebackAghDamageQueued=false
if bristlebackAghDamageTarget==null or bristlebackAghDamageSource==null or bristlebackAghDamageTarget==bristlebackAghDamageSource or bristlebackAghDamageAmount<=.01 then
return
endif
if GetUnitTypeId(bristlebackAghDamageTarget)==0 or GetUnitTypeId(bristlebackAghDamageSource)==0 or UnitAlive(bristlebackAghDamageTarget)==false or IsUnitType(bristlebackAghDamageTarget,UNIT_TYPE_HERO)==false or IsUnitIllusion(bristlebackAghDamageTarget) or IsHideUnit(bristlebackAghDamageTarget) then
return
endif
set bristlebackAghDamagePlayerId=GetPlayerId(GetOwningPlayer(bristlebackAghDamageTarget))
if (GetPlayerController(GetOwningPlayer(bristlebackAghDamageTarget))!=MAP_CONTROL_COMPUTER and KKLeaveAI_Active[bristlebackAghDamagePlayerId]==false) or IsUnitEnemy(bristlebackAghDamageSource,GetOwningPlayer(bristlebackAghDamageTarget))==false then
return
endif
set bristlebackAghDamageHandle=GetHandleId(bristlebackAghDamageTarget)
set bristlebackAghDamageNow=TimerGetElapsed(W)
// Native Bristleback AI can issue Goo (852600) later in this same damage/
// attack stack. Defer one direct active start until the stack unwinds so that
// Goo or another tactical order cannot erase ZBBA before SPELL_EFFECT. The
// controller, mana and cooldown lifecycle remains identical after startup.
if bristlebackAghDamageNow-LoadReal(L7,bristlebackAghDamageHandle,StringHash("BristlebackAghAIDamageOrderTime"))>=.25 then
set bristlebackAghDamageQueued=BristlebackAghActive_QueueAIActivate(bristlebackAghDamageTarget,GetUnitX(bristlebackAghDamageSource),GetUnitY(bristlebackAghDamageSource))
if bristlebackAghDamageQueued then
call SaveReal(L7,bristlebackAghDamageHandle,StringHash("BristlebackAghAIDamageOrderTime"),bristlebackAghDamageNow)
endif
call BristlebackAghActive_Debug(bristlebackAghDamageTarget,"AI-DAMAGE","source="+GetUnitName(bristlebackAghDamageSource)+"#"+I2S(GetHandleId(bristlebackAghDamageSource))+" damage="+R2S(bristlebackAghDamageAmount)+" queued="+I2S(B287_BoolToInt(bristlebackAghDamageQueued)))
endif
endfunction
function VM9 takes unit WI7 returns nothing
call BristlebackAghActive_FireQuill(WI7)
endfunction
function VN9 takes unit WI7,real YM7 returns nothing
local integer OB7=GetHandleId(WI7)
local real sD=ON7(OB7,"Bristleback_DamageStack")
if sD+YM7>=$C8 then
call NQ7(OB7,"Bristleback_DamageStack",((0)*1.))
call VM9(WI7)
else
call NQ7(OB7,"Bristleback_DamageStack",((sD+YM7)*1.))
endif
endfunction
function VO9 takes nothing returns nothing
local unit sE=GetTriggerUnit()
local unit S68=GetEventDamageSource()
local integer bristlebackDamageLevel=B287_GetUnitAbilityLevel(sE,'A0M3')
local real sf=J47(S68,sE)
local real sF=GetUnitFacing(sE)
local real sg
local real YM7=GetEventDamage()
local real sG
local real RK
if bristlebackDamageLevel>0 and(YM7>5)and GetUnitState(sE,UNIT_STATE_LIFE)>1 then
if((sF-sf)<(-180.))then
set sg=(sF-sf+360)
else
if((sF-sf)>180.)then
set sg=(sF-sf-360)
else
set sg=(sF-sf)
endif
endif
set RK=RAbsBJ(sg)
if RK<=70 then
set sG=(bristlebackDamageLevel*.08+.08)*YM7
call VN9(sE,YM7-sG)
call SetUnitState(sE,UNIT_STATE_LIFE,GetUnitState(sE,UNIT_STATE_LIFE)+sG)
elseif RK<=110 then
set sG=(bristlebackDamageLevel*.04+.04)*YM7
call SetUnitState(sE,UNIT_STATE_LIFE,GetUnitState(sE,UNIT_STATE_LIFE)+sG)
endif
endif
call BristlebackAghActive_TryAIDamageResponse(sE,S68,YM7)
set sE=null
set S68=null
endfunction
function VP9 takes unit WI7,boolean UA9 returns nothing
local integer bristlebackDamageHandle=0
local trigger t=null
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
set bristlebackDamageHandle=GetHandleId(WI7)
set t=LoadTriggerHandle(L7,bristlebackDamageHandle,StringHash("BristlebackDamageTrigger"))
if t!=null then
set t=null
return
endif
set t=CreateTrigger()
call B1027TempestTrackListener(WI7,t)
call B1023RegisterDamage(t,WI7)
call TriggerAddCondition(t,Condition(function VK9))
call TriggerAddAction(t,function VO9)
// This passive can be native or either OMG random skill. Its damage event
// owns an independent per-unit lifecycle and must not occupy nj[], the
// replaceable legacy third-skill trigger slot.
call SaveTriggerHandle(L7,bristlebackDamageHandle,StringHash("BristlebackDamageTrigger"),t)
set t=null
endfunction
