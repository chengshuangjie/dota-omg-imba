elseif(Y74[GetPlayerId(pl)]==3)then
if(not BT)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+40.))
else
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+80.))
endif
elseif(Y74[GetPlayerId(pl)]==5)then
if(not BT)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+60.))
else
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+120.))
endif
endif
endif
if(RZZZ and FX70==false and DG0==false and LT==false and BT==false)then
if(Y74[GetPlayerId(pl)]==1)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+40.))
elseif(Y74[GetPlayerId(pl)]==3)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+60.))
elseif(Y74[GetPlayerId(pl)]==5)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+80.))
endif
endif
if(FX70)then
if(Y74[GetPlayerId(pl)]==1)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+60.))
elseif(Y74[GetPlayerId(pl)]==3)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+100.))
elseif(Y74[GetPlayerId(pl)]==5)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+140.))
endif
endif
if(DG0)then
if(Y74[GetPlayerId(pl)]==1)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+100.+10.*XM_EXP))
elseif(Y74[GetPlayerId(pl)]==3)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+140.+10.*XM_EXP))
elseif(Y74[GetPlayerId(pl)]==5)then
call SetPlayerHandicapXPBJ(pl,(GetPlayerHandicapXPBJ(pl)+180.+10.*XM_EXP))
endif
endif
set Y74[16+GetPlayerId(pl)]=R2I(GetPlayerHandicapXPBJ(pl))
endfunction
function Q2F takes player pl,integer O5 returns nothing
local integer i=0
local integer O27=GetPlayerId(pl)
set hG[48+O27]=GetRandomInt(0,1)
if(D4 or RZ4)then
set hG[48+O27]=GetRandomInt(0,2)
endif
set hG[64+O27]=GetRandomInt(0,2)
set hG[80+O27]=GetRandomInt(0,2)
set OL4[O27]=false
call ForceRemovePlayer(L8,pl)
if Y4 then
set i=i+5
endif
if(RZZZ)then
set i=i+5
endif
if(RZZ0)then
set i=i+15
endif
if(FX70)then
set i=i+25
endif
if(DG0)then
set i=i+15
endif
if(CT)then  //HG
set i=i+10
endif
if((WT)or(O5==0))then //NG
elseif(Y74[O27]==1)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+(120/O5)+(10*(O5-1)))
set i=i+5
elseif(Y74[O27]==3)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+(360/O5)+(20*(O5-1)))
set i=i+10
else
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)+(600/O5)+(30*(O5-1)))
set i=i+15
endif
if(CT)then
call SetPlayerStateBJ(pl,PLAYER_STATE_RESOURCE_GOLD,R2I(GetPlayerState(pl,PLAYER_STATE_RESOURCE_GOLD)*1.1))
endif
set Y74[32+O27]=i
set Y74[48+O27]=i+10*XM_GOLD
set Y74[64+O27]=0
endfunction
function KKLeaveAI_RegisterEvents takes integer leaveAIPlayerId returns nothing
local trigger leaveAIEventTrigger=null
if leaveAIPlayerId<1 or leaveAIPlayerId>5 or Q04[leaveAIPlayerId]!=null then
return
endif
set Q04[leaveAIPlayerId]=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(Q04[leaveAIPlayerId],Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,Q24)
call TriggerRegisterPlayerUnitEvent(Q04[leaveAIPlayerId],Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,Q24)
call TriggerAddCondition(Q04[leaveAIPlayerId],Condition(function MGF))
call TriggerAddAction(Q04[leaveAIPlayerId],function B1060WaitOwner_MHF)
set Q04[16+leaveAIPlayerId]=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(Q04[16+leaveAIPlayerId],Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ISSUED_ORDER,Q24)
call TriggerAddCondition(Q04[16+leaveAIPlayerId],Condition(function MGF))
call TriggerAddAction(Q04[16+leaveAIPlayerId],function MNF)
set Q04[96+leaveAIPlayerId]=CreateTrigger()
call DisableTrigger(Q04[96+leaveAIPlayerId])
call TriggerRegisterTimerEvent(Q04[16+leaveAIPlayerId],.2,true)
call TriggerAddCondition(Q04[96+leaveAIPlayerId],Condition(function PX7))
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ATTACKED,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function F7F))
call TriggerAddAction(leaveAIEventTrigger,function B1060WaitOwner_F8F)
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ATTACKED,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function FGF))
call TriggerAddAction(leaveAIEventTrigger,function FHF)
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function DRF))
call TriggerAddAction(leaveAIEventTrigger,function DSF)
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_USE_ITEM,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function SB7))
call TriggerAddAction(leaveAIEventTrigger,function B1060WaitOwner_MOF)
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_ATTACKED,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function M5F))
call TriggerAddAction(leaveAIEventTrigger,function B1060WaitOwner_M2F)
set leaveAIEventTrigger=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(leaveAIEventTrigger,Player(leaveAIPlayerId),EVENT_PLAYER_UNIT_SPELL_EFFECT,Q24)
call TriggerAddCondition(leaveAIEventTrigger,Condition(function SB7))
call TriggerAddAction(leaveAIEventTrigger,function B1060WaitOwner_AI_TIAODAO)
set leaveAIEventTrigger=null
endfunction
function KKLeaveAI_RebuildRoster takes nothing returns nothing
local integer teamOffset=0
local integer floor=1
local integer leaveAIRosterPlayerId=0
local integer insertAt=0
local integer shift=0
local integer heroRank=0
local player leaveAIRosterPlayer=null
loop
exitwhen teamOffset>6
set floor=1
loop
exitwhen floor>5
set LU4[48+teamOffset+floor]=-1
set floor=floor+1
endloop
set floor=1
loop
exitwhen floor>5
if teamOffset==0 then
set leaveAIRosterPlayer=Z7[floor]
else
set leaveAIRosterPlayer=A7[floor]
endif
set leaveAIRosterPlayerId=GetPlayerId(leaveAIRosterPlayer)
if TZ7(leaveAIRosterPlayer) and M7[leaveAIRosterPlayerId]!=null then
set heroRank=JT7(GetUnitTypeId(M7[leaveAIRosterPlayerId]))
set insertAt=1
loop
exitwhen insertAt>5
if LU4[48+teamOffset+insertAt]==-1 then
set LU4[48+teamOffset+insertAt]=leaveAIRosterPlayerId
exitwhen true
elseif JT7(GetUnitTypeId(M7[LU4[48+teamOffset+insertAt]]))>heroRank then
set shift=5
loop
exitwhen shift==insertAt
set LU4[48+teamOffset+shift]=LU4[48+teamOffset+shift-1]
set shift=shift-1
endloop
set LU4[48+teamOffset+insertAt]=leaveAIRosterPlayerId
exitwhen true
endif
set insertAt=insertAt+1
endloop
endif
set floor=floor+1
endloop
set floor=1
loop
exitwhen floor>5
set LU4[80+teamOffset+floor]=LU4[48+teamOffset+floor]
set floor=floor+1
endloop
set teamOffset=teamOffset+6
endloop
set leaveAIRosterPlayer=null
endfunction
