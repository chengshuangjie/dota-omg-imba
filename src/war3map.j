function BrambleMaze_Damage takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer HEI=GetHandleId(t)
local unit u=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
local effect fx=(LoadEffectHandle(TABLE_XJ,(HEI),(32)))
local unit HKI=(LoadUnitHandle(TABLE_XJ,(HEI),(14)))
local integer V6I=(LoadInteger(TABLE_XJ,(HEI),(5)))
local unit N4I
local unit IH7=GetTriggerUnit()
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if u!=null then
call RemoveUnit(u)
endif
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
elseif HKI==null or u==null or GetUnitTypeId(HKI)==0 or GetUnitTypeId(u)==0 then
if u!=null and GetUnitTypeId(u)!=0 then
call RemoveUnit(u)
endif
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
elseif IH7!=null and GetUnitTypeId(IH7)!=0 and IsUnitEnemy(IH7,GetOwningPlayer(HKI))==true and IsUnitType(IH7,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(IH7,'A04R')==0 and GetUnitAbilityLevel(IH7,'Avul')==0 and WF7(IH7)==false and IsHideUnit(IH7)==false and UnitAlive(IH7) then
set N4I=CreateUnit(GetOwningPlayer(HKI),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(N4I,'A4IC')
call SetUnitAbilityLevel(N4I,'A4IC',V6I)
call B947IssueTargetOrderById("BrambleMaze_Damage @ war3map.j:77733 (B968)",N4I,$D008A,IH7)
call Loop_Damage(HKI,IH7,.1,.5+V6I*.5,10)
call RemoveUnit(u)
call DestroyEffect(fx)
call FlushChildHashtable(TABLE_XJ,(HEI))
call OZ7(t)
endif
set t=null
set u=null
set fx=null
set HKI=null
set N4I=null
set IH7=null
return false
endfunction
function BrambleMaze_Remove takes nothing returns boolean
