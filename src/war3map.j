call OX7(WI7,"Frozen")
call UnitRemoveAbility(WI7,'A04R')
call YT8(WI7,false)
call PauseUnit(WI7,false)
call NM7(OB7)
call OZ7(t)
elseif b1060GetSpellTargetUnit==WI7 and b1060B287_GetSpellAbilityId==vw and(GetPlayerSlotState(GetOwningPlayer((WI7)))==PLAYER_SLOT_STATE_LEFT or GetPlayerController(GetOwningPlayer((WI7)))==MAP_CONTROL_COMPUTER)and OT7(WI7,"Frozen") then
call OX7(WI7,"Frozen")
call UnitRemoveAbility(WI7,'A04R')
call YT8(WI7,false)
call PauseUnit(WI7,false)
call NM7(OB7)
call OZ7(t)
endif
elseif XH7(WI7)==false then
call SetUnitX(WI7,x)
call SetUnitY(WI7,y)
call OV7(WI7,"Frozen")
call UnitAddAbility(WI7,'A04R')
call YT8(WI7,true)
call PauseUnit(WI7,true)
endif
set WI7=null
set t=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
