function R4E takes nothing returns nothing
local unit p5=E3
local unit m5=GetEnumUnit()
local integer V77=V3
local unit BB7
local integer suijiIceBlastColdFeetLevel=B287_GetUnitAbilityLevel(p5,'A1MG')
call QBE(p5,m5)
call B67(p5,m5,1,150+100*V77)
if SuijiMode_ScepterRegistryIsActive(p5,'A1MI') then
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
    call XF7(BB7,'A1MG')
    call SaveUnitHandle(L7,GetHandleId(BB7),StringHash("SuijiColdFeetSource"),p5)
    if ISLABIKE(p5) then
        call B287_SetUnitAbilityLevel(BB7,'A1MG',4)
    else
        if suijiIceBlastColdFeetLevel<1 then
            set suijiIceBlastColdFeetLevel=1
        endif
        call B287_SetUnitAbilityLevel(BB7,'A1MG',suijiIceBlastColdFeetLevel)
    endif
    call B947IssueTargetOrderById("R4E @ war3map.j:115210 (B968)",BB7,$D0278,m5)
    call UnitApplyTimedLife(BB7,'BTLF',1.)
endif
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\PlasmaShot.mdl",m5,"chest"))
set p5=null
set m5=null
set BB7=null
endfunction
function R7E takes nothing returns nothing
local unit p5=E3
local unit m5=GetEnumUnit()
call QBE(p5,m5)
set p5=null
set m5=null
endfunction
function R8E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit BU7=O77(OB7,"Projectile")
local real Y5=ON7(OB7,"TargetX")
local real Z5=ON7(OB7,"TargetY")
local real l4=ON7(OB7,"Angle")
local real R9E=ON7(OB7,"AOE")
local unit p5=O77(OB7,"Source")
local integer V77=OM7(OB7,"Level")
local real x=GetUnitX(BU7)+30*Cos(l4)
local real y=GetUnitY(BU7)+30*Sin(l4)
local group g
local fogmodifier RDE
local boolexpr iceBlastFilter=null
if BU7==null or p5==null or GetUnitTypeId(BU7)==0 or GetUnitTypeId(p5)==0 then
call DestroyEffect(OG7(OB7,"FX"))
set RDE=N_7(OB7,"Fog")
if RDE!=null then
call FogModifierStop(RDE)
call DestroyFogModifier(RDE)
endif
if LS4 then
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=OM7(OB7,"FUN|EffNum")
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
call DestroyEffect(OG7(OB7,"FUN|Eff"+I2S(bj_forLoopAIndex)))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
call NM7(OB7)
call OZ7(t)
if BU7!=null then
call KillUnit(BU7)
endif
set t=null
set BU7=null
set p5=null
set RDE=null
set iceBlastFilter=null
return false
endif
if KF7(x,y,Y5,Z5)<35 or x!=X17(x)or y!=X07(y)then
set x=Y5
set y=Z5
call SetUnitX(BU7,x)
call SetUnitY(BU7,y)
call DestroyEffect(OG7(OB7,"FX"))
set RDE=N_7(OB7,"Fog")
call FogModifierStop(RDE)
call DestroyFogModifier(RDE)
set RDE=null
if LS4 then
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=OM7(OB7,"FUN|EffNum")
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
call DestroyEffect(OG7(OB7,"FUN|Eff"+I2S(bj_forLoopAIndex)))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
call NM7(OB7)
call OZ7(t)
call KillUnit(BU7)
set IN4=p5
set E3=p5
set V3=V77
set g=WS7()
set iceBlastFilter=Condition(function AJ7_gai)
call GroupEnumUnitsInRange(g,x,y,R9E+25,iceBlastFilter)
call DestroyBoolExpr(iceBlastFilter)
set iceBlastFilter=null
call ForGroup(g,function R4E) //爆炸
call WR7(g)
set g=null
else
call SetUnitX(BU7,x)
call SetUnitY(BU7,y)
set IN4=p5
set E3=p5
set V3=V77
set g=WS7()
set iceBlastFilter=Condition(function AJ7_gai)
call GroupEnumUnitsInRange(g,x,y,300,iceBlastFilter)
call DestroyBoolExpr(iceBlastFilter)
set iceBlastFilter=null
call ForGroup(g,function R7E) //刮到
call WR7(g)
set g=null
endif
set t=null
set BU7=null
set p5=null
set iceBlastFilter=null
return false
endfunction
function REE takes unit p5,real x,real y,real RFE,effect FX,fogmodifier RDE returns nothing
local real l4=Atan2(y-GetUnitY(p5),x-GetUnitX(p5))
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BU7=CreateUnit(GetOwningPlayer(p5),'h0B6',GetUnitX(p5),GetUnitY(p5),l4*bj_RADTODEG)
local integer V77=B287_GetUnitAbilityLevel(p5,'A1MI')
local real R9E=YJ7(350+25*RFE*2,1000)
local real BAD=KF7(GetUnitX(p5),GetUnitY(p5),x,y)
local real interval=0.005
if V77==0 then
set V77=B287_GetUnitAbilityLevel(p5,'A2SE')
endif
if IsUnitEnemy(BU7,GetLocalPlayer())and WG7(GetLocalPlayer())==false then
call UnitSetUsesAltIcon(BU7,true)
endif
call TriggerRegisterTimerEvent(t,interval,true)
call TriggerAddCondition(t,Condition(function R8E))
call NT7(OB7,"Projectile",BU7)
call NQ7(OB7,"TargetX",x*1.)
call NQ7(OB7,"TargetY",y*1.)
call NQ7(OB7,"Angle",l4*1.)
call NQ7(OB7,"AOE",R9E*1.)
call NP7(OB7,"Level",V77)
call NT7(OB7,"Source",p5)
call NX7(OB7,"Fog",RDE)
call NU7(OB7,"FX",FX)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MI',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2SE',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MN',false)
if LS4 then
set L94=""
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(p5))then
set L94="Doodads\\Icecrown\\Water\\BubbleGeyserSteam\\BubbleGeyserSteam.mdx"
endif
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=R2I(R9E/100)+$A
loop
exitwhen bj_forLoopAIndex>=bj_forLoopAIndexEnd
set LD4=I2R(bj_forLoopAIndex)*(6.2831853/I2R(bj_forLoopAIndexEnd))
call NU7(OB7,"FUN|Eff"+I2S(bj_forLoopAIndex),AddSpecialEffect(L94,x+Cos(LD4)*R9E,y+Sin(LD4)*R9E))
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call NP7(OB7,"FUN|EffNum",bj_forLoopAIndexEnd)
endif
set t=null
set BU7=null
endfunction
function B1060PredictionWork takes nothing returns nothing
local trigger owner1060=B1060PendingOwner
local unit source1060=B1060PendingSource
local unit target1060=B1060PendingTarget
local integer mode1060=B1060PendingMode
local integer key1060=GetHandleId(owner1060)
local location predicted1060=null
set B1060PendingOwner=null
set B1060PendingSource=null
set B1060PendingTarget=null
if source1060!=null and target1060!=null and UnitAlive(source1060) and UnitAlive(target1060) and IsTriggerEnabled(owner1060) then
call B1060ActionEnter(owner1060)
if mode1060==1 then
set predicted1060=WA7(source1060,target1060,500.,.02,1500.)
else
set predicted1060=WA7(source1060,target1060,1500.,2.02,99999.)
endif
if predicted1060!=null and IsTriggerEnabled(owner1060) and UnitAlive(source1060) and UnitAlive(target1060) and O77(key1060,"Source")==source1060 and O77(GetHandleId(source1060),"AI|IBTgt")==target1060 then
call NQ7(key1060,"AI|TgtX",GetLocationX(predicted1060))
call NQ7(key1060,"AI|TgtY",GetLocationY(predicted1060))
call NQ7(key1060,"AI|MaxDist",99999.)
endif
call B1060ActionLeave(owner1060)
endif
// WA7 returns the shared DH7 scratch location; this worker must not remove it.
set predicted1060=null
set owner1060=null
set source1060=null
set target1060=null
endfunction
function B1060StartPrediction takes trigger owner1060,unit source1060,integer mode1060 returns nothing
if B1060PredictionAction==null then
set B1060PredictionAction=CreateTrigger()
call TriggerAddAction(B1060PredictionAction,function B1060PredictionWork)
endif
set B1060PendingOwner=owner1060
set B1060PendingSource=source1060
set B1060PendingTarget=O77(GetHandleId(source1060),"AI|IBTgt")
set B1060PendingMode=mode1060
call TriggerExecute(B1060PredictionAction)
endfunction
function RGE takes nothing returns boolean
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit BU7=O77(OB7,"Projectile")
local unit p5=O77(OB7,"Source")
local real l4=ON7(OB7,"Angle")
local real x
local real y
local real RFE=TimerGetElapsed(W)-ON7(OB7,"CastTime")
local string s
local fogmodifier RDE
local effect FX
local real RHE=0.
local real RIE=0.
local boolean J4
local integer i
local boolean suijiIceBlastInvalid=false
if BU7==null then
set suijiIceBlastInvalid=true
elseif GetUnitTypeId(BU7)==0 then
set suijiIceBlastInvalid=true
elseif p5==null then
set suijiIceBlastInvalid=true
elseif GetUnitTypeId(p5)==0 then
set suijiIceBlastInvalid=true
endif
if suijiIceBlastInvalid then
if BU7!=null and GetUnitTypeId(BU7)!=0 then
call RemoveUnit(BU7)
endif
if p5!=null and GetUnitTypeId(p5)!=0 then
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MI',true)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2SE',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MN',false)
endif
call NM7(OB7)
call OZ7(t)
set t=null
set BU7=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set RHE=GetUnitX(BU7)+30*Cos(l4)
set RIE=GetUnitY(BU7)+30*Sin(l4)
set x=X17(RHE)
set y=X07(RIE)
call SetUnitX(BU7,x)
call SetUnitY(BU7,y)
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or (b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and (b1060GetSpellAbilityId=='A1MN' or OO7(OB7,"SuijiIceBlastReleaseIssued"))) or x!=RHE or y!=RIE then
    call NM7(OB7)
    call OZ7(t)
    call RemoveUnit(BU7)
    set s=""
    if IsPlayerAlly(GetOwningPlayer(p5),GetLocalPlayer())or WG7(GetLocalPlayer())then
        set s="war3mapImported\\IceWindGroundFX.mdl"
    endif
    set RDE=CreateFogModifierRadius(GetOwningPlayer(p5),FOG_OF_WAR_VISIBLE,x,y,500,true,true)
    call FogModifierStart(RDE)
    set FX=AddSpecialEffect(s,x,y)
    call REE(p5,x,y,RFE,FX,RDE)
    set RDE=null
    set FX=null
elseif TZ7(GetOwningPlayer(p5))then //如果是AI
    set LD4=KF7(x,y,ON7(OB7,"AI|TgtX"),ON7(OB7,"AI|TgtY"))
    if LD4>ON7(OB7,"AI|MaxDist")or OO7(OB7,"AI|Blast")then
        if K57(p5)then
if OO7(OB7,"SuijiIceBlastReleaseIssued")==false then
call NS7(OB7,"SuijiIceBlastReleaseIssued",true)
if N97(p5,852526,'A1MN')==false then
call NS7(OB7,"SuijiIceBlastReleaseIssued",false)
endif
endif
        else
            call NS7(OB7,"AI|Blast",true)
        endif
    else
        call NQ7(OB7,"AI|MaxDist",LD4)
        if Bz>ON7(OB7,"AI|NextUp")then
            call NQ7(OB7,"AI|NextUp",Bz+1)
            set J4=false
            set i=OM7(GetHandleId(p5),"AI|IBClose")
            if i==1 or i==0 then
                call B1060StartPrediction(t,p5,i)
            elseif(i==2)then
                call M07(O77(GetHandleId(p5),"AI|IBTgt"))
                call MoveLocation(DH7,GetLocationX(HA),GetLocationY(HA))
            endif
            if J4 then
                call NQ7(OB7,"AI|TgtX",GetLocationX(DH7))
                call NQ7(OB7,"AI|TgtY",GetLocationY(DH7))
                call NQ7(OB7,"AI|MaxDist",99999.)
            endif
        endif
    endif
endif
set t=null
set BU7=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function RJE takes nothing returns nothing
local unit p5=GetTriggerUnit()
local location l=null
local real x=0.
local real y=0.
local real a=0.
local trigger t=null
local integer OB7=0
local unit BU7=null
if p5==null or GetUnitTypeId(p5)==0 then
set p5=null
return
endif
set l=GetSpellTargetLoc()
set x=GetLocationX(l)
set y=GetLocationY(l)
set a=Atan2(y-GetUnitY(p5),x-GetUnitX(p5))
set t=CreateTrigger()
set OB7=GetHandleId(t)
set BU7=CreateUnit(GetOwningPlayer(p5),'H0B8',GetUnitX(p5),GetUnitY(p5),a*bj_RADTODEG)
if IsUnitEnemy(BU7,GetLocalPlayer())and WG7(GetLocalPlayer())==false then
call UnitSetUsesAltIcon(BU7,true)
endif
call NT7(OB7,"Projectile",BU7)
call NT7(OB7,"Source",p5)
call NQ7(OB7,"Angle",a*1.)
call NQ7(OB7,"CastTime",TimerGetElapsed(W)*1.)
if TZ7(GetOwningPlayer(p5))then
call NQ7(OB7,"AI|TgtX",x)
call NQ7(OB7,"AI|TgtY",y)
call NQ7(OB7,"AI|MaxDist",99999.)
call NQ7(OB7,"AI|NextUp",Bz+1)
endif
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function RGE))
call SetUnitColor(BU7,GetPlayerColor(Player($E)))
call RemoveLocation(l)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MI',false)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2SE',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MN',true)
call XF7(p5,'A1MN')
if TZ7(GetOwningPlayer(p5))then
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1MN',false)
endif
set p5=null
set l=null
set t=null
set BU7=null
endfunction
function RKE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1MI' or B287_GetSpellAbilityId()=='A2SE' then
call RJE()
endif
return false
endfunction
