endfunction
function RYD takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetLearnedSkill()=='A0BG' and IsUnitIllusion(b1060GetTriggerUnit)==false then
call RXD(b1060GetTriggerUnit,false)
endif
if D4 and B287_GetLearnedSkill()=='A0BG' and B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0BG')==1 and IsUnitIllusion(b1060GetTriggerUnit)==false then
    call XXZZW()
endif
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function HI8 takes nothing returns nothing
