if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PICKUP_ITEM and GetItemType(b1060GetManipulatedItem)==ITEM_TYPE_PERMANENT and KZ7(b1060GetManipulatedItem)==H2 then
call Ohv(b1060GetTriggerUnit)
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SUMMON and UnitInventorySize(b1060GetSummonedUnit)>0 and MV7(b1060GetSummonedUnit,ZU[H2])!=null then
call Ohv(b1060GetSummonedUnit)
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PICKUP_ITEM and GetItemType(b1060GetManipulatedItem)==ITEM_TYPE_PERMANENT and KZ7(b1060GetManipulatedItem)==R06 then
call OKv(b1060GetTriggerUnit)
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_SUMMON and UnitInventorySize(b1060GetSummonedUnit)>0 then
call FSTX(b1060GetSummonedUnit)
endif
set b1060ReturnValue=false
set b1060GetManipulatedItem=null
set b1060GetSummonedUnit=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
