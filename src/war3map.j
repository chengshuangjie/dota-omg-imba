call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function GHE))
set t=null
set W0[0]='A1DV'
set W0[1]='A1DQ'
set W0[2]='A1DR'
set W0[3]='A1DS'
set W0[4]='A1DT'
set W0[5]='A1DU'
set W0[6]='A1DW'
set W0[7]='A1DX'
set z0[0]='A1E4'
set z0[1]='A1E3'
set z0[2]='A1E2'
set z0[3]='A1E1'
set z0[4]='A1E0'
set z0[5]='A1E5'
set z0[6]='A1DZ'
set z0[7]='A1DY'
endfunction
// 大部分的攻击特效遍历
// One native damage listener per target, preserving the existing pair trigger
// evaluation context and its independent 4-second in-flight attack timeout.
function B935TargetDamage takes nothing returns boolean
local trigger damageOwner1116=GetTriggeringTrigger()
local trigger damagePair935=LoadTriggerHandle(TABLE_P,GetHandleId(GetEventDamageSource()),GetHandleId(GetTriggerUnit()))
// B1116: native owner callbacks and explicit pair evaluations share retirement protection.
call B1060ActionEnter(damageOwner1116)
if not LoadBoolean(OZ7_HT,GetHandleId(damageOwner1116),0) and damagePair935!=null and IsTriggerEnabled(damagePair935) and not LoadBoolean(OZ7_HT,GetHandleId(damagePair935),0) and LoadTriggerHandle(TABLE_HY,GetHandleId(damagePair935),StringHash("B935PairOwner"))==damageOwner1116 and LoadInteger(TABLE_HY,GetHandleId(damagePair935),0)>0 then
call B1060ActionEnter(damagePair935)
call TriggerEvaluate(damagePair935)
call B1060ActionLeave(damagePair935)
endif
call B1060ActionLeave(damageOwner1116)
set damagePair935=null
set damageOwner1116=null
return false
endfunction
function B935AcquireDamageOwner takes unit damageTarget935 returns trigger
local integer damageTargetKey935=0
local trigger damageOwner935=null
local integer damageOwnerKey935=0
if damageTarget935==null or GetUnitTypeId(damageTarget935)==0 or not UnitAlive(damageTarget935) then
return null
endif
set damageTargetKey935=GetHandleId(damageTarget935)
set damageOwner935=LoadTriggerHandle(TABLE_HY,damageTargetKey935,StringHash("B935TargetDamageOwner"))
if damageOwner935==null then
set damageOwner935=CreateTrigger()
set damageOwnerKey935=GetHandleId(damageOwner935)
call SaveTriggerHandle(TABLE_HY,damageTargetKey935,StringHash("B935TargetDamageOwner"),damageOwner935)
call SaveInteger(TABLE_HY,damageOwnerKey935,StringHash("B935TargetKey"),damageTargetKey935)
call B1023RegisterDamage(damageOwner935,damageTarget935)
call TriggerAddCondition(damageOwner935,Condition(function B935TargetDamage))
else
set damageOwnerKey935=GetHandleId(damageOwner935)
endif
call SaveInteger(TABLE_HY,damageOwnerKey935,StringHash("B935PairRefs"),LoadInteger(TABLE_HY,damageOwnerKey935,StringHash("B935PairRefs"))+1)
return damageOwner935
endfunction
function B935ReleaseDamageOwner takes trigger damagePair935 returns nothing
local trigger damageOwner935=LoadTriggerHandle(TABLE_HY,GetHandleId(damagePair935),StringHash("B935PairOwner"))
local integer damageOwnerKey935=GetHandleId(damageOwner935)
local integer damageTargetKey935=LoadInteger(TABLE_HY,damageOwnerKey935,StringHash("B935TargetKey"))
local integer damageRefs935=LoadInteger(TABLE_HY,damageOwnerKey935,StringHash("B935PairRefs"))-1
call RemoveSavedHandle(TABLE_HY,GetHandleId(damagePair935),StringHash("B935PairOwner"))
if damageOwner935!=null then
if damageRefs935<=0 then
if LoadTriggerHandle(TABLE_HY,damageTargetKey935,StringHash("B935TargetDamageOwner"))==damageOwner935 then
call RemoveSavedHandle(TABLE_HY,damageTargetKey935,StringHash("B935TargetDamageOwner"))
endif
call FlushChildHashtable(TABLE_HY,damageOwnerKey935)
call OZ7(damageOwner935)
else
call SaveInteger(TABLE_HY,damageOwnerKey935,StringHash("B935PairRefs"),damageRefs935)
endif
endif
set damageOwner935=null
endfunction
function TUA takes nothing returns nothing
local real b1060GetEventDamage=B1060EventDamage()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
	local trigger t = GetTriggeringTrigger()
	local integer h = GetHandleId(t)
	local unit attackerUnit=LoadUnitHandle(TABLE_HY, h, 0)
	local unit targetUnit=LoadUnitHandle(TABLE_HY, h, 1)
	local timer pairTimer1116=null
	if b1060GetTriggerEventId== EVENT_UNIT_DAMAGED and LoadInteger(TABLE_HY, h, 0)> 0 then	//右键伤害
		if attackerUnit!=null and targetUnit!=null and GetUnitTypeId(attackerUnit)!=0 and GetUnitTypeId(targetUnit)!=0 and GetEventDamageSource()==attackerUnit and FKK and(EXGetEventDamageData(1) != 0) and(b1060GetEventDamage> 0 or not LoadBoolean(TABLE_HY, h, 10)) then
			call DisableTrigger(t)
			call TTA(attackerUnit, targetUnit, b1060GetEventDamage)
			// B1116: nested attack work must not revive a retired or detached pair.
			if not LoadBoolean(OZ7_HT,h,0) and LoadTimerHandle(TABLE_HY,h,3)!=null then
				call EnableTrigger(t)
				if LoadInteger(TABLE_HY, h, 0)>0 then
					call SaveInteger(TABLE_HY, h, 0, LoadInteger(TABLE_HY, h, 0)-1)
				endif
			endif
		endif
	elseif b1060GetTriggerEventId== EVENT_GAME_TIMER_EXPIRED then
		set pairTimer1116=LoadTimerHandle(TABLE_HY,h,3)
		if pairTimer1116!=null and pairTimer1116==GetExpiredTimer() then
			// Detach this generation before releasing any shared owner state.
			call RemoveSavedHandle(TABLE_HY,h,3)
			if LoadTriggerHandle(TABLE_P,LoadInteger(TABLE_HY,h,10),LoadInteger(TABLE_HY,h,11))==t then
				call RemoveSavedHandle(TABLE_P,LoadInteger(TABLE_HY,h,10),LoadInteger(TABLE_HY,h,11))
			endif
			call B935ReleaseDamageOwner(t)
			call PauseTimer(pairTimer1116)
			call DestroyTimer(pairTimer1116)
			call FlushChildHashtable(TABLE_HY,h)
			call OZ7(t)
			set LXX=LXX-1
		endif
	endif
	set t = null
	set attackerUnit=null
	set targetUnit=null
	set pairTimer1116=null
set b1060GetTriggerEventId=null
endfunction
//判断是否闪避
function SetUnitMiss_PD takes unit ZX7,unit IH7 returns nothing
	local integer probability = 0
	local integer TYA = 0
	local unit d
	// 有金箍棒
	if(IsAttackEffectEnabled[17] and GetUnitAbilityLevel(ZX7,'A1FO')== 1 and (not IsUnitType(IH7, UNIT_TYPE_STRUCTURE) or (GetOwningPlayer(IH7)!= A7[0]and GetOwningPlayer(IH7)!= Z7[0]))) and MRPH(ZX7)==false and LoadInteger(L7,(GetHandleId(IH7)),('A4IS'))==0 then
		call UnitRemoveAbility(ZX7,'a3PQ')
        call ExecuteAttackEvent(-3)
		return	
	endif
	// 攻击者不是近战单位 和 飞行单位
	// 攻击者不是近战单位 和 飞行单位
	// 攻击者不是近战单位 和 飞行单位
	if not IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER) and not IsUnitType(ZX7, UNIT_TYPE_FLYING) then
		// 如果悬崖高就有 25% 几率丢失
		if GetTerrainCliffLevel(GetUnitX(ZX7), GetUnitY(ZX7))< GetTerrainCliffLevel(GetUnitX(IH7), GetUnitY(IH7)) then
			set TYA = 25
		endif
	endif
	// 查各种丢失 磁场 和 醉拳百分百闪避
    //if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	// 查各种丢失 磁场 和 醉拳百分百闪避
    //if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) or(IsAttackEffectEnabled[1]and GetUnitAbilityLevel(YX,'A34E')> 0 and GetUnitAbilityLevel(YX,'A36D')== 0) then
	if(IsAttackEffectEnabled[0]and GetUnitAbilityLevel(IH7,'ACes')> 0) then
		set probability = 100
	else
		set probability = GetUnitMissProbability(IH7)
	endif
    //风之障壁百分百闪避
    //风之障壁百分百闪避
    if GetUnitAbilityLevel(ZX7,'Aloc')==0 and IsUnitType(ZX7,UNIT_TYPE_RANGED_ATTACKER)and IsUnitType(ZX7,UNIT_TYPE_STRUCTURE)==false and(LoadInteger(L7,(GetHandleId(IH7)),('A4IS')))>0 then
    if Fc(IH7,ZX7)then
    // call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl",IH7,"chest"))
    set probability=100
    endif
    endif
	// 获取单位致盲几率
	set TYA = UUEE(TYA, GetUnitBlind(ZX7))
	if(probability > 0 or TYA > 0) and(GetRandomInt(1, 100)< probability or GetRandomInt(1, 100)< TYA) then
		set d = IYX(ZX7)
		call SetUnitX(d, GetUnitX(ZX7))
		call SetUnitY(d, GetUnitY(ZX7))
		call UnitAddAbility(d,'A3PQ')
		if not B947IssueTargetOrderById("SetUnitMiss_PD @ war3map.j:219920 (B968)",d, 852190, ZX7) then
			if GetUnitState(ZX7, UNIT_STATE_TYPE) == 0 then
				call SetUnitState(ZX7, UNIT_STATE_TYPE, 2) 
				call B947IssueTargetOrderById("SetUnitMiss_PD @ war3map.j:219923 (B968)",d, 852190, ZX7)
				call SetUnitState(ZX7, UNIT_STATE_TYPE, 0) 
			endif
		endif
		call UnitRemoveAbility(d,'A3PQ')
		set d = null
		set bDodgeAttack = true
	else
		call UnitRemoveAbility(ZX7,'a3PQ')
		set bDodgeAttack = false
        call ExecuteAttackEvent(-3)
	endif
endfunction
function SetUnitMiss takes nothing returns nothing
	call SetUnitMiss_PD(WXX,YXX)
endfunction
// 动态注册伤害事件
function TZA takes unit attackerUnit, unit targetUnit, boolean isAbility returns nothing
	local trigger t
	local integer h
	local timer tt
	local trigger b1018DamageOwner=null
	if attackerUnit==null or targetUnit==null or GetUnitTypeId(attackerUnit)==0 or GetUnitTypeId(targetUnit)==0 or not UnitAlive(attackerUnit) or not UnitAlive(targetUnit) then
		return
	endif
	if B846_IsStackOwner(attackerUnit) and (GetUnitAbilityLevel(attackerUnit,'A4BB')>0 or GetUnitAbilityLevel(attackerUnit,'A4BH')>0) then
		call YSBJ(attackerUnit)
	endif
	set WXX = attackerUnit
	set YXX = targetUnit
	set PVV = isAbility
	// 遍历 单位被攻击 事件 会第一时间运行闪避类
	call ExecuteAttackEvent(-1)
	// Attack consumers may synchronously kill, remove or replace either unit.
	if GetUnitTypeId(attackerUnit)==0 or GetUnitTypeId(targetUnit)==0 or not UnitAlive(attackerUnit) or not UnitAlive(targetUnit) then
		return
	endif
	//是僵尸则返回
	if GetUnitTypeId(attackerUnit)=='n0F5' or GetUnitTypeId(attackerUnit)=='n1F5' then
		return 
	endif
	// 近战单位在攻击时出手时结算暴击, 远程单位在造成伤害时结算暴击，敌人非建筑非守卫且攻击者是模拟暴击英雄
	if B846_IsStackOwner(attackerUnit)==false and IsUnitType(attackerUnit, UNIT_TYPE_MELEE_ATTACKER) and IsUnitEnemy(attackerUnit, GetOwningPlayer(targetUnit)) and IsUnitType(targetUnit, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(targetUnit,'A04R')==0 and (YSBJ_HERO(attackerUnit)==false or SuijiMode_HasRandomAttackCritical(attackerUnit)) then
		call SetUnitCriticalStrike(attackerUnit,targetUnit,true)
	endif
	if GetUnitTypeId(attackerUnit)==0 or GetUnitTypeId(targetUnit)==0 or not UnitAlive(attackerUnit) or not UnitAlive(targetUnit) then
		return
	endif
	// 是玩家单位 或者 有吸血光环 则继续 否则返回
	if not(TX7(GetOwningPlayer(attackerUnit)) or TX7(GetOwningPlayer(targetUnit)) or(XXGH and(GetUnitAbilityLevel(attackerUnit,'BVA1')== 1 or GetUnitAbilityLevel(attackerUnit,'BVA2')== 1 or GetUnitAbilityLevel(attackerUnit,'BVA3')== 1 or GetUnitAbilityLevel(attackerUnit,'BVA4')== 1)) or(JPGH and GetUnitAbilityLevel(attackerUnit,'B3B5')== 1)) then
		return
	endif
    //猴子猴孙攻击
    if GetUnitAbilityLevel(attackerUnit,'A4D9')>0 then
        if IsUnitType(targetUnit,UNIT_TYPE_HERO) and OT7(attackerUnit,"A4D9")==false then
            call SetUnitVertexColor(attackerUnit,255,255,255,255)
            call WukongsCommand_70(attackerUnit)
        else
            if ON7(GetHandleId(attackerUnit),"A4D9StopTime")<=TimerGetElapsed(W) then
            call NQ7(GetHandleId(attackerUnit),"A4D9StopTime",(TimerGetElapsed(W)+.25)*1.)
            call B947IssueImmediateOrder("TZA @ war3map.j:219972 (B968)",attackerUnit,"stop")
            endif
            return
        endif
    endif
	if GetUnitTypeId(attackerUnit)==0 or GetUnitTypeId(targetUnit)==0 or not UnitAlive(attackerUnit) or not UnitAlive(targetUnit) then
		return
	endif
	if HaveSavedHandle(TABLE_P, GetHandleId(attackerUnit), GetHandleId(targetUnit)) then
		set t = LoadTriggerHandle(TABLE_P, GetHandleId(attackerUnit), GetHandleId(targetUnit))
		set h = GetHandleId(t)
		if not bDodgeAttack then
			call SaveInteger(TABLE_HY, h, 0, LoadInteger(TABLE_HY, h, 0) + 1)
		endif
		set tt = LoadTimerHandle(TABLE_HY, h, 3)
	else
		set b1018DamageOwner=B935AcquireDamageOwner(targetUnit)
		if b1018DamageOwner==null then
			return
		endif
		set t = CreateTrigger()
		set h = GetHandleId(t)
		set tt = CreateTimer()
		call SaveTimerHandle(TABLE_HY, h, 3, tt)
		call SaveTriggerHandle(TABLE_P, GetHandleId(attackerUnit), GetHandleId(targetUnit), t)
		if not bDodgeAttack then
			call SaveInteger(TABLE_HY, h, 0, 1)
		else
			call SaveInteger(TABLE_HY, h, 0, 0)
		endif
		call SaveTriggerHandle(TABLE_HY,h,StringHash("B935PairOwner"),b1018DamageOwner)
		call TriggerRegisterTimerExpireEvent(t, tt)
		call TriggerAddCondition(t, Condition(function TUA))
		call SaveUnitHandle(TABLE_HY, h, 0, attackerUnit)
		call SaveUnitHandle(TABLE_HY, h, 1, targetUnit)
		call SaveInteger(TABLE_HY, h, 10, GetHandleId(attackerUnit))
		call SaveInteger(TABLE_HY, h, 11, GetHandleId(targetUnit))
		// 攻击单位是否是英雄或者是熊灵或者是猴子猴孙
		call SaveBoolean(TABLE_HY, h, 10, IsUnitType(attackerUnit, UNIT_TYPE_HERO) or AS7(attackerUnit) or ISHZHS(attackerUnit))
		// 目标单位是否是建筑
		call SaveBoolean(TABLE_HY, h, 11, IsUnitType(targetUnit, UNIT_TYPE_STRUCTURE))
		// 目标单位不是守卫单位
		call SaveBoolean(TABLE_HY, h, 14, GetUnitAbilityLevel(targetUnit,'A04R')== 0)
		// 攻击单位是否是目标单位的敌军
		call SaveBoolean(TABLE_HY, h, 15, IsUnitEnemy(attackerUnit, GetOwningPlayer(targetUnit)))
		set LXX = LXX + 1
	endif
	set EOO = h
	if not LoadBoolean(TABLE_HY, h, 11) and LoadBoolean(TABLE_HY, h, 14) and LoadBoolean(TABLE_HY, h, 15) then
		if GetUnitAbilityLevel(attackerUnit,'B0GS')> 0 then
			call SaveBoolean(TABLE_HY, h, 20, true)
		endif
	endif
	if IsUnitType(attackerUnit, UNIT_TYPE_HERO) or AS7(attackerUnit) or IsUnitIllusion(attackerUnit) then
		call ExecuteAttackEvent(-2)
	endif
	// IMBA: TZA buff x2 cap 30s.
	if XOMG_IMBA_ENABLED then
	call TimerStart(tt, RMinBJ(4.*IMBA_POWER,30.), false, null)
	else
	call TimerStart(tt, 4, false, null)
	endif
	call SaveBoolean(TABLE_HY, h, 0, isAbility)
	set b1018DamageOwner=null
	set tt = null
	set t = null
endfunction
function UWA takes unit u, unit t returns nothing	//单位被攻击
	call TZA(u, t, false)
endfunction
function W3A takes unit killingUnit,unit triggerUnit returns nothing  //单位死亡
	call FlushUnitData(triggerUnit)
endfunction
//TB变身额外判断
function TBBS takes unit EVD,integer skill returns boolean
return(skill=='A1RI')and SuijiMode_ScepterRegistryIsActive(EVD,'A1RI')
endfunction
// 释放技能事件
function UTA takes unit whichUnit, integer id returns nothing
local integer level = B287_GetUnitAbilityLevel(whichUnit, id)
local unit targetUnit = GetSpellTargetUnit()
local real Xn5
local real d=ReduceUnitAbilityCoolDownReal(whichUnit)
local real TBBS_cooltime=55
local integer I97=GetHandleId(whichUnit)
if (id=='A1GU' and level==4) or id=='A4L1' or id=='A28Y' then
set targetUnit=null
return
endif
if id=='A27H' then
if (LoadInteger(L7,(GetHandleId(targetUnit)),(705)))==0 then
// IMBA: control duration x2 cap 5s.
if XOMG_IMBA_ENABLED then
call TimerStart(N84[GetPlayerId(GetOwningPlayer(whichUnit))],RMinBJ(2.*IMBA_POWER,5.),false,null)
else
call TimerStart(N84[GetPlayerId(GetOwningPlayer(whichUnit))],2,false,null)
endif
call Japi_ReduceUnitAbilityCoolDown(whichUnit,id,2.)
set targetUnit=null
return
endif
endif
if ISLABIKE(whichUnit) and (id=='A0NQ' or id=='A10L' or id=='A0OR' or id=='A4K0') then
	set d=LABIKE_ANMU_ReduceUnitAbilityCoolDownReal(whichUnit)
endif
if d>0 then
set Xn5=LoadReal(ZCC,-id,level)
if Xn5==0 then
if LoadBoolean(ZCC,-id,0)then
set Xn5=LoadReal(ZCC,-id,1)
endif
endif
set Xn5=SuijiMode_GetEffectiveCooldownBase(whichUnit,id,level,Xn5)
if TBBS(whichUnit,id) then
set Xn5=TBBS_cooltime
endif
set d=(1-d)*Xn5
if d!=0 then
if ivv(GetUnitTypeId(whichUnit),id)==false and PT4==false then
call Japi_ReduceUnitAbilityCoolDown(whichUnit, id, YK7(Xn5-d,0))
endif
endif
else
if TBBS(whichUnit,id) and ivv(GetUnitTypeId(whichUnit),id)==false then
call Japi_ReduceUnitAbilityCoolDown(whichUnit, id, TBBS_cooltime)
endif
endif
//	if rReduceCoolDown > 0 then
//		call Japi_ReduceUnitAbilityCoolDown(whichUnit, id, rReduceCoolDown) //冷却缩减25
//	endif
	// 技能施法目标 不等于没有 并且是技能目标的敌对玩家 有莲花 而且施法者不是蝗虫
	// 莲花的判断
