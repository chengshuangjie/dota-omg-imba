endfunction
function IWX takes integer i returns unit
	call DisableTrigger(EA)
	set EUNIT[i]= CreateUnit(Player(i),'e00E', 0, 0, 0)
	call EnableTrigger(EA)
	return EUNIT[i]
endfunction
