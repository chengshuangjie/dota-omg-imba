function OLD takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer BC7=OM7(I97,"Level")
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or GetUnitAbilityLevel(ZX7,'B02H')==0 then
call NM7(I97)
call OZ7(t)
call UnitRemoveAbility(ZX7,'B02H')
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,$FF)
call OX7(ZX7,"JINU")
elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and C677(b1060GetEventDamage) then
call YN7(ZX7,.8*b1060GetEventDamage)
endif
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
