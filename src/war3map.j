call SuijiMode_StartPairCooldownSync(D97,b1060B287_GetSpellAbilityId,'A29G','A29H',"SuijiZeusUltCooldown",90.,90.,90.,90.,90.,90.)
call YS7("tx\\zeus\\Zeus_W.mdl",D97,"right hand",1)
set suijiZeusUltLevel=SuijiMode_GetPairCastLevel(D97,b1060B287_GetSpellAbilityId,'A29G','A29H')
if SuijiMode_ScepterRegistryIsActive(D97,'A29G') then
set DD7=suijiZeusUltLevel+7
else
set DD7=suijiZeusUltLevel+4
endif
call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,f)
call ForGroup(g,function PUD)
call WR7(g)
call DestroyBoolExpr(f)
set f=null
set g=null
set b1061SavedGetTriggerUnit=null
