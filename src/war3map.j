function MIO takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if GetUnitAbilityLevel(ZX7,'Bdet')==0 then
call UnitRemoveAbility(ZX7,'A2T4')
call UnitRemoveAbility(ZX7,'B0H0')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
if AK7(ZX7)==true then
if GetUnitAbilityLevel(ZX7,'B0H0')==0 then
call XF7(ZX7,'A2T4')
endif
else
if GetUnitAbilityLevel(ZX7,'B0H0')>0 then
call UnitRemoveAbility(ZX7,'A2T4')
call UnitRemoveAbility(ZX7,'B0H0')
endif
endif
endif
set ZX7=null
set t=null
return false
endfunction
