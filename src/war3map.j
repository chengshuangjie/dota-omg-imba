set t=null
endfunction
function BK9 takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit WI7=(b1061SavedGetTriggerUnit)
local integer V77=B287_GetUnitAbilityLevel(WI7,'A0O7')
local real x=GetUnitX(WI7)
local real y=GetUnitY(WI7)
local location l
local unit BB7
