function I39 takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local integer T8=1
local integer U8=5
local integer D5
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,20," ")
if(TW7(b1060GetTriggerPlayer))then
loop
exitwhen T8>U8
