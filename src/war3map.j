function CDD takes nothing returns boolean
return (IsUnitEnemy(IN4,GetOwningPlayer(GetFilterUnit())) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and GetUnitAbilityLevel(GetFilterUnit(),'Bcyc')>0==false and GetUnitTypeId(GetFilterUnit())!='n00L' and (GetUnitAbilityLevel(GetFilterUnit(),'B084')>0 or GetUnitAbilityLevel(GetFilterUnit(),'B0JJ')>0 or GetUnitAbilityLevel(GetFilterUnit(),'B0JK')>0 or GetUnitAbilityLevel(GetFilterUnit(),'B0JL')>0 or GetUnitAbilityLevel(GetFilterUnit(),'B0JM')>0))!=null
endfunction
function CED takes nothing returns boolean
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local integer OB7=GetHandleId(b1060GetTriggeringTrigger)
local unit p5=O77(OB7,"Source")
local group g
if p5==null or GetUnitTypeId(p5)==0 then
call NM7(OB7)
call OZ7(b1060GetTriggeringTrigger)
set p5=null
set b1060ReturnValue=false
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endif
if XH7(p5)==false and ISPH(p5)==false then
set g=WS7()
set IN4=p5
set RX4=p5
set RY4=B287_GetUnitAbilityLevel(p5,'A01N')+GetUnitAbilityLevel(p5,'X01N')+GetUnitAbilityLevel(p5,'X11N')
call GroupEnumUnitsInRange(g,GetUnitX(p5),GetUnitY(p5),$4C9,Condition(function CDD))
call ForGroup(g,function C4D)
call WR7(g)
endif
set g=null
set p5=null
set b1060ReturnValue=false
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
