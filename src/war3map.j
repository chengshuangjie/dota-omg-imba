call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
endif
else
call DestroyEffect(OG7(I97,"FX"))
call OZ7(t)
call FlushChildHashtable(L7,(I97))
call UnitRemoveType(m5,UNIT_TYPE_PEON)
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',false)
call DIE(p5,m5)
endif
set t=null
set p5=null
set m5=null
