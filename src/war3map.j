function DWG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local real x=(LoadReal(L7,(I97),(6)))
local real y=(LoadReal(L7,(I97),(7)))
local unit BB7
if GetUnitX(ZX7)!=x or GetUnitY(ZX7)!=y or (GetUnitAbilityLevel(ZX7,'B0G8')==0 and GetTriggerEvalCount(t)>R2I(1.5/.05)) then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call OX7(ZX7,"ShadowAmu|4330")
call UnitRemoveAbility(ZX7,'B0G6')
call UnitRemoveAbility(ZX7,'B0G8')
elseif GetTriggerEvalCount(t)==R2I(1.5/.05)then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
call UnitAddAbility(BB7,'A2N5')
call B947IssueTargetOrderById("DWG @ war3map.j:175628 (B968)",BB7,$D0065,ZX7)
call OX7(ZX7,"ShadowAmu|4330")
set BB7=null
endif
set t=null
set ZX7=null
return false
endfunction
