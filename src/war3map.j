function SJSDAddStun takes unit whichUnit, real dur returns nothing
	local unit dummyUnit = null
	if dur > 0 then
		set dummyUnit = CreateUnit(GetOwningPlayer(whichUnit),'e00E', GetUnitX(whichUnit), GetUnitY(whichUnit), 0)
		call UnitAddAbility(dummyUnit, 'A4FI')
		call YDWESetUnitAbilityDataReal(dummyUnit,'A4FI', 1, ABILITY_DATA_DUR, dur)
		call YDWESetUnitAbilityDataReal(dummyUnit,'A4FI', 1, ABILITY_DATA_HERODUR, dur)
		call B947IssueTargetOrderById("SJSDAddStun @ war3map.j:95549 (B968)",dummyUnit, 852095, whichUnit)
		set dummyUnit = null
	endif
endfunction
function SJSD2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(p5,'B0C2')==0 then
call NM7(OB7)
call OZ7(t)
call SetUnitTimeScale(p5,1)
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",p5,"origin"))
endif
set t=null
set p5=null
return false
endfunction
function SJSD takes unit ZX7, unit IH7 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(ZX7)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A081')
local real damage = (GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )
local string tx
if id=='ZC45' or id=='ZC46' or id=='ZC47' or id=='ZC48' then
if id=='ZC45' or id=='ZC46' then
    set tx="model\\hero_facelessvoid_n5s_e_target.mdl"
elseif id=='ZC47' then
    set tx="model\\hero_facelessvoid_n1s_e_target.mdl"
elseif id=='ZC48' then
    set tx="model\\hero_facelessvoid_n4s_e_target.mdl"
endif
call YS7(tx,IH7,"origin",1)
endif
if IsUnitType(IH7, UNIT_TYPE_HERO) then
call SJSDAddStun(IH7, 1.)
else
call SJSDAddStun(IH7, 2.)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", IH7, "origin"))
call B67(ZX7,IH7,1,20+5*level+damage)
call SetUnitTimeScale(IH7,0)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SJSD2))
call NT7(OB7,"Source",IH7)
set t=null
endfunction
function UTD takes unit I_7 returns boolean
return GetUnitTypeId(I_7)=='H00I' or GetUnitTypeId(I_7)=='H00J' or GetUnitTypeId(I_7)==GetUnitTypeId(GetTriggerUnit()) and GetUnitState(I_7,UNIT_STATE_LIFE)>.5 and GetOwningPlayer(I_7)==GetOwningPlayer(GetTriggerUnit())
endfunction
function UUD takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0N8'
endfunction
function UVD takes nothing returns boolean
return UTD(GetFilterUnit())
endfunction
function UWD takes nothing returns nothing
local unit UXD=GetEnumUnit()
local real yg=YO7(UXD,Z9)
if yg<F8 then
set F8=yg
set D8=UXD
endif
set UXD=null
endfunction
function UYD takes nothing returns boolean
return (IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0)!=null
endfunction
function UZD takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1030PriorDamageFlag=Fe
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",(b1060GetEnumUnit),"origin"))
set Fe=true
call UnitDamageTarget(b1060GetTriggerUnit,(b1060GetEnumUnit),F8,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
set Fe=b1030PriorDamageFlag
set b1060GetTriggerUnit=null
set b1060GetEnumUnit=null
endfunction
function UAD takes nothing returns nothing
local real b1060LocationX=GetSpellTargetX()
local real b1060LocationY=GetSpellTargetY()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local unit p5=b1060GetTriggerUnit
local unit IH7=GetSpellTargetUnit()
local location ZU9
local real x
local real y
local real AQ9=GetUnitX(p5)
local real AR9=GetUnitY(p5)
local group VA9
local boolexpr JJD
local boolean UBD=false
if IH7!=null and UTD(IH7)then
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
set UBD=true
else
set JJD=Condition(function UVD)
set VA9=WS7()
call GroupEnumUnitsInRange(VA9,0,0,$F423F,JJD)
if IH7!=null then
set ZU9=GetUnitLoc(IH7)
else
set ZU9=Location(b1060LocationX,b1060LocationY)
endif
set D8=FirstOfGroup(VA9)
if D8!=null then
set UBD=true
call GroupRemoveUnit(VA9,D8)
set F8=YO7(D8,ZU9)
set Z9=ZU9
call ForGroup(VA9,function UWD)
set IH7=D8
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
endif
call WR7(VA9)
call DestroyBoolExpr(JJD)
call RemoveLocation(ZU9)
endif
if UBD then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl",AQ9,AR9))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl",x,y))
call SetUnitX(p5,x)
call SetUnitY(p5,y)
set F8=60+B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0N8')*20
set JJD=Condition(function UYD)
set VA9=WS7()
call GroupEnumUnitsInRange(VA9,AQ9,AR9,400,JJD)
call ForGroup(VA9,function UZD)
call WR7(VA9)
set VA9=WS7()
call GroupEnumUnitsInRange(VA9,x,y,400,JJD)
call ForGroup(VA9,function UZD)
call WR7(VA9)
call DestroyBoolExpr(JJD)
endif
call DestroyBoolExpr(JJD)
set p5=null
set IH7=null
set ZU9=null
set VA9=null
set JJD=null
set b1060GetTriggerUnit=null
endfunction
