endfunction
function AI_FENLU_ATTACK2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local string VH=LoadStr(L7,OB7,0)
call PLF_Manual(VH)
call FlushChildHashtable(L7,OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
endfunction
function AI_FENLU_ATTACK takes unit ZX7 returns nothing
local player p=GetOwningPlayer(ZX7)
local integer O5=GetPlayerId(p)
local integer n
local string VH
local timer t
local integer OB7
    set U22=ZX7
    if MO7(2000.,M07(ZX7),Condition(function NOTENEMY))==0 then
        set n=GetRandomInt(1,3)
        if n==1 then
            set VH="l"
        elseif n==2 then
            set VH="m"
        else
            set VH="r"
        endif
        if O5>6 then
            set O5=O5-1
        endif
        set VH="-og"+VH+" "+I2S(O5)
        set t=CreateTimer()
        set OB7=GetHandleId(t)
        call SaveStr(L7, OB7, 0, VH)
        call TimerStart(t, 1., false, function AI_FENLU_ATTACK2)
        set t=null
    endif
set p=null
endfunction
function AUTO_CHANGE_FORM2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit ZX7=LoadUnitHandle(L7,OB7,0)
local integer i1=GetUnitTypeId(ZX7)
// B1081: the passive shield has no order state to restore.
call FlushChildHashtable(L7,OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set ZX7=null
endfunction
function AUTO_CHANGE_FORM takes unit ZX7 returns nothing
local integer i1=GetUnitTypeId(ZX7)
local timer t
local integer OB7
if i1!='N016' and i1!='H00V' and i1!='H08D' and i1!='H08C' and i1!='H084' and i1!='H08B' then
        return
    endif
    set t=CreateTimer()
    set OB7=GetHandleId(t)
    call SaveUnitHandle(L7, OB7, 0, ZX7)
    call TimerStart(t, .8, false, function AUTO_CHANGE_FORM2)
set t=null
endfunction
function Func_AUTO_CHANGE_FORM takes nothing returns nothing
    call AUTO_CHANGE_FORM(ZX7_tmp)
endfunction
//英雄复活
function O6G takes nothing returns nothing
local unit WX7=GetTriggerUnit()
local player p=GetOwningPlayer(WX7)
local real x
local real y
local integer DX8
local boolean CHI_BS=false
local real now=TimerGetElapsed(W)-M_4
// Aegis performs its one status/skill rebuild in the deferred completion owner.
if OO7(GetHandleId(WX7),"B1018AegisPending") then
set WX7=null
set p=null
return
endif
if DGFS(WX7) then
set WX7=null
set p=null
return
endif
if GetUnitTypeId(WX7)=='NTY1' or GetUnitTypeId(WX7)=='NTY2' then
set WX7=null
set p=null
return
endif
if GetUnitTypeId(WX7)=='NB0S' and ChaosObserverDefeated then
call RemoveUnit(WX7)
set WX7=null
set p=null
return
endif
call FixUnitPause(WX7,Player(0))
call FixUnitSilence(WX7)
call OX7(WX7,"HideUnit")
call OX7(WX7,"4316")
call OX7(WX7,"QPD")
call OX7(WX7,"JINU")
call OX7(WX7,"DISRB")
call OX7(WX7,"chongsheng")
call OX7(WX7,"ShallowGrave|Active")
call SaveBoolean(L7,GetHandleId(WX7),'DARK',false)
call SaveInteger(TABLE_HY, GetHandleId(WX7), 'echs', 0)
call RemoveSavedHandle(TABLE_HY, GetHandleId(WX7),'A4KW')
call RemoveSavedHandle(TABLE_HY, GetHandleId(WX7),'A4GA')
call RemoveSavedHandle(TABLE_HY, GetHandleId(WX7),'A18X')
set HSS[GetPlayerId((p))]=false
set IG4[GetPlayerId(GetOwningPlayer((WX7)))]=false
call YZ8(WX7)
call YW8(WX7,0,0)
call UnitRemoveBuffs(WX7,true,true)
call CK7(WX7)
// B834: keep the normal debuff cleanup, but a Reincarnation completion must
// not move to the fountain or apply Bloodstone/ordinary-respawn penalties.
// HAG still owns saved position, mana, skill/item refresh and final selection.
if OO7(GetHandleId(WX7),"B834ReincarnationPending") then
call DP8(WX7)
set SUIJI_EVENT_UNIT=WX7
call ExecuteFunc("SuijiMode_OnHeroReviveCurrent")
set WX7=null
set p=null
return
endif
if TV7(GetOwningPlayer(WX7))then
set x=GetRectCenterX(ED)
set y=GetRectCenterY(ED)
else
set x=GetRectCenterX(L9)
set y=GetRectCenterY(L9)
endif
if D87 then
set ZSS[GetPlayerId(p)]=R2I(TimerGetRemaining(U[GetPlayerId(p)])*0.25)
set VSS[GetPlayerId(p)]=(TimerGetElapsed(W))+TimerGetRemaining(U[GetPlayerId(p)])
else
set ZSS[GetPlayerId(p)]=0
endif
call TimerStart(U[GetPlayerId(p)],0.0,false,null)
if DU8(WX7)then
call D18(WX7)
else
call DS8(WX7,p,x,y,false)
endif
call SetUnitX(WX7,x)
call SetUnitY(WX7,y)
call DP8(WX7)
call SetUnitPathing(WX7,true)
if TZ7(GetOwningPlayer(WX7))==false then
if MV7(WX7,ZU[DI4])!=null and GetUnitTypeId(WX7)!='H00J' then
set DX8=(R2I(((GetItemCharges(MV7(WX7,ZU[DI4]))*0.85)*1.0)))
if GetItemCharges(MV7(WX7,ZU[DI4]))==1 then
set DX8=0
endif
call SetItemCharges(MV7(WX7,ZU[DI4]),DX8)
call SaveInteger(TABLE_VV,'I0BK',GetPlayerId(GetOwningPlayer(WX7)),DX8)
endif
call AddHeroXP(WX7,GetHeroXP(OA4[GetPlayerId(GetOwningPlayer(WX7))]),true)
call RemoveUnit(OA4[GetPlayerId(GetOwningPlayer(WX7))])
endif
if RZ4 and GetUnitPointValue(WX7)==500 then
call OGG(WX7,'A504')
endif
//非死亡模式概率吃宝石
if XM_MODE and GetUnitLevel(WX7)>=25 and not D4 and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
    if TV7(p) and JW_CHI_BS==false and now>JW_BS_COOL then
        set JW_BS_COOL=now+3600
        set CHI_BS=true
		set JW_CHI_BS=true
    elseif TW7(p) and TZ_CHI_BS==false and now>TZ_BS_COOL then
        set TZ_BS_COOL=now+3600
        set CHI_BS=true
		set TZ_CHI_BS=true
    endif
    if CHI_BS then
        call XF7(WX7,'A332')
        call UnitMakeAbilityPermanent(WX7,true,'A14K')
        call SetPlayerAbilityAvailable(p,'A332',false)
        call XF7(WX7,'A26A')
        call XF7(WX7,'A333')
        call DisplayTimedTextToForce(GetPlayersAll(), 10.00, Q[GetPlayerId(p)]+(KZ4[GetPlayerId(p)])+"("+GetUnitName(WX7)+")"+"|r |c00ffff00获得了真视之力|r")
    endif
endif
call AUTO_CHANGE_FORM(WX7)
set SUIJI_EVENT_UNIT=WX7
call ExecuteFunc("SuijiMode_OnHeroReviveCurrent")
set B957Revived=WX7
call ExecuteFunc("B957OnRevive")
//AI分路
if AIFL and (XM_MODE or AM_MODE) and GetUnitLevel(WX7)>=16 and (PE4==false and PG4==false and PF4==false and PH4==false) and GetPlayerController(p)==MAP_CONTROL_COMPUTER then
    call AI_FENLU_ATTACK(WX7)
endif
set WX7=null
set p=null
endfunction
function OLG takes unit O1G,integer O0G returns nothing
call UnitRemoveAbility(O1G,'A554')
call UnitRemoveAbility(O1G,'A555')
call UnitRemoveAbility(O1G,'A556')
call UnitRemoveAbility(O1G,'A557')
call UnitRemoveAbility(O1G,'A558')
if O0G>=16 then
call UnitAddAbility(O1G,'A558')
set O0G=O0G-16
endif
if O0G>=8 then
call UnitAddAbility(O1G,'A557')
set O0G=O0G-8
endif
if O0G>=4 then
call UnitAddAbility(O1G,'A556')
set O0G=O0G-4
endif
if O0G>=2 then
call UnitAddAbility(O1G,'A555')
set O0G=O0G-2
endif
if O0G>=1 then
call UnitAddAbility(O1G,'A554')
set O0G=O0G-1
endif
endfunction
function O5G takes nothing returns boolean
return B287_GetSpellAbilityId()=='A550'
endfunction
function O2G takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer O_G=(1+GetUnitAbilityLevel(O1G,'A550'))*GetHeroStr(O1G,true)
local integer P4G=OM7(GetHandleId(O1G),"iPFCount")+1
local integer O0G=OM7(GetHandleId(O1G),"iPFStrength")
local integer P7G=O0G
if P4G>9 then
set P4G=0
set P7G=YG7(5*GetUnitAbilityLevel(O1G,'A550'),O0G+1)
if P7G!=O0G then
call OLG(O1G,P7G)
if m5!=O1G then
call YW7("+1 Strength",3,O1G,.023,$FF,0,0,$FF)
endif
endif
endif
call SetUnitState(m5,UNIT_STATE_LIFE,GetUnitState(m5,UNIT_STATE_LIFE)+O_G)
if P4G!=0 or m5!=O1G or P7G==O0G then
call YW7("+"+I2S(O_G)+" HP",3,m5,.023,$FF,0,0,$FF)
else
call YW7("+"+I2S(O_G)+" HP\n        +1 Strength",3,O1G,.023,255,0,0,255)
endif
call NP7(GetHandleId(O1G),"iPFCount",P4G)
call NP7(GetHandleId(O1G),"iPFStrength",P7G)
set O1G=null
set m5=null
endfunction
function P8G takes nothing returns boolean
return C67(GetEventDamage())
endfunction
function P9G takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local real PDG=ON7(GetHandleId(O1G),"rPFDamage")+GetEventDamage()
local integer O0G=OM7(GetHandleId(O1G),"iPFStrength")
local integer P7G=O0G
if PDG>=500 then
set PDG=PDG-500
set P7G=YG7(5*GetUnitAbilityLevel(O1G,'A550'),O0G+1)
if P7G!=O0G then
call OLG(O1G,P7G)
call YW7("+1 Strength",3,O1G,.023,$FF,0,0,$FF)
endif
endif
call NQ7(GetHandleId(O1G),"rPFDamage",PDG)
call NP7(GetHandleId(O1G),"iPFStrength",P7G)
set O1G=null
endfunction
function PEG takes nothing returns boolean
return B287_GetLearnedSkill()=='A550' and GetUnitAbilityLevel(GetTriggerUnit(),'A550')==1
endfunction
function PFG takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local trigger t=CreateTrigger()
call B1023RegisterDamage(t,O1G)
call TriggerAddCondition(t,Condition(function P8G))
call TriggerAddAction(t,function P9G)
call NQ7(GetHandleId(O1G),"rPFDamage",0)
call NP7(GetHandleId(O1G),"iPFCount",0)
call NP7(GetHandleId(O1G),"iPFStrength",0)
set t=null
set O1G=null
endfunction
function PW8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function O5G))
call TriggerAddAction(t,function O2G)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function PEG))
call TriggerAddAction(t,function PFG)
set t=null
endfunction
function PGG takes unit O1G,integer PHG returns nothing
call UnitRemoveAbility(O1G,'A559')
call UnitRemoveAbility(O1G,'A55A')
call UnitRemoveAbility(O1G,'A55B')
call UnitRemoveAbility(O1G,'A55C')
call UnitRemoveAbility(O1G,'A55D')
if PHG>=16 then
call UnitAddAbility(O1G,'A55D')
set PHG=PHG-16
endif
if PHG>=8 then
call UnitAddAbility(O1G,'A55C')
set PHG=PHG-8
endif
if PHG>=4 then
call UnitAddAbility(O1G,'A55B')
set PHG=PHG-4
endif
if PHG>=2 then
call UnitAddAbility(O1G,'A55A')
set PHG=PHG-2
endif
if PHG>=1 then
call UnitAddAbility(O1G,'A559')
set PHG=PHG-1
endif
endfunction
function PIG takes nothing returns boolean
return B287_GetSpellAbilityId()=='A551'
endfunction
function PJG takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit m5=O77(GetHandleId(t),"SFluxTarget")
call UnitRemoveAbility(m5,'A55J')
call UnitRemoveAbility(m5,'A55N')
call UnitRemoveAbility(m5,'A55O')
call UnitRemoveAbility(m5,'A55P')
call UnitRemoveAbility(m5,'B55J')
call UnitRemoveAbility(m5,'B55N')
call UnitRemoveAbility(m5,'B55O')
call UnitRemoveAbility(m5,'B55P')
call VX7(t)
set t=null
set m5=null
endfunction
function PKG takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local real PMG=.25*GetHeroAgi(O1G,true)
local integer PNG=OM7(GetHandleId(O1G),"iSFCount")+1
local integer PHG=OM7(GetHandleId(O1G),"iSFAgility")
local integer POG=PHG
local trigger t=CreateTrigger()
local integer V77=GetUnitAbilityLevel(O1G,'A551')
if PNG>9 then
set PNG=0
set POG=YG7(5*V77,PHG+1)
if POG!=PHG then
call PGG(O1G,POG)
if m5!=O1G then
call YW7("+1 Agility",3,O1G,.023,0,$FF,0,$FF)
endif
endif
endif
call VX7(OE7(GetHandleId(m5),"SFluxEndTrig"))
call UnitRemoveAbility(m5,'A55J')
call UnitRemoveAbility(m5,'A55N')
call UnitRemoveAbility(m5,'A55O')
call UnitRemoveAbility(m5,'A55P')
call UnitRemoveAbility(m5,'B55J')
call UnitRemoveAbility(m5,'B55N')
call UnitRemoveAbility(m5,'B55O')
call UnitRemoveAbility(m5,'B55P')
if V77==1 then
call UnitAddAbility(m5,'A55J')
elseif V77==2 then
call UnitAddAbility(m5,'A55N')
elseif V77==3 then
call UnitAddAbility(m5,'A55O')
elseif V77==4 then
call UnitAddAbility(m5,'A55P')
endif
call TriggerRegisterTimerEvent(t,PMG,false)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddAction(t,function PJG)
call NT7(GetHandleId(t),"SFluxTarget",m5)
call NV7(GetHandleId(m5),"SFluxEndTrig",t)
if PNG!=0 or m5!=O1G or POG==PHG then
call YW7(R2S(PMG)+" s",3,m5,.023,0,$FF,0,$FF)
else
call YW7(R2S(PMG)+" s\n        +1 Agility",3,O1G,.023,0,255,0,255)
endif
call NP7(GetHandleId(O1G),"iSFCount",PNG)
call NP7(GetHandleId(O1G),"iSFAgility",POG)
set O1G=null
set m5=null
set t=null
endfunction
function PPG takes nothing returns boolean
return C67(GetEventDamage())
endfunction
function PQG takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local integer PRG=OM7(GetHandleId(O1G),"iSFHit")+1
local integer PHG=OM7(GetHandleId(O1G),"iSFAgility")
local integer POG=PHG
if PRG>=20 then
set PRG=0
set POG=YG7(5*GetUnitAbilityLevel(O1G,'A551'),PHG+1)
if POG!=PHG then
call PGG(O1G,POG)
call YW7("+1 Agility",3,O1G,.023,0,$FF,0,$FF)
endif
endif
call NP7(GetHandleId(O1G),"iSFHit",PRG)
call NP7(GetHandleId(O1G),"iSFAgility",POG)
set O1G=null
endfunction
function PSG takes nothing returns boolean
return B287_GetLearnedSkill()=='A551' and GetUnitAbilityLevel(GetTriggerUnit(),'A551')==1
endfunction
function PTG takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local trigger t=CreateTrigger()
call B1023RegisterDamage(t,O1G)
call TriggerAddCondition(t,Condition(function PPG))
call TriggerAddAction(t,function PQG)
call NP7(GetHandleId(O1G),"iSFHit",0)
call NP7(GetHandleId(O1G),"iSFCount",0)
call NP7(GetHandleId(O1G),"iSFAgility",0)
set t=null
set O1G=null
endfunction
function PX8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PIG))
call TriggerAddAction(t,function PKG)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function PSG))
call TriggerAddAction(t,function PTG)
set t=null
endfunction
function PUG takes unit O1G,integer PVG returns nothing
call UnitRemoveAbility(O1G,'A55E')
call UnitRemoveAbility(O1G,'A55F')
call UnitRemoveAbility(O1G,'A55G')
call UnitRemoveAbility(O1G,'A55H')
call UnitRemoveAbility(O1G,'A55I')
if PVG>=16 then
call UnitAddAbility(O1G,'A55I')
set PVG=PVG-16
endif
if PVG>=8 then
call UnitAddAbility(O1G,'A55H')
set PVG=PVG-8
endif
if PVG>=4 then
call UnitAddAbility(O1G,'A55G')
set PVG=PVG-4
endif
if PVG>=2 then
call UnitAddAbility(O1G,'A55F')
set PVG=PVG-2
endif
if PVG>=1 then
call UnitAddAbility(O1G,'A55E')
set PVG=PVG-1
endif
endfunction
function PWG takes nothing returns boolean
return B287_GetSpellAbilityId()=='A552'
endfunction
function PXG takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit m5=O77(GetHandleId(t),"MFluxTarget")
local integer PYG=OM7(GetHandleId(t),"iMFluxMP")
call SetUnitState(m5,UNIT_STATE_MANA,GetUnitState(m5,UNIT_STATE_MANA)+PYG)
call VX7(t)
set t=null
set m5=null
endfunction
function PZG takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer PYG=R2I(.75*GetUnitAbilityLevel(O1G,'A552')*GetHeroInt(O1G,true))
local integer PAG=OM7(GetHandleId(O1G),"iMFCount")+1
local integer PVG=OM7(GetHandleId(O1G),"iMFIntelligence")
local integer PBG=PVG
local trigger t=CreateTrigger()
if PAG>9 then
set PAG=0
set PBG=YG7(5*GetUnitAbilityLevel(O1G,'A552'),PVG+1)
if PBG!=PVG then
call PUG(O1G,PBG)
if m5!=O1G then
call YW7("+1 Intelligence",3,O1G,.023,0,0,$FF,$FF)
endif
endif
endif
call NT7(GetHandleId(t),"MFluxTarget",m5)
call NP7(GetHandleId(t),"iMFluxMP",PYG)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddAction(t,function PXG)
if PAG!=0 or m5!=O1G or PBG==PVG then
call YW7("+"+I2S(PYG)+" MP",3,m5,.023,0,0,$FF,$FF)
else
call YW7("+"+I2S(PYG)+" MP\n        +1 Intelligence",3,O1G,.023,0,0,255,255)
endif
call NP7(GetHandleId(O1G),"iMFCount",PAG)
call NP7(GetHandleId(O1G),"iMFIntelligence",PBG)
set O1G=null
set m5=null
set t=null
endfunction
function PCG takes nothing returns boolean
return GetSpellTargetUnit()==O77(GetHandleId(GetTriggeringTrigger()),"uKappa")and IsUnitEnemy(O77(GetHandleId(GetTriggeringTrigger()),"uKappa"),GetOwningPlayer(GetTriggerUnit()))
endfunction
function P3G takes nothing returns nothing
local unit O1G=GetSpellTargetUnit()
local integer P6G=OM7(GetHandleId(O1G),"iMFCast")+1
local integer PVG=OM7(GetHandleId(O1G),"iMFIntelligence")
local integer PBG=PVG
if P6G>=3 then
set P6G=0
set PBG=YG7(5*GetUnitAbilityLevel(O1G,'A552'),PVG+1)
if PBG!=PVG then
call PUG(O1G,PBG)
call YW7("+1 Intelligence",3,O1G,.023,0,0,$FF,$FF)
endif
endif
call NP7(GetHandleId(O1G),"iMFCast",P6G)
call NP7(GetHandleId(O1G),"iMFIntelligence",PBG)
set O1G=null
endfunction
function PLG takes nothing returns boolean
return B287_GetLearnedSkill()=='A552' and GetUnitAbilityLevel(GetTriggerUnit(),'A552')==1
endfunction
function P1G takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function PCG))
call TriggerAddAction(t,function P3G)
call NT7(GetHandleId(t),"uKappa",O1G)
call NP7(GetHandleId(O1G),"iMFCast",0)
call NP7(GetHandleId(O1G),"iMFCount",0)
call NP7(GetHandleId(O1G),"iMFIntelligence",0)
set t=null
set O1G=null
endfunction
function PY8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function PWG))
call TriggerAddAction(t,function PZG)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function PLG))
call TriggerAddAction(t,function P1G)
set t=null
endfunction
function P0G takes nothing returns boolean
return B287_GetSpellAbilityId()=='A553'
endfunction
function P5G takes nothing returns nothing
local unit O1G=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local integer P2G=0
local integer P_G=0
if GetUnitAbilityLevel(O1G,'A55K')>0 then
set P_G=OM7(GetHandleId(O1G),"iPFStrength")
elseif GetUnitAbilityLevel(O1G,'A55L')>0 then
set P_G=OM7(GetHandleId(O1G),"iSFAgility")
elseif GetUnitAbilityLevel(O1G,'A55M')>0 then
set P_G=OM7(GetHandleId(O1G),"iMFIntelligence")
endif
set P2G=P_G/2
if ModuloInteger(P_G,2)>0 then
set P2G=P2G+1
endif
set P_G=P_G/2
if GetUnitAbilityLevel(O1G,'A55K')>0 then
call OLG(O1G,0)
call NP7(GetHandleId(O1G),"iPFStrength",0)
call SetHeroStr(m5,GetHeroStr(m5,false)+P2G,true)
call SetHeroStr(O1G,GetHeroStr(O1G,false)+P_G,true)
call YW7("+"+I2S(P2G)+" Strength",3,m5,.023,$FF,0,0,$FF)
call YW7("+"+I2S(P_G)+" Strength",3,O1G,.023,$FF,0,0,$FF)
call NP7(GetHandleId(m5),"FluxStr",OM7(GetHandleId(m5),"FluxStr")+P2G)
call NP7(GetHandleId(O1G),"FluxStr",OM7(GetHandleId(O1G),"FluxStr")+P_G)
elseif GetUnitAbilityLevel(O1G,'A55L')>0 then
call PGG(O1G,0)
call NP7(GetHandleId(O1G),"iSFAgility",0)
call SetHeroAgi(m5,GetHeroAgi(m5,false)+P2G,true)
call SetHeroAgi(O1G,GetHeroAgi(O1G,false)+P_G,true)
call YW7("+"+I2S(P2G)+" Agility",3,m5,.023,0,$FF,0,$FF)
call YW7("+"+I2S(P_G)+" Agility",3,O1G,.023,0,$FF,0,$FF)
call NP7(GetHandleId(m5),"FluxAgi",OM7(GetHandleId(m5),"FluxAgi")+P2G)
call NP7(GetHandleId(O1G),"FluxAgi",OM7(GetHandleId(O1G),"FluxAgi")+P_G)
elseif GetUnitAbilityLevel(O1G,'A55M')>0 then
call PUG(O1G,0)
call NP7(GetHandleId(O1G),"iMFIntelligence",0)
call SetHeroInt(m5,GetHeroInt(m5,false)+P2G,true)
call SetHeroInt(O1G,GetHeroInt(O1G,false)+P_G,true)
call YW7("+"+I2S(P2G)+" Intelligence",3,m5,.023,0,0,$FF,$FF)
call YW7("+"+I2S(P_G)+" Intelligence",3,O1G,.023,0,0,$FF,$FF)
call NP7(GetHandleId(m5),"FluxInt",OM7(GetHandleId(m5),"FluxInt")+P2G)
