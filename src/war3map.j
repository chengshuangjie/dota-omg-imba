function A_number takes unit u returns integer
local integer inventorySize=UnitInventorySize(u)
local integer i=0
local integer n=0
local integer Z48
local item it
loop
exitwhen i > inventorySize
set it = UnitItemInSlot(u, i)
if it != null then
set Z48=KZ7(it)
if Z48==GB4 or Z48==G64 or Z48==G04 then
set n=n+1
endif
endif
set i=i+1
endloop
set it=null
return n
endfunction
