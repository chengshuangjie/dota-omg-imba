if suijiGlobalInitSource==63 or suijiGlobalInitSource==64 or suijiGlobalInitSource==65 or suijiGlobalInitSource==66 or suijiGlobalInitSource==67 or suijiGlobalInitSource==68 or suijiGlobalInitSource==69 or suijiGlobalInitSource==70 then
