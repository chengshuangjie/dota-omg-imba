function KKD59HeroItems takes nothing returns nothing
local unit ZX7=GetEnumUnit()
local item bloodstone939=null
if ZX7==null or GetUnitTypeId(ZX7)==0 or UnitAlive(ZX7)==false then
set ZX7=null
return
endif
if (IsUnitType(ZX7,UNIT_TYPE_HERO) or AS7(ZX7)) and IsUnitIllusion(ZX7)==false and MRPH(ZX7)==false then
    set bloodstone939=MV7(ZX7,ZU[DI4])
    if bloodstone939!=null then
        call D19(ZX7,GetItemCharges(bloodstone939))  //血精
    endif
    if GetUnitAbilityLevel(ZX7,'A15Y')>0 and Have_Item(ZX7, ZU[R2]) then
        call LXHX(ZX7) //龙心
    endif
endif
set bloodstone939=null
set ZX7=null
endfunction
function KKD59DefenseAura takes nothing returns nothing
local unit ZX7=GetEnumUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 or not UnitAlive(ZX7) or not IsUnitInGroup(ZX7,PlayerUnitGroup) or not B935HasDefenseRegen(ZX7) then
call GroupRemoveUnit(B935DefenseActive,ZX7)
set ZX7=null
return
endif
if IsUnitType(ZX7,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(ZX7)==false and GetUnitAbilityLevel(ZX7,'A04R')==0 then
    call FYGH(ZX7)      //防御光环
endif
set ZX7=null
endfunction
function D59 takes nothing returns boolean
local group g=WS7()
call GroupAddGroup(KKPeriodicHeroItemGroup,g)
call ForGroup(g,function KKD59HeroItems)
call GroupClear(g)
call ForGroup(B935DefenseSources,function B935ScanDefenseSource)
call GroupAddGroup(B935DefenseActive,g)
call ForGroup(g,function KKD59DefenseAura)
call WR7(g)
set g=null
return false
endfunction
