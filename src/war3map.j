function K3G takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if GetTriggerEventId()==EVENT_PLAYER_UNIT_SPELL_EFFECT then
if B287_GetSpellAbilityId()=='A19Z' then
