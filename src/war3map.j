function FJ9 takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real YM7=300
local real d
if OT7((b1060GetEnumUnit),"FK9") then
call X37(GetOwningPlayer((b1060GetEnumUnit)),GetObjectName('n02M')+" "+GetUnitName((b1060GetEnumUnit))+" "+GetObjectName('n02S'))
else
if IsUnitType((b1060GetEnumUnit),UNIT_TYPE_HERO) then
call O37((b1060GetEnumUnit),"FK9",25)
endif
set d=DGH_BUFF((b1060GetEnumUnit))
call SetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE,GetUnitState((b1060GetEnumUnit),UNIT_STATE_LIFE)+YM7*d)
endif
set b1060GetEnumUnit=null
endfunction
