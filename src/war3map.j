if uS>us then
set uS=us*2-uS
endif
call SetUnitFlyHeight(WI7,YK7(uS,0),0)
if IsHideUnit(WI7)==false then
    call SetUnitX(WI7,X17(Il))
    call SetUnitY(WI7,X07(IL))
endif
call SetUnitFacing(WI7,RK)
call NQ7(OB7,"DistanceRemaining",ur-20)
if (uS<1 and ur-uR!=0) or IsHideUnit(WI7) then
call NS7(GetHandleId(WI7),"InAir",false)
call SetUnitFacing(WI7,RK)
call SetUnitAnimation(WI7,"stand")
call SetUnitPathing(WI7,true)
call uo(WI7)
call uN(WI7)
call PauseTimer(t)
call NM7(OB7)
call DestroyTimer(t)
if id=='Z01V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n7s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Z11V' then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_PotM(1)_E2.mdx",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Z21V' then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_PotMpink_E2.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Z31V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n4s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Z41V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n5s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
endif
endif
set t=null
set WI7=null
endfunction
