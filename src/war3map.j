call MHDamagingEvent_Register(t)
set t=null
endfunction
function B3D takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer V77=0
local integer skill
if p5==null or GetUnitTypeId(p5)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
return false
endif
set V77=B287_GetUnitAbilityLevel(p5,'A15J')+GetUnitAbilityLevel(p5,'X15J')
if GetUnitAbilityLevel(p5,'X15J')>0 then
set skill='X15K'
else
set skill='A15K'
endif
//call SetUnitAbilityLevel(p5,skill,V77)
call C77(p5,300+V77*100)
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
return false
endfunction
function B6D takes nothing returns nothing
if IsUnitType(IN4,UNIT_TYPE_HERO) then
if BCD(IP4)then
call SetUnitState(IP4,UNIT_STATE_LIFE,GetUnitState(IP4,UNIT_STATE_LIFE)+GetUnitState(IP4,UNIT_STATE_MAX_LIFE)*.1)
else
call SetUnitState(IP4,UNIT_STATE_LIFE,GetUnitState(IP4,UNIT_STATE_LIFE)+GetUnitState(IP4,UNIT_STATE_MAX_LIFE)*.06)
endif
else
if BCD(IP4)then
call SetUnitState(IP4,UNIT_STATE_LIFE,GetUnitState(IP4,UNIT_STATE_LIFE)+GetUnitState(IP4,UNIT_STATE_MAX_LIFE)*.03)
else
call SetUnitState(IP4,UNIT_STATE_LIFE,GetUnitState(IP4,UNIT_STATE_LIFE)+GetUnitState(IP4,UNIT_STATE_MAX_LIFE)*.02)
endif
endif
endfunction
function BLD takes nothing returns boolean
local unit b1060GetDyingUnit=GetDyingUnit()
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t2=GetTriggeringTrigger()
local integer UB9=GetHandleId(t2)
local trigger t1=OE7(UB9,"t1")
local integer IID=GetHandleId(t1)
local unit p5=O77(UB9,"Source")
local unit m5
local real d
local real a
local boolean B1D=OO7(UB9,"IgnorePlague")
local integer id=0
local integer skillmj
if p5==null or GetUnitTypeId(p5)==0 then
call NM7(IID)
call NM7(UB9)
call OZ7(t1)
call OZ7(t2)
set t1=null
set t2=null
set p5=null
set b1060ReturnValue=false
set b1060GetDyingUnit=null
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
set id=GetUnitTypeId(p5)
if id=='Z00R' or id=='Z07I' then
set skillmj='h17Y'
else
set skillmj='h07Y'
endif
if(b1060GetTriggerEventId==EVENT_UNIT_DEATH and b1060GetTriggerUnit==p5)or(b1060GetTriggerEventId!=EVENT_UNIT_DAMAGED and b1060GetTriggerEventId!=EVENT_UNIT_DEATH)then
call C77(p5,0)
call UnitRemoveAbility(p5,'ZUDH')
call SuijiMode_EndVisualForm(p5,8)
call DestroyEffect(LoadEffectHandle(L7,UB9,32))
call NM7(IID)
call NM7(UB9)
call OZ7(t1)
call OZ7(t2)
elseif b1060GetTriggerEventId==EVENT_UNIT_DEATH then
if IsUnitIllusion(b1060GetDyingUnit)==false then
call ZF7(b1060GetDyingUnit,p5,skillmj,"B6D",600)
endif
elseif B1D==false then
set m5=b1060GetTriggerUnit
set d=KE7(p5,m5)
if b1060GetEventDamage>4 then
if d<250 then
if BCD(p5)then
set a=25+5*WZ
else
set a=15+5*WZ
endif
elseif d>=250 and d<750 then
if BCD(p5)then
set a=(20+5*WZ)-15*((d-250)/500)
else
set a=(15+5*WZ)-15*((d-250)/500)
endif
else
set a=0
endif
if a>0 then
call NS7(UB9,"IgnorePlague",true)
call B67(b1060GetEventDamageSource,m5,3,b1060GetEventDamage*a/100)
call NS7(UB9,"IgnorePlague",false)
endif
endif
endif
set t2=null
set t1=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetDyingUnit=null
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function B0D takes nothing returns boolean
local trigger t1=GetTriggeringTrigger()
local integer IID=GetHandleId(t1)
local trigger t2=OE7(IID,"t2")
local integer UB9=GetHandleId(t2)
local unit m5=GetTriggerUnit()
local unit p5=O77(IID,"Source")
if IsUnitEnemy(p5,GetOwningPlayer(m5)) and IsUnitType(m5,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(m5,'A04R')==0 then
if OO7(UB9,"Registered"+I2S(GetHandleId(m5)))==false then
call B1023RegisterDamage(t2,m5)
call TriggerRegisterUnitEvent(t2,m5,EVENT_UNIT_DEATH)
call NS7(UB9,"Registered"+I2S(GetHandleId(m5)),true)
endif
endif
set t1=null
set t2=null
set m5=null
set p5=null
return false
endfunction
function B5D takes nothing returns nothing
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local unit p5=GetTriggerUnit()
local trigger t1=CreateTrigger()
local integer IID=GetHandleId(t1)
local trigger t2=CreateTrigger()
local integer UB9=GetHandleId(t2)
local trigger t3=CreateTrigger()
local integer B2D=GetHandleId(t3)
local integer V77=B287_GetUnitAbilityLevel(p5,'A15J')+GetUnitAbilityLevel(p5,'X15J')
