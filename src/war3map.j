// Invoker's invoked buttons are one-level native carriers. Random OMG uses
// isolated three-level carriers so the original Invoker command card and
// invoke lifecycle remain untouched.
function B287_IsInvokerRandomCloneSkill takes integer logicalSkill returns boolean
return logicalSkill=='A0VQ' or logicalSkill=='A0VG' or logicalSkill=='A0VN' or logicalSkill=='A0VM'
endfunction
function B287_ShouldUseFixedClone takes integer logicalSkill returns boolean
if SUIJI_FIXED_CLONE_ENABLED==false then
return false
endif
if B287_IsInvokerRandomCloneSkill(logicalSkill) then
return true
endif
if SUIJI_FIXED_CLONE_ALL then
return LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)!=0
endif
return B287_IsPhase2CloneSkill(logicalSkill) or B287_IsPhase3CloneSkill(logicalSkill) or B287_IsPhase4CloneSkill(logicalSkill) or B287_IsPhase5CloneSkill(logicalSkill) or B287_IsPhase6CloneSkill(logicalSkill) or B287_IsPhase7CloneSkill(logicalSkill) or B287_IsPhase8CloneSkill(logicalSkill) or B287_IsPhase9CloneSkill(logicalSkill) or B287_IsPhase10CloneSkill(logicalSkill) or B287_IsPhase11CloneSkill(logicalSkill) or B287_IsPhase12CloneSkill(logicalSkill) or B287_IsPhase13CloneSkill(logicalSkill) or B287_IsPhase14CloneSkill(logicalSkill) or B287_IsPhase15CloneSkill(logicalSkill) or B287_IsPhase16CloneSkill(logicalSkill)
endfunction
// Some OMG "passives" are implemented by attack-event scripts rather than
// Warcraft's passive ability flag.  A late UnitAddAbility on an illusion is
// not reliable for those abilities, so the script reads the stable hero's
// selected OMG slot at attack time instead.  Keep this whitelist explicit:
// an active skill must never be inherited through this bridge.
function SuijiMode_IsIllusionPassiveBridgeSkill takes integer skill returns boolean
if skill=='A0MP' then
return true
endif
if skill=='A0BK' or skill=='A022' or skill=='A0SS' or skill=='A4EU' or skill=='A0JJ' or skill=='A081' or skill=='A01K' or skill=='A09E' or skill=='A0G5' then
return true
endif
return skill=='ABcr' or skill=='A03Q' or skill=='A03N' or skill=='A00K' or skill=='A2PX' or skill=='A1OY'
endfunction
function SuijiMode_GetIllusionPassiveBridgeLevel takes unit u,integer skill returns integer
local unit source=null
local integer level=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return 0
endif
set level=GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,skill))
if level>0 or IsUnitIllusion(u)==false or SuijiMode_IsIllusionPassiveBridgeSkill(skill)==false then
return level
endif
set source=M7[GetPlayerId(GetOwningPlayer(u))]
if source!=null and GetUnitTypeId(source)!=0 and LoadBoolean(L7,GetHandleId(source),StringHash("SuijiDone")) and (LoadInteger(L7,GetHandleId(source),StringHash("SuijiSmallSkill"))==skill or LoadInteger(L7,GetHandleId(source),StringHash("SuijiUltSkill"))==skill) then
set level=GetUnitAbilityLevel(source,B287_GetPhysicalAbilityId(source,skill))
endif
set source=null
return level
endfunction
function B287_GetUnitAbilityLevel takes unit u,integer logicalSkill returns integer
local integer level=0
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 then
return 0
endif
set level=GetUnitAbilityLevel(u,B287_GetPhysicalAbilityId(u,logicalSkill))
if level>0 then
return level
endif
// An existing illusion cannot reliably receive every OMG passive ability.
// The explicit bridge below is limited to selected attack-passive skills.
return SuijiMode_GetIllusionPassiveBridgeLevel(u,logicalSkill)
endfunction
function SuijiMode_HasExactLiveAbility takes unit u,integer skill returns boolean
// B540 expanded MHAbility_GetAbility/GetId into shared lifecycle guards.
// Those lookups enumerate the live command card and can either crash inside
// MemHack or return a client-local result while Warcraft is rebuilding it.
// Native ownership is synchronized and is the B539-validated guard for the
// bounded field writes retained by later gameplay fixes.
return u!=null and GetUnitTypeId(u)!=0 and skill!=0 and GetUnitAbilityLevel(u,skill)>0
endfunction
// Native ownership is the synchronized gameplay authority.  MemHack exact-live
// inspection is intentionally kept separate and may only guard optional live
// object writes; a client-local inspection result must never add/remove/level
// an ability or roll back a synchronized transition.
function SuijiMode_HasNativeAbility takes unit u,integer skill returns boolean
return u!=null and GetUnitTypeId(u)!=0 and skill!=0 and GetUnitAbilityLevel(u,skill)>0
endfunction
function SuijiMode_EnsureExactLiveAbility takes unit u,integer skill,boolean permanent returns boolean
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
if GetUnitAbilityLevel(u,skill)<=0 then
call UnitAddAbility(u,skill)
endif
if GetUnitAbilityLevel(u,skill)<=0 then
return false
endif
if permanent then
call UnitMakeAbilityPermanent(u,true,skill)
endif
return GetUnitAbilityLevel(u,skill)>0
endfunction
function SuijiMode_ClampExactAbilityLevel takes integer skill,integer level returns integer
if skill==0 or level<=0 then
return 0
endif
// Callers already resolve a valid logical level.  Do not use a client-local
// MemHack definition read to decide the synchronized SetUnitAbilityLevel value.
return level
endfunction
function SuijiMode_SetExactLiveAbilityLevel takes unit u,integer skill,integer level returns boolean
set level=SuijiMode_ClampExactAbilityLevel(skill,level)
if level<=0 or SuijiMode_HasNativeAbility(u,skill)==false then
return false
endif
if GetUnitAbilityLevel(u,skill)!=level then
call SetUnitAbilityLevel(u,skill,level)
endif
return GetUnitAbilityLevel(u,skill)==level
endfunction
function SuijiMode_EnsureExactLiveAbilityLevel takes unit u,integer skill,integer level,boolean permanent returns boolean
set level=SuijiMode_ClampExactAbilityLevel(skill,level)
if level<=0 then
return false
endif
if SuijiMode_EnsureExactLiveAbility(u,skill,permanent)==false then
return false
endif
if SuijiMode_SetExactLiveAbilityLevel(u,skill,level)==false then
return false
endif
return true
endfunction
function SuijiMode_GetExactLiveAbilityCastpoint takes unit u,integer skill returns real
local ability abil=null
local integer level=0
local real value=0.
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return 0.
endif
set level=GetUnitAbilityLevel(u,skill)
if level<=0 then
return 0.
endif
set abil=EXGetUnitAbility(u,skill)
if abil==null then
return 0.
endif
set value=EXGetAbilityDataReal(abil,level,ABILITY_DATA_CAST)
set abil=null
return value
endfunction
function SuijiMode_SetExactLiveAbilityCastpoint takes unit u,integer skill,real value returns boolean
local ability abil=null
local integer level=0
local boolean result=false
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
set level=GetUnitAbilityLevel(u,skill)
if level<=0 then
return false
endif
set abil=EXGetUnitAbility(u,skill)
if abil==null then
return false
endif
set result=EXSetAbilityDataReal(abil,level,ABILITY_DATA_CAST,value)
set abil=null
return result
endfunction
function B1000TotemLeapCastpoint takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 or GetUnitAbilityLevel(u,'A4LZ')<=0 then
return
endif
// Match Echo Slam: both object-level cast time and the live engine cast point.
call SuijiMode_SetExactLiveAbilityCastpoint(u,'A4LZ',0.)
call MHAbility_SetCastpoint(u,'A4LZ',0.)
endfunction
function B287_SetUnitAbilityLevel takes unit u,integer logicalSkill,integer level returns integer
local integer physicalSkill=0
if u==null or GetUnitTypeId(u)==0 or logicalSkill==0 or level<=0 then
return 0
endif
set physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if SuijiMode_HasNativeAbility(u,physicalSkill)==false then
return 0
endif
return SetUnitAbilityLevel(u,physicalSkill,level)
endfunction
function B287_GetExpectedAbilityId takes unit u,integer logicalSkill returns integer
local integer cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
local integer alternateSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)
local integer h=0
if alternateSkill!=0 and u!=null and GetUnitTypeId(u)!=0 then
if GetUnitAbilityLevel(u,alternateSkill)>0 then
return alternateSkill
endif
set h=GetHandleId(u)
if (LoadInteger(L7,h,StringHash("SuijiSmallSkill"))==logicalSkill and LoadInteger(L7,h,StringHash("SuijiSmallAbility"))==alternateSkill) or (LoadInteger(L7,h,StringHash("SuijiUltSkill"))==logicalSkill and LoadInteger(L7,h,StringHash("SuijiUltAbility"))==alternateSkill) then
return alternateSkill
endif
endif
if cloneSkill==0 or u==null or GetUnitTypeId(u)==0 then
return logicalSkill
endif
if GetUnitAbilityLevel(u,cloneSkill)>0 then
return cloneSkill
endif
if B287_ShouldUseFixedClone(logicalSkill) then
set h=GetHandleId(u)
if LoadInteger(L7,h,StringHash("SuijiSmallSkill"))==logicalSkill or LoadInteger(L7,h,StringHash("SuijiUltSkill"))==logicalSkill then
return cloneSkill
endif
endif
return logicalSkill
endfunction
function B287_UnitAddAbility takes unit u,integer logicalSkill returns boolean
return UnitAddAbility(u,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction
function B287_UnitRemoveAbility takes unit u,integer logicalSkill returns boolean
return UnitRemoveAbility(u,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction
function B287_UnitMakeAbilityPermanent takes unit u,boolean permanent,integer logicalSkill returns boolean
return UnitMakeAbilityPermanent(u,permanent,B287_GetExpectedAbilityId(u,logicalSkill))
endfunction
function B287_SetUnitAbilityAvailable takes unit u,integer logicalSkill,boolean available returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),B287_GetExpectedAbilityId(u,logicalSkill),available)
endfunction
function B287_IsStateReplaceBaseSkill takes integer logicalSkill returns boolean
return logicalSkill=='A0G8' or logicalSkill=='A1NI' or logicalSkill=='A085' or logicalSkill=='A07U' or logicalSkill=='A2SR' or logicalSkill=='A21F' or logicalSkill=='A21G' or logicalSkill=='A0R0' or logicalSkill=='A1MI' or logicalSkill=='A2SE' or logicalSkill=='A1RJ' or logicalSkill=='A1YY' or logicalSkill=='A1YX' or logicalSkill=='A4B6' or logicalSkill=='A11N' or logicalSkill=='A1A8' or logicalSkill=='A1TA' or logicalSkill=='A0BE' or logicalSkill=='A2E5' or logicalSkill=='A2SH' or logicalSkill=='A2SI'
endfunction
function SuijiMode_SyncStateReplaceBaseSlot takes unit suijiStateBaseUnit,integer suijiStateBaseSkill returns nothing
local integer suijiStateBasePhysical=0
local integer suijiStateBaseX=0
local integer suijiStateBaseY=0
local ability suijiStateBaseAbility=null
if suijiStateBaseUnit==null or GetUnitTypeId(suijiStateBaseUnit)==0 or suijiStateBaseSkill==0 or B287_IsStateReplaceBaseSkill(suijiStateBaseSkill)==false then
return
endif
set suijiStateBasePhysical=B287_GetPhysicalAbilityId(suijiStateBaseUnit,suijiStateBaseSkill)
if SuijiMode_HasExactLiveAbility(suijiStateBaseUnit,suijiStateBasePhysical)==false then
return
endif
set suijiStateBaseAbility=EXGetUnitAbility(suijiStateBaseUnit,suijiStateBasePhysical)
if suijiStateBaseAbility==null then
set suijiStateBaseAbility=null
return
endif
set suijiStateBaseX=MHAbility_GetCustomDataInt(suijiStateBaseUnit,suijiStateBasePhysical,ABILITY_DEF_DATA_BUTTON_X)
set suijiStateBaseY=MHAbility_GetCustomDataInt(suijiStateBaseUnit,suijiStateBasePhysical,ABILITY_DEF_DATA_BUTTON_Y)
call MHAbility_SetCustomDataInt(suijiStateBaseUnit,suijiStateBasePhysical,ABILITY_DEF_DATA_UNBUTTON_X,suijiStateBaseX)
call MHAbility_SetCustomDataInt(suijiStateBaseUnit,suijiStateBasePhysical,ABILITY_DEF_DATA_UNBUTTON_Y,suijiStateBaseY)
set suijiStateBaseAbility=null
endfunction
function B515_IsStableRandomCommandCardSkill takes unit hero,integer logicalSkill returns boolean
local integer h=0
if SUIJI_MODE==false or hero==null or GetUnitTypeId(hero)==0 or logicalSkill==0 then
return false
endif
set h=GetHandleId(hero)
if LoadBoolean(L7,h,StringHash("SuijiDone"))==false or B287_IsStateReplaceBaseSkill(logicalSkill) then
return false
endif
return logicalSkill==LoadInteger(L7,h,StringHash("SuijiSmallSkill")) or logicalSkill==LoadInteger(L7,h,StringHash("SuijiUltSkill"))
endfunction
function SuijiMode_IsTransientStateButton takes integer skill returns boolean
if skill=='AMdT' or skill=='AMdF' then
return true
endif
return skill=='Aamk' or skill=='A0NR' or skill=='A02T' or skill=='A0GC' or skill=='A0HA' or skill=='A0RT' or skill=='A0SA' or skill=='A121' or skill=='A13D' or skill=='A1MN' or skill=='A1NH' or skill=='A1S9' or skill=='A1TU' or skill=='A1WF' or skill=='A1Z2' or skill=='A1Z3' or skill=='A205' or skill=='A20N' or skill=='A21H' or skill=='A24A' or skill=='A24B' or skill=='A24E' or skill=='A2E6' or skill=='A2MB' or skill=='A2NI' or skill=='A4HF' or skill=='ZBRR' or skill=='ZT01' or skill=='ZT02' or skill=='ZT07' or skill=='ZT08' or skill=='ZPNK' or skill=='ZPNL'
endfunction
function B516_ShouldSkipLegacyAIVisibility takes unit hero,integer skill returns boolean
local integer logicalSkill=skill
local integer physicalSkill=skill
local integer mappedSkill=0
if SUIJI_MODE==false or hero==null or GetUnitTypeId(hero)==0 or hero!=B515_LEGACY_AI_UNIT or skill==0 then
return false
endif
set mappedSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
if mappedSkill!=0 then
set logicalSkill=mappedSkill
endif
// These buttons have a real state controller. Their explicit owner, rather
// than this generic guard, is still allowed to change command-card ownership.
if B287_IsStateReplaceBaseSkill(logicalSkill) or SuijiMode_IsTransientStateButton(logicalSkill) then
return false
endif
// Invoker's invoked spell is selected dynamically through BS[9] and is a real
// temporary button, not a tactical visibility hint.
if GetUnitTypeId(hero)=='H00U' then
return false
endif
if B515_IsStableRandomCommandCardSkill(hero,logicalSkill) then
return true
endif
set physicalSkill=B287_GetPhysicalAbilityId(hero,logicalSkill)
return GetUnitAbilityLevel(hero,skill)>0 or GetUnitAbilityLevel(hero,logicalSkill)>0 or (physicalSkill!=0 and GetUnitAbilityLevel(hero,physicalSkill)>0)
endfunction
function B290_IsDisplacementSkill takes integer skill returns boolean
if skill=='AEbl' or skill=='A03I' or skill=='A07W' or skill=='A0ME' or skill=='A2FW' or skill=='A0K9' or skill=='A01O' then
return true
endif
if skill=='A06J' or skill=='A0FN' or skill=='A06O' or skill=='A4I2' then
return true
endif
if skill=='A0FS' or skill=='A0IT' or skill=='A0KE' or skill=='A0LK' or skill=='A0LN' or skill=='A4EX' or skill=='A4EY' or skill=='A4EZ' then
return true
endif
if skill=='A0ML' or skill=='A0PL' or skill=='A0QR' or skill=='A1B3' or skill=='A0RW' then
return true
endif
if skill=='A0Z8' or skill=='A1CV' or skill=='A14O' or skill=='A1J7' or skill=='A4BZ' or skill=='A4C1' then
return true
endif
if skill=='A1Q4' or skill=='A1RD' or skill=='A3RD' or skill=='A1RJ' or skill=='A1S7' or skill=='A2E3' then
return true
endif
if skill=='A0BZ' or skill=='A0QE' or skill=='A2V5' or skill=='A2V6' then
return true
endif
if skill=='A0IN' or skill=='A1AW' or skill=='A1SW' or skill=='A0G4' or skill=='A1D8' then
return true
endif
return skill=='A2V4' or skill=='A2V8' or skill=='A2VF' or skill=='A2VG' or skill=='A2VH' or skill=='A2VI' or skill=='A2VJ' or skill=='A2VK'
endfunction
function B290_IsBlinkDisplacementSkill takes integer skill returns boolean
return skill=='AEbl' or skill=='A03I' or skill=='A07W' or skill=='A0ME' or skill=='A2FW'
endfunction
function B290_GetDisplacementMulticastCount takes unit u,integer skill returns integer
return 1
endfunction
function B290_ApplyBlinkMulticastDistance takes unit u,integer skill,integer count returns nothing
local integer h=0
local real startX=0.
local real startY=0.
local real currentX=0.
local real currentY=0.
local real targetX=0.
local real targetY=0.
if u==null or GetUnitTypeId(u)==0 or count<=1 or B290_IsBlinkDisplacementSkill(skill)==false then
return
endif
set h=GetHandleId(u)
set startX=LoadReal(L7,h,StringHash("B290DisplacementStartX"))
set startY=LoadReal(L7,h,StringHash("B290DisplacementStartY"))
set currentX=GetUnitX(u)
set currentY=GetUnitY(u)
if (currentX-startX)*(currentX-startX)+(currentY-startY)*(currentY-startY)<1. then
return
endif
set targetX=startX+(currentX-startX)*count
set targetY=startY+(currentY-startY)*count
if targetX<GetRectMinX(bj_mapInitialPlayableArea)+32. then
set targetX=GetRectMinX(bj_mapInitialPlayableArea)+32.
elseif targetX>GetRectMaxX(bj_mapInitialPlayableArea)-32. then
set targetX=GetRectMaxX(bj_mapInitialPlayableArea)-32.
endif
if targetY<GetRectMinY(bj_mapInitialPlayableArea)+32. then
set targetY=GetRectMinY(bj_mapInitialPlayableArea)+32.
elseif targetY>GetRectMaxY(bj_mapInitialPlayableArea)-32. then
set targetY=GetRectMaxY(bj_mapInitialPlayableArea)-32.
endif
call SetUnitX(u,targetX)
call SetUnitY(u,targetY)
endfunction
function XOMG_LogEvent takes string text returns nothing
local integer idx=ModuloInteger(B1133LogSerial,24)
local integer off=0
local integer row=0
set B1133LogSerial=B1133LogSerial+1
set B1133LogRows[idx]="#"+I2S(B1133LogSerial)+" t="+R2S(TimerGetElapsed(W))+" "+text
if B1133LogCount<24 then
set B1133LogCount=B1133LogCount+1
endif
if GetPlayerController(GetLocalPlayer())==MAP_CONTROL_USER then
call PreloadGenClear()
call PreloadStart()
loop
exitwhen off>=B1133LogCount
set row=ModuloInteger(B1133LogSerial-B1133LogCount+off,24)
call Preload(B1133LogRows[row])
set off=off+1
endloop
call PreloadGenEnd("1-miao-error\\imba-runtime.text")
call PreloadGenClear()
endif
set text=null
endfunction
function B287_BoolToInt takes boolean value returns integer
if value then
return 1
endif
return 0
endfunction
function B287_SetTetherAbilityAvailable takes unit hero,player p,boolean available returns nothing
local integer physicalSkill='A1TA'
local integer tetherLogCount=0
local boolean tetherActive=false
local boolean tetherReplaced=false
local trigger tetherController=null
if p==null or hero==null or GetUnitTypeId(hero)==0 then
return
endif
// Tether is a live state-replacement pair.  Resolve the physical object from
// actual ownership; the generic expected-clone policy is intended for grant
// and reconstruction paths and must not sit inside this runtime transition.
set physicalSkill=B287_GetPhysicalAbilityId(hero,'A1TA')
set tetherActive=LoadBoolean(L7,GetHandleId(hero),StringHash("SuijiTetherActive"))
set tetherReplaced=LoadBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+'A1TA')
set tetherController=LoadTriggerHandle(L7,GetHandleId(hero),StringHash("SuijiTetherController"))
if SUIJI_LOG then
set tetherLogCount=LoadInteger(L7,GetHandleId(hero),StringHash("SuijiTetherAvailLogCount"))
if tetherLogCount<24 then
call SaveInteger(L7,GetHandleId(hero),StringHash("SuijiTetherAvailLogCount"),tetherLogCount+1)
call BJDebugMsg("[TETHER-AVAIL] caster="+GetUnitName(hero)+"#"+I2S(GetHandleId(hero))+" write="+I2S(B287_BoolToInt(available))+" physical="+I2S(physicalSkill)+" active="+I2S(B287_BoolToInt(tetherActive))+" replaced="+I2S(B287_BoolToInt(tetherReplaced))+" controller="+I2S(GetHandleId(tetherController)))
endif
endif
if available and tetherActive then
set tetherController=null
set hero=null
return
endif
// Save the authoritative state before the native visibility write.  Even if
// the engine terminates that call's thread, integrity repair sees the correct
// exclusive button owner.
if available then
call RemoveSavedBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+'A1TA')
else
call SaveBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+'A1TA',true)
endif
call SetPlayerAbilityAvailable(p,physicalSkill,available)
set tetherController=null
set hero=null
endfunction
function B287_SetPlayerAbilityAvailable takes player p,integer logicalSkill,boolean available returns nothing
local unit hero=null
local integer physicalSkill=logicalSkill
if p==null then
return
endif
if B515_LEGACY_AI_UNIT!=null and GetUnitTypeId(B515_LEGACY_AI_UNIT)!=0 and GetOwningPlayer(B515_LEGACY_AI_UNIT)==p then
set hero=B515_LEGACY_AI_UNIT
else
set hero=M7[GetPlayerId(p)]
endif
if hero!=null and GetUnitTypeId(hero)!=0 then
if logicalSkill=='A1TA' then
call B287_SetTetherAbilityAvailable(hero,p,available)
set hero=null
return
endif
set physicalSkill=B287_GetExpectedAbilityId(hero,logicalSkill)
// B516: learned native and random abilities remain stable command-card
// owners. The legacy AI must express tactical intent through its conditions
// and orders, not by disabling and re-enabling an already owned button.
if B516_ShouldSkipLegacyAIVisibility(hero,logicalSkill) then
set hero=null
return
endif
// B515: the legacy AI used command-card visibility as a tactical boolean.
// Random skills are stable buttons; while an AI cast/template or the legacy
// two-second decision thread is running, never let those tactical writes
// rebuild the real OMG command card. State-replacement skills remain exempt.
if B515_IsStableRandomCommandCardSkill(hero,logicalSkill) and (SUIJI_AI_CASTING or hero==B515_LEGACY_AI_UNIT) then
set hero=null
return
endif
// Native Centaur Hoof Stomp is explicitly initialized visible once. The old
// AI thread must no longer hide it after B514 removed its periodic restorer.
if SUIJI_MODE and logicalSkill=='A00S' and physicalSkill=='A00S' and hero==B515_LEGACY_AI_UNIT then
set hero=null
return
endif
if B287_IsStateReplaceBaseSkill(logicalSkill) then
call SuijiMode_SyncStateReplaceBaseSlot(hero,logicalSkill)
if available then
call RemoveSavedBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+logicalSkill)
else
call SaveBoolean(L7,GetHandleId(hero),StringHash("B289StateReplaceBase")+logicalSkill,true)
endif
endif
endif
call SetPlayerAbilityAvailable(p,physicalSkill,available)
set hero=null
endfunction
function B515_SetLegacyAIAbilityAvailable takes unit hero,player p,integer skill,boolean available returns nothing
if p==null or skill==0 then
return
endif
if hero!=null and GetUnitTypeId(hero)!=0 then
if B516_ShouldSkipLegacyAIVisibility(hero,skill) then
return
endif
if B515_IsStableRandomCommandCardSkill(hero,skill) and hero==B515_LEGACY_AI_UNIT then
return
endif
if SUIJI_MODE and skill=='A00S' and B287_GetPhysicalAbilityId(hero,skill)=='A00S' and hero==B515_LEGACY_AI_UNIT then
return
endif
endif
call SetPlayerAbilityAvailable(p,skill,available)
endfunction
function B539_SetSummonAIAbilityAvailable takes unit summon,integer skill,boolean available returns nothing
local unit previousLegacyUnit=B515_LEGACY_AI_UNIT
if summon==null or GetUnitTypeId(summon)==0 or skill==0 then
set previousLegacyUnit=null
return
endif
// NDF runs for owned summons outside the hero-only N9F guard.  Scope the
// existing B515/B516 visibility protection to this one tactical write so the
// summon keeps its native button without changing NDF's main-hero operations.
set B515_LEGACY_AI_UNIT=summon
call B515_SetLegacyAIAbilityAvailable(summon,GetOwningPlayer(summon),skill,available)
set B515_LEGACY_AI_UNIT=previousLegacyUnit
set previousLegacyUnit=null
endfunction
function B582_GetAbilityCooldown takes unit u,integer skill returns real
local ability a=null
local real cooldown=0.
if u==null or GetUnitTypeId(u)==0 or skill==0 or GetUnitAbilityLevel(u,skill)<=0 then
return 0.
endif
set a=EXGetUnitAbility(u,skill)
if a!=null then
set cooldown=EXGetAbilityState(a,1)
endif
set a=null
return cooldown
endfunction
function B287_MHAbility_GetCooldown takes unit u,integer logicalSkill returns real
local integer physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
// B583: the EX/JAPI reader below already validates the unit, owned rawcode and
// live ability handle. Do not precede a routine cooldown read with the broader
// MemHack exact-live enumeration that regressed at the B539/B540 boundary.
return B582_GetAbilityCooldown(u,physicalSkill)
endfunction
function B287_MHAbility_SetCooldown takes unit u,integer logicalSkill,real duration returns boolean
local integer physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if SuijiMode_HasExactLiveAbility(u,physicalSkill)==false then
return false
endif
return MHAbility_SetCooldown(u,physicalSkill,duration)
endfunction
function B287_MHAbility_SetCooldownEx takes unit u,integer logicalSkill,real duration,real maxDuration returns boolean
local integer physicalSkill=B287_GetPhysicalAbilityId(u,logicalSkill)
if SuijiMode_HasExactLiveAbility(u,physicalSkill)==false then
return false
endif
return MHAbility_SetCooldownEx(u,physicalSkill,duration,maxDuration)
endfunction
// B945: generated from current map and packaging defaults. Regenerate on mana/item ability edits.
// One-time synchronous native data load; no per-spell discovery or periodic metadata scan.
function B945LoadData takes string b945Block,boolean b945Items returns nothing
local integer b945Pos=0
local integer b945Start=0
local integer b945Parent=0
local integer b945Level=1
local integer b945Length=StringLength(b945Block)
local string b945Char=""
loop
exitwhen b945Pos>=b945Length
set b945Char=SubString(b945Block,b945Pos,b945Pos+1)
if b945Char==":" then
set b945Parent=S2I(SubString(b945Block,b945Start,b945Pos))
set b945Start=b945Pos+1
set b945Level=1
elseif b945Char=="," or b945Char==";" then
if b945Items then
call SaveBoolean(B945SpellData,b945Parent,S2I(SubString(b945Block,b945Start,b945Pos)),true)
else
call SaveInteger(B945SpellData,b945Parent,b945Level,S2I(SubString(b945Block,b945Start,b945Pos)))
set b945Level=b945Level+1
endif
set b945Start=b945Pos+1
endif
set b945Pos=b945Pos+1
endloop
endfunction
