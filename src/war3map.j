function B1047TeleportRemaining takes nothing returns nothing
local timer furionTimer1047=GetExpiredTimer()
local integer furionTimerKey1047=GetHandleId(furionTimer1047)
local unit furionCaster1047=LoadUnitHandle(L7,furionTimerKey1047,0)
local integer furionPhysical1047=LoadInteger(L7,furionTimerKey1047,1)
local ability furionAbility1047=null
local real furionRemaining1047=0.
local integer furionUnitKey1047=0
if furionCaster1047!=null and GetUnitTypeId(furionCaster1047)!=0 and not IsUnitIllusion(furionCaster1047) then
set furionUnitKey1047=GetHandleId(furionCaster1047)
if OO7(furionUnitKey1047,"B1047TeleportPending") and OM7(furionUnitKey1047,"B1047TeleportSequence")==LoadInteger(L7,furionTimerKey1047,2) and SuijiMode_ScepterRegistryIsActive(furionCaster1047,'A01O') and B287_GetPhysicalAbilityId(furionCaster1047,'A01O')==furionPhysical1047 and GetUnitAbilityLevel(furionCaster1047,furionPhysical1047)>0 then
set furionAbility1047=MHAbility_GetAbility(furionCaster1047,furionPhysical1047)
if furionAbility1047!=null then
if MHAbility_GetId(furionAbility1047)==furionPhysical1047 then
set furionRemaining1047=MHAbility_GetAbilitySpellRemain(furionAbility1047)
if furionRemaining1047>1. then
// B1048 disproved the clock-advance hypothesis. Keep one second in this phase.
call MHAbility_SetAbilitySpellRemain(furionAbility1047,1.)
endif
if SUIJI_AGH_DEBUG[GetPlayerId(GetOwningPlayer(furionCaster1047))] then
call DisplayTextToPlayer(GetOwningPlayer(furionCaster1047),0,0,"[传送计时 B1050] 原读数="+R2S(furionRemaining1047)+"，当前读数="+R2S(MHAbility_GetAbilitySpellRemain(furionAbility1047)))
endif
endif
endif
endif
endif
call FlushChildHashtable(L7,furionTimerKey1047)
call PauseTimer(furionTimer1047)
call DestroyTimer(furionTimer1047)
set furionAbility1047=null
set furionCaster1047=null
set furionTimer1047=null
endfunction
function ZW9 takes nothing returns boolean
local unit furionCaster1047=GetTriggerUnit()
local timer furionTimer1047=null
local integer furionUnitKey1047=0
local integer furionPhysical1047=0
if B287_GetSpellAbilityId()!='A01O' then
set furionCaster1047=null
return false
endif
if furionCaster1047!=null and SuijiMode_ScepterRegistryIsActive(furionCaster1047,'A01O') and not IsUnitIllusion(furionCaster1047) then
set furionUnitKey1047=GetHandleId(furionCaster1047)
set furionPhysical1047=GetSpellAbilityId()
if furionPhysical1047=='A01O' or furionPhysical1047=='Y00M' then
call NP7(furionUnitKey1047,"B1047TeleportSequence",OM7(furionUnitKey1047,"B1047TeleportSequence")+1)
call NS7(furionUnitKey1047,"B1047TeleportPending",true)
call NQ7(furionUnitKey1047,"B1047TeleportStarted",GetGameTime())
set furionTimer1047=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(furionTimer1047),0,furionCaster1047)
call SaveInteger(L7,GetHandleId(furionTimer1047),1,furionPhysical1047)
call SaveInteger(L7,GetHandleId(furionTimer1047),2,OM7(furionUnitKey1047,"B1047TeleportSequence"))
// Let the engine initialize this cast's countdown before changing its remainder.
call TimerStart(furionTimer1047,0.,false,function B1047TeleportRemaining)
endif
endif
set furionTimer1047=null
set furionCaster1047=null
return true
endfunction
