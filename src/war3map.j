function TKD takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local integer wallImageOwner=OM7(I97,"B933WallOwner")
local integer wallImageSlot=OM7(I97,"B933WallSlot")
call DisableTrigger(t)
// Retire the wall's saved unit before death/expiry can remove its engine object.
call RemoveSavedHandle(L7,wallImageOwner,StringHash("Illusion"+I2S(wallImageSlot)))
call RemoveSavedHandle(L7,wallImageOwner,StringHash("IllusionTrig"+I2S(wallImageSlot)))
call GroupRemoveUnit(OF7(I97,"g1"),O77(I97,"imagesource"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit)))
call NM7(I97)
call OZ7(t)
set t=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function TMD takes unit ZX7,unit IH7,unit wallImageSource,real wallImageX,real wallImageY returns boolean
local integer I97=GetHandleId(ZX7)
local integer TND=OM7(I97,"NumOfImages")
local trigger t=CreateTrigger()
call SetUnitVertexColor(IH7,$FF,$FF,$FF,100)
call TriggerRegisterUnitEvent(t,IH7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function TKD))
call NB7(GetHandleId(t),"g1",OF7(I97,"g1"))
call NT7(GetHandleId(t),"imagesource",wallImageSource)
set TND=TND+1
call NP7(GetHandleId(t),"B933WallOwner",I97)
call NP7(GetHandleId(t),"B933WallSlot",TND)
call NP7(I97,"NumOfImages",TND)
call NT7(I97,"Illusion"+I2S(TND),IH7)
call NV7(I97,"IllusionTrig"+I2S(TND),t)
call SetUnitX(IH7,wallImageX)
call SetUnitY(IH7,wallImageY)
set t=null
return false
endfunction
function TFD takes boolean TGD returns boolean
local integer OB7=GetHandleId(GetTriggeringTrigger())
local unit THD=O77(OB7,"Wall")
local unit m5=GetTriggerUnit()
local unit XS=null
local unit WX7=O77(GetHandleId(THD),"Source")
local integer BC7=0
local unit BB7=null
local real wallImageX=0.
local real wallImageY=0.
if THD==null or WX7==null or m5==null or GetUnitTypeId(THD)==0 or GetUnitTypeId(WX7)==0 or GetUnitTypeId(m5)==0 or not UnitAlive(m5) then
set THD=null
set WX7=null
set m5=null
return false
endif
set BC7=IMaxBJ(B287_GetUnitAbilityLevel(WX7,'A0QK'),B287_GetUnitAbilityLevel(WX7,'A21Q'))
set wallImageX=GetUnitX(m5)
set wallImageY=GetUnitY(m5)
set XS=CreateUnit(GetOwningPlayer(THD),'e01S',wallImageX,wallImageY,0)
// call SetUnitAbilityLevel(THD,1093685580,BC7)
if TGD then
// call SetUnitAbilityLevel(THD,1093685580,3+BC7)
// call IssueTargetOrderById(THD,$D0132,m5)
// call SetUnitAbilityLevel(THD,1093685580,3+BC7)
// call IssueTargetOrderById(THD,$D0132,m5)
// call SetUnitAbilityLevel(THD,1093685580,3+BC7)
// call IssueTargetOrderById(THD,$D0132,m5)
set BB7=MHUnit_CreateIllusion(GetOwningPlayer(THD),m5,GetUnitX(m5),GetUnitY(m5))
if BB7!=null and GetUnitTypeId(BB7)!=0 then
call TMD(THD,BB7,m5,wallImageX,wallImageY)
call MHUnit_SetIllusionDamageDeal(BB7,0.9+BC7*0.1)
call MHUnit_SetIllusionDamageReceive(BB7,4.)
call UnitApplyTimedLife(BB7,'BTLF',35)
call MHUnit_FlagTypeOperator(BB7,FLAG_OPERATOR_REMOVE,UNIT_FLAG_TYPE_SUMMON)
call Set_Illusion_TX(WX7,BB7)
endif
call B67(THD,m5,1,200)
else
// call IssueTargetOrderById(THD,$D0132,m5)
call B67(THD,m5,1,200)
endif
call UnitApplyTimedLife(XS,'BTLF',.5)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(m5),GetUnitY(m5)))
set THD=null
set m5=null
set XS=null
set WX7=null
set BB7=null
return false
endfunction
function TID takes nothing returns boolean
local group g
if IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(O77(GetHandleId(GetTriggeringTrigger()),"Wall")))and (not DGFS(GetFilterUnit()) and LB7(GetUnitTypeId(GetFilterUnit()))==false) then
set g=OF7(GetHandleId(GetTriggeringTrigger()),"g1")
if IsUnitInGroup(GetFilterUnit(),g)==false then
call GroupAddUnit(g,GetFilterUnit())
call TFD(false)
endif
endif
set g=null
return false
endfunction
function TJD takes nothing returns boolean
local group g
if IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO) and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(O77(GetHandleId(GetTriggeringTrigger()),"Wall")))and (not DGFS(GetFilterUnit()) and LB7(GetUnitTypeId(GetFilterUnit()))==false) then
set g=OF7(GetHandleId(GetTriggeringTrigger()),"g1")
if IsUnitInGroup(GetFilterUnit(),g)==false then
call GroupAddUnit(g,GetFilterUnit())
call TFD(true)
endif
endif
set g=null
return false
endfunction
