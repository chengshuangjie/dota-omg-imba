function Q6E takes nothing returns boolean
local eventid b1061SavedGetTriggerEventId=GetTriggerEventId()
local trigger b1061SavedGetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1061Result
local trigger t=(b1061SavedGetTriggeringTrigger)
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit BB7=O77(OB7,"Caster")
local group QLE=OF7(OB7,"ActiveGroup")
local real x=0.
local real y=0.
local group g=WS7()
if p5==null or BB7==null or GetUnitTypeId(p5)==0 or GetUnitTypeId(BB7)==0 or QLE==null or (b1061SavedGetTriggerEventId)==EVENT_UNIT_DEATH then
if QLE!=null then
call ForGroup(QLE,function QCE)
call WR7(QLE)
endif
call WR7(g)
call NM7(OB7)
call OZ7(t)
if BB7!=null then
call ShowUnit(BB7,false)
endif
set t=null
set p5=null
set BB7=null
set QLE=null
set b1061Result=false
set b1061SavedGetTriggerEventId=null
set b1061SavedGetTriggeringTrigger=null
return b1061Result
endif
set x=GetUnitX(BB7)
set y=GetUnitY(BB7)
set n3=p5
set a3=B287_GetUnitAbilityLevel(p5,'A1HS')
set IN4=p5
call GroupEnumUnitsInRange(g,x,y,300,Condition(function AJ7_gai))
call GroupRemoveGroup(g,QLE)
call ForGroup(QLE,function QCE)
call ForGroup(g,function Q3E)
call NB7(OB7,"ActiveGroup",g)
call WR7(QLE)
set t=null
set p5=null
set BB7=null
set QLE=null
set g=null
set b1061Result=false
set b1061SavedGetTriggerEventId=null
set b1061SavedGetTriggeringTrigger=null
return b1061Result
endfunction
