function SuijiMode_FindDividedScepterSlot takes unit u returns integer
local integer playerHandle=0
local integer slot=1
local unit clone=null
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set playerHandle=GetHandleId(GetOwningPlayer(u))
loop
exitwhen slot>4
set clone=O77(playerHandle,"Kobold"+I2S(slot))
if clone==null or GetUnitTypeId(clone)==0 then
set clone=null
return slot
endif
set slot=slot+1
endloop
set clone=null
return 0
endfunction
function SuijiMode_SyncDividedWeStandAgh takes unit u returns nothing
local integer h=0
local integer playerHandle=0
local integer slot=0
local unit clone=null
local trigger attributes=null
if u==null or GetUnitTypeId(u)==0 or SuijiMode_ScepterRegistryIsRegistered(u,'A0MW')==false then
return
endif
set h=GetHandleId(u)
set playerHandle=GetHandleId(GetOwningPlayer(u))
set attributes=OE7(playerHandle,"Kobold|AttributesTrigger")
if SuijiMode_ScepterRegistryIsActive(u,'A0MW') then
if OO7(h,"SuijiDividedScepterClone")==false then
// Adopt the clone created by the legacy native scepter callback when it ran
// before the central registry update; otherwise create exactly one clone in
// the first reusable slot.
if A94 and A84>=1 then
set clone=O77(playerHandle,"Kobold"+I2S(A84))
if clone!=null and GetUnitTypeId(clone)!=0 then
set slot=A84
endif
endif
if slot==0 then
if O77(playerHandle,"Kobold0")==null then
call XPD(u)
endif
set slot=SuijiMode_FindDividedScepterSlot(u)
if slot>0 then
set clone=CreateUnit(GetOwningPlayer(u),'H00J',GetUnitX(u),GetUnitY(u),0)
call W1D(clone,u)
call WFD(clone,u)
call NT7(playerHandle,"Kobold"+I2S(slot),clone)
if slot>A84 then
set A84=slot
endif
endif
endif
if slot>0 and clone!=null then
call NT7(h,"SuijiDividedScepterCloneUnit",clone)
call NP7(h,"SuijiDividedScepterCloneSlot",slot)
call NS7(h,"SuijiDividedScepterClone",true)
endif
endif
set A94=true
else
set A94=false
if OO7(h,"SuijiDividedScepterClone") then
set clone=O77(h,"SuijiDividedScepterCloneUnit")
set slot=OM7(h,"SuijiDividedScepterCloneSlot")
if clone!=null and GetUnitTypeId(clone)!=0 then
call RemoveUnit(clone)
endif
if slot>0 then
call RemoveSavedHandle(L7,playerHandle,StringHash("Kobold"+I2S(slot)))
endif
call RemoveSavedHandle(L7,h,StringHash("SuijiDividedScepterCloneUnit"))
call RemoveSavedInteger(L7,h,StringHash("SuijiDividedScepterCloneSlot"))
call NS7(h,"SuijiDividedScepterClone",false)
endif
endif
if attributes!=null then
call TriggerExecute(attributes)
endif
set clone=null
set attributes=null
endfunction
function XTD takes nothing returns boolean
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local trigger t=b1060GetTriggeringTrigger
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
if IsUnitIllusion(b1060GetTriggerUnit)==false and GetOwningPlayer(b1060GetTriggerUnit)==GetOwningPlayer(ZX7)and U2D(b1060GetTriggerUnit)then
if B287_GetLearnedSkill()=='A0MW' or B287_GetLearnedSkill()=='A27C' then
call DisableTrigger(b1060GetTriggeringTrigger)
call XQD(b1060GetTriggerUnit,false)
call EnableTrigger(b1060GetTriggeringTrigger)
elseif B287_GetLearnedSkill()=='Aamk' or B287_GetLearnedSkill()=='A0N8' or B287_GetLearnedSkill()=='A0NB' or B287_GetLearnedSkill()=='A0N7' then
call TriggerExecute(OE7(GetHandleId(GetOwningPlayer(b1060GetTriggerUnit)),"Kobold|XPTrigger"))
call TriggerExecute(OE7(GetHandleId(GetOwningPlayer(b1060GetTriggerUnit)),"Kobold|AttributesTrigger"))
call DisableTrigger(b1060GetTriggeringTrigger)
call WCD(b1060GetTriggerUnit,B287_GetLearnedSkill())
call EnableTrigger(b1060GetTriggeringTrigger)
endif
endif
set ZX7=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function XUD takes nothing returns nothing
