function tQ takes nothing returns boolean
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
local integer OB7=GetHandleId(b1060GetTriggeringTrigger)
local unit WI7=O77(OB7,"Hero")
local real AD9=0.
local real MaxHealth=0.
local real AE9
local integer AF9
local integer V77=0
local boolean AG9=OO7(OB7,"HasFX")
local integer speed=0
local real d=0.
local real recover=0.
if WI7==null or GetUnitTypeId(WI7)==0 then
if AG9 then
call DestroyEffect(OG7(OB7,"FX1"))
call DestroyEffect(OG7(OB7,"FX2"))
call DestroyEffect(OG7(OB7,"FX3"))
endif
call RemoveSavedReal(ExtraHT,'A0QQ',GetHandleId(WI7))
call NM7(OB7)
call OZ7(b1060GetTriggeringTrigger)
set WI7=null
set b1060ReturnValue=false
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endif
set AD9=GetUnitState(WI7,UNIT_STATE_LIFE)
set MaxHealth=GetUnitState(WI7,UNIT_STATE_MAX_LIFE)
set V77=B287_GetUnitAbilityLevel(WI7,'A0QQ')
set speed=9+2*V77
set d=DGH_BUFF(WI7)
set recover=0.5*(0.005+0.02*V77)*d*GetHeroStr(WI7,true)*0.25
if IsUnitType(WI7,UNIT_TYPE_HERO)and V77>0 then
    set AE9=100*GetUnitState(WI7,UNIT_STATE_LIFE)/GetUnitState(WI7,UNIT_STATE_MAX_LIFE)
    set AF9=YH7(YG7(R2I((100-AE9)/4.5),20),0)
    if AE9<100 and AF9==0 then
        set AF9=1
    endif
if XH7(WI7)==false then
if GetUnitAbilityLevel(WI7,'BNdo')>0 or ISPH(WI7) then
        set AE9=100
        set AF9=0
    endif
    call C97(WI7,speed*AF9)
    call SaveReal(ExtraHT, 'A0QQ', GetHandleId(WI7), recover*AF9*4)
    if AF9>0 then
        call SetWidgetLife(WI7, GetWidgetLife(WI7)+recover*AF9)
    endif
    if AE9<40 then
        if AG9==false then
            call NS7(OB7,"HasFX",true)
            call NU7(OB7,"FX1",AddSpecialEffectTarget("Abilities\\Spells\\Orc\\TrollBerserk\\HeadhunterWEAPONSLeft.mdl",WI7,"left weapon"))
            call NU7(OB7,"FX2",AddSpecialEffectTarget("effects\\HeadhunterWEAPONSRight_NoSound.mdx",WI7,"right weapon"))
            call NU7(OB7,"FX3",AddSpecialEffectTarget("InnerVitality.mdx",WI7,"chest"))
        endif
    else
        if AG9 then
            call NS7(OB7,"HasFX",false)
            call DestroyEffect(OG7(OB7,"FX1"))
            call DestroyEffect(OG7(OB7,"FX2"))
            call DestroyEffect(OG7(OB7,"FX3"))
        endif
    endif
endif
endif
set WI7=null
set b1060ReturnValue=false
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
