function JFIXSTUN takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local integer O5=S2I(SubString(VH,9,StringLength(VH)))
local player p=b1060GetTriggerPlayer
local unit u
if O5>5 then
    set O5=O5+1
elseif O5==0 then
    set O5=GetPlayerId(p)
endif
set u=M7[O5]
if u!=null and UnitAlive(u) then
call FixUnitPause(u,p)
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00英雄存活才能使用|r")
endif
set u=null
set p=null
set b1060GetTriggerPlayer=null
endfunction
function JFIXSTATE2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit u=LoadUnitHandle(L7,OB7,0)
local player p=LoadPlayerHandle(L7,OB7,1)
call YZ8(u)
call YW8(u,0,0)
call DisplayTextToPlayer(p,0,0, "|cFF00FF00已尝试为 "+GetUnitName(u)+" 修复永久异常状态问题|r")
if GetOwningPlayer(u)!=p then
    call DisplayTextToPlayer(GetOwningPlayer(u),0,0, "|cFF00FF00已尝试为 "+GetUnitName(u)+" 修复永久异常状态问题|r")
endif
call NM7(OB7)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u=null
set p=null
endfunction
function JFIXSTATE takes nothing returns nothing
local string VH=GetEventPlayerChatString()
local integer O5=S2I(SubString(VH,9,StringLength(VH)))
local player p=GetTriggerPlayer()
local unit u
local timer t
local integer OB7
if O5>5 then
    set O5=O5+1
elseif O5==0 then
    set O5=GetPlayerId(p)
endif
set u=M7[O5]
if u==null then
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00目标不存在|r")
    set p=null
    return
endif
if LoadReal(TABLE_HY,GetHandleId(p),'FIXS')>GetGameTime() and SPEPLAYER[GetPlayerId(p)]!=1 then
    call DisplayTextToPlayer(p,0,0, "|cFF00FF00该指令有1分钟使用间隔，请勿滥用该指令|r")
    set u=null
    set p=null
    return
endif
call SaveReal(TABLE_HY,GetHandleId(p),'FIXS',GetGameTime()+60.)
set t=CreateTimer()
set OB7=GetHandleId(t)
call SaveUnitHandle(L7,OB7,0,u)
call SavePlayerHandle(L7,OB7,1,p)
call TimerStart(t,10.,false,function JFIXSTATE2)
call DisplayTextToPlayer(p,0,0, "|cFF00FF00将在10秒后为 "+GetUnitName(u)+" 修复永久异常状态问题|r")
set u=null
set p=null
set t=null
endfunction
function JFIXMODEL takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local integer i=S2I(SubString(VH,9,StringLength(VH)))
local unit u=null
if i>5 then
set i=i+1
endif
set u=M7[i]
if u==null then
set u=M7[GetPlayerId(b1060GetTriggerPlayer)]
endif
if u!=null and UnitAlive(u) then
	call MHUnit_SetModel(u,MHUnit_GetDefDataStr(GetUnitTypeId(u),UNIT_DEF_DATA_MODEL),false)
	call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复单位模型|r")
endif
set u=null
set b1060GetTriggerPlayer=null
endfunction
function JFIXUNIT takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=GetEventPlayerChatString()
local integer i=S2I(SubString(VH,8,StringLength(VH)))
local unit u=null
if i>5 then
set i=i+1
endif
set u=M7[i]
if u==null then
set u=M7[GetPlayerId(b1060GetTriggerPlayer)]
endif
if u!=null then
call SetUnitScale(u,XX7(u),XX7(u),XX7(u))
if KCD(u)==false then
call XF7(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
endif
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),0)
// call Hide_HP(u,false)
call UnitCancelHide(u)
call SetUnitInvulnerable(u,false)
call FixUnitPause(u,Player(0))
call FixUnitSilence(u)
call FixUnitMove(u)
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复单位模型错误|r")
endif
set u=null
set b1060GetTriggerPlayer=null
endfunction
function JFIXSKILL takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local player p=b1060GetTriggerPlayer
local integer O5=GetPlayerId(p)
local unit u=M7[O5]
local integer id=GetUnitTypeId(u)
local trigger t=null
if id=='H06S' then
call SetPlayerAbilityAvailable(p,'A13D',false)
call B287_SetPlayerAbilityAvailable(p,'A11N',true)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复X标记|r")
elseif id=='O01F' or id=='Z01F' then
    set t=LoadTriggerHandle(L7,GetHandleId(u),StringHash("SuijiTetherController"))
    if t!=null then
    call SuijiMode_TetherCleanup(t,"fixskill")
    else
    call UnitRemoveAbility(u,'A1TU')
    call RemoveSavedBoolean(L7,GetHandleId(u),StringHash("SuijiTetherActive"))
    call B287_SetPlayerAbilityAvailable(p,'A1TA',true)
    endif
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复羁绊|r")
elseif ISLABIKE(u) then
    call SetPlayerAbilityAvailable(p,'A27F',true)
    call SetPlayerAbilityAvailable(p,'A27X',false)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复隔空取物|r")
elseif PDLJ(u) then
    call B287_SetPlayerAbilityAvailable(p,'A1NI',true)
    call SetPlayerAbilityAvailable(p,'A1NH',false)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复不稳定化合物|r")
elseif id=='E02F' then
    call B287_SetPlayerAbilityAvailable(p,'A1YX',true)
    call SetPlayerAbilityAvailable(p,'A1Z2',false)
    call B287_SetPlayerAbilityAvailable(p,'A1RJ',true)
    call SetPlayerAbilityAvailable(p,'A20N',false)
    call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|cFF00FF00已尝试修复凤凰冲击和烈火精灵|r")
elseif id=='E032' then
