function AIMAXLV_ApplyAll takes nothing returns nothing
local integer O5
local unit u
set O5=7
loop
exitwhen O5>11
set u=M7[O5]
if u!=null and UnitAlive(u) and GetHeroLevel(u)<25 and GetPlayerController(Player(O5))==MAP_CONTROL_COMPUTER then
call SetHeroLevel(u,25,true)
endif
set O5=O5+1
endloop
set u=null
endfunction
function AIMAXZB_ApplyOne takes integer O5 returns boolean
local unit u=M7[O5]
local player p
local integer id
if u==null or not UnitAlive(u) or GetPlayerController(Player(O5))!=MAP_CONTROL_COMPUTER then
set u=null
return false
endif
set p=GetOwningPlayer(u)
set id=GetUnitTypeId(u)
call AICZB(O5,u,p)
call AIXLHZB(O5,id,u,p)
set AISZ[O5]=1
set AISJ[O5]=0
if AISJPD(u,O5) then
call AIHSJ(O5,id,u,p)
else
call AIHZB(O5,id,u,p)
endif
set KK_AIMAXZB_EQUIPPED[O5]=true
set u=null
set p=null
return true
endfunction
function AIMAXZB_ApplyPendingAll takes nothing returns boolean
local integer O5
local boolean done=true
set O5=7
loop
exitwhen O5>11
if GetPlayerController(Player(O5))==MAP_CONTROL_COMPUTER then
if not KK_AIMAXZB_EQUIPPED[O5] then
if not AIMAXZB_ApplyOne(O5) then
set done=false
endif
endif
else
set KK_AIMAXZB_EQUIPPED[O5]=true
endif
set O5=O5+1
endloop
return done
endfunction
function AIMAXZB_Retry takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local boolean gearDone
set gearDone=AIMAXZB_ApplyPendingAll()
if gearDone then
if t==KK_AIMAXZB_RETRY_TRIGGER then
set KK_AIMAXZB_RETRY_TRIGGER=null
endif
call OZ7(t)
endif
set t=null
endfunction
function AIMAXZB_ResetPending takes nothing returns nothing
local integer O5=7
set FORCE_AICZB=true
if KK_AIMAXZB_RETRY_TRIGGER!=null then
call OZ7(KK_AIMAXZB_RETRY_TRIGGER)
set KK_AIMAXZB_RETRY_TRIGGER=null
endif
loop
exitwhen O5>11
set KK_AIMAXZB_EQUIPPED[O5]=false
set O5=O5+1
endloop
endfunction
function AIMAXZB_StartRetry takes nothing returns nothing
set KK_AIMAXZB_RETRY_TRIGGER=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(KK_AIMAXZB_RETRY_TRIGGER,1.)
call TriggerAddAction(KK_AIMAXZB_RETRY_TRIGGER,function AIMAXZB_Retry)
endfunction
function AIMAXZB_ApplyAll takes nothing returns nothing
call AIMAXZB_ResetPending()
if not AIMAXZB_ApplyPendingAll() then
call AIMAXZB_StartRetry()
endif
endfunction
function JAIMAXLV takes nothing returns nothing
if GetPlayerId(GetTriggerPlayer())!=1 then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"只有玩家1可以使用此命令")
return
endif
call AIMAXLV_ApplyAll()
call DisplayTimedTextToForce(GetPlayersAll(),15.00,"|cFF00FF00黑暗势力所有AI立即满级!|r")
endfunction
function JAIMAXZB takes nothing returns nothing
if GetPlayerId(GetTriggerPlayer())!=1 then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"只有玩家1可以使用此命令")
return
endif
call AIMAXZB_ApplyAll()
call DisplayTimedTextToForce(GetPlayersAll(), 15.00, "|cFF00FF00黑暗势力所有AI立即获得9神装!|r")
endfunction
function P5I takes unit u, unit t returns nothing
	local integer level
	local real i
	local real d=DGH_BUFF(u)
	if GetUnitAbilityLevel(t,'A04R')== 0 and IsUnitIllusion(t)== false and IsUnitType(t, UNIT_TYPE_STRUCTURE)== false and IsUnitEnemy(u, GetOwningPlayer(t)) and(GetUnitAbilityLevel(u,'BVA1')> 0 or GetUnitAbilityLevel(u,'BVA2')> 0 or GetUnitAbilityLevel(u,'BVA3')> 0 or GetUnitAbilityLevel(u,'BVA4')> 0) and UnitAlive(u) then
		if GetUnitAbilityLevel(u,'BVA4')>0 then
			set level = GetUnitAbilityLevel(u,'BVA4')* 4
		elseif GetUnitAbilityLevel(u,'BVA3')>0 then
			set level = GetUnitAbilityLevel(u,'BVA3')* 3
		elseif GetUnitAbilityLevel(u,'BVA2')>0 then
			set level = GetUnitAbilityLevel(u,'BVA2')* 2
		else
			set level = GetUnitAbilityLevel(u,'BVA1')
		endif
		set i = (.1 + .05 * level)*d
		call SetWidgetLife(u, GetWidgetLife(u)+ GetEventDamage()* i)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", u, "origin"))
	endif
endfunction
function SNA takes nothing returns nothing	//吸血光环
	call P5I(WXX, YXX)
endfunction
function OGO takes nothing returns nothing	//祭品
	local real i = .15
	local real d
	if GetUnitAbilityLevel(WXX,'B3B5')== 0 then
		return
	endif
	if IsUnitIllusion(YXX)== false and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)== false and GetUnitAbilityLevel(YXX,'A04R')== 0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and UnitAlive(WXX) then
		set d=DGH_BUFF(WXX)
		call SetWidgetLife(WXX, GetWidgetLife(WXX)+ GetEventDamage()* i * d)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", WXX, "origin"))
	endif
endfunction
// 被动晕眩
function TPA takes nothing returns nothing
	local integer probability
	local boolean isMeleeAttacker = IsUnitType(WXX, UNIT_TYPE_MELEE_ATTACKER)
	if GetUnitAbilityLevel(WXX,'A4C7')>0 and ISHZHS(WXX)==false then	//碎颅锤和深渊之刃 且不是猴子猴孙
		if isMeleeAttacker then
			set probability = 25
		else
			set probability = 10
		endif
		set probability=IMinBJ(probability*imbaMult,100)
		if LoadInteger(TABLE_HY, GetHandleId(WXX),'bash')!= 1 and GetPrdRandom(WXX,'A4C7', probability) then
			if GetUnitAbilityLevel(WXX,'A4C6')==1 then
				call YDWESetUnitAbilityState(WXX,'A4C6', 1, 2)
			endif
			call EPX(WXX,'bash', 2)
			call TGA(WXX, YXX, 4)
		endif
	elseif B287_GetUnitAbilityLevel(WXX,'A0JJ')> 0 then	//重击
		set probability=IMinBJ((5 + 5 * B287_GetUnitAbilityLevel(WXX,'A0JJ'))*imbaMult,100)
		if GetPrdRandom(WXX,'A0JJ', probability) then
			call TGA(WXX, YXX, 1)
		endif
	elseif B287_GetUnitAbilityLevel(WXX,'A081')> 0 then	//时间锁定
			set probability=IMinBJ((5 + 5 * B287_GetUnitAbilityLevel(WXX,'A081'))*imbaMult,100)
			if (SUIJI_MODE==false or SuijiMode_HasRandomSkill(WXX,'A081')==false or GetUnitAbilityLevel(YXX,'B0C2')==0) and GetPrdRandom(WXX,'A081', probability) then
				call SJSD(WXX, YXX)
			endif
	elseif B287_GetUnitAbilityLevel(WXX,'A09E')> 0 then	//狂战士之怒
        if GetUnitAbilityLevel(WXX,'B00B')>0 and SuijiMode_HasAghanimState(WXX) then
            set probability = 15
        else
            set probability = 10
        endif
		set probability=IMinBJ(probability*imbaMult,100)
		if GetPrdRandom(WXX,'A09E', probability) then
			call TGA(WXX, YXX, 3)
		endif
	elseif GetUnitAbilityLevel(WXX,'A0WR')> 0 then	//极度饥渴
		set probability=IMinBJ(15*imbaMult,100)
		if GetPrdRandom(WXX,'A0WR', probability) then
				call TGA(WXX, YXX, 6)
		endif
    endif
	if GetUnitAbilityLevel(WXX,'A061')==1 then	//金箍棒
		set probability=IMinBJ(35*imbaMult,100)
		if GetPrdRandom(WXX,'A061', probability) then
			call TGA(WXX, YXX, 5)
		endif
	endif
endfunction
function hyzrcd takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 1)
	call SaveInteger(TABLE_HY, GetHandleId(u), 'echs', 0)
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function hrzycd takes unit u returns nothing
	local timer t = CreateTimer()
	if GetUnitAbilityLevel(u,'A2VW')>0 then
	call YDWESetUnitAbilityState(u,'A3TY', 1, 3.75)
	call SaveInteger(TABLE_HY, GetHandleId(u), 'echs', 1)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 1, u)
	// IMBA: buff duration x2 cap 30s.
	if XOMG_IMBA_ENABLED then
	call TimerStart(t, RMinBJ(3.75*IMBA_POWER,30.) , false, function hyzrcd)
	else
	call TimerStart(t, 3.75 , false, function hyzrcd)
	endif	
	else
	call YDWESetUnitAbilityState(u,'A3TY', 1, 5)
	call SaveInteger(TABLE_HY, GetHandleId(u), 'echs', 1)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 1, u)
	// IMBA: buff duration x2 cap 30s.
	if XOMG_IMBA_ENABLED then
	call TimerStart(t, RMinBJ(5.*IMBA_POWER,30.) , false, function hyzrcd)
	else
	call TimerStart(t, 5 , false, function hyzrcd)
	endif
	endif
	set t = null
endfunction
function Hyzr_Actions takes unit u , unit t returns nothing
	if LoadInteger(TABLE_HY, GetHandleId(WXX),'echs')== 0 then
		call UnitAddAbility(u,'A3TW')
		call hrzycd(u)
		if not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
			call Z57(t,'A3TX', 1, 0.8,'a3TX')
		endif
	endif
endfunction
function Hyzr takes nothing returns nothing
	if GetUnitAbilityLevel(WXX,'A3TW')> 0 then
		call UnitRemoveAbility(WXX,'A3TW')
	endif
    //是猴子猴孙则返回
    if ISHZHS(WXX) then
        return
    endif
	if(GetUnitAbilityLevel(WXX,'A3TY')> 0) and LoadBoolean(TABLE_HY, EOO, 15) and IsUnitType(WXX, UNIT_TYPE_MELEE_ATTACKER) and not IsUnitIllusion(WXX) then
		call Hyzr_Actions(WXX, YXX)
	endif
endfunction
function Q_A takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 0)
	if GetGameTime()> LoadReal(TABLE_HY, h, 0) or GetUnitAbilityLevel(u,'B0DM')== 0 then
		call UnitRemoveAbility(u,'A3OV')
		call UnitRemoveAbility(u,'A3OU')
		call UnitRemoveAbility(u,'B0DM')
		call RemoveSavedHandle(TABLE_HY, GetHandleId(u),'A3OV')
		call FlushChildHashtable(TABLE_HY, h)
		call PauseTimer(t)
		call DestroyTimer(t)
	else
		call B67(LoadUnitHandle(TABLE_HY, h, 1), u, 1, 4)
	endif
	set u = null
	set t = null
endfunction
function Q0A takes unit u, unit sou, boolean b returns nothing
	local timer t = LoadTimerHandle(TABLE_HY, GetHandleId(u),'A3OV')
	local integer h
	local integer id
	if b then
		set id = 'A3OV'
	else
		set id = 'A3OU'
	endif
	if t != null then
		set h = GetHandleId(t)
		if b != LoadBoolean(TABLE_HY, h, 1) then
			call UnitRemoveAbility(u,'A3OV')
			call UnitRemoveAbility(u,'A3OU')
			call UnitRemoveAbility(u,'B0DM')
			call UnitAddPermanentAbility(u, id)
		endif
	else
		set t = CreateTimer()
		set h = GetHandleId(t)
		call TimerStart(t, 1., true, function Q_A)
		call UnitAddPermanentAbility(u, id)
		call SaveUnitHandle(TABLE_HY, h, 0, u)
		call SaveUnitHandle(TABLE_HY, h, 1, sou)
		call SaveTimerHandle(TABLE_HY, GetHandleId(u),'A3OV', t)
	endif
	call SaveBoolean(TABLE_HY, h, 1, b)
	call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 4.)
	set t = null
endfunction
function OAO takes nothing returns nothing	//淬毒之珠
	if GetUnitAbilityLevel(WXX,'A1V7') > 0 then
		call Q0A(YXX, WXX, IsUnitType(WXX, UNIT_TYPE_MELEE_ATTACKER))
	endif
endfunction
function JDLD takes unit ZX7,unit IH7, boolean ZOO returns nothing
    local integer i
    if ZOO then
        set i=20
    else
        set i=10
    endif
    if WF7(IH7)==false and GetPrdRandom(ZX7,'A4HE', IMinBJ(i*imbaMult,100)) then
        call Z57(IH7,'A4HE', 1, 0.8,'B0K0')
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",IH7,"origin"))
        call B67(ZX7,IH7,1,75.)
    endif
endfunction
function QYA takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
    local integer skill=LoadInteger(TABLE_HY, h, 1)
    local integer buffid
    if skill=='A40W' then
        set buffid='B0HX'
    elseif skill=='A4H7' then
        set buffid='B0JZ'
    endif
	if GetGameTime()> LoadReal(TABLE_HY, h, 0) or GetUnitAbilityLevel(LoadUnitHandle(TABLE_HY, h, 0),skill)== 0 then
		call UnitRemoveAbility(LoadUnitHandle(TABLE_HY, h, 0),skill)
		call UnitRemoveAbility(LoadUnitHandle(TABLE_HY, h, 0),buffid)
        if GetUnitAbilityLevel(LoadUnitHandle(TABLE_HY, h, 0),'B0HX')==0 and GetUnitAbilityLevel(LoadUnitHandle(TABLE_HY, h, 0),'B0JZ')==0 then
            call ResetUnitVertexColor(LoadUnitHandle(TABLE_HY, h, 0),0)
        endif
		call RemoveSavedHandle(TABLE_HY, GetHandleId(LoadUnitHandle(TABLE_HY, h, 0)),skill)
		call FlushChildHashtable(TABLE_HY, h)
		call PauseTimer(t)
		call DestroyTimer(t)
	endif
	set t = null
endfunction
function QZA2 takes unit ZX7,unit IH7, boolean ZOO,integer skill returns nothing
	local timer t = LoadTimerHandle(TABLE_HY, GetHandleId(IH7),skill)
	local integer h
	if t != null then
		set h = GetHandleId(t)
	else
		set t = CreateTimer()
		set h = GetHandleId(t)
		call TimerStart(t, .1, true, function QYA)
		call UnitAddPermanentAbility(IH7,skill)
		call SaveUnitHandle(TABLE_HY, h, 0, IH7)
        call SaveInteger(TABLE_HY, h, 1, skill)
		call SaveTimerHandle(TABLE_HY, GetHandleId(IH7), skill, t)
	endif
	if ZOO then
		call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 5)
	else
		call SaveReal(TABLE_HY, h, 0, GetGameTime()+ 2.5)
	endif
	call JFX(IH7)
	set t = null
endfunction
function QZA takes unit ZX7,unit IH7, boolean ZOO returns nothing
    if GetUnitAbilityLevel(ZX7,'A4H8')>0 then
        call UnitRemoveAbility(IH7,'A40W')
		call UnitRemoveAbility(IH7,'B0HX')
        call QZA2(ZX7,IH7,ZOO,'A4H7')
        call JDLD(ZX7,IH7,ZOO)
    elseif GetUnitAbilityLevel(ZX7,'A2KV')>0 and GetUnitAbilityLevel(IH7,'B0JZ')==0 then
        call QZA2(ZX7,IH7,ZOO,'A40W')
    endif
endfunction
function OBO takes nothing returns nothing	//冰眼
	if GetUnitAbilityLevel(WXX,'A2KV')>0 or GetUnitAbilityLevel(WXX,'A4H8')>0 then
		call QZA(WXX, YXX, IsUnitType(WXX, UNIT_TYPE_MELEE_ATTACKER))
	endif
endfunction
function Physical_Lifesteal takes unit u, unit t, real d returns nothing
	local real r = B4R(WXX)
	if r == 0. then
		return
	endif
	if IsUnitIllusion(u) == false and IsUnitIllusion(t) == false then
		call SetWidgetLife(u, GetWidgetLife(u)+ d * r)
	endif
	call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", u, "origin"))
endfunction
function OPL takes nothing returns nothing
	if(IsUnitType(WXX, UNIT_TYPE_HERO) or IsUnitIllusion(WXX) or AS7(WXX)) then
		if LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) then
			call Physical_Lifesteal(WXX, YXX, ZXX)
		endif
	endif
endfunction
function Q4A takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit WLE = LoadUnitHandle(TABLE_HY, h, 1)
	local unit u
	local real ZCE
	if UnitAlive(WLE) then
		set u = LoadUnitHandle(TABLE_HY, h, 0)
		set ZCE = LoadReal(TABLE_HY, h, 0)
		if IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then
			if MR7(u,ZU[it_xh]) then
				call B67(u, WLE, 10, ZCE * .80)
            elseif MR7(u,ZU[X1]) then
				call B67(u, WLE, 10, ZCE * .60)
			else
				call B67(u, WLE, 10, ZCE * .40)
			endif
		else
				call B67(u, WLE, 10, ZCE * .25)
		endif
	endif
	call PauseTimer(t)
	call FlushChildHashtable(TABLE_HY, h)
	call DestroyTimer(t)
	set WLE = null
	set u = null
	set t = null
endfunction
function Q5A takes unit u, unit tar, real d returns nothing
	local timer t = CreateTimer()
	call TimerStart(t, 0, false, function Q4A)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 0, u)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 1, tar)
	call SaveReal(TABLE_HY, GetHandleId(t), 0, d)
	set t = null
endfunction
function OVO takes nothing returns nothing	//压制之刃、寒铁钢爪、狂战斧、超神斧
    //非建筑非守卫敌对非幻象非英雄非肉山非熊灵
    if LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and GetUnitAbilityLevel(WXX,'A1AB')>0 and IsUnitIllusion(YXX)==false and IsUnitType(YXX, UNIT_TYPE_HERO)==false and (YXX != V4 and AS7(YXX)==false) then
		call Q5A(WXX, YXX, ZXX)
	endif
endfunction
function UnitCleavePD takes nothing returns boolean
	return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(U22))and GZZ(GetFilterUnit())
	endfunction
function UnitCleave takes unit ZX7,unit IH7,real range,real value,string effPath,string attachPointName, boolean ISMNGJ returns nothing
    local group g= WS7()
    local unit firstUnit= null
    local real radian
    local real x
    local real y
	local real Face
	if IsUnitIllusion(ZX7) then
		set value=value*GetIllusionDamageData(ZX7)
	endif
	if ISMNGJ then
       set Face=Face_mngj[GetPlayerId(GetOwningPlayer(ZX7))]
	   set x=GetUnitX(IH7) + range * Cos(Face*bj_DEGTORAD)
	   set y=GetUnitY(IH7) + range * Sin(Face*bj_DEGTORAD)
	else
       set x=GetUnitX(ZX7)
       set y=GetUnitY(ZX7)
       set radian=RadianBetweenUnit(ZX7 , IH7)
       set x=x + range * Cos(radian)
       set y=y + range * Sin(radian)
	endif
       set U22=ZX7
       call GroupEnumUnitsInRange(g, x, y, range + MAX_UNIT_COLLISION, Condition(function UnitCleavePD))
       call GroupRemoveUnit(g, IH7)
       loop
           set firstUnit=FirstOfGroup(g)
       exitwhen firstUnit == null
           call GroupRemoveUnit(g, firstUnit) 
           if IsUnitInRange(firstUnit, IH7, range) then
               call B67_DPS(ZX7 , firstUnit , 10 , value)
               if effPath != null then
                   call DestroyEffect(AddSpecialEffectTarget(effPath, firstUnit, attachPointName))
               endif
           endif
       endloop
       set firstUnit=null
       call WR7(g)
       set g=null
   endfunction
function MNFL takes unit ZX7, unit IH7, real rate,boolean ISMNGJ returns nothing
	local integer level= 0
	local string modelName= null
	local string attachPointName= null
	local real d
	local unit BB7
	local integer id
	local boolean randomGiantSwing=false
    local real YM7=(GetUnitState(ZX7,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(ZX7,UNIT_STATE_ATTACK1_DAMAGE_BONUS))*rate
	if ISMNGJ==false and LoadBoolean(TABLE_HY,EOO,StringHash("B846StackHandled")) and WXX==ZX7 and YXX==IH7 then
	set YM7=LoadReal(TABLE_HY,EOO,StringHash("B846StackRaw"))*rate
	endif
	set randomGiantSwing=SUIJI_MODE and (SuijiMode_HasRandomSkill(ZX7,'A01K') or SuijiMode_GetIllusionPassiveBridgeLevel(ZX7,'A01K')>0)
	if IsUnitType(ZX7, UNIT_TYPE_MELEE_ATTACKER)==false and randomGiantSwing==false then
		return
	endif
			// 授予力量
            if Have_SYLL(ZX7) then
                set level=LoadInteger(ExtraHT, 'A037', GetHandleId(ZX7))
				set d=0.1 + level * 0.1
				set modelName="Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl"
				set attachPointName="chest"
				call UnitCleave(ZX7 , IH7 , 250 , YM7 * d , modelName , attachPointName ,ISMNGJ)
			endif
			//巨力挥舞
			set level=B287_GetUnitAbilityLevel(ZX7, 'A01K')
			if level > 0 and ISPH(ZX7)==false then
				set id=GetUnitTypeId(ZX7)
				set d=0.18 + level * 0.12
				if id=='Z001' or id=='Z0CQ' then
					set modelName="model\\Hero_Sven_N7S_C_Impact.mdl"
					set attachPointName="chest"
					set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0GL',GetUnitX(ZX7),GetUnitY(ZX7),AngleBetweenUnit(ZX7,IH7))
					call KillUnit(BB7)
				else
					set modelName=null
					set attachPointName=null
				endif
				if id=='H001' or id=='H0CQ' then
					set BB7=CreateUnit(GetOwningPlayer(ZX7),'h0GG',GetUnitX(ZX7),GetUnitY(ZX7),AngleBetweenUnit(ZX7,IH7))
					call KillUnit(BB7)
				endif
				call UnitCleave(ZX7 , IH7 , 300 , YM7 * d , modelName , attachPointName ,ISMNGJ)
			endif
			// A杖长大
			if GetUnitAbilityLevel(ZX7, 'A4C8') > 0 and ISPH(ZX7)==false then
				set d=0.5
				set modelName="Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl"
				set attachPointName="chest"
				call UnitCleave(ZX7 , IH7 , 400 , YM7 * d , modelName , attachPointName ,ISMNGJ)
			endif		
			//狂战斧
			if (GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (MR7(ZX7,ZU[X1]) or MR7(ZX7,ZU[it_xh])) and MRPH(ZX7)==false then
				set d=.45*(Have_Item_Quantity(ZX7,X1)+Have_Item_Quantity(ZX7,it_xh))
				set modelName="Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl"
				set attachPointName="chest"
				call UnitCleave(ZX7, IH7 , 300 , YM7 * d , modelName , attachPointName , ISMNGJ)
			endif
    set BB7=null
endfunction
function MNFL_PD takes nothing returns nothing
	//非建筑非守卫的敌对单位
	if LoadBoolean(TABLE_HY, EOO, 11)== false and LoadBoolean(TABLE_HY, EOO, 14) and LoadBoolean(TABLE_HY, EOO, 15) and IsUnitType(WXX, UNIT_TYPE_MELEE_ATTACKER) then
		call MNFL(WXX,YXX,1.,false)
	endif
endfunction
//暴击额外吸血
function BJ_EXTRA takes unit ZX7,unit IH7,real AddDamge returns nothing
local real r=(B4R(ZX7)+B4R_XXGH(ZX7))
//吸血
if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r>0 then
call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+AddDamge*r)
endif
//压制之刃
if IsUnitIllusion(IH7)==false and IsUnitType(IH7, UNIT_TYPE_HERO)==false and(GetUnitAbilityLevel(ZX7,'A1AB')> 0) and (IH7 != V4 and AS7(IH7)==false)  then
call Q5A(ZX7, IH7, AddDamge)
endif
endfunction
function ECJTBJ takes unit ZX7,unit IH7,real Damge,boolean ISMNGJ, real Damgerate returns boolean
local integer TotalDamge
local real AddDamge
local real Face=GetUnitFacing(ZX7)+180.
local integer id=GetPlayerId(GetOwningPlayer(ZX7))
if ISMNGJ then
set Face=Face_zxzr[id]
else
if Face>360. then
set Face=Face-360.
endif
endif
set TotalDamge=R2I(Damge*Damgerate)
set AddDamge=Damge*(Damgerate-1)
call YW7(I2S(TotalDamge)+"!",5,ZX7,0.024,255,0,0,255)
call B67_DPS(ZX7,IH7,2,AddDamge)
call CreateUnit(GetOwningPlayer(IH7),'e050',GetUnitX(IH7),GetUnitY(IH7),Face)
if XSBJ then
call DisplayTextToPlayer(Player(1),0,0, "恩赐解脱未暴击伤害："+R2S(Damge)+" 暴击倍率："+R2S(Damgerate)+" 总伤害："+R2S(TotalDamge)+" 额外伤害："+R2S(AddDamge))
endif
call BJ_EXTRA(ZX7,IH7,AddDamge)
call MNFL(ZX7, IH7, (Damgerate-1), ISMNGJ)
return false
endfunction
function HDYJBJ takes unit ZX7,unit IH7,real Damge, real Damgerate returns boolean
local integer level=B287_GetUnitAbilityLevel(ZX7,'A03N')
local integer TotalDamge
local real AddDamge
local real r_skill=.2+.1*level
local real d=DGH_BUFF(ZX7)
set TotalDamge=R2I(Damge*Damgerate)
set AddDamge=Damge*(Damgerate-1)
call YW7(I2S(TotalDamge)+"!",5,ZX7,0.024,255,0,0,255)
call B67_DPS(ZX7,IH7,2,AddDamge)
//暴击技能吸血
if IsUnitIllusion(ZX7)==false and IsUnitIllusion(IH7)==false and r_skill>0 then
call SetWidgetLife(ZX7, GetWidgetLife(ZX7)+Damge*(Damgerate)*r_skill*d)
endif
call BJ_EXTRA(ZX7,IH7,AddDamge)
call MNFL(ZX7, IH7, (Damgerate-1), false)
if XSBJ then
call DisplayTextToPlayer(Player(1),0,0, "混沌一击未暴击伤害："+R2S(Damge)+" 暴击倍率："+R2S(Damgerate)+" 总伤害："+R2S(TotalDamge)+" 技能吸血："+R2S(r_skill))
endif
return false
endfunction
function ZSDJBJ takes unit ZX7,unit IH7,real Damge,real Damgerate  returns boolean
local integer level=B287_GetUnitAbilityLevel(ZX7,'ABcr')
local integer TotalDamge=R2I(Damge*Damgerate)
local real AddDamge=Damge*(Damgerate-1)
if IsUnitType(IH7,UNIT_TYPE_HERO)==false and IsUnitIllusion(IH7)==false and GetUnitTypeId(IH7)!='n00L' and AS7(IH7)==false then
set Damgerate=Damgerate*2
set TotalDamge=R2I(Damge*Damgerate)
set AddDamge=Damge*(Damgerate-1)
endif
if GetUnitTypeId(ZX7)=='ZC00' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_skeletonking_n7s_e_star.mdx", IH7, "origin"))
else
call YS7("tx\\snk\\SNK_ZSDJ.mdx",IH7,"origin",2)
endif
call YW7(I2S(TotalDamge)+"!",5,ZX7,0.024,255,0,0,255)
call B67_DPS(ZX7,IH7,2,AddDamge)
call BJ_EXTRA(ZX7,IH7,AddDamge)
call MNFL(ZX7, IH7, (Damgerate-1), false)
if XSBJ then
call DisplayTextToPlayer(Player(1),0,0, "致死打击未暴击伤害："+R2S(Damge)+" 暴击倍率："+R2S(Damgerate)+" 总伤害："+R2S(TotalDamge)+" 额外伤害："+R2S(AddDamge))
endif
return false
endfunction
function SKBJ_RATE takes unit u returns real
local integer id=GetUnitTypeId(u)
local real d=0.
if B287_GetUnitAbilityLevel(u,'ABcr')>0 then
set d=(7.+B287_GetUnitAbilityLevel(u,'ABcr')*2)/100
elseif B287_GetUnitAbilityLevel(u,'A03Q')>0 then
set d=.17
elseif B287_GetUnitAbilityLevel(u,'A03N')>0 then
set d=.25
elseif B287_GetUnitAbilityLevel(u,'A2PX')>0 then
set d=.4
elseif B287_GetUnitAbilityLevel(u,'A1OY')>0 then
set d=.25
elseif B287_GetUnitAbilityLevel(u,'A00K')>0 then //剑舞
set d=(15.+B287_GetUnitAbilityLevel(u,'A00K')*5)/100
//仅做计算
elseif B287_GetUnitAbilityLevel(u,'A0MX')>0 then //醉拳
set d=BrewmasterBrawler_CritRate(u)
endif
return d
endfunction
function DPBJ_RATE takes unit u returns real
local integer n=Have_Item_Quantity(u,L5)
local integer i=1
local real d=1.
if n>0 then
loop
exitwhen i>n
set d=d * .7
set i=i+1
endloop
endif
return  1. - d
endfunction
function XJBJ_RATE takes unit u returns real
local integer n=Have_Item_Quantity(u,A1)+Have_Item_Quantity(u,it_xueji)
local integer i=1
local real d=1.
if n>0 then
loop
exitwhen i>n
set d=d * .8
set i=i+1
endloop
endif
return  1. - d
endfunction
//普通暴击
function MNBJ_Normal takes unit ZX7,unit IH7,real Damge,real Damgerate,boolean ISMNGJ returns nothing
local integer TotalDamge=R2I(Damge*Damgerate)
local real AddDamge=Damge*(Damgerate-1)
if AYB_MNGJ then
    call YW7(I2S(TotalDamge)+"!",5,IH7,0.024,255,0,128,255)
else
    call YW7(I2S(TotalDamge)+"!",5,ZX7,0.024,255,0,0,255)
endif
call B67_DPS(ZX7,IH7,2,AddDamge)
call BJ_EXTRA(ZX7,IH7,AddDamge)
call MNFL(ZX7, IH7, (Damgerate-1), ISMNGJ)
if XSBJ then
call DisplayTextToPlayer(Player(1),0,0, "未暴击伤害："+R2S(Damge)+" 暴击倍率："+R2S(Damgerate)+" 总伤害："+R2S(TotalDamge)+" 额外伤害："+R2S(AddDamge))
endif
endfunction
function BrewmasterBrawler_CritEvent takes nothing returns nothing
if LoadBoolean(TABLE_HY,EOO,StringHash("B846StackHandled")) then
return
endif
if LoadBoolean(TABLE_HY,EOO,10) and LoadBoolean(TABLE_HY,EOO,11)==false and LoadBoolean(TABLE_HY,EOO,14) and LoadBoolean(TABLE_HY,EOO,15) and ZXX>0. and BrewmasterBrawler_TryCrit(WXX) then
call MNBJ_Normal(WXX,YXX,ZXX,2.,false)
call YW7("醉拳!",5,YXX,.024,255,110,70,255)
endif
endfunction
function WalrusPunch_IsHeroTarget takes unit target returns boolean
return target!=null and GetUnitTypeId(target)!=0 and IsUnitType(target,UNIT_TYPE_HERO)
endfunction
function WalrusPunch_GetNoArmorDamage takes unit source,unit target,real rate returns real
local real damage=0.
if source==null or target==null or GetUnitTypeId(source)==0 or GetUnitTypeId(target)==0 then
return 0.
endif
set damage=(GetUnitState(source,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(source,UNIT_STATE_ATTACK1_DAMAGE_BONUS))*rate
if IsUnitIllusion(source) then
set damage=damage*GetIllusionDamageData(source)
endif
if IsUnitIllusion(target) then
set damage=damage*GetIllusionUnitData(target)
endif
return RMaxBJ(damage,0.)
endfunction
function WalrusPunch_ApplyNoArmorCritical takes unit source,unit target,real eventDamage,real rate,boolean simulated returns nothing
local real totalDamage=WalrusPunch_GetNoArmorDamage(source,target,rate)
local real extraDamage=RMaxBJ(totalDamage-eventDamage,0.)
if not simulated and LoadUnitHandle(L7,GetHandleId(source),StringHash("B1010GuiseTarget"))==target then
call SaveBoolean(L7,GetHandleId(source),StringHash("B1010GuiseArmorIgnored"),true)
endif
if simulated then
call B67_DPS(source,target,11,extraDamage)
else
call YDWESetEventDamage(totalDamage)
endif
call YW7(I2S(R2I(totalDamage))+"!",5,source,.024,255,0,0,255)
call BJ_EXTRA(source,target,extraDamage)
call MNFL(source,target,rate-1.,simulated)
endfunction
//判断是否暴击并获取倍数
function SetUnitCriticalStrike takes unit ZX7,unit IH7,boolean isMelee returns real
 local real value= 0.
 local real Damagerate= 0.
 local real rate= 0.
 local integer skill= 0
 local integer level= 0
 local boolean isHeroSource= IsUnitType(ZX7, UNIT_TYPE_HERO) or AS7(ZX7) or IsUnitIllusion(ZX7)
    if isHeroSource==false then //非英雄非熊灵非镜像则返回
        return 0.
    endif
	// 致命一击同时触发取最高值
	// if isHeroSource then
        //技能暴击
	// 致命一击同时触发取最高值
	// if isHeroSource then
        //技能暴击
	// 致命一击同时触发取最高值
	// if isHeroSource then
        //技能暴击
		if ISPH(ZX7)==false then
			// 忍术
			// set level=B287_GetUnitAbilityLevel(ZX7, 'A1IQ')
			// if level > 0 and B287_YDWEGetUnitAbilityState(ZX7 , 'A1IQ' , 1) == 0. then
			// 	set Damagerate=2.0
			// 	if ( value < Damagerate ) then
			// 		set value=Damagerate
			// 		set skill='A1IQ'
			// 	endif
			// endif
			// 狼人(40) * (1.6 1.8 2)
			// 忍术
			// set level=B287_GetUnitAbilityLevel(ZX7, 'A1IQ')
			// if level > 0 and B287_YDWEGetUnitAbilityState(ZX7 , 'A1IQ' , 1) == 0. then
			// 	set Damagerate=2.0
			// 	if ( value < Damagerate ) then
			// 		set value=Damagerate
			// 		set skill='A1IQ'
			// 	endif
			// endif
			// 狼人(40) * (1.6 1.8 2)
			// 忍术
			// set level=B287_GetUnitAbilityLevel(ZX7, 'A1IQ')
			// if level > 0 and B287_YDWEGetUnitAbilityState(ZX7 , 'A1IQ' , 1) == 0. then
			// 	set Damagerate=2.0
			// 	if ( value < Damagerate ) then
			// 		set value=Damagerate
			// 		set skill='A1IQ'
			// 	endif
			// endif
			// 狼人(40) * (1.6 1.8 2)
			set level=B287_GetUnitAbilityLevel(ZX7,'A2PX')
			if level > 0 and GetPrdRandom(ZX7 , 'A2PX' , IMinBJ(40*imbaMult,100)) then
				set Damagerate=1.4+level*.2
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A2PX'
				endif
			endif
			// 剑舞(20, 25, 30, 35) * (2.0) 
			// 剑舞(20, 25, 30, 35) * (2.0) 
			// 剑舞(20, 25, 30, 35) * (2.0) 
			set level=B287_GetUnitAbilityLevel(ZX7, 'A00K')
			if level > 0 and GetPrdRandom(ZX7 , 'A00K' , IMinBJ((15 + level * 5)*imbaMult,100)) then
				set Damagerate=2.0
				if ( value < Damagerate ) then
					set value=Damagerate
					set skill='A00K'
				endif
			endif
			// 醉拳 如果被破坏效果作用, 那么必定暴击也不会触发
			// set level=B287_GetUnitAbilityLevel(ZX7, 'A0MX')
			// if level > 0 and ( LoadBoolean(ExtraHT, AEAttackerId[AEI], HTKEY_UNIT_DRUNKEN_BRAWLER_CS) or GetPrdRandom(ZX7 , 'A0MX' , 5. + level * 5.) ) then
			// 	set Damagerate=2.0
