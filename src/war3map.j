set t=null
endfunction
function CSD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real V29=(LoadReal(L7,(I97),(680)))
local real d=0.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(IH7)==false then
if IH7!=null and GetUnitTypeId(IH7)!=0 then
call UnitRemoveAbility(IH7,'A4EO')
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
set d=V29*(GetUnitState(IH7,UNIT_STATE_MAX_LIFE)-GetUnitState(IH7,UNIT_STATE_LIFE))
call UnitRemoveAbility(IH7,'A4EO')
if GetUnitTypeId(ZX7)=='U00E' or GetUnitTypeId(ZX7)=='E02X' or GetUnitTypeId(ZX7)=='Z02X' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",IH7,"origin"))
endif
if OT7(IH7,"ShallowGrave|Active") then
	set d=GetUnitState(IH7,UNIT_STATE_LIFE)+50.
endif
call B67(ZX7,IH7,1,d)
call LINGXIA(ZX7,IH7)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endfunction
//死神镰刀
function CUD takes nothing returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local unit SSLD
local integer id=GetUnitTypeId(ZX7)
local integer CVD=B287_GetUnitAbilityLevel(ZX7,'A067')
local integer CWD=SuijiMode_GetRegisteredAghLevel(ZX7,'A067','A08P')
local real V29
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local real Face=GetUnitFacing(ZX7)
if CWD==1 then
set V29=.6
elseif CWD==2 then
set V29=.9
elseif CWD==3 then
set V29=1.2
elseif CVD==1 then
set V29=.4
elseif CVD==2 then
set V29=.6
else
set V29=.8
endif
if id=='Z00E' then
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Necrolyte_N4S_R_Target.mdl",IH7,"origin"))
    set SSLD=CreateUnit(GetOwningPlayer(ZX7),'e051',x,y,Face)
    call KillUnit(SSLD)
    set SSLD=null
elseif id=='Z10E' then
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Necrolyte_N5S_R_Target.mdl",IH7,"origin"))
    set SSLD=CreateUnit(GetOwningPlayer(ZX7),'e051',x,y,Face)
    call MHUnit_SetModel(SSLD,"model\\hero_necrolyte_n5s_r_source.mdl",false)
    call KillUnit(SSLD)
    set SSLD=null
elseif id=='Z20E' then
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Necrolyte_N2S_R_Target.mdl",IH7,"origin"))
    set SSLD=CreateUnit(GetOwningPlayer(ZX7),'e051',x,y,Face)
    call MHUnit_SetModel(SSLD,"model\\hero_necrolyte_n2s_r_source.mdl",false)
    call KillUnit(SSLD)
elseif id=='Z30E' then
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_Necrolyte_N3S_R_Target.mdl",IH7,"origin"))
    set SSLD=CreateUnit(GetOwningPlayer(ZX7),'e051',x,y,Face)
    call MHUnit_SetModel(SSLD,"model\\hero_necrolyte_n2s_r_source.mdl",false)
    call KillUnit(SSLD)
else
    call XF7(IH7,'A4EO')
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",IH7,"origin"))
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(IH7))
call SaveReal(L7,(I97),(680),((V29)*1.))
call TriggerRegisterTimerEvent(t,1.5,false)
call TriggerAddCondition(t,Condition(function CSD))
call O37(IH7,"4333",1.5)
if CWD>0 then
call O37(IH7,"4418",1.51)
endif
set ZJI=ZX7
set SSLD=null
set t=null
set ZX7=null
set IH7=null
endfunction
function CXD takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A067' or B287_GetSpellAbilityId()=='A08P') and WQ7(GetSpellTargetUnit())==false then
call CUD()
endif
return false
endfunction
function H58 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function CXD))
set t=null
