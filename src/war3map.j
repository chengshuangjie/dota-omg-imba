function KKAI_DisableBlinkNow takes unit WI7 returns nothing
local integer i=0
local item A28
local integer Y68
local integer disabledIndex
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false or OO7(GetHandleId(WI7),"B834ReincarnationPending") or GetPlayerController(GetOwningPlayer(WI7))!=MAP_CONTROL_COMPUTER then
set WI7=null
return
endif
loop
exitwhen i>5
set A28=UnitItemInSlot(WI7,i)
set Y68=KZ7(A28)
set disabledIndex=0
if Y68==RW then
set disabledIndex=TW
elseif Y68==it_sg then
set disabledIndex=it_sgban
elseif Y68==it_sssg then
