function LMD2 takes nothing returns nothing
    local unit ZX7=U22
    local unit IH7=GetEnumUnit()
    local integer BC7=AL4
    if WQ7(IH7)==false then
        call B67(ZX7,IH7,1,25+75*BC7)
        call CommonUnitAddStun(IH7, 0.1, false)
        if X67() then
            call Z57(IH7,'A4IB', 1, 2,'B00P')
        else
            call Z57(IH7,'A4IB', 1, 4,'B00P')
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl",IH7,"origin"))
        if IH7==IN4 then
            call LINGXIA(ZX7,IH7)
        endif
    else
        call PLK(IH7)
    endif
    set ZX7=null
    set IH7=null
endfunction
