endif
return false
endfunction
function SuijiMode_LockGlobalHeroInit takes integer suijiGlobalInitSource returns boolean
if SuijiMode_ShouldGlobalLockHeroInit(suijiGlobalInitSource)==false then
return true
endif
if OO7(StringHash("SuijiGlobalHeroInitLock"),I2S(suijiGlobalInitSource)) then
return false
endif
call NS7(StringHash("SuijiGlobalHeroInitLock"),I2S(suijiGlobalInitSource),true)
return true
endfunction
