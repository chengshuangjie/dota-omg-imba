            if GetRandomInt(0,100)<=15 then
                call FENGHUA2(WXX, YXX)
            endif
        else
            if GetRandomInt(0,100)<=5 then
		        call FENGHUA2(WXX, YXX)
            endif
        endif
	endif
endfunction
