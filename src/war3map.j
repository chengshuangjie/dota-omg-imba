endif
call NS7(kunkkaTidebringerUnitHandle,"KunkkaTidebringerInit",true)
set kunkkaTidebringerTimer=CreateTrigger()
call TriggerRegisterTimerEvent(kunkkaTidebringerTimer,.5,true)
call TriggerAddAction(kunkkaTidebringerTimer,function IQG)
call NT7(GetHandleId(kunkkaTidebringerTimer),"Hero",kunkkaTidebringerUnit)
call NQ7(kunkkaTidebringerUnitHandle,"WaterSword|LastUsed",.0)
set kunkkaTidebringerDeathTrigger=CreateTrigger()
call B1027TempestTrackListener(kunkkaTidebringerUnit,kunkkaTidebringerDeathTrigger)
call TriggerRegisterUnitEvent(kunkkaTidebringerDeathTrigger,kunkkaTidebringerUnit,EVENT_UNIT_DEATH)
call TriggerAddCondition(kunkkaTidebringerDeathTrigger,Condition(function IUG))
set kunkkaTidebringerTimer=null
set kunkkaTidebringerDeathTrigger=null
endfunction
