function QPD takes unit WI7,boolean b returns nothing
local group g=WS7()
local integer id=GetUnitTypeId(WI7)
if id=='Zpgh' then
    call DestroyEffect(AddSpecialEffect("model\\Hero_Axe_N9S_X_Source.mdl",GetUnitX(WI7),GetUnitY(WI7)))
elseif id=='Zpgi' then
    call DestroyEffect(AddSpecialEffect("model\\Hero_Axe_N4S_X_Source.mdl",GetUnitX(WI7),GetUnitY(WI7)))
endif
set U22=WI7
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),300,Condition(function LVI))
call ForGroup(g,function QOD)
call SetUnitAnimation(WI7,"spin")
call ZP7(WI7,.6)
if b==false then
    if GetUnitAbilityLevel(WI7,'A2VW')>0 then
call O37(WI7,"QPD",.75*(.5-.05*B287_GetUnitAbilityLevel(WI7,'A0C6')))
    else
call O37(WI7,"QPD",.5-.05*B287_GetUnitAbilityLevel(WI7,'A0C6'))
    endif
endif
call WR7(g)
set g=null
endfunction
function FJLX takes nothing returns nothing
	if B287_GetUnitAbilityLevel(YXX,'A0C6')> 0 and IsUnitType(WXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(WXX,'A04R')==0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetPrdRandom(YXX, 'A0C6', IMinBJ(20*imbaMult,100)) and ISPH(YXX)==false then
        if MV7(YXX,ZU[it_xh])!=null then
            call QPD(YXX,true) 
        elseif OT7(YXX,"QPD")==false then
            call QPD(YXX,false)
        endif 
    elseif B287_GetUnitAbilityLevel(WXX,'A0C6')> 0 and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(YXX,'A04R')==0 and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) and GetPrdRandom(WXX, 'A0C6', IMinBJ(20*imbaMult,100)) and ISPH(WXX)==false and SuijiMode_ScepterRegistryIsActive(WXX,'A0C6') then
        if MV7(WXX,ZU[it_xh])!=null then
            call QPD(WXX,true)
        elseif OT7(WXX,"QPD")==false then
            call QPD(WXX,false)
        endif
    endif
endfunction
