call SaveUnitHandle(L7,(OB7),(19),(oA))
call SaveUnitHandle(L7,(OB7),(2),(p5))
call SaveInteger(L7,(OB7),(3),(id))
call NP7(OB7,"WexLevel",((OM7(GetHandleId(p5),"WexLevel"))))
call NP7(OB7,"QuasLevel",((OM7(GetHandleId(p5),"QuasLevel"))))
call NP7(OB7,"ExortLevel",((OM7(GetHandleId(p5),"ExortLevel"))))
call RemoveLocation(l)
set t=null
set l=null
set p5=null
endfunction
function TUF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0VS' then
call TTF()
endif
return false
endfunction
function TVF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function TUF))
set t=null
endfunction
function TWF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit TXF=O77(OB7,"Caster")
local unit hn=O77(OB7,"Hero")
//local integer skill=OM7(OB7,"SKILL")
if GetUnitAbilityLevel(hn,'B08X')==0 then
call KillUnit(TXF)
call RemoveUnit(TXF)
call UnitRemoveAbility(hn,'A4B4')
call NM7(OB7)
call OZ7(t)
else
//call SetUnitAbilityLevel(TXF,skill,(OM7(GetHandleId(hn),"QuasLevel")))
call SetUnitX(TXF,GetUnitX(hn))
call SetUnitY(TXF,GetUnitY(hn))
endif
set t=null
set TXF=null
set hn=null
return false
endfunction
function TYF takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit hn=GetTriggerUnit()
local unit TXF=CreateUnit(GetOwningPlayer(hn),'e01V',GetUnitX(hn),GetUnitY(hn),0)
local integer id=GetUnitTypeId(hn)
local integer skill
local integer level=(OM7(GetHandleId(hn),"QuasLevel"))
if id=='Z00U' or id=='Z10U' or id=='Z20U' or id=='Z02X' then
set skill='X0VG'+level
call XF7(TXF,skill)
call XF7(hn,'A4B4')
else
set skill='A0VH'
call XF7(TXF,skill)
call SetUnitAbilityLevel(TXF,skill,level)
endif
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function TWF))
call NT7(OB7,"Caster",TXF)
call NT7(OB7,"Hero",hn)
//call NP7(OB7,"SKILL",skill)
set t=null
set hn=null
set TXF=null
endfunction
function TZF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0XL' then
call TYF()
endif
return false
endfunction
function TAF takes unit hn returns nothing
if GetUnitAbilityLevel(hn,'A0XL')>0 then
call SetUnitAbilityLevel(hn,'A0XL',OM7(GetHandleId(hn),"WexLevel"))
endif
endfunction
function TBF takes nothing returns boolean
if IsUnitIllusion(GetTriggerUnit())==false then
call TAF(GetTriggerUnit())
endif
return false
endfunction
function TCF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function TZF))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function TBF))
call Y97('A0VH',GetRandomReal(1,25))
set t=null
endfunction
function T3F takes unit T6F,unit m5,integer S1F returns nothing
    local real dur= 1 + S1F * 0.5
    call DisarmUnitToTimed(m5 , 'A4HZ' , 'A4I0' , 'B033' , dur)
endfunction
function T1F takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit T6F=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real T0F=ON7(OB7,"Angle")
local real T5F=ON7(OB7,"Rate")
local integer S1F=OM7(OB7,"WexLevel")
local integer T7F=OM7(OB7,"QuasLevel")
local integer T2F=T7F*25/ 3
local real x
local real y
local integer GYE=GetTriggerEvalCount(t)
if GYE>T2F/ 3 then
call NQ7(OB7,"Rate",T5F*.98)
endif
if GYE>T2F or b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call NM7(OB7)
call OZ7(t)
if b1060GetTriggerEventId!=EVENT_UNIT_DEATH then
call T3F(T6F,m5,S1F)
endif
else
set x=X17(GetUnitX(m5)+T5F*Cos(T0F))
set y=X07(GetUnitY(m5)+T5F*Sin(T0F))
call Y67(x,y,$96)
call SetUnitPosition(m5,x,y)
endif
set t=null
set T6F=null
set m5=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function T_F takes unit T6F,unit m5,integer S1F,integer T7F,integer U4F returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real T0F=Atan2(GetUnitY(m5)-GetUnitY(T6F),GetUnitX(m5)-GetUnitX(T6F))
call B67(T6F,m5,1,U4F*40)
call NT7(OB7,"Source",T6F)
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Angle",T0F)
call NQ7(OB7,"Rate",6)
call NP7(OB7,"WexLevel",S1F)
call NP7(OB7,"QuasLevel",T7F)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function T1F))
set t=null
endfunction
function U7F takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),IQ4)==false and WF7((b1060GetEnumUnit))==false then
call GroupAddUnit(IQ4,(b1060GetEnumUnit))
call T_F(IN4,(b1060GetEnumUnit),IH4,tl,Tl)
endif
set b1060GetEnumUnit=null
endfunction
function U8F takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit TLF=O77(OB7,"Caster")
local real a=ON7(OB7,"a")
local real x2=ON7(OB7,"x2")
local real y2=ON7(OB7,"y2")
local group g=OF7(OB7,"g")
local integer S1F=OM7(OB7,"WexLevel")
local integer T7F=OM7(OB7,"QuasLevel")
local integer U4F=OM7(OB7,"ExortLevel")
local real x=GetUnitX(TLF)
local real y=GetUnitY(TLF)
local group g2
if KF7(x,y,x2,y2)<100 then
set x=x2
set y=y2
else
set x=x+33*Cos(a)
set y=y+33*Sin(a)
endif
call SetUnitX(TLF,X17(x))
call SetUnitY(TLF,X07(y))
set g2=WS7()
set IN4=TLF
set IQ4=g
set IH4=S1F
set tl=T7F
set Tl=U4F
call GroupEnumUnitsInRange(g2,x,y,200,Condition(function AJ7_gai))
call ForGroup(g2,function U7F)
call WR7(g2)
if(x==x2 and y==y2)or GetTriggerEvalCount(t)>35 or BlockUnitPass(TLF) then
set g2=WS7()
set IN4=TLF
set IQ4=g
set IH4=S1F
set tl=T7F
set Tl=U4F
call GroupEnumUnitsInRange(g2,x,y,250,Condition(function AJ7_gai))
call ForGroup(g2,function U7F)
call WR7(g2)
call NM7(OB7)
call OZ7(t)
call KillUnit(TLF)
call RemoveUnit(TLF)
call WR7(g)
endif
set t=null
set TLF=null
set g=null
set g2=null
return false
endfunction
function U9F takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local location l=GetSpellTargetLoc()
local unit T6F=GetTriggerUnit()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local real a=Atan2(y-GetUnitY(T6F),x-GetUnitX(T6F))
local unit TLF
local integer id=GetUnitTypeId(T6F)
local integer skillmj
if id=='Z00U' then
set skillmj='n11X'
elseif id=='Z10U' or id=='Z02X' then
set skillmj='n21X'
elseif id=='Z20U' then
set skillmj='n31X'
else
set skillmj='n01X'
endif
set TLF=CreateUnit(GetOwningPlayer(T6F),skillmj,GetUnitX(T6F),GetUnitY(T6F),a*bj_RADTODEG)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function U8F))
call NT7(OB7,"Caster",TLF)
call NQ7(OB7,"a",a)
call NQ7(OB7,"x2",GetUnitX(T6F)+$3E8*Cos(a))
call NQ7(OB7,"y2",GetUnitY(T6F)+$3E8*Sin(a))
call NB7(OB7,"g",WS7())
call NP7(OB7,"WexLevel",(OM7(GetHandleId(T6F),"WexLevel")))
call NP7(OB7,"QuasLevel",(OM7(GetHandleId(T6F),"QuasLevel")))
call NP7(OB7,"ExortLevel",(OM7(GetHandleId(T6F),"ExortLevel")))
call RemoveLocation(l)
set t=null
set l=null
set T6F=null
set TLF=null
endfunction
function Zov takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group g=(LoadGroupHandle(L7,(OB7),(22)))
local integer i=0
local unit TLF
local real a
local real x2
local real y2
local real x
local real y
local group g3
set g3=WS7()
loop
set TLF=LoadUnitHandle(L7,OB7,100+i)
if TLF!=null then
set x2=LoadReal(L7,OB7,$C8+i)
set y2=LoadReal(L7,OB7,300+i)
set a=LoadReal(L7,OB7,100+i)
set x=GetUnitX(TLF)
set y=GetUnitY(TLF)
if KF7(x,y,x2,y2)<100 then
set x=x2
set y=y2
else
set x=x+33*Cos(a)
set y=y+33*Sin(a)
endif
call SetUnitX(TLF,X17(x))
call SetUnitY(TLF,X07(y))
set IN4=TLF
set IQ4=g
set IH4=7
set tl=7
set Tl=7
call GroupEnumUnitsInRange(g3,x,y,200,Condition(function AJ7_gai))
call ForGroup(g3,function U7F)
if GetTriggerEvalCount(t)>30 or BlockUnitPass(TLF) then
call GroupClear(g3)
set IN4=TLF
set IQ4=g
set IH4=7
set tl=7
set Tl=7
call GroupEnumUnitsInRange(g3,x,y,250,Condition(function AJ7_gai))
call ForGroup(g3,function U7F)
call GroupClear(g3)
call KillUnit(TLF)
call RemoveUnit(TLF)
call RemoveSavedHandle(L7,OB7,100+i)
endif
call GroupClear(g3)
endif
set i=i+1
exitwhen i==$C
endloop
call WR7(g3)
if GetTriggerEvalCount(t)>33 then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call WR7(g)
endif
set t=null
set TLF=null
set g=null
set g3=null
return false
endfunction
function Zrv takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit T6F=GetTriggerUnit()
local real a=0
local unit TLF
local integer i=0
local integer C2D=$C
local integer id=GetUnitTypeId(T6F)
local integer skillmj
if id=='Z00U' then
set skillmj='n11X'
elseif id=='Z10U' or id=='Z02X' then
set skillmj='n21X'
elseif id=='Z20U' then
set skillmj='n31X'
else
set skillmj='n01X'
endif
loop
set a=30*i
set TLF=CreateUnit(GetOwningPlayer(T6F),skillmj,GetUnitX(T6F),GetUnitY(T6F),a)
call SaveUnitHandle(L7,OB7,100+i,TLF)
call SaveReal(L7,OB7,100+i,a*bj_DEGTORAD)
call SetUnitX(TLF,GetUnitX(T6F))
call SetUnitY(TLF,GetUnitY(T6F))
call SaveReal(L7,OB7,$C8+i,X17(GetUnitX(TLF)+$3E8*Cos(a*bj_DEGTORAD)))
call SaveReal(L7,OB7,300+i,X07(GetUnitY(TLF)+$3E8*Sin(a*bj_DEGTORAD)))
set i=i+1
exitwhen i==C2D
endloop
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddCondition(t,Condition(function Zov))
call SaveGroupHandle(L7,(OB7),(22),(WS7()))
call NP7(OB7,"WexLevel",7)
call NP7(OB7,"QuasLevel",7)
call NP7(OB7,"ExortLevel",7)
call SaveInteger(L7,OB7,0,$A)
set t=null
set T6F=null
set TLF=null
endfunction
function UDF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0VM' then
if OM7(GetHandleId(GetTriggerUnit()),"WexLevel")==7 and OM7(GetHandleId(GetTriggerUnit()),"QuasLevel")==7 and OM7(GetHandleId(GetTriggerUnit()),"ExortLevel")==7 then
call Zrv()
else
call U9F()
endif
endif
return false
endfunction
function UEF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function UDF))
set t=null
endfunction
function UFF takes unit hn returns real
local integer UGF=(OM7(GetHandleId(hn),"ExortLevel"))
return(80+UGF*35.)/ 2
endfunction
function UHF takes unit hn returns real
local integer UIF=(OM7(GetHandleId(hn),"WexLevel"))
if GetUnitAbilityLevel(hn,'A2YK')>0 or GetUnitAbilityLevel(hn,'A2YJ')>0 then
set UIF=UIF+1
endif
if GetUnitAbilityLevel(hn,'A4DJ')==4 or GetUnitAbilityLevel(hn,'A4DZ')==4 then
set UIF=UIF+1
endif
return 325+UIF*175.
endfunction
function UJF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit T6F=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local real YM7=ON7(OB7,"Damage")
local effect FX=OG7(OB7,"FX")
local integer GYE=GetTriggerEvalCount(t)
call B67(T6F,m5,1,YM7)
if GYE==3 then
call NM7(OB7)
call OZ7(t)
call DestroyEffect(FX)
endif
set t=null
set T6F=null
set m5=null
set FX=null
return false
endfunction
function UKF takes unit T6F,unit m5,real YM7 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call NT7(OB7,"Source",T6F)
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Damage",YM7)
call NU7(OB7,"FX",AddSpecialEffectTarget("Environment\\SmallBuildingFire\\SmallBuildingFire2.mdl",m5,"chest"))
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function UJF))
set t=null
endfunction
function UMF takes nothing returns nothing
local unit u=GetEnumUnit()
local real d=IJ4
if SZYS then
    set d=d+GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.01
endif
if GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and IsUnitType(u, UNIT_TYPE_HERO) and SZYS then
    call MSF(u,IN4,2)
endif
call UKF(IN4,u,d / 5)
call B67(IN4,u,1,d)
set u=null
endfunction
function AddSpecialEffectEx takes string s,real x,real y,real size returns nothing
    local effect fx=AddSpecialEffect(s,x,y)
    if size>1 then
    call MHEffect_SetScale(fx,size)
    endif
    call DestroyEffect(fx)
    set fx=null
endfunction
function UNF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local real a=ON7(OB7,"a")
local integer GYE=GetTriggerEvalCount(t)-26
local unit T6F=O77(OB7,"Source")
local real UOF
local real UPF
local unit UQF
local group g
local integer id=OM7(OB7,"ID")
local integer skillmj
local string tx
local string tx2
local real FupoDamage=ON7(OB7,"FupoDamage")
local real size
local boolean HaveA=OO7(OB7,"HaveA")
local real range=ON7(OB7,"range")
set SZYS=HaveA
if id=='Z00U' then
set tx="model\\hero_invoker_n4s_d_born.mdl"
set tx2="model\\hero_invoker_n4s_d_boom.mdl"
elseif id=='Z10U' then
set tx="model\\hero_invoker_n3s_d_born.mdl"
set tx2="model\\hero_invoker_n3s_d_boom.mdl"
elseif id=='Z20U' or id=='Z02X' then
set tx="model\\hero_invoker_n2s_d_born.mdl"
set tx2="model\\hero_invoker_n2s_d_boom.mdl"
else
set tx="Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl"
endif
set skillmj=Get_kaer_d_unit(id)
if GYE==1 then
set UQF=CreateUnit(GetOwningPlayer(T6F),skillmj,x,y,a*bj_RADTODEG)
if HaveA then
    set size=XX7(UQF)*1.6
    call SetUnitScale(UQF,size,size,size)
endif
call NT7(OB7,"Caster",UQF)
elseif GYE>1 then
set UQF=O77(OB7,"Caster")
endif
if GYE>0 then
set UOF=X17(GetUnitX(UQF)+$F*Cos(a))
set UPF=X07(GetUnitY(UQF)+$F*Sin(a))
call SetUnitX(UQF,UOF)
call SetUnitY(UQF,UPF)
if(GYE>1 and ModuloInteger(GYE,$A)==0)or GYE==1 then
set g=WS7()
set IN4=T6F
set IJ4=UFF(T6F)*FupoDamage
call GroupEnumUnitsInRange(g,UOF,UPF,range,Condition(function AJ7_gai))
call ForGroup(g,function UMF)
call WR7(g)
if HaveA then
    call AddSpecialEffectEx(tx,UOF,UPF,1.6)
else
    call AddSpecialEffectEx(tx,UOF,UPF,1.)
endif
if id=='Z00U' or id=='Z10U' or id=='Z20U' or id=='Z02X' then
    if HaveA then
        call AddSpecialEffectEx(tx2,UOF,UPF,1.6)
    else
        call AddSpecialEffectEx(tx2,UOF,UPF,1.)
    endif
endif
endif
if GYE>UHF(T6F)/ 16.6 then
call NM7(OB7)
call OZ7(t)
call KillUnit(UQF)
call RemoveUnit(UQF)
endif
endif
set t=null
set g=null
set UQF=null
set T6F=null
return false
endfunction
// //X坐标向指定方向位移指定距离
// function Offset_X takes real x,real a,real d returns real
//     return x+d*Cos(a*bj_DEGTORAD)
// endfunction
// //Y坐标向指定方向位移指定距离
// function Offset_Y takes real y,real a,real d returns real
//     return y+d*Sin(a*bj_DEGTORAD)
// endfunction
function URF takes nothing returns nothing
local trigger t
local integer OB7
local unit T6F=GetTriggerUnit()
local real TargetX=GetSpellTargetX()
local real TargetY=GetSpellTargetY()
local real x=TargetX
local real y=TargetY
local real a=Atan2(y-GetUnitY(T6F),x-GetUnitX(T6F))
local unit USF
local integer id=GetUnitTypeId(T6F)
local integer skillmj
local real size
local real range=280
set SZYS=false
if id=='Z00U' then
set skillmj='e11K'
elseif id=='Z10U' then
set skillmj='e21K'
elseif id=='Z20U' or id=='Z02X' then
set skillmj='e31K'
else
set skillmj='e01K'
endif
if SuijiMode_InvokerSpellScepterIsActive(T6F,'A0VN') then
set SZYS=true
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set USF=CreateUnit(GetOwningPlayer(T6F),skillmj,x,y,a*bj_RADTODEG)
if SZYS then
    set size=XX7(USF)*1.6
    call SetUnitScale(USF,size,size,size)
    set range=420
endif
if id=='Z00U' or id=='Z10U' then
call SetUnitTimeScale(USF,1.)
else
call SetUnitTimeScale(USF,.58)
endif
call UnitApplyTimedLife(USF,'BTLF',1.75)
call TriggerRegisterTimerEvent(t,.05,true)
call TriggerAddCondition(t,Condition(function UNF))
call NT7(OB7,"Source",T6F)
call NQ7(OB7,"x",x)
call NQ7(OB7,"y",y)
call NQ7(OB7,"a",a)
call NQ7(OB7,"range",range)
call NP7(OB7,"ID",id)
call NS7(OB7,"HaveA",SZYS)
if SZYS and SPEPLAYER[GetPlayerId(GetOwningPlayer(T6F))]==3 then
    call NQ7(OB7,"FupoDamage",2.)
else
    call NQ7(OB7,"FupoDamage",1.)
endif
set t=null
set T6F=null
set USF=null
endfunction
function UTF takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0VN' then
call URF()
endif
return false
endfunction
function UUF takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function UTF))
set t=null
endfunction
function UVF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real UWF=ON7(GetHandleId(m5),"MeltingStrike|Last")
if UWF+5<=KQ7()then
call UnitRemoveAbility(m5,'A0VW')
endif
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
return false
endfunction
function UXF takes unit m5 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer V77=GetUnitAbilityLevel(m5,'A0VW')
if V77==0 then
call XF7(m5,'A0VW')
endif
call SetUnitAbilityLevel(m5,'A0VW',V77+1)
call NT7(OB7,"Target",m5)
call NQ7(GetHandleId(m5),"MeltingStrike|Last",KQ7())
call TriggerRegisterTimerEvent(t,5,false)
call TriggerAddCondition(t,Condition(function UVF))
set t=null
endfunction
function UYF takes nothing returns boolean
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger suijiInvokerForgeDamageTrigger=GetTriggeringTrigger()
local integer suijiInvokerForgeDamageHandle=GetHandleId(suijiInvokerForgeDamageTrigger)
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and (not B1023HitLive(O77(suijiInvokerForgeDamageHandle,"Source")) or not B1023HitLive(b1060GetTriggerUnit)) then
call NM7(suijiInvokerForgeDamageHandle)
call OZ7(suijiInvokerForgeDamageTrigger)
set suijiInvokerForgeDamageTrigger=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId!=EVENT_UNIT_DAMAGED then
call NM7(suijiInvokerForgeDamageHandle)
call OZ7(suijiInvokerForgeDamageTrigger)
set suijiInvokerForgeDamageTrigger=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if GetUnitAbilityLevel(b1060GetTriggerUnit,'B091')>0 and GetUnitAbilityLevel(b1060GetEventDamageSource,'A0VV')>0 and O77(suijiInvokerForgeDamageHandle,"Source")==b1060GetEventDamageSource then
call UnitRemoveAbility(b1060GetTriggerUnit,'B091')
call DisableTrigger(suijiInvokerForgeDamageTrigger)
call UXF(b1060GetTriggerUnit)
call NM7(suijiInvokerForgeDamageHandle)
call OZ7(suijiInvokerForgeDamageTrigger)
endif
set suijiInvokerForgeDamageTrigger=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function UZF takes nothing returns nothing
local trigger t
local unit m5
local unit p5
if GetTriggerEventId()==EVENT_UNIT_SPELL_EFFECT then
set m5=GetSpellTargetUnit()
set p5=GetTriggerUnit()
else
set m5=GetTriggerUnit()
set p5=GetAttacker()
endif
if B1023HitLive(p5) and B1023HitLive(m5) and IsUnitIllusion(p5)==false then
set t=CreateTrigger()
call NT7(GetHandleId(t),"Source",p5)
call B1023RegisterDamage(t,m5)
call TriggerRegisterUnitEvent(t,m5,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,2.,false)
call TriggerAddCondition(t,Condition(function UYF))
endif
set t=null
set m5=null
set p5=null
endfunction
function UAF takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetAttacker=B1060EventAttacker()
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local boolean b1060ReturnValue
if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
call NM7(GetHandleId(b1060GetTriggeringTrigger))
call OZ7(b1060GetTriggeringTrigger)
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_ATTACKED then
if GetUnitAbilityLevel(b1060GetAttacker,'A0VV')>0 and OO7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn") and IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_STRUCTURE)==false and b1060GetAttacker==O77(GetHandleId(b1060GetTriggeringTrigger),"Source") then
call UZF()
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER then
if(b1060GetIssuedOrderId==$D011F)then
call NS7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn",true)
elseif(b1060GetIssuedOrderId==$D0120)then
call NS7(GetHandleId(b1060GetTriggeringTrigger),"OrbOn",false)
endif
elseif b1060GetTriggerEventId==EVENT_UNIT_SPELL_EFFECT and b1060B287_GetSpellAbilityId=='A0VV' then
call UZF()
endif
set b1060ReturnValue=false
set b1060GetAttacker=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
set b1060GetTriggeringTrigger=null
return b1060ReturnValue
endfunction
function UBF takes unit p5 returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_ISSUED_ORDER)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function UAF))
call NT7(GetHandleId(t),"Source",p5)
call NS7(GetHandleId(t),"OrbOn",true)
set t=null
endfunction
