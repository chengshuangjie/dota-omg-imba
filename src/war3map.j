function BHT2 takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local integer V77=B287_GetUnitAbilityLevel(WI7,'A0LN')+GetUnitAbilityLevel(WI7,'A4F0')+Labike_Multiple_Skill_Level(WI7,'A0LN')
//local real in=300+100*V77
local real in=(300+50*V77)*B290_GetDisplacementMulticastCount(WI7,B287_GetSpellAbilityId())
local real RK=GetUnitFacing(WI7)
local real iN=GetUnitX(WI7)
local real io=GetUnitY(WI7)
local real hN=X17(iN+in*Cos(RK*bj_DEGTORAD))
local real ho=X07(io+in*Sin(RK*bj_DEGTORAD))
local timer t=CreateTimer()
local integer I97=GetHandleId(t)
local trigger uT=OE7(GetHandleId(WI7),"Trigger_TrackOrder")
local integer OB7=Get_Multiple_Skill_Key(WI7,'A0LN')
local integer N5E=(LoadInteger(MSK,(OB7),(30)))
local real WF8
local integer skill=(LoadInteger(MSK,(OB7),(N5E)))
local integer id=GetUnitTypeId(WI7)
if N5E>0 then
if id=='Z01V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n7s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
call YS7("model\\hero_priestessofthemoon_n7s_e_start.mdx",WI7,"chest",3)
elseif id=='Z11V' then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_PotM(1)_E2.mdl",GetUnitX(WI7),GetUnitY(WI7)))
call YS7("AZModel\\AZ_PotM(1)_E1.mdl",WI7,"chest",1)
call YS7("AZModel\\AZ_PotM(1)_E1.mdl",WI7,"left,foot",1)
call YS7("AZModel\\AZ_PotM(1)_E1.mdl",WI7,"right,foot",1)
elseif id=='Z21V' then
call DestroyEffect(AddSpecialEffect("AZModel\\AZ_PotMpink_E2.mdl",GetUnitX(WI7),GetUnitY(WI7)))
call YS7("AZModel\\AZ_PotMpink_E1.mdl",WI7,"chest",1)
call YS7("AZModel\\AZ_PotMpink_E1.mdl",WI7,"left,foot",1)
call YS7("AZModel\\AZ_PotMpink_E1.mdl",WI7,"right,foot",1)
elseif id=='Z31V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n4s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
//call YS7("model\\hero_priestessofthemoon_n4s_e_start.mdl",WI7,"chest",3)
call YS7("model\\hero_priestessofthemoon_n4s_e_start.mdl",WI7,"chest",1)
call YS7("model\\hero_priestessofthemoon_n4s_e_start.mdl",WI7,"left,foot",1)
call YS7("model\\hero_priestessofthemoon_n4s_e_start.mdl",WI7,"right,foot",1)
elseif id=='Z41V' then
call DestroyEffect(AddSpecialEffect("model\\hero_priestessofthemoon_n5s_e_finish.mdl",GetUnitX(WI7),GetUnitY(WI7)))
//call YS7("model\\hero_priestessofthemoon_n5s_e_start.mdx",WI7,"chest",3)
call YS7("model\\hero_priestessofthemoon_n5s_e_start.mdl",WI7,"chest",1)
call YS7("model\\hero_priestessofthemoon_n5s_e_start.mdl",WI7,"left,foot",1)
call YS7("model\\hero_priestessofthemoon_n5s_e_start.mdl",WI7,"right,foot",1)
endif
set in=SquareRoot((iN-hN)*(iN-hN)+(io-ho)*(io-ho))
if in>100 then
call XF7(WI7,'Amrf')
call UnitRemoveAbility(WI7,'Amrf')
call SetUnitPathing(WI7,false)
call SetUnitAnimationByIndex(WI7,6)
call DisableTrigger(uT)
call B947IssueImmediateOrderById("BHT2 @ war3map.j:79230 (B968)",WI7,$D0004)
call EnableTrigger(uT)
call NQ7(I97,"DistanceRemaining",in)
call NQ7(I97,"OriginalDistance",in)
call NQ7(I97,"Angle",RK)
call NT7(I97,"Hero",WI7)
call NP7(I97,"ID",id)
call TimerStart(t,.025,true,function uQ)
call NS7(GetHandleId(WI7),"Leap_InAir",true)
call NS7(GetHandleId(WI7),"SuperOrder",false)
endif
call UnitRemoveAbility(WI7,skill)
set N5E=N5E-1
call SaveInteger(MSK,(OB7),(30),(N5E))
set skill=(LoadInteger(MSK,(OB7),(N5E)))
if SuijiMode_EnsureExactLiveAbilityLevel(WI7,skill,V77,true) then
call Multiple_Skill_SyncButton(WI7,skill)
call Reset_Skill_range(WI7)
endif
else
call X377(GetOwningPlayer(WI7),"无可用次数")
endif
if N5E==0 then
set WF8=(LoadReal(MSK,(OB7),(50)))
if WF8>0 then
call Multiple_Skill_StartZeroCooldown(WI7,skill,WF8)
endif
endif
set WI7=null
set t=null
set uT=null
endfunction
