function LASER_TRI takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local boolean HaveA = LoadBoolean(TABLE_HY, h, 11)
	local real d
	set d =level*80
    call B67(ZX7, IH7, 3, d)
	if HaveA and UnitAlive(IH7) then
		call B67(ZX7, IH7, 3, GetUnitState(IH7,UNIT_STATE_LIFE)*.1)
	endif
    call Z57(IH7,'A4J5',1,2.5+0.5*level,'B02P')
    if B287_GetUnitAbilityLevel(ZX7,'A049')>0 then
        call LINGXIA(ZX7,IH7)
    endif
	set ZX7 = null
	set IH7 = null
endfunction
function LASER_RANGE2 takes nothing returns nothing
    local unit ZX7=IN4
    local unit IH7=IP4
    local unit m5=GetEnumUnit()
    local trigger t
    local integer level=AL4
    if WQ7(m5)==false then
        set t=NHX_TANSHE(ZX7, IH7, m5,'h0HH', "LASER_TRI",2000, true, "war3mapImported\\laser.MDX")
        call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
        call SaveBoolean(TABLE_HY, GetHandleId(t), 11, SUIJI_TINKER_LASER_AGH)
    else
        call PLK(m5)
    endif
    set t=null
    set ZX7=null
    set IH7=null
    set m5=null
endfunction
// B1092: guidance bounces to eligible creeps as well as heroes.
function B1092LaserBounceFilter takes nothing returns boolean
local unit laserBounce1092=GetFilterUnit()
local boolean laserAllowed1092=WF7(laserBounce1092)==false and IsUnitEnemy(IN4,GetOwningPlayer(laserBounce1092)) and (AK7(laserBounce1092)==false or IsUnitVisible(laserBounce1092,GetOwningPlayer(IN4))) and GetUnitAbilityLevel(laserBounce1092,'A04R')==0 and IsUnitType(laserBounce1092,UNIT_TYPE_STRUCTURE)==false and XH7(laserBounce1092)==false and (IsUnitType(laserBounce1092,UNIT_TYPE_ANCIENT)==false or Z_7(laserBounce1092))
set laserBounce1092=null
return laserAllowed1092
endfunction
function LASER_RANGE takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local integer guidance = B287_GetUnitAbilityLevel(ZX7,'A0BQ')
	local boolean HaveA = LoadBoolean(TABLE_HY, h, 11)
	local real range
	local real d
    local group g=WS7()
	set d =level*80
    call B67(ZX7, IH7, 3, d)
	if HaveA and UnitAlive(IH7) then
		call B67(ZX7, IH7, 3, GetUnitState(IH7,UNIT_STATE_LIFE)*.1)
	endif
    call Z57(IH7,'A4J5',1,2.5+0.5*level,'B02P')
    if guidance>0 then
        set range=150+100*guidance
        set AL4=level
        set IN4=ZX7
        set IP4=IH7
        set SUIJI_TINKER_LASER_AGH=HaveA
        call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),range,Condition(function B1092LaserBounceFilter))
        call GroupRemoveUnit(g,IH7)
        call ForGroup(g,function LASER_RANGE2)
    endif
    call WR7(g)
    call LINGXIA(ZX7,IH7)
    set g = null
	set ZX7 = null
	set IH7 = null
endfunction
function KBD takes nothing returns nothing
    local unit ZX7=GetTriggerUnit()
    local unit IH7=GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
    local integer guidance=B287_GetUnitAbilityLevel(ZX7,'A0BQ')
    local boolean HaveA=SuijiMode_TinkerLaserHasScepter(ZX7)
    local trigger t
    if HaveA or guidance>0 then
        set t=NHX(ZX7, IH7,'h0HH', "LASER_RANGE",2000, true, "war3mapImported\\laser.MDX")
    else
        set t=NHX(ZX7, IH7,'h0HH', "LASER_TRI",2000, true, "war3mapImported\\laser.MDX")
    endif
    call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
    call SaveBoolean(TABLE_HY, GetHandleId(t), 11, HaveA)
    call EnableAttackEffectByTime(14, 3.5 + level*.5)
    set ZX7=null
    set IH7=null
    set t=null
endfunction
function KAD takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A049' or B287_GetSpellAbilityId()=='A2UR') and WQ7(GetSpellTargetUnit())==false then
        call KBD()
