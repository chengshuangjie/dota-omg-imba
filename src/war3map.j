call SetUnitVertexColor(WX7,$FF,$FF,$FF,$FF)
endif
call OX7(WX7,"TimeWalk|Active")
endif
set t=null
set WX7=null
set BB7=null
set g=null
set BQ9=null
return false
endfunction
