set s=GetUnitName(GetTriggerUnit())+" "+GetObjectName('n0HB')+" "+GetObjectName(B287_GetLearnedSkill())+" ("+GetObjectName('n0HC')+" "+I2S(GetUnitAbilityLevel(GetTriggerUnit(),B287_GetLearnedSkill()))+")"
call DisplayTimedTextToPlayer(KX4,0,0,3,s)
call DisplayTimedTextToPlayer(KY4,0,0,3,s)
endif
return false
endfunction
function D48 takes nothing returns nothing
