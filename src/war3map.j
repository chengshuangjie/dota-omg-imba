function YAD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit ZZ9=(LoadUnitHandle(L7,(V07),(17)))
//call UnitRemoveAbility(ZZ9,1093751094)
if ZZ9!=null and GetUnitTypeId(ZZ9)!=0 then
call UnitRemoveAbility(ZZ9,'A1Q5')
call UnitRemoveAbility(ZZ9,'B0CX')
endif
call FlushChildHashtable(L7,(V07))
call OZ7(t)
set t=null
set ZZ9=null
return false
endfunction
function YBD takes unit Z69,unit ZZ9,integer KP7,integer suijiSkewerMulticastCount returns nothing
local trigger t=null
local integer V07=0
if Z69==null or ZZ9==null or GetUnitTypeId(Z69)==0 or GetUnitTypeId(ZZ9)==0 then
return
endif
if suijiSkewerMulticastCount<1 then
set suijiSkewerMulticastCount=1
endif
set t=CreateTrigger()
set V07=GetHandleId(t)
if GetUnitAbilityLevel(ZZ9,'B0J5')==0 then
call SetUnitPathing(ZZ9,true)
endif
call TriggerRegisterTimerEvent(t,2.5,false)
call TriggerRegisterUnitEvent(t,ZZ9,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function YAD))
call SaveUnitHandle(L7,(V07),(17),(ZZ9))
call XF7(ZZ9,'A1Q5')
// call XF7(ZZ9,1093751094)
// call UnitMakeAbilityPermanent(ZZ9,true,1093751094)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZZ9),1093751094,false)
// call XF7(ZZ9,1093751094)
// call UnitMakeAbilityPermanent(ZZ9,true,1093751094)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZZ9),1093751094,false)
// call XF7(ZZ9,1093751094)
// call UnitMakeAbilityPermanent(ZZ9,true,1093751094)
// call SetPlayerAbilityAvailable(GetOwningPlayer(ZZ9),1093751094,false)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl",ZZ9,"chest"))
call B67(Z69,ZZ9,1,(40+60*KP7)*suijiSkewerMulticastCount)
if IS_AI(Z69) and IS_HUMAN(ZZ9) and GetRandomInt(1,2)==1 and AI_Send_Msg then
	call Send_Chat_Text(GetOwningPlayer(Z69),Get_Skill_Text(GetOwningPlayer(Z69),"MengMaD"))
	set AI_Send_Msg=false
endif
set t=null
endfunction
function YCD takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer V07=GetHandleId(t)
local unit Z69=(LoadUnitHandle(L7,(V07),(2)))
local unit Y3D=(LoadUnitHandle(L7,(V07),(393)))
local unit Y6D=(LoadUnitHandle(L7,(V07),(394)))
local unit YLD=(LoadUnitHandle(L7,(V07),(395)))
local unit Y1D=(LoadUnitHandle(L7,(V07),(396)))
local unit AY1D=(LoadUnitHandle(L7,(V07),(397)))
local integer KP7=(LoadInteger(L7,(V07),(5)))
local integer suijiSkewerMaxTargets=(LoadInteger(L7,(V07),(8)))
local integer suijiSkewerMulticastCount=(LoadInteger(L7,(V07),(9)))
local real Y0D=(LoadReal(L7,(V07),(47)))
local real Y5D=(LoadReal(L7,(V07),(48)))
local real Y2D=(LoadReal(L7,(V07),($D)))
local real Y_D=(LoadReal(L7,(V07),(6)))
local real Z4D=(LoadReal(L7,(V07),(7)))
local real speed=(LoadReal(L7,(V07),(1)))
local real Z7D=X57(Y_D+speed*Cos(Y2D))
local real Z8D=X27(Z4D+speed*Sin(Y2D))
local group g
local integer Z9D=(LoadInteger(L7,(V07),($C)))
local location l
// call SetUnitPosition(Z69,Z7D,Z8D)
// call SetUnitFacing(Z69,Y2D*bj_RADTODEG)
// call SetUnitPosition(Z69,Z7D,Z8D)
// call SetUnitFacing(Z69,Y2D*bj_RADTODEG)
// call SetUnitPosition(Z69,Z7D,Z8D)
// call SetUnitFacing(Z69,Y2D*bj_RADTODEG)
if Z69==null or GetUnitTypeId(Z69)==0 then
call DestroyEffect((LoadEffectHandle(L7,(V07),($AF))))
if Y3D!=null and GetUnitTypeId(Y3D)!=0 then
call SetUnitPathing(Y3D,true)
endif
if Y6D!=null and GetUnitTypeId(Y6D)!=0 then
call SetUnitPathing(Y6D,true)
endif
if YLD!=null and GetUnitTypeId(YLD)!=0 then
call SetUnitPathing(YLD,true)
endif
if Y1D!=null and GetUnitTypeId(Y1D)!=0 then
call SetUnitPathing(Y1D,true)
endif
if AY1D!=null and GetUnitTypeId(AY1D)!=0 then
call SetUnitPathing(AY1D,true)
endif
call FlushChildHashtable(L7,(V07))
call OZ7(t)
set t=null
set Z69=null
set Y3D=null
set Y6D=null
set YLD=null
set Y1D=null
set AY1D=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
call SetUnitX(Z69,Z7D)
call SetUnitY(Z69,Z8D)
call MHUnit_SetFacing(Z69,Y2D*bj_RADTODEG,true)
call SaveReal(L7,(V07),(6),((Z7D)*1.))
call SaveReal(L7,(V07),(7),((Z8D)*1.))
if ModuloInteger(GetTriggerEvalCount(t),4)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",Z7D,Z8D))
endif
if GetTriggerEvalCount(t)==2 then
call SetUnitAnimationByIndex(Z69,3)
endif
if Y3D==null or Y6D==null or YLD==null or Y1D==null or AY1D==null then
set IN4=Z69
set g=WS7()
call GroupEnumUnitsInRange(g,Z7D,Z8D,150+25,Condition(function A37))
if FirstOfGroup(g)!=null then
if Y3D!=null then
call GroupRemoveUnit(g,Y3D)
endif
if Y6D!=null then
call GroupRemoveUnit(g,Y6D)
endif
if YLD!=null then
call GroupRemoveUnit(g,YLD)
endif
if Y1D!=null then
call GroupRemoveUnit(g,Y1D)
endif
if FirstOfGroup(g)!=null then
if Y3D==null then
set Y3D=FirstOfGroup(g)
call SetUnitPathing(Y3D,false)
call O37(Y3D,"4404",5)
elseif Y6D==null and suijiSkewerMaxTargets>1 then
set Y6D=FirstOfGroup(g)
call SetUnitPathing(Y6D,false)
call O37(Y6D,"4404",5)
elseif YLD==null and suijiSkewerMaxTargets>2 then
set YLD=FirstOfGroup(g)
call SetUnitPathing(YLD,false)
call O37(YLD,"4404",5)
elseif Y1D==null and suijiSkewerMaxTargets>3 then
set Y1D=FirstOfGroup(g)
call SetUnitPathing(Y1D,false)
call O37(Y1D,"4404",5)
elseif AY1D==null and suijiSkewerMaxTargets>4 then
set AY1D=FirstOfGroup(g)
call SetUnitPathing(AY1D,false)
call O37(AY1D,"4404",5)
endif
endif
endif
call WR7(g)
set g=null
endif
call SaveUnitHandle(L7,(V07),(393),(Y3D))
call SaveUnitHandle(L7,(V07),(394),(Y6D))
call SaveUnitHandle(L7,(V07),(395),(YLD))
call SaveUnitHandle(L7,(V07),(396),(Y1D))
call SaveUnitHandle(L7,(V07),(397),(AY1D))
if Y3D!=null then
call SetUnitPosition(Y3D,Z7D,Z8D)
endif
if Y6D!=null then
call SetUnitPosition(Y6D,Z7D,Z8D)
endif
if YLD!=null then
call SetUnitPosition(YLD,Z7D,Z8D)
endif
if Y1D!=null then
call SetUnitPosition(Y1D,Z7D,Z8D)
endif
if AY1D!=null then
call SetUnitPosition(AY1D,Z7D,Z8D)
endif
if ModuloInteger(GetTriggerEvalCount(t),3)==0 then
call Y67(Z7D,Z8D,$C8)
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>Z9D then
call DestroyEffect((LoadEffectHandle(L7,(V07),($AF))))
call SetUnitAnimationByIndex(Z69,0)
call SetUnitTimeScale(Z69,1.)
//call SetUnitPathing(Z69,true)
call SetUnitPhaseMove(Z69,false)
if GetUnitTypeId(Z69)=='UC11' and SuijiMode_HasAghanimState(Z69) then
call UnitRemoveAbility(Z69,'A4CK')
call XF7(Z69,'A4CK')
endif
if TZ7(GetOwningPlayer(Z69)) then
call OX7(Z69,"AI|MMCC")
endif
call FlushChildHashtable(L7,(V07))
call OZ7(t)
set AI_Send_Msg=true
if Y3D!=null then
if IsPointInRegion(IU4,GetUnitX(Y3D),GetUnitY(Y3D)) then
set l=YV8(GetUnitX(Y3D),GetUnitY(Y3D))
call SetUnitX(Y3D,X57(GetLocationX(l)))
call SetUnitY(Y3D,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
call YBD(Z69,Y3D,KP7,suijiSkewerMulticastCount)
call Y67(GetUnitX(Y3D),GetUnitY(Y3D),300)
endif
if Y6D!=null then
if IsPointInRegion(IU4,GetUnitX(Y6D),GetUnitY(Y6D)) then
set l=YV8(GetUnitX(Y6D),GetUnitY(Y6D))
call SetUnitX(Y6D,X57(GetLocationX(l)))
call SetUnitY(Y6D,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
call YBD(Z69,Y6D,KP7,suijiSkewerMulticastCount)
call Y67(GetUnitX(Y6D),GetUnitY(Y6D),300)
endif
if YLD!=null then
if IsPointInRegion(IU4,GetUnitX(YLD),GetUnitY(YLD)) then
set l=YV8(GetUnitX(YLD),GetUnitY(YLD))
call SetUnitX(YLD,X57(GetLocationX(l)))
call SetUnitY(YLD,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
call YBD(Z69,YLD,KP7,suijiSkewerMulticastCount)
call Y67(GetUnitX(YLD),GetUnitY(YLD),300)
endif
if Y1D!=null then
if IsPointInRegion(IU4,GetUnitX(Y1D),GetUnitY(Y1D)) then
set l=YV8(GetUnitX(Y1D),GetUnitY(Y1D))
call SetUnitX(Y1D,X57(GetLocationX(l)))
call SetUnitY(Y1D,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
call YBD(Z69,Y1D,KP7,suijiSkewerMulticastCount)
call Y67(GetUnitX(Y1D),GetUnitY(Y1D),300)
endif
if AY1D!=null then
if IsPointInRegion(IU4,GetUnitX(AY1D),GetUnitY(AY1D)) then
set l=YV8(GetUnitX(AY1D),GetUnitY(AY1D))
call SetUnitX(AY1D,X57(GetLocationX(l)))
call SetUnitY(AY1D,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
call YBD(Z69,AY1D,KP7,suijiSkewerMulticastCount)
call Y67(GetUnitX(AY1D),GetUnitY(AY1D),300)
endif
set AI_Send_Msg=false
if Y3D!=null and XH7(Y3D)==false then
call B947IssueTargetOrderById("YCD @ war3map.j:98516 (B968)",Z69,$D000F,Y3D)
elseif Y6D!=null and XH7(Y6D)==false then
call B947IssueTargetOrderById("YCD @ war3map.j:98518 (B968)",Z69,$D000F,Y6D)
elseif YLD!=null and XH7(YLD)==false then
call B947IssueTargetOrderById("YCD @ war3map.j:98520 (B968)",Z69,$D000F,YLD)
elseif Y1D!=null and XH7(Y1D)==false then
call B947IssueTargetOrderById("YCD @ war3map.j:98522 (B968)",Z69,$D000F,Y1D)
elseif AY1D!=null and XH7(AY1D)==false then
call B947IssueTargetOrderById("YCD @ war3map.j:98524 (B968)",Z69,$D000F,AY1D)
endif
call Y67(Z7D,Z8D,375)
if IsPointInRegion(IU4,GetUnitX(Z69),GetUnitY(Z69)) then
set l=YV8(GetUnitX(Z69),GetUnitY(Z69))
call SetUnitX(Z69,X57(GetLocationX(l)))
call SetUnitY(Z69,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
endif
set t=null
set Z69=null
set Y3D=null
set Y6D=null
set YLD=null
set Y1D=null
set AY1D=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ZDD takes nothing returns nothing
local trigger t=null
local integer V07=0
local real Y0D=X57(GetSpellTargetX())
local real Y5D=X27(GetSpellTargetY())
local unit Z69=GetTriggerUnit()
local real QHD=0.
local real ZED=0.
local integer skill=B287_GetSpellAbilityId()
local integer KP7=0
local integer suijiSkewerMulticastCount=1
local integer suijiSkewerMaxTargets=1
local real a=0.
local real ZFD=0.
local real speed
local integer id=0
local string tx
if Z69==null or GetUnitTypeId(Z69)==0 then
set Z69=null
return
endif
set t=CreateTrigger()
set V07=GetHandleId(t)
set QHD=GetUnitX(Z69)
set ZED=GetUnitY(Z69)
set KP7=B287_GetUnitAbilityLevel(Z69,skill)
if SUIJI_MODE and OO7(GetHandleId(Z69),"SuijiDone") and B287_GetUnitAbilityLevel(Z69,'A088')>0 and (GetUnitTypeId(Z69)=='Hmkg' or OO7(GetHandleId(Z69),"SuijiMulticast")) then
// The 16-platform Skewer merges Multicast into the one active displacement
// controller instead of issuing another movement order.  Keep every other
// displacement skill on B290's disabled-by-default path, but let Skewer roll
// once here and reuse its already bounded distance/target/damage multipliers.
set suijiSkewerMulticastCount=EUD(Z69)
if suijiSkewerMulticastCount<2 then
set suijiSkewerMulticastCount=1
elseif suijiSkewerMulticastCount==2 then
call YW7(GetObjectName('n0K7'),5,Z69,.03,255,0,0,255)
elseif suijiSkewerMulticastCount==3 then
call YW7(GetObjectName('n0JT'),5,Z69,.03,255,0,0,255)
elseif suijiSkewerMulticastCount==4 then
call YW7(GetObjectName('n0K8'),5,Z69,.03,255,0,0,255)
elseif suijiSkewerMulticastCount==5 then
call YW7(GetObjectName('n0JO'),5,Z69,.03,255,0,0,255)
endif
endif
set suijiSkewerMaxTargets=KP7+suijiSkewerMulticastCount-1
if SuijiMode_ScepterRegistryIsActive(Z69,'A1RD') and B287_GetUnitAbilityLevel(Z69,'A1RD')==4 then
set suijiSkewerMaxTargets=suijiSkewerMaxTargets+1
endif
if suijiSkewerMaxTargets>5 then
set suijiSkewerMaxTargets=5
endif
set a=J77(QHD,ZED,Y0D,Y5D)*bj_DEGTORAD
set ZFD=(800+200*KP7+25)*suijiSkewerMulticastCount
set id=GetUnitTypeId(Z69)
if SPEPLAYER[GetPlayerId(GetOwningPlayer(Z69))]==1 and ISLABIKE(Z69) then
    call YW7("我才是猛犸！",5,Z69,.03,$FF,$FF,0,$FF)
endif
if id=='UC11' or id=='ZC11' or id=='ZC12' then
    if SuijiMode_ScepterRegistryIsActive(Z69,'A1RD') then
        if B287_MHAbility_GetCastpoint(Z69,'A1RD')!=.15 then
        call B287_MHAbility_SetCastpoint(Z69,'A1RD',.15)
        endif
    else
        if B287_MHAbility_GetCastpoint(Z69,'A1RD')!=.3 and GetUnitAbilityLevel(Z69,'A2YR')==0 then
            call B287_MHAbility_SetCastpoint(Z69,'A1RD',.3)
        endif     
    endif
endif  
if id=='ZC11' then
    set tx="model\\Hero_Magnataur_N4S_D_Source.mdl"
elseif id=='ZC12' then
    set tx="model\\Hero_Magnataur_N1S_D_Source.mdl"
else
    set tx="war3mapImported\\SkewerTuskGlow_1.mdx"
endif
// AI normally orders Skewer on an enemy hero within roughly 800 range, so the
// selected point itself never consumes B768's Multicast distance multiplier.
// Once the actual roll is known, keep that enemy on the same line but extend
// only computer/leave-AI casts to the full bounded distance for this roll.
if suijiSkewerMulticastCount>1 and (GetPlayerController(GetOwningPlayer(Z69))==MAP_CONTROL_COMPUTER or KKLeaveAI_Active[GetPlayerId(GetOwningPlayer(Z69))]) and KF7(QHD,ZED,Y0D,Y5D)>1. then
set Y0D=X57(QHD+ZFD*Cos(a))
set Y5D=X27(ZED+ZFD*Sin(a))
elseif KF7(QHD,ZED,Y0D,Y5D)>ZFD then
set Y0D=X57(QHD+ZFD*Cos(a))
set Y5D=X27(ZED+ZFD*Sin(a))
endif
//call SetUnitPathing(Z69,false)
call SetUnitPhaseMove(Z69,true)
call SetUnitAnimationByIndex(Z69,3)
call SetUnitTimeScale(Z69,1.5)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,Z69,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function YCD))
call SaveUnitHandle(L7,(V07),(2),(Z69))
call SaveInteger(L7,(V07),(5),(KP7))
call SaveInteger(L7,(V07),(8),(suijiSkewerMaxTargets))
call SaveInteger(L7,(V07),(9),(suijiSkewerMulticastCount))
call SaveUnitHandle(L7,(V07),(393),(null))
call SaveUnitHandle(L7,(V07),(394),(null))
call SaveUnitHandle(L7,(V07),(395),(null))
call SaveUnitHandle(L7,(V07),(396),(null))
call SaveUnitHandle(L7,(V07),(397),(null))
call SaveReal(L7,(V07),(47),((Y0D)*1.))
call SaveReal(L7,(V07),(48),((Y5D)*1.))
call SaveReal(L7,(V07),(6),((QHD)*1.))
call SaveReal(L7,(V07),(7),((ZED)*1.))
call SaveReal(L7,(V07),($D),((Atan2(Y5D-ZED,Y0D-QHD))*1.))
if SuijiMode_HasAghanimState(Z69) then
set speed=24.
else
set speed=19.
endif
call SaveInteger(L7,(V07),($C),(R2I(KF7(QHD,ZED,Y0D,Y5D)/speed)))
call SaveReal(L7,(V07),(1),(speed))
call SaveEffectHandle(L7,(V07),($AF),(AddSpecialEffectTarget(tx,Z69,"head")))
if TZ7(GetOwningPlayer(Z69)) then
call OV7(Z69,"AI|MMCC")
endif
set t=null
set Z69=null
endfunction
function ZGD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1RD' or B287_GetSpellAbilityId()=='A3RD' then
call ZDD()
endif
return false
endfunction
function ZHD takes nothing returns boolean
local unit suijiMagnusSkewerCaster=GetTriggerUnit()
if (B287_GetSpellAbilityId()=='A1RD' or B287_GetSpellAbilityId()=='A3RD') and suijiMagnusSkewerCaster!=null and GetUnitTypeId(suijiMagnusSkewerCaster)!=0 then
call SetUnitAnimationByIndex(suijiMagnusSkewerCaster,7)
endif
set suijiMagnusSkewerCaster=null
return false
endfunction
function HC8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ZGD))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(t,Condition(function ZHD))
set t=null
endfunction
function SuijiMode_ClearScriptedSplitShot takes unit u returns nothing
if u==null then
return
endif
call UnitRemoveAbility(u,'A1ET')
call UnitRemoveAbility(u,'A1ES')
call UnitRemoveAbility(u,'A1EQ')
call UnitRemoveAbility(u,'A1ER')
call UnitRemoveAbility(u,'A2OT')
call UnitRemoveAbility(u,'A2OU')
call UnitRemoveAbility(u,'A2OV')
call UnitRemoveAbility(u,'A23F')
call NS7(GetHandleId(u),"SuijiScriptedSplitShot",false)
endfunction
function SuijiMode_ToggleScriptedSplitShot takes unit u returns nothing
local integer h=0
local integer level=0
local integer firstSkill=0
local integer secondSkill=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
if OO7(h,"SuijiScriptedSplitShot") then
call SuijiMode_ClearScriptedSplitShot(u)
return
endif
set level=GetUnitAbilityLevel(u,'Y08Z')
if level<1 then
return
elseif level>4 then
set level=4
endif
if level==1 then
set firstSkill='A1ET'
set secondSkill='A2OT'
elseif level==2 then
set firstSkill='A1ES'
set secondSkill='A2OU'
elseif level==3 then
set firstSkill='A1EQ'
set secondSkill='A2OV'
else
set firstSkill='A1ER'
set secondSkill='A23F'
endif
call XF7(u,firstSkill)
call UnitMakeAbilityPermanent(u,true,firstSkill)
call XF7(u,secondSkill)
call UnitMakeAbilityPermanent(u,true,secondSkill)
call NS7(h,"SuijiScriptedSplitShot",true)
endfunction
function ZID takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local integer b1060GetSpellAbilityId=GetSpellAbilityId()
local unit u=GetTriggerUnit()
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH then
if u!=null and OO7(GetHandleId(u),"SuijiScriptedSplitShot") then
call SuijiMode_ClearScriptedSplitShot(u)
endif
set u=null
return false
endif
if b1060B287_GetSpellAbilityId=='A1C0' then
if b1060GetSpellAbilityId=='Y08Z' then
call SuijiMode_ToggleScriptedSplitShot(u)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1ET',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1ES',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1EQ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1ER',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2OT',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2OU',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A2OV',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23F',false)
endif
set u=null
return false
endfunction
function H38 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ZID))
set t=null
endfunction
function ZJD takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=LoadInteger(L7,(I97),(10))
local real d=0.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
// The caster can be removed by wheel replacement while the target still exists.
call DisableTrigger(t)
if IH7!=null and GetUnitTypeId(IH7)!=0 then
call PauseUnitEx(IH7,false)
call UnitRemoveAbility(IH7,'A2LD')
endif
call DestroyEffect((LoadEffectHandle(L7,(I97),(609))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(610))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(611))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(612))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(613))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(614))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(615))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(616))))
call DestroyEffect((LoadEffectHandle(L7,(I97),(617))))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
