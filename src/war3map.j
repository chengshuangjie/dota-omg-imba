function ATC5 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IH7=(LoadUnitHandle(L7,(OB7),(17)))
local unit BALL=(LoadUnitHandle(L7,(OB7),(45)))
local real Y_7=GetUnitX(IH7)
local real Z47=GetUnitY(IH7)
local real r=(LoadReal(L7,(OB7),(671)))
local real a=J77(GetUnitX(BALL),GetUnitY(BALL),Y_7,Z47)*bj_DEGTORAD
local real x=GetUnitX(BALL)+r*Cos(a)
local real y=GetUnitY(BALL)+r*Sin(a)
local group UGG=(LoadGroupHandle(L7,(OB7),(133)))
local group g
local integer WF8=(LoadInteger(L7,(OB7),(60)))
local real VWE=RMinBJ(2.5+(WF8*.05),$A)
local real UVG=225+40*(WF8*.02)
local integer ATD5=(LoadInteger(L7,(OB7),(34)))
if GetTriggerEventId()==EVENT_UNIT_ISSUED_POINT_ORDER then
    if GetIssuedOrderId()>= 852008 and GetIssuedOrderId()<= 852013 and Is_Use_TD(ZX7,GetIssuedOrderId()) then
        // call EXStopUnit(ZX7)
        call KR7(ZX7)
    endif
set t=null
set ZX7=null
set IH7=null
set BALL=null
set UGG=null
return false
endif
set WF8=WF8+1
call SaveInteger(L7,(OB7),(60),(WF8))
set XW4=ATD5
set XS4=GetUnitAbilityLevel(ZX7,'A1S7')
set IN4=ZX7
set XO4=UGG
set XP4=ZX7
set XQ4=IH7
set XR4=(LoadUnitHandle(L7,(OB7),(19)))
call SetUnitX(BALL,x)
call SetUnitY(BALL,y)
call SetUnitX(ZX7,x)
call SetUnitY(ZX7,y)
// call SetUnitScale(ZX7,0,0,0)
call SetUnitFacing(BALL,a*bj_RADTODEG-$B4)
call SetUnitScale(BALL,VWE,VWE,VWE)
set XT4=x
set XU4=y
call ForGroup((LoadGroupHandle(L7,(OB7),(22))),function ATB5)
if KF7(x,y,Y_7,Z47)<r*2 or WF8==150 then
    call Y67(x,y,300)
    set g=WS7()
    call GroupEnumUnitsInRange(g,x,y,UVG,Condition(function AJ7_gai))
    call ForGroup(g,function ATA5)
    call WR7(g)
    set g=null
    set XT4=x
    set XU4=y
    call ForGroup((LoadGroupHandle(L7,(OB7),(22))),function AT95)
    call WR7((LoadGroupHandle(L7,(OB7),(22))))
    call WR7(UGG)
    call KillUnit(BALL)
    call NM7(OB7)
    call OZ7(t)
    call SetUnitInvulnerable(ZX7,false)
    call UnitRemoveAbility(ZX7,'Abun')
    // call UnitRemoveAbility(ZX7,'A04R')
    call OX7(ZX7,"HideUnit")
    // call SetUnitScale(ZX7,XX7(ZX7),XX7(ZX7),XX7(ZX7))
    call UnitCancelHide(ZX7)
    if IsUnitSelected(ZX7,GetOwningPlayer(ZX7)) then
        call SelectUnitForPlayerSingle(ZX7,GetOwningPlayer(ZX7))
    endif
else
    if ModuloInteger(GetTriggerEvalCount(t),5)==0 then
        call Y67(x,y,300)
        set g=WS7()
        call GroupEnumUnitsInRange(g,x,y,UVG,Condition(function AJ7_gai))
        call ForGroup(g,function ATA5)
        call WR7(g)
        set g=null
    endif
endif
set t=null
set ZX7=null
set IH7=null
set BALL=null
set UGG=null
return false
endfunction
function ATE5 takes unit ZX7,group g,unit u returns nothing
if IsUnitInGroup(u,g)==false then
call GroupAddUnit(g,u)
call DestroyEffect(AddSpecialEffect("war3mapImported\\ChainFreeze_F6.mdx",GetUnitX(u),GetUnitY(u)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",GetUnitX(u),GetUnitY(u)))
if ZX7!=u then
call SetUnitX(u,GetUnitX(ZX7))
call SetUnitY(u,GetUnitY(ZX7))
// call SetUnitScale(u,0,0,0)
call OV7(u,"HideUnit")
// call ImprisonedUnit(u,true)
call UnitEnterHide(u)
call SetUnitInvulnerable(u,true)
call PauseUnitEx(u,true)
endif
if ZX7!=u then
set XW4=XW4+1
endif
endif
endfunction
function SuijiMode_SnowballButtonBegin takes unit u returns nothing
local integer h=0
local integer releaseButton=0
if u==null or GetUnitTypeId(u)==0 then
return
endif
set h=GetHandleId(u)
set releaseButton=SuijiMode_GetFixedTransientButton(u,'A1S7',0,'A4HF','ZT01','ZT02')
// Preserve B475's working state-first transition for native and random owners.
call SaveInteger(L7,h,StringHash("SuijiTuskSnowballActive"),1)
call SaveInteger(L7,h,StringHash("SuijiTuskSnowballReleaseButton"),releaseButton)
call SuijiMode_HideFixedTransientButtons(u,'A4HF','ZT01','ZT02',false)
if SuijiMode_EnsureFixedTransientButton(u,releaseButton)==false then
call RemoveSavedInteger(L7,h,StringHash("SuijiTuskSnowballActive"))
call RemoveSavedInteger(L7,h,StringHash("SuijiTuskSnowballReleaseButton"))
return
endif
call B287_SetUnitAbilityAvailable(u,'A1S7',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),releaseButton,true)
endfunction
function SuijiMode_SnowballButtonEnd takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call RemoveSavedInteger(L7,GetHandleId(u),StringHash("SuijiTuskSnowballActive"))
call RemoveSavedInteger(L7,GetHandleId(u),StringHash("SuijiTuskSnowballReleaseButton"))
call SuijiMode_HideFixedTransientButtons(u,'A4HF','ZT01','ZT02',true)
call B287_SetUnitAbilityAvailable(u,'A1S7',true)
endfunction
