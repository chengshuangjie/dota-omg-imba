endfunction
function LL9 takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit WI7=(b1061SavedGetTriggerUnit)
local real iN=GetUnitX(WI7)
local real io=GetUnitY(WI7)
local real hN=(b1061SavedGetSpellTargetX)
local real ho=(b1061SavedGetSpellTargetY)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local group Ro=WS7()
local integer JL7=GetPlayerId(GetOwningPlayer(WI7))
local integer level=B287_GetUnitAbilityLevel(WI7,'A0FN')
local boolean b=false
local real YM7
local integer LX9=GetHeroAgi(WI7,true)
local integer LY9=GetHeroStr(WI7,true)
local real DQD=I2R(LX9)/ I2R(LY9)
local real DRD=I2R(LY9)/ I2R(LX9)
local integer suijiDisplacementCount=B290_GetDisplacementMulticastCount(WI7,'A0FN')
set YM7=level*75+25
set BLXTHERO=0
set BLXTMODE=0
if SuijiMode_ScepterRegistryIsActive(WI7,'A0FN') then
    set b=true
    if DRD>1.5 then
        set BLXTMODE=1
    elseif DQD>1.5 then
        set BLXTMODE=2
        set YM7=YM7+LX9
    else
        set BLXTMODE=3
    endif
endif
// call UnitAddAbility(BO9,1093815860)
if (b1061SavedGetSpellTargetUnit)!=null then
set hN=GetUnitX((b1061SavedGetSpellTargetUnit))
set ho=GetUnitY((b1061SavedGetSpellTargetUnit))
endif
set hN=iN+(hN-iN)*suijiDisplacementCount
set ho=io+(ho-io)*suijiDisplacementCount
call SetUnitVertexColor(WI7,$FF,$FF,$FF,0)
call NS7(GetHandleId(WI7),"Waveforming",true)
call SetUnitInvulnerable(WI7,true)
call SetUnitPathing(WI7,false)
call NT7(OB7,"UnitVar",WI7)
call SaveReal(L7,(OB7),(23),((iN)*1.))
call SaveReal(L7,(OB7),(24),((io)*1.))
call SaveReal(L7,(OB7),(30),((YM7)*1.))
call NB7(OB7,"AlreadyDamaged",Ro)
call NQ7(OB7,"Angle",Atan2(ho-io,hN-iN))
call NP7(OB7,"Remaining",YH7(R2I(SquareRoot((hN-iN)*(hN-iN)+(ho-io)*(ho-io))/50),1))
// call NT7(OB7,"Dummy",BO9)
call NS7(OB7,"B",b)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function L69))
call ShowUnit(WI7,false)
call ShowUnit(WI7,true)
call SelectUnitAddForPlayer(WI7,GetOwningPlayer(WI7))
set t=null
set WI7=null
set Ro=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
