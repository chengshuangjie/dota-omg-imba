call ForGroup(g,function ZCXJ_DAMAGE)
call WR7(g)
call Y17(XUEJI_SOUND2,x,y)
call DestroyEffect(AddSpecialEffect(GXI,x,y))
call DestroyEffect(AddSpecialEffect(GXI,x,y+250))
call DestroyEffect(AddSpecialEffect(GXI,x,y-250))
call DestroyEffect(AddSpecialEffect(GXI,x+250,y))
call DestroyEffect(AddSpecialEffect(GXI,x-250,y))
call DestroyEffect(AddSpecialEffect(GXI,x+250,y+250))
call DestroyEffect(AddSpecialEffect(GXI,x-250,y-250))
call DestroyEffect(AddSpecialEffect(GXI,x+250,y-250))
call DestroyEffect(AddSpecialEffect(GXI,x-250,y+250))
