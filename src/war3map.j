set OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,$A+5*V77,false)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_SPELL_CAST)
call TriggerRegisterUnitEvent(t,p5,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function UL9))
call NT7(OB7,"Hero",p5)
call NV7(GetHandleId(p5),"ai|WWTrigger",t)
call XF7(p5,'A1J4')
call XF7(p5,'A1J3')
call XF7(p5,'A1J5')
call XF7(p5,'A1IU')
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1J4',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1J3',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1J5',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A1IU',false)
