call SetUnitY(u,y)
call SetUnitFlyHeight(u,160,0)
call SetUnitAnimationByIndex(u,i)
if r==0 or b1060GetTriggerEventId==EVENT_UNIT_DEATH or UnitAlive(HKI)==false then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
call ShowUnit(u,false)
call RemoveUnit(u)
endif
set t=null
set u=null
set HKI=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ShuangXiongTime takes unit HKI,real N2I returns nothing
local trigger t=null
local integer OB7=0
local unit u=null
local integer r=0
local integer g=0
local integer b=0
local integer a=0
if HKI==null or GetUnitTypeId(HKI)==0 then
set HKI=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set u=CreateUnit(GetOwningPlayer(HKI),'h0HP',GetUnitX(HKI),GetUnitY(HKI),bj_UNIT_FACING)
set r=KA4[GetPlayerId(GetOwningPlayer(HKI))]
set g=KB4[GetPlayerId(GetOwningPlayer(HKI))]
set b=KC4[GetPlayerId(GetOwningPlayer(HKI))]
if u==null or GetUnitTypeId(u)==0 then
call FlushChildHashtable(TABLE_XJ,(OB7))
call OZ7(t)
set HKI=null
set u=null
set t=null
return
endif
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(HKI)) or WG7(GetLocalPlayer())then
call SetUnitVertexColor(u,r,g,b,255)
else
call SetUnitVertexColor(u,r,g,b,a)
endif
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
call SetUnitFlyHeight(u,160,0)
call SetUnitAnimationByIndex(u,52)
call PauseUnit(u,true)
call SaveUnitHandle(TABLE_XJ,(OB7),(14),(HKI))
call SaveUnitHandle(TABLE_XJ,(OB7),(231),(u))
call SaveReal(TABLE_XJ,(OB7),(232),((N2I)*1.0))
call TriggerRegisterTimerEvent(t,0.05,true)
call TriggerRegisterUnitEvent(t,HKI,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function ShuangXiongTime2))
set u=null
set t=null
endfunction
// B956: called on both Tempest removal paths; idempotent and owner-local.
function B956MidasReleaseDouble takes unit double956 returns nothing
local integer owner956=GetHandleId(double956)
local timer recharge956=LoadTimerHandle(B852MidasTable,owner956,2)
local integer index956=1
if double956==null then
return
endif
if recharge956!=null then
call PauseTimer(recharge956)
call FlushChildHashtable(B852MidasTable,GetHandleId(recharge956))
call DestroyTimer(recharge956)
endif
call FlushChildHashtable(B852MidasTable,owner956)
loop
exitwhen index956>B852MidasItemCount
if LoadUnitHandle(B852MidasTable,GetHandleId(B852MidasItems[index956]),10)==double956 then
call RemoveSavedHandle(B852MidasTable,GetHandleId(B852MidasItems[index956]),10)
endif
set index956=index956+1
endloop
set recharge956=null
endfunction
function B1017TempestTrackItem takes unit b1017Double,item b1017Copy,integer b1017Slot returns nothing
call SaveItemHandle(L7,GetHandleId(b1017Double),StringHash("B1017TempestItem"+I2S(b1017Slot)),b1017Copy)
call SaveUnitHandle(L7,GetHandleId(b1017Copy),StringHash("B1017TempestOwner"),b1017Double)
call SetItemPawnable(b1017Copy,false)
call SetItemDroppable(b1017Copy,false)
call SetItemDropOnDeath(b1017Copy,false)
endfunction
function B1017TempestClearItems takes unit b1017Double returns nothing
local integer b1017Slot=0
local item b1017Copy=null
if b1017Double==null then
return
endif
loop
exitwhen b1017Slot>5
set b1017Copy=LoadItemHandle(L7,GetHandleId(b1017Double),StringHash("B1017TempestItem"+I2S(b1017Slot)))
call RemoveSavedHandle(L7,GetHandleId(b1017Double),StringHash("B1017TempestItem"+I2S(b1017Slot)))
if b1017Copy!=null then
call RemoveSavedHandle(L7,GetHandleId(b1017Copy),StringHash("B1017TempestOwner"))
if GetItemTypeId(b1017Copy)!=0 then
call RemoveItem(b1017Copy)
endif
endif
set b1017Slot=b1017Slot+1
endloop
set b1017Copy=null
endfunction
function B1017TempestRepairItems takes unit b1017Double returns nothing
local integer b1017Slot=0
local item b1017Copy=null
local boolean b1017PickupEnabled=false
if b1017Double==null then
return
endif
if GetUnitTypeId(b1017Double)==0 or not UnitAlive(b1017Double) then
call B1017TempestClearItems(b1017Double)
return
endif
if not DGFS(b1017Double) then
return
endif
set b1017PickupEnabled=IsTriggerEnabled(H94)
call DisableTrigger(H94)
if GetUnitAbilityLevel(b1017Double,'A2LZ')==0 then
call UnitAddAbility(b1017Double,'A2LZ')
call UnitMakeAbilityPermanent(b1017Double,true,'A2LZ')
endif
loop
exitwhen b1017Slot>5
set b1017Copy=LoadItemHandle(L7,GetHandleId(b1017Double),StringHash("B1017TempestItem"+I2S(b1017Slot)))
if b1017Copy!=null and GetItemTypeId(b1017Copy)!=0 and not UnitHasItem(b1017Double,b1017Copy) then
call SetItemPawnable(b1017Copy,false)
call SetItemDroppable(b1017Copy,false)
call SetItemDropOnDeath(b1017Copy,false)
call SetItemVisible(b1017Copy,true)
if not UnitAddItem(b1017Double,b1017Copy) then
// Keep displaced copies inaccessible until the existing lifetime tick retries.
call SetItemVisible(b1017Copy,false)
endif
endif
set b1017Slot=b1017Slot+1
endloop
if b1017PickupEnabled then
call EnableTrigger(H94)
endif
set b1017Copy=null
endfunction
function B1017TempestDropFinish takes nothing returns nothing
local timer b1017Timer=GetExpiredTimer()
local unit b1017Double=LoadUnitHandle(L7,GetHandleId(b1017Timer),0)
call RemoveSavedBoolean(L7,GetHandleId(b1017Double),StringHash("B1017TempestRepairQueued"))
call B1017TempestRepairItems(b1017Double)
call FlushChildHashtable(L7,GetHandleId(b1017Timer))
call PauseTimer(b1017Timer)
call DestroyTimer(b1017Timer)
set b1017Double=null
set b1017Timer=null
endfunction
function B1017TempestItemDrop takes nothing returns boolean
local item b1017Copy=GetManipulatedItem()
local unit b1017Double=LoadUnitHandle(L7,GetHandleId(b1017Copy),StringHash("B1017TempestOwner"))
local timer b1017Timer=null
if b1017Double!=null then
// Never add/remove inventory inside the engine's item-drop event stack.
call SetItemVisible(b1017Copy,false)
if not LoadBoolean(L7,GetHandleId(b1017Double),StringHash("B1017TempestRepairQueued")) then
call SaveBoolean(L7,GetHandleId(b1017Double),StringHash("B1017TempestRepairQueued"),true)
set b1017Timer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(b1017Timer),0,b1017Double)
call TimerStart(b1017Timer,0.,false,function B1017TempestDropFinish)
endif
endif
set b1017Copy=null
set b1017Double=null
set b1017Timer=null
return false
endfunction
function B1027TempestRemove takes unit retired1027 returns nothing
if retired1027==null then
return
endif
call B1017TempestClearItems(retired1027)
call B956MidasReleaseDouble(retired1027)
call B1027TempestReleaseListeners(retired1027)
set MiaoEntryUnit=retired1027
call ExecuteFunc("B1027MiaoRetireCurrent")
if GetUnitTypeId(retired1027)!=0 then
call RemoveUnit(retired1027)
endif
call FlushChildHashtable(L7,GetHandleId(retired1027))
endfunction
function APD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit AQD=(LoadUnitHandle(L7,(I97),(17)))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call B1027TempestRemove(AQD)
set t=null
set AQD=null
return false
endfunction
function ARD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit AQD=(LoadUnitHandle(L7,(I97),(2)))
call FlushChildHashtable(L7,(I97))
call OZ7(t)
// Keep per-double skill ownership until removal; death callbacks may still use it.
call ShowUnit(AQD,false)
set t=null
set AQD=null
return false
endfunction
function ASD takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit AQD=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=(LoadInteger(L7,(I97),(10)))
if AQD==null or GetUnitTypeId(AQD)==0 or ZX7==null or GetUnitTypeId(ZX7)==0 then
// Stop this owner before KillUnit can synchronously dispatch its death event.
call FlushChildHashtable(L7,I97)
call OZ7(t)
if AQD!=null and GetUnitTypeId(AQD)!=0 then
call B1017TempestClearItems(AQD)
call KillUnit(AQD)
endif
set t=null
set ZX7=null
set AQD=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if GetTriggerEvalCount(t)==(100+20*BC7) or b1060GetTriggerEventId==EVENT_WIDGET_DEATH or UnitAlive(AQD)==false then
call B1017TempestClearItems(AQD)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",GetUnitX(AQD),GetUnitY(AQD)))
call KillUnit(AQD)
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveUnitHandle(L7,(I97),(2),(AQD))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function ARD))
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,3,false)
call TriggerAddCondition(t,Condition(function APD))
call SaveUnitHandle(L7,(I97),(17),(AQD))
else
call B1017TempestRepairItems(AQD)
call SuspendHeroXP(AQD,true)
call UnitModifySkillPoints(AQD,-25)
endif
set t=null
set ZX7=null
set AQD=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function ASD2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer I97=GetHandleId(t)
local unit u=LoadUnitHandle(L7,I97,0)
if u!=null then
call B1027TempestRemove(u)
endif
call PauseTimer(t)
call FlushChildHashtable(L7,I97)
call DestroyTimer(t)
set u=null
set t=null
endfunction
//风暴双雄
function ATD takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t=null
local timer tt=null
local integer I97=0
local unit AQD=null
local integer BC7=0
local integer i=0
local item D88
local integer AUD='I02M'
local real DUR=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
set ZX7=null
return
endif
set t=CreateTrigger()
set tt=CreateTimer()
set I97=GetHandleId(t)
// Suppress main-hero enter registration until the new handle can be tagged.
set B998TempestCreating=true
if GetUnitTypeId(ZX7)=='N0MK' then
set AQD=CreateUnit(GetOwningPlayer(ZX7),'N0MM',GetUnitX(ZX7),GetUnitY(ZX7),GetUnitFacing(ZX7))
else
set AQD=CreateUnit(GetOwningPlayer(ZX7),GetUnitTypeId(ZX7),GetUnitX(ZX7),GetUnitY(ZX7),GetUnitFacing(ZX7))
endif
set B998TempestCreating=false
if AQD!=null then
call NS7(GetHandleId(AQD),"B849TempestOwned",true)
call NS7(GetHandleId(AQD),"EnteredAlready",true)
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A2M0')
set DUR=10+BC7*2
if AQD==null or GetUnitTypeId(AQD)==0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call PauseTimer(tt)
call DestroyTimer(tt)
set ZX7=null
set AQD=null
set t=null
set tt=null
return
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl",AQD,"chest"))
if TV7(GetOwningPlayer(AQD))==false then
set AUD='I0PC'
endif
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(ZX7)) or IsPlayerObserver(GetLocalPlayer()) then
call SetUnitVertexColor(AQD,75,75,75,100)
endif
if Ab[GetPlayerId(GetOwningPlayer(ZX7))]then
call SelectUnitAddForPlayer(AQD,GetOwningPlayer(ZX7))
endif
// Same-type OMG doubles otherwise inherit the hero's unrestricted inventory.
// Match native N0MM before adding any copied equipment.
call UnitRemoveAbility(AQD,'AInv')
call UnitAddAbility(AQD,'A2LZ')
call UnitMakeAbilityPermanent(AQD,true,'A2LZ')
call DisableTrigger(H94)
loop
exitwhen i>5
if UnitItemInSlot(ZX7,i)!=null and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[X0]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[ZC]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[VC]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[WC]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[H3]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[DF4]and GetItemTypeId(UnitItemInSlot(ZX7,i))!=ZU[EW]then
set D88=CreateItem(GetItemTypeId(UnitItemInSlot(ZX7,i)),0,0)
call B1017TempestTrackItem(AQD,D88,i)
if GetItemCharges(UnitItemInSlot(ZX7,i))>0 then
call SetItemCharges(D88,GetItemCharges(UnitItemInSlot(ZX7,i)))
endif
call UnitAddItem(AQD,D88)
call SetItemPlayer(D88,GetOwningPlayer(AQD),false)
else
set D88=CreateItem(AUD,0,0)
call B1017TempestTrackItem(AQD,D88,i)
call UnitAddItem(AQD,D88)
endif
// Lock only these newly created copies, never the source hero's item handles.
call SetItemPawnable(D88,false)
call SetItemDroppable(D88,false)
call SetItemDropOnDeath(D88,false)
set i=i+1
endloop
call EnableTrigger(H94)
call SetHeroLevel(AQD,GetHeroLevel(ZX7),false)
set i=1
loop
exitwhen i>GetUnitAbilityLevel(ZX7,'Aamk')
call SelectHeroSkill(AQD,'Aamk')
set i=i+1
endloop
set i=1
loop
exitwhen i>GetUnitAbilityLevel(ZX7,'A2LL')
call SelectHeroSkill(AQD,'A2LL')
set i=i+1
endloop
set i=1
loop
exitwhen i>GetUnitAbilityLevel(ZX7,'A2LM')
call SelectHeroSkill(AQD,'A2LM')
set i=i+1
endloop
set i=1
loop
exitwhen i>GetUnitAbilityLevel(ZX7,'A2M1')
call SelectHeroSkill(AQD,'A2M1')
set i=i+1
endloop
set i=1
loop
exitwhen i>GetUnitAbilityLevel(ZX7,'A2B4')
call SelectHeroSkill(AQD,'A2B4')
set i=i+1
endloop
// Tempest itself must never be available on the copy; native ultimates are rebuilt below.
call UnitRemoveAbility(AQD,'A2M0')
call UnitModifySkillPoints(AQD,-25)
call SuspendHeroXP(AQD,true)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerRegisterDeathEvent(t,AQD)
call TriggerAddCondition(t,Condition(function ASD))
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(17),(AQD))
call SaveInteger(L7,(I97),(10),(BC7))
call SetUnitState(ZX7,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE)*(1-(0.-0.*BC7)))
call SetUnitState(ZX7,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA)*(1-(0.-0.*BC7)))
call SetUnitState(AQD,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE))
call SetUnitState(AQD,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA))
// call UnitApplyTimedLife(AQD,1112820806,DUR)
call ShuangXiongTime(AQD,DUR)
call SaveUnitHandle(L7,GetHandleId(tt),0,AQD)
call TimerStart(tt,DUR+4,false,function ASD2)
set B849TempestSource=ZX7
set B849TempestDouble=AQD
call ExecuteFunc("B849TempestInherit")
call SetUnitState(AQD,UNIT_STATE_LIFE,GetUnitState(ZX7,UNIT_STATE_LIFE))
call SetUnitState(AQD,UNIT_STATE_MANA,GetUnitState(ZX7,UNIT_STATE_MANA))
if SuijiMode_ScepterRegistryIsActive(ZX7,'A2M0') then
if GetUnitAbilityLevel(ZX7,'A330')>0 then
call XF7(AQD,'A330')
endif
if GetUnitAbilityLevel(ZX7,'A2Q5')>0 then
call XF7(AQD,'A2Q5')
call XF7(AQD,'A2Q3')
endif
if GetUnitAbilityLevel(ZX7,'A334')>0 then
call XF7(AQD,'A334')
call XF7(AQD,'A2VW')
endif
if GetUnitAbilityLevel(ZX7,'A333')>0 then
call XF7(AQD,'A332')
call UnitMakeAbilityPermanent(AQD,true,'A14K')
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A332',false)
call XF7(AQD,'A26A')
call XF7(AQD,'A333')
endif
endif
set ZX7=null
set AQD=null
set t=null
set tt=null
set D88=null
endfunction
function AVD takes nothing returns boolean
// Dispatch by logical ownership, including fixed random carriers; doubles cannot recurse.
if B287_GetSpellAbilityId()=='A2M0' and not DGFS(GetTriggerUnit()) and not OO7(GetHandleId(GetTriggerUnit()),"B849TempestOwned") and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A2M0')>0 then
call ATD()
endif
return false
endfunction
function PN8 takes nothing returns nothing
local trigger t=null
if B849TempestStarted then
return
endif
set B849TempestStarted=true
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function AVD))
set t=null
endfunction
function Marksmanship_HasScepter takes unit marksmanshipUnit returns boolean
if marksmanshipUnit==null then
return false
endif
return SuijiMode_ScepterRegistryIsActive(marksmanshipUnit,'A0VC')
endfunction
function Marksmanship_UpdateScepterState takes unit marksmanshipUnit returns nothing
if marksmanshipUnit==null then
return
endif
if B287_GetUnitAbilityLevel(marksmanshipUnit,'A0VC')>0 and Marksmanship_HasScepter(marksmanshipUnit) then
if GetUnitAbilityLevel(marksmanshipUnit,'S3UR')==0 then
call XF7(marksmanshipUnit,'S3UR')
call UnitMakeAbilityPermanent(marksmanshipUnit,true,'S3UR')
endif
else
if GetUnitAbilityLevel(marksmanshipUnit,'S3UR')>0 then
call UnitRemoveAbility(marksmanshipUnit,'S3UR')
endif
endif
endfunction
function AWD takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local group g=null
local integer BC7=0
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call KKPassiveControllerStop(ZX7,'A0VC')
set ZX7=null
set t=null
return false
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A0VC')
if BC7<=0 then
if GetUnitAbilityLevel(ZX7,'A2NX')>0 then
call UnitRemoveAbility(ZX7,'A2NX')
endif
set ZX7=null
set t=null
return false
endif
set g=WS7()
call Marksmanship_UpdateScepterState(ZX7)
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(ZX7),GetUnitY(ZX7),450+25,Condition(function A_7))
if FirstOfGroup(g)==null and ISPH(ZX7)==false then
if GetUnitAbilityLevel(ZX7,'A2NX')!=BC7 then
call XF7(ZX7,'A2NX')
call SetUnitAbilityLevel(ZX7,'A2NX',BC7)
endif
else
if GetUnitAbilityLevel(ZX7,'A2NX')>0 then
call UnitRemoveAbility(ZX7,'A2NX')
endif
endif
call WR7(g)
set ZX7=null
set t=null
set g=null
return false
endfunction
function Marksmanship_RegisterAttackEvent takes nothing returns nothing
if SuijiMarksmanshipAttackEventReady==false then
call RegisterUnitAttackEvent("Marksmanship",1)
set SuijiMarksmanshipAttackEventReady=true
endif
endfunction
function SuijiMode_StartMarksmanshipTimer takes unit suijiMarksmanshipUnit returns nothing
local trigger suijiMarksmanshipTrigger=null
local integer suijiMarksmanshipUnitHandle=0
local integer suijiMarksmanshipTriggerHandle=0
if suijiMarksmanshipUnit==null or GetUnitTypeId(suijiMarksmanshipUnit)==0 then
return
endif
set suijiMarksmanshipUnitHandle=GetHandleId(suijiMarksmanshipUnit)
if LoadTriggerHandle(KKControllerOwnerTable,suijiMarksmanshipUnitHandle,StringHash("B820Passive"+I2S('A0VC')))!=null then
return
endif
call NS7(suijiMarksmanshipUnitHandle,"SuijiA0VCInit",true)
call Marksmanship_UpdateScepterState(suijiMarksmanshipUnit)
call Marksmanship_RegisterAttackEvent()
set suijiMarksmanshipTrigger=CreateTrigger()
set suijiMarksmanshipTriggerHandle=GetHandleId(suijiMarksmanshipTrigger)
call SaveTriggerHandle(KKControllerOwnerTable,suijiMarksmanshipUnitHandle,StringHash("B820Passive"+I2S('A0VC')),suijiMarksmanshipTrigger)
call TriggerRegisterTimerEvent(suijiMarksmanshipTrigger,.1,true)
call TriggerAddCondition(suijiMarksmanshipTrigger,Condition(function AWD))
call SaveUnitHandle(L7,suijiMarksmanshipTriggerHandle,2,suijiMarksmanshipUnit)
set suijiMarksmanshipTrigger=null
endfunction
//小黑分裂箭
function MarksmanshipActions takes nothing returns nothing
	local unit target = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	call B67_DPS(LoadUnitHandle(TABLE_HY, h,'xhts'), target, 2, LoadReal(TABLE_HY, h,'xhts'))
	//call Z1I(LoadUnitHandle(TABLE_HY, h,'xhts'), target) //模拟攻击触发法球
	set target = null
endfunction
function Marksmanship_tsw takes unit u, unit u2, unit target, real damage returns nothing
	local trigger t = NHX_TANSHE(u, u2, target,'h30C', "MarksmanshipActions", 900, true, "")
	local integer h = GetHandleId(t)
	call SaveReal(TABLE_HY, h,'xhts', damage)
	call SaveUnitHandle(TABLE_HY, h,'xhts', u)
	set t = null
endfunction
function MarksmanshipEnumTarget takes nothing returns boolean
	return(IsUnitEnemy(U22, GetOwningPlayer(GetFilterUnit())) and IsAliveNotStrucNotWard(GetFilterUnit()) and lWA(GetFilterUnit(), GetOwningPlayer(U22)) ) != null
endfunction
function MarksmanshipEnum takes unit u, unit target returns nothing
	local unit fu
	local group g = WS7() 
	local real damage
	local integer i = 1
	set U22 = u
	call GroupEnumUnitsInRange(g, GetUnitX(target), GetUnitY(target), 425, Condition(function MarksmanshipEnumTarget))
	set damage = (GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(u, UNIT_STATE_ATTACK1_DAMAGE_BONUS) )* 0.4
	loop
		set fu = GroupPickRandomUnit(g)
	exitwhen(fu == null or i > 2)
		if target != fu then
			call Marksmanship_tsw(u, target, fu, damage)
			set i = i + 1
		endif
		call GroupRemoveUnit(g, fu)
	endloop
	call WR7(g)
	set fu = null
	set g = null
endfunction
function Marksmanship takes nothing returns nothing
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A0VC')>0 and GetUnitAbilityLevel(WXX,'S3UR')>0 and Marksmanship_HasScepter(WXX) and (GetUnitTypeId(WXX)=='Nbrn' or (SUIJI_MODE and OO7(GetHandleId(WXX),"SuijiA0VCInit"))) and IsUnitEnemy(WXX, GetOwningPlayer(YXX)) then
		call MarksmanshipEnum(WXX, YXX)
	endif
endfunction
function AXD takes nothing returns nothing
call SuijiMode_StartMarksmanshipTimer(GetTriggerUnit())
endfunction
function AYD takes nothing returns boolean
if B287_GetLearnedSkill()=='A0VC' and IsUnitIllusion(GetTriggerUnit())==false and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A0VC')==1 then
call AXD()
endif
return false
endfunction
function PQ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function AYD))
set t=null
endfunction
function D96 takes unit ZX7,unit IH7,integer SUI returns nothing
local unit I01=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(I01,'A2RW')
call SetUnitAbilityLevel(I01,'A2RW',SUI)
