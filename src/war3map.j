if YT(IP4,IN4)then
set b1060GetTriggerPlayer=null
return
endif
endif
set i=i+1
endloop
set b1060GetTriggerPlayer=null
return
elseif i<1 or i>5 then
call X37(b1060GetTriggerPlayer,"无效的交换选择")
set b1060GetTriggerPlayer=null
return
endif
set IP4=M7[GetPlayerId(b1060GetTriggerPlayer)]
if TV7(b1060GetTriggerPlayer)then
set IR4=Z7[i]
else
set IR4=A7[i]
endif
set IN4=M7[GetPlayerId(IR4)]
if IP4==null or GetOwningPlayer(IP4)!=b1060GetTriggerPlayer or IN4==null or GetOwningPlayer(IN4)!=IR4 or IR4==b1060GetTriggerPlayer then
call X37(b1060GetTriggerPlayer,"无效的交换选择")
set b1060GetTriggerPlayer=null
return
endif
call YT(IP4,IN4)
set b1060GetTriggerPlayer=null
endfunction
