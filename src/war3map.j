//狼人叫
function W9E takes nothing returns nothing
local unit hn=GetTriggerUnit()
local integer id=0
local unit V5E
local integer i=1
local boolean WDE=false
local player p
local integer WEE
local integer WFE
local integer WGE=0
local string tx
if hn==null or GetUnitTypeId(hn)==0 then
set hn=null
set V5E=null
set p=null
return
endif
set id=GetUnitTypeId(hn)
set WDE=TV7(GetOwningPlayer(hn))
set WGE=B287_GetUnitAbilityLevel(hn,'A0ZF')
if id=='Z008' or id=='E115' then
set tx="model\\hero_lycan_n4s_w_source.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='X104'
set WFE='X107'
elseif WGE==2 then
set WEE='X101'
set WFE='X106'
elseif WGE==3 then
set WEE='X102'
set WFE='X105'
elseif WGE==4 then
set WEE='X103'
set WFE='X108'
endif
elseif id=='Z009' or id=='E116' then
set tx="model\\hero_lycan_n3s_w_source.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='X204'
set WFE='X207'
elseif WGE==2 then
set WEE='X201'
set WFE='X206'
elseif WGE==3 then
set WEE='X202'
set WFE='X205'
elseif WGE==4 then
set WEE='X203'
set WFE='X208'
endif
else
set tx="Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl"
call DestroyEffect(AddSpecialEffectTarget(tx,hn,"origin"))
if WGE==1 then
set WEE='A104'
set WFE='A107'
elseif WGE==2 then
set WEE='A101'
set WFE='A106'
elseif WGE==3 then
set WEE='A102'
set WFE='A105'
elseif WGE==4 then
set WEE='A103'
set WFE='A108'
endif
endif
loop
exitwhen i>5
if WDE then
set p=Z7[i]
else
set p=A7[i]
endif
set V5E=CreateUnit(p,'e01V',0,0,0)
call XF7(V5E,WEE)
call XF7(V5E,WFE)
call UnitApplyTimedLife(V5E,'BTLF',12)
set i=i+1
endloop
set hn=null
set V5E=null
set p=null
endfunction
function WHE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0ZF' then
call W9E()
