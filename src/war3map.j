function DragonTail_IsDragonForm takes unit dragonTailUnit returns boolean
local integer dragonTailUnitId=0
if dragonTailUnit==null then
return false
endif
set dragonTailUnitId=GetUnitTypeId(dragonTailUnit)
return dragonTailUnitId=='H00F' or dragonTailUnitId=='H00E' or dragonTailUnitId=='H00G' or dragonTailUnitId=='H10G'
endfunction
function DragonTail_GetBaseLevel takes unit dragonTailUnit returns integer
local integer dragonTailLearnLevel=0
local integer dragonTailCastLevel=0
if dragonTailUnit==null then
return 0
endif
set dragonTailLearnLevel=GetUnitAbilityLevel(dragonTailUnit,'A2AI')
set dragonTailCastLevel=B287_GetUnitAbilityLevel(dragonTailUnit,'A0AR')
if dragonTailLearnLevel>0 then
return dragonTailLearnLevel
endif
if dragonTailCastLevel>4 then
return dragonTailCastLevel-4
endif
return dragonTailCastLevel
endfunction
function DragonTail_SyncRangeLevel takes unit dragonTailUnit returns nothing
local integer dragonTailBaseLevel=DragonTail_GetBaseLevel(dragonTailUnit)
if dragonTailBaseLevel<=0 then
return
endif
if DragonTail_IsDragonForm(dragonTailUnit) then
call B287_SetUnitAbilityLevel(dragonTailUnit,'A0AR',dragonTailBaseLevel+4)
else
call B287_SetUnitAbilityLevel(dragonTailUnit,'A0AR',dragonTailBaseLevel)
endif
endfunction
function W_9 takes unit ZX7 returns nothing
call DragonTail_SyncRangeLevel(ZX7)
endfunction
function X49 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer BC7=GetUnitAbilityLevel(ZX7,'A2AI')
