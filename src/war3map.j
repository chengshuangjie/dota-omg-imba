function ClearAllEditBoxFocus takes nothing returns nothing
	local integer i = 1
	set EditingHotKeyIndex = 0
	loop
		exitwhen i > 18
		if HotKeyButtonHighlight[i] != 0 then
			call DzFrameShow(HotKeyButtonHighlight[i], false)
		endif
		set i = i + 1
	endloop
endfunction
function MapSettingsShortcut_SetOpen takes boolean isOpen returns nothing
	if MapSettingsShortcutIcon==0 then
		return
	endif
	if isOpen then
		call DzFrameSetTexture(MapSettingsShortcutIcon,"ui\\gaijiananniui2.tga",0)
	else
		call DzFrameSetTexture(MapSettingsShortcutIcon,"ui\\gaijiananniui1.tga",0)
	endif
endfunction
function MapSettingsShortcut_RestoreParent takes nothing returns nothing
	call DzFrameSetParent(UIFrame__SetUp,DzFrameFindByName("EscMenuMainPanel",0))
	set MapSettingsShortcutDirectOpen=false
endfunction
function ShowSetUpPanel takes boolean show returns nothing
	set IsSetUpUIEnable = show
	call DzFrameShow( UIFrame__SetUp, show )
	call DzFrameShow( UIFrame__MainPanel, not show)
endfunction
// 点击 地图设置 按钮
function ClickMapSetUpButton__Script takes nothing returns nothing
	call DzClickFrame( DzFrameFindByName("EndGameButton", 0) )
	call DzFrameShow( UIFrame__MapSetUpBackdrop , true)
	call DzFrameShow( DzFrameFindByName("EndGamePanel", 0) , false)
	call ShowSetUpPanel(true)
	call MapSettingsShortcut_SetOpen(true)
	call DzFrameSetParent( UIFrame__ToolTip, DzFrameFindByName("MapOptionsPanel", 0) )
endfunction
function MapSettingsShortcut_OnClick takes nothing returns nothing
	set MapSettingsShortcutDirectOpen=true
	call DzFrameSetParent(UIFrame__SetUp,GameUI)
	call ClickMapSetUpButton__Script()
endfunction
// 点击地图选项返回按钮
function ClickMapSetUpReturnButton takes nothing returns nothing
	// 隐藏地图设置界面
	call ClearAllEditBoxFocus()
	call ShowSetUpPanel(false)
	call MapSettingsShortcut_SetOpen(false)
	if MapSettingsShortcutDirectOpen then
		call MapSettingsShortcut_RestoreParent()
	elseif DzGetTriggerKey() != 27 then
		call DzClickFrame( DzFrameFindByName("PreviousButton", 0) )
	endif
	call DzFrameSetParent( UIFrame__ToolTip, GameUI )
endfunction
