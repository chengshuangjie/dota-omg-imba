//删除装备
function JSCZB takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit u=M7[GetPlayerId(b1060GetTriggerPlayer)]
local integer i=S2I(SubString(GetEventPlayerChatString(),5,7))
local item ff
if u==null then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,E9,10.,GetObjectName('n08A'))
elseif not IsUnitAliveBJ(u) then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "请等待英雄复活")
elseif i > 0 and i < 7 then
set i=i-1
set ff=UnitItemInSlot(u,i)
if(ff!=null)and(Y_8(ff))then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|c00FF0000无法对A杖使用该指令|r")
else
call RemoveItem(UnitItemInSlot(u,i))
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "成功删除装备")
endif
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0,"删除装备指令使用方法：|cFF00FF00-sczb 数字|r\n(数字为1~6)，左上角为1，右下角为6")
endif
set u=null
set ff=null
set b1060GetTriggerPlayer=null
endfunction
function JDEBUGON takes nothing returns nothing
