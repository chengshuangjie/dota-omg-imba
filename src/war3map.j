function L8D takes nothing returns boolean
local unit b1060GetKillingUnit=GetKillingUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if B287_GetUnitAbilityLevel(b1060GetKillingUnit,'A0BR')>0 and IsUnitIllusion(b1060GetTriggerUnit)==false then
call C_D()
elseif B287_GetUnitAbilityLevel(M7[GetPlayerId(GetOwningPlayer(b1060GetKillingUnit))],'A0BR')>0 and GetUnitTypeId(b1060GetKillingUnit)=='e00C' then
call C_D()
endif
if B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0BR')>0 and IsUnitIllusion(b1060GetTriggerUnit)==false and SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A0BR')==false then
call L4D()
elseif B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A0BR')>0 and IsUnitIllusion(b1060GetTriggerUnit)==false and SuijiMode_ScepterRegistryIsActive(b1060GetTriggerUnit,'A0BR') then
call L4DD()
endif
set b1060ReturnValue=false
set b1060GetKillingUnit=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
