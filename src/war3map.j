endif
call SaveReal(L7,(OB7),(6),((GetUnitX(p5))*1.0))
call SaveReal(L7,(OB7),(7),((GetUnitY(p5))*1.0))
endif
set t=null
set p5=null
set ya=null
return false
endfunction
