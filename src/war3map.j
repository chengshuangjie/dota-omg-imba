//极度饥渴
function InsatiableHunger_RemoveRuntime takes unit u returns nothing
if u==null or GetUnitTypeId(u)==0 then
return
endif
call UnitRemoveAbility(u,'A0WR')
call UnitRemoveAbility(u,'A0WU')
call UnitRemoveAbility(u,'A0WW')
call UnitRemoveAbility(u,'A2OP')
call UnitRemoveAbility(u,'A0WT')
call UnitRemoveAbility(u,'A0WV')
call UnitRemoveAbility(u,'A2OQ')
call UnitRemoveAbility(u,'A0WS')
call UnitRemoveAbility(u,'A0WX')
call UnitRemoveAbility(u,'A2OR')
endfunction
function InsatiableHunger_ApplyRuntime takes unit u,integer level returns boolean
if u==null or GetUnitTypeId(u)==0 or level<1 or level>3 then
return false
endif
// B537's single Aspb container is the last user-validated non-crashing
// implementation.  It owns the damage/lifesteal/speed helpers by level, so
// never attach the replacement Aamk marker or its children independently.
if GetUnitAbilityLevel(u,'A0WR')==0 then
call XF7(u,'A0WR')
endif
if GetUnitAbilityLevel(u,'A0WR')==0 then
call InsatiableHunger_RemoveRuntime(u)
return false
endif
call SetUnitAbilityLevel(u,'A0WR',level)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0WR',false)
return GetUnitAbilityLevel(u,'A0WR')==level
endfunction
function InsatiableHunger_StopTimer takes unit u returns nothing
local integer unitHandle=0
local integer timerHandle=0
local timer t=null
if u==null then
return
endif
set unitHandle=GetHandleId(u)
set t=LoadTimerHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"))
if t!=null then
set timerHandle=GetHandleId(t)
call RemoveSavedHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"))
call DestroyEffect(LoadEffectHandle(L7,timerHandle,2))
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
endfunction
function InsatiableHunger_Expire takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer timerHandle=GetHandleId(t)
local integer unitHandle=LoadInteger(L7,timerHandle,1)
local unit u=LoadUnitHandle(L7,timerHandle,0)
if unitHandle>0 and LoadTimerHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"))==t then
call RemoveSavedHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"))
if u!=null and GetUnitTypeId(u)!=0 then
call InsatiableHunger_RemoveRuntime(u)
endif
endif
call DestroyEffect(LoadEffectHandle(L7,timerHandle,2))
call FlushChildHashtable(L7,timerHandle)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function RAD takes nothing returns nothing
local timer t=null
local unit WI7=GetTriggerUnit()
local integer level=0
local integer unitHandle=0
local integer timerHandle=0
if WI7==null or GetUnitTypeId(WI7)==0 then
set WI7=null
return
endif
set level=B287_GetUnitAbilityLevel(WI7,'A0WQ')
if InsatiableHunger_ApplyRuntime(WI7,level)==false then
call InsatiableHunger_StopTimer(WI7)
set WI7=null
return
endif
set unitHandle=GetHandleId(WI7)
set t=LoadTimerHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"))
if t==null then
set t=CreateTimer()
call SaveTimerHandle(L7,unitHandle,StringHash("InsatiableHungerTimer"),t)
else
call DestroyEffect(LoadEffectHandle(L7,GetHandleId(t),2))
endif
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,0,WI7)
call SaveInteger(L7,timerHandle,1,unitHandle)
call SaveEffectHandle(L7,timerHandle,2,AddSpecialEffectTarget("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",WI7,"origin"))
call TimerStart(t,20,false,function InsatiableHunger_Expire)
set t=null
set WI7=null
endfunction
function RBD takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0WQ' then
call RAD()
endif
return false
endfunction
function HJ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RBD))
set t=null
endfunction
function RCD2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real d=(LoadReal(L7,(I97),(20)))
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
return false
endif
if GetTriggerEvalCount(t)>300 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
elseif GetUnitAbilityLevel(IH7,'B0E7')>0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call B67(ZX7, IH7, 1, d)
call LINGXIA(ZX7,IH7)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function RCD takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local trigger t=null
    local integer I97=0
local unit BB7=null
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        set ZX7 = null
        set IH7 = null
        return
    endif
    set t=CreateTrigger()
    set I97=GetHandleId(t)
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
    call SaveUnitHandle(L7,GetHandleId(BB7),StringHash("B1010SpiderCaster"),ZX7)
    call SaveReal(L7,GetHandleId(BB7),StringHash("B1014SpiderSourceUntil"),TimerGetElapsed(W)+4.)
    call SaveUnitHandle(L7,GetHandleId(IH7),StringHash("B1010SpiderCaster"),ZX7)
    call SaveReal(L7,GetHandleId(IH7),StringHash("B1014SpiderSourceUntil"),TimerGetElapsed(W)+4.)
    call SaveReal(L7,GetHandleId(ZX7),StringHash("B1014SpiderSourceUntil"),TimerGetElapsed(W)+4.)
    call XF7(BB7,'A4GP')
    call SetUnitAbilityLevel(BB7,'A4GP',level)
    call B947IssueTargetOrderById("RCD @ war3map.j:93428 (B968)",BB7,$D0279,IH7)
    // Keep the parasite caster alive through the full three-second hatch window.
    call UnitApplyTimedLife(BB7,'BTLF',5.)
    call TriggerRegisterTimerEvent(t,.01,true)
    call TriggerAddCondition(t,Condition(function RCD2))
    call SaveUnitHandle(L7,(I97),(2),(ZX7))
    call SaveUnitHandle(L7,(I97),(17),(IH7))
    call SaveReal(L7,(I97),(20),(75. * level))
    set BB7=null
	set ZX7 = null
	set IH7 = null
    set t = null
endfunction
function R3D takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
	local trigger t
    if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
        set ZX7 = null
        set IH7 = null
        return
    endif
    set t=NHX(ZX7, IH7,'h0HH', "RCD",1200, true, "Abilities\\Spells\\Undead\\Web\\Webmissile.mdl")
call SaveInteger(TABLE_HY,GetHandleId(t),10,B287_GetUnitAbilityLevel(ZX7,'A0BH'))
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
