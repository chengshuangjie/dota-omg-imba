// call DisplayTimedTextToPlayer(p,0,0,10,"|c00FF0000该皮肤为定制皮肤，暂不开放使用|r")
// set u=null
// return
// endif
call CHANGE_HERO(u,WI7_ID,p)
set u=null
endfunction
