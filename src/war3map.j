return d>5
endif
return true
endfunction
function D_9 takes unit u returns unit
local group g
if GetUnitAbilityLevel(u,'A04R')==0 then
return u
endif
set IN4=VU4
set g=WS7()
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),900,Condition(function AJ7_gai))
set VT4=FirstOfGroup(g)
call WR7(g)
set g=null
return VT4
endfunction
function E49 takes nothing returns nothing
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit BB7
local unit p5
if b1060GetTriggerEventId== EVENT_GAME_TIMER_EXPIRED or b1060GetTriggerEventId==EVENT_WIDGET_DEATH then
    call UnitRemoveAbility(O77(OB7,"Target"),'A4JA')
    call OX7(O77(OB7,"Target"),"StaticChargeActive")
    call NM7(OB7)
    call OZ7(t)
elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and LoadBoolean(L7,OB7,StringHash("B1026StaticChargeBusy"))==false and D29(b1060GetEventDamageSource,b1060GetEventDamage)and GetRandomInt(1,100)<21 and OT7(b1060GetTriggerUnit,"E79")==false then
    set p5=O77(OB7,"Source")
if p5!=null and GetUnitTypeId(p5)!=0 and b1060GetTriggerUnit!=null and GetUnitTypeId(b1060GetTriggerUnit)!=0 then
// Orders may synchronously re-enter damage before the success cooldown exists.
call SaveBoolean(L7,OB7,StringHash("B1026StaticChargeBusy"),true)
set BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(b1060GetTriggerUnit),GetUnitY(b1060GetTriggerUnit),0)
call UnitAddAbility(BB7,'A0K6')
    set VU4=p5
    if B947IssueTargetOrderById("E49 @ war3map.j:48853 (B968)",BB7,$D026B,D_9(b1060GetEventDamageSource))then
        call O37(b1060GetTriggerUnit,"E79",.5)
    endif
call RemoveSavedBoolean(L7,OB7,StringHash("B1026StaticChargeBusy"))
endif
endif
set t=null
set BB7=null
set p5=null
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
endfunction
function E79 takes nothing returns nothing
local unit p5=GetTriggerUnit()
local unit m5=GetSpellTargetUnit()
local trigger t
local integer OB7
if m5==null then
set m5=p5
endif
if OT7(m5,"StaticChargeActive")==false then
    set t=CreateTrigger()
    set OB7=GetHandleId(t)
    call OV7(m5,"StaticChargeActive")
    call TriggerRegisterTimerEvent(t,20.,false)
    call TriggerRegisterDeathEvent(t,m5)
    call B1023RegisterDamage(t,m5)
    call TriggerAddCondition(t,Condition(function E49))
    call XF7(m5,'A4JA')
    call NT7(OB7,"Source",p5)
    call NT7(OB7,"Target",m5)
endif
set t=null
set p5=null
set m5=null
endfunction
function E99 takes nothing returns nothing
if B287_GetSpellAbilityId()=='A0JL' then
    call E79()
endif
endfunction
