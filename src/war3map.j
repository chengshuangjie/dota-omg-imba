local group LQ7=null
local integer O5=0
local integer BZ7=30+V77*10
local boolean suijiChronosphereScepter=LoadBoolean(L7,OB7,15)
if WI7==null or ya==null or T_D==null then
if WI7!=null then
set O5=GetPlayerId(GetOwningPlayer(WI7))
if B946DetectCount>0 then
set GZ[384+O5]=B962Flag(1,384+O5,false,"T0D @ war3map.j:95099 (B968)")
else
