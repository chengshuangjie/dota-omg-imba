//马甲释放技能
function MJ_USE_SKILL takes unit ZX7,unit IH7,integer skill,integer orderid returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
call XF7(BB7,skill)
call B947IssueTargetOrderById("MJ_USE_SKILL @ war3map.j:179228 (B968)",BB7,orderid,IH7)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endfunction
//多重物品
function MUL_ITEM takes integer r,unit ZX7,unit IH7,integer skill returns nothing
local group g
local unit m5
local integer D1G
local integer n=1
local string VH
if r==2 then
call YW7(GetObjectName('n0K7'),5,ZX7,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,ZX7,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,ZX7,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,ZX7,.03,255,0,0,255)
endif
set r=r-1
if skill=='A02O' or skill=='A08Y' or skill=='A08Z' or skill=='A090' or skill=='A092' then
set D1G=DLG_level(skill)
set VH="dagen"
elseif skill=='AChx' then
set VH="yangdao"
elseif skill=='A0FD' then
set VH="ziyuan"
elseif skill=='A32X' then
set VH="xueji"
elseif skill=='A1QD' then
set VH="xulingdao"
elseif skill=='A2EA' then
set VH="atuosi"
elseif skill=='A4DN' then
set VH="foujue"
elseif skill=='A4pg' then
set VH="sanshi"
elseif skill=='A4DT' then
set VH="shj"
endif
set g=WS7()
set IN4=ZX7
call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),450,Condition(function AX7))
call GroupRemoveUnit(g,IH7)
loop
set m5=GroupPickRandomUnit(g)
call GroupRemoveUnit(g,m5)
exitwhen n>r or m5==null
if UnitAlive(m5) and IsMagicImmuneUnit(m5)==false then
    if WQ7(m5) then
        call PLK(m5)
    else
        if VH=="dagen" then
            call D6G(D1G,ZX7,m5)
        elseif VH=="yangdao" then
            call MJ_USE_SKILL(ZX7,m5,'AChx',$D0216)
        elseif VH=="ziyuan" then
            call MJ_USE_SKILL(ZX7,m5,'A0FD',$D02BC)
        elseif VH=="xueji" then
            call MJ_USE_SKILL(ZX7,m5,'A32X',$D02BC)
        elseif VH=="xulingdao" then
            call EWG(ZX7,m5)
        elseif VH=="atuosi" then
            call DRG(ZX7,m5)
        elseif VH=="foujue" then
            // call NHX(ZX7, m5,'h0GW', "fj_exec", 5000, false, "")
            call fj_exec(ZX7,m5)
        elseif VH=="sanshi" then
            call JINGHUA(ZX7,m5,'A4pg')
        elseif VH=="shj" then
            call JINGHUA(ZX7,m5,'A4DT')
        endif
    endif
endif
set n=n+1
endloop
call WR7(g)
set g=null
set m5=null
endfunction
//火焰爆轰 物品多重
function E2D takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
local integer r
local unit ZX7=GetTriggerUnit()
local unit IH7=b1060GetSpellTargetUnit
local integer skill=b1060B287_GetSpellAbilityId
if SuijiMulticastTemplate_IsRandomCaster(ZX7) then
if IH7!=null and WQ7(IH7)==false and SuijiMulticastTemplate_IsFireblastSkill(skill) then
call HYBH(ZX7,IH7,skill,true)
if ISPH(ZX7)==false then
set r=EUD(ZX7)
if r>1 and((LoadInteger(L7,(GetHandleId(IH7)),((4322))))==1)==false then
call E5D(r)
endif
endif
elseif IH7!=null and ISPH(ZX7)==false and WQ7(IH7)==false and SuijiMulticastTemplate_IsItemSkill(skill) then
set r=EUD(ZX7)
if r>1 then
call MUL_ITEM(r,ZX7,IH7,skill)
endif
endif
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endif
if WQ7(b1060GetSpellTargetUnit)==false and (b1060B287_GetSpellAbilityId=='A04W' or b1060B287_GetSpellAbilityId=='A08D' or b1060B287_GetSpellAbilityId=='A08A' or b1060B287_GetSpellAbilityId=='A089' or b1060B287_GetSpellAbilityId=='A2KQ') then
call HYBH(ZX7,b1060GetSpellTargetUnit,b1060B287_GetSpellAbilityId,true)
endif
if (B287_GetUnitAbilityLevel(ZX7,'A088')>0 or (ISLABIKE(ZX7) and ISPH(ZX7)==false)) and WQ7(b1060GetSpellTargetUnit)==false and (b1060B287_GetSpellAbilityId=='A04W' or b1060B287_GetSpellAbilityId=='A08D' or b1060B287_GetSpellAbilityId=='A08A' or b1060B287_GetSpellAbilityId=='A089' or b1060B287_GetSpellAbilityId=='A2KQ') then
set r=EUD(ZX7)
if r>1 and((LoadInteger(L7,(GetHandleId((b1060GetSpellTargetUnit))),((4322))))==1)==false then
call E5D(r)
endif
endif
if B287_GetUnitAbilityLevel(ZX7,'A088')>0 and ISPH(ZX7)==false and WQ7(IH7)==false and(skill=='A02O' or skill=='A08Y' or skill=='A08Z' or skill=='A090' or skill=='A092' or skill=='AChx' or skill=='A0FD' or skill=='A32X' or skill=='A1QD' or skill=='A2EA' or skill=='A4DN' or skill=='A4pg' or skill=='A4DT')then
set r=EUD(ZX7)
if r>1 then
call MUL_ITEM(r,ZX7,IH7,skill)
endif
endif
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function FA8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function E2D))
set t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,Z7[1],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[2],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[3],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[4],"-st",true)
call TriggerRegisterPlayerChatEvent(t,Z7[5],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[1],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[2],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[3],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[4],"-st",true)
call TriggerRegisterPlayerChatEvent(t,A7[5],"-st",true)
call TriggerAddCondition(t,Condition(function E_D))
set t=null
endfunction
function SET_HQJJ2 takes unit ZX7,integer skill returns nothing
    if SUIJI_MODE and SuijiMode_ScepterRegistryIsRegistered(ZX7,'A04P') then
        set skill=B287_GetPhysicalAbilityId(ZX7,'A04P')
        if SuijiMode_ScepterRegistryIsActive(ZX7,'A04P') then
            call SuijiMode_SetExactLiveAbilityCastpoint(ZX7,skill,.3)
        else
            call SuijiMode_SetExactLiveAbilityCastpoint(ZX7,skill,1.7)
        endif
    elseif skill=='A04P' then
        if SuijiMode_GetExactLiveAbilityCastpoint(ZX7,skill)!=1.7 then
            call SuijiMode_SetExactLiveAbilityCastpoint(ZX7,skill,1.7)
        endif
    else
        if SuijiMode_GetExactLiveAbilityCastpoint(ZX7,skill)!=.3 then
            call SuijiMode_SetExactLiveAbilityCastpoint(ZX7,skill,.3)
        endif     
    endif
endfunction
function SET_HQJJ takes nothing returns boolean
if IsUnitIllusion(GetTriggerUnit())==false and (B287_GetLearnedSkill()=='A04P' or B287_GetLearnedSkill()=='A1AU') then
call SET_HQJJ2(GetTriggerUnit(),B287_GetLearnedSkill())
endif
return false
endfunction
function HQJJ_ALL takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
	local group g = WS7()
	local unit u
	call GroupEnumUnitsInRange(g, GetUnitX(IH7), GetUnitY(IH7), 225, Condition(function DJX))
	set d =205.+150.* level
	loop
		set u = FirstOfGroup(g)
	exitwhen u == null
        if GetPlayerController(GetOwningPlayer(u))==MAP_CONTROL_COMPUTER and GetRandomInt(1,2)==1 then
            call AI_ITEM_RENJIA(u)
        endif
		call B67(ZX7, u, 1, d)
		call CommonUnitAddStun(u, 2, false)
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Mortar\\MortarMissile.mdl", GetUnitX(u), GetUnitY(u)))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl", u, "origin"))
		call GroupRemoveUnit(g, u)
	endloop
    call LINGXIA(ZX7,IH7)
	call WR7(g)
	set g = null
	set ZX7 = null
	set IH7 = null
endfunction
function HQJJ_DT takes nothing returns nothing
	local unit ZX7 = U22
	local unit IH7 = W22
	local integer h = GetHandleId(GetTriggeringTrigger())
	local integer level = LoadInteger(TABLE_HY, h, 10)
	local real d
    if GetPlayerController(GetOwningPlayer(IH7))==MAP_CONTROL_COMPUTER then
        call AI_ITEM_RENJIA(IH7)
    endif
	set d =205.+150.* level
    call B67(ZX7, IH7, 1, d)
    call CommonUnitAddStun(IH7, 0.01, false)
    call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Mortar\\MortarMissile.mdl", GetUnitX(IH7), GetUnitY(IH7)))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\CannonTowerMissile\\CannonTowerMissile.mdl", IH7, "origin"))
    call LINGXIA(ZX7,IH7)
	set ZX7 = null
	set IH7 = null
endfunction
function HQJJ takes nothing returns nothing
	local unit ZX7 = GetTriggerUnit()
	local unit IH7 = GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
	local trigger t
	local integer h
    call SET_HQJJ2(ZX7,skill)
    if SuijiMode_ScepterRegistryIsActive(ZX7,'A04P')==false then
        call SetUnitAnimation(ZX7,"spell throw")
        set t=NHX(ZX7, IH7,'n12F', "HQJJ_DT",2500, true, "")
    else
        set t=NHX(ZX7, IH7,'n12F', "HQJJ_ALL",2500, true, "")
    endif
    set h=GetHandleId(t)
    call SaveInteger(TABLE_HY, h, 10, SuijiMode_GetPairCastLevel(ZX7,skill,'A04P','A1AU'))
	set t = null
	set ZX7 = null
	set IH7 = null
endfunction
function E5GG takes nothing returns boolean
if (B287_GetSpellAbilityId()=='A04P' or B287_GetSpellAbilityId()=='A1AU') and WQ7(GetSpellTargetUnit())==false then
call HQJJ()
endif
return false
endfunction
function G98 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function E5G))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function E5GG))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function SET_HQJJ))
set t=null
endfunction
function E2G takes nothing returns boolean
local real d
if IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IP4)) then
set d=KF7(IK4,IM4,GetUnitX(GetFilterUnit()),GetUnitY(GetFilterUnit()))
if d<IJ4 then
set IJ4=d
set IN4=GetFilterUnit()
endif
endif
return false
endfunction
function E_G takes unit F4G,real x,real y returns unit
local group g=WS7()
set IN4=null
set IP4=F4G
set IJ4=99999
set IK4=x
set IM4=y
call GroupEnumUnitsInRange(g,x,y,$7D0,Condition(function E2G))
call WR7(g)
set g=null
return IN4
endfunction
function F7G takes nothing returns boolean
local real d
if GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and XH7(GetFilterUnit())==false and IsUnitType(GetFilterUnit(),UNIT_TYPE_HERO)==false and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IP4)) then
set d=KF7(IK4,IM4,GetUnitX(GetFilterUnit()),GetUnitY(GetFilterUnit()))
if d<IJ4 then
set IJ4=d
set IN4=GetFilterUnit()
endif
endif
return false
endfunction
function F8G takes unit F4G,real x,real y returns unit
local group g=WS7()
set IN4=null
set IP4=F4G
set IJ4=99999
set IK4=x
set IM4=y
call GroupEnumUnitsInRange(g,x,y,$7D0,Condition(function F7G))
call WR7(g)
set g=null
return IN4
endfunction
function F9G takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit WI7=GetTriggerUnit()
local location l
local real x
local real y
local unit m5=b1060GetSpellTargetUnit
if m5==null then
set l=GetSpellTargetLoc()
set x=GetLocationX(l)
set y=GetLocationY(l)
call RemoveLocation(l)
if b1060B287_GetSpellAbilityId=='A0CX' then
set m5=E_G(WI7,x,y)
else
set m5=F8G(WI7,x,y)
endif
set x=GetUnitX(m5)
set y=GetUnitY(m5)
else
set x=GetUnitX(b1060GetSpellTargetUnit)
set y=GetUnitY(b1060GetSpellTargetUnit)
endif
if(IsUnitAlly(WI7,GetLocalPlayer())and GetLocalPlayer()!=GetOwningPlayer(WI7))or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
call PingMinimapEx(x,y,3,$FF,$FF,$FF,false)
endif
set WI7=null
set l=null
set m5=null
set b1060GetSpellTargetUnit=null
endfunction
function FDG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0CX' or B287_GetSpellAbilityId()=='AImt' then
call F9G()
endif
return false
endfunction
function FEG_ACTION takes nothing returns nothing
	local unit IH7=GetEnumUnit()
	call CommonUnitAddStun(IH7, 0.1, false)
	call B67(IN4,IH7,1,IJ4)
	set IH7=null
endfunction
function FEG takes unit ZX7,integer level,boolean b returns nothing
local group g=WS7()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local unit IH7
local real d=level*25+25
set IN4=ZX7
set IJ4=d
call GroupEnumUnitsInRange(g,x,y,300,Condition(function A17))
if b then
	call ForGroup(g,function FEG_ACTION)
else
	set IH7=GroupPickRandomUnit(g)
	if IH7!=null then
		call CommonUnitAddStun(IH7, 0.1, false)
		call B67(ZX7,IH7,1,d)
	endif
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",ZX7,"origin"))
call WR7(g)
set g=null
set IH7=null
endfunction
function FJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer FKG=GetHandleId(t)
local integer FMG=GetTriggerEvalCount(t)
local unit FNG=O77(FKG,"Hero")
local real DUR=ON7(FKG,"DUR")
if GetGameTime()>DUR or GetTriggerEventId()==EVENT_UNIT_DEATH then
call NM7(FKG)
call OZ7(t)
else
call FEG(FNG,OM7(FKG,"Level"),OO7(FKG,"HaveA"))
endif
set t=null
set FNG=null
return false
endfunction
function Clockwerk_HasScepter takes unit clockwerkScepterUnit returns boolean
if clockwerkScepterUnit==null then
return false
endif
return SuijiMode_HasAghanimState(clockwerkScepterUnit)
endfunction
function FOG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer FKG=GetHandleId(t)
local unit FNG=GetTriggerUnit()
local integer level=B287_GetUnitAbilityLevel(FNG,'A0Z4')
local real d
local boolean b=false
if Clockwerk_HasScepter(FNG) then
	set b=true
endif
if level==1 then
	set d=0.7
elseif level==2 then
	set d=0.6
else
	set d=0.5
endif
call TriggerRegisterTimerEvent(t,d,true)
call TriggerRegisterUnitEvent(t,FNG,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function FJG))
call NT7(FKG,"Hero",FNG)
call NP7(FKG,"Level",level)
call NS7(FKG,"HaveA",b)
call NQ7(FKG,"DUR",GetGameTime()+10.)
call TriggerEvaluate(t)
set t=null
set FNG=null
endfunction
function FPG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0Z4' then
call FOG()
endif
return false
endfunction
function MZ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function FPG))
set t=null
endfunction
function G9G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real GDG=ON7(OB7,"Angle")
local real x=GetUnitX(m5)
local real y=GetUnitY(m5)
local real T5F=6
local unit p5=O77(OB7,"Source")
local real GEG=ON7(OB7,"Damage")
if GetTriggerEvalCount(t)>21 then
call NM7(OB7)
call OZ7(t)
call OX7(m5,"PowerCogShocked")
call B67(p5,m5,1,GEG)
call SetUnitState(m5,UNIT_STATE_MANA,YK7(GetUnitState(m5,UNIT_STATE_MANA)-GEG*0.5,0))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl",x,y))
call Y67(x,y,$96)
if OT7(m5,"TimeWalk|Active")==false then
call SetUnitPosition(m5,x+T5F*Cos(GDG*bj_DEGTORAD),y+T5F*Sin(GDG*bj_DEGTORAD))
endif
endif
set t=null
set m5=null
set p5=null
return false
endfunction
function ApplyCogRebound takes unit target, real cogX, real cogY, unit hero, integer level,boolean b returns nothing
    local real dx = GetUnitX(target) - cogX
    local real dy = GetUnitY(target) - cogY
    local real dist = SquareRoot(dx * dx + dy * dy)
    local real angle = Atan2(dy, dx) * bj_RADTODEG
    local real pushDist = 150.0 + 50.0 - dist
    local trigger t
    local integer OB7
	local real d = 40+40*level
	if b then
		set d=d*1.5
	endif
    if pushDist > 0 then
        call SetUnitX(target, GetUnitX(target) + pushDist * Cos(angle * bj_DEGTORAD))
        call SetUnitY(target, GetUnitY(target) + pushDist * Sin(angle * bj_DEGTORAD))
    endif
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl", target, "chest"))
    call OV7(target, "PowerCogShocked")
    set t = CreateTrigger()
    set OB7 = GetHandleId(t)
    call NT7(OB7, "Target", target)
    call NQ7(OB7, "Angle", angle)
    call NT7(OB7, "Source", hero)
	call NQ7(OB7, "Damage", d)
    call TriggerRegisterTimerEvent(t, 0.04, true)
    call TriggerAddCondition(t, Condition(function G9G))
    set t = null
endfunction
function GFG takes nothing returns nothing
    local unit m5 = GetEnumUnit()
    local real cogX = ON7(GetHandleId(m5), "CogX")
    local real cogY = ON7(GetHandleId(m5), "CogY")
    call ApplyCogRebound(m5, cogX, cogY, IN4, IH4, false)
    set m5 = null
endfunction
function GMG takes nothing returns nothing
    local unit target = GetEnumUnit()
    local integer i
    local unit cog
    local real threshold = 125.0
    if GetUnitState(target, UNIT_STATE_MANA) > 0 and OT7(target, "PowerCogShocked") == false then
        set i = 1
        loop
            exitwhen i > 8
            set cog = O77(tl, "Cog" + I2S(i))
            if cog != null and XH7(cog) == false and OM7(GetHandleId(cog), "PowerCogUsed") != 1 then
                if KF7(GetUnitX(target), GetUnitY(target), GetUnitX(cog), GetUnitY(cog)) <= threshold then
                    call OV7(target, "PowerCogShocked")
                    call NP7(GetHandleId(cog), "PowerCogUsed", 1)
                    call SetUnitVertexColor(cog, 25, 25, 25, 175)
					call NQ7(GetHandleId(target), "CogX", GetUnitX(cog))
                    call NQ7(GetHandleId(target), "CogY", GetUnitY(cog))
                    call GroupAddUnit(aL, target)
                    exitwhen true
                endif
            endif
            set i = i + 1
        endloop
    endif
    set target = null
	set cog = null
endfunction
function GNG takes trigger t,unit WI7,real x,real y,real d,integer V77 returns nothing
local integer OB7=GetHandleId(t)
local real GOG=200
// local rect r1=Rect(x-d,y-d,x+d,y+d)
local rect r2=LoadRectHandle(L7,OB7,StringHash("B820CogRect"))
// local group g1=WS7()
local group g2=LoadGroupHandle(L7,OB7,StringHash("B820CogScan"))
local group g3=LoadGroupHandle(L7,OB7,StringHash("B820CogHits"))
if r2==null then
set r2=Rect(x-d-GOG,y-d-GOG,x+d+GOG,y+d+GOG)
set g2=CreateGroup()
set g3=CreateGroup()
call SaveRectHandle(L7,OB7,StringHash("B820CogRect"),r2)
call SaveGroupHandle(L7,OB7,StringHash("B820CogScan"),g2)
call SaveGroupHandle(L7,OB7,StringHash("B820CogHits"),g3)
endif
call GroupClear(g2)
call GroupClear(g3)
set IN4=WI7
// call GroupEnumUnitsInRect(g1,r1,Condition(function AJ7_gai))
call GroupEnumUnitsInRect(g2,r2,Condition(function AJ7_gai))
// set IQ4=g1
set aL=g3
set IJ4=x
set IK4=y
set IM4=d
set tl=OB7
call ForGroup(g2,function GMG)
set IH4=V77
call ForGroup(g3,function GFG)
// call WR7(g1)
call GroupClear(g2)
call GroupClear(g3)
// call RemoveRect(r1)
// set g1=null
set g2=null
set g3=null
// set r1=null
set r2=null
endfunction
function GPG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local player p=O97(OB7,"p")
local boolean GQG=OO7(OB7,"NeedFix")
call NM7(OB7)
call OZ7(t)
if GQG then
call Y57(p,.2,x,y,500)
endif
set t=null
set p=null
return false
endfunction
function GRG takes unit GJG returns nothing
local real x=GetUnitX(GJG)
local real y=GetUnitY(GJG)
local player p=GetOwningPlayer(GJG)
local unit oA=CreateUnit(p,'u00W',x,y,0)
call KillUnit(oA)
set p=null
set oA=null
endfunction
function Clockwerk_RemoveStoredCog takes unit clockwerkStoredCog returns nothing
if clockwerkStoredCog!=null then
call GRG(clockwerkStoredCog)
call RemoveUnit(clockwerkStoredCog)
call FlushChildHashtable(L7,GetHandleId(clockwerkStoredCog))
endif
endfunction
function GSG takes integer OB7,real x,real y,boolean GQG,player p returns nothing
local unit FLG=O77(OB7,"Cog1")
local unit F1G=O77(OB7,"Cog2")
local unit F0G=O77(OB7,"Cog3")
local unit F5G=O77(OB7,"Cog4")
local unit F2G=O77(OB7,"Cog5")
local unit F_G=O77(OB7,"Cog6")
local unit G4G=O77(OB7,"Cog7")
local unit G7G=O77(OB7,"Cog8")
local trigger t=CreateTrigger()
if LoadRectHandle(L7,OB7,StringHash("B820CogRect"))!=null then
call RemoveRect(LoadRectHandle(L7,OB7,StringHash("B820CogRect")))
call DestroyGroup(LoadGroupHandle(L7,OB7,StringHash("B820CogScan")))
call DestroyGroup(LoadGroupHandle(L7,OB7,StringHash("B820CogHits")))
call RemoveSavedHandle(L7,OB7,StringHash("B820CogRect"))
call RemoveSavedHandle(L7,OB7,StringHash("B820CogScan"))
call RemoveSavedHandle(L7,OB7,StringHash("B820CogHits"))
endif
call TriggerRegisterTimerEvent(t,.1,false)
call TriggerAddCondition(t,Condition(function GPG))
call NQ7(GetHandleId(t),"x",x*1.)
call NQ7(GetHandleId(t),"y",y*1.)
call NZ7(GetHandleId(t),"p",p)
call NS7(GetHandleId(t),"NeedFix",GQG)
call Clockwerk_RemoveStoredCog(FLG)
call Clockwerk_RemoveStoredCog(F1G)
call Clockwerk_RemoveStoredCog(F0G)
call Clockwerk_RemoveStoredCog(F5G)
call Clockwerk_RemoveStoredCog(F2G)
call Clockwerk_RemoveStoredCog(F_G)
call Clockwerk_RemoveStoredCog(G4G)
call Clockwerk_RemoveStoredCog(G7G)
set FLG=null
set F1G=null
set F0G=null
set F5G=null
set F2G=null
set F_G=null
set G4G=null
set G7G=null
endfunction
function GTG takes unit GJG,integer OB7,integer GUG,player p returns nothing
if IsUnitVisible(GJG,p)then
call NS7(OB7,"NeedFix",true)
endif
call MHUnit_SetMoveType(GJG,UNIT_MOVE_TYPE_FOOT)
call MHUnit_SetCollisionType(GJG , UNIT_COLLISION_TYPE_FOOT , UNIT_COLLISION_TYPE_GROUND)
call NT7(OB7,"Cog"+I2S(GUG),GJG)
call NP7(GetHandleId(GJG), "CogIndex", GUG)
call NP7(GetHandleId(GJG), "CogParent", OB7)
endfunction
function GVG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real Hk=ON7(OB7,"Duration")
local integer GYE=GetTriggerEvalCount(t)
// local boolean b=OO7(OB7,"HaveA")
// if b and GYE==300 then
// local boolean b=OO7(OB7,"HaveA")
// if b and GYE==300 then
if GYE==300 then
	call SaveInteger(L7,GetHandleId(O77(OB7,"Hero")),'B0KV',0)
	call SetUnitPhaseMove(O77(OB7,"Hero"),false)
endif
if GYE>R2I(Hk*100)then
call GSG(OB7,ON7(OB7,"x"),ON7(OB7,"y"),OO7(OB7,"NeedFix"),O97(OB7,"Enemy"))
call NM7(OB7)
call OZ7(t)
else
call GNG(t,O77(OB7,"Hero"),ON7(OB7,"x"),ON7(OB7,"y"),ON7(OB7,"d"),OM7(OB7,"Level"))
endif
set t=null
return false
endfunction
function GWG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
call SetUnitX((b1060GetEnumUnit),GetUnitX(IN4))
call SetUnitY((b1060GetEnumUnit),GetUnitY(IN4))
set b1060GetEnumUnit=null
endfunction
function GXG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local integer V77=B287_GetUnitAbilityLevel(WI7,'A0Z5')
local integer ID='u00S'
local real x1=GetUnitX(WI7)
local real y1=GetUnitY(WI7)
local real x2
local real y2
local real d=300
local unit GJG
local real Hk=3+V77
local group g
local rect GYG
local player GZG
local integer NUM=8
local integer i
if TV7(GetOwningPlayer(WI7))then
set GZG=A7[0]
else
set GZG=Z7[0]
endif
call NM7(OB7)
call OZ7(t)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call NS7(OB7,"NeedFix",false)
set i=1
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,1,GZG)
if TZ7(GetOwningPlayer(WI7))then
call NT7(GetHandleId(WI7),"AI|Cog1",GJG)
endif
set i=2
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,2,GZG)
set i=3
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,3,GZG)
if TZ7(GetOwningPlayer(WI7))then
call NT7(GetHandleId(WI7),"AI|Cog2",GJG)
endif
set i=4
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,4,GZG)
set i=5
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,5,GZG)
if TZ7(GetOwningPlayer(WI7))then
call NT7(GetHandleId(WI7),"AI|Cog3",GJG)
endif
set i=6
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,6,GZG)
set i=7
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,7,GZG)
if TZ7(GetOwningPlayer(WI7))then
call NT7(GetHandleId(WI7),"AI|Cog4",GJG)
endif
set i=8
set x2=x1+d*Cos(i*360/NUM*bj_DEGTORAD)
set y2=y1+d*Sin(i*360/NUM*bj_DEGTORAD)
set GJG=CreateUnit(GetOwningPlayer(WI7),ID,x2,y2,0)
call SetUnitPosition(GJG,x2,y2)
call GTG(GJG,OB7,8,GZG)
call TriggerRegisterTimerEvent(t,.01,true)
call TriggerAddCondition(t,Condition(function GVG))
call NQ7(OB7,"Duration",Hk*1.)
call NQ7(OB7,"x",x1*1.)
call NQ7(OB7,"y",y1*1.)
call NQ7(OB7,"d",d*1.)
call NT7(OB7,"Hero",WI7)
call NP7(OB7,"Level",V77)
call NZ7(OB7,"Enemy",GZG)
// call NS7(OB7,"HaveA",b)
set d=d+110
set g=WS7()
set GYG=Rect(x1-d,y1-d,x1+d,y1+d)
set IN4=WI7
call GroupEnumUnitsInRect(g,GYG,Condition(function A_7))
call ForGroup(g,function GWG)
call WR7(g)
call RemoveRect(GYG)
set t=null
set g=null
set WI7=null
set GJG=null
set GYG=null
set GZG=null
return false
endfunction
function GAG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
