return true
endfunction
function N87 takes unit u,string KL7,widget I77 returns boolean
return B947IssueTargetOrder("N87 @ war3map.j:20230 (B968)",u,KL7,I77)and N77(u)
endfunction
function SuijiAI_OrderLogicalSkill takes integer skill returns integer
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
if logicalSkill!=0 then
return logicalSkill
endif
return skill
endfunction
function N97 takes unit x6,integer X5,integer o6 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local integer suijiOrderSkill=SuijiAI_OrderLogicalSkill(o6)
local integer suijiOrderPhysical=B287_GetPhysicalAbilityId(x6,suijiOrderSkill)
if B1120ControlBlocked(x6) then
call B1120OrderTrace(x6,o6,X5,"N97 blocked")
return false
endif
if not B992ChannelUltAllowed(x6,o6) then
return false
endif
if B835AIChannelBlocked(x6) then
return false
endif
if suijiOrderPhysical=='YE1I' then
set X5=OrderId("ancestralspirit")
elseif suijiOrderPhysical=='YE0I' then
set X5=OrderId("frenzy")
elseif suijiOrderPhysical=='YE16' or suijiOrderPhysical=='YE17' then
set X5=OrderId("frenzy")
elseif suijiOrderPhysical=='Y0BE' or suijiOrderPhysical=='Y0FR' or suijiOrderPhysical=='Y0BY' then
// B578 keeps the three random-only transform clones on the same proven
// ANcl/metamorphosis carrier command as the working Y0EP scripted ultimate.
// Original hero objects still retain their native command data.
set X5=OrderId("metamorphosis")
elseif suijiOrderPhysical=='Y0HB' then
set X5=OrderId("berserk")
elseif suijiOrderSkill=='A29L' then
// These older script-owned abilities use isolated Channel base orders in
// object data.  Normalize their legacy/native AI calls to those commands.
set X5=OrderId("resurrection")
elseif suijiOrderSkill=='A1YQ' then
set X5=OrderId("magicdefense")
elseif suijiOrderSkill=='A2O6' or suijiOrderSkill=='A2ZG' then
set X5=OrderId("recharge")
elseif suijiOrderSkill=='A4HK' then
set X5=OrderId("dispel")
elseif suijiOrderSkill=='A2IS' then
set X5=OrderId("frenzy")
elseif suijiOrderSkill=='A2H3' then
set X5=OrderId("polymorph")
elseif suijiOrderSkill=='A2IT' then
set X5=OrderId("invisibility")
elseif suijiOrderSkill=='A2FK' then
set X5=OrderId("web")
elseif suijiOrderSkill=='A0DH' or suijiOrderSkill=='A1OB' then
set X5=OrderId("creepanimatedead")
elseif suijiOrderSkill=='A0GP' then
set X5=OrderId("creepdevour")
elseif suijiOrderSkill=='A14P' then
set X5=OrderId("replenish")
elseif suijiOrderSkill=='A2KU' then
set X5=OrderId("controlmagic")
endif
if SUIJI_AI_CASTING and SUIJI_AI_ORDER_ID!=0 and X5!=SUIJI_AI_ORDER_ID then
return false
endif
if not SuijiAI_AbilityAllowed(o6,0) then
return false
endif
if(not QY4[O5]or o6==0)then
return false
endif
// Poison Nova owns one live base/Scepter button. Resolve and expose only that
// physical button after its real cooldown is ready; never toggle both aliases.
if suijiOrderSkill=='A013' or suijiOrderSkill=='A0A6' then
if LoadReal(L7,GetHandleId(x6),StringHash("B661PoisonNovaAIReadyAt"))>TimerGetElapsed(W) then
return false
endif
if suijiOrderPhysical==0 or GetUnitAbilityLevel(x6,suijiOrderPhysical)<=0 then
set suijiOrderPhysical=B287_GetPhysicalAbilityId(x6,'A0A6')
endif
if suijiOrderPhysical==0 or GetUnitAbilityLevel(x6,suijiOrderPhysical)<=0 then
set suijiOrderPhysical=B287_GetPhysicalAbilityId(x6,'A013')
endif
if B581_AIAbilityReady(x6,suijiOrderPhysical)==false then
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),suijiOrderPhysical,true)
call DisableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 before")
if B947IssueImmediateOrderById("N97 @ war3map.j:20308 (B968)",x6,X5) then
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 ok")
call SaveReal(L7,GetHandleId(x6),StringHash("B661PoisonNovaAIReadyAt"),TimerGetElapsed(W)+1.)
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 failed")
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,true)
call DisableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 before")
if(B947IssueImmediateOrderById("N97 @ war3map.j:20319 (B968)",x6,X5))then
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 ok")
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,suijiOrderSkill,X5,"N97 failed")
if not SUIJI_AI_CASTING then
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,false)
endif
return false
endfunction
function B515_IssueA00S takes unit u returns boolean
local integer playerId=0
if B1120ControlBlocked(u) then
return false
endif
if B835AIChannelBlocked(u) then
return false
endif
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if B287_GetPhysicalAbilityId(u,'A00S')=='A00S' then
// Do not call N97 for the native object: N97 writes command-card visibility
// before and after issuing an order. Native A00S must remain completely
// outside that visibility path, including unchanged "show" writes.
set playerId=GetPlayerId(GetOwningPlayer(u))
if SUIJI_AI_CASTING and SUIJI_AI_ORDER_ID!=0 and SUIJI_AI_ORDER_ID!=852127 then
return false
endif
if not SuijiAI_AbilityAllowed('A00S',0) or not QY4[playerId] then
return false
endif
call DisableTrigger(Q04[16+playerId])
if B947IssueImmediateOrderById("B515_IssueA00S @ war3map.j:20350 (B968)",u,852127) then
call EnableTrigger(Q04[16+playerId])
call SuijiTest_NotifyAICastSuccess(u,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[16+playerId])
return false
endif
return N97(u,852127,'A00S')
endfunction
function N977 takes unit x6,integer X5,integer o6,integer n6 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local integer suijiTideRavagePhysical=0
if B1120ControlBlocked(x6) then
call B1120OrderTrace(x6,o6,X5,"N977 blocked")
return false
endif
if not B992ChannelUltAllowed(x6,o6) or not B992ChannelUltAllowed(x6,n6) then
return false
endif
if B835AIChannelBlocked(x6) then
return false
endif
if SUIJI_AI_CASTING and SUIJI_AI_ORDER_ID!=0 and X5!=SUIJI_AI_ORDER_ID then
return false
endif
if not SuijiAI_AbilityAllowed(o6,n6) then
return false
endif
if(not QY4[O5]or o6==0)then
return false
endif
// Tide Ravage owns one live base/Scepter button. Repeatedly enabling both pair
// rawcodes from the high-frequency AI loop can expose a ready alias and clear
// the command-card cooldown, so issue only through the current physical button.
if o6=='A29I' and n6=='A2UL' then
if LoadReal(L7,GetHandleId(x6),StringHash("SuijiTideRavageReadyAt"))>TimerGetElapsed(W) then
return false
endif
set suijiTideRavagePhysical=B287_GetPhysicalAbilityId(x6,'A29I')
if GetUnitAbilityLevel(x6,suijiTideRavagePhysical)<=0 then
set suijiTideRavagePhysical=B287_GetPhysicalAbilityId(x6,'A2UL')
endif
if B581_AIAbilityReady(x6,suijiTideRavagePhysical)==false then
return false
endif
call DisableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 before")
if B947IssueImmediateOrderById("N977 @ war3map.j:20390 (B968)",x6,X5) then
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 ok")
call SaveReal(L7,GetHandleId(x6),StringHash("SuijiTideRavageReadyAt"),TimerGetElapsed(W)+1.)
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 failed")
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,true)
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),n6,true)
call DisableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 before")
if(B947IssueImmediateOrderById("N977 @ war3map.j:20402 (B968)",x6,X5))then
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 ok")
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[16+O5])
call B1120OrderTrace(x6,o6,X5,"N977 failed")
if not SUIJI_AI_CASTING then
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,false)
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),n6,false)
endif
return false
endfunction
