endfunction
function B962State takes unit u962,string reason962 returns nothing
local integer pid962=GetPlayerId(GetOwningPlayer(u962))
if B946DetectCount==0 or pid962<0 or pid962>=12 then
return
endif
if TimerGetElapsed(W)<B962StateNext[pid962] then
return
endif
if B946DetectCount>0 then
set B962StateNext[pid962]=TimerGetElapsed(W)+2.
endif
if B946DetectCount>0 then
call B960RouteText(u962,reason962+" 生命="+R2S(GetUnitLifePercent(u962))+" 当前命令="+I2S(GetUnitCurrentOrder(u962))+" 后撤点="+B960Node(h9[pid962]))
endif
if B946DetectCount>0 then
call B960RouteText(u962,"后撤状态 G0[32]="+B962FlagLine(0,32+pid962)+"\n    后撤锁 GZ[160]="+B962FlagLine(1,160+pid962))
endif
if B946DetectCount>0 then
call B960RouteText(u962,"进攻许可 G0[128]="+B962FlagLine(0,128+pid962)+"\n    分路调整 G0[240]="+B962FlagLine(0,240+pid962))
endif
endfunction
function B962AvoidText takes unit u962,unit caster962,string branch962 returns nothing
local integer pid962=GetPlayerId(GetOwningPlayer(u962))
if B946DetectCount==0 then
return
endif
if TimerGetElapsed(W)<B962AvoidNext[pid962] and B962AvoidLast[pid962]==B962AvoidSource+branch962 then
return
endif
if B946DetectCount>0 then
set B962AvoidNext[pid962]=TimerGetElapsed(W)+1.
endif
if B946DetectCount>0 then
set B962AvoidLast[pid962]=B962AvoidSource+branch962
endif
if B946DetectCount>0 then
call B960RouteText(u962,"技能避让 "+branch962+" 施法者="+GetUnitName(caster962)+"#"+I2S(GetHandleId(caster962))+"\n    逻辑技能="+GetObjectName(B962AvoidLogical)+"("+I2S(B962AvoidLogical)+") 实际技能="+I2S(B962AvoidPhysical)+"\n    入口："+B962AvoidSource+"\n    距施法者="+R2S(SquareRoot((GetUnitX(u962)-GetUnitX(caster962))*(GetUnitX(u962)-GetUnitX(caster962))+(GetUnitY(u962)-GetUnitY(caster962))*(GetUnitY(u962)-GetUnitY(caster962))))+" 后撤点="+B960Node(h9[GetPlayerId(GetOwningPlayer(u962))]))
endif
endfunction

function B960H8 takes integer pid960,unit target960,string source960 returns unit
if B946DetectCount==0 then
return target960
