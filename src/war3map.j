function T48 takes unit WI7 returns nothing
local trigger damageRegister939=null
if WI7==null or GetUnitTypeId(WI7)==0 then
return
endif
if B939DamageOwners==null then
set B939DamageOwners=InitHashtable()
set B939DamageUnits=CreateGroup()
endif
set damageRegister939=LoadTriggerHandle(B939DamageOwners,GetHandleId(WI7),0)
if damageRegister939==null then
set damageRegister939=CreateTrigger()
call SaveTriggerHandle(B939DamageOwners,GetHandleId(WI7),0,damageRegister939)
call GroupAddUnit(B939DamageUnits,WI7)
call B1023RegisterDamage(damageRegister939,WI7)
call TriggerAddCondition(damageRegister939,Condition(function S58))
endif
call NS7(GetHandleId(WI7),"DamageRegisterAlready",true)
set damageRegister939=null
endfunction
