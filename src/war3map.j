function ul takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit IJ=O77(OB7,"Projectile")
local real hN=ON7(OB7,"TargetX")
local real ho=ON7(OB7,"TargetY")
local real RK=ON7(OB7,"Angle")
local integer id=OM7(OB7,"ID")
local integer level=OM7(OB7,"level")
local real iN=0.
local real io=0.
local real Il=0.
local real IL=0.
local boolexpr hP=null
local group LQ7=null
local unit oA
local unit m5
local real uk
local real uK
local integer BC7
local boolean miranaArrowIsRepeat=false
local real miranaArrowDamage
if WI7==null or IJ==null or GetUnitTypeId(WI7)==0 or GetUnitTypeId(IJ)==0 then
if IJ!=null and GetUnitTypeId(IJ)!=0 then
call KillUnit(IJ)
endif
call Mv(t)
set WI7=null
set IJ=null
set t=null
return
endif
set iN=GetUnitX(IJ)
set io=GetUnitY(IJ)
set Il=X17(iN+40*Cos(RK))
set IL=X07(io+40*Sin(RK))
set hP=Condition(function uj)
set LQ7=WS7()
call SetUnitX(IJ,Il)
call SetUnitY(IJ,IL)
set D8=WI7
call GroupEnumUnitsInRange(LQ7,Il,IL,155,hP)
set m5=FirstOfGroup(LQ7)
call WR7(LQ7)
call DestroyBoolExpr(hP)
if m5!=null then
if IsUnitType(m5,UNIT_TYPE_HERO) then
set SO4[GetPlayerId(GetOwningPlayer(WI7))]=SO4[GetPlayerId(GetOwningPlayer(WI7))]+1
call C27("AA_Hits"+I2S(GetPlayerId(GetOwningPlayer(WI7))),SO4[GetPlayerId(GetOwningPlayer(WI7))])
endif
set uk=ON7(OB7,"OriginalX")
set uK=ON7(OB7,"OriginalY")
// Snapshot belongs to this projectile, not the caster's transient multicast flag.
set miranaArrowIsRepeat=LoadBoolean(L7,OB7,StringHash("MiranaArrowMulticast"))
set miranaArrowDamage=(75*level)+((uJ(uk,uK,iN,io)-1)*14)
if miranaArrowIsRepeat then
set miranaArrowDamage=miranaArrowDamage/3.
else
set oA=CreateUnit(GetOwningPlayer(m5),'e00E',iN,io,0)
call XF7(oA,'A0L7')
call SetUnitAbilityLevel(oA,'A0L7',uJ(uk,uK,iN,io))
call B947IssueTargetOrderById("ul @ war3map.j:78913 (B968)",oA,$D007F,m5)
call UnitApplyTimedLife(oA,'BTLF',1.)
if (IsUnitEnemy(WI7,GetOwningPlayer(m5)) and (GetUnitAbilityLevel(m5,'A04R')==0 and IsUnitType(m5,UNIT_TYPE_STRUCTURE)==false and XH7(m5)==false) and IsUnitType(m5,UNIT_TYPE_ANCIENT)==false or Z_7(m5) and (IsUnitType(m5,UNIT_TYPE_HERO)==false and IsUnitIllusion(m5)==false) and IsMagicImmuneUnit(m5)==false and AS7(m5)==false)!=null then
call SetUnitLifeBJ(m5,10)
if KE7(WI7,m5)>1300 then
set BC7=GetUnitLevel(m5)
call AddHeroXP(WI7,R2I(EEG(BC7)),true)
endif
endif
endif
call B67(WI7,m5,1,miranaArrowDamage)
call KillUnit(IJ)
call R_EXTX(id,WI7,Il,IL)
call Mv(t)
set oA=null
if miranaArrowIsRepeat==false and uJ(uk,uK,iN,io)>1 and UnitAlive(m5) and IsMagicImmuneUnit(m5)==false then
call ZKR(WI7, m5, uJ(uk,uK,iN,io))
endif
elseif(Il-hN)*(Il-hN)+(IL-ho)*(IL-ho)<1600 or BlockUnitPass(IJ) then
call KillUnit(IJ)
call R_EXTX(id,WI7,Il,IL)
call Mv(t)
endif
set WI7=null
set IJ=null
set t=null
set hP=null
set LQ7=null
set m5=null
endfunction
function Get_POM_R_UNIT takes integer id,integer i returns integer
if id=='Z01V' or i==1 then
return 'h105'
elseif id=='Z11V'or i==2 then
return 'h205'
elseif id=='Z21V'or i==3 then
return 'h305'
elseif id=='Z31V'or i==4 then
return 'h405'
elseif id=='Z41V'or i==5 then
return 'h505'
else
return 'h005'
endif
endfunction
function LS9 takes unit WI7,real iN,real io,real RK,integer i,boolean miranaArrowExtra returns nothing
local timer t=CreateTimer()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(WI7)
local unit IJ
local integer skillmj
local integer level=B287_GetUnitAbilityLevel(WI7,'A0L8')
local real d=3000
set d=Labike_ZZMF_Skill_Range(WI7,d)
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
    set d=d+200
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
    set d=d+150
endif
set skillmj=Get_POM_R_UNIT(id,i)
set IJ=CreateUnit(GetOwningPlayer(WI7),skillmj,iN,io,RK*bj_RADTODEG)
set SP4[GetPlayerId(GetOwningPlayer(WI7))]=SP4[GetPlayerId(GetOwningPlayer(WI7))]+1
call C27("AA_Total"+I2S(GetPlayerId(GetOwningPlayer(WI7))),SP4[GetPlayerId(GetOwningPlayer(WI7))])
call SetUnitFacing(IJ,RK*bj_RADTODEG)
call SetUnitPathing(IJ,false)
call NQ7(OB7,"OriginalX",iN)
call NQ7(OB7,"OriginalY",io)
call NQ7(OB7,"TargetX",X17(iN+d*Cos(RK)))
call NQ7(OB7,"TargetY",X07(io+d*Sin(RK)))
call NQ7(OB7,"Angle",RK)
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Projectile",IJ)
call NP7(OB7,"ID",id)
call NP7(OB7,"level",level)
call NS7(OB7,"MiranaArrowMulticast",miranaArrowExtra)
call TimerStart(t,.035,true,function ul)
set t=null
set IJ=null
endfunction
function MiranaArrow_CastEffect takes unit WI7,real hN,real ho,boolean miranaArrowExtra returns nothing
local real iN=X17(GetUnitX(WI7))
local real io=X07(GetUnitY(WI7))
local real RK=Atan2(ho-io,hN-iN)
local integer id=GetUnitTypeId(WI7)
local real a
local real x
local real y
local integer i=0
if id=='Z02X' then
    set i=GetRandomInt(1,5)
endif
call LS9(WI7,iN,io,RK,i,miranaArrowExtra)
if SuijiMode_ScepterRegistryIsActive(WI7,'A0L8') then
    set a=RK*bj_RADTODEG-90
    if a>360 then
        set a=a-360
    elseif a<0 then
        set a=a+360
    endif
    set x=X17(GetUnitX(WI7)+200*Cos(a*bj_DEGTORAD))
    set y=X07(GetUnitY(WI7)+200*Sin(a*bj_DEGTORAD))
    call LS9(WI7,x,y,RK,i,miranaArrowExtra)
    set a=RK*bj_RADTODEG+90
    if a>360 then
        set a=a-360
    elseif a<0 then
        set a=a+360
    endif
    set x=X17(GetUnitX(WI7)+200*Cos(a*bj_DEGTORAD))
    set y=X07(GetUnitY(WI7)+200*Sin(a*bj_DEGTORAD))
    call LS9(WI7,x,y,RK,i,miranaArrowExtra)
endif
set WI7=null
endfunction
