function BPG takes unit ZX7,unit IH7 returns nothing
local unit BB7=CreateUnit(GetOwningPlayer(IH7),'e00E',GetUnitX(IH7),GetUnitY(IH7),0)
local integer AE9=R2I(100*GetUnitState(IH7,UNIT_STATE_LIFE)/GetUnitState(IH7,UNIT_STATE_MAX_LIFE))
local integer BC7=YH7(YG7(R2I(100-AE9)/5,20),1)
call UnitAddAbility(BB7,'A2DV')
call SetUnitAbilityLevel(BB7,'A2DV',BC7)
call B947IssueTargetOrder("BPG @ war3map.j:212421 (B968)",BB7,"slow",IH7)
set BB7=null
endfunction
function BQG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
local real d
if D9==false and((LoadInteger(L7,(GetHandleId(((b1060GetEnumUnit)))),((4349))))==1)==false then
set d=GetUnitState((b1060GetEnumUnit),UNIT_STATE_MAX_LIFE)*.01
call O3O((b1060GetEnumUnit),4348,0.49)
call B67(EQ7,(b1060GetEnumUnit),3,(25+25*ER7+d)*0.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",(b1060GetEnumUnit),"origin"))
call BPG(EQ7,(b1060GetEnumUnit))
endif
set b1060GetEnumUnit=null
endfunction
function BRG takes nothing returns nothing
