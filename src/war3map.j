call SelectUnitAddForPlayer(AR8,GetOwningPlayer(AR8))
elseif GetUnitTypeId(AR8)=='o000' or GetUnitTypeId(AR8)=='o001' or GetUnitTypeId(AR8)=='o00A' or GetUnitTypeId(AR8)=='o00X' or GetUnitTypeId(AR8)=='o021' or GetUnitTypeId(AR8)=='o022'then
call SelectUnitAddForPlayer(AR8,GetOwningPlayer(AR8))
endif
set WI7=null
set AR8=null
endfunction
