function JXSBJ takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
if GetPlayerId(b1060GetTriggerPlayer)!=1 then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "只有玩家1可以使用")
set b1060GetTriggerPlayer=null
return
endif
set XSBJ=not XSBJ
if XSBJ==true then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "已开启骷髅王、PA暴击具体伤害显示")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "已关闭骷髅王、PA暴击具体伤害显示")
endif
set b1060GetTriggerPlayer=null
endfunction
function TXSTRI takes nothing returns boolean 
local trigger t=GetTriggeringTrigger() 
local integer I97=GetHandleId(t) 
local player p=LoadPlayerHandle(TABLE_VV,I97, 0)
local unit u
call DisplayTimedTextToPlayer(p,0,0,4, "数量："+I2S(Dy))
set u=null
set t=null 
set p=null 
return false 
endfunction 
function JXSTRI takes nothing returns nothing
local trigger t
local integer I97
local player p=GetTriggerPlayer()
local integer O5=GetPlayerId(p)
if XSTRI[O5]==0 then
set XSTRI[O5]=1
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true) 
call TriggerAddCondition(t,Condition(function TXSTRI))
call SavePlayerHandle(TABLE_VV,I97, 0, p)
call SaveTriggerHandle(TABLE_VV,GetHandleId(p), 1, t)
call DisplayTextToPlayer(p,0,0, "开启数量显示")
else
set XSTRI[O5]=0
set t=LoadTriggerHandle(TABLE_VV,GetHandleId(p),1)
if t!=null then
call OZ7(t)
endif
call DisplayTextToPlayer(p,0,0, "关闭数量显示")
endif
set t=null
set p=null
endfunction
function JXSID takes nothing returns nothing
