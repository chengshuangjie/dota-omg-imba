function TpSlot_UpdateCursorLocal takes nothing returns nothing
local integer width=DzGetWindowWidth()
local integer height=DzGetWindowHeight()
local real x
local real y
if not TpSlotLocalTargeting or TpSlotCursorFrame==0 or width<=0 or height<=0 then
return
endif
set x=I2R(DzGetMouseXRelative())*.8/I2R(width)+.012
set y=I2R(height-DzGetMouseYRelative())*.6/I2R(height)-.012
if x<.009 then
set x=.009
elseif x>.791 then
set x=.791
endif
if y<.009 then
set y=.009
elseif y>.591 then
set y=.591
endif
call DzFrameClearAllPoints(TpSlotCursorFrame)
call DzFrameSetAbsolutePoint(TpSlotCursorFrame,4,x,y)
endfunction
function TpSlot_SetTargetingLocal takes boolean active returns nothing
set TpSlotLocalTargeting=active
if TpSlotTargetText!=0 then
if active then
call DzFrameSetText(TpSlotTargetText,"|cFF66CCFF选取中|r")
else
call DzFrameSetText(TpSlotTargetText,"|cFFFFFFFFP|r")
endif
endif
if TpSlotCursorFrame!=0 then
call DzFrameShow(TpSlotCursorFrame,active)
if active then
call TpSlot_UpdateCursorLocal()
endif
endif
endfunction
function TpSlot_RequestPointLocal takes real x,real y returns nothing
call TpSlot_SetTargetingLocal(false)
set TpSlotLocalSerial=TpSlotLocalSerial+1
call DzSyncData("tpslot",I2S(TpSlotLocalSerial)+","+I2S(R2I(x*10.))+","+I2S(R2I(y*10.))+",0")
endfunction
function TpSlot_RequestFountainLocal takes nothing returns nothing
local player p=GetLocalPlayer()
local unit fountain=null
if TV7(p) then
set fountain=IZ4
else
set fountain=JA4
endif
call TpSlot_SetTargetingLocal(false)
if fountain==null or GetUnitTypeId(fountain)==0 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00独立TP施放失败：己方泉水当前不可用。|r")
else
set TpSlotLocalSerial=TpSlotLocalSerial+1
call DzSyncData("tpslot",I2S(TpSlotLocalSerial)+","+I2S(R2I(GetUnitX(fountain)*10.))+","+I2S(R2I(GetUnitY(fountain)*10.))+",1")
call DisplayTimedTextToPlayer(p,0,0,2.,"|cFF66CCFF独立TP：|r双击图标，直接传送至己方泉水。")
endif
set fountain=null
set p=null
endfunction
function TpSlot_RequestMinimapPointLocal takes real uiX,real uiY returns boolean
local integer minimap=DzFrameGetMinimap()
local real size=DzFrameGetHeight(minimap)
local real left=.008
local real bottom=.008
local real ratioX
local real ratioY
local real x
local real y
if size<=0. or size>.25 then
set size=.14
endif
if uiX<left or uiX>left+size or uiY<bottom or uiY>bottom+size then
return false
endif
set ratioX=(uiX-left)/size
set ratioY=(uiY-bottom)/size
if ratioX<0. then
set ratioX=0.
elseif ratioX>1. then
set ratioX=1.
endif
if ratioY<0. then
set ratioY=0.
elseif ratioY>1. then
set ratioY=1.
endif
set x=GetRectMinX(bj_mapInitialPlayableArea)+ratioX*(GetRectMaxX(bj_mapInitialPlayableArea)-GetRectMinX(bj_mapInitialPlayableArea))
set y=GetRectMinY(bj_mapInitialPlayableArea)+ratioY*(GetRectMaxY(bj_mapInitialPlayableArea)-GetRectMinY(bj_mapInitialPlayableArea))
call TpSlot_RequestPointLocal(x,y)
return true
endfunction
function TpSlot_OnMouseLeftDown takes nothing returns nothing
local real x
local real y
local real uiX
local real uiY
local integer width
local integer height
if TpSlotLocalTargeting then
set width=DzGetWindowWidth()
set height=DzGetWindowHeight()
if width>0 and height>0 then
set uiX=I2R(DzGetMouseXRelative())*.8/I2R(width)
set uiY=I2R(height-DzGetMouseYRelative())*.6/I2R(height)
endif
// B932: the button center is (.571,.190), size (.026,.026).
// Both clicks belong exclusively to the frame callback, never terrain picking.
if width>0 and height>0 and uiX>=.558 and uiX<=.584 and uiY>=.177 and uiY<=.203 then
return
endif
// Convert a minimap click directly to the current world point. This path must
// not depend on which unit is selected or on a unit receiving a point order.
if width>0 and height>0 and TpSlot_RequestMinimapPointLocal(uiX,uiY) then
return
endif
// DzIsMouseOverUI reports the main world viewport as UI on some KK clients.
// Use the stable console/top-bar bounds instead, so visible terrain and units
// always produce the current cursor point without accepting command-card clicks.
if width>0 and height>0 and (uiY<.145 or uiY>.56) then
return
endif
set x=DzGetMouseTerrainX()
set y=DzGetMouseTerrainY()
call TpSlot_RequestPointLocal(x,y)
endif
endfunction
function TpSlot_OnMouseRightDown takes nothing returns nothing
if TpSlotLocalTargeting then
call TpSlot_SetTargetingLocal(false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,2.,"|cFFFFCC00已取消独立TP选点。|r")
endif
endfunction
