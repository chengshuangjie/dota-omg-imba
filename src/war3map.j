function KKGameTips_UpdateFloatingText takes string floatingTipText returns nothing
if KK_GAME_TIP_TEXTTAG==null or J44==null or GetUnitTypeId(J44)==0 then
return
endif
call SetTextTagText(KK_GAME_TIP_TEXTTAG,"|cFFFFCC00【地图播报】|r\n|cFFFFFFFF"+floatingTipText+"|r",.036)
call SetTextTagPosUnit(KK_GAME_TIP_TEXTTAG,J44,300.)
if not KK_GAME_TIP_TEXT_CLOSED[GetPlayerId(GetLocalPlayer())] then
call SetTextTagVisibility(KK_GAME_TIP_TEXTTAG,true)
endif
endfunction
function KKGameTips_Broadcast takes nothing returns nothing
local string gameTipText
local integer randomGameTipIndex
if KK_GAME_TIP_INDEX<1 or KK_GAME_TIP_INDEX>13 then
set randomGameTipIndex=GetRandomInt(1,13)
else
set randomGameTipIndex=GetRandomInt(1,12)
if randomGameTipIndex>=KK_GAME_TIP_INDEX then
set randomGameTipIndex=randomGameTipIndex+1
endif
endif
set KK_GAME_TIP_INDEX=randomGameTipIndex
set gameTipText=KKGameTips_GetTip(KK_GAME_TIP_INDEX)
call VV7(bj_FORCE_ALL_PLAYERS,10.,"|cFFFFCC00【游戏提示】|r |cFFFFFFFF"+gameTipText+"|r")
call KKGameTips_UpdateFloatingText(KKGameTips_GetFloatingTip(KK_GAME_TIP_INDEX))
set gameTipText=null
endfunction
function KKGameTips_FastFirst takes nothing returns nothing
call KKGameTips_Broadcast()
if KK_GAME_TIP_FAST_MODE then
call TimerStart(KK_GAME_TIP_TIMER,10.,true,function KKGameTips_Broadcast)
endif
endfunction
function KKGameTips_SetFastMode takes boolean fastEnabled returns nothing
local real gameTipElapsed
set KK_GAME_TIP_FAST_MODE=fastEnabled
if KK_GAME_TIP_TIMER==null then
return
endif
if fastEnabled then
set gameTipElapsed=TimerGetElapsed(W)-KK_GAME_TIP_INIT_TIME
if gameTipElapsed<20. then
call TimerStart(KK_GAME_TIP_TIMER,20.-gameTipElapsed,false,function KKGameTips_FastFirst)
else
call TimerStart(KK_GAME_TIP_TIMER,.01,false,function KKGameTips_FastFirst)
endif
else
call TimerStart(KK_GAME_TIP_TIMER,KK_GAME_TIP_INTERVAL,true,function KKGameTips_Broadcast)
endif
endfunction
function KKGameTips_CloseText takes nothing returns nothing
local player closingPlayer=GetTriggerPlayer()
local integer closingPlayerId=GetPlayerId(closingPlayer)
set KK_GAME_TIP_TEXT_CLOSED[closingPlayerId]=true
if GetLocalPlayer()==closingPlayer and KK_GAME_TIP_TEXTTAG!=null then
call SetTextTagVisibility(KK_GAME_TIP_TEXTTAG,false)
endif
call DisplayTimedTextToPlayer(closingPlayer,0,0,8.,"|cFFFFCC00已关闭达拉然秘法圣所上方的地图播报文字。|r")
set closingPlayer=null
endfunction
function KKGameTips_CloseTextInit takes nothing returns nothing
local trigger closeTextTrigger=CreateTrigger()
local integer closeTextPlayerIndex=0
loop
exitwhen closeTextPlayerIndex>11
call TriggerRegisterPlayerChatEvent(closeTextTrigger,Player(closeTextPlayerIndex),"-closetext",true)
set closeTextPlayerIndex=closeTextPlayerIndex+1
endloop
call TriggerAddAction(closeTextTrigger,function KKGameTips_CloseText)
set closeTextTrigger=null
endfunction
function KKGameTips_Init takes nothing returns nothing
set KK_GAME_TIP_TEXTTAG=CreateTextTag()
call SetTextTagText(KK_GAME_TIP_TEXTTAG," ",.036)
call SetTextTagPosUnit(KK_GAME_TIP_TEXTTAG,J44,300.)
call SetTextTagColor(KK_GAME_TIP_TEXTTAG,255,255,255,255)
call SetTextTagVelocity(KK_GAME_TIP_TEXTTAG,0.,0.)
call SetTextTagPermanent(KK_GAME_TIP_TEXTTAG,true)
call SetTextTagVisibility(KK_GAME_TIP_TEXTTAG,false)
set KK_GAME_TIP_TIMER=CreateTimer()
set KK_GAME_TIP_INIT_TIME=TimerGetElapsed(W)
