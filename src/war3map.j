if id=='Zfir' or id=='Zgir' then
call YS7("model\\Hero_ShadowFiend_N8S_R_Missile_1.mdl",u,"origin",1.5)
elseif id=='Zhir' then
call YS7("model\\Hero_ShadowFiend_N4S_R_Missile_1.mdl",u,"origin",1.5)
endif
endif
set u=null
endfunction
