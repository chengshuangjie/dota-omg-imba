call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J5')
call UnitRemoveAbility(p5,'A1IU')
elseif V77==3 then
call UnitRemoveAbility(p5,'A1J4')
call UnitRemoveAbility(p5,'A1J3')
call UnitRemoveAbility(p5,'A1IU')
