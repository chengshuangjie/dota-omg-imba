endif
set P37=false
if((not MS7(it)))then
set P37=true
elseif(MR7(it,ZU[QC]))then
set P67=bj_lastCreatedItem
set P37=true
elseif(MR7(it,ZU[TC]))then
set P67=bj_lastCreatedItem
set P37=true
