if skill=='A1C0' or skill=='A0MP' or skill=='A086' or skill=='A03K' or skill=='ABav' or skill=='ABcr' or skill=='A01Y' or skill=='A09U' then
return true
endif
if skill=='A05C' or skill=='A0JJ' or skill=='A034' or skill=='A030' or skill=='AHfa' or skill=='A025' or skill=='A04Q' or skill=='A0CZ' then
return true
endif
if skill=='A081' or skill=='A0J1' or skill=='A1D7' or skill=='A09V' or skill=='A0MM' or skill=='A1DP' or skill=='A1E6' or skill=='A1AO' then
return true
endif
if skill=='A1UV' or skill=='A0T2' or skill=='A0SS' or skill=='A194' or skill=='A04E' or skill=='A044' or skill=='A06D' or skill=='A1P8' then
return true
