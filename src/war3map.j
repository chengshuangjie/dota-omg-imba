if ChaosObserverBoss==null or XH7(ChaosObserverBoss) then
return
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",ChaosObserverBoss,"origin"))
loop
exitwhen i>5
