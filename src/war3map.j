//泉水
// Spatial candidates are checked at the original tick rate. Active buffs may
// linger outside the radius; keep those units until the engine removes the buff.
function B935TrackRegenSource takes unit regenSource935 returns nothing
if B935FountainSources==null or regenSource935==null or GetUnitTypeId(regenSource935)==0 then
return
endif
if GetUnitAbilityLevel(regenSource935,'A0VL')>0 then
call GroupAddUnit(B935FountainSources,regenSource935)
endif
if GetUnitAbilityLevel(regenSource935,'A32S')>0 or GetUnitAbilityLevel(regenSource935,'A32T')>0 or GetUnitAbilityLevel(regenSource935,'A32U')>0 or GetUnitAbilityLevel(regenSource935,'A32V')>0 then
call GroupAddUnit(B935DefenseSources,regenSource935)
endif
endfunction
function B935DiscoverRegenSource takes nothing returns boolean
call B935TrackRegenSource(GetFilterUnit())
return false
endfunction
function B935HasDefenseRegen takes unit regenMember935 returns boolean
return GetUnitAbilityLevel(regenMember935,'B0I9')>0 or GetUnitAbilityLevel(regenMember935,'B0I8')>0 or GetUnitAbilityLevel(regenMember935,'B0I7')>0 or GetUnitAbilityLevel(regenMember935,'B0HO')>0
endfunction
function B935FountainCandidate takes nothing returns boolean
local unit regenMember935=GetFilterUnit()
if IsUnitInGroup(regenMember935,PlayerUnitGroup) and GetUnitAbilityLevel(regenMember935,'B0KL')>0 then
call GroupAddUnit(B935FountainActive,regenMember935)
endif
set regenMember935=null
return false
endfunction
function B935DefenseCandidate takes nothing returns boolean
local unit regenMember935=GetFilterUnit()
if IsUnitInGroup(regenMember935,PlayerUnitGroup) and B935HasDefenseRegen(regenMember935) then
call GroupAddUnit(B935DefenseActive,regenMember935)
endif
set regenMember935=null
return false
endfunction
function B935ScanFountainSource takes nothing returns nothing
local unit regenSource935=GetEnumUnit()
if regenSource935==null or GetUnitTypeId(regenSource935)==0 or GetUnitAbilityLevel(regenSource935,'A0VL')==0 then
call GroupRemoveUnit(B935FountainSources,regenSource935)
elseif UnitAlive(regenSource935) then
// A0VL area 1200; generous candidate margin, actual buff remains authoritative.
call GroupEnumUnitsInRange(B935RegenScan,GetUnitX(regenSource935),GetUnitY(regenSource935),1800.,Condition(function B935FountainCandidate))
endif
set regenSource935=null
endfunction
function B935ScanDefenseSource takes nothing returns nothing
local unit regenSource935=GetEnumUnit()
if regenSource935==null or GetUnitTypeId(regenSource935)==0 or (GetUnitAbilityLevel(regenSource935,'A32S')==0 and GetUnitAbilityLevel(regenSource935,'A32T')==0 and GetUnitAbilityLevel(regenSource935,'A32U')==0 and GetUnitAbilityLevel(regenSource935,'A32V')==0) then
call GroupRemoveUnit(B935DefenseSources,regenSource935)
elseif UnitAlive(regenSource935) then
// Largest defense aura area 550; keep a margin for collision extents.
call GroupEnumUnitsInRange(B935RegenScan,GetUnitX(regenSource935),GetUnitY(regenSource935),1000.,Condition(function B935DefenseCandidate))
endif
set regenSource935=null
endfunction
function QSHF takes unit u returns nothing
local real LIFE_NOW=GetUnitState(u,UNIT_STATE_LIFE)
local real LIFE_MAX=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real MANA_NOW=GetUnitState(u,UNIT_STATE_MANA)
local real MANA_MAX=GetUnitState(u,UNIT_STATE_MAX_MANA)
local real recover1=0
local real recover2=0
if GetUnitAbilityLevel(u,'B0KL')>0 and (LIFE_NOW!=LIFE_MAX or MANA_NOW!=MANA_MAX) then
set recover1=LIFE_MAX*0.125*0.1
set recover2=MANA_MAX*0.125*0.1
call SetUnitState(u,UNIT_STATE_LIFE,LIFE_NOW+recover1)
call SetUnitState(u,UNIT_STATE_MANA,MANA_NOW+recover2)
call Z57(u,'A4KL', 1, 2,0)
endif
endfunction
function KKBFHeroItems takes nothing returns nothing
local unit ZX7=GetEnumUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 or UnitAlive(ZX7)==false then
set ZX7=null
return
endif
//玩家熊灵不打断
if (IsUnitType(ZX7,UNIT_TYPE_HERO) or (AS7(ZX7) and GetPlayerController(GetOwningPlayer(ZX7))!=MAP_CONTROL_USER)) and IsUnitIllusion(ZX7)==false and GetUnitTypeId(ZX7)!='H00J' then
    //跳刀
    if GetUnitAbilityLevel(ZX7,'Abbk')>0 then
        call A58(ZX7)
    endif
    //秘奥闪光
    if GetUnitAbilityLevel(ZX7,'A2YR')>0 then
        call Set_SG(ZX7)
    endif
    //迅疾闪光
    if GetUnitAbilityLevel(ZX7,'A4HS')>0 then
        call Set_XJSG(ZX7)
    endif
    //盛势闪光
    if GetUnitAbilityLevel(ZX7,'A4HR')>0 then
        call Set_SSSG(ZX7)
    endif
    //龙心
    if B937HasEitherItem(ZX7,ZU[R2],ZU[S2]) then
        call B48(ZX7)
    endif
    //绿鞋
    if B937HasEitherItem(ZX7,ZU[LB],ZU[EC]) then
        call AL8(ZX7)
    endif
endif
set ZX7=null
endfunction
function KKBFFountain takes nothing returns nothing
local unit ZX7=GetEnumUnit()
if ZX7==null or GetUnitTypeId(ZX7)==0 or not UnitAlive(ZX7) or not IsUnitInGroup(ZX7,PlayerUnitGroup) or GetUnitAbilityLevel(ZX7,'B0KL')==0 then
call GroupRemoveUnit(B935FountainActive,ZX7)
set ZX7=null
return
endif
if GetUnitAbilityLevel(ZX7,'B0KL')>0 and IsUnitType(ZX7,UNIT_TYPE_STRUCTURE)==false and (IsUnitType(ZX7,UNIT_TYPE_HERO) or GetUnitAbilityLevel(ZX7,'A04R')==0 or KW7(ZX7) or AS7(ZX7)) then
    call QSHF(ZX7)      //泉水
endif
set ZX7=null
endfunction
function BF8 takes nothing returns boolean
local group g=WS7()
local integer i=0
local unit courier=null
call GroupAddGroup(KKPeriodicHeroItemGroup,g)
call ForGroup(g,function KKBFHeroItems)
call GroupClear(g)
call ForGroup(B935FountainSources,function B935ScanFountainSource)
call GroupAddGroup(B935FountainActive,g)
call ForGroup(g,function KKBFFountain)
call WR7(g)
// Couriers are intentionally excluded from PlayerUnitGroup because many combat
// systems must ignore them.  Process only the one registered courier per player
// here so fountain regeneration does not depend on that combat-group policy.
loop
exitwhen i>$B
set courier=LoadUnitHandle(TABLE_K,GetHandleId(Player(i)),'COUR')
if courier!=null and GetUnitTypeId(courier)!=0 and UnitAlive(courier) and KW7(courier) then
call QSHF(courier)
endif
set i=i+1
endloop
set g=null
set courier=null
return false
endfunction
function BG8 takes nothing returns nothing
local unit WI7=GetFilterUnit()
local integer i=0
local item QU8
local integer Y68
loop
exitwhen i>5
set QU8=UnitItemInSlot(WI7,i)
set Y68=KY7(QU8)
if(Y68==AZ or Y68==BZ or Y68==CZ)and GetItemUserData(QU8)>0 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",WI7,"overhead"))
call XC7(GetOwningPlayer(WI7),"Abilities\\Spells\\Human\\Heal\\HealTarget.wav")
set IR4=GetItemPlayer(QU8)
call KX7(QU8)
set HA4=AY8(WI7,ZU[IA],i)
call SetItemPlayer(HA4,IR4,false)
call SetItemUserData(HA4,1)
endif
set i=i+1
endloop
set WI7=null
set QU8=null
endfunction
function BH8 takes nothing returns boolean
if UnitInventorySize(GetFilterUnit())>0 and TV7(GetOwningPlayer(GetFilterUnit()))and IsUnitIllusion(GetFilterUnit())==false and XH7(GetFilterUnit())==false then
call BG8()
endif
return false
endfunction
function BI8 takes nothing returns boolean
if UnitInventorySize(GetFilterUnit())>0 and TW7(GetOwningPlayer(GetFilterUnit()))and IsUnitIllusion(GetFilterUnit())==false and XH7(GetFilterUnit())==false then
call BG8()
endif
return false
endfunction
function BJ8 takes nothing returns boolean
local group g=WS7()
call GroupEnumUnitsInRange(g,IX4,IY4,750,Condition(function BH8))
call WR7(g)
set g=WS7()
call GroupEnumUnitsInRange(g,JY4,JZ4,750,Condition(function BI8))
call WR7(g)
set g=null
return false
endfunction
function BK8 takes unit u returns unit
if IsUnitType(u,UNIT_TYPE_HERO) or GetUnitAbilityLevel(u,'A04R')==0 then
return u
else
return M7[GetPlayerId(GetOwningPlayer(u))]
endif
endfunction
function BM8 takes nothing returns boolean
local unit b1060GetDyingUnit=GetDyingUnit()
local unit b1060GetKillingUnit=GetKillingUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
if IsUnitType(b1060GetKillingUnit,UNIT_TYPE_STRUCTURE)==false and IsUnitAlly(b1060GetDyingUnit,GetOwningPlayer(b1060GetKillingUnit))==false then
if GetUnitTypeId(b1060GetTriggerUnit)=='n00J' then
call B67(b1060GetDyingUnit,BK8(b1060GetKillingUnit),3,400)
elseif GetUnitTypeId(b1060GetTriggerUnit)=='n00A' then
call B67(b1060GetDyingUnit,BK8(b1060GetKillingUnit),3,500)
elseif GetUnitTypeId(b1060GetTriggerUnit)=='n006' then
call B67(b1060GetDyingUnit,BK8(b1060GetKillingUnit),3,600)
endif
endif
set b1060ReturnValue=false
set b1060GetDyingUnit=null
set b1060GetKillingUnit=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function BN8 takes nothing returns boolean
return GetUnitTypeId(GetEnteringUnit())=='e00E' or GetUnitTypeId(GetEnteringUnit())=='e022'
endfunction
//马甲生命周期设置
function BO8 takes nothing returns nothing
local unit b1060GetEnteringUnit=GetEnteringUnit()
call ShowUnitHide(b1060GetEnteringUnit)
call SetUnitPathing(b1060GetEnteringUnit,false)
call SetUnitInvulnerable(b1060GetEnteringUnit,true)
if(GetPlayerController(GetOwningPlayer(b1060GetEnteringUnit))==MAP_CONTROL_USER)then
call UnitApplyTimedLifeBJ(20.,'BTLF',b1060GetEnteringUnit)
else
//电脑的马甲需要等待，否则会出现例如小小V没效果等问题
call TriggerSleepAction(10.)
call UnitApplyTimedLifeBJ(10.,'BTLF',b1060GetEnteringUnit)
endif
set b1060GetEnteringUnit=null
endfunction
function B1060WaitOwner_BO8 takes nothing returns nothing
local trigger actionOwner1060=GetTriggeringTrigger()
call B1060ActionEnter(actionOwner1060)
call BO8()
call B1060ActionLeave(actionOwner1060)
set actionOwner1060=null
endfunction
function BP8 takes nothing returns boolean
return GetUnitTypeId(GetDyingUnit())=='e00R' or GetUnitTypeId(GetDyingUnit())=='e011' or GetUnitTypeId(GetDyingUnit())=='e00S' or GetUnitTypeId(GetDyingUnit())=='e019'
endfunction
function AX2 takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='ncop' and IsPlayerAlly(GetOwningPlayer(GetFilterUnit()),IR4)==true
endfunction
//刷新防御符文
function AY2 takes unit ZX7 returns nothing
local player p = GetOwningPlayer(ZX7)
local group g=WS7()
local unit u
set IR4=p
call GroupEnumUnitsInRange(g,0,0,99999,Condition(function AX2))
loop
set u=FirstOfGroup(g)
exitwhen FirstOfGroup(g)==null
if GetUnitAbilityLevel(u,'A141')>0 then
call UnitRemoveAbility(u,'A141')
call UnitAddAbility(u,'A141')
else
call UnitRemoveAbility(u,'A1WI')
call UnitAddAbility(u,'A1WI')
endif
call GroupRemoveUnit(g,u)
endloop
call DestroyEffect(tower_rangeeff[LoadInteger(ExtraHT, GetHandleId(ZX7), HTKEY_TOWER_ATTACK_RANGE_EFFECT )])
set tower_rangeeff[LoadInteger(ExtraHT, GetHandleId(ZX7), HTKEY_TOWER_ATTACK_RANGE_EFFECT )] = null
if IsPlayerAlly(GetLocalPlayer(),p)then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,"我方的防御符文冷却时间已刷新")
endif
call WR7(g)
set g=null
set u=null
set p=null
endfunction
function B1008UnlockBase takes unit deadTower1008 returns nothing
// Objective progression must not depend on rewards, statistics or glyph callbacks.
if (deadTower1008==JW_4LT or deadTower1008==JW_4RT) and not UnitAlive(JW_4LT) and not UnitAlive(JW_4RT) and JW_JD!=null and PW4 then
call YT8(JW_JD,false)
set PW4=false
elseif (deadTower1008==TZ_4LT or deadTower1008==TZ_4RT) and not UnitAlive(TZ_4LT) and not UnitAlive(TZ_4RT) and TZ_JD!=null and PX4 then
call YT8(TZ_JD,false)
set PX4=false
endif
endfunction
function BQ8 takes nothing returns nothing
local unit b1060GetDyingUnit=GetDyingUnit()
local unit b1060GetKillingUnit=GetKillingUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
call B1008UnlockBase(b1060GetDyingUnit)
if IsUnitEnemy(b1060GetTriggerUnit,GetOwningPlayer(b1060GetKillingUnit))then
set gD[GetPlayerId(GetOwningPlayer(b1060GetKillingUnit))]=gD[GetPlayerId(GetOwningPlayer(b1060GetKillingUnit))]+1
endif
if(b1060GetDyingUnit==JW_1ST)then
call C27("Tower"+I2S(0)+I2S(1)+I2S(0),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_2ST,false)
call V47(b1060GetKillingUnit,1)
call AY2(b1060GetTriggerUnit)
set P64=1
elseif(b1060GetDyingUnit==JW_1ZT)then
call C27("Tower"+I2S(0)+I2S(1)+I2S(1),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_2ZT,false)
call V47(b1060GetKillingUnit,1)
call AY2(b1060GetTriggerUnit)
set P34=1
elseif(b1060GetDyingUnit==JW_1XT)then
call C27("Tower"+I2S(0)+I2S(1)+I2S(2),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_2XT,false)
call V47(b1060GetKillingUnit,1)
call AY2(b1060GetTriggerUnit)
set PL4=1
elseif(b1060GetDyingUnit==JW_2ST)then
call C27("Tower"+I2S(0)+I2S(2)+I2S(0),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_3ST,false)
call V47(b1060GetKillingUnit,2)
call AY2(b1060GetTriggerUnit)
set P64=2
elseif(b1060GetDyingUnit==JW_2ZT)then
call C27("Tower"+I2S(0)+I2S(2)+I2S(1),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_3ZT,false)
call V47(b1060GetKillingUnit,2)
call AY2(b1060GetTriggerUnit)
set P34=2
elseif(b1060GetDyingUnit==JW_2XT)then
call C27("Tower"+I2S(0)+I2S(2)+I2S(2),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call YT8(JW_3XT,false)
call V47(b1060GetKillingUnit,2)
call AY2(b1060GetTriggerUnit)
set PL4=2
elseif(b1060GetDyingUnit==JW_3ST)then
call C27("Tower"+I2S(0)+I2S(3)+I2S(0),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call V47(b1060GetKillingUnit,3)
call AY2(b1060GetTriggerUnit)
call YT8(JS4,false)
call YT8(JV4,false)
call YT8(JW_4LT,false)
call YT8(JW_4RT,false)
call YT8(WP,false)
call YT8(zP,false)
call YT8(tP,false)
set P64=3
elseif(b1060GetDyingUnit==JW_3ZT)then
call C27("Tower"+I2S(0)+I2S(3)+I2S(1),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call V47(b1060GetKillingUnit,3)
call AY2(b1060GetTriggerUnit)
call YT8(JT4,false)
call YT8(JW4,false)
call YT8(JW_4LT,false)
call YT8(JW_4RT,false)
call YT8(WP,false)
call YT8(zP,false)
call YT8(tP,false)
set P34=3
elseif(b1060GetDyingUnit==JW_3XT)then
call C27("Tower"+I2S(0)+I2S(3)+I2S(2),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call V47(b1060GetKillingUnit,3)
call AY2(b1060GetTriggerUnit)
call YT8(JU4,false)
call YT8(JX4,false)
call YT8(JW_4LT,false)
call YT8(JW_4RT,false)
call YT8(WP,false)
call YT8(zP,false)
call YT8(tP,false)
set PL4=3
endif
if b1060GetDyingUnit==JW_4LT or b1060GetDyingUnit==JW_4RT then
call C27("Tower"+I2S(0)+I2S(4)+I2S(1),GetPlayerId(GetOwningPlayer(b1060GetKillingUnit)))
call V47(b1060GetKillingUnit,4)
call AY2(b1060GetTriggerUnit)
endif
set b1060GetDyingUnit=null
set b1060GetKillingUnit=null
set b1060GetTriggerUnit=null
endfunction
