set earthLifeAfter1099=0.
if GetUnitTypeId(IH7)!=0 then
set earthLifeAfter1099=RMaxBJ(0.,GetWidgetLife(IH7))
endif
set earthHeal1099=RMaxBJ(0.,earthLifeBefore1099-earthLifeAfter1099)
if earthHeal1099>0. then
// Damage refund: do not amplify it again through the skill-heal item pipeline.
call SetWidgetLife(ZX7,RMinBJ(GetUnitState(ZX7,UNIT_STATE_MAX_LIFE),GetWidgetLife(ZX7)+earthHeal1099))
endif
endif
endif
set K7I=ZX7
set IN4=ZX7
