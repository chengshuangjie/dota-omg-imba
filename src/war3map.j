set n=n+1
set UpdateLog[n]="\n- [冰女]冰霜新星可以提供短暂视野\n- [发条]钩子眩晕无视魔免和林肯\n- [谜团]黑洞冷却时间降低\n- [恶魔巫师]穿刺伤害略微提升\n- [小强]地刺伤害略微提升\n- [死亡先知]大幅加强，技能重做，增加神杖效果\n- [疾风剑豪]斩钢闪冷却关联攻速，踏前斩冷却关联敏捷值，狂风绝息斩范围和眩晕关联力量值\n- [巨魔战将]增加神杖效果，最大攻速上限增加至800\n- [电棍]神杖风暴之眼可同时攻击两个目标\n- [大树]增加神杖效果：获得主动技能丛林之眼\n- [拉比克]使用暗牧技能带编织效果，可以偷取强袭飓风和灵动迅捷，快捷键会重置为W和E\n- [亚巴顿]大幅加强，神杖可获得主动技能霜之印记\n"
