function K9G_TRI takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local integer WF8=(LoadInteger(L7,(OB7),(100)))
set WF8=WF8+1
call SaveInteger(L7,(OB7),(100), WF8)
if UnitAlive(ZX7)==false or WF8>=100 then
	call UnitRemoveAbility(ZX7,'A4MK')
	call UnitRemoveAbility(ZX7,'A4MJ')
	call UnitRemoveAbility(ZX7,'B0AY')
	call CHIHUN_GS(ZX7,0)
	call CHIHUN_MS(ZX7,0)
	call RemoveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A18X')
	call RemoveSavedReal(L7,GetHandleId(ZX7),StringHash("SuijiChihunProcTime"))
	call FlushChildHashtable(L7, OB7)
	call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set ZX7=null
endfunction
function SuijiMode_EnsureChihunSkillTables takes nothing returns nothing
if CS3[0]==0 then
set CS3[0]='A4M4'
set CS3[1]='A4M5'
set CS3[2]='A4M6'
set CS3[3]='A4M7'
set CS3[4]='A4M8'
set CS3[5]='A4M9'
call yS(CS3[0])
call yS(CS3[1])
call yS(CS3[2])
call yS(CS3[3])
call yS(CS3[4])
call yS(CS3[5])
endif
if GS3[0]==0 then
set GS3[0]='A4MA'
set GS3[1]='A4MB'
set GS3[2]='A4MC'
set GS3[3]='A4MD'
set GS3[4]='A4ME'
set GS3[5]='A4MF'
set GS3[6]='A4MG'
set GS3[7]='A4MH'
set GS3[8]='A4MI'
call yS(GS3[0])
call yS(GS3[1])
call yS(GS3[2])
call yS(GS3[3])
call yS(GS3[4])
call yS(GS3[5])
call yS(GS3[6])
call yS(GS3[7])
call yS(GS3[8])
endif
endfunction
function SuijiMode_IsChihunRandomCaster takes unit suijiChihunUnit returns boolean
local integer suijiChihunUnitHandle=0
if SUIJI_MODE==false or suijiChihunUnit==null then
return false
endif
set suijiChihunUnitHandle=GetHandleId(suijiChihunUnit)
return OO7(suijiChihunUnitHandle,"SuijiDone") and (OM7(suijiChihunUnitHandle,"SuijiSmallSkill")=='A18X' or OM7(suijiChihunUnitHandle,"SuijiUltSkill")=='A18X')
endfunction
function SuijiMode_MakeChihunRandomBonusesPermanent takes unit suijiChihunUnit returns nothing
local integer suijiChihunIndex=0
if suijiChihunUnit==null then
return
endif
loop
exitwhen suijiChihunIndex>5
if CS3[suijiChihunIndex]!=0 and GetUnitAbilityLevel(suijiChihunUnit,CS3[suijiChihunIndex])>0 then
call UnitMakeAbilityPermanent(suijiChihunUnit,true,CS3[suijiChihunIndex])
endif
set suijiChihunIndex=suijiChihunIndex+1
endloop
set suijiChihunIndex=0
loop
exitwhen suijiChihunIndex>8
if GS3[suijiChihunIndex]!=0 and GetUnitAbilityLevel(suijiChihunUnit,GS3[suijiChihunIndex])>0 then
call UnitMakeAbilityPermanent(suijiChihunUnit,true,GS3[suijiChihunIndex])
endif
set suijiChihunIndex=suijiChihunIndex+1
endloop
endfunction
function SuijiMode_GetChihunRandomLevel takes unit suijiChihunLevelUnit returns integer
local integer suijiChihunRandomLevel=R2I(I2R(GetHeroLevel(suijiChihunLevelUnit))/4.)+1
if suijiChihunRandomLevel<1 then
set suijiChihunRandomLevel=1
endif
if suijiChihunRandomLevel>4 then
set suijiChihunRandomLevel=4
endif
return suijiChihunRandomLevel
endfunction
function K9G takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local integer ZX7Handle=GetHandleId(ZX7)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A18X')
local integer skillbuff
local integer id=GetUnitTypeId(ZX7)
local timer t
local integer OB7
local integer layer=1
local integer gs=0
local integer ms=0
local real suijiChihunNow=TimerGetElapsed(W)
local boolean suijiChihunRandom=SuijiMode_IsChihunRandomCaster(ZX7)
if suijiChihunRandom and ON7(ZX7Handle,"SuijiChihunProcTime")>0. and suijiChihunNow-ON7(ZX7Handle,"SuijiChihunProcTime")<.03 then
set ZX7=null
return
endif
if suijiChihunRandom then
call NQ7(ZX7Handle,"SuijiChihunProcTime",suijiChihunNow)
call SuijiMode_EnsureChihunSkillTables()
endif
if ISLABIKE(ZX7) then
	set level=4
endif
if level<=0 and suijiChihunRandom then
	set level=SuijiMode_GetChihunRandomLevel(ZX7)
endif
if id=='Z004' then
	set skillbuff='A4MK'
else
	set skillbuff='A4MJ'
endif
call Z57(ZX7,skillbuff, 1, 10,'B0AY')
if HaveSavedHandle(TABLE_HY, GetHandleId(ZX7),'A18X') then
	set t=LoadTimerHandle(TABLE_HY, GetHandleId(ZX7),'A18X')
    set OB7=GetHandleId(t)
    call SaveInteger(L7,(OB7),(100), 0)
	set layer=IMinBJ((LoadInteger(L7,(OB7),(10)))+1,3)
	call SaveInteger(L7,(OB7),(10), layer)
else
	set t=CreateTimer()
	set OB7=GetHandleId(t)
	call SaveTimerHandle(TABLE_HY, GetHandleId(ZX7),'A18X', t)
	call SaveUnitHandle(L7,(OB7),(2),(ZX7))
	call SaveInteger(L7,(OB7),(100), 0)
	call SaveInteger(L7,(OB7),(10), layer)
	call TimerStart(t,.1,true,function K9G_TRI)
endif
if level==1 then
	set gs=40
	set ms=5
elseif level==2 then
	set gs=55
	set ms=6
elseif level==3 then
	set gs=70
	set ms=7
elseif level==4 then
	set gs=85
	set ms=8
endif
set gs=gs*layer
set ms=ms*layer
call CHIHUN_GS(ZX7,gs)
call CHIHUN_MS(ZX7,ms)
if suijiChihunRandom then
call SuijiMode_MakeChihunRandomBonusesPermanent(ZX7)
endif
set t=null
set ZX7=null
endfunction
//炽魂
function SuijiMode_CanChihunProcBySkill takes integer suijiChihunSkill returns boolean
if suijiChihunSkill==0 then
return false
endif
return LC7(suijiChihunSkill)==false and L67(suijiChihunSkill)==false and UL7(suijiChihunSkill)
endfunction
function SuijiMode_IsNativeChihunProcSkill takes integer suijiChihunSkill returns boolean
return suijiChihunSkill=='A01F' or suijiChihunSkill=='A027' or suijiChihunSkill=='A01P' or suijiChihunSkill=='A09Z'
endfunction
function KDG takes nothing returns boolean
local unit suijiChihunCaster=GetTriggerUnit()
local integer suijiChihunSkill=B287_GetSpellAbilityId()
if ISPH(suijiChihunCaster)==false and SuijiMode_IsChihunRandomCaster(suijiChihunCaster)==false and (B287_GetUnitAbilityLevel(suijiChihunCaster,'A18X')>0 or ISLABIKE(suijiChihunCaster)) and SuijiMode_IsNativeChihunProcSkill(suijiChihunSkill) then
call K9G()
endif
set suijiChihunCaster=null
return false
endfunction
function SuijiMode_ChihunRandomOnSpell takes nothing returns boolean
local unit suijiChihunUnit=GetTriggerUnit()
local integer suijiChihunSkill=B287_GetSpellAbilityId()
local item suijiChihunSourceItem=null
if SUIJI_MODE and ISPH(suijiChihunUnit)==false and SuijiMode_IsChihunRandomCaster(suijiChihunUnit) and B287_GetUnitAbilityLevel(suijiChihunUnit,suijiChihunSkill)>0 and SuijiMode_CanChihunProcBySkill(suijiChihunSkill) then
set suijiChihunSourceItem=B945SourceItem(suijiChihunUnit,B287_GetPhysicalAbilityId(suijiChihunUnit,suijiChihunSkill))
if suijiChihunSourceItem==null then
call K9G()
endif
endif
set suijiChihunUnit=null
set suijiChihunSourceItem=null
return false
endfunction
