function RMF takes nothing returns nothing
local unit m5=GetEnumUnit()
local group T69=pw
local unit p5=qw
if IsUnitInGroup(m5,T69)==false then
call GroupAddUnit(T69,m5)
call B947IssueTargetOrderById("RMF @ war3map.j:160853 (B968)",Qw,$D006B,m5)
set E97=true
call B67(p5,m5,1,200)
set E97=false
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",m5,"origin"))
endif
set m5=null
set T69=null
set p5=null
endfunction
function RNF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit BB7=O77(OB7,"Caster")
local group T69=OF7(OB7,"AlreadyDamaged")
local real d
local real x
local real x0=GetUnitX(p5)
local real y
local real y0=GetUnitY(p5)
local group g=WS7()
local integer SV9=GetTriggerEvalCount(t)
local integer i
call SetUnitX(BB7,GetUnitX(p5))
call SetUnitY(BB7,GetUnitY(p5))
set pw=T69
set qw=p5
set Qw=O77(OB7,"Nuker")
if GetTriggerEvalCount(t)>33 then
call KillUnit(BB7)
call WR7(T69)
call NM7(OB7)
call OZ7(t)
else
set d=SV9*18
set i=0
loop
exitwhen i>36
set x=x0+d*Cos(360*i/ 36*bj_DEGTORAD)
set y=y0+d*Sin(360*i/ 36*bj_DEGTORAD)
set IN4=p5
call GroupEnumUnitsInRange(g,x,y,$96,Condition(function AX7))
call ForGroup(g,function RMF)
set i=i+1
endloop
endif
call WR7(g)
set t=null
set BB7=null
set T69=null
set p5=null
set g=null
return false
endfunction
function ROF takes unit WI7 returns nothing
local real x=GetUnitX(WI7)
local real y=GetUnitY(WI7)
local group T69=WS7()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit BB7=CreateUnit(GetOwningPlayer(WI7),'h091',x,y,0)
local unit RPF=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(WI7),GetUnitY(WI7),0)
call UnitAddAbility(RPF,'A0T0')
call NB7(OB7,"AlreadyDamaged",T69)
call NT7(OB7,"Caster",BB7)
call NT7(OB7,"Nuker",RPF)
call NT7(OB7,"Source",WI7)
call TriggerRegisterTimerEvent(t,.06,true)
call TriggerAddCondition(t,Condition(function RNF))
set t=null
set T69=null
set BB7=null
set RPF=null
endfunction
function MUL_BJ2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer E1D=OM7(OB7,"Iterations")
if GetTriggerEvalCount(t)>E1D then
call NM7(OB7)
call OZ7(t)
else
call ROF(p5)
endif
set t=null
set p5=null
return false
endfunction
function MUL_BJ takes unit WI7,integer r returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
if r==2 then
call YW7(GetObjectName('n0K7'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==3 then
call YW7(GetObjectName('n0JT'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==4 then
call YW7(GetObjectName('n0K8'),5,b1060GetTriggerUnit,.03,255,0,0,255)
elseif r==5 then
call YW7(GetObjectName('n0JO'),5,b1060GetTriggerUnit,.03,255,0,0,255)
endif
call NT7(OB7,"Source",WI7)
call NP7(OB7,"Iterations",r)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerAddCondition(t,Condition(function MUL_BJ2))
set t=null
set b1060GetTriggerUnit=null
endfunction
//冰甲
function RQF takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer r
if B287_GetSpellAbilityId()=='A0T9' then
if (GetUnitTypeId(b1060GetTriggerUnit)=='Hmkg' or (SUIJI_MODE and OO7(GetHandleId(b1060GetTriggerUnit),"SuijiDone") and OO7(GetHandleId(b1060GetTriggerUnit),"SuijiMulticast"))) and B287_GetUnitAbilityLevel(b1060GetTriggerUnit,'A088')>0 and ISPH(b1060GetTriggerUnit)==false then
set r=EUD(b1060GetTriggerUnit)
if r>1 then
call MUL_BJ(b1060GetTriggerUnit,r)
else
call ROF(b1060GetTriggerUnit)
endif
else
call ROF(b1060GetTriggerUnit)
endif
endif
set b1060GetTriggerUnit=null
endfunction
function RRF takes unit ZX7,integer N5E returns nothing
local integer I97=GetHandleId(ZX7)
call SaveInteger(L7,(I97),(750),(N5E))
endfunction
//魔棒
function RSF takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local integer i=0
local integer RTF=0
local boolean RUF=false
local real d
if B287_GetSpellAbilityId()=='A0JY' then
loop
exitwhen i>5
if KZ7(UnitItemInSlot(b1060GetTriggerUnit,i))==ZA or KZ7(UnitItemInSlot(b1060GetTriggerUnit,i))==DT4 then
set RTF=GetItemCharges(UnitItemInSlot(b1060GetTriggerUnit,i))
if RTF>0 then
call SetItemCharges(UnitItemInSlot(b1060GetTriggerUnit,i),0)
call RRF(b1060GetTriggerUnit,0)
if RUF==false then
set RUF=true
set d=DGH_BUFF(b1060GetTriggerUnit)
if GetUnitState(b1060GetTriggerUnit,UNIT_STATE_LIFE)!=GetUnitState(b1060GetTriggerUnit,UNIT_STATE_MAX_LIFE) then
call HXXS("+"+I2S(R2I(15*RTF*d)),1,b1060GetTriggerUnit,.03)
endif
call SetUnitState(b1060GetTriggerUnit,UNIT_STATE_MANA,GetUnitState(b1060GetTriggerUnit,UNIT_STATE_MANA)+15*RTF*d)
call SetUnitState(b1060GetTriggerUnit,UNIT_STATE_LIFE,GetUnitState(b1060GetTriggerUnit,UNIT_STATE_LIFE)+15*RTF*d)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",b1060GetTriggerUnit,"origin"))
endif
endif
set b1060GetTriggerUnit=null
return
endif
set i=i+1
endloop
endif
set b1060GetTriggerUnit=null
endfunction
function RVF takes integer id returns boolean
local integer i=1
loop
exitwhen i>MC4
if id==MB4[i]then
return false
endif
set i=i+1
endloop
return true
endfunction
function RWF takes unit RXF,unit p5 returns nothing
if IsUnitVisible(RXF,GetOwningPlayer(p5))==false and GetRandomInt(1,100)<$A then
call PlaySoundOnUnitBJ(RI,100,p5)
endif
endfunction
function RYF takes nothing returns nothing
local unit b1060GetTriggerUnit=GetTriggerUnit()
local unit WI7=GetEnumUnit()
local integer i=0
loop
exitwhen i>5
if IsUnitVisible(b1060GetTriggerUnit,GetOwningPlayer(GetEnumUnit())) then
if KZ7(UnitItemInSlot(WI7,i))==ZA or KZ7(UnitItemInSlot(WI7,i))==DT4 then
if KZ7(UnitItemInSlot(WI7,i))==DT4 then
if GetItemCharges(UnitItemInSlot(WI7,i))==$11 then
call RWF(b1060GetTriggerUnit,WI7)
endif
call RRF(WI7,YG7(GetItemCharges(UnitItemInSlot(WI7,i))+1,$11))
call SetItemCharges(UnitItemInSlot(WI7,i),YG7(GetItemCharges(UnitItemInSlot(WI7,i))+1,$11))
else
if GetItemCharges(UnitItemInSlot(WI7,i))==$A then
call RWF(b1060GetTriggerUnit,WI7)
endif
call RRF(WI7,YG7(GetItemCharges(UnitItemInSlot(WI7,i))+1,$A))
call SetItemCharges(UnitItemInSlot(WI7,i),YG7(GetItemCharges(UnitItemInSlot(WI7,i))+1,$A))
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl",WI7,"chest"))
set i=5
endif
endif
set i=i+1
endloop
set WI7=null
set b1060GetTriggerUnit=null
endfunction
function RZF takes nothing returns nothing
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local group g=WS7()
local unit p5=(b1061SavedGetTriggerUnit)
local real x=GetUnitX(p5)
local real y=GetUnitY(p5)
call GroupEnumUnitsInRange(g,x,y,$4C9,Condition(function A57))
call ForGroup(g,function RYF)
call WR7(g)
set g=null
set p5=null
set b1061SavedGetTriggerUnit=null
endfunction
function RAF takes nothing returns nothing
if RVF(B287_GetSpellAbilityId()) and B291_IsRealSpellCast(GetTriggerUnit(),B287_GetSpellAbilityId()) and UL7(B287_GetSpellAbilityId()) and GetUnitAbilityLevel(GetTriggerUnit(),'A04R')==0 then
call RZF()
endif
endfunction
function XGSY takes unit ZX7,unit m5 returns nothing
local integer V77=B287_GetUnitAbilityLevel(ZX7,'A0SS')
local real YM7=(.03+.01*V77)*GetUnitState(m5,UNIT_STATE_LIFE)
local real d=DGH_BUFF(ZX7)
local integer id=GetUnitTypeId(ZX7)
local string tx
if id=='Z00C' then
    set tx="model\\Hero_Lifestealer_N2S_F_Recover.mdl"
else
    set tx="Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl"
endif
if GetUnitAbilityLevel(m5,'A04R')==0 then
if(GetUnitState(m5,UNIT_STATE_LIFE)/GetUnitState(m5,UNIT_STATE_MAX_LIFE))>=.33 then
call B67(ZX7,m5,2,YM7)
endif
if(GetUnitState(m5,UNIT_STATE_LIFE)/GetUnitState(m5,UNIT_STATE_MAX_LIFE))<.33 then
call B67(ZX7,m5,20,YM7)
endif
call SetUnitState(ZX7,UNIT_STATE_LIFE,YM7*d+GetUnitState(ZX7,UNIT_STATE_LIFE))
call DestroyEffect(AddSpecialEffectTarget(tx,ZX7,"origin"))
endif
endfunction
