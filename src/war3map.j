set count1071=LoadInteger(LocalHashTable,0,StringHash("B1071ImpaleLog"))
if count1071>=80 then
return
endif
call SaveInteger(LocalHashTable,0,StringHash("B1071ImpaleLog"),count1071+1)
call DisplayTimedTextToPlayer(Le,0,0,20.,"[CONTROL "+phase1071+"] "+GetUnitName(controlTarget1071)+" id="+I2S(GetHandleId(controlTarget1071))+" pause="+I2S(LoadInteger(ExtraHT,GetHandleId(controlTarget1071),HTKEY_UNIT_PAUSE_COUINT))+" height="+R2S(GetUnitFlyHeight(controlTarget1071)))
endfunction
function GXE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit WI7=O77(OB7,"Hero")
local integer GYE=GetTriggerEvalCount(t)
local real y=(GYE-$D)*(GYE-$D)
if GYE<26 then
if KCD(WI7)==false then
call SetUnitFlyHeight(WI7,375-y,0)
endif
else
//call PauseUnit(WI7,false)
call PauseUnitEx(WI7,false)
if KCD(WI7)==false then
call SetUnitFlyHeight(WI7,GetUnitDefaultFlyHeight(WI7),0)
endif
call B1071ImpaleLog(WI7,"land")
call B67(p5,WI7,1,ON7(OB7,"Damage"))
call BA7(p5,WI7,ON7(OB7,"Duration"))
if LoadInteger(ExtraHT, 'A4I2', GetHandleId(p5))==1 then
    set FSDSOURCE=p5
    set FSDTARGET=WI7
    call ExecuteFunc("SJA_JDCC")
endif
if LoadInteger(ExtraHT, 'HMRS', GetHandleId(p5))==1 and GetPlayerController(GetOwningPlayer(p5))==MAP_CONTROL_COMPUTER then
    if IsUnitType(WI7,UNIT_TYPE_HERO) and UnitAlive(WI7) then
        call SaveInteger(ExtraHT,'HMRC',GetHandleId(p5),LoadInteger(ExtraHT,'HMRC',GetHandleId(p5))+1)
    endif
endif
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set p5=null
return false
endfunction
function GZE takes unit WI7,unit p5,real Hk,real GAE,real GBE returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(p5)
local string tx
//call PauseUnit(WI7,true)
call PauseUnitEx(WI7,true)
call B1071ImpaleLog(WI7,"lift")
if KCD(WI7)==false then
call UnitAddAbility(WI7,'Amrf')
call UnitRemoveAbility(WI7,'Amrf')
endif
//地刺击中特效
if id=='Z00K' then
    set tx="model\\hero_sandking_n11s_e_target.mdl"
elseif id=='ZC18' then
    set tx="model\\hero_demonwitch_n5s_e_target.mdl"
else
    set tx="Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl"
endif
call DestroyEffect(AddSpecialEffect(tx,GetUnitX(WI7),GetUnitY(WI7)))
call NT7(OB7,"Hero",WI7)
call NT7(OB7,"Source",p5)
call NQ7(OB7,"Damage",GAE)
call NQ7(OB7,"Duration",Hk)
call TriggerRegisterTimerEvent(t,.02/ .52*GBE,true)
call TriggerAddCondition(t,Condition(function GXE))
set t=null
endfunction
function GCE takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),IQ4)==false and WF7((b1060GetEnumUnit))==false and CHUIFENG((b1060GetEnumUnit))==false and OT7((b1060GetEnumUnit),"Omnislashing")==false then
call GroupAddUnit(IQ4,(b1060GetEnumUnit))
call GZE((b1060GetEnumUnit),IN4,IK4,IJ4,IM4)
endif
set b1060GetEnumUnit=null
endfunction
function G3E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local real GAE=ON7(OB7,"damage")
local real Hk=ON7(OB7,"duration")
local real x1=ON7(OB7,"x1")
local real y1=ON7(OB7,"y1")
local real x2=ON7(OB7,"x2")
local real y2=ON7(OB7,"y2")
local real w=ON7(OB7,"w")
local real G6E=ON7(OB7,"TempReal")
local real a=Atan2(y2-y1,x2-x1)
local group g=OF7(OB7,"g")
local group GLE=WS7()
local boolexpr ravageFilter=null
local real GBE=G6E*.0625
local real G1E=ON7(OB7,"LastFX_x")
local real G0E=ON7(OB7,"LastFX_y")
local real G5E=ON7(OB7,"FX_Interval")
local real G2E=ON7(OB7,"airtime")
local integer id=OM7(OB7,"id")
local string tx
if GBE>KF7(x1,y1,x2,y2)then
set x1=x2
set y1=y2
else
set x1=x1+GBE*Cos(a)
set y1=y1+GBE*Sin(a)
endif
set IN4=p5
set IJ4=GAE
set IK4=Hk
set IM4=G2E
set IQ4=g
set ravageFilter=Condition(function AJ7_gai)
call GroupEnumUnitsInRange(GLE,x1,y1,w,ravageFilter)
call DestroyBoolExpr(ravageFilter)
set ravageFilter=null
call ForGroup(GLE,function GCE)
call WR7(GLE)
if KF7(x1,y1,G1E,G0E)>=G5E then
call NQ7(OB7,"LastFX_x",x1)
call NQ7(OB7,"LastFX_y",y1)
//地刺特效
if id=='Z00K' then
    set tx="model\\hero_sandking_n11s_e_misslie.mdl"
elseif id=='Z10K' then
    set tx="AZModel\\AZ_SKcrystal_E_Misslie.mdl"
elseif id=='ZC18' then
    set tx="model\\hero_demonwitch_n5s_e_stab.mdl"
else
    set tx="Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl"
endif
call DestroyEffect(AddSpecialEffect(tx,x1,y1))
endif
call NQ7(OB7,"x1",x1)
call NQ7(OB7,"y1",y1)
if x1==x2 and y1==y2 then
if OO7(OB7,"destroyGroup") then
call WR7(g)
endif
call NM7(OB7)
call OZ7(t)
endif
set g=null
set GLE=null
set ravageFilter=null
set p5=null
set t=null
return false
endfunction
function G_E takes real H4E,real H7E returns integer
if H4E/ H7E-R2I(H4E/ H7E)>=.5 then
return R2I(H4E/ H7E)+1
endif
return R2I(H4E/ H7E)
endfunction
function H8E takes unit p5,unit m5,real GAE,real Hk,real G2E,real x1,real y1,real x2,real y2,real w,group H9E,boolean HDE,real G6E returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real HEE
local integer HFE
local real G5E
local group g
local integer id=GetUnitTypeId(p5)
local real ON=150 //地刺间隔
if id=='Z00K' or id=='Z10K' then
    set ON=75
endif
if Hk==2.17 and SuijiMode_HasAghanimState(p5) then
    call SaveInteger(ExtraHT, 'A4I2', GetHandleId(p5), 1)
else
    call SaveInteger(ExtraHT, 'A4I2', GetHandleId(p5), 0)
endif
if G2E==.75 and GetPlayerController(GetOwningPlayer(p5))==MAP_CONTROL_COMPUTER then //AI潮汐大
    call SaveInteger(ExtraHT, 'HMRS', GetHandleId(p5), 1)
endif
set HEE=KF7(x1,y1,x2,y2)
set HFE=G_E(HEE,ON)
set G5E=HEE/HFE
call NT7(OB7,"Source",p5)
call NQ7(OB7,"damage",GAE)
call NQ7(OB7,"duration",Hk)
call NQ7(OB7,"airtime",G2E)
call NQ7(OB7,"x1",x1)
call NQ7(OB7,"y1",y1)
call NQ7(OB7,"x2",x2)
call NQ7(OB7,"y2",y2)
call NQ7(OB7,"w",w)
call NQ7(OB7,"TempReal",G6E)
call NP7(OB7,"id",id)
if H9E==null then
set g=WS7()
if m5!=null and IsUnitIllusion(m5)==false then
call GroupAddUnit(g,m5)
endif
call NB7(OB7,"g",g)
call NS7(OB7,"destroyGroup",HDE)
else
call NB7(OB7,"g",H9E)
call NS7(OB7,"destroyGroup",HDE)
endif
call NQ7(OB7,"FX_Interval",G5E)
call NQ7(OB7,"LastFX_x",x1)
call NQ7(OB7,"LastFX_y",y1)
call TriggerRegisterTimerEvent(t,.0625,true)
call TriggerAddCondition(t,Condition(function G3E))
set t=null
set g=null
endfunction
function HGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
//call SetUnitPosition(WI7,x,y)
call SetUnitX(WI7,x)
call SetUnitY(WI7,y)
call SetUnitAnimation(WI7,"morph ALTERNATE")
call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
return false
endfunction
function HHE takes nothing returns nothing
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit WI7=GetTriggerUnit()
local integer skill=b1060B287_GetSpellAbilityId
local integer V77=B287_GetUnitAbilityLevel(WI7,skill)
local location l
local real HIE
local real x=GetUnitX(WI7)
local real y=GetUnitY(WI7)
local real HJE
local real HKE
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real YM7
local real Hk=2.17
local unit m5=null
// if GetPlayerController(GetOwningPlayer(WI7))!=MAP_CONTROL_COMPUTER and X8==false then
//     if YDWEGetUnitAbilityDataReal(WI7,skill,V77,ABILITY_DATA_DATA_E)!=0 then
//         call YDWESetUnitAbilityDataReal(WI7, skill, 1, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 2, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 3, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 4, ABILITY_DATA_DATA_E, 0)
//     endif
// endif
// if GetPlayerController(GetOwningPlayer(WI7))!=MAP_CONTROL_COMPUTER and X8==false then
//     if YDWEGetUnitAbilityDataReal(WI7,skill,V77,ABILITY_DATA_DATA_E)!=0 then
//         call YDWESetUnitAbilityDataReal(WI7, skill, 1, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 2, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 3, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 4, ABILITY_DATA_DATA_E, 0)
//     endif
// endif
// if GetPlayerController(GetOwningPlayer(WI7))!=MAP_CONTROL_COMPUTER and X8==false then
//     if YDWEGetUnitAbilityDataReal(WI7,skill,V77,ABILITY_DATA_DATA_E)!=0 then
//         call YDWESetUnitAbilityDataReal(WI7, skill, 1, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 2, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 3, ABILITY_DATA_DATA_E, 0)
//         call YDWESetUnitAbilityDataReal(WI7, skill, 4, ABILITY_DATA_DATA_E, 0)
//     endif
// endif
if V77==1 then
set YM7=100
elseif V77==2 then
set YM7=$A0
elseif V77==3 then
set YM7=$DC
elseif V77==4 then
set YM7=280
endif
if b1060GetSpellTargetUnit!=null then
set l=GetUnitLoc(b1060GetSpellTargetUnit)
else
set l=GetSpellTargetLoc()
endif
set HJE=GetLocationX(l)
set HKE=GetLocationY(l)
call RemoveLocation(l)
set HJE=x+(HJE-x)*B290_GetDisplacementMulticastCount(WI7,b1060B287_GetSpellAbilityId)
set HKE=y+(HKE-y)*B290_GetDisplacementMulticastCount(WI7,b1060B287_GetSpellAbilityId)
set HIE=J77(x,y,HJE,HKE)
call NT7(OB7,"Hero",WI7)
call NQ7(OB7,"x",HJE)
call NQ7(OB7,"y",HKE)
call TriggerRegisterTimerEvent(t,KF7(x,y,HJE,HKE)/2000,false)
call TriggerAddCondition(t,Condition(function HGE))
if KF7(x,y,HJE,HKE)<$96 then
set HJE=x+$96*Cos(HIE*bj_DEGTORAD)
set HKE=y+$96*Sin(HIE*bj_DEGTORAD)
endif
if b1060GetSpellTargetUnit!=null and WQ7(b1060GetSpellTargetUnit)then
set m5=b1060GetSpellTargetUnit
endif
call H8E(WI7,m5,YM7,Hk,.52,x,y,HJE,HKE,$AF,null,true,$640)
set l=null
set WI7=null
set t=null
set m5=null
set b1060GetSpellTargetUnit=null
endfunction
function HOE takes nothing returns boolean
if B287_GetSpellAbilityId()=='A06O' or B287_GetSpellAbilityId()=='A4I2' then
call HHE()
endif
return false
endfunction
function IP8 takes nothing returns nothing
local trigger t
if SUIJI_SANDKING_IMPALE_INIT_READY then
return
endif
set t=CreateTrigger()
set SUIJI_SANDKING_IMPALE_INIT_READY=true
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function HOE))
set t=null
endfunction
function HPE takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
call B67(e0,(b1060GetEnumUnit),1,110)
if GetPlayerController(GetOwningPlayer(o0))==MAP_CONTROL_COMPUTER then
call UnitAddAbility(o0,'A17B')
endif
call B947IssueTargetOrderById("HPE @ war3map.j:107129 (B968)",o0,$D006B,(b1060GetEnumUnit))
set b1060GetEnumUnit=null
endfunction
//沙王地震
function HQE takes unit p5,unit pulseDummy,real x,real y,integer V77,integer HRE returns nothing
local group g=WS7()
local real r
local string fx
local boolexpr sandKingEpicenterFilter=null
if HRE==8 then
set r=850
elseif HRE==9 then
set r=900
elseif HRE>=$A then
set r=450+50*HRE
else
set r=450+50*HRE
endif
if GetUnitTypeId(p5)=='Z00K' then
    if HRE<4 then
        set fx="model\\hero_sandking_n11s_c_small.mdx"
    elseif HRE<8 then
        set fx="model\\hero_sandking_n11s_c_midium.mdx"
    else
        set fx="model\\hero_sandking_n11s_c_big.mdx"
    endif
elseif GetUnitTypeId(p5)=='Z10K' then
    if HRE<4 then
        set fx="AZModel\\AZ_SKcrystal_C1_4.mdl"
    elseif HRE<8 then
        set fx="AZModel\\AZ_SKcrystal_C5_8.mdl"
    else
        set fx="AZModel\\AZ_SKcrystal_C9_12.mdl"
    endif
else
    if HRE<4 then
        set fx="war3mapImported\\EpiPulse_1_4.mdx"
    elseif HRE<8 then
        set fx="war3mapImported\\EpiPulse_5_8.mdx"
    else
        set fx="war3mapImported\\EpiPulse_9_12.mdx"
    endif
endif
call DestroyEffect(AddSpecialEffect(fx,x,y))
if GetUnitTypeId(p5)=='Z00K' then
if HRE<4 then
set fx="model\\hero_sandking_n11s_c_small_crack.mdx"
elseif HRE<8 then
set fx="model\\hero_sandking_n11s_c_midium_crack.mdx"
else
set fx="model\\hero_sandking_n11s_c_big_crack.mdx"
endif
call DestroyEffect(AddSpecialEffect(fx,x,y))
endif
set IN4=p5
set e0=p5
set o0=pulseDummy
set sandKingEpicenterFilter=Condition(function AJ7_gai)
call GroupEnumUnitsInRange(g,x,y,r,sandKingEpicenterFilter)
call ForGroup(g,function HPE)
call DestroyBoolExpr(sandKingEpicenterFilter)
call WR7(g)
call nm(.03,false,x,y,450+50*HRE,450+50*HRE,72,.03,512)
set g=null
set sandKingEpicenterFilter=null
endfunction
function SuijiMode_SandKingEpicenterCanStart takes unit suijiSandKingEpicenterUnit returns boolean
local integer suijiSandKingEpicenterHandle=0
local real suijiSandKingEpicenterNow=TimerGetElapsed(W)
if SUIJI_MODE==false or suijiSandKingEpicenterUnit==null then
return true
endif
set suijiSandKingEpicenterHandle=GetHandleId(suijiSandKingEpicenterUnit)
if LoadTriggerHandle(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterTrigger"))!=null or LoadReal(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterActiveUntil"))>suijiSandKingEpicenterNow then
return false
endif
call SaveReal(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterActiveUntil"),suijiSandKingEpicenterNow+8.)
return true
endfunction
function SuijiMode_SandKingEpicenterStoreActive takes unit suijiSandKingEpicenterUnit,trigger suijiSandKingEpicenterTrigger returns nothing
local integer suijiSandKingEpicenterHandle=0
if SUIJI_MODE==false or suijiSandKingEpicenterUnit==null then
return
endif
set suijiSandKingEpicenterHandle=GetHandleId(suijiSandKingEpicenterUnit)
call SaveTriggerHandle(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterTrigger"),suijiSandKingEpicenterTrigger)
call SaveReal(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterActiveUntil"),TimerGetElapsed(W)+8.)
endfunction
function SuijiMode_SandKingEpicenterClearActive takes unit suijiSandKingEpicenterUnit,trigger suijiSandKingEpicenterTrigger returns nothing
local integer suijiSandKingEpicenterHandle=0
if SUIJI_MODE==false or suijiSandKingEpicenterUnit==null then
return
endif
set suijiSandKingEpicenterHandle=GetHandleId(suijiSandKingEpicenterUnit)
if LoadTriggerHandle(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterTrigger"))==suijiSandKingEpicenterTrigger then
call RemoveSavedHandle(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterTrigger"))
call RemoveSavedReal(L7,suijiSandKingEpicenterHandle,StringHash("SuijiSandKingEpicenterActiveUntil"))
endif
endfunction
function HSE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local player p=O97(OB7,"p")
local unit WI7=O77(OB7,"Hero")
local real HTE=ON7(OB7,"LastX")
local real HUE=ON7(OB7,"LastY")
local boolean EWD=OO7(OB7,"Scepter")
local integer V77=OM7(OB7,"Level")
local integer HRE=OM7(OB7,"Iteration")
local integer HVE=4+V77*2
local unit sandKingEpicenterPulseDummy=O77(OB7,"PulseDummy")
local real x=HTE
local real y=HUE
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false or V77<=0 then
call SuijiMode_SandKingEpicenterClearActive(WI7,t)
call NM7(OB7)
call OZ7(t)
set t=null
set p=null
set WI7=null
set sandKingEpicenterPulseDummy=null
return false
endif
if EWD then
set HVE=HVE+3
endif
if HRE>HVE then
call SuijiMode_SandKingEpicenterClearActive(WI7,t)
call NM7(OB7)
call OZ7(t)
else
if WI7!=null and XH7(WI7)==false then
set x=GetUnitX(WI7)
set y=GetUnitY(WI7)
endif
call HQE(WI7,sandKingEpicenterPulseDummy,x,y,V77,HRE)
call NP7(OB7,"Iteration",HRE+1)
call NQ7(OB7,"LastX",(x)*1.)
call NQ7(OB7,"LastY",(y)*1.)
endif
set t=null
set p=null
set WI7=null
set sandKingEpicenterPulseDummy=null
return false
endfunction
function SuijiMode_SandKingEpicenterSpellAllowed takes unit u,integer skill returns boolean
if u==null or GetUnitTypeId(u)==0 or (skill!='A06R' and skill!='A1B4') then
return false
endif
if SUIJI_MODE==false then
return true
endif
if skill=='A06R' then
return true
endif
return B287_GetUnitAbilityLevel(u,'A06R')==0
endfunction
function SuijiMode_SandKingEpicenterExtra takes unit suijiSandkingEpicenterCaster,integer suijiSandkingEpicenterSkill returns nothing
local player suijiSandkingEpicenterOwner=null
local integer suijiSandkingEpicenterPlayerId=0
local trigger suijiSandkingEpicenterPulseTrigger=null
local integer suijiSandkingEpicenterPulseHandle=0
local integer suijiSandkingEpicenterLevel=0
local boolean suijiSandkingEpicenterScepter=false
if suijiSandkingEpicenterCaster==null or UnitAlive(suijiSandkingEpicenterCaster)==false then
return
endif
if SuijiMode_SandKingEpicenterSpellAllowed(suijiSandkingEpicenterCaster,suijiSandkingEpicenterSkill)==false then
return
endif
set suijiSandkingEpicenterScepter=SuijiMode_ScepterRegistryIsActive(suijiSandkingEpicenterCaster,'A06R')
set suijiSandkingEpicenterLevel=SuijiMode_GetPairCastLevel(suijiSandkingEpicenterCaster,suijiSandkingEpicenterSkill,'A06R','A1B4')
if suijiSandkingEpicenterLevel<=0 then
return
endif
set suijiSandkingEpicenterOwner=GetOwningPlayer(suijiSandkingEpicenterCaster)
set suijiSandkingEpicenterPlayerId=GetPlayerId(suijiSandkingEpicenterOwner)
set BREAKLBK[suijiSandkingEpicenterPlayerId]=0
set suijiSandkingEpicenterPulseTrigger=CreateTrigger()
set suijiSandkingEpicenterPulseHandle=GetHandleId(suijiSandkingEpicenterPulseTrigger)
if TV7(suijiSandkingEpicenterOwner)then
set v0[suijiSandkingEpicenterPlayerId]=CreateUnit(A7[0],'e00E',GetUnitX(suijiSandkingEpicenterCaster),GetUnitY(suijiSandkingEpicenterCaster),0)
else
set v0[suijiSandkingEpicenterPlayerId]=CreateUnit(Z7[0],'e00E',GetUnitX(suijiSandkingEpicenterCaster),GetUnitY(suijiSandkingEpicenterCaster),0)
endif
call UnitApplyTimedLife(v0[suijiSandkingEpicenterPlayerId],$42544C46,8.)
if GetUnitTypeId(suijiSandkingEpicenterCaster)=='Z00K' then
call XF7(v0[suijiSandkingEpicenterPlayerId],'X17B')
else
call XF7(v0[suijiSandkingEpicenterPlayerId],'A17B')
endif
call NT7(suijiSandkingEpicenterPulseHandle,"Hero",suijiSandkingEpicenterCaster)
call NZ7(suijiSandkingEpicenterPulseHandle,"p",suijiSandkingEpicenterOwner)
call NQ7(suijiSandkingEpicenterPulseHandle,"LastX",(GetUnitX(suijiSandkingEpicenterCaster))*1.)
call NQ7(suijiSandkingEpicenterPulseHandle,"LastY",(GetUnitY(suijiSandkingEpicenterCaster))*1.)
call NP7(suijiSandkingEpicenterPulseHandle,"Level",suijiSandkingEpicenterLevel)
call NP7(suijiSandkingEpicenterPulseHandle,"Iteration",2)
call NS7(suijiSandkingEpicenterPulseHandle,"Scepter",suijiSandkingEpicenterScepter)
call NT7(suijiSandkingEpicenterPulseHandle,"PulseDummy",v0[suijiSandkingEpicenterPlayerId])
call TriggerRegisterTimerEvent(suijiSandkingEpicenterPulseTrigger,.35,true)
call TriggerAddCondition(suijiSandkingEpicenterPulseTrigger,Condition(function HSE))
call HQE(suijiSandkingEpicenterCaster,v0[suijiSandkingEpicenterPlayerId],GetUnitX(suijiSandkingEpicenterCaster),GetUnitY(suijiSandkingEpicenterCaster),suijiSandkingEpicenterLevel,1)
set suijiSandkingEpicenterPulseTrigger=null
set suijiSandkingEpicenterOwner=null
endfunction
function HWE takes nothing returns nothing
local unit WI7=GetTriggerUnit()
local player p=null
local trigger t=null
local integer OB7=0
local integer V77=0
local integer sandKingEpicenterUnitHandle=0
local integer sandKingEpicenterPlayerId=0
local real sandKingEpicenterNow=TimerGetElapsed(W)
local boolean EWD=false
local integer sandKingEpicenterSkill=B287_GetSpellAbilityId()
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false then
set WI7=null
return
endif
if SuijiMode_SandKingEpicenterSpellAllowed(WI7,sandKingEpicenterSkill)==false then
set WI7=null
return
endif
set p=GetOwningPlayer(WI7)
set EWD=SuijiMode_ScepterRegistryIsActive(WI7,'A06R')
set V77=SuijiMode_GetPairCastLevel(WI7,sandKingEpicenterSkill,'A06R','A1B4')
set sandKingEpicenterUnitHandle=GetHandleId(WI7)
set sandKingEpicenterPlayerId=GetPlayerId(p)
if ON7(sandKingEpicenterUnitHandle,"SandKingEpicenterGuardUntil")>sandKingEpicenterNow then
set WI7=null
set p=null
return
endif
call NQ7(sandKingEpicenterUnitHandle,"SandKingEpicenterGuardUntil",sandKingEpicenterNow+.20)
if V77<=0 then
set WI7=null
set p=null
return
endif
if SuijiMode_SandKingEpicenterCanStart(WI7)==false then
set WI7=null
set p=null
return
endif
set t=CreateTrigger()
set OB7=GetHandleId(t)
set BREAKLBK[sandKingEpicenterPlayerId]=0
if TV7(p)then
set v0[sandKingEpicenterPlayerId]=CreateUnit(A7[0],'e00E',GetUnitX(WI7),GetUnitY(WI7),0)
else
set v0[sandKingEpicenterPlayerId]=CreateUnit(Z7[0],'e00E',GetUnitX(WI7),GetUnitY(WI7),0)
endif
call UnitApplyTimedLife(v0[sandKingEpicenterPlayerId],$42544C46,8.)
//地震减速
if GetUnitTypeId(WI7)=='Z00K' then
call XF7(v0[sandKingEpicenterPlayerId],'X17B')
else
call XF7(v0[sandKingEpicenterPlayerId],'A17B')
endif
call NT7(OB7,"Hero",WI7)
call NZ7(OB7,"p",GetOwningPlayer(WI7))
call NQ7(OB7,"LastX",(GetUnitX(WI7))*1.)
call NQ7(OB7,"LastY",(GetUnitY(WI7))*1.)
call NP7(OB7,"Level",V77)
call NP7(OB7,"Iteration",2)
call NS7(OB7,"Scepter",EWD)
call NT7(OB7,"PulseDummy",v0[sandKingEpicenterPlayerId])
call SuijiMode_SandKingEpicenterStoreActive(WI7,t)
call TriggerRegisterTimerEvent(t,.35,true)
call TriggerAddCondition(t,Condition(function HSE))
call HQE(WI7,v0[sandKingEpicenterPlayerId],GetUnitX(WI7),GetUnitY(WI7),V77,1)
set WI7=null
set p=null
set t=null
endfunction
function SuijiMode_SandKingCooldownSyncTick takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer timerHandle=GetHandleId(t)
local unit u=LoadUnitHandle(L7,timerHandle,2)
local integer skill=LoadInteger(L7,timerHandle,3)
local integer casterHandle=0
local integer level=0
local real cooldown=0.
local real factor=0.
local real maxCooldown=0.
local boolean scepter=false
if u!=null and GetUnitTypeId(u)!=0 then
set casterHandle=GetHandleId(u)
set cooldown=B582_GetAbilityCooldown(u,skill)
set level=SuijiMode_GetPairCastLevel(u,skill,'A06R','A1B4')
if level<1 then
set level=1
elseif level>3 then
set level=3
endif
set scepter=SuijiMode_ScepterRegistryIsActive(u,'A06R')
if scepter then
if level==1 then
set maxCooldown=100.
elseif level==2 then
set maxCooldown=90.
else
set maxCooldown=80.
endif
else
if level==1 then
set maxCooldown=120.
elseif level==2 then
set maxCooldown=110.
else
set maxCooldown=100.
endif
endif
set factor=ReduceUnitAbilityCoolDownReal(u)
if factor>0. then
set maxCooldown=maxCooldown*factor
endif
if cooldown<=.01 or cooldown>maxCooldown then
set cooldown=maxCooldown
endif
if cooldown>.01 then
if B287_GetUnitAbilityLevel(u,'A06R')>0 then
call B287_YDWESetUnitAbilityState(u,'A06R',1,cooldown)
call B287_MHAbility_SetCooldown(u,'A06R',cooldown)
endif
if B287_GetUnitAbilityLevel(u,'A1B4')>0 then
call B287_YDWESetUnitAbilityState(u,'A1B4',1,cooldown)
call B287_MHAbility_SetCooldown(u,'A1B4',cooldown)
endif
endif
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiSandKingCooldownTrigger"))
endif
call NM7(timerHandle)
call OZ7(t)
set u=null
set t=null
return false
endfunction
function SuijiMode_StartSandKingCooldownSync takes unit u,integer skill returns nothing
local trigger t=null
local integer casterHandle=0
local integer timerHandle=0
if SUIJI_MODE==false or u==null or GetUnitTypeId(u)==0 then
return
endif
if skill!='A06R' and skill!='A1B4' then
return
endif
set casterHandle=GetHandleId(u)
if LoadTriggerHandle(L7,casterHandle,StringHash("SuijiSandKingCooldownTrigger"))!=null then
return
endif
set t=CreateTrigger()
set timerHandle=GetHandleId(t)
call SaveUnitHandle(L7,timerHandle,2,u)
call SaveInteger(L7,timerHandle,3,skill)
call SaveTriggerHandle(L7,casterHandle,StringHash("SuijiSandKingCooldownTrigger"),t)
call TriggerRegisterTimerEvent(t,.10,false)
call TriggerAddCondition(t,Condition(function SuijiMode_SandKingCooldownSyncTick))
set t=null
endfunction
function HXE takes nothing returns boolean
if SuijiMode_SandKingEpicenterSpellAllowed(GetTriggerUnit(),B287_GetSpellAbilityId()) then
call SuijiMode_StartSandKingCooldownSync(GetTriggerUnit(),B287_GetSpellAbilityId())
call HWE()
endif
return false
endfunction
function IQ8 takes nothing returns nothing
local trigger t
if SUIJI_SANDKING_EPICENTER_INIT_READY then
return
endif
set t=CreateTrigger()
set SUIJI_SANDKING_EPICENTER_INIT_READY=true
call YB7(t,EVENT_PLAYER_UNIT_SPELL_FINISH)
call TriggerAddCondition(t,Condition(function HXE))
call X_7('A17B')
set t=null
endfunction
function HYE takes nothing returns boolean
return B287_GetSpellAbilityId()=='A0H0'
endfunction
function HZE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit oA=null
if WI7==null or GetUnitTypeId(WI7)==0 or UnitAlive(WI7)==false then
call OZ7(t)
set t=null
set WI7=null
return false
endif
set oA=CreateUnit(GetOwningPlayer(WI7),'e00E',GetUnitX(WI7),GetUnitY(WI7),bj_UNIT_FACING)
call UnitApplyTimedLife(oA,'BTLF',1.)
call XF7(oA,'A0HO')
call SetUnitAbilityLevel(oA,'A0HO',B287_GetUnitAbilityLevel(WI7,'A0H0'))
call B947IssueTargetOrderById("HZE @ war3map.j:107528 (B968)",oA,$D0065,WI7)
//等下次施法前再清除表
// call NM7(OB7)
//等下次施法前再清除表
// call NM7(OB7)
call OZ7(t)
set t=null
set WI7=null
set oA=null
return false
endfunction
function SCB_PD takes nothing returns boolean
    return(IsUnitEnemy(U22,GetOwningPlayer(GetFilterUnit()))and AU7())!=null
endfunction
function SCB2 takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7
local integer WF8=GetTriggerEvalCount(t)
local group g
local real x=(LoadReal(L7,(I97),(3)))
local real y=(LoadReal(L7,(I97),(4)))
local real d=(LoadReal(L7,(I97),(5)))
local integer dur=(LoadInteger(L7,(I97),(6)))
local integer id=(LoadInteger(L7,(I97),(10)))
local boolexpr sandstormEnemyFilter=null
local string tx
if ZX7==null or GetUnitTypeId(ZX7)==0 or UnitAlive(ZX7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if id=='Z00K' or id=='Z10K' then
    set tx="model\\hero_sandking_n11s_aghanim_1.mdl"
else
    set tx="Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl"
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or(b1060GetTriggerEventId==EVENT_UNIT_SPELL_ENDCAST and b1060B287_GetSpellAbilityId=='A0H0') or WF8>dur then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
    set g=WS7()
    set U22=ZX7
    set sandstormEnemyFilter=Condition(function SCB_PD)
    call GroupEnumUnitsInRange(g,x,y,525,sandstormEnemyFilter)
    call DestroyBoolExpr(sandstormEnemyFilter)
    loop
        set IH7=FirstOfGroup(g)
        exitwhen IH7==null
        call B67(ZX7,IH7,1,d)
        call YS7(tx,IH7,"head",.5)
        call GroupRemoveUnit(g,IH7)
        endloop
    call WR7(g)
    set g=null
endif
set t=null
set ZX7=null
set IH7=null
set sandstormEnemyFilter=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SCB takes unit ZX7 returns nothing
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0H0')
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_ENDCAST)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerAddAction(t,function SCB2)
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveReal(L7,(I97),(3),(GetUnitX(ZX7)))
call SaveReal(L7,(I97),(4),(GetUnitY(ZX7)))
call SaveReal(L7,(I97),(5),(level*25.*.5))
call SaveInteger(L7,(I97),(6),(level*20*2))
call SaveInteger(L7,(I97),(10),(GetUnitTypeId(ZX7)))
set t=null
endfunction
