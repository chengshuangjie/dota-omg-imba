function UH3 takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local unit IH7=null
local group g=WS7()
local real x=GetUnitX(ZX7)
local real y=GetUnitY(ZX7)
local integer X87=B287_GetUnitAbilityLevel(ZX7,'A0BQ')+1
local boolean HaveA=SuijiMode_ScepterRegistryIsActive(ZX7,'A05E') or (ZX7==ChaosObserverBoss and GetUnitAbilityLevel(ZX7,'A2US')>0)
local trigger t
local integer skill=B287_GetSpellAbilityId()
local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
if ISLABIKE(ZX7) then
set X87=5
endif
set IN4=ZX7
call GroupEnumUnitsInRange(g,x,y,2500+25,Condition(function UF3))
loop
exitwhen FirstOfGroup(g)==null or X87==0
set IH7=M59(g,x,y)
set X87=X87-1
call GroupRemoveUnit(g,IH7)
set t=NHX(ZX7, IH7,'h0EU', "UG3",1000, true, "")
call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
call SaveBoolean(TABLE_HY, GetHandleId(t), 11, HaveA)
endloop
call WR7(g)
set g=null
set IH7=null
set ZX7=null
set t=null
endfunction
