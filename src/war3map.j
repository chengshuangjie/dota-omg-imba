function AI_USE_TH_TRI takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer OB7=GetHandleId(t)
    local unit ZX7=O77(OB7,"Hero")
    local integer heroHandle=OM7(OB7,"HeroHandle")
    local group g
    local integer n=OM7(OB7,"Counter")
    local integer i=0
    local unit suijiTideAlly=null
    set n=n+1
    call NP7(OB7,"Counter",n)
    if ZX7==null or GetUnitTypeId(ZX7)==0 then
        call RemoveSavedHandle(L7,heroHandle,StringHash("SuijiTideAIComboTimer"))
        call RemoveSavedInteger(ExtraHT,'HMRS',heroHandle)
        call RemoveSavedInteger(ExtraHT,'HMRC',heroHandle)
        call PauseTimer(t)
        call FlushChildHashtable(L7,OB7)
        call DestroyTimer(t)
    elseif n>20 then
        call RemoveSavedHandle(L7,heroHandle,StringHash("SuijiTideAIComboTimer"))
        call RemoveSavedInteger(ExtraHT,'HMRS',heroHandle)
        call RemoveSavedInteger(ExtraHT,'HMRC',heroHandle)
        call PauseTimer(t)
        call FlushChildHashtable(L7,OB7)
        call DestroyTimer(t)
    elseif LoadInteger(ExtraHT,'HMRC',heroHandle)>0 then
        set g=WS7()
        // The old path copied every unit on the map into a group. Only allied
        // computer heroes can participate in this combo, so bound the scan.
        loop
        exitwhen i>$B
        set suijiTideAlly=M7[i]
        if suijiTideAlly!=null and GetUnitTypeId(suijiTideAlly)!=0 and UnitAlive(suijiTideAlly) and IsUnitAlly(suijiTideAlly,GetOwningPlayer(ZX7)) and GetPlayerController(GetOwningPlayer(suijiTideAlly))==MAP_CONTROL_COMPUTER then
        call GroupAddUnit(g,suijiTideAlly)
        endif
        set i=i+1
        endloop
        set IN4=ZX7
        call ForGroup(g,function AI_USE_TH_PD)
        call WR7(g)
        call RemoveSavedHandle(L7,heroHandle,StringHash("SuijiTideAIComboTimer"))
        call RemoveSavedInteger(ExtraHT,'HMRS',heroHandle)
        call RemoveSavedInteger(ExtraHT,'HMRC',heroHandle)
        call PauseTimer(t)
        call FlushChildHashtable(L7,OB7)
        call DestroyTimer(t)
    endif
    set ZX7=null
    set suijiTideAlly=null
    set g=null
    set t=null
endfunction
function AI_USE_TH takes unit ZX7 returns nothing
    local timer t=null
    local integer OB7=0
    if ZX7==null or GetUnitTypeId(ZX7)==0 or LoadTimerHandle(L7,GetHandleId(ZX7),StringHash("SuijiTideAIComboTimer"))!=null then
        return
    endif
    set t=CreateTimer()
    set OB7=GetHandleId(t)
    call NT7(OB7,"Hero",ZX7)
    call NP7(OB7,"HeroHandle",GetHandleId(ZX7))
    call NP7(OB7,"Counter",0)
    call SaveTimerHandle(L7,GetHandleId(ZX7),StringHash("SuijiTideAIComboTimer"),t)
    call TimerStart(t,.1,true,function AI_USE_TH_TRI)
    set t=null
endfunction
