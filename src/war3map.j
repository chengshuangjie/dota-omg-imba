function Set_Unit_Alpha takes unit u,integer a returns nothing
	local integer r = 255
	local integer g = 255
	local integer b = 255
    local integer WPV = GetUnitTypeId(u)
	if HaveSavedInteger(TABLE_L, WPV, 0) then
		set r = LoadInteger(TABLE_L, WPV, 0)
	endif
	if HaveSavedInteger(TABLE_L, WPV, 1) then
		set g = LoadInteger(TABLE_L, WPV, 1)
	endif
	if HaveSavedInteger(TABLE_L, WPV, 2) then
		set b = LoadInteger(TABLE_L, WPV, 2)
	endif
	call SetUnitVertexColor(u, r, g, b, a)
endfunction
function MUShareVision takes unit dummy returns nothing
    local integer i = 0
    loop
    exitwhen i > 11
        call UnitShareVision(dummy, Player(i), true)
        set i = i + 1
    endloop
    set dummy = null
endfunction
function MUAddUnitMod takes nothing returns boolean
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local integer pid = GetPlayerId(b1060GetTriggerPlayer)
local integer i
local real d
local integer a
local boolean b2 = false
local boolean b = not IsUnitType(b1060GetTriggerUnit, UNIT_TYPE_STRUCTURE) and IsUnitInRangeXY(b1060GetTriggerUnit, O_4, P44, 1000) and (GetOwningPlayer(b1060GetTriggerUnit)==A7[0] or GetOwningPlayer(b1060GetTriggerUnit)==Z7[0]) and M7[pid]==null
if (not mu_select_bool[pid])  and  IsUnitType(b1060GetTriggerUnit, UNIT_TYPE_HERO) then
    set b1060ReturnValue=false
    set b1060GetTriggerPlayer=null
    set b1060GetTriggerUnit=null
    return b1060ReturnValue
endif
if (not b) then
    set b1060ReturnValue=false
    set b1060GetTriggerPlayer=null
    set b1060GetTriggerUnit=null
    return b1060ReturnValue
endif
if ((mu_select_hero[pid] == null)) then
    set mu_select_hero[pid] = CreateUnit( b1060GetTriggerPlayer, GetUnitTypeId(b1060GetTriggerUnit), O_4, P44, 0 )
    call UnitAddAbility( mu_select_hero[pid], 'Aloc' )
else
    call RemoveUnit(mu_select_hero[pid])
    set mu_select_hero[pid] = CreateUnit( b1060GetTriggerPlayer, GetUnitTypeId(b1060GetTriggerUnit), O_4, P44, 0 )
    call UnitAddAbility( mu_select_hero[pid], 'Aloc' )
endif
// ShowUnit changes simulation state and must be identical on every client.
// Keep enemy previews visually private with a local vertex alpha only.
call ShowUnit(  mu_select_hero[pid], true  )
set d=RMaxBJ(Get_Unit_Scale(mu_select_hero[pid])*0.7,0.5)
call SetUnitScale( mu_select_hero[pid], d, d, d )
call Set_Unit_Alpha(mu_select_hero[pid],150)
if ((IsPlayerEnemy(b1060GetTriggerPlayer, GetLocalPlayer()) == true)) then
    call Set_Unit_Alpha(mu_select_hero[pid],0)
endif
set i = 1
loop
exitwhen i > 5
if(GetPlayerId(Z7[i]) == pid)  then
    set a = i + 2
    set b2 = false
endif
if(GetPlayerId(A7[i]) == pid)  then
    set a = i + 2
    set b2 = true
endif
set i = i + 1
endloop
//若是黑暗势力的玩家
if b2 then
    set d = 90
    call SetUnitPosition(mu_select_hero[pid],UJ0[a],UK0[a])
else
    set d =  270
    call SetUnitPosition(mu_select_hero[pid],UX0[a],UY0[a])
endif
call SetUnitFacing(mu_select_hero[pid], d)
call MHUnit_DisableMove(mu_select_hero[pid],true)
call MUShareVision(mu_select_hero[pid])
call SetUnitColor(mu_select_hero[pid], GetPlayerColor(b1060GetTriggerPlayer))
set b1060ReturnValue=false
set b1060GetTriggerPlayer=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
//玩家选择事件
function MUPlayerSelectHero takes nothing returns nothing
    local trigger t= CreateTrigger()
    local integer i = 0
    loop
    exitwhen i > 11
        call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_SELECTED, null)
        set mu_select_bool[i] = true
        set i = i + 1
    endloop
    call TriggerAddCondition(t, Condition(function MUAddUnitMod))
    set t=null
endfunction
