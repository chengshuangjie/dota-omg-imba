local integer JYE
local integer BC7
local real TA9
local real TP9=(LoadReal(L7,(I97),(23)))
local real TQ9=(LoadReal(L7,(I97),(24)))
local real x=0.
local real y=0.
local real d=0.
if ZX7==null or IH7==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
set d=KF7(x,y,TP9,TQ9)
call SaveReal(L7,(I97),(23),((x)*1.))
call SaveReal(L7,(I97),(24),((y)*1.))
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or WF8==$C8 or d>$708 then
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,$FF)
call UnitShareVision(IH7,GetOwningPlayer(ZX7),false)
call UnitRemoveAbility(ZX7,'A179')
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
if WF8<100 then
set JYE=WF8
else
set JYE=$C8-WF8
endif
call SetUnitVertexColor(ZX7,$FF,$FF,$FF,$FF*(100-JYE)/100)
if WF8==100 then
set BC7=(LoadInteger(L7,(I97),(5)))
set TA9=Atan2(GetUnitY(IH7)-GetUnitY(ZX7),GetUnitX(IH7)-GetUnitX(ZX7))
call SetUnitPosition(ZX7,GetUnitX(IH7)+80*Cos(TA9),GetUnitY(IH7)+80*Sin(TA9))
call SetUnitAnimation(ZX7,"attack")
call B947IssueTargetOrderById("JXE @ war3map.j:109598 (B968)",ZX7,$D000F,IH7)
if (LoadBoolean(L7,(I97),(15))) then
call JWE(ZX7,IH7)
else
call JUE(ZX7,IH7)
endif
call B67(ZX7,IH7,1,50+100*BC7)
call LINGXIA(ZX7,IH7)
endif
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
