function SuijiTest_EnemyHeroDamageDisplay takes nothing returns nothing
local unit target=GetTriggerUnit()
local real damage=GetEventDamage()
local texttag tt=null
if target!=null and GetUnitTypeId(target)!=0 and damage>0. then
set tt=CreateTextTag()
call SetTextTagText(tt,"-"+I2S(R2I(damage+.5)),.024)
call SetTextTagPosUnit(tt,target,64.)
call SetTextTagColor(tt,$FF,$40,$40,$FF)
call SetTextTagVelocity(tt,GetRandomReal(-.018,.018),.035)
call SetTextTagFadepoint(tt,.75)
call SetTextTagLifespan(tt,1.25)
call SetTextTagPermanent(tt,false)
call SetTextTagVisibility(tt,true)
endif
set tt=null
set target=null
endfunction
function SuijiTest_EnemyHeroAutoCast takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer triggerId=GetHandleId(t)
local integer playerIndex=OM7(triggerId,"PlayerIndex")
local integer cooldownTicks=OM7(triggerId,"CastCooldownTicks")
local integer testSkillIndex=OM7(triggerId,"TestSkillIndex")
local boolean testOrderIssued=false
local unit dummy=SUIJI_TEST_ENEMY_HERO[playerIndex]
local unit hero=M7[playerIndex]
if dummy==null or GetUnitTypeId(dummy)==0 then
call NM7(triggerId)
call OZ7(t)
set SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]=null
elseif cooldownTicks>0 then
call NP7(triggerId,"CastCooldownTicks",cooldownTicks-1)
elseif hero!=null and GetUnitTypeId(hero)!=0 and GetWidgetLife(hero)>.405 and GetWidgetLife(dummy)>.405 and IsUnitInRange(dummy,hero,525.) then
if GetUnitAbilityLevel(dummy,'A020')>0 then
if testSkillIndex==0 then
set testOrderIssued=B947IssueTargetOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46718 (B968)",dummy,"thunderbolt",hero)
elseif testSkillIndex==1 then
set testOrderIssued=B947IssueTargetOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46720 (B968)",dummy,"chainlightning",hero)
elseif testSkillIndex==2 then
set testOrderIssued=B947IssuePointOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46722 (B968)",dummy,"blizzard",GetUnitX(hero),GetUnitY(hero))
elseif testSkillIndex==3 then
set testOrderIssued=B947IssuePointOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46724 (B968)",dummy,"flare",GetUnitX(hero),GetUnitY(hero))
else
set testOrderIssued=B947IssueImmediateOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46726 (B968)",dummy,"creepdevour")
endif
if testOrderIssued then
call NP7(triggerId,"TestSkillIndex",ModuloInteger(testSkillIndex+1,5))
call NP7(triggerId,"CastCooldownTicks",20)
endif
elseif B947IssueTargetOrder("SuijiTest_EnemyHeroAutoCast @ war3map.j:46732 (B968)",dummy,"thunderbolt",hero) then
call NP7(triggerId,"CastCooldownTicks",32)
endif
endif
set hero=null
set dummy=null
set t=null
return false
endfunction
function SuijiTest_AddEnemyHeroSkills takes nothing returns nothing
local player p=GetTriggerPlayer()
local integer playerIndex=GetPlayerId(p)
local unit dummy=SUIJI_TEST_ENEMY_HERO[playerIndex]
local trigger castTrigger=SUIJI_TEST_ENEMY_CAST_TRIGGER[playerIndex]
if Test_NoOtherHumanPlayer(p)==false then
call DisplayTimedTextToPlayer(p,0,0,5.,"有其他真人玩家时不能使用 -jiajineng。")
elseif dummy==null or GetUnitTypeId(dummy)==0 then
call DisplayTimedTextToPlayer(p,0,0,8.,"请先输入 -jiaren 生成敌对测试英雄，再输入 -jiajineng 添加技能。")
else
call UnitAddAbility(dummy,'A020')
call SetUnitAbilityLevel(dummy,'A020',4)
call UnitAddAbility(dummy,'A0LL')
call SetUnitAbilityLevel(dummy,'A0LL',4)
call UnitAddAbility(dummy,'Y09X')
call SetUnitAbilityLevel(dummy,'Y09X',4)
call UnitAddAbility(dummy,'A0GP')
call SetUnitAbilityLevel(dummy,'A0GP',4)
call SetHeroInt(dummy,100,true)
call MHUnit_SetData(dummy,UNIT_DATA_MANA_REGEN,100.)
call SetUnitState(dummy,UNIT_STATE_MANA,GetUnitState(dummy,UNIT_STATE_MAX_MANA))
if castTrigger!=null then
call NP7(GetHandleId(castTrigger),"TestSkillIndex",0)
call NP7(GetHandleId(castTrigger),"CastCooldownTicks",0)
endif
call DisplayTimedTextToPlayer(p,0,0,12.,"已给测试英雄添加弧形闪电、山崩、动能力场和刺针扫射；进入525范围后，将与风暴之锤一起每5秒按固定顺序自动施放。")
endif
set castTrigger=null
set dummy=null
set p=null
endfunction
function B1057ClearTestBosses takes integer bossPlayer1057 returns nothing
if B1057_TEST_ALLY_BOSS[bossPlayer1057]!=null and GetUnitTypeId(B1057_TEST_ALLY_BOSS[bossPlayer1057])!=0 then
call RemoveUnit(B1057_TEST_ALLY_BOSS[bossPlayer1057])
endif
if B1057_TEST_ENEMY_BOSS[bossPlayer1057]!=null and GetUnitTypeId(B1057_TEST_ENEMY_BOSS[bossPlayer1057])!=0 then
