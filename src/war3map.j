    set x=GetUnitX(WI7)+F8E*40*Cos(l4*bj_DEGTORAD)
    set y=GetUnitY(WI7)+F8E*40*Sin(l4*bj_DEGTORAD)
    call NT7(FGE,"fristgz",CreateUnit(GetOwningPlayer(WI7),gzmj,x,y,l4))
    else
    set fristgz=O77(FGE,"fristgz")
    set x=GetUnitX(WI7)+F8E*40*Cos(l4*bj_DEGTORAD)
    set y=GetUnitY(WI7)+F8E*40*Sin(l4*bj_DEGTORAD)
    call SetUnitX(fristgz,x)
    call SetUnitY(fristgz,y)
    set x=GetUnitX(WI7)+(F8E-1)*40*Cos(l4*bj_DEGTORAD)
    set y=GetUnitY(WI7)+(F8E-1)*40*Sin(l4*bj_DEGTORAD)
    call NT7(FGE,"Link"+I2S(F8E),CreateUnit(GetOwningPlayer(WI7),gzmj,x,y,l4))
    endif
    set g=WS7()
    call GroupEnumUnitsInRange(g,x,y,110,Condition(function B47))
    call GroupRemoveUnit(g,WI7)
    set u=GroupPickRandomUnit(g)
    call WR7(g)
    if u!=null then
    call NM7(OB7)
    call OZ7(t)
    call TriggerRegisterTimerEvent(FFE,.03,true)
    call TriggerAddCondition(FFE,Condition(function F7E_PIFU))
    call NP7(FGE,"LinkNumber",F8E)
    call NS7(FGE,"FoundTarget",true)
    call NT7(FGE,"Target",u)
    if IsUnitEnemy(u,GetOwningPlayer(WI7))then
    if IsUnitType(u,UNIT_TYPE_HERO) then
    call C27("HA_Hits"+I2S(GetPlayerId(GetOwningPlayer(WI7))),R74[GetPlayerId(GetOwningPlayer(WI7))])
    set R74[GetPlayerId(GetOwningPlayer(WI7))]=R74[GetPlayerId(GetOwningPlayer(WI7))]+1
	call O37(WI7,"4400",1.5)
    endif
    set R84[GetPlayerId(GetOwningPlayer(WI7))]=R84[GetPlayerId(GetOwningPlayer(WI7))]+1
    call C27("HA_Total"+I2S(GetPlayerId(GetOwningPlayer(WI7))),R84[GetPlayerId(GetOwningPlayer(WI7))])
    call F4E(WI7,u)
if SuijiMode_ScepterRegistryIsActive(WI7,'A06I') then
    call B67(WI7,u,3,75+100*V77)
    else
    call B67(WI7,u,3,90*V77)
    endif
    call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"origin"))
    endif
    endif
endif
set t=null
set WI7=null
set FFE=null
set g=null
set u=null
set fristgz=null
return false
endfunction
function SuijiMode_MeatHookStart takes unit WI7,real targetX,real targetY,integer castSkill returns nothing
local real l4=J77(GetUnitX(WI7),GetUnitY(WI7),targetX,targetY)
local integer V77=B287_GetUnitAbilityLevel(WI7,'A06I')
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer id=GetUnitTypeId(WI7)
local integer length
local integer ZZMF_level=GetUnitAbilityLevel(WI7,'A4DJ')+GetUnitAbilityLevel(WI7,'A4DZ')
local integer ZZMF=0
if ZZMF_level==1 then
    set ZZMF=1
elseif ZZMF_level==2 then
    set ZZMF=2
elseif ZZMF_level==3 then
    set ZZMF=4
elseif ZZMF_level==4 then
    set ZZMF=5
endif
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
set length=38+ZZMF
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
set length=37+ZZMF
else
set length=33+ZZMF
endif
if V77==0 then
set V77=B287_GetUnitAbilityLevel(WI7,'A2S1')
endif
call NT7(OB7,"Hero",WI7)
call NP7(OB7,"Level",V77)
call NP7(OB7,"length",length)
call NP7(OB7,"id",id)
call NQ7(OB7,"Angle",l4*1.)
call NP7(OB7,"LinkNumber",0)
call NV7(OB7,"RetractTrigger",CreateTrigger())
call TriggerRegisterTimerEvent(t,.03,true)
if id=='Z00F' then
call TriggerAddCondition(t,Condition(function FEE_PIFU))
else
call TriggerAddCondition(t,Condition(function FEE))
endif
set WI7=null
set t=null
endfunction
function FHE takes nothing returns nothing
call SuijiMode_MeatHookStart(GetTriggerUnit(),GetSpellTargetX(),GetSpellTargetY(),B287_GetSpellAbilityId())
endfunction
