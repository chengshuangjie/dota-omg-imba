function DSSW takes nothing returns nothing
local integer b1061SavedB287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
local unit b1061SavedGetTriggerUnit=GetTriggerUnit()
local unit p5=(b1061SavedGetTriggerUnit)
local unit IH7=(b1061SavedGetSpellTargetUnit)
local unit BB7=CreateUnit(GetOwningPlayer(p5),'e00E',GetUnitX(p5),GetUnitY(p5),0)
local integer level=0
local integer id=GetUnitTypeId(p5)
local integer skill
local real x
local real y
local boolean HaveA=false
if SuijiMode_ScepterRegistryIsActive(p5,'A00H') then
    set HaveA=true
endif
set level=SuijiMode_GetPairCastLevel(p5,(b1061SavedB287_GetSpellAbilityId),'A00H','A0A1')
if IH7!=null then
    set x=GetUnitX(IH7)
    set y=GetUnitY(IH7)
else
    set x=(b1061SavedGetSpellTargetX)
    set y=(b1061SavedGetSpellTargetY)
endif
if id=='Zrkn' then
    if HaveA then
        set skill='A4GU'
    else
        set skill='A4GR'
    endif
elseif id=='Zskn' then
    if HaveA then
        set skill='A4GV'
    else
        set skill='A4GS'
    endif
    set IH7=CreateUnit(GetOwningPlayer(p5),'e051',x,y,90)
    call MHUnit_SetModel(IH7,"AZModel\\AZ_SSCrow_W_SkyHead.mdl",false)
    call SetUnitPathing(IH7,false)
    call Time_RemoveUnit(IH7,4.5)
else
    if HaveA then
        set skill='A4GT'
    else
        set skill='A4GQ'
    endif
endif
call XF7(BB7,skill)
call SetUnitAbilityLevel(BB7,skill,level)
call B947IssueBuildOrderById("DSSW @ war3map.j:117382 (B968)",BB7,$D0218,x,y)
call UnitApplyTimedLife(BB7,'BTLF',2.)
set p5=null
set IH7=null
set BB7=null
set b1061SavedGetSpellTargetUnit=null
set b1061SavedGetTriggerUnit=null
endfunction
function SZE takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
if (b1060B287_GetSpellAbilityId=='A00P' or b1060B287_GetSpellAbilityId=='X00P' or b1060B287_GetSpellAbilityId=='X10P') and WQ7(b1060GetSpellTargetUnit)==false then
call XYJS()
elseif (b1060B287_GetSpellAbilityId=='A0RX' or b1060B287_GetSpellAbilityId=='X0RX' or b1060B287_GetSpellAbilityId=='X1RX') and WQ7(b1060GetSpellTargetUnit)==false then
call XYBY()
elseif b1060B287_GetSpellAbilityId=='A010' and WQ7(b1060GetSpellTargetUnit)==false then
call CQZJ()
elseif b1060B287_GetSpellAbilityId=='A00H' or b1060B287_GetSpellAbilityId=='A0A1' then
call DSSW()
endif
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
