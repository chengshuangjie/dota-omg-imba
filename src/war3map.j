function TpSlot_GetCastleLanding takes unit caster,unit target,real requestedX,real requestedY returns location
local real tpCastleX=GetUnitX(target)
local real tpCastleY=GetUnitY(target)
local real tpCastleAngle=Atan2(requestedY-tpCastleY,requestedX-tpCastleX)
local real tpCastleDistance=KF7(requestedX,requestedY,tpCastleX,tpCastleY)
local real tpCastleCandidateX=0.
local real tpCastleCandidateY=0.
local integer tpCastleTry=0
if target!=JW_JD then
set caster=null
set target=null
return Location(requestedX,requestedY)
endif
if tpCastleDistance<160. and caster!=null and GetUnitTypeId(caster)!=0 then
set tpCastleAngle=Atan2(GetUnitY(caster)-tpCastleY,GetUnitX(caster)-tpCastleX)
if KF7(GetUnitX(caster),GetUnitY(caster),tpCastleX,tpCastleY)<32. then
set tpCastleAngle=GetUnitFacing(target)*bj_DEGTORAD
endif
endif
loop
set tpCastleCandidateX=X17(tpCastleX+448.*Cos(tpCastleAngle+I2R(tpCastleTry)*45.*bj_DEGTORAD))
set tpCastleCandidateY=X07(tpCastleY+448.*Sin(tpCastleAngle+I2R(tpCastleTry)*45.*bj_DEGTORAD))
exitwhen IsTerrainPathable(tpCastleCandidateX,tpCastleCandidateY,PATHING_TYPE_WALKABILITY)==false or tpCastleTry>=7
set tpCastleTry=tpCastleTry+1
endloop
set caster=null
set target=null
return Location(tpCastleCandidateX,tpCastleCandidateY)
endfunction
