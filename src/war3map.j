function HUANGWU_PD takes nothing returns boolean
return IsUnitAlly(GetFilterUnit(),GetOwningPlayer(IN4)) and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and UnitAlive(GetFilterUnit()) and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false
endfunction
function HUANGWU_TRI takes unit ZX7,unit IH7,integer level,string skilltx returns nothing
if OT7(ZX7,"Desolate")==false then
	call B67(ZX7,IH7,21,20*level)
	call DestroyEffect(AddSpecialEffectTarget(skilltx,IH7,"overhead"))
	if GetUnitAbilityLevel(ZX7,'A2VW')>0 then
		call O37(ZX7,"Desolate",.225)
	else
		call O37(ZX7,"Desolate",.3)
	endif
endif
endfunction
function HUANGWU2 takes unit ZX7,unit IH7 returns nothing
local group g
local boolexpr spectreDesolateAllyFilter=null
local integer level=B287_GetUnitAbilityLevel(ZX7,'A0FX')
local integer id=GetUnitTypeId(ZX7)
local string skilltx
if id=='Z01B' then
set skilltx="model\\Hero_Spectre_N7S_L_Target.mdl"
elseif id=='Z11B' then
set skilltx="model\\Hero_Spectre_N6S_L_Target.mdl"
elseif id=='Z21B' then
set skilltx="model\\Hero_Spectre_N4S_L_Target.mdl"
elseif id=='Z31B' then
set skilltx="model\\Hero_Spectre_N3S_L_Target.mdl"
else
set skilltx="Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl"
endif
if SuijiMode_ScepterRegistryIsActive(ZX7,'A0FX') then
	call HUANGWU_TRI(ZX7,IH7,level,skilltx)
else
	set g=WS7()
	set IN4=IH7
	set spectreDesolateAllyFilter=Condition(function HUANGWU_PD)
	call GroupEnumUnitsInRange(g,GetUnitX(IH7),GetUnitY(IH7),300,spectreDesolateAllyFilter)
	call DestroyBoolExpr(spectreDesolateAllyFilter)
	call GroupRemoveUnit(g,IH7)
	if FirstOfGroup(g)==null then
		call HUANGWU_TRI(ZX7,IH7,level,skilltx)
	endif
	call WR7(g)
endif
set g=null
set spectreDesolateAllyFilter=null
endfunction
function HUANGWU takes nothing returns nothing
	if ISPH(WXX)==false and B287_GetUnitAbilityLevel(WXX,'A0FX')>0 and IsUnitEnemy(YXX,GetOwningPlayer(WXX)) and IsUnitType(YXX, UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(YXX,'A04R')==0 and GetUnitAbilityLevel(YXX,'A4IF')==0 then
		call HUANGWU2(WXX, YXX)
	endif
endfunction
function aDx takes nothing returns boolean
return (IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit())))!=null
endfunction
function B1051DispersionExpire takes nothing returns nothing
local timer dispersionClock1051=GetExpiredTimer()
local integer dispersionClockKey1051=GetHandleId(dispersionClock1051)
local unit dispersionOwner1051=LoadUnitHandle(L7,dispersionClockKey1051,0)
local group dispersionTargets1051=LoadGroupHandle(L7,dispersionClockKey1051,1)
if dispersionOwner1051!=null then
if LoadGroupHandle(L7,GetHandleId(dispersionOwner1051),StringHash("B1051DispersionTargets"))==dispersionTargets1051 then
call RemoveSavedHandle(L7,GetHandleId(dispersionOwner1051),StringHash("B1051DispersionTargets"))
endif
endif
call DestroyGroup(dispersionTargets1051)
call FlushChildHashtable(L7,dispersionClockKey1051)
call PauseTimer(dispersionClock1051)
call DestroyTimer(dispersionClock1051)
set dispersionTargets1051=null
set dispersionOwner1051=null
set dispersionClock1051=null
endfunction
function B1051DispersionTargets takes unit dispersionOwner1051 returns group
local integer dispersionOwnerKey1051=GetHandleId(dispersionOwner1051)
local group dispersionTargets1051=LoadGroupHandle(L7,dispersionOwnerKey1051,StringHash("B1051DispersionTargets"))
local timer dispersionClock1051=null
local boolexpr dispersionFilter1051=null
if dispersionTargets1051==null then
set dispersionTargets1051=CreateGroup()
set dispersionFilter1051=Condition(function AW7)
call GroupEnumUnitsInRange(dispersionTargets1051,GetUnitX(dispersionOwner1051),GetUnitY(dispersionOwner1051),$401,dispersionFilter1051)
call DestroyBoolExpr(dispersionFilter1051)
call SaveGroupHandle(L7,dispersionOwnerKey1051,StringHash("B1051DispersionTargets"),dispersionTargets1051)
set dispersionClock1051=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(dispersionClock1051),0,dispersionOwner1051)
call SaveGroupHandle(L7,GetHandleId(dispersionClock1051),1,dispersionTargets1051)
// One bounded cache lifetime; no idle periodic scan or retained unit group.
call TimerStart(dispersionClock1051,.25,false,function B1051DispersionExpire)
endif
set dispersionClock1051=null
set dispersionFilter1051=null
set dispersionTargets1051=null
return LoadGroupHandle(L7,dispersionOwnerKey1051,StringHash("B1051DispersionTargets"))
endfunction
function IRE takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit m5=GetEnumUnit()
local real d=0.
local real ISE=0
local integer dispersionVictimPlayer1051=0
// Cached handles can die, be removed, change owner or leave the effect radius.
if u==null or GetUnitTypeId(u)==0 or not UnitAlive(u) then
set u=null
set m5=null
return
endif
if m5==null or GetUnitTypeId(m5)==0 or not UnitAlive(m5) then
if m5!=null then
call GroupRemoveUnit(LoadGroupHandle(L7,GetHandleId(u),StringHash("B1051DispersionTargets")),m5)
endif
set u=null
set m5=null
return
endif
if not IsUnitEnemy(u,GetOwningPlayer(m5)) or GetUnitAbilityLevel(m5,'A04R')!=0 or IsUnitType(m5,UNIT_TYPE_STRUCTURE) or XH7(m5) or CHUIFENG(m5) or (IsUnitType(m5,UNIT_TYPE_ANCIENT) and not Z_7(m5)) then
set u=null
set m5=null
return
endif
set d=KE7(u,m5)-25
if d<=300 then
set ISE=1
elseif d<$3E8 then
set ISE=($3E8-d)/700
endif
if ISE>0 then
set dispersionVictimPlayer1051=GetPlayerId(GetOwningPlayer(m5))
set V04[dispersionVictimPlayer1051]=true
call B67(u,m5,3,YS*ISE)
set V04[dispersionVictimPlayer1051]=false
endif
set u=null
set m5=null
endfunction
function ITE takes nothing returns boolean
local unit WX7=GetTriggerUnit()
local real VW9=GetEventDamage()
local integer BC7=B287_GetUnitAbilityLevel(WX7,'A0NA')
local group g
local unit spectreDamageSource=GetEventDamageSource()
local boolean spectreSkipDrainDamage=false
local real spectreAbsorbedDamage=0.
if spectreDamageSource!=null and GetUnitTypeId(spectreDamageSource)!=0 and GetUnitAbilityLevel(spectreDamageSource,'Bdcl')>0 and (B287_GetUnitAbilityLevel(spectreDamageSource,'A0CC')>0 or B287_GetUnitAbilityLevel(spectreDamageSource,'A02Z')>0) and LoadUnitHandle(L7,GetHandleId(spectreDamageSource),'A0CC')==WX7 then
set spectreSkipDrainDamage=true
endif
if BC7>0 and C677(VW9) and ISPH(WX7)==false and spectreSkipDrainDamage==false then
set spectreAbsorbedDamage=VW9*(.06+.04*BC7)
if SpectreDispersionReflecting then
// B822: nested damage still gets mitigation, but never starts another reflection.
// Do not write YS or clear the reflection guard owned by the outer callback.
call YN7(WX7,spectreAbsorbedDamage)
else
// Keep the guard across the entire synchronous group, including return damage.
// It also keeps nested owners from overwriting the shared YS damage amount.
set SpectreDispersionReflecting=true
set YS=spectreAbsorbedDamage
call YN7(WX7,spectreAbsorbedDamage)
set g=B1051DispersionTargets(WX7)
call ForGroup(g,function IRE)
set SpectreDispersionReflecting=false
endif
endif
set WX7=null
set g=null
set spectreDamageSource=null
return false
endfunction
function IUE takes unit WI7 returns nothing
