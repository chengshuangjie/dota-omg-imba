call SuijiMode_ApplyRegisteredCastRange4(u,'A0FW',active,600.,600.,600.,600.,0.,0.,0.,0.)
set changed=true
endif
return changed
endfunction
// UI callers must never populate the shared gameplay cache from local events.
function SuijiMode_ReadStableHeroIndex takes unit syncHero1111 returns integer
local integer syncHeroIndex1111=0
if syncHero1111==null or GetUnitTypeId(syncHero1111)==0 then
return 0
endif
set syncHeroIndex1111=LoadInteger(L7,GetHandleId(syncHero1111),StringHash("SuijiStableHeroIndex"))
if syncHeroIndex1111>=KL4 and syncHeroIndex1111<=K54 then
return syncHeroIndex1111
endif
return GetUnitPointValue(syncHero1111)
endfunction
function SuijiMode_GetStableHeroIndex takes unit u returns integer
local integer h=0
local integer heroIndex=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set h=GetHandleId(u)
set heroIndex=LoadInteger(L7,h,StringHash("SuijiStableHeroIndex"))
if heroIndex>=KL4 and heroIndex<=K54 then
return heroIndex
endif
set heroIndex=GetUnitPointValue(u)
if heroIndex>=KL4 and heroIndex<=K54 then
call SaveInteger(L7,h,StringHash("SuijiStableHeroIndex"),heroIndex)
endif
return heroIndex
endfunction
function SuijiMode_GetFixedPersistentNativeAghBook takes unit u returns integer
local integer id=0
local integer source=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set id=GetUnitTypeId(u)
set source=SuijiMode_GetStableHeroIndex(u)
if source>=KL4 and source<=K54 and HQ4[source]!=0 and (SuijiMode_IsFixedPersistentAghPair(HM4[source],HQ4[source]) or SuijiMode_IsFixedPersistentAghPair(HN4[source],HQ4[source]) or SuijiMode_IsFixedPersistentAghPair(HO4[source],HQ4[source]) or SuijiMode_IsFixedPersistentAghPair(HP4[source],HQ4[source])) then
return F29(u)
endif
if id=='Hmbr' then
return 'A0U1'
elseif id=='Hjai' or id=='Zjai' or id=='Zjaj' or id=='Zjak' then
return 'A0U3'
elseif id=='HC49' then
return 'A2SS'
elseif id=='E005' or id=='Z005' or id=='Z105' or id=='Z205' then
return 'A0UF'
elseif id=='H000' then
return 'A2ZI'
elseif id=='H06S' then
return 'A2XW'
elseif id=='U00A' or id=='Z00A' or id=='Z10A' then
return 'A2XZ'
elseif id=='E002' then
return 'A1UU'
elseif id=='Udea' then
return 'A1D3'
elseif id=='Uktl' or id=='Zktl' then
return 'A2SM'
elseif id=='N01A' then
return 'A2SV'
elseif id=='N0HP' then
return 'A2SF'
elseif id=='H00U' or id=='Z00U' or id=='Z10U' or id=='Z20U' or id=='Z02X' then
return 'A1BD'
endif
return 0
endfunction
function SuijiMode_NormalizeNativePersistentAgh takes unit u returns nothing
local integer book=0
if SUIJI_MODE==false then
return
endif
set book=SuijiMode_GetFixedPersistentNativeAghBook(u)
if book!=0 and GetUnitAbilityLevel(u,book)>0 then
call UnitRemoveAbility(u,book)
endif
endfunction
// OMG only: rawcode must match the hero's actual scepter state.
function SuijiMode_UsesAghPairVariant takes unit u,integer castSkill,integer normalSkill,integer aghSkill returns boolean
if u==null or GetUnitTypeId(u)==0 then
return false
endif
if castSkill!=normalSkill and castSkill!=aghSkill then
return false
endif
if SUIJI_MODE==false then
return true
endif
if SuijiMode_HasAghanimState(u) then
return castSkill==aghSkill
endif
return castSkill==normalSkill
endfunction
function CHIA_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
local string tx="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
local integer i1
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,1)
set i1=GetUnitTypeId(playeru)
if (i1=='N0MB' or i1=='N0MC' or i1=='N0MO' or i1=='N0MA') then
call X37(p2,"|c00FF0000开启严寒烧灼时无法购买|r")
set playeru=null
return
endif
if CHIA[GetPlayerId(p2)]==0 then
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call XF7(playeru,'A330')
call CHIA_TX(playeru,p2)
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
set CHIA[GetPlayerId(p2)]=1
call CHIA_SKILL(playeru,p2)
set SUIJI_AGH_UPDATE_UNIT=playeru
call ExecuteFunc("SuijiMode_UpdateAghSkillsAfterBlessing")
else
call X37(p2,"|c00FF0000英雄未持有阿哈利姆神杖|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
else
call DisplayTextToPlayer(p2,0,0, "|c00FF0000你已经购买过阿哈利姆祝福，返还购买金钱|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
call XF7(playeru,'A330')
call CHIA_SKILL(playeru,p2)
call CHIA_TX(playeru,p2)
set SUIJI_AGH_UPDATE_UNIT=playeru
call ExecuteFunc("SuijiMode_UpdateAghSkillsAfterBlessing")
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
endif
set playeru=null
endfunction
function CHIBS_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,2)
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call XF7(playeru,'A332')
call UnitMakeAbilityPermanent(playeru,true,'A14K')
call SetPlayerAbilityAvailable(p2,'A332',false)
call XF7(playeru,'A26A')
call XF7(playeru,'A333')
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl",playeru,"origin"))
if IsPlayerAlly(GetLocalPlayer(),p2) then
call PingMinimapEx(GetUnitX(playeru),GetUnitY(playeru),3,0,$FF,0,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(p2)]+(KZ4[GetPlayerId(p2)])+"|r |c00ffff00获得了真视之力|r")
endif
else
call X37(p2,"|c00FF0000英雄未持有真视宝石|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
set playeru=null
endfunction
function CHILLX_SKILL takes unit u,player p returns nothing
local integer id=GetUnitTypeId(u)
if id=='Ubal' or id=='Zbal' then
call XF7(u,'A33B')
call SetPlayerAbilityAvailable(p,'A33B',false)
endif
endfunction
function CHILLX_JUDGMENT takes player p2 returns nothing
local unit playeru=GetBuyingUnit()
local integer slot
local integer goldcost=2000
local string tx="Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl"
if IsUnitType(playeru,UNIT_TYPE_HERO)==false then
set playeru=M7[GetPlayerId(GetOwningPlayer(playeru))]
endif
set slot=FIND_SLOT(playeru,3)
if CHILLX[GetPlayerId(p2)]==0 then
if slot>-1 then
call RemoveItem(UnitItemInSlot(playeru,slot))
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
call XF7(playeru,'A334')
call XF7(playeru,'A2VW')
call CHILLX_SKILL(playeru,p2)
set CHILLX[GetPlayerId(p2)]=1
else
call X37(p2,"|c00FF0000英雄未持有玲珑心|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
endif
else
call DisplayTextToPlayer(p2,0,0, "|c00FF0000你已经购买过玲珑心之力，返还购买金钱|r")
call AdjustPlayerStateBJ(goldcost,p2,PLAYER_STATE_RESOURCE_GOLD)
call XF7(playeru,'A2VW')
call XF7(playeru,'A334')
call CHILLX_SKILL(playeru,p2)
call DestroyEffect(AddSpecialEffectTarget(tx,playeru,"origin"))
endif
set playeru=null
endfunction
function XPE takes integer O5,integer o6,integer n6,integer XQE,integer XRE,integer XSE,integer XTE,integer XUE returns nothing
set eY[$80+O5]=o6
set eY[$90+O5]=n6
set eY[$A0+O5]=XQE
set eY[$AC+O5]=XRE
set eY[$BC+O5]=XSE
set hG[$90+O5]=XTE
set hG[$A0+O5]=XUE
endfunction
