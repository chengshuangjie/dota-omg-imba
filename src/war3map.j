function VFF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn=O77(OB7,"Hero")
local real YM7=ON7(OB7,"Damage")
local real x=ON7(OB7,"x")
local real y=ON7(OB7,"y")
local boolean b=OO7(OB7,"HTMD")
local group g=WS7()
local integer GYE
local integer id=GetUnitTypeId(hn)
set AI_Send_Msg=true
set IN4=hn
set HTMD=b
call GroupEnumUnitsInRange(g,x,y,$E1,Condition(function AJ7_gai))
set GYE=CountUnitsInGroup(g)
if GYE<1 then
set GYE=1
endif
set IJ4=YM7/ GYE
call ForGroup(g,function VEF)
if id=='Z00U' then
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n4s_t_boom1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n4s_t_boom2.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n4s_t_boom3.mdl",x,y))
elseif id=='Z10U' then
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n3s_t_boom1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n3s_t_boom2.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n3s_t_boom3.mdl",x,y))
elseif id=='Z20U' then
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n2s_t_boom1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n2s_t_boom2.mdl",x,y))
call DestroyEffect(AddSpecialEffect("model\\hero_invoker_n2s_t_boom3.mdl",x,y))
else
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
endif
call WR7(g)
call DestroyEffect(OG7(OB7,"Effect"))
call NM7(OB7)
call OZ7(t)
set AI_Send_Msg=false
set AI_Send_BB=false
set t=null
set hn=null
set g=null
return false
endfunction
function SET_TH_TIP takes nothing returns nothing
local integer id=GetPlayerId(GetLocalPlayer())
local unit u
local string VH
local string array THTIP
if HaveSavedString(MSK,('A0VG'),(0)) then
    set VH=LoadStr(MSK,('A0VG'),(0))
else
    set VH=MHAbility_GetLevelDefDataStr('A0VG',1,ABILITY_LEVEL_DEF_DATA_UBERTIP)
    call SaveStr(MSK,('A0VG'),(0),(VH))
endif
set THTIP[id]=""
set u=M7[id]
if OM7(GetHandleId(u),"ExortLevel")>0 then
set THTIP[id]=I2S(R2I((OM7(GetHandleId(u),"ExortLevel"))*62.5+12.5+50))
set THTIP[id]="|n|n|cff99ccff当前伤害：|r"+THTIP[id]
endif
call MHAbility_SetLevelDefDataStr('A0VG',1,ABILITY_LEVEL_DEF_DATA_UBERTIP,VH+THTIP[id])
set u=null
endfunction
function TH_TRI takes unit ZX7,real x,real y,real YM7,string s,boolean b returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
if TY7(GetOwningPlayer(ZX7)) and b==false and IsVisibleToPlayer(x,y,GetOwningPlayer(ZX7))==false then
	set AI_Send_BB=true
endif
call Y57(GetOwningPlayer(ZX7),5.7,x,y,400)
call TriggerRegisterTimerEvent(t,1.7,false)
call TriggerAddCondition(t,Condition(function VFF))
call NT7(OB7,"Hero",ZX7)
call NQ7(OB7,"x",x)
call NQ7(OB7,"y",y)
call NQ7(OB7,"Damage",YM7)
call NU7(OB7,"Effect",AddSpecialEffect(s,x,y))
call NS7(OB7,"HTMD",b)
set t=null
endfunction
function VGF takes nothing returns nothing
local unit hn=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real x=GetLocationX(l)
local real y=GetLocationY(l)
local real YM7=(OM7(GetHandleId(hn),"ExortLevel"))*62.5+12.5+50
local string s=""
local string tx
local integer id=GetUnitTypeId(hn)
local real SrouceX=GetUnitX(hn)
local real SrouceY=GetUnitY(hn)
local boolean b=false
local unit IH7=GetSpellTargetUnit()
local group g
local real a
local real r
local real d=ReduceUnitAbilityCoolDownReal(hn)
local real cooldown=25.
local integer physicalSkill=B287_GetSpellPhysicalAbilityId()
if id=='Z00U' then
set tx="model\\hero_invoker_n4s_t_start.mdl"
elseif id=='Z10U' then
set tx="model\\hero_invoker_n3s_t_start.mdl"
elseif id=='Z20U'or id=='Z02X' then
set tx="model\\hero_invoker_n2s_t_start.mdl"
else
set tx="Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl"
endif
if SuijiMode_InvokerSpellScepterIsActive(hn,'A0VG') and RAbsBJ(SrouceX-x)<150 and RAbsBJ(SrouceY-y)<150 then
set b=true
endif
if b==false then
    if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(hn)) or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
        set s=tx
    endif
    call TH_TRI(hn,x,y,YM7,s,b)
    if d>0 then
        set cooldown=cooldown*d
call Japi_ReduceUnitAbilityCoolDown(hn,physicalSkill,cooldown)
    endif
else
    set s=tx
    set g=WS7()
    set D97=hn
    call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,Condition(function PTD))
    loop
    set IH7=FirstOfGroup(g)
    exitwhen IH7==null
    if IH7!=null then
        call GroupRemoveUnit(g,IH7)
        set a=GetRandomReal(0,360)
        set r=GetRandomReal(100,150)
        set x=GetUnitX(IH7)+r*Cos(a*bj_DEGTORAD)
        set y=GetUnitY(IH7)+r*Sin(a*bj_DEGTORAD)
        call TH_TRI(hn,x,y,YM7,s,b)
        if a>0 and a<=180 then
            set a=a+180
        elseif a>180 and a<=360 then
            set a=a-180
        endif
        set x=GetUnitX(IH7)+r*Cos(a*bj_DEGTORAD)
        set y=GetUnitY(IH7)+r*Sin(a*bj_DEGTORAD)
        call TH_TRI(hn,x,y,YM7,s,b)
    endif
    endloop
    call WR7(g)
    set cooldown=90.
    if d>0 then
call Japi_ReduceUnitAbilityCoolDown(hn,physicalSkill,cooldown*d)
    else
call Japi_ReduceUnitAbilityCoolDown(hn,physicalSkill,cooldown)
    endif
endif
call RemoveLocation(l)
set hn=null
set l=null
set IH7=null
set g=null
endfunction
