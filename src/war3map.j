function Func_cg takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local string VH=StringCase(GetEventPlayerChatString(),false)
local integer i
if not XM_MODE then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "|c00FF0000仅限XM模式可用|r")
set b1060GetTriggerPlayer=null
return
endif
if (Bz+N44>15.) then
call DisplayTimedTextToPlayer(b1060GetTriggerPlayer,0,0,10.,"太迟了不能设置，需在游戏开始后15秒内设置")
set b1060GetTriggerPlayer=null
return
endif
if SubString(VH,0,4)=="-cg " then
set i=S2I(SubString(VH,4,StringLength(VH)))
if i > 0 and i < 1001 then
set XM_EXP=i
set XM_GOLD=i
set XM_CG=true
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF00FF当前AI动态经验增加"+I2S(XM_EXP*10)+"%|r")
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF00FF当前AI动态金钱增加"+I2S(XM_GOLD*10)+"|r")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入 -cg 后面要加个空格再加数字(1~1000)")
endif
endif
if SubString(VH,0,4)=="-cge" then
set i=S2I(SubString(VH,5,StringLength(VH)))
if i > 0 and i < 1001 then
set XM_EXP=i
set XM_CG=true
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF00FF当前AI动态经验增加"+I2S(XM_EXP*10)+"%|r")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入 -cge 后面要加个空格再加数字(1~1000)")
endif
endif
if SubString(VH,0,4)=="-cgg" then
set i=S2I(SubString(VH,5,StringLength(VH)))
if i > 0 and i < 1001 then
set XM_GOLD=i
set XM_CG=true
call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF00FF当前AI动态金钱增加"+I2S(XM_GOLD*10)+"%|r")
else
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "输入 -cgg 后面要加个空格再加数字(1~1000)")
endif
endif
if not XM_CG then
call DisplayTextToPlayer(b1060GetTriggerPlayer,0,0, "请输入 -cg 或者 -cge 或者 -cgg 后面要加个空格再加数字(1~1000)")
endif
set b1060GetTriggerPlayer=null
endfunction
