function WW takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local real PLD=ON7(I97,"Life")
local real YM7=ON7(I97,"Damage")
local unit ZX7
local unit IH7=O77(I97,"Target")
local integer BC7
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
	if C677(b1060GetEventDamage)then
		if OT7(b1060GetTriggerUnit,"BorrowedTime|Active")==false then
			if PLD<b1060GetEventDamage then
				set ZX7=O77(I97,"Source")
				set BC7=OM7(I97,"Level")
				call DestroyEffect(OG7(I97,"FX"))
				call NS7(GetHandleId(IH7),"AphoticShield|Active",false)
				call NM7(I97)
				call OZ7(t)
				call YN7(b1060GetTriggerUnit,PLD)
				call P6D(ZX7,b1060GetTriggerUnit,YM7)
if B946DetectCount>0 then
				set GZ[256+GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))]=B962Flag(1,256+GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit)),false,"WW @ war3map.j:90610 (B968)")
else
				set GZ[256+GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))]=false
endif
			elseif b1060GetEventDamage>0 then
				call YN7(b1060GetTriggerUnit,b1060GetEventDamage)
				call NQ7(I97,"Life",PLD-b1060GetEventDamage)
			endif
		endif
	endif
else
	set ZX7=O77(I97,"Source")
	set BC7=OM7(I97,"Level")
	call NS7(GetHandleId(IH7),"AphoticShield|Active",false)
if B946DetectCount>0 then
	set GZ[256+GetPlayerId(GetOwningPlayer(O77(I97,"AphTarg")))]=B962Flag(1,256+GetPlayerId(GetOwningPlayer(O77(I97,"AphTarg"))),false,"WW @ war3map.j:90625 (B968)")
else
	set GZ[256+GetPlayerId(GetOwningPlayer(O77(I97,"AphTarg")))]=false
endif
	call DestroyEffect(OG7(I97,"FX"))
	call NM7(I97)
	call OZ7(t)
	call P6D(ZX7,IH7,YM7)
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function P1D takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=GetTriggerUnit()
local unit IH7=b1060GetSpellTargetUnit
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A0MF')
local integer IED=GetHandleId(IH7)
local real PLD=50+50*BC7
local real YM7=50+50*BC7
local unit BB7
if OO7(IED,"AphoticShield|Active") then
call TriggerEvaluate(OE7(IED,"AphoticShield|Trigger"))
endif
call YZ8(IH7)
call YW8(IH7,0,0)
call NQ7(I97,"Life",PLD)
call NQ7(I97,"Damage",YM7)
call NU7(I97,"FX",AddSpecialEffectTarget("war3mapImported\\Defensive Barrier big.mdx",IH7,"chest"))
call NT7(I97,"Source",ZX7)
call NP7(I97,"Level",BC7)
call NT7(I97,"Target",IH7)
if B946DetectCount>0 then
set GZ[256+GetPlayerId(GetOwningPlayer(b1060GetSpellTargetUnit))]=B962Flag(1,256+GetPlayerId(GetOwningPlayer(b1060GetSpellTargetUnit)),true,"P1D @ war3map.j:90661 (B968)")
else
set GZ[256+GetPlayerId(GetOwningPlayer(b1060GetSpellTargetUnit))]=true
endif
call B1023RegisterDamage(t,IH7)
call TriggerRegisterTimerEvent(t,15,false)
call TriggerAddCondition(t,Condition(function WW))
call NV7(IED,"AphoticShield|Trigger",t)
call NS7(IED,"AphoticShield|Active",true)
if ZX7!=IH7 and GetUnitTypeId(ZX7)!='e00E' and SuijiMode_ScepterRegistryIsActive(ZX7,'A0MF') then
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',GetUnitX(ZX7),GetUnitY(ZX7),0)
	call XF7(BB7,'A0MF')
	call B287_SetUnitAbilityLevel(BB7,'A0MF',BC7)
	call B947IssueTargetOrderById("P1D @ war3map.j:90674 (B968)",BB7,$D0097,ZX7)
endif
set t=null
set IH7=null
set ZX7=null
set BB7=null
set b1060GetSpellTargetUnit=null
endfunction
