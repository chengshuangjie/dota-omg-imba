function JY2 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local real x
local real y
local integer NPI=GetTriggerEvalCount(t)
local image JZ2=(LoadImageHandle(L7,(OB7),(158)))
local image JV2=(LoadImageHandle(L7,(OB7),(159)))
local image JJ2=(LoadImageHandle(L7,(OB7),(160)))
local image JK2=(LoadImageHandle(L7,(OB7),(161)))
local image JL2=(LoadImageHandle(L7,(OB7),(162)))
local image JM2=(LoadImageHandle(L7,(OB7),(163)))
local image JN2=(LoadImageHandle(L7,(OB7),(164)))
local image JS2=(LoadImageHandle(L7,(OB7),(165)))
local integer a
local player p=(LoadPlayerHandle(L7,(OB7),(54)))
local integer times=LoadInteger(L7,OB7,10)
set x=QQ0
set y=QU0+250
if NPI>0 then
call ShowImage(JZ2,false)
call DestroyImage(JZ2)
call ShowImage(JV2,false)
call DestroyImage(JV2)
call ShowImage(JJ2,false)
call DestroyImage(JJ2)
call ShowImage(JK2,false)
call DestroyImage(JK2)
call ShowImage(JL2,false)
call DestroyImage(JL2)
call ShowImage(JM2,false)
call DestroyImage(JM2)
call ShowImage(JN2,false)
call DestroyImage(JN2)
call ShowImage(JS2,false)
call DestroyImage(JS2)
endif
if NPI==times then
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
else
if GetLocalPlayer()==QM0 or GetLocalPlayer()==QN0 then
set a=255
else
set a=0
endif
call JX2(a,x,y,OB7)
endif
set t=null
set JZ2=null
set JV2=null
set JJ2=null
set JK2=null
set JL2=null
set JM2=null
set JN2=null
set JS2=null
set p=null
return false
endfunction
function JT2 takes player p,integer times returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddCondition(t,Condition(function JY2))
call SavePlayerHandle(L7,(OB7),(54),(p))
call SaveInteger(L7,(OB7),(10),(times))
call TriggerEvaluate(t)
set t=null
endfunction
function JR2 takes player p,integer MLI,boolean randomed returns nothing //创建马甲和英雄
local integer i=qA(p)+2
local real d
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING then //非在线玩家就没有英雄
return
endif
if TV7(p)then
call SetUnitPosition(U90[MLI],UX0[i],UY0[i])
set d=YK7(XX7(U90[MLI])-0.3,0.5)
call SetUnitScale(U90[MLI],d,d,d)
call SetUnitFacing(U90[MLI],270)
call UnitRemoveAbility(U90[MLI],'Amov')
else
call SetUnitPosition(U90[MLI],UJ0[i],UK0[i])
set d=YK7(XX7(U90[MLI])-0.3,0.5)
call SetUnitScale(U90[MLI],d,d,d)
call SetUnitFacing(U90[MLI],90)
call UnitRemoveAbility(U90[MLI],'Amov')
endif
call SetUnitColor(U90[MLI],GetPlayerColor(p))
call PauseUnit(U90[MLI],true)
call SetUnitOwner(U90[MLI],p,true)
set QP0[GetPlayerId(p)]=true
set Selected[MLI]=true
if TV7(p)then
set M7[GetPlayerId(p)]=CreateUnit(p,K34[U70[MLI]],GetRectCenterX(ED),GetRectCenterY(ED),0)
else
set M7[GetPlayerId(p)]=CreateUnit(p,K34[U70[MLI]],GetRectCenterX(L9),GetRectCenterY(L9),0)
endif
set mu_select_bool[GetPlayerId(p)] = false
call RemoveUnit(mu_select_hero[GetPlayerId(p)])
endfunction
function JP3 takes player p returns nothing
    if TV7(p) then
        set JW_HERO=JW_HERO+1
    else
        set TZ_HERO=TZ_HERO+1
    endif
endfunction
function CX_HERO_OK takes integer num,integer TYPE returns boolean
    local integer i=1
    if TYPE==1 then
        loop
        exitwhen i>LL_HERO_NUM
        if num==LL_HERO_GROUP[i] then
            return true
        endif
        set i=i+1
        endloop
    elseif TYPE==2 then
        loop
        exitwhen i>MJ_HERO_NUM
        if num==MJ_HERO_GROUP[i] then
            return true
        endif
        set i=i+1
        endloop
    elseif TYPE==3 then
        loop
        exitwhen i>ZL_HERO_NUM
        if num==ZL_HERO_GROUP[i] then
            return true
        endif
        set i=i+1
        endloop
    endif
    return false
endfunction
function AI_NO_SELECT_HERO takes integer i returns boolean
    if i!=113 and i!=114 and i!=115 and i!=58 and i!=89 and i!=16 and i!=19 and i!=24 and i!=54 then
        return true
    endif
    return false
endfunction
function JP2 takes player p returns integer
local integer i=1
local integer num
local integer TYPE
local integer SLOT
local integer ATTR=0
if TY7(p) then
    loop
    exitwhen i>28
    if Selected[i]==false then
        return i
    endif
    set i=i+1
    endloop
endif
if TV7(p) then
    set TYPE=JW_TYPE
    set SLOT=JW_HERO
else
    set TYPE=TZ_TYPE
    set SLOT=TZ_HERO
endif
//阵容类型401、320、311、221、212
//阵容类型401、320、311、221、212
//阵容类型401、320、311、221、212
if TYPE==1 then
    if SLOT==0 or SLOT==1 or SLOT==2 or SLOT==3 then
        set ATTR=1
    else
        set ATTR=3
    endif
elseif TYPE==2 then
    if SLOT==0 or SLOT==1 or SLOT==2 then
        set ATTR=1
    else
        set ATTR=2
    endif
elseif TYPE==3 then
    if SLOT==0 or SLOT==1 or SLOT==2 then
        set ATTR=1
    elseif SLOT==3 then
        set ATTR=2
    else
        set ATTR=3
    endif
elseif TYPE==4 then
    if SLOT==0 or SLOT==1 then
        set ATTR=1
    elseif SLOT==2 or SLOT==3 then
        set ATTR=2
    else
        set ATTR=3
    endif
elseif TYPE==5 then
    if SLOT==0 or SLOT==1 then
        set ATTR=1
    elseif SLOT==2 then
        set ATTR=2
    else
        set ATTR=3
    endif
endif
if ATTR==1 then
    loop
    exitwhen i>28
    set num=U70[i]
    if Selected[i]==false and CX_HERO_OK(num,1) and AI_NO_SELECT_HERO(num) then
        call JP3(p)
        return i
    endif
    set i=i+1
    endloop
elseif ATTR==2 then
    loop
    exitwhen i>28
    set num=U70[i]
    if Selected[i]==false and CX_HERO_OK(num,2) and AI_NO_SELECT_HERO(num) then
        call JP3(p)
        return i
    endif
    set i=i+1
    endloop
elseif ATTR==3 then
    loop
    exitwhen i>28
    set num=U70[i]
    if Selected[i]==false and CX_HERO_OK(num,3) and AI_NO_SELECT_HERO(num) then
        call JP3(p)
        return i
    endif
    set i=i+1
    endloop
endif
set i=1
loop
exitwhen i>28
set num=U70[i]
if Selected[i]==false and AI_NO_SELECT_HERO(num) then
return i
endif
set i=i+1
endloop
return 0
endfunction
function AUTO_SELECT_HERO takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer OB7=GetHandleId(t)
    local player p=(LoadPlayerHandle(L7,(OB7),(0)))
    local integer WF8=GetTriggerEvalCount(t)
    if (WF8>4 and GetRandomInt(1,4)==1) or WF8==17 then
        call JR2(p,JP2(p),true)
        call NM7(OB7)
        call OZ7(t)
    endif
    set t=null
    set p=null
    return false
endfunction
function ZC_AUTO_SELECT_HERO takes player p returns nothing
    local trigger t
    local integer OB7
    if p!=null and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)!=MAP_CONTROL_USER then
        set t=CreateTrigger()
        set OB7=GetHandleId(t)
        call SavePlayerHandle(L7,(OB7),(0),p)
        call TriggerRegisterTimerEvent(t,1,true)
        call TriggerAddCondition(t,Condition(function AUTO_SELECT_HERO))
    endif
    set t=null
endfunction
function JQ2 takes player p returns nothing
local integer i=1
local boolean JU2=TV7(p)
loop
exitwhen i==28
if GetOwningPlayer(U90[i])==Z7[0]or GetOwningPlayer(U90[i])==A7[0]then
if JU2 then
call SetUnitOwner(U90[i],Z7[0],false)
else
call SetUnitOwner(U90[i],A7[0],false)
endif
endif
set i=i+1
endloop
endfunction
