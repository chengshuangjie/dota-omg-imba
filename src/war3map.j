endfunction
function BED takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
local integer BC7=0
local unit BB7=O77(I97,"Caster")
