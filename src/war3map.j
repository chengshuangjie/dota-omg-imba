call Z57(WI7,'A4MP',1,3,'B0KV')
call SaveInteger(L7,GetHandleId(WI7),'B0KV',1)
call SetUnitPhaseMove(WI7,true)
// set b=true
// endif
// set b=true
// endif
// set b=true
// endif
call TriggerRegisterTimerEvent(t,.1,false)
call TriggerAddCondition(t,Condition(function GXG))
call NT7(OB7,"Hero",WI7)
// call NS7(OB7,"HaveA",b)
set t=null
set WI7=null
endfunction
//能量齿轮
function GBG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0Z5' then
call GAG()
endif
return false
endfunction
function COG_Damaging_EVENT takes nothing returns boolean
	local unit m5=MHEvent_GetUnit()
	local unit cogDamageSource=MHDamagingEvent_GetSource()
	local integer id=0
	if m5==null or cogDamageSource==null or GetUnitTypeId(m5)==0 or GetUnitTypeId(cogDamageSource)==0 then
		set m5=null
		set cogDamageSource=null
		return false
	endif
	set id=GetUnitTypeId(m5)
	if id=='u00S' and MHDamagingEvent_GetDamage()>0 and MHDamagingEvent_IsPhysical() then
		if GetOwningPlayer(cogDamageSource)==GetOwningPlayer(m5) then
			call MHDamagingEvent_SetDamage(0)
		else
			call MHDamagingEvent_SetDamage(1.)
		endif
	endif
	set m5=null
	set cogDamageSource=null
	return false
endfunction
function GearKickAction takes nothing returns nothing
local unit gear=U22
local unit target=GetEnumUnit()
local unit hero=IN4
local integer level=IH4
if GetUnitState(target, UNIT_STATE_MANA) > 0 and OT7(target, "PowerCogShocked") == false then
	if IsUnitInGroup(target,JQH)==false then
		call GroupAddUnit(JQH,target)
        call ApplyCogRebound(target, GetUnitX(gear), GetUnitY(gear), hero, level, true)
	endif
endif
set gear=null
set target=null
set hero=null
endfunction
function GearKickTimer takes nothing returns boolean
    local trigger t = GetTriggeringTrigger()
    local integer OB7 = GetHandleId(t)
    local unit gear = O77(OB7, "Gear")
    local real angle = ON7(OB7, "Angle")
    local real distLeft = ON7(OB7, "Dist")
    local real step = ON7(OB7, "Speed")
    local real x = GetUnitX(gear) + step * Cos(angle)
    local real y = GetUnitY(gear) + step * Sin(angle)
    local group g
	local group AlreadyDamagedGroup=OF7(OB7,"AlreadyDamaged")
    local unit hero = O77(OB7, "Owner")
    local integer level = OM7(OB7, "Level")
	set x=X17(x)
	set y=X07(y)
    if UnitAlive(gear)==false then
		call WR7(AlreadyDamagedGroup)
        call NM7(OB7)
        call OZ7(t)
		set gear = null
		set hero = null
		set AlreadyDamagedGroup = null
        return false
    endif
    set g = WS7()
	set IN4=hero
	set U22=gear
	set JQH=AlreadyDamagedGroup
	set IH4=level
    call GroupEnumUnitsInRange(g,x,y,150, Condition(function AJ7_gai))
	call ForGroup(g,function GearKickAction)
    call WR7(g)
	call SetUnitPosition(gear, x, y)
	call SetUnitX(gear,x)
	call SetUnitY(gear,y)
    set distLeft = distLeft - step
    call NQ7(OB7, "Dist", distLeft)
    if distLeft <= 0 then
		call MHUnit_SetModel(gear,"buildings\\other\\PowerGenerator\\PowerGenerator.mdl",false)
		call SetUnitScale(gear,XX7(gear),XX7(gear),XX7(gear))
		call KillUnit(gear)
		call WR7(AlreadyDamagedGroup)
        call NM7(OB7)
        call OZ7(t)
    endif
	set g = null
    set gear = null
    set hero = null
	set AlreadyDamagedGroup = null
    return false
endfunction
function KickGear takes unit gear, unit hero returns nothing
    local real angle = Atan2(GetUnitY(gear)-GetUnitY(hero), GetUnitX(gear)-GetUnitX(hero))
    local integer parentOB7 = OM7(GetHandleId(gear), "CogParent")
    local integer index = OM7(GetHandleId(gear), "CogIndex")
    local trigger t
    local integer OB7
local integer level=B287_GetUnitAbilityLevel(hero,'A0Z5')
	local real dist = 1000.
	local real speed = 18
    if parentOB7 != 0 and index > 0 then
        call NT7(parentOB7, "Cog"+I2S(index), null)
    endif
	call SetUnitInvulnerable(gear,true)
	if SuijiMode_ScepterRegistryIsActive(hero,'A0Z5') then
		set dist=1500
		set speed=27
		call MHUnit_SetModel(gear,"effects\\football.mdl",false)
		call SetUnitScale(gear,4.5,4.5,4.5)
		call SetUnitFlyHeight(gear,25,0)
	endif
    call OV7(gear, "PowerCogKicked")
	call NP7(GetHandleId(gear), "PowerCogUsed", 1)
    set t = CreateTrigger()
    set OB7 = GetHandleId(t)
    call NT7(OB7, "Gear", gear)
    call NQ7(OB7, "Angle", angle)
    call NQ7(OB7, "Dist", dist)
	call NQ7(OB7, "Speed", speed)
    call NT7(OB7, "Owner", hero)
	call NP7(OB7, "Level", level)
	call NB7(OB7,"AlreadyDamaged",WS7())
    call TriggerRegisterTimerEvent(t, 0.02, true)
    call TriggerAddCondition(t, Condition(function GearKickTimer))
    set t = null
endfunction
function COG_Damage_EVENT takes nothing returns boolean
    local unit gear = MHEvent_GetUnit()
    local unit attacker = MHDamageEvent_GetSource()
    if gear!=null and attacker!=null and GetUnitTypeId(gear)=='u00S' and GetUnitTypeId(attacker)!=0 and UnitAlive(gear) and GetOwningPlayer(attacker)==GetOwningPlayer(gear) and MHDamageEvent_IsPhysical() and OT7(gear, "PowerCogKicked") == false and OM7(GetHandleId(gear), "PowerCogUsed")==0 then
        call KickGear(gear, attacker)
    endif
    set gear = null
    set attacker = null
    return false
endfunction
function MA8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function GBG))
set t=CreateTrigger()
call TriggerAddCondition(t, Condition(function COG_Damaging_EVENT))
call MHDamagingEvent_Register(t)
set t=CreateTrigger()
call TriggerAddCondition(t, Condition(function COG_Damage_EVENT))
call MHDamageEvent_Register(t)
set t=null
endfunction
function GCG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if WF7((b1060GetEnumUnit))==false then
call B67(IN4,(b1060GetEnumUnit),1,IJ4)
call Z57((b1060GetEnumUnit),'A4MN', 1, 0.5, 'B0KT')
endif
set b1060GetEnumUnit=null
endfunction
function G3G takes unit G6G,real x,real y,boolean aghExtra returns nothing
local real x1
local real y1
local group g=WS7()
local integer GLG=B287_GetUnitAbilityLevel(G6G,'A0Z6')
local real G1G=75*GLG
if aghExtra then
set G1G=G1G*.5
endif
set IN4=G6G
set IJ4=G1G
call GroupEnumUnitsInRange(g,x,y,600,Condition(function AJ7_gai))
call ForGroup(g,function GCG)
call WR7(g)
set x1=x
set y1=y
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
set x1=x+$C8
set y1=y+$C8
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
set x1=x+$C8
set y1=y-$C8
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
set x1=x-$C8
set y1=y+$C8
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
set x1=x-$C8
set y1=y-$C8
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FlyingMachine\\FlyingMachineImpact.mdl",x1,y1))
call Y57(GetOwningPlayer(G6G),$A,x,y,600)
set g=null
endfunction
function G0G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit hn
local unit G5G=O77(OB7,"Projectile")
local real G2G=ON7(OB7,"TargetX")
local real G_G=ON7(OB7,"TargetY")
local real H4G=ON7(OB7,"Angle")
local real H7G=ON7(OB7,"SourceX")
local real H8G=ON7(OB7,"SourceY")
local real H9G=X17(H7G+30*Cos(H4G))
local real HDG=X07(H8G+30*Sin(H4G))
local boolean aghExtra=LoadBoolean(L7,OB7,StringHash("RocketFlareAghExtra"))
call SetUnitX(G5G,H9G)
call SetUnitY(G5G,HDG)
call NQ7(OB7,"SourceX",H9G)
call NQ7(OB7,"SourceY",HDG)
if BlockUnitPass(G5G) then
    call KillUnit(G5G)
    call NM7(OB7)
    call OZ7(t)
elseif KF7(G2G,G_G,H9G,HDG)<=35 then
    call KillUnit(G5G)
    set hn=O77(OB7,"Hero")
    call G3G(hn,H9G,HDG,aghExtra)
    call NM7(OB7)
    call OZ7(t)
endif
set t=null
set hn=null
set G5G=null
return false
endfunction
function RocketFlare_CreateProjectile takes unit hn,real G2G,real G_G,boolean aghExtra returns nothing
local real H7G=X17(GetUnitX(hn))
local real H8G=X07(GetUnitY(hn))
local real targetX=X17(G2G)
local real targetY=X07(G_G)
local real H4G=Atan2(targetY-H8G,targetX-H7G)
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit G5G=CreateUnit(GetOwningPlayer(hn),'h03Y',H7G,H8G,H4G*bj_RADTODEG)
call SetUnitFacing(G5G,H4G*bj_RADTODEG)
call SetUnitPathing(G5G,false)
call XF7(G5G,'Aloc')
call ShowUnit(G5G,false)
call UnitRemoveAbility(G5G,'Aloc')
call ShowUnit(G5G,true)
call NQ7(OB7,"OriginalX",H7G)
call NQ7(OB7,"OriginalY",H8G)
call NQ7(OB7,"SourceX",H7G)
call NQ7(OB7,"SourceY",H8G)
call NQ7(OB7,"TargetX",targetX)
call NQ7(OB7,"TargetY",targetY)
call NQ7(OB7,"Angle",H4G)
call SaveBoolean(L7,OB7,StringHash("RocketFlareAghExtra"),aghExtra)
call NT7(OB7,"Hero",hn)
call NT7(OB7,"Projectile",G5G)
call TriggerRegisterTimerEvent(t,.025,true)
call TriggerAddCondition(t,Condition(function G0G))
set t=null
set G5G=null
endfunction
function HEG takes nothing returns nothing
local unit hn=GetTriggerUnit()
local location HFG=GetSpellTargetLoc()
local real G2G=X17(GetLocationX(HFG))
local real G_G=X07(GetLocationY(HFG))
call RemoveLocation(HFG)
call RocketFlare_CreateProjectile(hn,G2G,G_G,false)
if SuijiMode_ScepterRegistryIsActive(hn,'A0Z6') and SuijiMode_DetectAghanimSourceState(hn) then
    call RocketFlare_CreateProjectile(hn,G2G+600.,G_G,true)
    call RocketFlare_CreateProjectile(hn,G2G-600.,G_G,true)
    call RocketFlare_CreateProjectile(hn,G2G,G_G+600.,true)
    call RocketFlare_CreateProjectile(hn,G2G,G_G-600.,true)
endif
set hn=null
set HFG=null
endfunction
function HGG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0Z6' then
call HEG()
endif
return false
endfunction
function MB8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function HGG))
set t=null
endfunction
function HHG takes unit p5,unit m5 returns nothing
local integer level=B287_GetUnitAbilityLevel(p5,'A0Z8')
local real d=75*level
if SuijiMode_ScepterRegistryIsActive(p5,'A0Z8') then
set d=100*level+50
endif
call CommonUnitAddStun(m5, 0.25*level+1, true)
call B67(p5,m5,1,d)
endfunction
function HIG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),IQ4)==false then
call GroupAddUnit(IQ4,(b1060GetEnumUnit))
call HHG(IN4,(b1060GetEnumUnit))
endif
set b1060GetEnumUnit=null
endfunction
function HJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local unit m5=O77(OB7,"Target")
local integer HKG=OM7(OB7,"MaxLinks")
local integer U38=GetTriggerEvalCount(t)
local unit HMG
local group HNG=OF7(OB7,"AlreadyAdded")
local group g
local real HOG=225
if m5==null then
set HMG=O77(OB7,"HPG"+I2S(HKG+1-U38))
call RemoveUnit(HMG)
else
set HMG=O77(OB7,"HPG"+I2S(U38))
if IsHideUnit(WI7)==false then
    call SetUnitX(WI7,GetUnitX(HMG))
    call SetUnitY(WI7,GetUnitY(HMG))
endif
call RemoveUnit(HMG)
if U38==HKG then
set HOG=225
endif
set g=WS7()
set IN4=WI7
set IQ4=HNG
call GroupEnumUnitsInRange(g,GetUnitX(WI7),GetUnitY(WI7),HOG,Condition(function AJ7_gai))
call ForGroup(g,function HIG)
call WR7(g)
endif
if U38==HKG then
if m5!=null then
call PauseUnitEx(m5,false)
endif
call Y67(GetUnitX(WI7),GetUnitY(WI7),100)
call WR7(HNG)
call NM7(OB7)
call OZ7(t)
endif
set t=null
set WI7=null
set m5=null
set HMG=null
set HNG=null
set g=null
return false
endfunction
function HQG_PD2 takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='u014' or GetUnitTypeId(GetFilterUnit())=='u015' or GetUnitTypeId(GetFilterUnit())=='u016' or GetUnitTypeId(GetFilterUnit())=='u01D' or GetUnitTypeId(GetFilterUnit())=='u01E' or GetUnitTypeId(GetFilterUnit())=='u01F' or GetUnitTypeId(GetFilterUnit())=='u01R' or GetUnitTypeId(GetFilterUnit())=='u01S' or GetUnitTypeId(GetFilterUnit())=='u01T' or GetUnitTypeId(GetFilterUnit())=='u017' or GetUnitTypeId(GetFilterUnit())=='u019' or GetUnitTypeId(GetFilterUnit())=='u018' or GetUnitTypeId(GetFilterUnit())=='u01A' or GetUnitTypeId(GetFilterUnit())=='u01B' or GetUnitTypeId(GetFilterUnit())=='u01C' or GetUnitTypeId(GetFilterUnit())=='u01U' or GetUnitTypeId(GetFilterUnit())=='u01V' or GetUnitTypeId(GetFilterUnit())=='u01W' or GetUnitTypeId(GetFilterUnit())=='n01Q' or GetUnitTypeId(GetFilterUnit())=='n01R' or GetUnitTypeId(GetFilterUnit())=='ntor' or GetUnitTypeId(GetFilterUnit())=='h0BT'
endfunction
function HQG_PD takes nothing returns boolean
return (GetUnitAbilityLevel(GetFilterUnit(),'A04R')==0 and IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)==false and XH7(GetFilterUnit())==false and CHUIFENG(GetFilterUnit())==false and HQG_PD2()==false and IsHideUnit(GetFilterUnit())==false)!=null
endfunction
function HQG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=O77(OB7,"Hero")
local real l4=ON7(OB7,"Angle")
local integer OBD=OM7(OB7,"MaxCount")
local integer U38=GetTriggerEvalCount(t)
local real x=CoordinateX50(GetUnitX(WI7)+U38*50*Cos(l4*bj_DEGTORAD))
local real y=CoordinateY50(GetUnitY(WI7)+U38*50*Sin(l4*bj_DEGTORAD))
local boolean EWD=OO7(OB7,"Scepter")
local unit HRG
local trigger HSG=OE7(OB7,"Retract")
local integer FGE=GetHandleId(HSG)
local group g=WS7()
local unit m5
local integer ID='u00V'
local real HOG=125
if U38==1 then
set HOG=100
endif
set IN4=WI7
call GroupEnumUnitsInRange(g,x,y,HOG,Condition(function HQG_PD))
call GroupRemoveUnit(g,WI7)
set m5=GroupPickRandomUnit(g)
call WR7(g)
if m5!=null or U38==OBD or U38==(OBD-1)or U38==(OBD-2)then
set ID='u00U'
endif
set HRG=CreateUnit(GetOwningPlayer(WI7),ID,x,y,l4)
call NT7(FGE,"HPG"+I2S(U38),HRG)
if m5!=null then
if(IsUnitAlly(m5,GetOwningPlayer(WI7)) and EWD==false)or OT7(m5,"Frozen") then
set m5=null
endif
call NM7(OB7)
call OZ7(t)
if m5!=null and IsUnitAlly(m5,GetOwningPlayer(WI7))==false then
call PauseUnitEx(m5,true)
endif
call TriggerRegisterTimerEvent(HSG,.5/ OBD,true)
call TriggerAddCondition(HSG,Condition(function HJG))
call NP7(FGE,"MaxLinks",U38)
call NT7(FGE,"Target",m5)
call NT7(FGE,"Hero",WI7)
call NB7(FGE,"AlreadyAdded",WS7())
elseif U38>OBD or BlockUnitPass(HRG) then
set m5=null
call NM7(OB7)
call OZ7(t)
call TriggerRegisterTimerEvent(HSG,.5/ OBD,true)
call TriggerAddCondition(HSG,Condition(function HJG))
call NP7(FGE,"MaxLinks",U38)
call NT7(FGE,"Target",m5)
call NT7(FGE,"Hero",WI7)
call NB7(FGE,"AlreadyAdded",WS7())
endif
set t=null
set WI7=null
set HRG=null
set HSG=null
set g=null
set m5=null
return false
endfunction
function HPG takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local unit WI7=GetTriggerUnit()
local location l=GetSpellTargetLoc()
local real l4=J77(GetUnitX(WI7),GetUnitY(WI7),GetLocationX(l),GetLocationY(l))
local integer V77=B287_GetUnitAbilityLevel(WI7,'A0Z8')
local integer HTG
local integer OBD
local boolean EWD=true
local integer suijiDisplacementCount=B290_GetDisplacementMulticastCount(WI7,B287_GetSpellAbilityId())
if SuijiMode_ScepterRegistryIsActive(WI7,'A0Z8') then
set EWD=true
endif
set HTG=700+200*V77
set HTG=HTG+GetUnitAbilityLevel(WI7,'A4DJ')*50+GetUnitAbilityLevel(WI7,'A4DZ')*50
if GetUnitAbilityLevel(WI7,'A2YK')>0 then
	set HTG=HTG+200
elseif GetUnitAbilityLevel(WI7,'A2YJ')>0 then
	set HTG=HTG+150
endif
set HTG=HTG*suijiDisplacementCount
set OBD=HTG/ 50
call NT7(OB7,"Hero",WI7)
call NP7(OB7,"Level",V77)
call NQ7(OB7,"Angle",l4*1.)
call NP7(OB7,"MaxCount",OBD)
call NV7(OB7,"Retract",CreateTrigger())
call NS7(OB7,"Scepter",EWD)
call TriggerRegisterTimerEvent(t,.5/ OBD,true)
call TriggerAddCondition(t,Condition(function HQG))
call RemoveLocation(l)
set t=null
set WI7=null
set l=null
endfunction
function HUG takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0Z8' or B287_GetSpellAbilityId()=='A1CV' then
call HPG()
endif
return false
endfunction
function MC8 takes nothing returns nothing
