function B962Flag takes integer family962,integer index962,boolean value962,string source962 returns boolean
local integer pid962=-1
local integer key962=index962+family962*512
local boolean old962=false
if B946DetectCount==0 then
return value962
endif
if family962==0 then
if index962>=32 and index962<44 then
set pid962=index962-32
elseif index962>=128 and index962<140 then
set pid962=index962-128
elseif index962>=240 and index962<252 then
set pid962=index962-240
endif
set old962=G0[index962]
else
if index962>=160 and index962<172 then
set pid962=index962-160
endif
set old962=GZ[index962]
endif
if pid962>=0 then
if B946DetectCount>0 then
set B962FlagWrite[key962]=source962
endif
if old962!=value962 then
if B946DetectCount>0 then
set B962FlagChange[key962]=source962
endif
if B946DetectCount>0 then
set B962FlagTime[key962]=TimerGetElapsed(W)
endif
if B946DetectCount>0 then
if B946DetectCount>0 then
call B960RouteText(M7[pid962],"标记变化 族="+I2S(family962)+" 索引="+I2S(index962)+" "+B962Bool(old962)+" -> "+B962Bool(value962)+"\n    来源："+source962)
endif
endif
endif
endif
return value962
endfunction
