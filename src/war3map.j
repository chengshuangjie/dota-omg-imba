//死随自动学习技能
function LEARN_SKILL takes unit it,integer O5 returns nothing
local integer i1=GetUnitTypeId(it)
local integer i=1
loop
exitwhen i>7
call B287_SelectHeroSkill(it,eY[$80+O5])
call B287_SelectHeroSkill(it,eY[$90+O5])
call B287_SelectHeroSkill(it,eY[$A0+O5])
call B287_SelectHeroSkill(it,eY[$AC+O5])
if(eY[$BC+O5]!=0)then
call B287_SelectHeroSkill(it,eY[$BC+O5])
endif
if i1=='UC76' then
call SelectHeroSkill(it,kT(it))
call SelectHeroSkill(it,kS(it))
call SelectHeroSkill(it,QH7(it))
call SelectHeroSkill(it,'A1PH')
elseif i1=='Hmkg' then
call SelectHeroSkill(it,QI7(it))
call SelectHeroSkill(it,QJ7(it))
call SelectHeroSkill(it,QK7(it))
elseif i1=='N01O' then
call SelectHeroSkill(it,'A1EG')
call SelectHeroSkill(it,'A1EI')
call SelectHeroSkill(it,'A1EH')
call SelectHeroSkill(it,'A1EE')
call SelectHeroSkill(it,'A1EF')
endif
set i=i+1
endloop
//黄点
set i=1
loop
exitwhen i>10
if i1=='Nfir' or i1=='O00P' or i1=='N01O' or i1=='N013' or i1=='N014' or i1=='N015' or (i1=='Hblm' or i1=='H06X' or i1=='H06Y' or i1=='H06W') or i1=='H00K' or i1=='E02F' or i1=='O01F' or i1=='E02X' or i1=='H0BC' or i1=='H06W' or i1=='H06X' or i1=='H06Y' or i1=='O016' or i1=='O017' or i1=='UC60' or i1=='UC42' or i1=='O00P' or i1=='H00R' or i1=='H07I' or i1=='N0MU' or i1=='N0MV' or i1=='E01B' or i1=='Z052' or i1=='Z060' or i1=='U00C' or i1=='Z00C' then
call SelectHeroSkill(it,'A0NR')
else
call SelectHeroSkill(it,'Aamk')
endif
set i=i+1
endloop
endfunction
