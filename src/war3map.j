//动物信使
function KU7 takes unit I_7 returns boolean
local integer id=GetUnitTypeId(I_7)
return id=='n00I' or id=='n022' or id=='n021' or id=='n0KY' or id=='n0KZ' or id=='n0LE' or id=='n023' or id=='n024' or id=='n025' or id=='n0L0' or id=='n0L1' or id=='n0M4' or id=='n00M' or id=='n0HV' or id=='n0LS' or id=='n12C'
endfunction
//飞行信使
function KV7 takes unit I_7 returns boolean
local integer id=GetUnitTypeId(I_7)
return id=='e01H' or id=='e01Z' or id=='e02R' or id=='e02T' or id=='e02S' or id=='e030' or id=='e03A' or id=='e03B' or id=='e03C' or id=='e03D'
endfunction
//判断信使
function KW7 takes unit I_7 returns boolean
return KU7(I_7)or KV7(I_7)
endfunction
// Random OMG couriers receive these two point-target abilities at runtime.
// Keep them off normal-mode couriers and use dedicated rawcodes so ward item
// abilities keep their original order ids and inventory behaviour.
function SuijiMode_AddCourierWardSkills takes unit u returns nothing
local player p=null
if u==null or GetUnitTypeId(u)==0 or KW7(u)==false then
set u=null
return
endif
set p=GetOwningPlayer(u)
// B494: couriers are created before -omg sets SUIJI_MODE, so YE8 has
// already disabled both dedicated rawcodes for this player.  Re-enable
// them when random OMG starts and repair transformed/legacy couriers that
// do not physically own the object-data abilities.
call SetPlayerAbilityAvailable(p,'Y0H9',true)
call SetPlayerAbilityAvailable(p,'Y0HA',true)
if GetUnitAbilityLevel(u,'Y0H9')==0 then
call UnitAddAbility(u,'Y0H9')
endif
if GetUnitAbilityLevel(u,'Y0HA')==0 then
call UnitAddAbility(u,'Y0HA')
endif
call UnitMakeAbilityPermanent(u,true,'Y0H9')
call UnitMakeAbilityPermanent(u,true,'Y0HA')
set p=null
set u=null
endfunction
function SuijiMode_AddAllCourierWardSkills takes nothing returns nothing
local integer i=0
local unit courier=null
loop
exitwhen i>11
set courier=LoadUnitHandle(TABLE_K,GetHandleId(Player(i)),'COUR')
call SuijiMode_AddCourierWardSkills(courier)
set i=i+1
endloop
set courier=null
endfunction
