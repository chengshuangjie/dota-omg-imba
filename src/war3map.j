//齐天大圣技能
function JinguMastery_damage takes unit W4I,unit W5I,integer V6I returns nothing
if GetUnitAbilityLevel(W4I,'A4CU')==0 then
return
endif
if V6I==1 then
call XF7(W5I,'A4CV')
elseif V6I==2 then
call XF7(W5I,'A4CW')
elseif V6I==3 then
call XF7(W5I,'A4CX')
elseif V6I==4 then
call XF7(W5I,'A4CY')
endif
endfunction
function GetJinguMasteryBar takes unit u,boolean b returns string
local integer W9I=LoadInteger(TABLE_XJ,(GetHandleId(u)),('A4CQ'))
local string c1=Q[GetPlayerId(GetOwningPlayer(u))]
local string c2=" + "
local string s="|r"
local string jinguMasteryBarText=""
    if GetOwningPlayer(u)==B7 then
    set c1="|c00ff0303"
    endif
    if b==false then
    set W9I=LoadInteger(TABLE_XJ,(GetHandleId(u)),('A4CS'))
    set c1="|c00ff0303"
    endif
    if W9I==4 then
    set jinguMasteryBarText=c1+c2+c2+c2+c2+s
    elseif W9I==3 then
    set jinguMasteryBarText=c1+c2+c2+c2+s+c2
    elseif W9I==2 then
    set jinguMasteryBarText=c1+c2+c2+s+c2+c2
    elseif W9I==1 then
    set jinguMasteryBarText=c1+c2+s+c2+c2+c2
    endif
    return jinguMasteryBarText
endfunction
function JinguMastery_OnCount takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
    local trigger t=GetTriggeringTrigger()
    local integer HEI=GetHandleId(t)
    local unit W4I=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
    local unit W5I=(LoadUnitHandle(TABLE_XJ,(HEI),(17)))
    local real XDI=(TimerGetElapsed(W))
    local real U3O=(LoadReal(TABLE_XJ,(HEI),(34)))
    local texttag tt=(LoadTextTagHandle(TABLE_XJ,(HEI),(231)))
    if b1060GetTriggerEventId==EVENT_UNIT_DEATH then
    call DestroyTextTag(tt)
    call UnitRemoveAbility(W5I,'A4CS')
    call SaveInteger(TABLE_XJ,(GetHandleId(W5I)),('A4CS'),(0))
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    elseif b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
    if b1060GetEventDamageSource==W4I and b1060GetEventDamage>0 then
    call SaveReal(TABLE_XJ,(HEI),(34),(((TimerGetElapsed(W)))*1.0))
    endif
    else
    if XDI-U3O>10 or LoadInteger(TABLE_XJ,(GetHandleId(W5I)),('A4CS'))>=4 then
    call DestroyTextTag(tt)
    call UnitRemoveAbility(W5I,'A4CS')
    call SaveInteger(TABLE_XJ,(GetHandleId(W5I)),('A4CS'),(0))
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    else
    call SetTextTagText(tt,GetJinguMasteryBar(W5I,false),0.035)
    call SetTextTagPosUnit(tt,W5I,0)
    call SetTextTagVisibility(tt,GetOwningPlayer(W4I)==GetLocalPlayer()and IsUnitVisible(W5I,GetLocalPlayer()))
    endif
    endif
    set t=null
    set tt=null
    set W4I=null
    set W5I=null
    set b1060ReturnValue=false
    set b1060GetEventDamageSource=null
    set b1060GetTriggerEventId=null
    return b1060ReturnValue
endfunction
function JinguMastery_count takes unit W4I,unit W5I returns nothing
    local trigger t
    local integer HEI
    local texttag tt
    if GetUnitAbilityLevel(W5I,'A4CS')==0 and XH7(W5I)==false then
    call XF7(W5I,'A4CS')
    set t=CreateTrigger()
    set HEI=GetHandleId(t)
    set tt=CreateTextTag()
    call SetTextTagText(tt,GetJinguMasteryBar(W5I,false),0.035)
    call SetTextTagPosUnit(tt,W5I,0)
    call SetTextTagVisibility(tt,GetOwningPlayer(W4I)==GetLocalPlayer()and IsUnitVisible(W5I,GetLocalPlayer()))
    call SetTextTagPermanent(tt,true)
    call TriggerRegisterTimerEvent(t,0.05,true)
    call TriggerRegisterUnitEvent(t,W5I,EVENT_UNIT_DEATH)
    call B1023RegisterDamage(t,W5I)
    call TriggerAddCondition(t,Condition(function JinguMastery_OnCount))
    call SaveUnitHandle(TABLE_XJ,(HEI),(2),(W4I))
    call SaveUnitHandle(TABLE_XJ,(HEI),(17),(W5I))
    call SaveReal(TABLE_XJ,(HEI),(34),(((TimerGetElapsed(W)))*1.0))
    call SaveTextTagHandle(TABLE_XJ,(HEI),(231),(tt))
    endif
    set t=null
    set tt=null
endfunction
function JinguMastery_OnCoolDown takes nothing returns boolean
    local trigger t=GetTriggeringTrigger()
    local integer HEI=GetHandleId(t)
    local unit HKI=(LoadUnitHandle(TABLE_XJ,(HEI),(2)))
    local texttag tt=(LoadTextTagHandle(TABLE_XJ,(HEI),(231)))
    if(D4 and XH7(HKI)) or HKI==null then
    call FlushChildHashtable(TABLE_XJ,(HEI))
    call OZ7(t)
    endif
    if XH7(HKI)==false then
    call SetTextTagText(tt,GetJinguMasteryBar(HKI,true),0.035)
    call SetTextTagPosUnit(tt,HKI,0)
    call SetTextTagVisibility(tt,GetOwningPlayer(HKI)==GetLocalPlayer())
    else
    call SetTextTagVisibility(tt,false)
    endif
    set t=null
    set HKI=null
    set tt=null
    return false
endfunction
function JinguMastery_CoolDown takes unit HKI returns nothing
    local trigger t=CreateTrigger()
    local integer HEI=GetHandleId(t)
    local texttag tt=CreateTextTag()
    call SetTextTagText(tt,GetJinguMasteryBar(HKI,true),0.035)
    call SetTextTagPosUnit(tt,HKI,0)
    call SetTextTagVisibility(tt,GetOwningPlayer(HKI)==GetLocalPlayer())
    call SetTextTagPermanent(tt,true)
    call SaveTextTagHandle(TABLE_XJ,(HEI),(231),(tt))
    call SaveUnitHandle(TABLE_XJ,(HEI),(2),(HKI))
    call TriggerRegisterTimerEvent(t,0.05,true)
    call TriggerAddCondition(t,Condition(function JinguMastery_OnCoolDown))
    set t=null
    set tt=null
endfunction
function JinguMastery_Learn takes nothing returns nothing
    if(B287_GetLearnedSkill()=='A4CQ')and(GetUnitAbilityLevel(GetTriggerUnit(),'A4CQ')==1 and IsUnitIllusion(GetTriggerUnit())==false)then
    call JinguMastery_CoolDown(GetTriggerUnit())
    endif
endfunction
function JinguMastery_reduce takes unit W4I,unit W5I,real d,boolean b returns boolean
    local integer V6I=GetUnitAbilityLevel(W4I,'A4CQ')
    local integer W9I=LoadInteger(TABLE_XJ,(GetHandleId(W4I)),('A4CQ'))
    if GetUnitAbilityLevel(W4I,'A4CU')==0 then
    return false
    endif
    if W9I>0 and d>0 then
    call SetWidgetLife(W4I,GetWidgetLife(W4I)+d*(0.2+0.1*V6I))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",W4I,"origin"))
    call DestroyEffect(AddSpecialEffectTarget("tx\\qtds\\HeroMonkeyking_E_Impact.MDX",W5I,"chest"))
    endif
    if b then
    set W9I=YH7(W9I-1,0)
    call SaveInteger(TABLE_XJ,(GetHandleId(W4I)),('A4CQ'),(W9I))
    endif
    if W9I==0 then
    call UnitRemoveAbility(W4I,'A4CU')
    call UnitRemoveAbility(W4I,'B0J1')
    call UnitRemoveAbility(W4I,'A4CV')
    call UnitRemoveAbility(W4I,'A4CW')
    call UnitRemoveAbility(W4I,'A4CX')
    call UnitRemoveAbility(W4I,'A4CY')
    endif
    return false
endfunction
function JinguMastery_add takes unit W4I,unit W5I returns boolean
    local integer V6I=0
    local integer WQI=0
    if W4I==null or W5I==null or GetUnitTypeId(W4I)==0 or GetUnitTypeId(W5I)==0 then
    return false
    endif
    set V6I=GetUnitAbilityLevel(W4I,'A4CQ')
    set WQI=LoadInteger(TABLE_XJ,(GetHandleId(W5I)),('A4CS'))
    if V6I==0 then
    return false
    endif
    set WQI=YG7(WQI+1,4)
    call SaveInteger(TABLE_XJ,(GetHandleId(W5I)),('A4CS'),(WQI))
    call JinguMastery_count(W4I,W5I)
    if WQI==4 then
    call SaveInteger(TABLE_XJ,(GetHandleId(W4I)),('A4CQ'),(WQI))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl",W4I,"overhead"))
    call XF7(W4I,'A4CU')
    call UnitMakeAbilityPermanent(W4I,true,'A4CT')
    call SetPlayerAbilityAvailable(GetOwningPlayer(W4I),'A4CU',false)
    call JinguMastery_damage(W4I,W4I,V6I)
    endif
    return false
endfunction
function JinguMastery_Attack takes nothing returns boolean
//攻击任意单位
    if WXX==null or YXX==null or GetUnitTypeId(WXX)==0 or GetUnitTypeId(YXX)==0 then
        return false
    endif
    if GetUnitTypeId(WXX)!='Z052' or IsUnitIllusion(WXX) or ISPH(WXX) then
        return false
    endif
    if GetUnitAbilityLevel(WXX,'A4CU')>0 then
        call JinguMastery_reduce(WXX,YXX,ZXX,true)
    elseif GetUnitAbilityLevel(WXX,'A4CQ')>0 then
        if IsUnitType(YXX,UNIT_TYPE_HERO)then
            call JinguMastery_add(WXX,YXX)
        endif
    endif
return false
endfunction
