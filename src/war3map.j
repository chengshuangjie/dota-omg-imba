set B960H8Time[pid960]=TimerGetElapsed(W)
endif
if h8[pid960]!=target960 then
if B946DetectCount>0 then
set B960H8Change[pid960]=source960
endif
if B946DetectCount>0 then
if B946DetectCount>0 then
call B960RouteText(M7[pid960],"h8改写 "+B960Node(h8[pid960])+" -> "+B960Node(target960)+"\n    写入者："+source960)
endif
endif
endif
endif
return target960
endfunction
function B960RouteEntry takes unit u960,integer node960 returns nothing
local integer pid960=GetPlayerId(GetOwningPlayer(u960))
if B946DetectCount==0 then
return
endif
if pid960>=0 and pid960<12 and u960==M7[pid960] then
if B946DetectCount>0 then
set B960Entry[pid960]=node960
endif
if B946DetectCount>0 then
set B960EntryTime[pid960]=TimerGetElapsed(W)
endif
if B946DetectCount>0 then
if B946DetectCount>0 then
call B960RouteText(u960,"进入节点="+I2S(node960)+" 模式="+I2S(eY[pid960])+" 子状态="+I2S(eY[272+pid960])+" h8="+B960Node(h8[pid960]))
endif
endif
endif
endfunction
function B963NormalAdvance takes unit u963 returns boolean
local integer p963=GetPlayerId(GetOwningPlayer(u963))
return p963>=0 and p963<12 and u963==M7[p963] and eY[p963]==1 and G0[128+p963] and not G0[32+p963] and not GZ[160+p963] and not GE7[256+p963]
endfunction
function B963Lane takes integer node963 returns integer
if (node963>=11 and node963<=17) or (node963>=111 and node963<=117) then
return 0
elseif (node963>=31 and node963<=39) or (node963>=131 and node963<=139) then
return 1
elseif (node963>=51 and node963<=59) or (node963>=151 and node963<=159) then
return 2
endif
return -1
endfunction
function B963ForwardEntry takes unit u963,integer entered963 returns boolean
local integer target963=GetUnitUserData(h8[GetPlayerId(GetOwningPlayer(u963))])
if not B963NormalAdvance(u963) then
return false
endif
if not IsUnitAlly(u963,Z7[0]) then
set target963=hj[512+target963]
endif
return B963Lane(entered963)>=0 and B963Lane(entered963)==B963Lane(target963) and entered963>=target963 and ((entered963<100)==(target963<100))
endfunction
function B963FloorRoute takes unit u963,integer proposed963,integer first963,integer last963 returns integer
local integer i963=first963
local integer nearest963=proposed963
local real best963=400.
local real dx963=0.
local real dy963=0.
local real distance963=0.
if not B963NormalAdvance(u963) then
return proposed963
endif
loop
exitwhen i963>last963
set dx963=GetUnitX(u963)-GetUnitX(h7[i963])
set dy963=GetUnitY(u963)-GetUnitY(h7[i963])
set distance963=SquareRoot(dx963*dx963+dy963*dy963)
if distance963<=best963 then
set best963=distance963
set nearest963=i963
endif
set i963=i963+1
endloop
if nearest963>proposed963 then
if B946DetectCount>0 then
call B960RouteText(u963,"修复路线回退：兵线建议="+I2S(proposed963)+" 已到达="+I2S(nearest963)+" 保留前进进度")
endif
return nearest963
endif
return proposed963
endfunction

function B960RouteDecision takes unit u960,integer node960,boolean advance960 returns nothing
local integer pid960=GetPlayerId(GetOwningPlayer(u960))
local string result960="不推进"
if B946DetectCount==0 or pid960<0 or pid960>=12 or u960!=M7[pid960] then
return
endif
if advance960 then
set result960="推进"
elseif GE7[256+pid960] then
set result960="不推进：特殊路线锁定"
else
set result960="不推进：节点和路段不匹配"
endif
if B946DetectCount>0 then
call B960RouteText(u960,"节点="+I2S(node960)+" "+result960+"\n    进攻="+B960Node(h8[pid960])+" 后撤="+B960Node(h9[pid960])+"\n    路段="+I2S(GetUnitUserData(h9[16+pid960]))+"/"+I2S(GetUnitUserData(h8[16+pid960]))+" 节点路段="+I2S(hj[node960])+"/"+I2S(hj[256+node960]))
endif
if B946DetectCount>0 then
call B960RouteText(u960,"匹配h8="+B962Bool(h8[pid960]==h7[node960])+" h9="+B962Bool(h9[pid960]==h7[node960])+" 同路段="+B962Bool(h8[16+pid960]==h7[hj[256+node960]] and h9[16+pid960]==h7[hj[node960]])+" 反端1="+B962Bool(h8[16+pid960]==h7[hj[node960]])+" 反端2="+B962Bool(h9[16+pid960]==h7[hj[256+node960]])+" 锁定="+B962Bool(GE7[256+pid960])+"\n    节点索引="+I2S(node960)+" 对应单位编号="+I2S(GetUnitUserData(h7[node960]))+" 达拉然侧="+B962Bool(IsUnitAlly(u960,Z7[0]))+"\n    h8上次设置链："+B960H8Source[pid960])
endif
endfunction
function B960Fallback takes unit u960 returns nothing
local integer pid960=GetPlayerId(GetOwningPlayer(u960))
local real dx960=0.
local real dy960=0.
if B946DetectCount==0 or pid960<0 or pid960>=12 or u960!=M7[pid960] then
return
endif
if TimerGetElapsed(W)<B960Next[pid960] then
return
endif
if B946DetectCount>0 then
set B960Next[pid960]=TimerGetElapsed(W)+2.
endif
set dx960=GetUnitX(u960)-GetUnitX(h8[pid960])
set dy960=GetUnitY(u960)-GetUnitY(h8[pid960])
if B946DetectCount>0 then
call B960RouteText(u960,"J3兜底 模式="+I2S(eY[pid960])+" 子状态="+I2S(eY[272+pid960])+" 节点="+B960Node(h8[pid960])+"\n    距离="+R2S(SquareRoot(dx960*dx960+dy960*dy960))+" 偏移="+R2S(hq[864+pid960])+"\n    最近写入："+B960H8Source[pid960]+" 时间="+R2S(B960H8Time[pid960])+"\n    最近变更："+B960H8Change[pid960]+"\n    最近进入节点="+I2S(B960Entry[pid960])+" 时间="+R2S(B960EntryTime[pid960]))
endif
endfunction

