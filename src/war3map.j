return HB7=='H0B8' or HB7=='n0FJ' or HB7=='n0FI' or HB7=='n0F6' or HB7=='n0FH' or HB7=='u00S' or HB7=='n1FJ' or HB7=='n1FI' or HB7=='n1F6' or HB7=='n1FH' or HB7=='Z053'
endfunction
