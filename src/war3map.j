call SaveReal(L7,(h),($688DFB59),((GetUnitX(u))*1.))
call SaveReal(L7,(h),(-$5F89FBF),((GetUnitY(u))*1.))
set t=null
set tt=null
endfunction
function LKZD_Z07 takes nothing returns boolean
