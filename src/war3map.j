function JULANG takes nothing returns nothing
	local unit u = GetTriggerUnit()
	local integer level = B287_GetUnitAbilityLevel(u, 'A4FG')
	local real x = GetUnitX(u)
	local real y = GetUnitY(u)
	local real length
    local integer ZZMF_level=GetUnitAbilityLevel(u,'A4DJ')+GetUnitAbilityLevel(u,'A4DZ')
    local integer ZZMF=0
    if level<=0 then
        set level=B287_GetUnitAbilityLevel(u,'A046')
    endif
    if ZZMF_level>0 then
        set ZZMF=50*ZZMF_level
    endif
    if GetUnitAbilityLevel(u,'A2YK')>0 then
    set length=1460+ZZMF
    elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
    set length=1410+ZZMF
    else
    set length=1260+ZZMF
    endif
	call Wave(u,'h0H2', 25 + 75 * level, length, 240, 240, x, y, GetSpellTargetX(), GetSpellTargetY(), 1500, 1, false, "GushUpgraded_Actions", level)
	set u = null
endfunction
