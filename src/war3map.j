//library AMHUnit ends
function B287_GetPhysicalAbilityId takes unit u,integer logicalSkill returns integer
local integer cloneSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,0,logicalSkill)
local integer alternateSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)
// Tianxing Twins use private physical carriers so Player(7)'s normal hero can
// never hide or replace a boss button through player-wide command-card state.
// Keep this mapping explicit and unit-scoped; it must not alter native Invoker,
// Medusa, Io or OMG ownership.
if u!=null and GetUnitTypeId(u)=='NTY1' then
if logicalSkill=='A0VS' then
return 'BT01'
elseif logicalSkill=='A0VK' then
return 'BT02'
elseif logicalSkill=='A0VQ' then
return 'BT03'
elseif logicalSkill=='A0XL' then
return 'BT04'
elseif logicalSkill=='A0VM' then
return 'BT05'
elseif logicalSkill=='A0VN' then
return 'BT06'
elseif logicalSkill=='A0VO' then
return 'BT07'
elseif logicalSkill=='A0VP' then
return 'BT08'
elseif logicalSkill=='A0VG' then
return 'BT09'
elseif logicalSkill=='A0VZ' then
return 'BT10'
elseif logicalSkill=='A0MP' then
return 'ATBM'
elseif logicalSkill=='A9BM' then
return 'TRMC'
elseif logicalSkill=='A0IF' then
return 'TRAR'
endif
elseif u!=null and GetUnitTypeId(u)=='NTY2' then
if logicalSkill=='A1TA' then
return 'ATBT'
elseif logicalSkill=='A28Q' then
return 'ATBO'
elseif logicalSkill=='A08N' then
return 'TBPU'
elseif logicalSkill=='A08V' then
return 'TBRE'
elseif logicalSkill=='A06A' then
return 'TBDA'
elseif logicalSkill=='A0ER' then
return 'TBGA'
elseif logicalSkill=='A10L' then
return 'TBSG'
endif
endif
// Random Channel-derived skills may own a private alternate-order carrier.
// Resolve only the explicitly registered per-skill carrier; native heroes and
// the generated default clone remain unchanged.
if alternateSkill!=0 and u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,alternateSkill)>0 then
return alternateSkill
endif
// Unified random orbs must never fall back to their native autocast objects.
// Keep these physical mappings independent from the large generated clone table
// so test presets, AI presets and late restore paths all resolve the passive icon.
if logicalSkill=='A026' then
set cloneSkill='Y0GP'
elseif logicalSkill=='A2ZJ' then
set cloneSkill='Y0GQ'
elseif logicalSkill=='A09V' then
set cloneSkill='Y0GR'
elseif logicalSkill=='A4HO' then
set cloneSkill='Y0GW'
elseif logicalSkill=='AHfa' then
set cloneSkill='Y0GS'
elseif logicalSkill=='A0LZ' then
set cloneSkill='Y0GT'
elseif logicalSkill=='A0OI' or logicalSkill=='X0OI' then
set cloneSkill='Y0GU'
elseif logicalSkill=='A0QN' then
set cloneSkill='Y0GV'
elseif logicalSkill=='A0DY' then
set cloneSkill='Y0GI'
elseif logicalSkill=='A1WB' then
set cloneSkill='Y0GN'
endif
if cloneSkill!=0 and u!=null and GetUnitTypeId(u)!=0 and GetUnitAbilityLevel(u,cloneSkill)>0 then
return cloneSkill
endif
return logicalSkill
endfunction
function B287_UsesAlternateCarrier takes unit u,integer logicalSkill returns boolean
local integer alternateSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,2,logicalSkill)
return alternateSkill!=0 and B287_GetPhysicalAbilityId(u,logicalSkill)==alternateSkill
endfunction
// Native hero ability lists and OMG grants use passive physical orb objects,
// while registration, triggers and pool data keep the original logical ids.
// Learning paths must therefore resolve the physical object even at level 0.
function B287_GetLearnableAbilityId takes integer logicalSkill returns integer
if logicalSkill=='A026' then
return 'Y0GP'
elseif logicalSkill=='A2ZJ' then
return 'Y0GQ'
elseif logicalSkill=='A09V' then
return 'Y0GR'
elseif logicalSkill=='A4HO' then
return 'Y0GW'
elseif logicalSkill=='AHfa' then
return 'Y0GS'
elseif logicalSkill=='A0LZ' then
return 'Y0GT'
elseif logicalSkill=='A0OI' or logicalSkill=='X0OI' then
return 'Y0GU'
elseif logicalSkill=='A0QN' then
return 'Y0GV'
elseif logicalSkill=='A0DY' then
return 'Y0GI'
elseif logicalSkill=='A1WB' then
return 'Y0GN'
endif
return logicalSkill
endfunction
function B287_SelectHeroSkill takes unit u,integer logicalSkill returns nothing
call SelectHeroSkill(u,B287_GetLearnableAbilityId(logicalSkill))
endfunction
