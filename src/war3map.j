call DestroyBoolExpr(suijiStoneGazeEnemyFilter)
call ForGroup(g,function B7D)
call WR7(g)
call DestroyEffect(OG7(I97,"FX"))
if GetTriggerEvalCount(t)>100 then
if BB7!=null then
call RemoveUnit(BB7)
endif
call OZ7(t)
call NM7(I97)
call WR7(BQ9)
else
call NU7(I97,"FX",AddSpecialEffectTarget("Abilities\\Spells\\Orc\\EtherealForm\\SpiritWalkerChange.mdl",ZX7,"chest"))
endif
set ZX7=null
set BB7=null
set g=null
set t=null
set BQ9=null
set suijiStoneGazeEnemyFilter=null
return false
endfunction
