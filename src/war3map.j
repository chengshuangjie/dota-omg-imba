if skill=='A15J' or skill=='X15J' or skill=='A1RI' or skill=='A1TX' or skill=='A1WH' or skill=='X1WH' then
return true
endif
if skill=='A0AG' or skill=='A0BE' or skill=='A1C0' or skill=='A0MV' then
