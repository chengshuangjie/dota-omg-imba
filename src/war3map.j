function QSD takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if GetUnitAbilityLevel((b1060GetEnumUnit),'B0KN')>0 then
if((IsUnitType((b1060GetEnumUnit),UNIT_TYPE_HERO))and(GetPlayerController(GetOwningPlayer((b1060GetEnumUnit)))==MAP_CONTROL_COMPUTER))then
// call IssueTargetOrderById(GetEnumUnit(),$D0003,DG7)
call DisableTrigger(Q04[GetPlayerId(GetOwningPlayer(DG7))])
call B947IssueTargetOrderById("QSD @ war3map.j:91540 (B968)",(b1060GetEnumUnit),$D000F,DG7)
call EnableTrigger(Q04[GetPlayerId(GetOwningPlayer(DG7))])
else
call B947IssueTargetOrderById("QSD @ war3map.j:91543 (B968)",(b1060GetEnumUnit),$D000F,DG7)
endif
endif
set b1060GetEnumUnit=null
endfunction
function xE takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local group g=LoadGroupHandle(L7,(I97),($DC))
local unit WX7=LoadUnitHandle(L7,(I97),($E))
// local integer QRD=LoadInteger(L7,(I97),(365))
local integer BC7=(LoadInteger(L7,(I97),(5)))
local integer WF8=(LoadInteger(L7,(I97),(34)))
if WX7==null or GetUnitTypeId(WX7)==0 or UnitAlive(WX7)==false or g==null then
    if g!=null then
        call WR7(g)
    endif
    call FlushChildHashtable(L7,(I97))
    call OZ7(t)
set t=null
set g=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER and b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER and b1060GetTriggerEventId!=EVENT_PLAYER_UNIT_ISSUED_ORDER then
    set WF8=WF8+1
    call SaveInteger(L7,(I97),(34),(WF8))
    if WF8==(8+2*BC7)then
call UnitRemoveAbility(WX7,'A0I5')
        call WR7(g)
        // call xd(I97,QRD)
        call FlushChildHashtable(L7,(I97))
        call OZ7(t)
    else
        call DisableTrigger(t)
        set DG7=WX7
        call ForGroup(g,function QSD)
        call EnableTrigger(t)
    endif
else
if IsUnitInGroup(b1060GetTriggerUnit,g) and UnitIsSleeping(b1060GetTriggerUnit)==false and GetUnitAbilityLevel(b1060GetTriggerUnit,'B008')==0 and b1060GetIssuedOrderId!=851973 and DE7==false and GetUnitAbilityLevel(b1060GetTriggerUnit,'B0KN')>0 then
call DisableTrigger(t)
    if b1060GetIssuedOrderId >= 852008 and b1060GetIssuedOrderId <= 852013 and Is_Use_TD(b1060GetTriggerUnit,b1060GetIssuedOrderId)then
        call KR7(b1060GetTriggerUnit)
    endif
if((IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_HERO))and(GetPlayerController(GetOwningPlayer(b1060GetTriggerUnit))==MAP_CONTROL_COMPUTER))then
call DisableTrigger(Q04[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))])
// call IssueTargetOrderById(GetTriggerUnit(),$D0003,WX7)
call B947IssueTargetOrderById("xE @ war3map.j:91590 (B968)",b1060GetTriggerUnit,$D000F,WX7)
call EnableTrigger(Q04[GetPlayerId(GetOwningPlayer(b1060GetTriggerUnit))])
else
call B947IssueTargetOrderById("xE @ war3map.j:91593 (B968)",b1060GetTriggerUnit,$D000F,WX7)
endif
call EnableTrigger(t)
endif
endif
set t=null
set g=null
set WX7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
