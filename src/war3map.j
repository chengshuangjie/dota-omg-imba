// if FirstOfGroup(g)!=null then
// call STG(ZX7,SAG)
// endif
// call GroupClear(g)
set UO4=SAG
set U64=5
set UM4=ZX7
call GroupEnumUnitsInRange(g,x,y,$AF,Condition(function A67))
call ForGroup(g,function SHG)
call GroupClear(g)
endif
call WR7(g)
endif
set t=null
set ZX7=null
set SWG=null
set SXG=null
set SYG=null
set SZG=null
set SAG=null
set g=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function SLG takes nothing returns nothing
local unit ZX7=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer I97=GetHandleId(t)
local unit SWG
local unit SXG
local unit SYG
local unit SZG
local unit S1G
local real x
local real y
local integer BC7=B287_GetUnitAbilityLevel(ZX7,'A1T8')
local integer HaveA=1
local integer id=GetUnitTypeId(ZX7)
if SuijiMode_ScepterRegistryIsActive(ZX7,'A1T8') then
set HaveA=2
endif
set x=GetUnitX(ZX7)+$FA*Cos(bj_DEGTORAD*360*5/5.*-1.)
set y=GetUnitY(ZX7)+$FA*Sin(bj_DEGTORAD*360*5/5.*-1.)
set SWG=CreateUnit(GetOwningPlayer(ZX7),'h0CJ',x,y,360*5/5.*-1.)
call XF7(SWG,'Aloc')
set x=GetUnitX(ZX7)+$FA*Cos(bj_DEGTORAD*360*4/5.*-1.)
set y=GetUnitY(ZX7)+$FA*Sin(bj_DEGTORAD*360*4/5.*-1.)
set SXG=CreateUnit(GetOwningPlayer(ZX7),'h0CJ',x,y,360*4/5.*-1.)
call ShowUnit(SXG,false)
call SetUnitInvulnerable(SXG,true)
set x=GetUnitX(ZX7)+$FA*Cos(bj_DEGTORAD*360*3/5.*-1.)
set y=GetUnitY(ZX7)+$FA*Sin(bj_DEGTORAD*360*3/5.*-1.)
set SYG=CreateUnit(GetOwningPlayer(ZX7),'h0CJ',x,y,360*3/5.*-1.)
call ShowUnit(SYG,false)
call SetUnitInvulnerable(SXG,true)
set x=GetUnitX(ZX7)+$FA*Cos(bj_DEGTORAD*360*2/5.*-1.)
set y=GetUnitY(ZX7)+$FA*Sin(bj_DEGTORAD*360*2/5.*-1.)
set SZG=CreateUnit(GetOwningPlayer(ZX7),'h0CJ',x,y,360*2/5.*-1.)
call ShowUnit(SZG,false)
call SetUnitInvulnerable(SZG,true)
set x=GetUnitX(ZX7)+$FA*Cos(bj_DEGTORAD*360*1/5.*-1.)
set y=GetUnitY(ZX7)+$FA*Sin(bj_DEGTORAD*360*1/5.*-1.)
set S1G=CreateUnit(GetOwningPlayer(ZX7),'h0CJ',x,y,360*1/5.*-1.)
call ShowUnit(S1G,false)
call SetUnitInvulnerable(S1G,true)
if id=='Z01F' then
call MHUnit_SetModel(SWG,"model\\Hero_GuardianWisp_N2S_W_Ball.mdl",false)
call MHUnit_SetModel(SXG,"model\\Hero_GuardianWisp_N2S_W_Ball.mdl",false)
call MHUnit_SetModel(SYG,"model\\Hero_GuardianWisp_N2S_W_Ball.mdl",false)
call MHUnit_SetModel(SZG,"model\\Hero_GuardianWisp_N2S_W_Ball.mdl",false)
call MHUnit_SetModel(S1G,"model\\Hero_GuardianWisp_N2S_W_Ball.mdl",false)
endif
call SaveUnitHandle(L7,(I97),(2),(ZX7))
call SaveUnitHandle(L7,(I97),(393),(SWG))
call SaveUnitHandle(L7,(I97),(394),(SXG))
call SaveUnitHandle(L7,(I97),(395),(SYG))
call SaveUnitHandle(L7,(I97),(396),(SZG))
call SaveUnitHandle(L7,(I97),(397),(S1G))
call SaveInteger(L7,(I97),(10),(BC7))
call SaveInteger(L7,(I97),(20),(HaveA))
call SaveBoolean(L7,(I97),(511),(true))
call SaveBoolean(L7,(I97),(512),(false))
call SaveBoolean(L7,(I97),(513),(false))
call SaveBoolean(L7,(I97),(514),(false))
call SaveBoolean(L7,(I97),(515),(false))
call SaveBoolean(L7,(I97),(655),(false))
call SaveBoolean(L7,(I97),(656),(false))
call SaveReal(L7,(I97),(138),(($96)*1.))
call XF7(ZX7,'A1U2')
call XF7(ZX7,'A1U3')
if GetPlayerController(GetOwningPlayer(ZX7))!=MAP_CONTROL_COMPUTER then
call XF7(ZX7,'A4G0')
endif
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function SVG))
set ZX7=null
set t=null
set SWG=null
set SXG=null
set SYG=null
set SZG=null
set S1G=null
endfunction
function S0G takes nothing returns boolean
if B287_GetSpellAbilityId()=='A1T8' then
call SLG()
endif
return false
endfunction
function OI8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function S0G))
set t=null
endfunction
function S5G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer BC7=(LoadInteger(L7,(I97),(5)))
call YN7(ZX7,GetEventDamage()*.05*BC7)
set t=null
set ZX7=null
return false
endfunction
function S2G takes unit u returns nothing
local trigger t=null
local trigger overchargeDeath=null
local integer overchargeUnitKey=GetHandleId(u)
// Detach both owners before removing helpers; any nested cleanup is a no-op.
set overchargeDeath=LoadTriggerHandle(L7,overchargeUnitKey,StringHash("B933OverchargeDeath"))
set t=LoadTriggerHandle(L7,overchargeUnitKey,709)
if overchargeDeath==null and t==null and not LoadBoolean(L7,overchargeUnitKey,708) then
return
endif
call RemoveSavedHandle(L7,overchargeUnitKey,StringHash("B933OverchargeDeath"))
if overchargeDeath!=null then
call DisableTrigger(overchargeDeath)
call FlushChildHashtable(L7,GetHandleId(overchargeDeath))
call OZ7(overchargeDeath)
endif
call RemoveSavedHandle(L7,overchargeUnitKey,709)
call SaveBoolean(L7,overchargeUnitKey,708,false)
if t!=null then
call DisableTrigger(t)
call FlushChildHashtable(L7,GetHandleId(t))
call OZ7(t)
endif
set t=null
set overchargeDeath=null
if u==null or GetUnitTypeId(u)==0 then
return
endif
call UnitRemoveAbility(u,'A1TS')
call UnitRemoveAbility(u,'A1TR')
call UnitRemoveAbility(u,'A1TT')
call UnitRemoveAbility(u,'A1TP')
call UnitRemoveAbility(u,'A4G2')
call UnitRemoveAbility(u,'A1TQ')
endfunction
function S_G takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
call S2G(ZX7)
// Also retire this callback if another unit cleanup already cleared its owner.
call FlushChildHashtable(L7,I97)
call OZ7(t)
set ZX7=null
set t=null
return false
endfunction
function T4G takes unit u,integer i,integer id returns nothing
local trigger t=null
local integer I97=0
local integer overchargeUnitKey=0
local integer skilltx
if u==null or GetUnitTypeId(u)==0 or not UnitAlive(u) or i<1 or i>4 then
return
endif
set overchargeUnitKey=GetHandleId(u)
if id=='Z01F' then
    set skilltx='A4G2'
else
    set skilltx='A1TQ'
endif
set t=LoadTriggerHandle(L7,overchargeUnitKey,StringHash("B933OverchargeDeath"))
if t==null then
set t=CreateTrigger()
set I97=GetHandleId(t)
call SaveTriggerHandle(L7,overchargeUnitKey,StringHash("B933OverchargeDeath"),t)
call SaveUnitHandle(L7,I97,2,u)
call TriggerRegisterUnitEvent(t,u,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function S_G))
endif
if i==1 then
if GetUnitAbilityLevel(u,'A1TS')==0 then
call XF7(u,'A1TS')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1TS',false)
endif
elseif i==2 then
if GetUnitAbilityLevel(u,'A1TR')==0 then
call XF7(u,'A1TR')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1TR',false)
endif
elseif i==3 then
if GetUnitAbilityLevel(u,'A1TT')==0 then
call XF7(u,'A1TT')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1TT',false)
endif
elseif i==4 then
if GetUnitAbilityLevel(u,'A1TP')==0 then
call XF7(u,'A1TP')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1TP',false)
endif
endif
if GetUnitAbilityLevel(u,skilltx)==0 then
call XF7(u,skilltx)
endif
if(LoadBoolean(L7,(GetHandleId(u)),(708)))==false then
call SaveBoolean(L7,(GetHandleId(u)),(708),(true))
set t=CreateTrigger()
set I97=GetHandleId(t)
call B1023RegisterDamage(t,u)
call TriggerAddCondition(t,Condition(function S5G))
call SaveTriggerHandle(L7,(GetHandleId(u)),(709),(t))
call SaveUnitHandle(L7,(GetHandleId(t)),(2),(u))
call SaveInteger(L7,(GetHandleId(t)),(5),(i))
else
// A level refresh updates the existing listener instead of adding another one.
call SaveInteger(L7,GetHandleId(LoadTriggerHandle(L7,overchargeUnitKey,709)),5,i)
endif
set t=null
endfunction
function T7G takes nothing returns boolean
local integer b1060GetIssuedOrderId=GetIssuedOrderId()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local integer QSG=(LoadInteger(L7,(I97),(34)))
local integer BC7=0
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local unit T8G=null
local boolean T9G=false
local real TDG=0.
local real TEG=0.
local integer id=(LoadInteger(L7,(I97),(10)))
if ZX7==null or GetUnitTypeId(ZX7)==0 then
call DisableTrigger(t)
call S2G(ZX7)
if IH7!=null then
call S2G(IH7)
endif
call RemoveSavedBoolean(L7,GetHandleId(ZX7),StringHash("SuijiIoOverchargeInit"))
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
if not UnitAlive(ZX7) then
call S2G(ZX7)
if IH7!=null then
call S2G(IH7)
call SaveUnitHandle(L7,I97,17,null)
endif
set t=null
set ZX7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endif
set BC7=B287_GetUnitAbilityLevel(ZX7,'A28Q')
set T8G=LoadUnitHandle(L7,GetHandleId(ZX7),652)
if T8G!=null and (GetUnitTypeId(T8G)==0 or not UnitAlive(T8G)) then
set T8G=null
endif
set TDG=.2*(GetUnitState(ZX7,UNIT_STATE_LIFE)*.035)
set TEG=.2*(GetUnitState(ZX7,UNIT_STATE_MANA)*.035)
if b1060GetTriggerEventId==EVENT_UNIT_ISSUED_ORDER then
if b1060GetIssuedOrderId==852589then
call T4G(ZX7,BC7,id)
elseif b1060GetIssuedOrderId==852590then
call S2G(ZX7)
endif
endif
if GetUnitAbilityLevel(ZX7,'A1TS')>0 or GetUnitAbilityLevel(ZX7,'A1TR')>0 or GetUnitAbilityLevel(ZX7,'A1TT')>0 or GetUnitAbilityLevel(ZX7,'A1TP')>0 then
set T9G=true
call SetUnitState(ZX7,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(ZX7,UNIT_STATE_LIFE)-TDG,1))
call SetUnitState(ZX7,UNIT_STATE_MANA,RMaxBJ(GetUnitState(ZX7,UNIT_STATE_MANA)-TEG,1))
endif
if T8G==null then
if IH7!=null then
call S2G(IH7)
set IH7=null
call SaveUnitHandle(L7,(I97),(17),(IH7))
endif
else
if IH7==null then
set IH7=T8G
if T9G then
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
else
call S2G(IH7)
endif
elseif IH7!=T8G then
call S2G(IH7)
if T9G then
set IH7=T8G
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
endif
elseif T9G==false then
call S2G(IH7)
elseif IH7==T8G then
if T9G then
set IH7=T8G
call SaveUnitHandle(L7,(I97),(17),(IH7))
call T4G(IH7,BC7,id)
endif
endif
endif
set t=null
set ZX7=null
set IH7=null
set T8G=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function IoOvercharge_InitUnit takes unit suijiIoOverchargeInitUnit returns nothing
local trigger suijiIoOverchargeInitTrigger=null
local integer suijiIoOverchargeInitTriggerId=0
if suijiIoOverchargeInitUnit==null or IsUnitIllusion(suijiIoOverchargeInitUnit) then
set suijiIoOverchargeInitUnit=null
return
endif
if OO7(GetHandleId(suijiIoOverchargeInitUnit),"SuijiIoOverchargeInit") then
set suijiIoOverchargeInitUnit=null
return
endif
call NS7(GetHandleId(suijiIoOverchargeInitUnit),"SuijiIoOverchargeInit",true)
set suijiIoOverchargeInitTrigger=CreateTrigger()
set suijiIoOverchargeInitTriggerId=GetHandleId(suijiIoOverchargeInitTrigger)
call SaveUnitHandle(L7,(suijiIoOverchargeInitTriggerId),(2),(suijiIoOverchargeInitUnit))
call SaveUnitHandle(L7,(suijiIoOverchargeInitTriggerId),(17),(null))
call SaveInteger(L7,(suijiIoOverchargeInitTriggerId),(10),(GetUnitTypeId(suijiIoOverchargeInitUnit)))
call TriggerRegisterTimerEvent(suijiIoOverchargeInitTrigger,.2,true)
call TriggerRegisterUnitEvent(suijiIoOverchargeInitTrigger,suijiIoOverchargeInitUnit,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddCondition(suijiIoOverchargeInitTrigger,Condition(function T7G))
set suijiIoOverchargeInitUnit=null
set suijiIoOverchargeInitTrigger=null
endfunction
function TianxingTwins_InitBlackOvercharge takes nothing returns nothing
call IoOvercharge_InitUnit(TianxingOverchargeInitUnit)
