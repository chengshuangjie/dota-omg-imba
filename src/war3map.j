function HLE takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function H1E takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local group g=OF7(OB7,"g")
local unit WX7=O77(OB7,"Hero")
local integer i=0
if WX7!=null and GetUnitTypeId(WX7)!=0 then
set i=GetPlayerId(GetOwningPlayer(WX7))
endif
if WX7!=null and GetUnitTypeId(WX7)!=0 and OT7(WX7,"Sandstorm")==false then
call UnitRemoveAbility(WX7,'B04R')
endif
if g!=null then
call ForGroup(g,function HLE)
call DestroyGroup(g)
endif
//删除沙尘暴特效
if OG7(OB7,"FX")!=null then
call DestroyEffect(OG7(OB7,"FX"))
endif
//////
call NM7(OB7)
call OZ7(t)
set t=null
set g=null
set WX7=null
return false
endfunction
function H0E takes nothing returns nothing
local unit HCE=GetTriggerUnit()
local group LQ7
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local integer i=GetPlayerId(GetOwningPlayer(HCE))
//转存沙尘暴特效
if OG7(SK_TX[i],"FX")!=null then
call NU7(OB7,"FX",OG7(SK_TX[i],"FX"))
endif
////////
call OX7(HCE,"Sandstorm")
set LQ7=HZ7(GetOwningPlayer(HCE),Condition(function H6E))
call NB7(OB7,"g",LQ7)
call NT7(OB7,"Hero",HCE)
call TriggerRegisterTimerEvent(t,.3+B287_GetUnitAbilityLevel(HCE,'A0H0')*.3,false)
