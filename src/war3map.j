function IoTether_CanTarget takes unit ioTetherCaster,unit ioTetherTarget returns boolean
if ioTetherCaster==null or ioTetherTarget==null then
return false
endif
if ioTetherCaster==ioTetherTarget then
return false
endif
if XH7(ioTetherCaster) or XH7(ioTetherTarget) then
return false
endif
if IsUnitEnemy(ioTetherTarget,GetOwningPlayer(ioTetherCaster)) then
return false
endif
return true
endfunction
function TVG takes nothing returns boolean
local unit ioTetherCaster=GetTriggerUnit()
local unit ioTetherTarget=GetSpellTargetUnit()
