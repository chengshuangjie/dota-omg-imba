elseif(CCE==2)then
set eY[$D0+UP]=JH7(TV7(pl),49+Q44,$9F-Q44)
endif
else
set CCE=$A+CCE
call DVF(M7[UP],JD7(TV7(pl),h7[9+P24],h7[117-P24]))
endif
elseif(CCE==1)then
call DVF(M7[UP],JD7(TV7(pl),h7[29+P_4],h7[$8B-P_4]))
elseif(CCE==2)then
call DVF(M7[UP],JD7(TV7(pl),h7[49+Q44],h7[$9F-Q44]))
