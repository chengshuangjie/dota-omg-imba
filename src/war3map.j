endfunction
function XB takes unit WI7,unit IH7 returns nothing
local integer BC7=B287_GetUnitAbilityLevel(WI7,'A0OI')+GetUnitAbilityLevel(WI7,'X0OI')
local real mana=GetUnitState(WI7,UNIT_STATE_MANA)
local real d=.01*(5+BC7)*(mana+(80+20*BC7))
local integer id=GetUnitTypeId(WI7)
call UnitRemoveAbility(IH7,'B06Y')
if(R4s(IH7) or IsUnitIllusion(IH7)) and AS7(IH7)==false and R4t(IH7)==false then
set d=d+100*BC7
endif
call YW7("+"+I2S(R2I(d)),1,IH7,.023,$BF,64,$FF,$D8)
call B67(WI7,IH7,3,d)
if IsUnitType(IH7,UNIT_TYPE_HERO) and GetHeroInt(IH7,false)>1 then
call Xb(WI7,IH7)
endif
if GetUnitAbilityLevel(WI7,'B06X')>0 and GetRandomInt(1,100)<=40 then
call SetUnitState(WI7,UNIT_STATE_MANA,mana+(.05+.05*B287_GetUnitAbilityLevel(WI7,'A0IF'))*GetUnitState(WI7,UNIT_STATE_MAX_MANA))
if id=='Z00P' then
call DestroyEffect(AddSpecialEffectTarget("model\\hero_obsidiandestroyer_n3s_e_source.mdl",WI7,"overhead"))
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl",WI7,"overhead"))
endif
endif
endfunction
