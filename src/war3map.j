set W8F='X2I0'
set W9F='X2HZ'
set WDF='X2IC'
set WEF='X2IB'
set WFF='X2ID'
else
if SuijiMode_ScepterRegistryIsActive(WX7,'A21Y')==false then
set V2F='A0DN'
set V_F='A0DG'
set W4F='A0IX'
set W7F='A0I1'
set W8F='A0I0'
set W9F='A0HZ'
set WDF='A0IC'
set WEF='A0IB'
set WFF='A0ID'
else
set V2F='A22C'
set V_F='A22D'
set W4F='A22E'
