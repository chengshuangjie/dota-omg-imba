local trigger t=null
local integer I97=0
local unit X_8=LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(WX7)),'COUR')
local integer YTF=OM7(GetHandleId(X_8),"DeliveryIndex")
local integer O5=GetPlayerId(GetOwningPlayer(WX7))
