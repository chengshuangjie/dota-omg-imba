endif
call ForGroup(T_D,function TLD)
set D8=WI7
call GroupEnumUnitsInRange(LQ7,Y5,Z5,475,U4D)
call GroupClear(T_D)
call GroupAddGroup(LQ7,T_D)
call ForGroup(LQ7,function T3D)
if(GetPlayerController(GetOwningPlayer(WI7))==MAP_CONTROL_COMPUTER)then
if(h4[16+O5]==null)then
set hS=null
set hx=WI7
call ForGroup(LQ7,function T5D)
set h4[16+O5]=hS
endif
if(h4[16+O5]!=null)then
if IsUnitAliveBJ(h4[16+O5]) and GetUnitAbilityLevel(h4[16+O5],'B02F')==0 and IsUnitVisible(h4[16+O5],GetOwningPlayer(WI7)) and IsUnitInGroup(h4[16+O5],LQ7) then
// B915: preserve an active attack instead of restarting its windup every .1s.
// Controller-local target tracking avoids live MemHack attack-target queries.
if LoadUnitHandle(L7,OB7,StringHash("B915ChronoAttackTarget"))!=h4[16+O5] or (GetUnitCurrentOrder(WI7)!=$D000F and GetUnitCurrentOrder(WI7)!=$D00FA and GetGameTime()>=LoadReal(L7,OB7,StringHash("B915ChronoAttackRetry"))) then
call SaveUnitHandle(L7,OB7,StringHash("B915ChronoAttackTarget"),h4[16+O5])
call SaveReal(L7,OB7,StringHash("B915ChronoAttackRetry"),GetGameTime()+.5)
if((not IsUnitInRange(WI7,h4[16+O5],300.))and(IsUnitType(h4[16+O5],UNIT_TYPE_HERO)))then
if(not B947IssueTargetOrderById("T0D @ war3map.j:95178 (B968)",WI7,$D00FA,h4[16+O5]))then
call B947IssueTargetOrderById("T0D @ war3map.j:95179 (B968)",WI7,$D000F,h4[16+O5])
endif
elseif(not MC7(WI7,ZU[P1]))then
call B947IssueTargetOrderById("T0D @ war3map.j:95182 (B968)",WI7,$D000F,h4[16+O5])
endif
endif
else
set h4[16+O5]=null
call RemoveSavedHandle(L7,OB7,StringHash("B915ChronoAttackTarget"))
endif
endif
endif
call WR7(LQ7)
set T8=T8+1
call SaveInteger(L7,(OB7),(28),(T8))
if T8>BZ7 then
if B946DetectCount>0 then
set GZ[384+O5]=B962Flag(1,384+O5,false,"T0D @ war3map.j:95196 (B968)")
else
set GZ[384+O5]=false
endif
set h4[16+O5]=null
if D9==false then
call ForGroup(T_D,function TLD)
endif
call RemoveUnit(ya)
call WR7(T_D)
call PauseTimer(t)
call FlushChildHashtable(L7,(OB7))
call DestroyTimer(t)
endif
call DestroyBoolExpr(U4D)
set t=null
set ya=null
set WI7=null
set T_D=null
set U4D=null
set LQ7=null
endfunction
