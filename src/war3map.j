endfunction
function M07 takes widget it returns location
call MoveLocation(HA,GetWidgetX(it),GetWidgetY(it))
return HA
endfunction
// B948: the caller is passed as a value, so nested orders cannot overwrite it.
function B948JwSource takes string caller948,string site948 returns string
if B946DetectCount==0 then
return site948
endif
return site948+"\n    调用者："+caller948
endfunction
function jW takes string caller948,unit u,integer X5,unit m5 returns boolean
local integer j=0
local integer O5=0
if(h7[GetUnitUserData(m5)]!=m5)or(X5!=$D000F and X5!=$D0012 and X5!=$D0003)then
return B947IssuePointOrderById(B948JwSource(caller948,"jW @ war3map.j:19764 (B968)"),u,X5,GetUnitX(m5),GetUnitY(m5))
endif
set j=GetUnitUserData(m5)
if j<=0 or j>=100 then
return B947IssuePointOrderById(B948JwSource(caller948,"jW @ war3map.j:19768 (B968)"),u,X5,GetUnitX(m5),GetUnitY(m5))
else
set LO4=J47(u,m5)-90
set O5=GetPlayerId(GetOwningPlayer(u))
return B947IssuePointOrderById(B948JwSource(caller948,"jW @ war3map.j:19772 (B968)"),u,X5,GetUnitX(m5)+hq[864+O5]*Cos(LO4*bj_DEGTORAD),GetUnitY(m5)+hq[864+O5]*Sin(LO4*bj_DEGTORAD))
endif
endfunction
function j1 takes unit j4,rect Ja returns real
local real JD=GetRectCenterX(Ja)-GetUnitX(j4)
local real Je=GetRectCenterY(Ja)-GetUnitY(j4)
return SquareRoot(JD*JD+Je*Je)
endfunction
function SuijiTest_NotifyAICastSuccess takes unit u,integer skill returns nothing
local player p=null
if SUIJI_AI_FOCUS_LOG==false or SUIJI_MODE==false or u==null or skill==0 then
return
endif
if GetPlayerController(GetOwningPlayer(u))!=MAP_CONTROL_COMPUTER then
return
endif
if skill!='A08V' and skill!='A06O' and skill!='A2ON' and skill!='A0QE' then
return
endif
set p=GetOwningPlayer(u)
call DisplayTimedTextToPlayer(Le,0,0,10.,"|cFF00FF00AI4日志[成功]：|rAI"+I2S(GetPlayerId(p))+" "+GetUnitName(u)+" 释放 "+GetAbilityName(skill))
set p=null
endfunction
function SuijiAI_AbilityAllowed takes integer a,integer b returns boolean
local integer logicalA=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,a)
local integer logicalB=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,b)
if not SUIJI_AI_CASTING or SUIJI_AI_SKILL_ID==0 then
return true
endif
if logicalA==0 then
set logicalA=a
endif
if logicalB==0 then
set logicalB=b
endif
return (logicalA!=0 and (logicalA==SUIJI_AI_SKILL_ID or logicalA==SUIJI_AI_HELPER_ID)) or (logicalB!=0 and (logicalB==SUIJI_AI_SKILL_ID or logicalB==SUIJI_AI_HELPER_ID))
endfunction
function SuijiAI_EffectiveUnitType takes unit u returns integer
if u==null then
return 0
endif
if SUIJI_MODE and SUIJI_AI_CASTING and SUIJI_AI_TEMPLATE_UNIT_ID!=0 then
return SUIJI_AI_TEMPLATE_UNIT_ID
endif
return GetUnitTypeId(u)
endfunction
function SuijiAI_GetActiveRandomOrder takes unit u,integer skill returns string
local integer h=0
local integer logicalSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
local integer activeSkill=SUIJI_AI_SKILL_ID
local integer storedSkill=0
if u==null or GetUnitTypeId(u)==0 or not SUIJI_AI_CASTING or SUIJI_AI_SKILL_ID==0 then
return ""
endif
if logicalSkill==0 then
set logicalSkill=skill
endif
if LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,activeSkill)!=0 then
set activeSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,activeSkill)
endif
if logicalSkill!=activeSkill then
return ""
endif
set h=GetHandleId(u)
set storedSkill=LoadInteger(L7,h,StringHash("SuijiSmallSkill"))
if LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,storedSkill)!=0 then
set storedSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,storedSkill)
endif
if storedSkill==logicalSkill then
return LoadStr(L7,h,StringHash("SuijiSmallOrder"))
endif
set storedSkill=LoadInteger(L7,h,StringHash("SuijiUltSkill"))
if LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,storedSkill)!=0 then
set storedSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,storedSkill)
endif
if storedSkill==logicalSkill then
return LoadStr(L7,h,StringHash("SuijiUltOrder"))
endif
return ""
endfunction
function SuijiAI_RandomOrderUsesPointTarget takes integer skill,string order returns boolean
if LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)!=0 then
set skill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
endif
// Random Burrowstrike and the isolated Vacuum carrier are Channel point spells.
// Their accepted command text alone is not sufficient to infer the target type.
return skill=='A06O' or skill=='A0QE'
endfunction
// B835: deterministic AI cast ownership; never inspect/mutate a live ability.
// Only genuine held channels keep ownership after EFFECT. ANcl alone and the
// broad Multicast exclusion list are NOT a channel classifier.
function B835AIChannelHoldLimit takes integer b835Skill returns real
if b835Skill=='A03R' or b835Skill=='A0AV' then
return 15.
elseif b835Skill=='A06R' or b835Skill=='A1B4' then
return 4.
elseif b835Skill=='A065' then
return 5.
elseif b835Skill=='A085' then
return 7.
elseif b835Skill=='A12K' or b835Skill=='A1AA' or b835Skill=='A2V1' or b835Skill=='A4CZ' then
return 4.
elseif b835Skill=='A1BX' or b835Skill=='A2SL' or b835Skill=='A0BY' then
return 6.
elseif b835Skill=='A0NT' or b835Skill=='A0NX' then
return 16.
elseif b835Skill=='A00P' or b835Skill=='X00P' or b835Skill=='X10P' or b835Skill=='A19N' or b835Skill=='A02N' or b835Skill=='X02N' then
return 7.
elseif b835Skill=='A02Q' or b835Skill=='A1D9' then
return 9.
elseif b835Skill=='A0FL' or b835Skill=='A1CX' or b835Skill=='X1CX' then
return 8.
elseif b835Skill=='A0CC' or b835Skill=='A02Z' or b835Skill=='A04L' then
return 12.
elseif b835Skill=='A06P' then
return 14.
elseif b835Skill=='A0H0' then
return 82.
elseif b835Skill=='A2L0' then
return 8.
elseif b835Skill=='A137' or b835Skill=='A4T0' then
return 22.
elseif b835Skill=='A231' or b835Skill=='A2Q6' then
return 6.
endif
// In particular: A4L1 Rearm-mod, A1PH charge casts, Infest, Poison Nova,
// Eclipse, transformations and persistent ground effects do not hold here.
return 0.
endfunction
function B835AIChannelClear takes unit b835Unit returns nothing
local integer b835Handle=GetHandleId(b835Unit)
local integer b835Player=LoadInteger(L7,b835Handle,StringHash("B835AIChannelPlayer"))
if LoadUnitHandle(L7,StringHash("B835AIChannelOwners"),b835Player)==b835Unit then
call RemoveSavedHandle(L7,StringHash("B835AIChannelOwners"),b835Player)
endif
call RemoveSavedInteger(L7,b835Handle,StringHash("B835AIChannelPhysical"))
call RemoveSavedInteger(L7,b835Handle,StringHash("B835AIChannelPlayer"))
call RemoveSavedReal(L7,b835Handle,StringHash("B835AIChannelUntil"))
endfunction
function B835AIChannelBlocked takes unit b835Unit returns boolean
local integer b835Handle=0
if GetUnitTypeId(b835Unit)=='H0DO' and LoadReal(L7,GetHandleId(b835Unit),StringHash("B1021Hold"))>TimerGetElapsed(W) and not LoadBoolean(L7,GetHandleId(b835Unit),StringHash("B1021Issuing")) then
return true
endif
if not SUIJI_MODE or b835Unit==null then
return false
endif
set b835Handle=GetHandleId(b835Unit)
if MiaoStarted and GetUnitTypeId(b835Unit)=='HMD0' and UnitAlive(b835Unit) and GetPlayerController(GetOwningPlayer(b835Unit))==MAP_CONTROL_COMPUTER and LoadReal(MiaoTable,b835Handle,147)>GetGameTime() then
return true
endif
// Charge is script-driven after its short engine cast ends. Reuse DARK and
// the controller's own bounded deadline, not GetUnitCurrentOrder or ENDCAST.
if GetUnitTypeId(b835Unit)!=0 and UnitAlive(b835Unit) and GetPlayerController(GetOwningPlayer(b835Unit))==MAP_CONTROL_COMPUTER and LoadBoolean(L7,b835Handle,'DARK') and LoadReal(L7,b835Handle,StringHash("B835AIChargeUntil"))>TimerGetElapsed(W) then
return true
endif
if LoadInteger(L7,b835Handle,StringHash("B835AIChannelPhysical"))==0 then
return false
endif
if GetUnitTypeId(b835Unit)==0 or not UnitAlive(b835Unit) or GetPlayerController(GetOwningPlayer(b835Unit))!=MAP_CONTROL_COMPUTER or TimerGetElapsed(W)>=LoadReal(L7,b835Handle,StringHash("B835AIChannelUntil")) then
call B835AIChannelClear(b835Unit)
return false
endif
return true
endfunction
function B835AIChannelPruneSlot takes integer b835Player returns nothing
local unit b835Unit=LoadUnitHandle(L7,StringHash("B835AIChannelOwners"),b835Player)
if b835Unit!=null then
if b835Unit!=M7[b835Player] then
call B835AIChannelClear(b835Unit)
else
call B835AIChannelBlocked(b835Unit)
endif
endif
set b835Unit=null
endfunction
function B835AIChannelEvent takes nothing returns boolean
local integer b1060B287_GetSpellAbilityId=B287_GetSpellAbilityId()
local unit b835Unit=GetTriggerUnit()
local unit b835OldUnit=null
local integer b835Handle=0
local integer b835Player=0
local integer b835Physical=GetSpellAbilityId()
local integer b835Logical=0
local real b835Hold=0.
local eventid b835Event=GetTriggerEventId()
if not SUIJI_MODE or b835Unit==null then
set b835Unit=null
return false
endif
set b835Handle=GetHandleId(b835Unit)
if b835Event==EVENT_PLAYER_UNIT_DEATH then
if LoadInteger(L7,b835Handle,StringHash("B835AIChannelPhysical"))!=0 then
call B835AIChannelClear(b835Unit)
endif
set b835Unit=null
return false
endif
if GetUnitTypeId(b835Unit)==0 or not UnitAlive(b835Unit) or GetPlayerController(GetOwningPlayer(b835Unit))!=MAP_CONTROL_COMPUTER or not IsUnitType(b835Unit,UNIT_TYPE_HERO) or IsUnitIllusion(b835Unit) then
set b835Unit=null
return false
endif
set b835Player=GetPlayerId(GetOwningPlayer(b835Unit))
// The existing AI loop owns one primary hero per player. Never retain dummy
// casters/illusion handles or let their events replace the hero's ownership.
if b835Player>11 or M7[b835Player]!=b835Unit or b835Physical==0 or LoadBoolean(L7,b835Handle,StringHash("SuijiMulticastCasting")) or LoadBoolean(L7,b835Handle,StringHash("LotusReflecting")) then
set b835Unit=null
return false
endif
if b835Event==EVENT_PLAYER_UNIT_SPELL_CHANNEL then
set b835OldUnit=LoadUnitHandle(L7,StringHash("B835AIChannelOwners"),b835Player)
if b835OldUnit!=null and b835OldUnit!=b835Unit then
call B835AIChannelClear(b835OldUnit)
endif
call SaveUnitHandle(L7,StringHash("B835AIChannelOwners"),b835Player,b835Unit)
call SaveInteger(L7,b835Handle,StringHash("B835AIChannelPlayer"),b835Player)
call SaveInteger(L7,b835Handle,StringHash("B835AIChannelPhysical"),b835Physical)
// Protect ordinary windup too, but never leave it locked after EFFECT.
call SaveReal(L7,b835Handle,StringHash("B835AIChannelUntil"),TimerGetElapsed(W)+8.)
elseif LoadInteger(L7,b835Handle,StringHash("B835AIChannelPhysical"))==b835Physical then
if b835Event==EVENT_PLAYER_UNIT_SPELL_EFFECT then
set b835Logical=b1060B287_GetSpellAbilityId
set b835Hold=B835AIChannelHoldLimit(b835Logical)
// Upgraded Upheaval is an independent field; do not wait for its visual expiry.
if b835Logical=='A06P' and SuijiMode_EarlyScepterRegistryIsActive(b835Unit,'A06P') then
set b835Hold=0.
endif
if b835Hold>0. then
call SaveReal(L7,b835Handle,StringHash("B835AIChannelUntil"),TimerGetElapsed(W)+b835Hold)
else
call B835AIChannelClear(b835Unit)
endif
elseif b835Event==EVENT_PLAYER_UNIT_SPELL_FINISH or b835Event==EVENT_PLAYER_UNIT_SPELL_ENDCAST then
// Exact physical ownership prevents another spell's end event from unlocking
// the held spell. Synthetic repeats/reflections were excluded above.
call B835AIChannelClear(b835Unit)
endif
endif
set b835Unit=null
set b835OldUnit=null
return false
endfunction
function SuijiAI_IssueNativeTargetOrder takes unit u,unit target,integer sourceOrder,integer skill returns boolean
local string order=SuijiAI_GetActiveRandomOrder(u,skill)
if B1120ControlBlocked(u) then
return false
endif
if B835AIChannelBlocked(u) then
return false
endif
if order!="" and order!="passive" then
if SuijiAI_RandomOrderUsesPointTarget(skill,order) then
return B947IssuePointOrderById("SuijiAI_IssueNativeTargetOrder @ war3map.j:20014 (B968)",u,OrderId(order),GetUnitX(target),GetUnitY(target))
endif
return B947IssueTargetOrderById("SuijiAI_IssueNativeTargetOrder @ war3map.j:20016 (B968)",u,OrderId(order),target)
endif
return B947IssueTargetOrderById("SuijiAI_IssueNativeTargetOrder @ war3map.j:20018 (B968)",u,sourceOrder,target)
endfunction
function SuijiMode_IsOwnedRandomFlareSkill takes unit u,integer skill returns boolean
local integer logicalSkill=skill
local integer mappedSkill=0
if u==null or GetUnitTypeId(u)==0 or skill==0 then
return false
endif
set mappedSkill=LoadInteger(SUIJI_FIXED_CLONE_TABLE,1,skill)
if mappedSkill!=0 then
set logicalSkill=mappedSkill
endif
return (logicalSkill=='A0IL' or logicalSkill=='A0LL' or logicalSkill=='A0NB' or logicalSkill=='A0NO' or logicalSkill=='A0Z6' or logicalSkill=='A14L' or logicalSkill=='A15S' or logicalSkill=='A1E9' or logicalSkill=='A1HS' or logicalSkill=='A1SB' or logicalSkill=='A1SU' or logicalSkill=='A0OK' or logicalSkill=='A0S8' or logicalSkill=='A1QP' or logicalSkill=='A1T5' or logicalSkill=='A1VW' or logicalSkill=='A235') and (LoadInteger(L7,GetHandleId(u),StringHash("SuijiSmallSkill"))==logicalSkill or LoadInteger(L7,GetHandleId(u),StringHash("SuijiUltSkill"))==logicalSkill)
endfunction
function M57 takes unit x6,integer X5,integer o6,unit m5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local boolean suijiFlare=SuijiMode_IsOwnedRandomFlareSkill(x6,o6)
local string suijiOrder=SuijiAI_GetActiveRandomOrder(x6,o6)
local boolean suijiPoint=false
if B1120ControlBlocked(x6) then
return false
endif
if not B992ChannelUltAllowed(x6,o6) then
return false
endif
if B835AIChannelBlocked(x6) then
return false
endif
if suijiFlare then
set X5=852060
elseif suijiOrder!="" and suijiOrder!="passive" then
set X5=OrderId(suijiOrder)
set suijiPoint=SuijiAI_RandomOrderUsesPointTarget(o6,suijiOrder)
endif
if SUIJI_AI_CASTING and SUIJI_AI_ORDER_ID!=0 and X5!=SUIJI_AI_ORDER_ID then
return false
endif
if not SuijiAI_AbilityAllowed(o6,0) then
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,true)
call DisableTrigger(Q04[O5])
if(((suijiFlare or suijiPoint) and B947IssuePointOrderById("M57 @ war3map.j:20054 (B968)",x6,X5,GetUnitX(m5),GetUnitY(m5))) or (not suijiFlare and not suijiPoint and B947IssueTargetOrderById("M57 @ war3map.j:20054 (B968)",x6,X5,m5)))then
call EnableTrigger(Q04[O5])
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[O5])
if not SUIJI_AI_CASTING then
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,false)
endif
return false
endfunction
function M_7 takes unit x6,integer X5,integer o6,integer n6,unit m5 returns boolean
local integer O5=GetPlayerId(GetOwningPlayer(x6))
local boolean suijiFlare=SuijiMode_IsOwnedRandomFlareSkill(x6,o6) or SuijiMode_IsOwnedRandomFlareSkill(x6,n6)
local integer suijiLionFingerPhysical=0
local string suijiOrder=SuijiAI_GetActiveRandomOrder(x6,o6)
local boolean suijiPoint=false
if B1120ControlBlocked(x6) then
return false
endif
if B835AIChannelBlocked(x6) then
return false
endif
if suijiOrder=="" then
set suijiOrder=SuijiAI_GetActiveRandomOrder(x6,n6)
endif
if suijiFlare then
set X5=852060
elseif suijiOrder!="" and suijiOrder!="passive" then
set X5=OrderId(suijiOrder)
set suijiPoint=SuijiAI_RandomOrderUsesPointTarget(SUIJI_AI_SKILL_ID,suijiOrder)
endif
if SUIJI_AI_CASTING and SUIJI_AI_ORDER_ID!=0 and X5!=SUIJI_AI_ORDER_ID then
return false
endif
if not SuijiAI_AbilityAllowed(o6,n6) then
return false
endif
if(not QY4[O5]or o6==0)then
return false
endif
// Finger of Death owns one live base/Scepter button. Do not enable both
// aliases in the AI loop, or a ready alias can bypass the shared cooldown.
if o6=='A095' and n6=='A09W' then
if LoadReal(L7,GetHandleId(x6),StringHash("SuijiLionFingerReadyAt"))>TimerGetElapsed(W) then
return false
endif
set suijiLionFingerPhysical=B287_GetPhysicalAbilityId(x6,'A095')
if GetUnitAbilityLevel(x6,suijiLionFingerPhysical)<=0 then
set suijiLionFingerPhysical=B287_GetPhysicalAbilityId(x6,'A09W')
endif
if B581_AIAbilityReady(x6,suijiLionFingerPhysical)==false then
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),suijiLionFingerPhysical,true)
call DisableTrigger(Q04[O5])
if B947IssueTargetOrderById("M_7 @ war3map.j:20107 (B968)",x6,X5,m5) then
call EnableTrigger(Q04[O5])
call SaveReal(L7,GetHandleId(x6),StringHash("SuijiLionFingerReadyAt"),TimerGetElapsed(W)+1.)
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[O5])
return false
endif
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,true)
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),n6,true)
call DisableTrigger(Q04[O5])
if(((suijiFlare or suijiPoint) and B947IssuePointOrderById("M_7 @ war3map.j:20119 (B968)",x6,X5,GetUnitX(m5),GetUnitY(m5))) or (not suijiFlare and not suijiPoint and B947IssueTargetOrderById("M_7 @ war3map.j:20119 (B968)",x6,X5,m5)))then
call EnableTrigger(Q04[O5])
call SuijiTest_NotifyAICastSuccess(x6,SUIJI_AI_SKILL_ID)
return true
endif
call EnableTrigger(Q04[O5])
if not SUIJI_AI_CASTING then
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),o6,false)
call B515_SetLegacyAIAbilityAvailable(x6,GetOwningPlayer(x6),n6,false)
endif
return false
endfunction
