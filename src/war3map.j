elseif BZ7>=1.5 then
return 8
elseif BZ7>=1.4 then
return 7
elseif BZ7>=1.25 then
return 6
elseif BZ7>=1.2 then
return 5
elseif BZ7>=1 then
return 4
elseif BZ7>=.75 then
return 3
elseif BZ7>=.5 then
return 2
elseif BZ7>=.25 then
return 1
endif
return 1
endfunction
//给单位添加眩晕，第一次使用会卡一下
function BA7 takes unit p5,unit m5,real Z27 returns nothing
local unit BB7=null
local integer BC7=0
// IMBA: safety filters mirroring CommonUnitAddStun; duration x2 cap 5s.
if XOMG_IMBA_ENABLED then
if MiaoStarted and GetUnitAbilityLevel(m5,'AMdI')>0 then
return
endif
if (m5==ChaosObserverBoss and GetUnitTypeId(m5)=='NB0S') or (m5==TianxingBlackBoss and GetUnitTypeId(m5)=='NTY2') then
return
endif
if IsMagicImmuneUnit(m5) or not UnitAlive(m5) then
return
endif
if Z27 > 0. and Z27 < 2.5 then
set Z27 = RMinBJ(Z27*IMBA_POWER, 5.)
endif
endif
set BB7=CreateUnit(GetOwningPlayer(m5),'e00E',GetUnitX(m5),GetUnitY(m5),0)
set BC7=BY7(Z27)
call UnitAddAbility(BB7,'A0X6')
call SetUnitAbilityLevel(BB7,'A0X6',BC7)
call B947IssueTargetOrderById("BA7 @ war3map.j:27206 (B968)",BB7,$D007F,m5)
call UnitApplyTimedLife(BB7,'BTLF',1.)
set BB7=null
endfunction
//不会造成玲珑心吸血的伤害
function B67_DPS takes unit p5,unit m5,integer BL7,real YM7 returns nothing
local unit b67DpsKillDummyUnit=null
if BL7==0 then
return
endif
// IMBA: positive skill damage x IMBA_POWER once; BL7==6 life removal excluded; call-site exclusion for execute/econ.
if imbaB67DpsExclude then
set imbaB67DpsExclude=false
elseif XOMG_IMBA_ENABLED and BL7!=6 then
if XOMG_DAMAGE_LOG_COUNT<12 then
call XOMG_LogEvent("IMBA_DAMAGE path=DPS type="+I2S(BL7)+" base="+R2S(YM7)+" actual="+R2S(YM7*IMBA_POWER)+" legacyXM="+I2S(B287_BoolToInt(XM_MODE))+" mult="+I2S(imbaMult)+" ver="+XOMG_VERSION)
set XOMG_DAMAGE_LOG_COUNT=XOMG_DAMAGE_LOG_COUNT+1
endif
set YM7=YM7*IMBA_POWER
endif
if BL7==2 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==3 then
	if IsFortDefenseTypeUnit(m5) then
		set YM7 = YM7 * 2
	endif
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==4 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==5 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
//生命移除
elseif BL7==6 then
call SetUnitState(m5,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(m5,UNIT_STATE_LIFE)-YM7,1))
if GetUnitState(m5,UNIT_STATE_LIFE)<2 then
call UnitRemoveBuffs(m5,true,true)
call UnitRemoveAbility(m5,'Aetl')
set b67DpsKillDummyUnit=CreateUnit(GetOwningPlayer(p5),'e00E',0,0,0)
call UnitDamageTarget(b67DpsKillDummyUnit,m5,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitApplyTimedLife(b67DpsKillDummyUnit,'BTLF',1.)
endif
//无视虚无纯粹伤害
elseif BL7==7 then
if GetUnitAbilityLevel(m5,'Aetl')>0 or GetUnitAbilityLevel(m5,'B01N')>0 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
else
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
elseif BL7==8 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==9 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==10 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
elseif BL7==11 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==12 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==13 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==14 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==15 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==16 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==17 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_DIVINE,WEAPON_TYPE_WHOKNOWS)
elseif BL7==18 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNKNOWN,WEAPON_TYPE_WHOKNOWS)
elseif BL7==19 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNKNOWN,WEAPON_TYPE_WHOKNOWS)
elseif BL7==20 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
endif
set b67DpsKillDummyUnit=null
endfunction
//单位伤害事件中所有伤害会造成玲珑心吸血
function B67 takes unit p5,unit m5,integer BL7,real YM7 returns nothing
local unit b67KillDummyUnit=null
local boolean b1030PriorDamageFlag=Fe
if BL7==0 then
return
endif
// IMBA: positive skill damage x IMBA_POWER once; BL7==6 life removal excluded.
if XOMG_IMBA_ENABLED and BL7!=6 then
if XOMG_DAMAGE_LOG_COUNT<12 then
call XOMG_LogEvent("IMBA_DAMAGE path=B67 type="+I2S(BL7)+" base="+R2S(YM7)+" actual="+R2S(YM7*IMBA_POWER)+" legacyXM="+I2S(B287_BoolToInt(XM_MODE))+" mult="+I2S(imbaMult)+" ver="+XOMG_VERSION)
set XOMG_DAMAGE_LOG_COUNT=XOMG_DAMAGE_LOG_COUNT+1
endif
set YM7=YM7*IMBA_POWER
endif
set Fe=true
call BrewmasterCinderBrew_TryIgnite(p5,m5,BL7)
//普通攻击火焰伤害，魔法技能，计算魔抗
if BL7==1 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_FIRE,WEAPON_TYPE_WHOKNOWS)
//英雄攻击普通伤害，物理攻击，计算护甲
elseif BL7==2 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
//英雄攻击魔法伤害，不计算魔抗和护甲，对魔免单位无效
elseif BL7==3 then
	if IsFortDefenseTypeUnit(m5) and not XM_MODE then
		set YM7 = YM7 * 2
	endif
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==4 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==5 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
//生命移除
elseif BL7==6 then
call SetUnitState(m5,UNIT_STATE_LIFE,RMaxBJ(GetUnitState(m5,UNIT_STATE_LIFE)-YM7,1))
if GetUnitState(m5,UNIT_STATE_LIFE)<2 and OT7(m5,"ShallowGrave|Active")==false then
call UnitRemoveBuffs(m5,true,true)
call UnitRemoveAbility(m5,'Aetl')
set b67KillDummyUnit=CreateUnit(GetOwningPlayer(p5),'e00E',0,0,0)
call UnitDamageTarget(b67KillDummyUnit,m5,100000000.,true,false,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitApplyTimedLife(b67KillDummyUnit,'BTLF',1.)
endif
//无视虚无纯粹伤害
elseif BL7==7 then
	if IsFortDefenseTypeUnit(m5) and not XM_MODE then
		set YM7 = YM7 * 2
	endif
if GetUnitAbilityLevel(m5,'Aetl')>0 or GetUnitAbilityLevel(m5,'B01N')>0 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
else
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
//法术攻击通用伤害
elseif BL7==8 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
//魔法攻击通用伤害，英雄护甲固定80%伤害，不计算魔抗和护甲，计算削弱的魔抗，可以伤害虚无，对魔免无效
elseif BL7==9 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
//英雄攻击加强伤害，不计算魔抗和护甲，对魔免单位有效，对虚无无效
elseif BL7==10 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
//英雄攻击通用伤害，不计算魔抗和护甲，对魔免单位有效，对虚无无效
elseif BL7==11 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==12 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif BL7==13 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==14 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==15 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_SIEGE,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==16 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif BL7==17 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_DIVINE,WEAPON_TYPE_WHOKNOWS)
elseif BL7==18 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_UNKNOWN,WEAPON_TYPE_WHOKNOWS)
elseif BL7==19 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_UNKNOWN,WEAPON_TYPE_WHOKNOWS)
elseif BL7==20 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
//英雄攻击神圣伤害，对魔免无效
elseif BL7==21 then
call UnitDamageTarget(p5,m5,YM7,true,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_DIVINE,WEAPON_TYPE_WHOKNOWS)
endif
set b67KillDummyUnit=null
set Fe=b1030PriorDamageFlag
endfunction
//循环伤害
function Loop_Damage_Action takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer OB7=GetHandleId(t)
    local unit ZX7=LoadUnitHandle(TABLE_HY,OB7,0)
    local unit IH7=LoadUnitHandle(TABLE_HY,OB7,1)
    local real YM7=LoadReal(TABLE_HY,OB7,0)
    if GetGameTime()>=LoadReal(TABLE_HY, OB7, 100) or UnitAlive(IH7)==false then
        call PauseTimer(t)
        call FlushChildHashtable(TABLE_HY,OB7)
        call DestroyTimer(t)
    else
        call B67(ZX7,IH7,1,YM7)
    endif
    set t=null
    set ZX7=null
    set IH7=null
endfunction
function Loop_Damage takes unit ZX7,unit IH7,real d,real DUR,real YM7 returns nothing
    local timer t=CreateTimer()
    local integer OB7=GetHandleId(t)
    // IMBA: DoT total duration x2 cap 30s; tick d untouched; end-time child100 syncs via same DUR.
    if XOMG_IMBA_ENABLED then
        set DUR=RMinBJ(DUR*IMBA_POWER,30.)
    endif
    call SaveUnitHandle(TABLE_HY,OB7,0,ZX7)
    call SaveUnitHandle(TABLE_HY,OB7,1,IH7)
    call SaveReal(TABLE_HY,OB7,0,YM7)
    call SaveReal(TABLE_HY,OB7,100, GetGameTime()+ DUR)
    call TimerStart(t,d,true,function Loop_Damage_Action)
    set t=null
endfunction
// 晕眩单位 单位 持续时间 是否无视魔免
function CommonUnitAddStun takes unit whichUnit, real dur, boolean isIgnoresMagicImmunity returns real
	local unit dummyUnit = null
	if MiaoStarted and GetUnitAbilityLevel(whichUnit,'AMdI')>0 then
		return 0.
	endif
	if (whichUnit==ChaosObserverBoss and GetUnitTypeId(whichUnit)=='NB0S') or (whichUnit==TianxingBlackBoss and GetUnitTypeId(whichUnit)=='NTY2') then
		return 0.
	endif
	if (not isIgnoresMagicImmunity and IsMagicImmuneUnit(whichUnit)) or not UnitAlive(whichUnit) then//检查是否魔免
		return 0.
	endif
	// IMBA: positive stun duration x IMBA_POWER, hard-capped at 5s; permanent/abnormal long stuns untouched.
	if XOMG_IMBA_ENABLED and dur > 0. and dur < 5. then
		set dur=RMinBJ(dur*IMBA_POWER,5.)
	endif
	//set dur = FQX(whichUnit, s)
	if dur > 0 then
		set dummyUnit = CreateUnit(GetOwningPlayer(whichUnit),'e00E', GetUnitX(whichUnit), GetUnitY(whichUnit), 0)
		call UnitAddAbility(dummyUnit, 'A420')
		call YDWESetUnitAbilityDataReal(dummyUnit,'A420', 1, ABILITY_DATA_DUR, dur)
		call YDWESetUnitAbilityDataReal(dummyUnit,'A420', 1, ABILITY_DATA_HERODUR, dur)
		call B947IssueTargetOrderById("CommonUnitAddStun @ war3map.j:27400 (B968)",dummyUnit, 852095, whichUnit)
		call UnitApplyTimedLife(dummyUnit,'BTLF',1.)
		set dummyUnit = null
	endif
	// debug call SingleDebug(" 晕眩时间 "+ R2S(dur) )
	return dur
endfunction
function TGA takes unit whichUnit, unit targetUnit, integer i returns nothing
	if i == 1 then //重击
		call B67(whichUnit, targetUnit, 2, 40 + 20 * B287_GetUnitAbilityLevel(whichUnit,'A0JJ'))
		call CommonUnitAddStun(targetUnit, 1., true)
	// elseif i == 2 then
    //     call CommonUnitAddStun(targetUnit, 1., true)
//		call B67(whichUnit, targetUnit, 1, 30 + 10 * B287_GetUnitAbilityLevel(whichUnit,'A081'))	
//		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", targetUnit, "chest"))
	// elseif i == 2 then
    //     call CommonUnitAddStun(targetUnit, 1., true)
//		call B67(whichUnit, targetUnit, 1, 30 + 10 * B287_GetUnitAbilityLevel(whichUnit,'A081'))	
//		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", targetUnit, "chest"))
	// elseif i == 2 then
    //     call CommonUnitAddStun(targetUnit, 1., true)
//		call B67(whichUnit, targetUnit, 1, 30 + 10 * B287_GetUnitAbilityLevel(whichUnit,'A081'))	
//		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", targetUnit, "chest"))
    elseif i == 3 then
		call B67(whichUnit, targetUnit, 10, 20 * GetUnitAbilityLevel(whichUnit,'A09E'))
		call CommonUnitAddStun(targetUnit, .4 + .4 * GetUnitAbilityLevel(whichUnit,'A09E'), true)
	elseif i == 4 then //晕锤眩晕
		call CommonUnitAddStun(targetUnit, 1.4, true)
	elseif i == 5 then //金箍棒伤害和眩晕
		call B67(whichUnit, targetUnit, 1, 160)
		call CommonUnitAddStun(targetUnit, 0.01, true)
	elseif i == 6 then  //极度饥渴眩晕
		call CommonUnitAddStun(targetUnit, 1., true)
	endif
endfunction
function LXCD_TRI takes nothing returns nothing
	local timer t = GetExpiredTimer()
	local integer h = GetHandleId(t)
	local unit u = LoadUnitHandle(TABLE_HY, h, 1)
	call SaveInteger(TABLE_HY, GetHandleId(u), 'LXCD', 0)
	call FlushChildHashtable(TABLE_HY, h)
	call PauseTimer(t)
	call DestroyTimer(t)
	set t = null
	set u = null
endfunction
function LXCD takes unit u returns nothing
	local timer t = CreateTimer()
    local real d = 5.
	if GetUnitAbilityLevel(u,'A2VW')>0 then
        set d=3.75
    endif
	call YDWESetUnitAbilityState(u,'A4K8', 1, d)
	call SaveInteger(TABLE_HY, GetHandleId(u), 'LXCD', 1)
	call SaveUnitHandle(TABLE_HY, GetHandleId(t), 1, u)
	call TimerStart(t, d , false, function LXCD_TRI)
	set t = null
endfunction
function LINGXIA takes unit ZX7,unit IH7 returns nothing
    local real damage
    //敌人非建筑非守卫非魔免非隐藏非吹风可见
    if IsUnitEnemy(IH7,GetOwningPlayer(ZX7)) and IsAliveNotStrucNotWard(IH7) and WF7(IH7)==false and IsHideUnit(IH7)==false and CHUIFENG(IH7)==false and AM7(IH7,GetOwningPlayer(ZX7))==false then
	    if GetUnitAbilityLevel(ZX7,'A4K8')>0 and LoadInteger(TABLE_HY, GetHandleId(ZX7),'LXCD')== 0 and B581_AIAbilityReady(ZX7,'A4K8') then
            call LXCD(ZX7)
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl",GetUnitX(IH7),GetUnitY(IH7)))
            if GetUnitAbilityLevel(ZX7,'A4K7')>0 then
		        call B67(ZX7,IH7,1,150)
		        call Z57(IH7,'A4K9', 1, 2.,'B0KG')
                call YW7("+150",2,IH7,.023,255,80,168,255)
            elseif GetUnitAbilityLevel(ZX7,'A4KB')>0 then
                set damage = 150. + (GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BASE) + GetUnitState(ZX7, UNIT_STATE_ATTACK1_DAMAGE_BONUS) ) * 0.6
		        call B67(ZX7,IH7,1,damage)
		        call Z57(IH7,'A4KA', 1, 2.,'B0KH')
                call YW7("+"+I2S(R2I(damage)),2,IH7,.023,255,80,168,255)
            endif
	    endif
    endif
endfunction
function B17 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local integer B07=OM7(OB7,"TargetIndex")
local unit m5=TQ7(B07)
local integer BL7=OM7(OB7,"DamageType")
local real YM7=ON7(OB7,"Damage")
call B67(p5,m5,BL7,YM7)
call TP7(B07)
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endfunction
function B57 takes unit p5,unit m5,integer BL7,real YM7,real Z27 returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call NT7(OB7,"Source",p5)
call NP7(OB7,"TargetIndex",TS7(m5))
call NP7(OB7,"DamageType",BL7)
call NQ7(OB7,"Damage",YM7*1.)
call TriggerRegisterTimerEvent(t,Z27,false)
call TriggerAddCondition(t,Condition(function B17))
set t=null
endfunction
function jQ takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer BL7=OM7(OB7,"DamageType")
local real YM7=ON7(OB7,"Damage")
call B67(p5,m5,BL7,YM7)
call NM7(OB7)
call OZ7(t)
set t=null
set p5=null
set m5=null
return false
endfunction
function B27 takes unit p5,unit m5,integer BL7,real YM7,real Hk returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NP7(OB7,"DamageType",BL7)
call NQ7(OB7,"Damage",YM7)
call TriggerRegisterTimerEvent(t,Hk,false)
call TriggerAddCondition(t,Condition(function jQ))
set t=null
endfunction
function jQ_KAERCF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=O77(OB7,"Source")
local unit m5=O77(OB7,"Target")
local integer BL7=OM7(OB7,"DamageType")
local real YM7=ON7(OB7,"Damage")
local real MAX=ON7(OB7,"MAX")
local real NOW=ON7(OB7,"NOW")
if NOW>=MAX or (NOW>.1 and GetUnitAbilityLevel(m5,'Bcyc')==0) then
call B67(p5,m5,BL7,YM7)
call NM7(OB7)
call OZ7(t)
else
call NQ7(OB7,"NOW",NOW+.1)
endif
set t=null
set p5=null
set m5=null
return false
endfunction
function B27_KAERCF takes unit p5,unit m5,integer BL7,real YM7,real Hk returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call NT7(OB7,"Source",p5)
call NT7(OB7,"Target",m5)
call NP7(OB7,"DamageType",BL7)
call NQ7(OB7,"Damage",YM7)
call NQ7(OB7,"MAX",Hk)
