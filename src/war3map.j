local unit suijiIoOverchargeDeferredUnit=LoadUnitHandle(L7,StringHash("SuijiIoOverchargeInitDeferred"),0)
call RemoveSavedHandle(L7,StringHash("SuijiIoOverchargeInitDeferred"),0)
call IoOvercharge_InitUnit(suijiIoOverchargeDeferredUnit)
set suijiIoOverchargeDeferredUnit=null
endfunction
function TFG takes nothing returns nothing
call IoOvercharge_InitUnit(GetTriggerUnit())
endfunction
function TGG takes nothing returns boolean
if B287_GetLearnedSkill()=='A28Q' and IsUnitIllusion(GetTriggerUnit())==false and B287_GetUnitAbilityLevel(GetTriggerUnit(),'A28Q')==1 then
call TFG()
endif
return false
endfunction
function OJ8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function TGG))
set t=null
endfunction
function THG takes nothing returns nothing
local unit b1060GetEnumUnit=GetEnumUnit()
if IsUnitInGroup((b1060GetEnumUnit),UA4)==false then
call GroupAddUnit(UA4,(b1060GetEnumUnit))
call BA7(UK4,(b1060GetEnumUnit),.25+.5*U34)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl",(b1060GetEnumUnit),"chest"))
endif
set b1060GetEnumUnit=null
endfunction
function TIG takes unit ZX7,unit IH7,group QTG returns nothing
local real x1=GetUnitX(ZX7)
local real y1=GetUnitY(ZX7)
local real x2=GetUnitX(IH7)
local real y2=GetUnitY(IH7)
local real a=J77(x1,y1,x2,y2)*bj_DEGTORAD
local real x
local real y
local real d=KF7(x1,y1,x2,y2)
local group g=WS7()
local integer i=1
set UA4=QTG
set UK4=ZX7
set U34=B287_GetUnitAbilityLevel(ZX7,'A1TA')
set UB4=U34*50+50
loop
exitwhen i>8
set IN4=ZX7
set x=x1+d*i/8*Cos(a)
set y=y1+d*i/8*Sin(a)
call GroupEnumUnitsInRange(g,x,y,100,Condition(function AJ7_gai))
call ForGroup(g,function THG)
call GroupClear(g)
set i=i+1
endloop
call WR7(g)
set g=null
endfunction
function TJG takes unit ZX7,unit IH7 returns boolean
return(OT7(ZX7,"Relocate|Active"))
endfunction
function TKG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local real d=KE7(ZX7,IH7)
local real a=J47(ZX7,IH7)*bj_DEGTORAD
local real x=GetUnitX(ZX7)+20*Cos(a)
local real y=GetUnitY(ZX7)+20*Sin(a)
local location l
if d<300 or d>$866 then
set l=YV8(x,y)
set x=GetLocationX(l)
set y=GetLocationY(l)
call SetUnitX(ZX7,X17(x))
call SetUnitY(ZX7,X17(y))
call Y67(x,y,350)
call RemoveLocation(l)
set l=null
call DestroyEffect((LoadEffectHandle(L7,(I97),(32))))
if LoadTriggerHandle(L7,GetHandleId(ZX7),StringHash("SuijiTetherDashController"))==t then
call RemoveSavedHandle(L7,GetHandleId(ZX7),StringHash("SuijiTetherDashController"))
endif
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call SaveInteger(L7,(GetHandleId((ZX7))),((4295)),(2))
else
call SetUnitX(ZX7,x)
call SetUnitY(ZX7,y)
endif
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function SuijiMode_TetherDebugState takes unit u,string tag,trigger eventController returns nothing
local integer casterHandle=0
local integer physicalSkill=0
local integer logCount=0
local integer baseX=-99
local integer baseY=-99
local integer stopX=-99
local integer stopY=-99
local trigger currentController=null
local trigger dashController=null
local unit target=null
if SUIJI_LOG==false or u==null or GetUnitTypeId(u)==0 then
return
endif
set casterHandle=GetHandleId(u)
set logCount=LoadInteger(L7,casterHandle,StringHash("SuijiTetherStateLogCount"))
if logCount>=30 then
return
endif
call SaveInteger(L7,casterHandle,StringHash("SuijiTetherStateLogCount"),logCount+1)
set physicalSkill=B287_GetPhysicalAbilityId(u,'A1TA')
set currentController=LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherController"))
set dashController=LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherDashController"))
set target=LoadUnitHandle(L7,casterHandle,652)
if physicalSkill!=0 and GetUnitAbilityLevel(u,physicalSkill)>0 then
set baseX=B287_MHAbility_GetCustomDataInt(u,physicalSkill,ABILITY_DEF_DATA_BUTTON_X)
set baseY=B287_MHAbility_GetCustomDataInt(u,physicalSkill,ABILITY_DEF_DATA_BUTTON_Y)
endif
if GetUnitAbilityLevel(u,'A1TU')>0 then
set stopX=MHAbility_GetCustomDataInt(u,'A1TU',ABILITY_DEF_DATA_BUTTON_X)
set stopY=MHAbility_GetCustomDataInt(u,'A1TU',ABILITY_DEF_DATA_BUTTON_Y)
endif
call SuijiTest_DebugAll(tag,"caster="+GetUnitName(u)+"#"+I2S(casterHandle)+" type="+I2S(GetUnitTypeId(u))+" order="+I2S(GetUnitCurrentOrder(u))+" physical="+I2S(physicalSkill)+" lv="+I2S(GetUnitAbilityLevel(u,physicalSkill))+"/"+I2S(GetUnitAbilityLevel(u,'A1TA'))+"/"+I2S(GetUnitAbilityLevel(u,'Y0A0'))+" stopLv="+I2S(GetUnitAbilityLevel(u,'A1TU')))
call SuijiTest_DebugAll(tag,"active="+I2S(B287_BoolToInt(LoadBoolean(L7,casterHandle,StringHash("SuijiTetherActive"))))+" replaced="+I2S(B287_BoolToInt(LoadBoolean(L7,casterHandle,StringHash("B289StateReplaceBase")+'A1TA')))+" controller="+I2S(GetHandleId(currentController))+" event="+I2S(GetHandleId(eventController))+" dash="+I2S(GetHandleId(dashController))+" target="+I2S(GetHandleId(target))+" ownerHero="+I2S(GetHandleId(M7[GetPlayerId(GetOwningPlayer(u))]))+" buttons="+I2S(baseX)+","+I2S(baseY)+"/"+I2S(stopX)+","+I2S(stopY))
set currentController=null
set dashController=null
set target=null
set u=null
set eventController=null
endfunction
function SuijiMode_TetherCleanup takes trigger t,string reason returns nothing
local integer I97=0
local integer casterHandle=0
local unit ZX7=null
local unit IH7=null
local group QTG=null
local lightning TNG=null
local trigger dashController=null
local effect dashEffect=null
local boolean restoreBase=false
if t==null then
return
endif
set I97=GetHandleId(t)
set ZX7=LoadUnitHandle(L7,I97,2)
set IH7=LoadUnitHandle(L7,I97,17)
set QTG=LoadGroupHandle(L7,I97,$85)
set TNG=LoadLightningHandle(L7,I97,$C4)
call SuijiMode_TetherDebugState(ZX7,"TETHER-CLEAN-BEFORE",t)
if QTG!=null then
call WR7(QTG)
endif
if TNG!=null then
call DestroyLightning(TNG)
endif
if IH7!=null then
call UnitRemoveAbility(IH7,'A1TH')
call UnitRemoveAbility(IH7,'A1TI')
call UnitRemoveAbility(IH7,'A1TG')
call UnitRemoveAbility(IH7,'A1TJ')
call UnitRemoveAbility(IH7,'B0DH')
call UnitRemoveAbility(IH7,'A4G1')
call RemoveSavedHandle(L7,GetHandleId(IH7),StringHash("AI|TetherSource"))
endif
if ZX7!=null then
set casterHandle=GetHandleId(ZX7)
set dashController=LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherDashController"))
if dashController!=null then
set dashEffect=LoadEffectHandle(L7,GetHandleId(dashController),32)
if dashEffect!=null then
call DestroyEffect(dashEffect)
endif
call FlushChildHashtable(L7,GetHandleId(dashController))
call OZ7(dashController)
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiTetherDashController"))
endif
call UnitRemoveAbility(ZX7,'A1TH')
call UnitRemoveAbility(ZX7,'A1TI')
call UnitRemoveAbility(ZX7,'A1TG')
call UnitRemoveAbility(ZX7,'A1TJ')
call UnitRemoveAbility(ZX7,'B0DH')
call UnitRemoveAbility(ZX7,'A1TU')
call RemoveSavedHandle(L7,casterHandle,652)
call RemoveSavedBoolean(L7,casterHandle,StringHash("SuijiTetherActive"))
if LoadTriggerHandle(L7,casterHandle,StringHash("SuijiTetherController"))==t then
call RemoveSavedHandle(L7,casterHandle,StringHash("SuijiTetherController"))
endif
call SaveInteger(L7,casterHandle,4295,2)
set restoreBase=true
if SUIJI_LOG then
call SuijiTest_DebugAll("TETHER-END","caster="+GetUnitName(ZX7)+"#"+I2S(casterHandle)+" controller="+I2S(I97)+" lightning="+I2S(GetHandleId(TNG))+" reason="+reason)
endif
endif
// Destroy the controller before restoring the command card.  If Warcraft
// terminates a visibility native, no dead periodic trigger can keep re-entering
// cleanup with already destroyed group/lightning handles.
call FlushChildHashtable(L7,I97)
call OZ7(t)
set t=null
if restoreBase then
if SUIJI_LOG then
call SuijiTest_DebugAll("TETHER-CLEAN-CORE-DONE","caster="+I2S(casterHandle)+" controller="+I2S(I97)+" active=0")
endif
call B287_SetTetherAbilityAvailable(ZX7,GetOwningPlayer(ZX7),true)
call SuijiMode_TetherDebugState(ZX7,"TETHER-CLEAN-AFTER",null)
endif
set ZX7=null
set IH7=null
set QTG=null
set TNG=null
