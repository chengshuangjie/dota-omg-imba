// 模拟移动 可突破522
function SetUnitImitateMoveSpeed takes unit u, integer I2X, integer WOV returns nothing
	local timer t = null
	local integer h
	if u == null or GetUnitTypeId(u) == 0 then
		return
	endif
	set t = LoadTimerHandle(TABLE_K, GetHandleId(u), 'MVSP')
	if t != null and LoadUnitHandle(TABLE_HY, GetHandleId(t), 0) != u then
		// Do not reuse a stale binding, or destroy a timer owned by another unit.
		call RemoveSavedHandle(TABLE_K, GetHandleId(u), 'MVSP')
		set t = null
	endif
	if t == null then
		if I2X == 0 then
			call SaveReal(TABLE_K, GetHandleId(u), 99, 0)
			call RemoveSavedBoolean(TABLE_K, GetHandleId(u), 99)
			return
		endif
		set t = CreateTimer()
		set h = GetHandleId(t)
		call SaveUnitHandle(TABLE_HY, h, 0, u)
		call SaveInteger(TABLE_HY, h, StringHash("B1116MoveOwner"), GetHandleId(u))
		call SaveReal(TABLE_HY, h, 10, GetUnitX(u))
		call SaveReal(TABLE_HY, h,$B, GetUnitY(u))
		call SaveBoolean(TABLE_HY, h, 100, false)
		call SaveTimerHandle(TABLE_K, GetHandleId(u),'MVSP', t)
	else
		set h = GetHandleId(t)
	endif
	if I2X == LoadInteger(TABLE_HY, h, 0) and WOV == LoadInteger(TABLE_HY, h, 1) then
		set t = null
		return
	endif
	call SaveInteger(TABLE_HY, h, 1, WOV)
	call SaveInteger(TABLE_HY, h, 0, I2X)
	if I2X == 0 then
		if LoadBoolean(TABLE_HY, h, 100) then
			call PauseTimer(t)
			set RRR = RRR -1
		endif
		call SaveReal(TABLE_K, GetHandleId(u), 99, 0)
		call SaveBoolean(TABLE_HY, h, 100, false)
		call RemoveSavedHandle(TABLE_K, GetHandleId(u), 'MVSP')
		call RemoveSavedBoolean(TABLE_K, GetHandleId(u), 99)
		call FlushChildHashtable(TABLE_HY, h)
		call DestroyTimer(t)
	elseif LoadBoolean(TABLE_HY, h, 100)== false then
		call TimerStart(t, YNN, true, function I1X)
		set RRR = RRR + 1
		call SaveBoolean(TABLE_HY, h, 100, true)
	endif
	set t = null
endfunction
