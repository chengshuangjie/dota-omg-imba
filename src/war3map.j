    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品7 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 7)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品8 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 8)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品9 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 9)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品10 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 10)))
    // call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000物品11 |r"+I2S(LoadInteger(TABLE_HY,'ITEM', 11)))
    if XRO==77 or XRO==119 then
        if XWO(88) then
            set XRO=XRO+1
        endif
    elseif XRO==111 then
        if XWO(189) then
            set XRO=XRO+1
        endif   
    elseif XRO==117 then
        if XWO(110) then
            set XRO=XRO+1
        endif
    elseif XRO==55 then
        if XWO(112) then
            set XRO=XRO+1
        endif
    elseif XRO==71 then
        if XWO(62) then
            set XRO=XRO+2
        endif
    elseif XRO==89 then
        if XWO(43) then
            set XRO=XRO+1
        endif
    elseif XRO==57 then
        if XWO(70) then
            set XRO=XRO+1
        endif
    elseif XRO==102 then
        if XWO(104) then
            set XRO=XRO+1
        endif
    elseif XRO==64 then
        if XWO(43) then
            set XRO=XRO+2
        endif
    elseif XRO==109 or XRO==128 or XRO==130 then
        if XWO(23) then
            set XRO=XRO+1
        endif
    endif    
    //call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000调整后XRO |r"+I2S(XRO))
    if XRO==B964WizardRecipe and XWO(F44) then
        set XRO=XRO+1
    endif
    return XRO
endfunction
function XOO takes unit KKX, integer XRO, player p returns nothing
	local integer i = 0
	local item it
	local integer k = 0
	local integer Z6X = 0
	local integer j
	local integer Z7X
	local integer Z8X
	local unit Y1X = LoadUnitHandle(TABLE_K, GetHandleId(p),'COUR')
	local integer id
	local unit d
	local real x
	local real y
	if XRO ==-1 or GetPlayerSlotState(p)== PLAYER_SLOT_STATE_LEFT then
		set it = null
		set Y1X = null
		set d = null
		return
	endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	//if Y1X == null then
	//	set Y1X = HJX(p)  //判断其他信使
	//endif
	call FlushChildHashtable(TABLE_HY,'ITEM')
	loop
		if Y1X != null then
			set it = UnitItemInSlot(Y1X, i)
			if it != null and (GetItemPlayer(it)==p or PK4) then
				call SaveItemHandle(TABLE_HY,'ITEM', k, it)
				call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
				set k = k + 1
			endif
		endif
        if KKX != Y1X then
		    set it = UnitItemInSlot(KKX, i)
		    if it != null and (GetItemPlayer(it)==p or PK4) then
			    call SaveItemHandle(TABLE_HY,'ITEM', k, it)
			    call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
			    set k = k + 1
		    endif
        endif
		if KKX != M7[GetPlayerId(p)] then
			set it = UnitItemInSlot(M7[GetPlayerId(p)], i)
			if it != null and (GetItemPlayer(it)==p or PK4) then
				call SaveItemHandle(TABLE_HY,'ITEM', k, it)
				call SaveInteger(TABLE_HY,'ITEM', k, KY7(it))
				set k = k + 1
			endif
		endif
		set i = i + 1
	exitwhen i > 5
	endloop
	set E33 = p
	set Q22 = 0
	if TV7(p) then
		call EnumItemsInRect(WAA, Condition(function E9O), function XVO)
	else
		call EnumItemsInRect(YAA, Condition(function E9O), function XVO)
	endif
	set i = Q22
	loop
	exitwhen i < 0
		if HaveSavedHandle(TABLE_VV,'ITEM', i) then
			call SaveItemHandle(TABLE_HY,'ITEM', k, LoadItemHandle(TABLE_VV,'ITEM', i))
			call SaveInteger(TABLE_HY,'ITEM', k, KY7(LoadItemHandle(TABLE_VV,'ITEM', i)))
			call RemoveSavedHandle(TABLE_VV,'ITEM', i)
			set k = k + 1
		endif
		set i = i -1
	endloop
	set it = null
	set Z6X = k
    set XRO=YJGM_EXTRA_PD(XRO)
	if QuickBuySharedRequestActive and QuickBuySharedRequestPlayerId==GetPlayerId(p) then
		set QuickBuySharedExpectedRecipe=XRO
	endif
	set k = XRO
	call SaveInteger(TABLE_HY,'ITEM', 51, FJ4[k])
	call SaveInteger(TABLE_HY,'ITEM', 52, FK4[k])
	call SaveInteger(TABLE_HY,'ITEM', 53, FM4[k])
	call SaveInteger(TABLE_HY,'ITEM', 54, FN4[k])
	call SaveInteger(TABLE_HY,'ITEM', 55, FO4[k])
	set Z8X = 0
	set Z7X = 0
	set i = 0
	if FJ4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FK4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FM4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FN4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	if FO4[k]!= 0 then
		set Z7X = Z7X + 1
	endif
	loop
		set j = LoadInteger(TABLE_HY,'ITEM', i)
		if j > 0 and LoadBoolean(TABLE_HY,'ITEM', i)== false then
			if(j == LoadInteger(TABLE_HY,'ITEM', 51) and Z2X(TABLE_HY,'ITEM', 51)) or(j == LoadInteger(TABLE_HY,'ITEM', 52) and Z2X(TABLE_HY,'ITEM', 52)) or(j == LoadInteger(TABLE_HY,'ITEM', 53) and Z2X(TABLE_HY,'ITEM', 53)) or(j == LoadInteger(TABLE_HY,'ITEM', 54) and Z2X(TABLE_HY,'ITEM', 54)) or(j == LoadInteger(TABLE_HY,'ITEM', 55) and Z2X(TABLE_HY,'ITEM', 55)) then
				call SaveItemHandle(TABLE_HY,'ITEM', 100 + Z8X, LoadItemHandle(TABLE_HY,'ITEM', i))
				call SaveBoolean(TABLE_HY,'ITEM', i, true)
				call SaveInteger(TABLE_HY,'ITEM',$C8+ Z8X, i)
				set Z8X = Z8X + 1
			endif
		endif
		set i = i + 1
	exitwhen i >= Z6X
	endloop
	if Z8X != Z7X then
		set id = LoadInteger(TABLE_HY,'ITEM', 51)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 52)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 53)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 54)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		set id = LoadInteger(TABLE_HY,'ITEM', 55)
		if id != 0 then
			if E8O(KKX, id) then
				set Z7X = Z7X + 1
			endif
		endif
		if Z8X == Z7X then
			set i = 100 
			loop
				call UnitAddItem(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1), LoadItemHandle(TABLE_HY,'ITEM', i))
				call RemoveSavedHandle(TABLE_HY,'ITEM', i)
				set i = i + 1
			exitwhen HaveSavedHandle(TABLE_HY,'ITEM', i)== false
			endloop
		endif
		set d = LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1)
		if true then
			set x = GetUnitX(d)
			set y = GetUnitY(d)
			call SetUnitX(d, GetUnitX(KKX))
			call SetUnitY(d, GetUnitY(KKX))
			if UnitAlive(KKX) and (IsUnitInRange(KKX, IZ4,2100) or IsUnitInRange(KKX, JA4,2100)) then
				call Z3X(d, KKX, true, k)
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 0), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 1), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 2), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 3), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 4), KKX)
				endif
				if YRE(KKX)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 5), KKX)
				endif
			elseif Y1X != null and UnitAlive(Y1X) and(IsUnitInRangeXY(Y1X, GetRectCenterX(WAA), GetRectCenterY(WAA),$640) or IsUnitInRangeXY(Y1X, GetRectCenterX(YAA), GetRectCenterY(YAA),$640)) then
				call SetUnitX(d, GetUnitX(Y1X))
				call SetUnitY(d, GetUnitY(Y1X))
				call Z3X(d, Y1X, true, k)
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 0), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 1), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 2), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 3), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 4), Y1X)
				endif
				if YRE(Y1X)> 0 then
					call UnitDropItemTarget(d, UnitItemInSlot(d, 5), Y1X)
				endif
			endif
			call SetUnitX(d, x)
			call SetUnitY(d, y)
		endif
		call E4O(d)
		set d = null
	endif
	call UnitRemoveAbility(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1),'AInv')
	call UnitAddAbility(LoadUnitHandle(TABLE_K, GetHandleId(GetOwningPlayer(KKX)),'COUR'+ 1),'AInv')
	set Y1X = null
	set it = null
	set d = null
endfunction
////////////////////
//不需要卷轴时XAO为false，需要卷轴时为true
function XIO takes integer id, boolean XAO returns integer
	local integer i = 0
    //call DisplayTimedTextToForce(GetPlayersAll(), 10.00, "|c00FF8000ITDM的id是|r"+I2S(id))
	loop
		if(XAO == false and FP4[i]== LoadInteger(TABLE_HY,'ITDB', id)) or(XAO and(FJ4[i]== id or FK4[i]== id or FM4[i]== id or FN4[i]== id or FO4[i]== id)) then
			return i
		endif
		set i = i + 1
	exitwhen i > FQ4
	endloop
	return -1
endfunction
function CHOUJIANG takes nothing returns nothing
local unit u=M7[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
local player p=GetOwningPlayer(u)
local integer id=GetPlayerId(p)
local item it=null
local integer zb=0
local string name=""
local integer n=0
call B1063BuildLotteryPool()
if B1063LotteryCount>0 and GetRandomInt(1,100)<=50 then
set zb=B1063LotteryPool[GetRandomInt(1,B1063LotteryCount)]
endif
if zb!=0 then
if UnitInventoryCount(u)<6 then
set it=UnitAddItemById(u,zb)
else
set it=CreateItem(zb,GetUnitX(u),GetUnitY(u))
endif
call SetItemPlayer(it,p,true)
call SetItemUserData(it,1)
set name=GetItemName(it)
set name=MHString_Sub(name,0,MHString_Find(name,"|n",0))
call DisplayTimedTextToForce(GetPlayersAll(),12.,Q[id]+KZ4[id]+"|r 抽奖获得了: |cFF00FF00"+name+"|r")
call XOMG_LogEvent("LOTTERY pid="+I2S(id)+" kind=item raw="+I2S(zb)+" min_price="+I2S(B1063LotteryMinPrice)+" pool="+I2S(B1063LotteryCount)+" ver="+XOMG_VERSION)
else
set n=GetRandomInt(1000,1500)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)+n)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(u),GetUnitY(u)))
call DisplayTimedTextToForce(GetPlayersAll(),12.,Q[id]+KZ4[id]+"|r 抽奖获得了: |cFF00FF00"+I2S(n)+"枚金币|r")
call XOMG_LogEvent("LOTTERY pid="+I2S(id)+" kind=gold amount="+I2S(n)+" pool="+I2S(B1063LotteryCount)+" ver="+XOMG_VERSION)
endif
set CHOUJIANGSTATE[id]=0
call UnitRemoveAbility(SuijiTavernB295_GetEnergyCircle(id),'A4DK')
set u=null
set p=null
set it=null
endfunction
function TpSlot_GetTravelLevel takes unit hero returns integer
local integer slot=0
local item it=null
local integer itemId=0
loop
exitwhen slot>=bj_MAX_INVENTORY
set it=UnitItemInSlot(hero,slot)
if it!=null then
set itemId=GetItemTypeId(it)
if itemId=='I0PG' then
set it=null
return 2
elseif itemId=='I06B' then
set it=null
return 1
endif
endif
set slot=slot+1
endloop
set it=null
return 0
endfunction
function TpSlot_RefreshLocal takes player p returns nothing
local integer pid=GetPlayerId(p)
local unit hero=M7[pid]
local integer travelLevel=0
if GetLocalPlayer()!=p or TpSlotIcon==0 then
set hero=null
set p=null
return
endif
if hero!=null and GetUnitTypeId(hero)!=0 then
set travelLevel=TpSlot_GetTravelLevel(hero)
endif
if travelLevel==2 then
call DzFrameSetTexture(TpSlotIcon,"ReplaceableTextures\\CommandButtons\\BTNAbilityDFX.blp",0)
elseif travelLevel==1 then
call DzFrameSetTexture(TpSlotIcon,"ReplaceableTextures\\CommandButtons\\BTNAbility_Rogue_Sprint.blp",0)
elseif TpSlotCharges[pid]>0 then
call DzFrameSetTexture(TpSlotIcon,"ReplaceableTextures\\CommandButtons\\BTNScrollUber.blp",0)
else
call DzFrameSetTexture(TpSlotIcon,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNScrollUber.blp",0)
endif
if TpSlotCooldownRemaining[pid]>0 then
call DzFrameSetText(TpSlotCountText,"|cFFFFCC00"+I2S(TpSlotCooldownRemaining[pid])+"|r")
elseif travelLevel>0 then
call DzFrameSetText(TpSlotCountText,"|cFF66FF66∞|r")
elseif TpSlotCharges[pid]>0 then
call DzFrameSetText(TpSlotCountText,I2S(TpSlotCharges[pid]))
else
call DzFrameSetText(TpSlotCountText,"0")
endif
set hero=null
set p=null
endfunction
function TpSlot_AddCharge takes player p,integer amount returns nothing
local integer pid=GetPlayerId(p)
if pid>=0 and pid<bj_MAX_PLAYERS and amount>0 and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
set TpSlotCharges[pid]=IMinBJ(999,TpSlotCharges[pid]+amount)
call TpSlot_RefreshLocal(p)
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFF66CCFF独立TP栏：|r获得 "+I2S(amount)+" 点，当前 "+I2S(TpSlotCharges[pid])+" 点。")
endif
set p=null
endfunction
function ZRF takes nothing returns nothing
local unit b1060GetSellingUnit=GetSellingUnit()
local unit u=GetSoldUnit()
local unit buyer=GetBuyingUnit()
local player p=GetOwningPlayer(u)
local integer Y68=WD7(u)
local real x
local real y
local integer id=GetUnitTypeId(u)
local integer i
local integer O5=GetPlayerId(p)
local item deleteSkillItem=null
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
//GetSoldUnit 哪个物品
//GetSellingUnit 哪个商店
if id=='h0PG' then
if M7[O5]!=null and GetUnitTypeId(M7[O5])!=0 then
set deleteSkillItem=UnitAddItemById(M7[O5],'I0ZY')
call SetItemPlayer(deleteSkillItem,p,true)
call SetItemUserData(deleteSkillItem,0)
else
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)+1000)
call DisplayTimedTextToPlayer(p,0,0,8.,"|cFFFFCC00删除技能：未找到主英雄，本次购买已退款。|r")
endif
call UnitAddAbility(u,'Aloc')
call ShowUnit(u,true)
call UnitApplyTimedLife(u,'BTLF',2)
set deleteSkillItem=null
set buyer=null
set u=null
set p=null
set b1060GetSellingUnit=null
return
endif
if ZIF(b1060GetSellingUnit,u)then
call X37(p,GetObjectName('n02G'))
if IsUnitAlly(u,Z7[0])then
set p=A7[0]
else
set p=Z7[0]
endif
set x=ZPF(b1060GetSellingUnit,u)
set y=ZQF(b1060GetSellingUnit,u)
call X0F(SU[WD7(u)],x,y,p,true,Z98(WD7(u)))
elseif id=='h0F4' then
call CHIA_JUDGMENT(p)
elseif id=='h0F5' then
call CHIBS_JUDGMENT(p)
elseif id=='h0F6' then
call CHILLX_JUDGMENT(p)
elseif id=='h0F8' or id=='h0F9' then
call Download(p)
elseif id=='h0FK' then
call CHANGE_PIFU(p,0)
elseif id=='h0FB' then
call CHANGE_PIFU(p,1)
elseif id=='h0FC' then
call CHANGE_PIFU(p,2)
elseif id=='h0FD' then
call CHANGE_PIFU(p,3)
elseif id=='h0FE' then
call CHANGE_PIFU(p,4)
elseif id=='h0FF' then
call CHANGE_PIFU(p,5)
elseif id=='h0FG' then
call CHANGE_PIFU(p,6)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
//elseif id=='h0FH' then
//call CHANGE_PIFU(p,3,1)
//elseif id=='h0FI' then
//call CHANGE_PIFU(p,3,2)
//elseif id=='h0FJ' then
//call CHANGE_PIFU(p,3,3)
elseif (id=='h02E' or id=='h08H') and GetPlayerController(p)==MAP_CONTROL_USER and buyer!=null and IsUnitType(buyer,UNIT_TYPE_HERO) then
call TpSlot_AddCharge(p,1)
else
call ZHF(p,Y38(Y68))
if ZU[Y68]==0 then
set i = XIO(Y68, false)
if i ==-1 then
call X37(p,GetObjectName('n02H'))
else
    set eH=b1060GetSellingUnit
    //call XOO(YLF(u,0), i, p)  //没有卷轴的直接购买成品
    call XOO(M7[GetPlayerId(p)], i, p)
endif
else
set x=ZMF(b1060GetSellingUnit,u)
set y=ZOF(b1060GetSellingUnit,u)
if Y68==CC then
call Y0F(p,u,b1060GetSellingUnit,Y38(Y68),x,y,2,0)
else
call Y0F(p,u,b1060GetSellingUnit,Y38(Y68),x,y,0,0)
endif
endif
endif
call UnitAddAbility(u,'Aloc')
call ShowUnit(u,true)
call UnitApplyTimedLife(u,'BTLF',2)
if ZU[Y68]!= 0 then
	if IsUnitType(M7[GetPlayerId(p)],UNIT_TYPE_RANGED_ATTACKER) then
	if Y68==BA then
		set Y68=GB
	elseif Y68==E_4 then
		set Y68=F44
	elseif Y68==EZ then
		set Y68=HZ
	endif
	endif
    if Y68==XZ then
        set Y68=IA
    endif
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		// call SaveInteger(TABLE_P,'ITEM', GetPlayerId(p), ZU[Y68])
		// call SaveReal(TABLE_P,'ITEM', GetPlayerId(p), GetGameTime())
		call Record_Buy_Item(p,O5,Y68)
endif
if QuickBuySharedRequestActive and QuickBuySharedRequestPlayerId==O5 and QuickBuySharedRequestItemUnitId==id and WD7(u)>=0 and ZU[WD7(u)]!=0 and CU[WD7(u)]!="ReplaceableTextures\\CommandButtons\\BTNSnazzyScroll.blp" then
set QuickBuySharedCompleted=true
endif
set buyer=null
set u=null
set p=null
set b1060GetSellingUnit=null
endfunction
function ZSF takes nothing returns boolean
local unit b1060GetSoldUnit=GetSoldUnit()
local boolean b1060ReturnValue
if VI4==false then
if GetUnitPointValue(b1060GetSoldUnit)>=$C8 then
call ZRF()
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(b1060GetSoldUnit))or(V8 and(GetLocalPlayer()==KX4 or GetLocalPlayer()==KY4))then
if GetUnitTypeId(b1060GetSoldUnit)=='h076' then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0KO')+"|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h02C' or GetUnitTypeId(b1060GetSoldUnit)=='h08P' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0KP')+"|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h02D' or GetUnitTypeId(b1060GetSoldUnit)=='h08Q' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0KQ')+"|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h0BA' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0KT')+"|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h0G4' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+(KZ4[GetPlayerId((GetOwningPlayer(b1060GetSoldUnit)))])+"|r |c00ffff00购买了魂之灵龛|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h01G' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0LB')+"|r")
elseif GetUnitTypeId(b1060GetSoldUnit)=='h0D3' or GetUnitTypeId(b1060GetSoldUnit)=='h08R' then
call PingMinimapEx(GetUnitX(b1060GetSoldUnit),GetUnitY(b1060GetSoldUnit),3,$FF,$FF,$FF,false)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4,Q[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+KZ4[GetPlayerId(GetOwningPlayer(b1060GetSoldUnit))]+"|r |c00ffff00"+GetObjectName('n0LP')+"|r")
endif
endif
else
call YXF()
endif
endif
set b1060ReturnValue=false
set b1060GetSoldUnit=null
return b1060ReturnValue
endfunction
function ZTF takes unit u returns boolean
local integer id=GetUnitTypeId(u)
return id=='Eevm' or id=='E02V' or id=='E02W' or id=='E02U'
endfunction
