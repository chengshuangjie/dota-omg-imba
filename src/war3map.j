function SetUp_SyncData takes nothing returns boolean
	local string s = DzGetTriggerSyncData()
    local integer data = S2I(s)
    local player p = DzGetTriggerSyncPlayer()
	local integer id = GetPlayerId(p)
	local boolean b
	if data == 3 then
		set DISZDGJ[id] = not DISZDGJ[id]
        if M7[id]!=null then
            call Disable_Unit_Auto_Attack(M7[id],DISZDGJ[id])
        endif
	elseif data == 4 then
		set ab[id] = not ab[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("多面板显示装备", ab[id])
		endif
	elseif data == 5 then
		set Ab[id] = not Ab[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("自动选择召唤物", Ab[id])
		endif
	elseif data == 6 then
		set TPFZ[id] = not TPFZ[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("TP时防右键打断", TPFZ[id])
		endif
	elseif data == 7 then
		set b = not OO7(GetHandleId(p),"DisableHelp")
        call NS7(GetHandleId(p),"DisableHelp",b)
		if GetLocalPlayer() == p then
			call GetSetUpText("拒绝友方帮助技能", b)
		endif
	elseif data == 8 then
		set CW[id] = not CW[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("关闭特殊音效", not CW[id])
		endif
    elseif data == 9 then
		if TEXTDUR[id]== 1. then
			set TEXTDUR[id]= 8.
		else
			set TEXTDUR[id]= 1.
		endif
		if GetLocalPlayer() == p then
			call GetSetUpText("快速清理击杀信息", TEXTDUR[id]== 1.)
		endif
	elseif data == 10 then
        set OL3[id] = not OL3[id]
		if GetLocalPlayer() == p then
			call GetSetUpText("信使复活计时窗口", OL3[id])
		endif
	elseif data == 11 then
		set OL4[id] = not OL4[id]
        if GetLocalPlayer() == p then
		    call GetSetUpText("英雄复活计时窗口", OL4[id])
        endif
    elseif data == 19 then
		set TXXS[id] = not TXXS[id]
        call Set_Player_TXXS(p,TXXS[id])
        if GetLocalPlayer() == p then
		    call GetSetUpText("开启队友头像显示", TXXS[id])
        endif
	endif
    set p = null
    return false
endfunction
//======================================================================
// 本地预购栏。队列和界面只属于本地玩家；扣钱和购买只在 DzSyncData 回调中执行。
// 商店仍通过原生 IssueNeutralImmediateOrderById 购买，因此保留距离、库存、价格和原有合成处理。
//======================================================================
function QuickBuy_FindItemIndex takes integer itemUnitId returns integer
    local integer i=0
    loop
        exitwhen i>EV
        if itemUnitId!=0 and AU[i]==itemUnitId then
            return i
        endif
        set i=i+1
    endloop
    return -1
endfunction
function QuickBuy_IsSupportedItemUnit takes integer itemUnitId returns boolean
    return QuickBuy_FindItemIndex(itemUnitId)>=0 or itemUnitId=='h0F4' or itemUnitId=='h0F5' or itemUnitId=='h0F6'
endfunction
function QuickBuy_IsRecipeIndex takes integer itemIndex returns boolean
    return itemIndex>=0 and ZU[itemIndex]!=0 and CU[itemIndex]=="ReplaceableTextures\\CommandButtons\\BTNSnazzyScroll.blp"
endfunction
function QuickBuy_ItemName takes integer itemUnitId returns string
    local string name=GetObjectName(itemUnitId)
    local integer pos=MHString_Find(name,"|n",0)
    if pos>0 then
        return MHString_Sub(name,0,pos)
    endif
    return name
endfunction
function QuickBuy_ParseField takes string data,integer field returns integer
    local integer start=0
    local integer pos=0
    local integer i=0
    loop
        exitwhen i>=field
        set pos=MHString_Find(data,",",start)
        if pos<0 then
            return 0
        endif
        set start=pos+1
        set i=i+1
    endloop
    set pos=MHString_Find(data,",",start)
    if pos<0 then
        set pos=StringLength(data)
    endif
    return S2I(SubString(data,start,pos))
endfunction
function TpSlot_ParseField takes string data,integer field returns integer
local integer start=0
local integer pos=0
local integer current=0
local integer length=StringLength(data)
loop
exitwhen pos>=length
if SubString(data,pos,pos+1)=="," then
if current==field then
return S2I(SubString(data,start,pos))
endif
set current=current+1
set start=pos+1
endif
set pos=pos+1
endloop
if current==field then
return S2I(SubString(data,start,length))
endif
return 0
endfunction
function UnifiedOrbToggle_RefreshLocal takes player orbTogglePlayer returns nothing
local integer orbTogglePlayerId=GetPlayerId(orbTogglePlayer)
if GetLocalPlayer()!=orbTogglePlayer or UnifiedOrbToggleIcon==0 then
set orbTogglePlayer=null
return
endif
if UnifiedOrbMasterDisabled[orbTogglePlayerId] then
call DzFrameSetTexture(UnifiedOrbToggleIcon,"ReplaceableTextures\\CommandButtonsDisabled\\DISBTNOrbOfVenom.blp",0)
call DzFrameSetText(UnifiedOrbToggleStateText,"|cFFFF5555关|r")
else
call DzFrameSetTexture(UnifiedOrbToggleIcon,"ReplaceableTextures\\CommandButtons\\BTNOrbOfVenom.blp",0)
call DzFrameSetText(UnifiedOrbToggleStateText,"|cFF66FF66开|r")
endif
set orbTogglePlayer=null
endfunction
function TpSlot_TargetFilter takes nothing returns boolean
local unit u=GetFilterUnit()
local real distance
if u!=null and u!=TpSlotFilterCaster and GetUnitTypeId(u)!=0 and GetWidgetLife(u)>.405 and IsUnitAlly(u,TpSlotFilterPlayer) and not IsUnitIllusion(u) and GetUnitAbilityLevel(u,'Aloc')==0 and GetUnitAbilityLevel(u,'Asud')==0 and GetUnitAbilityLevel(u,'Asel')==0 and not IsUnitType(u,UNIT_TYPE_FLYING) and (TpSlotFilterMode==3 or not IsUnitType(u,UNIT_TYPE_HERO)) then
set distance=KF7(TpSlotFilterX,TpSlotFilterY,GetUnitX(u),GetUnitY(u))
if distance<TpSlotFilterDistance then
set TpSlotFilterDistance=distance
set TpSlotFilterBest=u
endif
endif
set u=null
return false
endfunction
function TpSlot_FindTravelTarget takes unit hero,real x,real y,integer mode returns unit
local group g=CreateGroup()
local boolexpr filter=Condition(function TpSlot_TargetFilter)
set TpSlotFilterPlayer=GetOwningPlayer(hero)
set TpSlotFilterCaster=hero
set TpSlotFilterBest=null
set TpSlotFilterMode=mode
set TpSlotFilterX=x
set TpSlotFilterY=y
set TpSlotFilterDistance=999999.
// Travel Boots follow the original map rule: the selected point chooses the
// nearest legal allied unit on the map, rather than requiring one within 350.
call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,filter)
call DestroyBoolExpr(filter)
call DestroyGroup(g)
set filter=null
set g=null
set hero=null
return TpSlotFilterBest
endfunction
function B957Ready takes unit u957 returns boolean
return u957!=null and GetUnitTypeId(u957)!=0 and UnitAlive(u957) and not IsUnitIllusion(u957) and GetUnitLifePercent(u957)>=65. and (GetUnitState(u957,UNIT_STATE_MAX_MANA)<1. or GetUnitManaPercent(u957)>=25.)
endfunction
function B957Notice takes unit u957,string text957 returns nothing
if B946DetectEnabled[GetPlayerId(GetLocalPlayer())] and IsUnitSelected(u957,GetLocalPlayer()) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,8.,"|cffffcc80[detect 集合 B968]|r "+GetUnitName(u957)+" "+text957)
endif
endfunction
function B976HasPendingAlly takes unit hero976 returns boolean
local integer index976=1
local unit pending976=null
loop
exitwhen index976>NP4
set pending976=NM4[index976]
if NN4[index976]>0. and pending976!=null and GetUnitTypeId(pending976)!=0 and not UnitAlive(pending976) and pending976==M7[GetPlayerId(GetOwningPlayer(pending976))] and IsUnitAlly(pending976,GetOwningPlayer(hero976)) then
set pending976=null
return true
endif
set index976=index976+1
endloop
// Script-owned reincarnation can temporarily be outside the normal countdown queue.
set index976=0
loop
exitwhen index976>=12
set pending976=M7[index976]
if pending976!=null and GetUnitTypeId(pending976)!=0 and not UnitAlive(pending976) and IsUnitAlly(pending976,GetOwningPlayer(hero976)) then
if OO7(GetHandleId(pending976),"SuijiRevivalPending") or OO7(GetHandleId(pending976),"B834ReincarnationPending") or OT7(pending976,"chongsheng") then
set pending976=null
return true
endif
endif
set index976=index976+1
endloop
set pending976=null
return false
endfunction
function B977BaseUnderAttack takes unit hero977 returns boolean
local integer side977=0
if not IsUnitAlly(hero977,Z7[0]) then
set side977=1
endif
return B977BaseThreatUntil[side977]>TimerGetElapsed(W)
endfunction
function B976ResumeAI takes unit hero976 returns nothing
local integer player976=GetPlayerId(GetOwningPlayer(hero976))
// Release the order gate before asking the original AI to choose its route.
set B957State[player976]=0
set B957Until[player976]=0.
set B957Next[player976]=0.
set B957Retry[player976]=0.
call UQ7("B976ResumeAI",hero976)
call J3(hero976,true)
if B946DetectCount>0 then
if B977BaseUnderAttack(hero976) then
set B961Reason[player976]="高地建筑受袭：解除集合，常规AI接管防守"
call B957Notice(hero976,"高地塔、兵营或基地受袭：停止等待复活，交回常规AI防守")
else
set B961Reason[player976]="无人待复活：交回常规AI"
call B957Notice(hero976,"同阵营已无人等待复活：解除集合，交回常规AI")
endif
endif
endfunction
function B957OnRevive takes nothing returns nothing
local unit u957=B957Revived
local unit home957=null
local unit lane957=null
local integer p957=0
local real angle957=0.
set B957Revived=null
if u957!=null then
set p957=GetPlayerId(GetOwningPlayer(u957))
if p957<12 and u957==M7[p957] and GetPlayerController(GetOwningPlayer(u957))==MAP_CONTROL_COMPUTER and not IsUnitIllusion(u957) and not OO7(GetHandleId(u957),"B834ReincarnationPending") then
set B957Known[p957]=u957
set B957Dead[p957]=false
if B977BaseUnderAttack(u957) or not B976HasPendingAlly(u957) then
call B976ResumeAI(u957)
set u957=null
return
endif
set home957=NF7(u957)
if home957!=null and KE7(u957,home957)<2500. then
set lane957=h7[1]
if not IsUnitAlly(u957,Z7[0]) then
set lane957=h7[101]
endif
set angle957=Atan2(GetUnitY(lane957)-GetUnitY(home957),GetUnitX(lane957)-GetUnitX(home957))
set B957X[p957]=GetUnitX(home957)+900.*Cos(angle957)
set B957Y[p957]=GetUnitY(home957)+900.*Sin(angle957)
if IsTerrainPathable(B957X[p957],B957Y[p957],PATHING_TYPE_WALKABILITY) then
set B957X[p957]=GetUnitX(home957)
set B957Y[p957]=GetUnitY(home957)
endif
set B957Known[p957]=u957
set B957State[p957]=1
set B957Until[p957]=TimerGetElapsed(W)+12.
set B957Next[p957]=0.
set B957Retry[p957]=0.
if B946DetectCount>0 then
set B961Reason[p957]="复活等待队伍"
endif
set B957Dead[p957]=false
if B946DetectCount>0 then
call B957Notice(u957,"复活集合：最多等待12秒，3名可战英雄到场后出击")
endif
endif
endif
endif
set home957=null
set lane957=null
set u957=null
endfunction
function B957Count takes unit u957,real x957,real y957,real radius957,boolean enemy957 returns integer
local integer i957=0
local integer count957=0
local unit v957=null
loop
exitwhen i957>=12
set v957=M7[i957]
if v957!=null and GetUnitTypeId(v957)!=0 and UnitAlive(v957) and not IsUnitIllusion(v957) and (enemy957 or B957Ready(v957)) then
if IsUnitEnemy(v957,GetOwningPlayer(u957))==enemy957 and (not enemy957 or IsUnitVisible(v957,GetOwningPlayer(u957))) and KF7(GetUnitX(v957),GetUnitY(v957),x957,y957)<=radius957 then
set count957=count957+1
endif
endif
set i957=i957+1
endloop
set v957=null
return count957
endfunction
function B957Soon takes unit u957 returns boolean
local integer i957=1
local real left957=0.
loop
exitwhen i957>NP4
if NM4[i957]!=null and not UnitAlive(NM4[i957]) and NM4[i957]==M7[GetPlayerId(GetOwningPlayer(NM4[i957]))] and IsUnitAlly(NM4[i957],GetOwningPlayer(u957)) then
set left957=NN4[i957]-KQ7()
if left957>0. and left957<=8. then
return true
endif
endif
set i957=i957+1
endloop
return false
endfunction
function B957Front takes unit u957 returns unit
local integer i957=0
local unit v957=null
local unit best957=null
local unit home957=NF7(u957)
local real distance957=999999.
local real d957=0.
loop
exitwhen i957>=12
set v957=M7[i957]
if v957!=u957 and B957Ready(v957) and IsUnitAlly(v957,GetOwningPlayer(u957)) and B957State[i957]!=1 and B957State[i957]!=2 and B957State[i957]!=3 then
set d957=KE7(v957,home957)
if d957>3000. and d957<distance957 and B957Count(u957,GetUnitX(v957),GetUnitY(v957),1200.,false)>=2 and B957Count(u957,GetUnitX(v957),GetUnitY(v957),1600.,true)<3 then
set best957=v957
set distance957=d957
endif
endif
set i957=i957+1
endloop
set v957=null
set home957=null
return best957
endfunction
function B957Threat takes unit u957,real x957,real y957 returns unit
local unit v957=null
local unit best957=null
local real distance957=1900.
local real d957=0.
call GroupEnumUnitsInRange(B957Scan,x957,y957,1900.,null)
loop
set v957=FirstOfGroup(B957Scan)
exitwhen v957==null
call GroupRemoveUnit(B957Scan,v957)
if GetUnitTypeId(v957)!=0 and UnitAlive(v957) and IsUnitEnemy(v957,GetOwningPlayer(u957)) and IsUnitVisible(v957,GetOwningPlayer(u957)) and GetUnitAbilityLevel(v957,'Aloc')==0 and GetUnitAbilityLevel(v957,'Avul')==0 then
set d957=KF7(GetUnitX(v957),GetUnitY(v957),x957,y957)
if d957<distance957 then
set best957=v957
set distance957=d957
endif
endif
endloop
set v957=null
return best957
endfunction
function B957TryTP takes unit u957,unit front957 returns boolean
local integer p957=GetPlayerId(GetOwningPlayer(u957))
local item item957=null
local unit landing957=null
local boolean result957=false
set B957Retry[p957]=TimerGetElapsed(W)+5.
if GetUnitState(u957,UNIT_STATE_MANA)<75. or IsUnitPaused(u957) or IsUnitType(u957,UNIT_TYPE_STUNNED) or IsUnitType(u957,UNIT_TYPE_POLYMORPHED) then
if B946DetectCount>0 then
set B961Reason[p957]="TP受限：需要75蓝且未被控制"
endif
return false
endif
set item957=MV7(u957,ZU[FF6])
if item957!=null then
set landing957=TpSlot_FindTravelTarget(u957,GetUnitX(front957),GetUnitY(front957),3)
else
set item957=MV7(u957,ZU[F6])
if item957!=null then
set landing957=TpSlot_FindTravelTarget(u957,GetUnitX(front957),GetUnitY(front957),2)
else
set item957=MV7(u957,ZU[YC])
if item957!=null then
set landing957=BCF(u957,GetUnitX(front957),GetUnitY(front957))
endif
endif
endif
if item957!=null and landing957!=null and GetUnitTypeId(landing957)!=0 and UnitAlive(landing957) and IsUnitAlly(landing957,GetOwningPlayer(u957)) and KE7(landing957,front957)<=1600. and B957Count(u957,GetUnitX(landing957),GetUnitY(landing957),1000.,true)==0 then
set B957State[p957]=3
set B957Until[p957]=TimerGetElapsed(W)+24.
set B957JoinX[p957]=GetUnitX(landing957)
set B957JoinY[p957]=GetUnitY(landing957)
set result957=UnitUseItemPoint(u957,item957,GetUnitX(landing957),GetUnitY(landing957))
if result957 then
if B946DetectCount>0 then
set B961Reason[p957]="TP请求已接受，等待落地"
endif
if B946DetectCount>0 then
call B957Notice(u957,"前方已有至少2名队友：使用现有TP物品增援")
endif
else
// Scripted TP may complete after the native request reports false.
set B957Until[p957]=TimerGetElapsed(W)+5.
if B946DetectCount>0 then
set B961Reason[p957]="TP请求未确认，最多观察5秒；施法中继续保护"
endif
if B946DetectCount>0 then
call B957Notice(u957,B961Reason[p957])
endif
endif
elseif item957==null then
if B946DetectCount>0 then
set B961Reason[p957]="缺少背包TP物品：回城卷轴或飞鞋"
endif
elseif landing957==null then
if B946DetectCount>0 then
set B961Reason[p957]="未找到合法TP落点"
endif
elseif GetUnitTypeId(landing957)==0 or not UnitAlive(landing957) or not IsUnitAlly(landing957,GetOwningPlayer(u957)) then
if B946DetectCount>0 then
set B961Reason[p957]="TP落点已失效"
endif
elseif KE7(landing957,front957)>1600. then
if B946DetectCount>0 then
set B961Reason[p957]="TP落点距前线队友超过1600"
endif
else
if B946DetectCount>0 then
set B961Reason[p957]="TP落点1000范围内有可见敌方英雄"
endif
endif
set item957=null
set landing957=null
return result957
endfunction
function B957Release takes unit leader957 returns nothing
local integer i957=0
local integer p957=GetPlayerId(GetOwningPlayer(leader957))
local unit v957=null
local real x957=GetUnitX(h7[15])
local real y957=GetUnitY(h7[15])
loop
exitwhen i957>=12
set v957=M7[i957]
if B957Ready(v957) and IsUnitAlly(v957,GetOwningPlayer(leader957)) and (B957State[i957]==1 or B957State[i957]==2) and KF7(GetUnitX(v957),GetUnitY(v957),B957X[p957],B957Y[p957])<=1200. then
set B957State[i957]=4
set B957Until[i957]=TimerGetElapsed(W)+8.
set B957X[i957]=x957
set B957Y[i957]=y957
set B957Next[i957]=0.
if B946DetectCount>0 then
call B957Notice(v957,"集合完成：共同目标保持8秒")
endif
endif
set i957=i957+1
endloop
set v957=null
endfunction
function B961Status takes unit u961,boolean channel961 returns nothing
local integer p961=GetPlayerId(GetOwningPlayer(u961))
local integer i961=0
local integer frontCount961=0
local integer cluster961=0
local integer count961=0
local unit v961=null
local unit home961=null
local unit front961=null
local string reason961=B961Reason[p961]
if B946DetectCount==0 or TimerGetElapsed(W)<B961Next[p961] then
return
endif
if B946DetectCount>0 then
set B961Next[p961]=TimerGetElapsed(W)+4.
endif
set home961=NF7(u961)
set front961=B957Front(u961)
loop
exitwhen i961>=12
set v961=M7[i961]
if v961!=null and v961!=u961 and GetUnitTypeId(v961)!=0 and UnitAlive(v961) and not IsUnitIllusion(v961) and IsUnitAlly(v961,GetOwningPlayer(u961)) and KE7(v961,home961)>3000. then
set frontCount961=frontCount961+1
set count961=B957Count(u961,GetUnitX(v961),GetUnitY(v961),1200.,false)
if count961>cluster961 then
set cluster961=count961
endif
endif
set i961=i961+1
endloop
if B957State[p961]==0 then
set reason961="常规AI接管（未被集合控制器锁住）"
elseif channel961 then
set reason961="施法保护中，暂不移动或重试"
elseif B957State[p961]==4 then
set reason961="已出发：维持共同目标"
endif
if B946DetectCount>0 then
call B957Notice(u961,"集合状态="+I2S(B957State[p961])+" "+reason961+"\n    生命="+R2S(GetUnitLifePercent(u961))+"% 魔法="+R2S(GetUnitManaPercent(u961))+"% 当前蓝="+R2S(GetUnitState(u961,UNIT_STATE_MANA))+"\n    前线存活队友="+I2S(frontCount961)+" 最大1200可战队伍="+I2S(cluster961)+" 选定队友="+B960Node(front961)+"\n    当前时间="+R2S(TimerGetElapsed(W))+" 等待截止="+R2S(B957Until[p961])+" 重试时刻="+R2S(B957Retry[p961]))
endif
set v961=null
set home961=null
set front961=null
endfunction
function B957Pulse takes nothing returns nothing
local integer p957=0
local unit u957=null
local unit home957=null
local unit front957=null
local unit threat957=null
local real now957=TimerGetElapsed(W)
local integer state957=0
local boolean channel961=false
loop
exitwhen p957>=12
set u957=M7[p957]
if u957!=B957Known[p957] then
set B957Known[p957]=u957
set B957Dead[p957]=false
set B957State[p957]=0
endif
if u957!=null and GetUnitTypeId(u957)!=0 and GetPlayerController(GetOwningPlayer(u957))==MAP_CONTROL_COMPUTER and not IsUnitIllusion(u957) then
if not UnitAlive(u957) then
set B957Dead[p957]=true
set B957State[p957]=0
else
if B957Dead[p957] then
set B957Dead[p957]=false
set B957Revived=u957
call B957OnRevive()
endif
set state957=B957State[p957]
set channel961=false
if state957>0 then
set channel961=B835AIChannelBlocked(u957)
endif
if state957>0 and not channel961 then
set home957=NF7(u957)
if (state957==1 or state957==2) and (B977BaseUnderAttack(u957) or not B976HasPendingAlly(u957)) then
call B976ResumeAI(u957)
elseif (state957==1 or state957==2) and home957!=null and KE7(u957,home957)>=2500. then
set B957State[p957]=0
if B946DetectCount>0 then
call B957Notice(u957,"已离开基地：解除泉水集合，交回常规AI")
endif
elseif state957==3 then
if KF7(GetUnitX(u957),GetUnitY(u957),B957JoinX[p957],B957JoinY[p957])<1200. then
set B957State[p957]=0
call UQ7("B957Pulse @ war3map.j:223388 (B968)",u957)
call J3(u957,true)
if B946DetectCount>0 then
call B957Notice(u957,"TP到达：刷新路线并立即加入战斗")
endif
elseif now957>=B957Until[p957] then
if home957!=null and KE7(u957,home957)>=2500. then
set B957State[p957]=0
if B946DetectCount>0 then
call B957Notice(u957,"TP等待结束且已离开基地：交回常规AI")
endif
else
set B957State[p957]=2
if B946DetectCount>0 then
call B957Notice(u957,"TP未到达：转安全防守并重试")
endif
endif
endif
elseif state957==4 then
if now957>=B957Until[p957] then
set B957State[p957]=0
if B946DetectCount>0 then
call B957Notice(u957,"编队出击结束：交回常规AI")
endif
endif
else
set threat957=B957Threat(u957,B957X[p957],B957Y[p957])
if threat957!=null then
if B946DetectCount>0 then
set B961Reason[p957]="集合点附近有敌人：优先防守"
endif
if now957>=B957Next[p957] then
set B957OrderOwner=u957
call B947IssueTargetOrderById("B957Pulse @ war3map.j:223421 (B968)",u957,851983,threat957)
set B957OrderOwner=null
set B957Next[p957]=now957+2.
endif
else
set front957=B957Front(u957)
if front957!=null then
if not B957Ready(u957) then
if B946DetectCount>0 then
set B961Reason[p957]="自身未就绪：需要65%生命、25%魔法"
endif
elseif now957>=B957Retry[p957] then
call B957TryTP(u957,front957)
endif
elseif B957Ready(u957) and B957Count(u957,B957X[p957],B957Y[p957],1200.,false)>=3 and (now957>=B957Until[p957] or not B957Soon(u957)) then
call B957Release(u957)
else
if B946DetectCount>0 then
set B961Reason[p957]="未识别成形前线队伍，基地人数不足或仍等复活"
endif
endif
endif
if B957State[p957]==1 and now957>=B957Until[p957] then
set B957State[p957]=2
if B946DetectCount>0 then
call B957Notice(u957,"等待已满12秒：就近防守清兵，继续寻找队伍")
endif
endif
endif
set state957=B957State[p957]
if state957!=3 and state957>0 and now957>=B957Next[p957] then
set B957OrderOwner=u957
if state957==4 then
call B947IssuePointOrderById("B957Pulse @ war3map.j:223454 (B968)",u957,851983,B957X[p957],B957Y[p957])
elseif KF7(GetUnitX(u957),GetUnitY(u957),B957X[p957],B957Y[p957])>350. then
call B947IssuePointOrderById("B957Pulse @ war3map.j:223456 (B968)",u957,851986,B957X[p957],B957Y[p957])
elseif GetUnitCurrentOrder(u957)!=851983 and GetUnitCurrentOrder(u957)!=851993 then
call B947IssueImmediateOrderById("B957Pulse @ war3map.j:223458 (B968)",u957,851993)
endif
set B957OrderOwner=null
set B957Next[p957]=now957+2.
endif
endif
if B946DetectCount>0 then
call B961Status(u957,channel961)
endif
endif
else
set B957State[p957]=0
endif
set p957=p957+1
endloop
set u957=null
set home957=null
set front957=null
set threat957=null
endfunction
function B977BaseAttackEvent takes nothing returns boolean
local unit building977=GetTriggerUnit()
local unit attacker977=null
local integer side977=0
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamage()<=0. then
set building977=null
return false
endif
set attacker977=GetEventDamageSource()
else
set attacker977=GetAttacker()
endif
if attacker977!=null and IsUnitEnemy(attacker977,GetOwningPlayer(building977)) then
if IsUnitAlly(building977,A7[0]) then
set side977=1
endif
// Shared event-only alarm; the existing pulse releases waiters outside damage dispatch.
set B977BaseThreatUntil[side977]=TimerGetElapsed(W)+12.
endif
set building977=null
set attacker977=null
return false
endfunction
function B977WatchBaseBuilding takes trigger alarm977,unit building977 returns nothing
if building977!=null then
call TriggerRegisterUnitEvent(alarm977,building977,EVENT_UNIT_ATTACKED)
call B1023RegisterDamage(alarm977,building977)
endif
endfunction
function B957Init takes nothing returns nothing
local timer pulse957=CreateTimer()
local trigger alarm977=CreateTrigger()
call B977WatchBaseBuilding(alarm977,JW_3ST)
call B977WatchBaseBuilding(alarm977,JW_3ZT)
call B977WatchBaseBuilding(alarm977,JW_3XT)
call B977WatchBaseBuilding(alarm977,JW_4LT)
call B977WatchBaseBuilding(alarm977,JW_4RT)
call B977WatchBaseBuilding(alarm977,JW_JD)
call B977WatchBaseBuilding(alarm977,JS4)
call B977WatchBaseBuilding(alarm977,JT4)
call B977WatchBaseBuilding(alarm977,JU4)
call B977WatchBaseBuilding(alarm977,JV4)
call B977WatchBaseBuilding(alarm977,JW4)
call B977WatchBaseBuilding(alarm977,JX4)
call B977WatchBaseBuilding(alarm977,TZ_3ST)
call B977WatchBaseBuilding(alarm977,TZ_3ZT)
call B977WatchBaseBuilding(alarm977,TZ_3XT)
call B977WatchBaseBuilding(alarm977,TZ_4LT)
call B977WatchBaseBuilding(alarm977,TZ_4RT)
call B977WatchBaseBuilding(alarm977,TZ_JD)
call B977WatchBaseBuilding(alarm977,KD4)
call B977WatchBaseBuilding(alarm977,KE4)
call B977WatchBaseBuilding(alarm977,KF4)
call B977WatchBaseBuilding(alarm977,KG4)
call B977WatchBaseBuilding(alarm977,KH4)
call B977WatchBaseBuilding(alarm977,KI4)
call TriggerAddCondition(alarm977,Condition(function B977BaseAttackEvent))
set alarm977=null
set B957Scan=CreateGroup()
call TimerStart(pulse957,.5,true,function B957Pulse)
set pulse957=null
endfunction


function TpSlot_ExpireRequest takes integer tp1120Player returns nothing
local unit tp1120Hero=TpSlotCastRequestUnit[tp1120Player]
local integer tp1120Serial=TpSlotCastRequestSerial[tp1120Player]
local boolean tp1120Stopped=false
if TpSlotCancelledRequestUnit[tp1120Player]!=null and (TpSlotCancelledRequestUnit[tp1120Player]!=M7[tp1120Player] or GetUnitTypeId(TpSlotCancelledRequestUnit[tp1120Player])==0 or not UnitAlive(TpSlotCancelledRequestUnit[tp1120Player])) then
set TpSlotCancelledRequestUnit[tp1120Player]=null
endif
// ISSUED only proves dispatch, not acceptance. Observe the settled order/state
// from this later periodic callback before releasing a cancellation quarantine.
if TpSlotCancelledRequestUnit[tp1120Player]!=null and GetUnitCurrentOrder(TpSlotCancelledRequestUnit[tp1120Player])!=852122 and not B1120ControlBlocked(TpSlotCancelledRequestUnit[tp1120Player]) then
set TpSlotCancelledRequestUnit[tp1120Player]=null
endif
if tp1120Serial!=0 then
if tp1120Hero==null or tp1120Hero!=M7[tp1120Player] or GetUnitTypeId(tp1120Hero)==0 or not UnitAlive(tp1120Hero) then
call TpSlot_ClearRequest(tp1120Player)
elseif TimerGetElapsed(W)>=TpSlotCastRequestUntil[tp1120Player] and TpSlotSubmittingSerial[tp1120Player]==0 then
call B1120OrderTrace(tp1120Hero,'A4T0',852122,"tp-expire req="+I2S(tp1120Serial))
call TpSlot_ClearRequest(tp1120Player)
if GetUnitCurrentOrder(tp1120Hero)==852122 then
set TpSlotSubmittingSerial[tp1120Player]=tp1120Serial
set tp1120Stopped=B947IssueImmediateOrderById("TpSlot_ExpireRequest B1120",tp1120Hero,851972)
if not tp1120Stopped or GetUnitCurrentOrder(tp1120Hero)==852122 then
set TpSlotCancelledRequestUnit[tp1120Player]=tp1120Hero
endif
set TpSlotSubmittingSerial[tp1120Player]=0
call SaveReal(L7,GetHandleId(tp1120Hero),StringHash("B1120TPSettledAt"),TimerGetElapsed(W)+.05)
endif
endif
endif
set tp1120Hero=null
endfunction
function TpSlot_OnSync takes nothing returns nothing
local player p=DzGetTriggerSyncPlayer()
local integer pid=GetPlayerId(p)
local string data=DzGetTriggerSyncData()
local integer serial=TpSlot_ParseField(data,0)
local real x=I2R(TpSlot_ParseField(data,1))/10.
local real y=I2R(TpSlot_ParseField(data,2))/10.
local integer directFountain=TpSlot_ParseField(data,3)
local unit hero=M7[pid]
local unit target=null
local integer mode=0
local boolean success=false
local string errorText="|cFFFFCC00独立TP施放失败。|r"
if pid>=0 and pid<bj_MAX_PLAYERS and serial>TpSlotSharedLastSerial[pid] and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
set TpSlotSharedLastSerial[pid]=serial
if TpSlotCastRequestSerial[pid]!=0 and TpSlotCastRequestUnit[pid]!=hero then
call TpSlot_ClearRequest(pid)
endif
if TpSlotCancelledRequestUnit[pid]!=null and TpSlotCancelledRequestUnit[pid]!=hero then
set TpSlotCancelledRequestUnit[pid]=null
endif
// A rejected duplicate must not clear the target owned by a pending request.
// Inventory TP/Travel controllers participate too: a new farsight must never
// force the old controller's PauseUnit cleanup inside its own order stack.
if TpSlotSubmittingSerial[pid]!=0 or TpSlotCastRequestSerial[pid]!=0 or TpSlotCancelledRequestUnit[pid]==hero and hero!=null or TpSlotChannelActive[pid] or TpSlot_ControllerBusy(hero) then
call B1120OrderTrace(hero,'A4T0',852122,"tp-busy req="+I2S(serial)+" owner="+I2S(TpSlotCastRequestSerial[pid]))
call DisplayTimedTextToPlayer(p,0,0,4.,"|cFFFFCC00请等待当前传送结束；未完成的请求可先移动或停止取消后重试。|r")
set target=null
set hero=null
set p=null
return
endif
set TpSlotSubmittingSerial[pid]=serial
set TpSlotForcedTarget[pid]=null
set TpSlotCastMode[pid]=0
set TpSlotCastX[pid]=0.
set TpSlotCastY[pid]=0.
if hero==null or GetUnitTypeId(hero)==0 or GetOwningPlayer(hero)!=p or GetWidgetLife(hero)<=.405 or IsUnitIllusion(hero) then
set errorText="|cFFFFCC00独立TP施放失败：主英雄当前不可用。|r"
elseif TpSlotCooldownRemaining[pid]>0 then
set errorText="|cFFFFCC00独立TP冷却中：还剩 "+I2S(TpSlotCooldownRemaining[pid])+" 秒。|r"
elseif GetUnitState(hero,UNIT_STATE_MANA)<75. then
set errorText="|cFFFFCC00独立TP施放失败：魔法不足，需要75点魔法。|r"
elseif IsUnitPaused(hero) then
set errorText="|cFFFFCC00独立TP施放失败：英雄当前被暂停或禁用。|r"
elseif IsUnitType(hero,UNIT_TYPE_STUNNED) then
set errorText="|cFFFFCC00独立TP施放失败：英雄当前处于眩晕状态。|r"
elseif IsUnitType(hero,UNIT_TYPE_POLYMORPHED) then
set errorText="|cFFFFCC00独立TP施放失败：英雄当前处于变形状态。|r"
elseif B1120ControlBlocked(hero) then
set errorText="|cFFFFCC00独立TP施放失败：英雄当前无法行动。|r"
else
set mode=TpSlot_GetTravelLevel(hero)+1
if mode==1 and TpSlotCharges[pid]<=0 then
set errorText="|cFFFFCC00独立TP栏没有可用点数。|r"
else
if directFountain==1 then
if TV7(p) then
set target=IZ4
else
set target=JA4
endif
if target!=null and GetUnitTypeId(target)!=0 then
set x=GetUnitX(target)
set y=GetUnitY(target)
endif
elseif mode==1 then
set target=BCF(hero,x,y)
else
set target=TpSlot_FindTravelTarget(hero,x,y,mode)
endif
if target==null then
if mode==1 then
set errorText="|cFFFFCC00请选择友方建筑附近作为TP落点。|r"
elseif mode==2 then
set errorText="|cFFFFCC00远行鞋1请选择友方非英雄单位。|r"
else
set errorText="|cFFFFCC00远行鞋2请选择友方单位或队友英雄。|r"
endif
else
if GetUnitAbilityLevel(hero,'A4T0')==0 then
call UnitAddAbility(hero,'A4T0')
call UnitMakeAbilityPermanent(hero,true,'A4T0')
endif
if GetUnitAbilityLevel(hero,'A4T0')==0 then
set errorText="|cFFFFCC00独立TP施放失败：TP施法载体加载失败。|r"
else
if GetUnitAbilityLevel(hero,'A4T0')!=mode then
call SetUnitAbilityLevel(hero,'A4T0',mode)
endif
// Recheck after native ability changes and target resolution, immediately
// before submission. No retry is queued for a hero that became controlled.
if TpSlotSubmittingSerial[pid]!=serial or hero!=M7[pid] or B1120ControlBlocked(hero) or TpSlot_ControllerBusy(hero) or TpSlotChannelActive[pid] or TpSlotCooldownRemaining[pid]>0 or GetUnitState(hero,UNIT_STATE_MANA)<75. or target==null or GetUnitTypeId(target)==0 or GetWidgetLife(target)<=.405 or not IsUnitAlly(target,p) or target==hero or (mode==1 and TpSlotCharges[pid]<=0) then
call B1120OrderTrace(hero,'A4T0',852122,"tp-blocked req="+I2S(serial))
set errorText="|cFFFFCC00独立TP施放失败：英雄、目标或传送状态已变化，请稍后重新选择。|r"
else
set TpSlotCastRequestSerial[pid]=serial
set TpSlotCastRequestUnit[pid]=hero
set TpSlotCastRequestUntil[pid]=TimerGetElapsed(W)+5.
set TpSlotCastMode[pid]=mode
set TpSlotCastX[pid]=x
set TpSlotCastY[pid]=y
if mode>1 then
set TpSlotForcedTarget[pid]=target
else
set TpSlotForcedTarget[pid]=null
endif
call B1120OrderTrace(hero,'A4T0',852122,"tp-before req="+I2S(serial))
set success=B947IssueImmediateOrder("TpSlot_OnSync @ war3map.j:223564 (B968)",hero,"farsight")
call B1120OrderTrace(hero,'A4T0',852122,"tp-after req="+I2S(serial))
if not success then
if TpSlotCastRequestSerial[pid]==serial then
call TpSlot_ClearRequest(pid)
endif
set errorText="|cFFFFCC00独立TP施放失败：原生施法命令被拒绝，英雄可能被沉默或正处于无法施法的指令状态。|r"
endif
endif
endif
endif
endif
endif
if TpSlotSubmittingSerial[pid]==serial then
set TpSlotSubmittingSerial[pid]=0
endif
endif
if not success then
call DisplayTimedTextToPlayer(p,0,0,4.,errorText)
else
call TpSlot_RefreshLocal(p)
endif
set target=null
set hero=null
set p=null
endfunction
function UnifiedOrbToggle_OnSync takes nothing returns nothing
local player orbTogglePlayer=DzGetTriggerSyncPlayer()
local integer orbTogglePlayerId=GetPlayerId(orbTogglePlayer)
local integer orbToggleSerial=S2I(DzGetTriggerSyncData())
if orbTogglePlayerId>=0 and orbTogglePlayerId<bj_MAX_PLAYERS and orbToggleSerial>UnifiedOrbToggleSharedLastSerial[orbTogglePlayerId] and GetPlayerController(orbTogglePlayer)==MAP_CONTROL_USER and GetPlayerSlotState(orbTogglePlayer)==PLAYER_SLOT_STATE_PLAYING then
set UnifiedOrbToggleSharedLastSerial[orbTogglePlayerId]=orbToggleSerial
set UnifiedOrbMasterDisabled[orbTogglePlayerId]=not UnifiedOrbMasterDisabled[orbTogglePlayerId]
set UnifiedOrbMasterRevision[orbTogglePlayerId]=UnifiedOrbMasterRevision[orbTogglePlayerId]+1
call UnifiedOrbToggle_RefreshLocal(orbTogglePlayer)
if UnifiedOrbMasterDisabled[orbTogglePlayerId] then
call DisplayTimedTextToPlayer(orbTogglePlayer,0,0,3.,"|cFFFF5555统一法球已关闭：|r攻击不会触发法球效果，也不会消耗魔法或生命。")
else
call DisplayTimedTextToPlayer(orbTogglePlayer,0,0,3.,"|cFF66FF66统一法球已开启：|r英雄身上的法球恢复正常效果与消耗。")
endif
endif
set orbTogglePlayer=null
endfunction
function TpSlot_BeginTargetingLocal takes nothing returns nothing
local player p=GetLocalPlayer()
local integer pid=GetPlayerId(p)
local unit hero=M7[pid]
local integer mode=0
call TpSlot_RefreshLocal(p)
if hero==null or GetUnitTypeId(hero)==0 or GetWidgetLife(hero)<=.405 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00主英雄当前不可使用独立TP。|r")
elseif GetPlayerController(p)!=MAP_CONTROL_USER then
elseif TpSlot_GetTravelLevel(hero)==0 and TpSlotCharges[pid]<=0 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00请先购买回城卷轴。|r")
elseif TpSlotCooldownRemaining[pid]>0 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00独立TP冷却中：还剩 "+I2S(TpSlotCooldownRemaining[pid])+" 秒。|r")
elseif GetUnitState(hero,UNIT_STATE_MANA)<75. then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00魔法不足：独立TP需要75点魔法。|r")
elseif IsUnitPaused(hero) or IsUnitType(hero,UNIT_TYPE_STUNNED) then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00英雄处于暂停、禁用或眩晕状态，无法使用独立TP。|r")
elseif IsUnitType(hero,UNIT_TYPE_POLYMORPHED) then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFFFFCC00英雄处于变形状态，无法使用独立TP。|r")
else
set mode=TpSlot_GetTravelLevel(hero)+1
call TpSlot_SetTargetingLocal(true)
if mode==1 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFF66CCFF独立TP：|r左键或小地图选择友方建筑附近的落点，右键或Esc取消。")
elseif mode==2 then
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFF66CCFF远行鞋1：|r左键或小地图选点，传送至最近的友方非英雄单位。")
else
call DisplayTimedTextToPlayer(p,0,0,3.,"|cFF66CCFF远行鞋2：|r左键或小地图选点，传送至最近的友方单位或队友英雄。")
endif
endif
set hero=null
set p=null
endfunction
function TpSlot_OnFrameClick takes nothing returns nothing
local real now=GetGameTime()
if TpSlotLocalLastClickTime>=0. and now>=TpSlotLocalLastClickTime and now-TpSlotLocalLastClickTime<=.45 then
set TpSlotLocalLastClickTime=-10.
call TpSlot_RequestFountainLocal()
else
set TpSlotLocalLastClickTime=now
call TpSlot_BeginTargetingLocal()
endif
endfunction
function UnifiedOrbToggle_OnFrameClick takes nothing returns nothing
local player orbTogglePlayer=GetLocalPlayer()
if GetPlayerController(orbTogglePlayer)==MAP_CONTROL_USER and GetPlayerSlotState(orbTogglePlayer)==PLAYER_SLOT_STATE_PLAYING then
set UnifiedOrbToggleLocalSerial=UnifiedOrbToggleLocalSerial+1
call DzSyncData("orbtoggle",I2S(UnifiedOrbToggleLocalSerial))
endif
set orbTogglePlayer=null
endfunction
function TpSlot_OnHotkeyP takes nothing returns nothing
if TpSlotLocalChatOpen or IsSetUpUIEnable or bMenuMainPanelIsEnable or UpdateLogIsShow then
return
endif
if DzIsKeyDown(16) or DzIsKeyDown(17) or DzIsKeyDown(18) then
return
endif
if not TpSlotLocalTargeting then
call ForceUICancel()
set TpSlotLocalLastClickTime=-10.
call TpSlot_BeginTargetingLocal()
endif
endfunction
function TpSlot_OnIssuedOrder takes nothing returns boolean
local unit hero=GetTriggerUnit()
local player p=GetOwningPlayer(hero)
local integer pid=GetPlayerId(p)
local integer orderId=GetIssuedOrderId()
// A real replacement order cancels a request which has not reached EFFECT.
// The accepted farsight itself retains the request for its eventual effect.
if pid>=0 and pid<bj_MAX_PLAYERS and hero==TpSlotCastRequestUnit[pid] and orderId!=852122 then
set TpSlotCancelledRequestUnit[pid]=hero
call TpSlot_ClearRequest(pid)
endif
// Keep native point orders as a fallback, but do not require the main hero to
// be selected. The first accepted request closes local targeting, preventing
// multiple selected units from submitting duplicate coordinates.
if pid>=0 and pid<bj_MAX_PLAYERS and GetPlayerController(p)==MAP_CONTROL_USER and GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER and GetLocalPlayer()==p and TpSlotLocalTargeting then
call TpSlot_RequestPointLocal(GetOrderPointX(),GetOrderPointY())
endif
if pid>=0 and pid<bj_MAX_PLAYERS and hero==M7[pid] and GetPlayerController(p)==MAP_CONTROL_USER and TpSlotChannelActive[pid] then
if orderId==$D0004 then
set TpSlotStopRequested[pid]=true
elseif not TpSlotOrderGuard[pid] then
set TpSlotPreserveChannel[pid]=true
set TpSlotOrderGuard[pid]=true
call B947IssueImmediateOrderById("TpSlot_OnIssuedOrder @ war3map.j:223683 (B968)",hero,$D0019)
set TpSlotOrderGuard[pid]=false
endif
endif
set hero=null
set p=null
return false
endfunction
function TpSlot_OnItemChange takes nothing returns boolean
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer pid=GetPlayerId(p)
local item it=GetManipulatedItem()
local integer itemId=GetItemTypeId(it)
local integer amount=0
if GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
if GetTriggerEventId()==EVENT_PLAYER_UNIT_PICKUP_ITEM and IsUnitType(u,UNIT_TYPE_HERO) and (itemId=='I05A' or itemId=='I05I' or itemId=='I0RX' or itemId=='I0RY') then
set amount=GetItemCharges(it)
if amount<1 then
set amount=1
endif
call KX7(it)
call TpSlot_AddCharge(p,amount)
elseif u==M7[pid] and (itemId=='I06B' or itemId=='I0PG') then
call TpSlot_RefreshLocal(p)
endif
endif
set it=null
set u=null
set p=null
return false
endfunction
function TpSlot_OnHeroDeath takes nothing returns nothing
local unit hero=GetTriggerUnit()
local player p=GetOwningPlayer(hero)
local integer pid=GetPlayerId(p)
if hero==M7[pid] and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and not IsUnitIllusion(hero) then
call TpSlot_ClearRequest(pid)
set TpSlotCancelledRequestUnit[pid]=null
set TpSlotChannelActive[pid]=false
set TpSlotStopRequested[pid]=true
set TpSlotOrderGuard[pid]=false
set TpSlotPreserveChannel[pid]=false
if GetLocalPlayer()==p then
call TpSlot_SetTargetingLocal(false)
endif
call TpSlot_AddCharge(p,1)
endif
set hero=null
set p=null
endfunction
function TpSlot_OnCooldownTick takes nothing returns nothing
local integer i=0
local player p=null
loop
exitwhen i>=bj_MAX_PLAYERS
call TpSlot_ExpireRequest(i)
if TpSlotCooldownRemaining[i]>0 then
set TpSlotCooldownRemaining[i]=TpSlotCooldownRemaining[i]-1
endif
set p=Player(i)
call TpSlot_RefreshLocal(p)
set i=i+1
endloop
set p=null
endfunction
function TpSlot_InitEvents takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
local player p=null
loop
exitwhen i>=bj_MAX_PLAYERS
set p=Player(i)
if GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING then
call SetPlayerAbilityAvailable(p,'A231',false)
call SetPlayerAbilityAvailable(p,'A2Q6',false)
endif
set i=i+1
endloop
call YB7(t,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call YB7(t,EVENT_PLAYER_UNIT_DROP_ITEM)
call YB7(t,EVENT_PLAYER_UNIT_PAWN_ITEM)
call TriggerAddCondition(t,Condition(function TpSlot_OnItemChange))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(t,function TpSlot_OnHeroDeath)
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call YB7(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function TpSlot_OnIssuedOrder))
set t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
call TriggerAddAction(t,function TpSlot_OnCastEnd)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddAction(t,function TpSlot_OnCooldownTick)
set t=null
set p=null
endfunction
function QuickBuy_RefreshSlot takes integer slot returns nothing
    if slot<1 or slot>QUICKBUY_SLOT_COUNT then
        return
    endif
    if QuickBuyLocalUnitId[slot]==0 then
        call DzFrameShow(QuickBuyIcon[slot],false)
        call DzFrameShow(QuickBuyButton[slot],false)
    else
        call DzFrameSetTexture(QuickBuyIcon[slot],QuickBuyLocalTexture[slot],0)
        call DzFrameShow(QuickBuyIcon[slot],true)
        call DzFrameShow(QuickBuyButton[slot],true)
    endif
    set QuickBuyLocalDirty=true
endfunction
function QuickBuy_RefreshAll takes nothing returns nothing
    local integer slot=1
    loop
        exitwhen slot>QUICKBUY_SLOT_COUNT
        call QuickBuy_RefreshSlot(slot)
        set slot=slot+1
    endloop
endfunction
function QuickBuy_RemoveLocal takes integer slot returns nothing
    local integer i=slot
    if slot<1 or slot>QUICKBUY_SLOT_COUNT or QuickBuyLocalBusy then
        return
    endif
    loop
        exitwhen i>=QUICKBUY_SLOT_COUNT
        set QuickBuyLocalUnitId[i]=QuickBuyLocalUnitId[i+1]
        set QuickBuyLocalShopHandleId[i]=QuickBuyLocalShopHandleId[i+1]
        set QuickBuyLocalCost[i]=QuickBuyLocalCost[i+1]
        set QuickBuyLocalTexture[i]=QuickBuyLocalTexture[i+1]
        set QuickBuyLocalName[i]=QuickBuyLocalName[i+1]
        set i=i+1
    endloop
    set QuickBuyLocalUnitId[QUICKBUY_SLOT_COUNT]=0
    set QuickBuyLocalShopHandleId[QUICKBUY_SLOT_COUNT]=0
    set QuickBuyLocalCost[QUICKBUY_SLOT_COUNT]=0
    set QuickBuyLocalTexture[QUICKBUY_SLOT_COUNT]=""
    set QuickBuyLocalName[QUICKBUY_SLOT_COUNT]=""
    set QuickBuyLocalLastClickSlot=0
    set QuickBuyLocalLastClickStamp=0
    call QuickBuy_RefreshAll()
endfunction
function QuickBuy_AddLocal takes integer skillButton,unit shop returns boolean
    local integer itemUnitId=MHUIData_GetCommandButtonOrderId(skillButton)
    local integer itemIndex=QuickBuy_FindItemIndex(itemUnitId)
    local integer slot=1
    local integer cost=MHUIData_GetCommandButtonGoldCost(skillButton)
    local string texture=MHUIData_GetCommandButtonTexture(skillButton)
    if shop==null or GetUnitTypeId(shop)==0 or not QuickBuy_IsSupportedItemUnit(itemUnitId) then
        set shop=null
        return false
    endif
    loop
        exitwhen slot>QUICKBUY_SLOT_COUNT or QuickBuyLocalUnitId[slot]==0
        set slot=slot+1
    endloop
    if slot>QUICKBUY_SLOT_COUNT then
        call MHUI_PlayErrorSound()
        call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,4.,"|cFFFFCC00预购栏已满，请先移除一件装备。|r")
        set shop=null
        return true
    endif
    if (texture==null or texture=="") and itemIndex>=0 then
        set texture=CU[itemIndex]
    endif
    set QuickBuyLocalUnitId[slot]=itemUnitId
    set QuickBuyLocalShopHandleId[slot]=GetHandleId(shop)
    set QuickBuyLocalCost[slot]=cost
    set QuickBuyLocalTexture[slot]=texture
    set QuickBuyLocalName[slot]=QuickBuy_ItemName(itemUnitId)
    set QuickBuyLocalLastClickSlot=0
    set QuickBuyLocalLastClickStamp=0
    call QuickBuy_RefreshAll()
    call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,3.,"|cFF66CCFF已加入预购：|r"+QuickBuyLocalName[slot])
    set shop=null
    return true
endfunction
function QuickBuy_RegisterShops takes nothing returns nothing
    local group g
    local unit u
    if QuickBuyShopCount>0 then
        return
    endif
    set g=CreateGroup()
    call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,null)
    loop
        set u=FirstOfGroup(g)
        exitwhen u==null
        call GroupRemoveUnit(g,u)
        if GetUnitAbilityLevel(u,'Asud')>0 or GetUnitAbilityLevel(u,'Asel')>0 then
            set QuickBuyShopCount=QuickBuyShopCount+1
            set QuickBuyShop[QuickBuyShopCount]=u
            call SaveUnitHandle(QuickBuyShopTable,0,GetHandleId(u),u)
        endif
    endloop
    call DestroyGroup(g)
    set g=null
    set u=null
endfunction
function QuickBuy_TryShop takes player p,unit shop,integer itemUnitId returns boolean
    if shop==null or GetUnitTypeId(shop)==0 or not UnitAlive(shop) then
        return false
    endif
    if GetUnitAbilityLevel(shop,'Asud')==0 and GetUnitAbilityLevel(shop,'Asel')==0 then
        return false
    endif
    return B947IssueNeutralImmediateOrderById("QuickBuy_TryShop @ war3map.j:223886 (B968)",p,shop,itemUnitId)
endfunction
function QuickBuy_TryPurchase takes player p,integer itemUnitId,integer preferredShopHandleId returns boolean
    local unit preferred=LoadUnitHandle(QuickBuyShopTable,0,preferredShopHandleId)
    local unit shop
    local integer i=1
    local integer itemIndex=QuickBuy_FindItemIndex(itemUnitId)
    local integer recipeIndex=-1
    local unit hero=M7[GetPlayerId(p)]
    local boolean success=false
    if QuickBuy_IsRecipeIndex(itemIndex) then
        set recipeIndex=XIO(itemIndex,true)
        if recipeIndex>=0 and hero!=null and GetUnitTypeId(hero)!=0 then
            call XOO(hero,recipeIndex,p)
            set success=true
        endif
    else
        if preferred!=null then
            set success=QuickBuy_TryShop(p,preferred,itemUnitId)
        endif
        loop
            exitwhen success or i>QuickBuyShopCount
            set shop=QuickBuyShop[i]
            if shop!=preferred then
                set success=QuickBuy_TryShop(p,shop,itemUnitId)
            endif
            set i=i+1
        endloop
    endif
    set preferred=null
    set shop=null
    set hero=null
    return success
endfunction
function QuickBuy_IsSpecialCompleted takes player p,integer itemUnitId returns boolean
    local integer pid=GetPlayerId(p)
    local unit hero=M7[pid]
    local boolean completed=false
    if itemUnitId=='h0F4' then
        set completed=CHIA[pid]>0
    elseif itemUnitId=='h0F5' and hero!=null and GetUnitTypeId(hero)!=0 then
        set completed=GetUnitAbilityLevel(hero,'A332')>0 or GetUnitAbilityLevel(hero,'A26A')>0 or GetUnitAbilityLevel(hero,'A333')>0
    elseif itemUnitId=='h0F6' then
        set completed=CHILLX[pid]>0
    endif
    set hero=null
    return completed
endfunction
function QuickBuy_OnSync takes nothing returns nothing
    local player p=DzGetTriggerSyncPlayer()
    local integer pid=GetPlayerId(p)
    local string data=DzGetTriggerSyncData()
    local integer slot=QuickBuy_ParseField(data,0)
    local integer itemUnitId=QuickBuy_ParseField(data,1)
    local integer shopHandleId=QuickBuy_ParseField(data,2)
    local integer serial=QuickBuy_ParseField(data,3)
    local boolean success=false
    local boolean completed=false
    if pid>=0 and pid<bj_MAX_PLAYERS and GetPlayerController(p)==MAP_CONTROL_USER and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and slot>=1 and slot<=QUICKBUY_SLOT_COUNT and QuickBuy_IsSupportedItemUnit(itemUnitId) and serial>QuickBuySharedLastSerial[pid] then
        set QuickBuySharedLastSerial[pid]=serial
        set QuickBuySharedRequestActive=true
        set QuickBuySharedRequestPlayerId=pid
        set QuickBuySharedRequestItemUnitId=itemUnitId
        set QuickBuySharedExpectedRecipe=-1
        set QuickBuySharedCompleted=false
        set success=QuickBuy_TryPurchase(p,itemUnitId,shopHandleId)
        if itemUnitId=='h0F4' or itemUnitId=='h0F5' or itemUnitId=='h0F6' then
            set completed=QuickBuy_IsSpecialCompleted(p,itemUnitId)
        else
            set completed=QuickBuySharedCompleted
        endif
        set QuickBuySharedRequestActive=false
        set QuickBuySharedRequestPlayerId=-1
        set QuickBuySharedRequestItemUnitId=0
        set QuickBuySharedExpectedRecipe=-1
        set QuickBuySharedCompleted=false
    endif
    if GetLocalPlayer()==p and serial==QuickBuyLocalSerial then
        set QuickBuyLocalBusy=false
        set QuickBuyLocalDirty=true
        if completed and slot>=1 and slot<=QUICKBUY_SLOT_COUNT and QuickBuyLocalUnitId[slot]==itemUnitId then
            call QuickBuy_RemoveLocal(slot)
        elseif not success then
            call MHUI_PlayErrorSound()
            call DisplayTimedTextToPlayer(p,0,0,5.,"|cFFFFCC00预购失败：请确认金币、商店距离、库存及装备限制。|r")
        endif
    endif
    set p=null
endfunction
function QuickBuy_RequestLocal takes integer slot returns nothing
    local string data
    if slot<1 or slot>QUICKBUY_SLOT_COUNT or QuickBuyLocalUnitId[slot]==0 or QuickBuyLocalBusy then
        return
    endif
    set QuickBuyLocalBusy=true
    set QuickBuyLocalDirty=true
    set QuickBuyLocalSerial=QuickBuyLocalSerial+1
    set data=I2S(slot)+","+I2S(QuickBuyLocalUnitId[slot])+","+I2S(QuickBuyLocalShopHandleId[slot])+","+I2S(QuickBuyLocalSerial)
    call DzSyncData("quickbuy",data)
endfunction
function QuickBuy_OnFrameClick takes nothing returns nothing
    local integer frame=DzGetTriggerUIEventFrame()
    local integer slot=1
    local integer stamp=MHGame_GetGameStamp()
    loop
        exitwhen slot>QUICKBUY_SLOT_COUNT or QuickBuyButton[slot]==frame
        set slot=slot+1
    endloop
    if slot<=QUICKBUY_SLOT_COUNT then
        if DzIsKeyDown(OSKEY_SHIFT) then
            call QuickBuy_RemoveLocal(slot)
        elseif QuickBuyLocalLastClickSlot==slot and stamp>=QuickBuyLocalLastClickStamp and stamp-QuickBuyLocalLastClickStamp<=QUICKBUY_DOUBLE_CLICK_THRESHOLD then
            set QuickBuyLocalLastClickSlot=0
            set QuickBuyLocalLastClickStamp=0
            call QuickBuy_RequestLocal(slot)
        else
            set QuickBuyLocalLastClickSlot=slot
            set QuickBuyLocalLastClickStamp=stamp
        endif
    endif
endfunction
function QuickBuy_InitFrames takes nothing returns nothing
    local integer slot=1
    local real x
    if QuickBuyButton[1]!=0 then
        return
    endif
    loop
        exitwhen slot>QUICKBUY_SLOT_COUNT
        set x=0.615+I2R(slot-1)*0.029
        set QuickBuyIcon[slot]=DzCreateFrameByTagName("BACKDROP",null,GameUI,"template",200+slot)
        call DzFrameSetSize(QuickBuyIcon[slot],0.022,0.022)
        call DzFrameClearAllPoints(QuickBuyIcon[slot])
        call DzFrameSetAbsolutePoint(QuickBuyIcon[slot],4,x,0.190)
        call DzFrameSetPriority(QuickBuyIcon[slot],94)
        set QuickBuyButton[slot]=DzCreateFrameByTagName("TEXTBUTTON","QuickBuyButton",GameUI,"Glyph_Button",100+slot)
        call DzFrameSetSize(QuickBuyButton[slot],0.026,0.026)
        call DzFrameClearAllPoints(QuickBuyButton[slot])
        call DzFrameSetAbsolutePoint(QuickBuyButton[slot],4,x,0.190)
        call DzFrameSetPriority(QuickBuyButton[slot],95)
        call DzFrameSetAlpha(QuickBuyButton[slot],0)
        call DzFrameSetScriptByCode(QuickBuyButton[slot],1,function QuickBuy_OnFrameClick,false)
        call DzFrameShow(QuickBuyIcon[slot],false)
        call DzFrameShow(QuickBuyButton[slot],false)
        set slot=slot+1
    endloop
endfunction
//初始化同步触发器
function InitSyncTrigger takes nothing returns nothing
	local trigger trig
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "p", false)
	call TriggerAddAction(trig, function Trig_Synsp)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "t", false)
	call TriggerAddAction(trig, function Trig_SynsT)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "CHAT", false)
	call TriggerAddAction(trig, function Trig_SynsChat)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "setup", false)
    call TriggerAddCondition(trig, Condition( function SetUp_SyncData))
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "omghold", false)
	call TriggerAddAction(trig, function OmgHoldPositionHotkey_OnSync)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "omgdel", false)
	call TriggerAddAction(trig, function OmgDeleteSkill_OnSync)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "quickbuy", false)
	call TriggerAddAction(trig, function QuickBuy_OnSync)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "tpslot", false)
	call TriggerAddAction(trig, function TpSlot_OnSync)
	set trig = CreateTrigger()
	call DzTriggerRegisterSyncData(trig, "orbtoggle", false)
	call TriggerAddAction(trig, function UnifiedOrbToggle_OnSync)
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "FogClick", false)
 //   call TriggerAddCondition(trig, Condition( function SyncFogClickData))
	// 同步学习技能快捷键
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "SyncLeranSkillHotKey", false)
 //   call TriggerAddCondition(trig, Condition( function SyncLeranSkillHotKeyActions ))
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "FogClick", false)
 //   call TriggerAddCondition(trig, Condition( function SyncFogClickData))
	// 同步学习技能快捷键
//	set trig = CreateTrigger()
//	call DzTriggerRegisterSyncData(trig, "SyncLeranSkillHotKey", false)
 //   call TriggerAddCondition(trig, Condition( function SyncLeranSkillHotKeyActions ))
	set trig = null
endfunction
function Click_LifeManaButton takes nothing returns nothing
	local unit u = MHPlayer_GetSelectUnit()
	local integer i = GetPlayerId(GetLocalPlayer())
	local player p
	local integer j8 = GetPlayerId(DzGetTriggerKeyPlayer())
	if DzIsKeyDown(18) then
		if u != null and GetUnitAbilityLevel(u, 'AHer') > 0 then
			if IsUnitAlly(u, GetLocalPlayer()) and IsUnitType(u, UNIT_TYPE_HERO) then
				if GetChat_times(j8) then
					if u == M7[i] then 
						call DzSyncData("t", "我拥有" + UnitLP(u, true)+ UnitMP(u, true))
					else
						set p = GetOwningPlayer(u)
						call DzSyncData("t", "队友 " + Q[GetPlayerId(p)] + GetPlayerName(p) + "|r拥有" + UnitLP(u, true)+ UnitMP(u, true))
						set p = null
					endif
				endif
			else
				if GetChat_times(j8) then
					// B1059: sync click-time text only; the target may disappear before delivery.
					call DzSyncData("t", "敌人" + Q[GetPlayerId(GetOwningPlayer(u))] + GetUnitName(u) + "|r拥有" + UnitLP(u, false) + UnitMP(u, false))
				endif
			endif
		endif
	endif
	set u = null
endfunction
function GetFrameToolTipStr takes integer frame, integer typeId returns string
	return LoadStr( ExtraHT, frame, typeId )
endfunction
function FrameToolTip__MouseEnter takes nothing returns nothing
	local integer frame = DzGetTriggerUIEventFrame()
	call DzFrameShow( UIFrame__ToolTip, true )
	call DzFrameSetText( UIText__ToolTip, GetFrameToolTipStr( frame, HTKEY_UI_TOOLTIP_STR ) )
	call DzFrameSetText( UIText__ToolUberTip, GetFrameToolTipStr( frame, HTKEY_UI_TOOLTIP_UBERSTR ) )
endfunction
function FrameToolTip__MouseLeave takes nothing returns nothing
	call DzFrameShow( UIFrame__ToolTip, false )
endfunction
// 给Frame添加工具提示
function SetFrameToolTip takes integer frame, string tip, string uberTip returns nothing
	call SaveStr( ExtraHT, frame, HTKEY_UI_TOOLTIP_STR, tip )
	call SaveStr( ExtraHT, frame, HTKEY_UI_TOOLTIP_UBERSTR, uberTip )
	call DzFrameSetScriptByCode( frame, 2, function FrameToolTip__MouseEnter, false )
	call DzFrameSetScriptByCode( frame, 3, function FrameToolTip__MouseLeave, false )
endfunction
function B927BuybackEnter takes nothing returns nothing
local player bbHoverPlayer927=GetLocalPlayer()
local integer bbHoverCost927=B927BuybackCost(bbHoverPlayer927)
local string bbHoverText927="点击购买已有商店中的买活，立即在原买活地点复活你的主英雄。|n费用、冷却和禁止买活规则与原买活入口相同。"
local string bbHoverError927=B927BuybackError(bbHoverPlayer927)
if bbHoverCost927>=0 then
set bbHoverText927=bbHoverText927+"|n|n|cFFFFFF00当前费用："+I2S(bbHoverCost927)+" 黄金|r"
endif
if bbHoverError927=="" then
set bbHoverText927=bbHoverText927+"|n|cFF66FF66可以买活|r"
else
set bbHoverText927=bbHoverText927+"|n|cFFFFCC00"+bbHoverError927+"|r"
endif
call DzFrameSetText(UIText__ToolTip,"买活英雄")
call DzFrameSetText(UIText__ToolUberTip,bbHoverText927)
call DzFrameShow(UIFrame__ToolTip,true)
set bbHoverPlayer927=null
endfunction
function B927BuybackInit takes nothing returns nothing
local integer bbNativeFrame927=MHUI_GetMiniMapFormationButton()
if B927BuybackFrame!=0 then
return
endif
set B927BuybackFrame=DzCreateFrameByTagName("TEXTBUTTON","B927BuybackFrame",GameUI,"B927_BuybackButton",927)
// Like GlyphFrame, anchor to the visible minimap, never the hidden native button.
call DzFrameClearAllPoints(B927BuybackFrame)
call DzFrameSetSize(B927BuybackFrame,.0245,.0245)
call DzFrameSetPoint(B927BuybackFrame,4,DzFrameGetMinimap(),4,.087,-.0365)
if bbNativeFrame927!=0 then
// Native minimap controls are simple buttons, not custom Dz TEXTBUTTON frames.
// Retire the exact formation control with its native frame API so it cannot
// retain hover/click ownership underneath the replacement or reappear in place.
call MHFrame_Disable(bbNativeFrame927,true)
call MHFrame_Hide(bbNativeFrame927,true)
call MHFrame_ClearAllPoints(bbNativeFrame927)
call MHFrame_SetAbsolutePoint(bbNativeFrame927,ANCHOR_CENTER,-1.,-1.)
endif
call DzFrameSetEnable(B927BuybackFrame,true)
call DzFrameShow(B927BuybackFrame,true)
call DzFrameSetText(B927BuybackFrame," ")
call DzFrameSetPriority(B927BuybackFrame,95)
call SetFrameToolTip(B927BuybackFrame,"买活英雄","点击立即买活，沿用原商店的费用、冷却和限制。")
call DzFrameSetScriptByCode(B927BuybackFrame,2,function B927BuybackEnter,false)
call DzFrameSetScriptByCode(B927BuybackFrame,1,function B927BuybackClick,false)
if WG7(GetLocalPlayer()) then
call DzFrameSetEnable(B927BuybackFrame,false)
endif
endfunction
