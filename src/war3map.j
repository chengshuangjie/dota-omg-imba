function SuijiMode_GetNethertoxinLevel takes unit u returns integer
local integer level=0
local integer h=0
if u==null or GetUnitTypeId(u)==0 then
return 0
endif
set level=GetUnitAbilityLevel(u,'A1A3')
if level>0 then
return level
endif
if SUIJI_MODE==false then
return 0
endif
set h=GetHandleId(u)
if OO7(h,"SuijiDone") and (OM7(h,"SuijiSmallSkill")=='A1A3' or OM7(h,"SuijiUltSkill")=='A1A3') then
return GetUnitAbilityLevel(u,'Y08W')
endif
return 0
endfunction
