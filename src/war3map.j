call UnitRemoveAbility(u,'A4BB')
call UnitRemoveAbility(u,'A4BC')
call UnitRemoveAbility(u,'A4BD')
call UnitRemoveAbility(u,'A4BE')
call UnitRemoveAbility(u,'A4BF')
call UnitRemoveAbility(u,'A4BG')
endif
if n>0 then
call XF7(u,'A4BB')
call UnitMakeAbilityPermanent(u,true,'A09O')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BB',false)
endif
if n>1 then
call XF7(u,'A4BC')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BC',false)
endif
if n>2 then
call XF7(u,'A4BD')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BD',false)
endif
if n>3 then
call XF7(u,'A4BE')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BE',false)
endif
if n>4 then
call XF7(u,'A4BF')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BF',false)
endif
if n>5 then
call XF7(u,'A4BG')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A4BG',false)
endif
endfunction
