function CSG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local integer BC7=LoadInteger(L7,I97,5)
local integer id=0
local integer CTG=0
call FlushChildHashtable(L7,(I97))
call OZ7(t)
if ZX7==null or GetUnitTypeId(ZX7)==0 or IH7==null or XH7(IH7) then
set t=null
set ZX7=null
set IH7=null
return false
endif
if BC7<1 or BC7>3 then
set t=null
set ZX7=null
set IH7=null
return false
endif
if IsUnitAlly(IH7,GetOwningPlayer(ZX7)) then
set CTG='B0F8'
if BC7==1 then
set id='A2FA'
elseif BC7==2 then
set id='A2FB'
elseif BC7==3 then
set id='A2F9'
endif
call B907SkillHeal(ZX7,IH7,100+50*BC7)
else
set CTG='B0F9'
if BC7==1 then
set id='A2F7'
elseif BC7==2 then
set id='A2F8'
elseif BC7==3 then
set id='A2F6'
endif
call B67(ZX7,IH7,1,100+50*BC7)
endif
call Z57(IH7,id,1,4,CTG)
set t=null
set ZX7=null
set IH7=null
return false
endfunction
function CUG takes nothing returns nothing
