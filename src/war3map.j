call NM7(T_7)
call OZ7(t)
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
if b1060GetEventDamageSource==ZX7 and(b1060GetEventDamage>20 or IsUnitType(b1060GetTriggerUnit,UNIT_TYPE_STRUCTURE))then
set MHD=OM7(GetHandleId(ZX7),"Count")
if MHD>0 then
if OE7(GetHandleId(ZX7),"FlakCannon_EndTrig")==LoadTriggerHandle(L7,T_7,StringHash("B845FlakOwner")) then
call NP7(GetHandleId(ZX7),"Count",(MHD+1))
endif
endif
call NM7(T_7)
call OZ7(t)
endif
else
call NM7(T_7)
call OZ7(t)
endif
set t=null
set ZX7=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function ROG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=O77(I97,"Source")
if ISBIANYANG(ZX7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
call UnitRemoveAbility(ZX7,'A237')
call UnitAddAbility(ZX7,'A22B')
call UnitRemoveAbility(ZX7,'A22B')
if (GetUnitTypeId(ZX7)=='E02N' or GetUnitTypeId(ZX7)=='E02O') and SuijiMode_HasAghanimState(ZX7) then
call SuijiMode_EnsureExactLiveAbilityLevel(ZX7,'A237',1,true)
endif
endif
set t=null
set ZX7=null
return false
endfunction
function RPG takes unit ZX7 returns nothing
local trigger t
// Abrf A22B is Gyrocopter's unit-type swap, never an OMG cleanup helper.
if ZX7==null or (GetUnitTypeId(ZX7)!='E02N' and GetUnitTypeId(ZX7)!='E02O') then
return
endif
if ISBIANYANG(ZX7)==false then
call UnitRemoveAbility(ZX7,'A237')
call UnitAddAbility(ZX7,'A22B')
call UnitRemoveAbility(ZX7,'A22B')
if (GetUnitTypeId(ZX7)=='E02N' or GetUnitTypeId(ZX7)=='E02O') and SuijiMode_HasAghanimState(ZX7) then
call SuijiMode_EnsureExactLiveAbilityLevel(ZX7,'A237',1,true)
endif
else
set t=CreateTrigger()
call NT7(GetHandleId(t),"Source",ZX7)
call TriggerRegisterTimerEvent(t,.1,true)
call TriggerAddCondition(t,Condition(function ROG))
set t=null
endif
endfunction
function SuijiMode_FlakEnd takes trigger t returns nothing
local integer T_7=GetHandleId(t)
local unit ZX7=O77(T_7,"Source")
if t==null then
return
endif
if ZX7!=null and OE7(GetHandleId(ZX7),"FlakCannon_EndTrig")==t then
call RemoveSavedHandle(L7,GetHandleId(ZX7),StringHash("FlakCannon_EndTrig"))
call NP7(GetHandleId(ZX7),"B845FlakShots",0)
call NQ7(GetHandleId(ZX7),"B845FlakUntil",0.)
if GetUnitTypeId(ZX7)=='E02N' or GetUnitTypeId(ZX7)=='E02O' then
call UnitRemoveAbility(ZX7,'A1TW')
call UnitRemoveAbility(ZX7,'B0DJ')
call RPG(ZX7)
endif
endif
call NM7(T_7)
call OZ7(t)
set ZX7=null
endfunction
function RQG takes nothing returns boolean
call SuijiMode_FlakEnd(GetTriggeringTrigger())
return false
endfunction
function SuijiMode_FlakRandomProjectileHit takes nothing returns nothing
local trigger flakMissile=GetTriggeringTrigger()
local unit flakSource=LoadUnitHandle(TABLE_HY,GetHandleId(flakMissile),43)
local unit flakTarget=W22
if flakSource!=null and flakTarget!=null and GetUnitTypeId(flakSource)!=0 and GetUnitTypeId(flakTarget)!=0 and UnitAlive(flakTarget) and IsUnitEnemy(flakTarget,GetOwningPlayer(flakSource)) and IsHideUnit(flakTarget)==false and AE7(flakTarget)==false and ISWUDI(flakTarget)==false then
// Flak secondary bullets deal attack damage, not another attack-effect chain.
call NS7(GetHandleId(flakSource),"B845FlakSecondaryHit",true)
call B67(flakSource,flakTarget,2,LoadReal(TABLE_HY,GetHandleId(flakMissile),StringHash("B845FlakDamage")))
call NS7(GetHandleId(flakSource),"B845FlakSecondaryHit",false)
endif
set flakMissile=null
set flakSource=null
set flakTarget=null
endfunction
function SuijiMode_FlakRandomOnAttack takes unit flakSource,unit flakPrimary returns nothing
local integer flakHandle=GetHandleId(flakSource)
local integer flakShots=OM7(flakHandle,"B845FlakShots")
local group flakTargets=null
local unit flakTarget=null
local trigger flakMissile=null
local real flakDamage=0.
local integer flakEmitted=0
if flakShots<=0 then
return
endif
if flakSource==null or GetUnitTypeId(flakSource)==0 or UnitAlive(flakSource)==false or IsUnitIllusion(flakSource) or B287_GetUnitAbilityLevel(flakSource,'A229')<=0 or ON7(flakHandle,"B845FlakUntil")<=TimerGetElapsed(W) then
call SuijiMode_FlakEnd(OE7(flakHandle,"FlakCannon_EndTrig"))
return
endif
if flakPrimary==null or IsUnitEnemy(flakPrimary,GetOwningPlayer(flakSource))==false or OO7(flakHandle,"SuijiFlakSideGunnerAttacking") or OO7(flakHandle,"B845FlakSecondaryHit") then
return
endif
call NP7(flakHandle,"B845FlakShots",flakShots-1)
set flakDamage=GetUnitState(flakSource,UNIT_STATE_ATTACK1_DAMAGE_BASE)+GetUnitState(flakSource,UNIT_STATE_ATTACK1_DAMAGE_BONUS)
set flakTargets=CreateGroup()
call GroupEnumUnitsInRange(flakTargets,GetUnitX(flakSource),GetUnitY(flakSource),1000.,null)
call GroupRemoveUnit(flakTargets,flakPrimary)
loop
set flakTarget=FirstOfGroup(flakTargets)
exitwhen flakTarget==null or flakEmitted>=100
call GroupRemoveUnit(flakTargets,flakTarget)
if UnitAlive(flakTarget) and IsUnitEnemy(flakTarget,GetOwningPlayer(flakSource)) and IsUnitVisible(flakTarget,GetOwningPlayer(flakSource)) and IsHideUnit(flakTarget)==false and GetUnitAbilityLevel(flakTarget,'Aloc')==0 and GetUnitAbilityLevel(flakTarget,'A04R')==0 and AE7(flakTarget)==false and ISWUDI(flakTarget)==false then
set flakMissile=NHX(flakSource,flakTarget,'h0HH',"SuijiMode_FlakRandomProjectileHit",800.,false,"")
if flakMissile!=null then
call SaveReal(TABLE_HY,GetHandleId(flakMissile),StringHash("B845FlakDamage"),flakDamage)
set flakEmitted=flakEmitted+1
endif
endif
endloop
call DestroyGroup(flakTargets)
if flakShots==1 then
call SuijiMode_FlakEnd(OE7(flakHandle,"FlakCannon_EndTrig"))
endif
set flakTargets=null
set flakTarget=null
set flakMissile=null
endfunction
function SuijiMode_FlakCooldownTick takes nothing returns nothing
local timer flakCooldownTimer=GetExpiredTimer()
local integer flakCooldownHandle=GetHandleId(flakCooldownTimer)
local unit flakCooldownUnit=LoadUnitHandle(L7,flakCooldownHandle,0)
local integer flakCooldownPhysical=LoadInteger(L7,flakCooldownHandle,1)
local real flakCooldownValue=LoadReal(L7,flakCooldownHandle,2)
if flakCooldownUnit!=null and GetUnitTypeId(flakCooldownUnit)!=0 and GetUnitAbilityLevel(flakCooldownUnit,flakCooldownPhysical)>0 then
call YDWESetUnitAbilityState(flakCooldownUnit,flakCooldownPhysical,1,flakCooldownValue)
call MHAbility_SetCooldownEx(flakCooldownUnit,flakCooldownPhysical,flakCooldownValue,flakCooldownValue)
endif
call NM7(flakCooldownHandle)
call PauseTimer(flakCooldownTimer)
call DestroyTimer(flakCooldownTimer)
set flakCooldownUnit=null
set flakCooldownTimer=null
endfunction
function RRG takes nothing returns nothing
local unit b1060GetAttacker=B1060EventAttacker()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local unit CV7=b1060GetAttacker
local integer T_7=GetHandleId(CV7)
local integer MHD=OM7(T_7,"Count")
local integer CW7=0
local trigger t
if not B1023HitLive(b1060GetAttacker) or not B1023HitLive(b1060GetTriggerUnit) then
set CV7=null
set t=null
set b1060GetAttacker=null
set b1060GetTriggerUnit=null
return
endif
set CW7=B287_GetUnitAbilityLevel(CV7,'A229')
if IsUnitIllusion(b1060GetAttacker) and GetUnitAbilityLevel(b1060GetAttacker,'A1TW')>0 then
call RPG(b1060GetAttacker)
call UnitRemoveAbility(b1060GetAttacker,'A1TW')
endif
if b1060GetAttacker==CV7 then
set MHD=MHD+1
if MHD>3+CW7 then
call SuijiMode_FlakEnd(OE7(T_7,"FlakCannon_EndTrig"))
else
set t=CreateTrigger()
call B1023RegisterDamage(t,b1060GetTriggerUnit)
call TriggerRegisterTimerEvent(t,2,false)
call TriggerAddCondition(t,Condition(function RNG))
call NT7(GetHandleId(t),"Source",CV7)
call SaveTriggerHandle(L7,GetHandleId(t),StringHash("B845FlakOwner"),OE7(T_7,"FlakCannon_EndTrig"))
endif
endif
set t=null
set CV7=null
set b1060GetAttacker=null
set b1060GetTriggerUnit=null
endfunction
function RSG takes nothing returns boolean
local unit suijiFlakAttackUnit=GetAttacker()
if suijiFlakAttackUnit!=null and GetUnitAbilityLevel(suijiFlakAttackUnit,'A1TW')>0 and OO7(GetHandleId(suijiFlakAttackUnit),"SuijiFlakSideGunnerAttacking")==false then
call RRG()
endif
set suijiFlakAttackUnit=null
return false
endfunction
function RTG takes nothing returns nothing
local trigger t=null
local integer T_7=0
local unit ZX7=GetTriggerUnit()
local timer flakCooldownTimer=null
local real flakCooldownFactor=ReduceUnitAbilityCoolDownReal(ZX7)
local real flakCooldownValue=20.
// Recast/refresh replaces one lifetime; an old expiry must not end a new cast.
call SuijiMode_FlakEnd(OE7(GetHandleId(ZX7),"FlakCannon_EndTrig"))
set t=CreateTrigger()
set T_7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,$F,false)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function RQG))
call NT7(T_7,"Source",ZX7)
call NV7(GetHandleId(ZX7),"FlakCannon_EndTrig",t)
call NP7(GetHandleId(ZX7),"Count",(1))
if GetUnitTypeId(ZX7)=='E02N' or GetUnitTypeId(ZX7)=='E02O' then
call UnitRemoveAbility(ZX7,'A237')
call UnitAddAbility(ZX7,'A22A')
call UnitRemoveAbility(ZX7,'A22A')
else
// Aroc only follows native ranged weapons. Foreign melee/ranged heroes share
// a scripted hit-count owner and must never attach native morph/attack helpers.
call NP7(GetHandleId(ZX7),"B845FlakShots",2+IMinBJ(4,B287_GetUnitAbilityLevel(ZX7,'A229')))
call NQ7(GetHandleId(ZX7),"B845FlakUntil",TimerGetElapsed(W)+15.)
endif
if (GetUnitTypeId(ZX7)=='E02N' or GetUnitTypeId(ZX7)=='E02O') and SuijiMode_HasAghanimState(ZX7) then
call SuijiMode_EnsureExactLiveAbilityLevel(ZX7,'A237',1,true)
endif
if flakCooldownFactor>0. then
set flakCooldownValue=flakCooldownValue*flakCooldownFactor
endif
// Match UTA's factor once, then materialize both cooldown states after the
// engine's SPELL_EFFECT processing. Never rewrite a live cooldown periodically.
set flakCooldownTimer=CreateTimer()
call SaveUnitHandle(L7,GetHandleId(flakCooldownTimer),0,ZX7)
call SaveInteger(L7,GetHandleId(flakCooldownTimer),1,B287_GetPhysicalAbilityId(ZX7,'A229'))
call SaveReal(L7,GetHandleId(flakCooldownTimer),2,flakCooldownValue)
call TimerStart(flakCooldownTimer,0.,false,function SuijiMode_FlakCooldownTick)
set flakCooldownTimer=null
set t=null
set ZX7=null
endfunction
function RUG takes nothing returns boolean
if IsUnitIllusion(GetTriggerUnit()) and GetUnitTypeId(GetTriggerUnit())=='E02O' then
call RPG(GetTriggerUnit())
endif
return false
endfunction
function RVG takes nothing returns boolean
local unit suijiFlakCastUnit=GetTriggerUnit()
if B287_GetSpellAbilityId()=='A229' and IsUnitIllusion(suijiFlakCastUnit)==false and (GetUnitTypeId(suijiFlakCastUnit)=='E02N' or GetUnitTypeId(suijiFlakCastUnit)=='E02O' or (SUIJI_MODE and OO7(GetHandleId(suijiFlakCastUnit),"SuijiDone") and B287_GetUnitAbilityLevel(suijiFlakCastUnit,'A229')>0)) then
call RTG()
endif
set suijiFlakCastUnit=null
return false
endfunction
function OD8 takes nothing returns nothing
local trigger t=CreateTrigger()
call YB7(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RVG))
set t=CreateTrigger()
