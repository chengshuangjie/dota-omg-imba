if kunkkaTidebringerUnit==null or IsUnitIllusion(kunkkaTidebringerUnit) then
return
endif
set kunkkaTidebringerUnitHandle=GetHandleId(kunkkaTidebringerUnit)
if OO7(kunkkaTidebringerUnitHandle,"KunkkaTidebringerInit") then
