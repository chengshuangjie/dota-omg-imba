function B991Request takes unit u991 returns boolean
local integer p991=0
local unit a991=null
local boolean valid991=false
local real now991=TimerGetElapsed(W)
if u991==null then
return false
endif
if u991==B991OrderOwner then
return true
endif
set p991=GetPlayerId(GetOwningPlayer(u991))
if p991>=12 or u991!=M7[p991] or B991Owner[p991]!=u991 or GetPlayerController(GetOwningPlayer(u991))!=MAP_CONTROL_COMPUTER or not UnitAlive(u991) or IsUnitIllusion(u991) then
if p991<12 and B991Owner[p991]==u991 then
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=0.
endif
return false
endif
// B1122: below level 10, release retaliation ownership to the existing retreat AI.
// Never issue an order here: request checks also run inside order callbacks.
if GetHeroLevel(u991)<10 then
if B991Until[p991]>0. and h4[p991]==B991Attacker[p991] then
set h4[p991]=null
endif
set B991Until[p991]=0.
set B991ActionTime[p991]=0.
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=0.
return false
endif
if not G0[32+p991] and not ME7(u991) and not (GetUnitTypeId(u991)=='HMD0' and GetUnitLifePercent(u991)<30.) then
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=0.
return false
endif
set a991=B991Attacker[p991]
// Actual damage remains the evidence; a brief spell/move order is not disengagement.
set valid991=a991!=null and UnitAlive(a991) and IsUnitEnemy(a991,GetOwningPlayer(u991)) and IsUnitVisible(a991,GetOwningPlayer(u991)) and not IsUnitIllusion(a991) and not MHUnit_IsInvulnerable(a991) and IsUnitInRange(u991,a991,350.) and (now991-B991HitTime[p991]<=1.5 or B993ControlPending[p991] or now991<B993ThreatUntil[p991] or (GetUnitCurrentOrder(a991)==851983 and MHUnit_GetAttackTargetUnit(a991)==u991)) and (GetUnitCurrentOrder(a991)!=OrderId("attack") or MHUnit_GetAttackTargetUnit(a991)==u991)
if not valid991 then
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=0.
elseif IsUnitPaused(u991) or IsUnitType(u991,UNIT_TYPE_STUNNED) or IsUnitType(u991,UNIT_TYPE_POLYMORPHED) then
// Reserve the response without spending it while the hero cannot act.
set B993ControlPending[p991]=true
set B991Until[p991]=now991+1.
set G0[32+p991]=true
set h4[p991]=a991
elseif B993ControlPending[p991] then
set B993ControlPending[p991]=false
set B993ThreatUntil[p991]=now991+1.
set B991Until[p991]=now991+1.
set B991ActionTime[p991]=0.
set h4[p991]=a991
endif
if valid991 then
// Keep ownership while the threat persists; only actions have a cooldown.
set B991Until[p991]=now991+1.
set G0[32+p991]=true
set h4[p991]=a991
endif
set a991=null
return valid991
endfunction
