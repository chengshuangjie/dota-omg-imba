call UnitRemoveAbility(u,'ZTBD')
// Defensive cleanup for B571 and earlier direct-child states.
call UnitRemoveAbility(u,'ZTBS')
endif
set fx=LoadEffectHandle(L7,h,StringHash("SuijiScriptedTerrorbladeEffect"))
if fx!=null then
call DestroyEffect(fx)
call RemoveSavedHandle(L7,h,StringHash("SuijiScriptedTerrorbladeEffect"))
