function YINRAN3 takes nothing returns nothing
    local unit ZX7=GetTriggerUnit()
    local unit IH7=GetSpellTargetUnit()
    local integer skill=B287_GetSpellAbilityId()
    local integer level=B287_GetUnitAbilityLevel(ZX7,skill)
    local integer skillmj
    local trigger t
    if skill=='A011' then
        set skillmj='A4J6'
    elseif skill=='A007' then
        set skillmj='A4J7'
    elseif skill=='A01T' then
        set skillmj='A4J8'
    elseif skill=='A00F' then
        set skillmj='A4J9'
    endif
    set t=NHX(ZX7, IH7,'h0HL', "YINRAN_TRI",1000, true, "")
    call SaveInteger(TABLE_HY, GetHandleId(t), 10, level)
    call SaveInteger(TABLE_HY, GetHandleId(t), 11, skillmj)
    call SaveInteger(TABLE_HY, GetHandleId(t), 12, SuijiMode_GetDurationMulticastCount(ZX7,skill))
    set ZX7=null
    set IH7=null
    set t=null
endfunction
