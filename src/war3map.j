function K_E takes nothing returns boolean
if B287_GetSpellAbilityId()=='A0NQ' and WQ7(GetSpellTargetUnit())==false then
        call JDZC()
endif
return false
endfunction
function KF8 takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function K_E))
set t=null
endfunction
function MFE takes real BZ7 returns string
if BZ7>4.5 then
return"5.0"
elseif BZ7>4. then
return"4.5"
elseif BZ7>3.5 then
return"4.0"
elseif BZ7>3. then
return"3.5"
elseif BZ7>2.5 then
return"3.0"
elseif BZ7>2. then
return"2.5"
elseif BZ7>1.5 then
return"2.0"
elseif BZ7>1. then
return"1.5"
elseif BZ7>.5 then
return"1.0"
elseif BZ7>.0 then
return"0.5"
else
return"0.0"
endif
return" "
endfunction
function BZ_TEXT takes string YY7,unit IH7,unit WX7 returns nothing
local texttag tt=CreateTextTag()
call SetTextTagText(tt,YY7,.033)
call SetTextTagPosUnit(tt,IH7,64)
call SetTextTagColor(tt,$A0,0,$FF,$FF)
call SetTextTagVelocity(tt,0,.0355)
call SetTextTagFadepoint(tt,.15)
call SetTextTagPermanent(tt,false)
call SetTextTagLifespan(tt,.65)
call SetTextTagVisibility(tt,true)
set tt=null
endfunction
function MGE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit IH7=O77(I97,"Target")
local integer WF8=GetTriggerEvalCount(t)
if IH7==null or GetUnitTypeId(IH7)==0 or WF8>$B or UnitAlive(IH7)==false then
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
call BZ_TEXT(MFE(5.5-.5*WF8),IH7,IH7)
endif
set t=null
set IH7=null
return false
endfunction
function MHE takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real MIE=ON7(OB7,"Damage")
local real MJE=0.
local real MKE=0.
if m5==null or GetUnitTypeId(m5)==0 then
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
return false
endif
set MJE=YK7(GetUnitState(m5,UNIT_STATE_LIFE)-MIE,2)
set MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
call SetUnitState(m5,UNIT_STATE_LIFE,MJE)
call NQ7(GetHandleId(m5),"ShallowGrave|FakeLife",MKE-MIE)
call NM7(OB7)
call OZ7(t)
set t=null
set m5=null
return false
endfunction
function MME takes unit m5,real MIE returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
call NT7(OB7,"Target",m5)
call NQ7(OB7,"Damage",MIE)
call NQ7(GetHandleId(m5),"ShallowGrave|FakeLife",MKE+MIE)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function MHE))
set t=null
endfunction
function MNE takes nothing returns boolean
local real b1060GetEventDamage=B1060EventDamage()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit m5=O77(OB7,"Target")
local real Wx
local real MIE
local integer iX=GetTriggerEvalCount(t)
local real MKE
local real MOE=ON7(OB7,"LastFrame")
local real MPE=ON7(OB7,"FrameDamage")
local boolean b=OO7(OB7,"HaveA")
if m5==null or GetUnitTypeId(m5)==0 then
call DestroyEffect(OG7(OB7,"FX"))
call NM7(OB7)
call OZ7(t)
set m5=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endif
if MOE!=KQ7()then
set MOE=KQ7()
set MPE=0
call NQ7(OB7,"LastFrame",MOE)
call NQ7(OB7,"FrameDamage",MPE)
endif
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED then
set m5=b1060GetTriggerUnit
set MKE=ON7(GetHandleId(m5),"ShallowGrave|FakeLife")
set Wx=GetUnitState(m5,UNIT_STATE_LIFE)
set MIE=b1060GetEventDamage
if((Wx-MKE-MPE)-MIE)<1 then
call SetUnitState(m5,UNIT_STATE_LIFE,Wx+MIE+MPE)
call MME(m5,MIE)
else
set MPE=MPE+MIE
call NQ7(OB7,"FrameDamage",MPE)
endif
else
call SaveInteger(L7,(GetHandleId(((LoadUnitHandle(L7,(OB7),(17)))))),((2485)),(2))
call OX7(O77(OB7,"Target"),"ShallowGrave|Active")
call DestroyEffect(OG7(OB7,"FX"))
call UnitRemoveAbility(O77(OB7,"Target"),'A21I')
call UnitRemoveAbility(O77(OB7,"Target"),'B07D')
    if b then
        call YZ8(O77(OB7,"Target"))
        call YW8(O77(OB7,"Target"),0,0)
    endif
call NM7(OB7)
call OZ7(t)
endif
set m5=null
set t=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
// Resolve only this event's target. Point casts retain BGX's lowest-life rule.
function B1030GraveResolveTarget takes unit b1030GraveCaster,unit b1030GraveDirect,real b1030GraveX,real b1030GraveY returns unit
local group b1030GraveGroup=null
local unit b1030GraveCandidate=null
local unit b1030GraveChoice=null
local real b1030GraveLife=0.
local real b1030GraveLowest=$F423F
if b1030GraveCaster==null or GetUnitTypeId(b1030GraveCaster)==0 then
return null
endif
if b1030GraveDirect!=null then
if GetUnitTypeId(b1030GraveDirect)!=0 and UnitAlive(b1030GraveDirect) and IsUnitEnemy(b1030GraveCaster,GetOwningPlayer(b1030GraveDirect))==false then
return b1030GraveDirect
endif
return null
endif
set b1030GraveGroup=WS7()
call GroupEnumUnitsInRange(b1030GraveGroup,b1030GraveX,b1030GraveY,400,null)
loop
set b1030GraveCandidate=FirstOfGroup(b1030GraveGroup)
exitwhen b1030GraveCandidate==null
call GroupRemoveUnit(b1030GraveGroup,b1030GraveCandidate)
if GetUnitTypeId(b1030GraveCandidate)!=0 and IsUnitEnemy(b1030GraveCaster,GetOwningPlayer(b1030GraveCandidate))==false and IsAliveNotStrucNotWard(b1030GraveCandidate) and IsHideUnit(b1030GraveCandidate)==false and CHUIFENG(b1030GraveCandidate)==false and IsUnitType(b1030GraveCandidate,UNIT_TYPE_HERO) and DGFS(b1030GraveCandidate)==false then
set b1030GraveLife=GetUnitState(b1030GraveCandidate,UNIT_STATE_LIFE)
if b1030GraveLife<b1030GraveLowest then
set b1030GraveLowest=b1030GraveLife
set b1030GraveChoice=b1030GraveCandidate
endif
endif
endloop
call WR7(b1030GraveGroup)
set b1030GraveGroup=null
set b1030GraveCandidate=null
return b1030GraveChoice
endfunction
function MQE takes nothing returns nothing
local trigger t=null
local integer I97=0
local unit p5=GetTriggerUnit()
local unit IH7=B1030GraveResolveTarget(p5,GetSpellTargetUnit(),GetSpellTargetX(),GetSpellTargetY())
local boolean b=false
if IH7==null then
set p5=null
return
endif
if SuijiMode_HasAghanimState(p5) then
    set b=true
endif
set t=CreateTrigger()
set I97=GetHandleId(t)
call XF7(IH7,'A21I')
call TriggerRegisterTimerEvent(t,5,false)
call B1023RegisterDamage(t,IH7)
call TriggerAddCondition(t,Condition(function MNE))
call NU7(I97,"FX",AddSpecialEffectTarget("war3mapImported\\DarkHands.mdx",IH7,"overhead"))
call NQ7(GetHandleId(IH7),"ShallowGrave|FakeLife",0)
call NQ7(I97,"LastFrame",KQ7())
call NQ7(I97,"FrameDamage",0)
call NT7(I97,"Target",IH7)
call NS7(I97,"HaveA",b)
call OV7(IH7,"ShallowGrave|Active")
call SaveInteger(L7,(GetHandleId((IH7))),((2485)),(1))
set t=CreateTrigger()
set I97=GetHandleId(t)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function MGE))
call NT7(I97,"Target",IH7)
set t=null
set p5=null
set IH7=null
endfunction
