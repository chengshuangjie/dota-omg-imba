call GroupEnumUnitsOfPlayer(VA9,GetOwningPlayer(S79),JJD)
if CountUnitsInGroup(VA9)!=0 then
set ZQ8=FirstOfGroup(VA9)
if ZQ8!=null and OT7(ZQ8,"4327") then
call KR7(S79)
call X37(JID,GetObjectName('n0MN'))
endif
endif
