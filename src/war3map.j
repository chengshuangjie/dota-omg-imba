if ((B287_GetLearnedSkill()=='A2JK' and GetUnitAbilityLevel(b1060GetTriggerUnit,'A2JK')==1) or (B287_GetLearnedSkill()=='A3JK' and GetUnitAbilityLevel(b1060GetTriggerUnit,'A3JK')==1)) and IsUnitIllusion(b1060GetTriggerUnit)==false then
