function VHG takes unit ZX7,unit IH7 returns nothing
local integer BC7=GetUnitAbilityLevel(ZX7,'A27G')
if IsUnitType(IH7,UNIT_TYPE_HERO) then
if BC7==1 then
call Z67(IH7,'A27W',1,10)
elseif BC7==2 then
call Z67(IH7,'A286',1,10)
elseif BC7==3 then
call Z67(IH7,'A285',1,10)
elseif BC7==4 then
call Z67(IH7,'A287',1,10)
endif
else
if BC7==1 then
call Z67(IH7,'A291',1,10)
elseif BC7==2 then
call Z67(IH7,'A28Z',1,10)
elseif BC7==3 then
call Z67(IH7,'A292',1,10)
elseif BC7==4 then
call Z67(IH7,'A290',1,10)
endif
endif
call Y17(Y04,GetUnitX(IH7),GetUnitY(IH7))
endfunction
function VIG takes nothing returns nothing
local real d
if IsUnitInGroup(GetEnumUnit(),ZJ4)==false then
set d=KE7(GetEnumUnit(),ZI4)
if d<ZK4 then
set ZK4=d
set ZH4=GetEnumUnit()
endif
endif
endfunction
function VJG takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer I97=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(I97),(2)))
local unit IH6=(LoadUnitHandle(L7,(I97),(16)))
local unit IH7=(LoadUnitHandle(L7,(I97),(17)))
local group BQ9=(LoadGroupHandle(L7,(I97),($BB)))
local real x=GetUnitX(IH7)
local real y=GetUnitY(IH7)
local group g=WS7()
local integer level=(LoadInteger(L7,(I97),(10)))
local integer id=(LoadInteger(L7,(I97),(11)))
local string sdtx
if id=='Z02X' then
set sdtx="WJWG"
call DestroyEffect(AddSpecialEffectTarget("model\\Hero_GrandMagus_N1S_X_Target.mdl",IH7,"chest"))
else
set sdtx="FADE"
endif
call GroupAddUnit(BQ9,IH7)
call VHG(ZX7,IH7)
call B67(ZX7,IH7,1,75*level)
call MA9(sdtx,IH6,IH7,1,1,1,1,.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl",IH7,"origin"))
call SaveUnitHandle(L7,(I97),(16),(IH7))
if GetTriggerEvalCount(t)==1 then
    call LINGXIA(ZX7,IH7)
endif
set IN4=ZX7
set ZH4=null
set ZI4=IH7
set ZJ4=BQ9
set ZK4=$F423F
call GroupEnumUnitsInRange(g,x,y,650+25,Condition(function A17))
call ForGroup(g,function VIG)
call WR7(g)
if ZH4==null or GetTriggerEvalCount(t)>26 then
call WR7(BQ9)
call FlushChildHashtable(L7,(I97))
call OZ7(t)
else
set IH7=ZH4
call SaveUnitHandle(L7,(I97),(17),(IH7))
endif
set g=null
set t=null
set ZX7=null
set IH6=null
set IH7=null
set BQ9=null
return false
endfunction
