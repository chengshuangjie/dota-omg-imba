local player L82
call KillUnit(YC2)
if BANING then
    if UD0==1 then
        set L82=Z7[1]
    else
        set L82=A7[1]
    endif
    if UM0 or UL0[UD0]<1 or p!=L82 then  //BAN英雄购买触发
        call X37(p,"没有轮到你选择")
        set YC2=null
        set p=null
        set L82=null
        set b1060ReturnValue=false
        set b1060GetSellingUnit=null
        return b1060ReturnValue
    elseif GetUnitTypeId(YC2)=='h06N' then
        call L22(L52(b1060GetSellingUnit),false)
        set YC2=null
        set p=null
        set L82=null
        set b1060ReturnValue=false
        set b1060GetSellingUnit=null
        return b1060ReturnValue
    endif
endif
if QP0[GetPlayerId(p)]==true then
call X37(p,"你已经有一个英雄了")
set YC2=null
set p=null
set L82=null
set b1060ReturnValue=false
set b1060GetSellingUnit=null
return b1060ReturnValue
endif
if p!=QM0 and p!=QN0 then
call X37(p,"没有轮到你选择")
set YC2=null
set p=null
set L82=null
set b1060ReturnValue=false
set b1060GetSellingUnit=null
return b1060ReturnValue
endif
if GetUnitTypeId(YC2)=='h06N' then
call JR2(p,K42(b1060GetSellingUnit),false)
call KillUnit(U30[GetPlayerId(p)])
call KillUnit(U40[GetPlayerId(p)])
endif
set YC2=null
set p=null
set b1060ReturnValue=false
set b1060GetSellingUnit=null
return b1060ReturnValue
endfunction
