function CO3 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IH7=(LoadUnitHandle(L7,(OB7),(17)))
local group BQ9=(LoadGroupHandle(L7,(OB7),(187)))
local real x=0.
local real y=0.
local group g=WS7()
local integer BC7=0
local real dur=0.
local integer id=(LoadInteger(L7,(OB7),(10)))
local string tx
if ZX7==null or IH7==null or BQ9==null or GetUnitTypeId(ZX7)==0 or GetUnitTypeId(IH7)==0 or UnitAlive(ZX7)==false or UnitAlive(IH7)==false then
if BQ9!=null then
call WR7(BQ9)
endif
call WR7(g)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
set g=null
set t=null
set ZX7=null
set IH7=null
set BQ9=null
return false
endif
set x=GetUnitX(IH7)
set y=GetUnitY(IH7)
set BC7=B287_GetUnitAbilityLevel(ZX7,'A06V')
set dur=.6+.1*BC7
if id=='Zkee' then
    set tx="model\\Hero_TormentedSoul_N4S_G_Target.mdl"
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_TormentedSoul_N4S_G_Target2.mdl",IH7,"origin"))
elseif id=='Zkef' then
    set tx="model\\Hero_TormentedSoul_N3S_G_Target.mdl"
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_TormentedSoul_N3S_G_Target2.mdl",IH7,"origin"))
elseif id=='Zkeg' then
    set tx="model\\Hero_TormentedSoul_N2S_G_Target.mdl"
    call DestroyEffect(AddSpecialEffectTarget("model\\Hero_TormentedSoul_N2S_G_Target2.mdl",IH7,"origin"))
else
    set tx="Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl"
endif
call GroupAddUnit(BQ9,IH7)
call B67(ZX7,IH7,1,20+60*BC7)
call Z57(IH7,'A2TY',1,dur,'B0H1')
call DestroyEffect(AddSpecialEffectTarget(tx,IH7,"origin"))
if GetTriggerEvalCount(t)==1 then
    call LINGXIA(ZX7,IH7)
endif
set IN4=ZX7
set ZII=null
set Z1I=IH7
set ZOI=BQ9
set Z2I=999999
call GroupEnumUnitsInRange(g,x,y,475+25,Condition(function A17))
call ForGroup(g,function CO2)
call WR7(g)
if ZII==null or GetTriggerEvalCount(t)>3+BC7 then
call WR7(BQ9)
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
else
set IH7=ZII
call SaveUnitHandle(L7,(OB7),(17),(IH7))
endif
set g=null
set t=null
set ZX7=null
set IH7=null
set BQ9=null
return false
endfunction
