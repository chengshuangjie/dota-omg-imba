call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
call UnitAddAbility(ZX7,'A2AS')
endif
elseif EX7==3 then
if GetUnitAbilityLevel(ZX7,'A2AU')==0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
call UnitAddAbility(ZX7,'A2AU')
endif
elseif EX7==4 then
if GetUnitAbilityLevel(ZX7,'A2AT')==0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
call UnitAddAbility(ZX7,'A2AT')
endif
elseif EX7==5 then
if GetUnitAbilityLevel(ZX7,'A2AQ')==0 then
call UnitRemoveAbility(ZX7,'A2AR')
call UnitRemoveAbility(ZX7,'A2AS')
call UnitRemoveAbility(ZX7,'A2AU')
call UnitRemoveAbility(ZX7,'A2AT')
call UnitRemoveAbility(ZX7,'A2AQ')
call UnitRemoveAbility(ZX7,'A2AP')
call UnitRemoveAbility(ZX7,'B0EZ')
call UnitAddAbility(ZX7,'A2AQ')
endif
elseif EX7>=6 then
if GetUnitAbilityLevel(ZX7,'A2AP')==0 then
