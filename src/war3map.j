function Global_Skill takes nothing returns boolean
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local boolean b1060ReturnValue
local unit ZX7=GetTriggerUnit()
local integer skill=B287_GetSpellAbilityId()
if skill=='A1OV' then
    call MR_chongjibo()
elseif skill=='ABsh' then
    call YG_chongjibo()
elseif skill=='A2S7' and WQ7(b1060GetSpellTargetUnit)==false then
    call  MR_toushi()
elseif skill=='ABS5' and WQ7(b1060GetSpellTargetUnit)==false then
    call  YG_toushi()
elseif skill=='A1P6' and WQ7(b1060GetSpellTargetUnit)==false then
    call  MR_youbu()
elseif skill=='ABen' and WQ7(b1060GetSpellTargetUnit)==false then
    call  YG_youbu()
elseif skill=='A1OU' then
    if WQ7(b1060GetSpellTargetUnit)==false then
        call  MR_jinghua()
    else
        call PLK(b1060GetSpellTargetUnit)
    endif
elseif skill=='ABpu' then
    if WQ7(b1060GetSpellTargetUnit)==false then
        call  YG_jinghua()
    else
        call PLK(b1060GetSpellTargetUnit)
    endif
endif
// if PT4==false and Is_Item_Skill(skill) and GetUnitAbilityLevel(ZX7,'A2VW')>0 then
//     call MH_ReduceUnitAbilityCoolDown(ZX7,skill)
// endif
// if PT4==false and Is_Item_Skill(skill) and GetUnitAbilityLevel(ZX7,'A2VW')>0 then
//     call MH_ReduceUnitAbilityCoolDown(ZX7,skill)
// endif
if skill=='A0RK' then //信使之盾
    call XXZD_TIP(ZX7)
endif
set ZX7=null
set b1060ReturnValue=false
set b1060GetSpellTargetUnit=null
return b1060ReturnValue
endfunction
function Global_Skill_CAST takes nothing returns boolean
