function AUF takes nothing returns nothing
local item b1060GetManipulatedItem=GetManipulatedItem()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit WI7=GetTriggerUnit()
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_DROP_ITEM or b1060GetTriggerEventId==EVENT_PLAYER_UNIT_PAWN_ITEM then
if KZ7(b1060GetManipulatedItem)==DM4 then
