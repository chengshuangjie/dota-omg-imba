function Labike_ZZMF_Skill_Range takes unit u,real d returns real
local integer level=B287_GetUnitAbilityLevel(u,'A4DJ')+B287_GetUnitAbilityLevel(u,'A4DZ')
if level>0 then
	set d=d+50*level
endif
return d
endfunction
function Change_Hero_Skill_Range takes unit u,real d returns nothing
set d=Labike_ZZMF_Skill_Range(u,d)
call MHUnit_AddSpellRange(u,d)
endfunction
//重置技能施法距离
function Reset_Skill_range takes unit u returns nothing
if GetUnitAbilityLevel(u,'A2YK')>0 then
call Change_Hero_Skill_Range(u,200.)
elseif GetUnitAbilityLevel(u,'A2YJ')>0 then
call Change_Hero_Skill_Range(u,150.)
else
call Change_Hero_Skill_Range(u,0.)
endif
endfunction
function is takes unit it returns boolean
return((GetUnitCurrentOrder(it)<$D0020)and(Bz>hq[832+GetPlayerId(GetOwningPlayer(it))]))
endfunction
function K37 takes unit K67 returns boolean
local integer KL7=GetUnitCurrentOrder(K67)
return(KL7==0)or(KL7==$D0005)or(KL7==$D0007)or(KL7==$D0013)or(KL7==$D0019)
endfunction
function AYCC takes unit it returns boolean
return LoadBoolean(L7,GetHandleId(it),'DARK')
endfunction
