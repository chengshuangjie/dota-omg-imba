function KKLeaveAI_CopyEquipment takes unit leaveAITargetHero,unit leaveAISourceHero returns nothing
local integer slot=0
local integer leaveAIPlayerId=GetPlayerId(GetOwningPlayer(leaveAITargetHero))
local integer oldEquipmentBuildGuard=AIBRZB[leaveAIPlayerId]
local item sourceItem=null
local item copiedItem=null
set AIBRZB[leaveAIPlayerId]=1
call AISCZB(leaveAITargetHero)
loop
exitwhen slot>5
set sourceItem=UnitItemInSlot(leaveAISourceHero,slot)
if sourceItem!=null then
set copiedItem=CreateItem(GetItemTypeId(sourceItem),GetUnitX(leaveAITargetHero),GetUnitY(leaveAITargetHero))
if copiedItem!=null then
call SetItemCharges(copiedItem,GetItemCharges(sourceItem))
call SetItemUserData(copiedItem,GetItemUserData(sourceItem))
call SetItemPlayer(copiedItem,GetOwningPlayer(leaveAITargetHero),false)
call SetItemDroppable(copiedItem,false)
call SetItemPawnable(copiedItem,false)
if UnitAddItem(leaveAITargetHero,copiedItem)==false then
call RemoveItem(copiedItem)
endif
endif
endif
set slot=slot+1
endloop
set AIBRZB[leaveAIPlayerId]=oldEquipmentBuildGuard
set sourceItem=null
set copiedItem=null
endfunction
function KKLeaveAI_MirrorNow takes integer leaveAIPlayerId returns boolean
local integer sourcePid=leaveAIPlayerId+6
local integer oldGold=0
local unit targetHero=M7[leaveAIPlayerId]
local unit sourceHero=M7[sourcePid]
if sourceHero==null or GetUnitTypeId(sourceHero)==0 then
set targetHero=null
set sourceHero=null
return false
endif
if targetHero==null or GetUnitTypeId(targetHero)==0 then
if AI_TRI_INIT==null then
set oldGold=GetPlayerState(Player(leaveAIPlayerId),PLAYER_STATE_RESOURCE_GOLD)
call XZE(leaveAIPlayerId,0)
call SetPlayerState(Player(leaveAIPlayerId),PLAYER_STATE_RESOURCE_GOLD,oldGold)
set targetHero=M7[leaveAIPlayerId]
endif
endif
if targetHero==null or GetUnitTypeId(targetHero)==0 then
set targetHero=null
set sourceHero=null
return false
endif
call SetHeroLevel(targetHero,GetHeroLevel(sourceHero),false)
call KKLeaveAI_CopyEquipment(targetHero,sourceHero)
call KKLeaveAI_SetLane(leaveAIPlayerId,eY[64+sourcePid])
set eY[leaveAIPlayerId]=1
call KKLeaveAI_RebuildRoster()
if GetWidgetLife(targetHero)>.405 then
call J3(targetHero,true)
endif
call VV7(bj_FORCE_ALL_PLAYERS,12.,Q[leaveAIPlayerId]+KZ4[leaveAIPlayerId]+"|r 已由电脑接管，并复制第"+I2S(leaveAIPlayerId+5)+"楼 AI 的等级与六格装备。")
set targetHero=null
set sourceHero=null
return true
endfunction
function KKLeaveAI_Retry takes nothing returns nothing
local timer leaveAIRetryExpiredTimer=GetExpiredTimer()
local integer handleId=GetHandleId(leaveAIRetryExpiredTimer)
local integer leaveAIPlayerId=LoadInteger(L7,handleId,1)
local integer attempts=LoadInteger(L7,handleId,2)+1
if KKLeaveAI_MirrorNow(leaveAIPlayerId) or attempts>=120 then
call FlushChildHashtable(L7,handleId)
call PauseTimer(leaveAIRetryExpiredTimer)
call DestroyTimer(leaveAIRetryExpiredTimer)
else
call SaveInteger(L7,handleId,2,attempts)
endif
set leaveAIRetryExpiredTimer=null
endfunction
function KKLeaveAI_Apply takes integer leaveAIPlayerId returns nothing
local player leavingPlayer=Player(leaveAIPlayerId)
local player sourcePlayer=null
local integer allyFloor=1
local timer retryTimer=null
local integer retryId=0
if leaveAIPlayerId<1 or leaveAIPlayerId>5 or KKLeaveAI_Active[leaveAIPlayerId]==false then
set leavingPlayer=null
return
endif
set sourcePlayer=Player(leaveAIPlayerId+6)
call SetPlayerController(leavingPlayer,MAP_CONTROL_COMPUTER)
call ForceAddPlayer(QX4,leavingPlayer)
set QY4[leaveAIPlayerId]=true
loop
exitwhen allyFloor>5
if Z7[allyFloor]!=leavingPlayer then
call SetPlayerAlliance(leavingPlayer,Z7[allyFloor],ALLIANCE_SHARED_CONTROL,true)
call SetPlayerAlliance(Z7[allyFloor],leavingPlayer,ALLIANCE_SHARED_CONTROL,true)
endif
set allyFloor=allyFloor+1
endloop
set Y74[leaveAIPlayerId]=5
call SetPlayerHandicapXPBJ(leavingPlayer,GetPlayerHandicapXPBJ(sourcePlayer))
set Y74[16+leaveAIPlayerId]=R2I(GetPlayerHandicapXPBJ(leavingPlayer))
if AI_TRI_INIT==null then
call Q2F(leavingPlayer,0)
call KKLeaveAI_RegisterEvents(leaveAIPlayerId)
endif
if KKLeaveAI_MirrorNow(leaveAIPlayerId)==false then
set retryTimer=CreateTimer()
set retryId=GetHandleId(retryTimer)
call SaveInteger(L7,retryId,1,leaveAIPlayerId)
call SaveInteger(L7,retryId,2,0)
call TimerStart(retryTimer,1.,true,function KKLeaveAI_Retry)
endif
set leavingPlayer=null
set sourcePlayer=null
set retryTimer=null
endfunction
function KKLeaveAI_DeferredApply takes nothing returns nothing
local timer leaveAIDeferredTimer=GetExpiredTimer()
local integer leaveAIDeferredHandleId=GetHandleId(leaveAIDeferredTimer)
local integer leaveAIPlayerId=LoadInteger(L7,leaveAIDeferredHandleId,1)
call FlushChildHashtable(L7,leaveAIDeferredHandleId)
call PauseTimer(leaveAIDeferredTimer)
call DestroyTimer(leaveAIDeferredTimer)
if KKLeaveAI_Active[leaveAIPlayerId] then
call KKLeaveAI_Apply(leaveAIPlayerId)
endif
set leaveAIDeferredTimer=null
endfunction
function KKLeaveAI_Begin takes nothing returns nothing
local player leavingPlayer=KKLeaveAI_LeavingPlayer
local integer leaveAIPlayerId=GetPlayerId(leavingPlayer)
local timer leaveAIDeferredTimer=null
local integer leaveAIDeferredHandleId=0
if leaveAIPlayerId<1 or leaveAIPlayerId>5 or KKServerScore_InitialHuman[leaveAIPlayerId]==false or KKLeaveAI_Active[leaveAIPlayerId] then
set leavingPlayer=null
return
endif
set KKLeaveAI_Active[leaveAIPlayerId]=true
set leaveAIDeferredTimer=CreateTimer()
set leaveAIDeferredHandleId=GetHandleId(leaveAIDeferredTimer)
call SaveInteger(L7,leaveAIDeferredHandleId,1,leaveAIPlayerId)
call TimerStart(leaveAIDeferredTimer,.25,false,function KKLeaveAI_DeferredApply)
set leavingPlayer=null
set leaveAIDeferredTimer=null
endfunction
function KKLeaveAI_RestoreDroppedItem takes nothing returns nothing
local timer itemReturnTimer=GetExpiredTimer()
local integer itemReturnTimerId=GetHandleId(itemReturnTimer)
local integer leaveAIPlayerId=LoadInteger(L7,itemReturnTimerId,1)
local integer oldEquipmentBuildGuard=AIBRZB[leaveAIPlayerId]
local unit hero=LoadUnitHandle(L7,itemReturnTimerId,2)
local item manipulatedItem=LoadItemHandle(L7,itemReturnTimerId,3)
call FlushChildHashtable(L7,itemReturnTimerId)
call PauseTimer(itemReturnTimer)
call DestroyTimer(itemReturnTimer)
if leaveAIPlayerId>=1 and leaveAIPlayerId<=5 and KKLeaveAI_Active[leaveAIPlayerId] and hero==M7[leaveAIPlayerId] and GetUnitTypeId(hero)!=0 and manipulatedItem!=null and GetItemTypeId(manipulatedItem)!=0 then
call SetItemPlayer(manipulatedItem,Player(leaveAIPlayerId),false)
call SetItemDroppable(manipulatedItem,false)
call SetItemPawnable(manipulatedItem,false)
if not UnitHasItem(hero,manipulatedItem) then
set AIBRZB[leaveAIPlayerId]=1
call UnitAddItem(hero,manipulatedItem)
set AIBRZB[leaveAIPlayerId]=oldEquipmentBuildGuard
endif
endif
set itemReturnTimer=null
set hero=null
set manipulatedItem=null
endfunction
function KKLeaveAI_ProtectItem takes nothing returns nothing
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit hero=GetTriggerUnit()
local integer leaveAIPlayerId=GetPlayerId(GetOwningPlayer(hero))
local item manipulatedItem=GetManipulatedItem()
local timer itemReturnTimer=null
local integer itemReturnTimerId=0
if leaveAIPlayerId>=1 and leaveAIPlayerId<=5 and KKLeaveAI_Active[leaveAIPlayerId] and hero==M7[leaveAIPlayerId] and manipulatedItem!=null then
call SetItemDroppable(manipulatedItem,false)
call SetItemPawnable(manipulatedItem,false)
if b1060GetTriggerEventId==EVENT_PLAYER_UNIT_DROP_ITEM then
set itemReturnTimer=CreateTimer()
set itemReturnTimerId=GetHandleId(itemReturnTimer)
call SaveInteger(L7,itemReturnTimerId,1,leaveAIPlayerId)
call SaveUnitHandle(L7,itemReturnTimerId,2,hero)
call SaveItemHandle(L7,itemReturnTimerId,3,manipulatedItem)
call TimerStart(itemReturnTimer,0.,false,function KKLeaveAI_RestoreDroppedItem)
endif
endif
set hero=null
set manipulatedItem=null
set itemReturnTimer=null
set b1060GetTriggerEventId=null
endfunction
function Q_F takes trigger t,boolean O6,boolean R4F,boolean R7F returns nothing
if(NJ7(O6)!=null)then
call TriggerRegisterPlayerChatEvent(t,NJ7(O6),"-o",false)
call TriggerRegisterPlayerChatEvent(t,NJ7(O6),"-c",false)
call TriggerRegisterPlayerChatEvent(t,NJ7(O6)," c",false)
call TriggerRegisterPlayerChatEvent(t,NJ7(O6)," ",true)
if(IsTriggerEnabled(QA4))then
call TriggerRegisterPlayerChatEvent(QA4,NJ7(O6),"-pa",true)
call TriggerRegisterPlayerChatEvent(QA4,NJ7(O6),"-px",true)
if((NJ7(not O6)==null)and(R7F)) and O04==false then
if(R4F)then
call DisplayTimedTextToPlayer(NJ7(O6),0,0,10.,"你可以使用"+"|c00dd8dff"+"-pa|r/"+"|c00dd8dff"+"-pe|r为友方/敌方选择英雄")
else
call DisplayTimedTextToPlayer(NJ7(O6),0,0,10.,"你可以使用"+"|c00dd8dff"+"-pe|r为友方/敌方选择英雄")
endif
call TriggerRegisterPlayerChatEvent(QA4,NJ7(O6),"-pe",true)
elseif(R4F) and O04==false then
call DisplayTimedTextToPlayer(NJ7(O6),0,0,10.,"你可以使用"+"|c00dd8dff"+"-pa|r为友方选择英雄")
endif
endif
endif
endfunction
function R8F takes nothing returns nothing
local integer i=0
loop
exitwhen i>$F
if M7[i]!=null and GetPlayerController(Player(i))==MAP_CONTROL_COMPUTER and IsUnitInRange(M7[i],IZ4,$3E8)==false and IsUnitInRange(M7[i],JA4,$3E8)==false then
set G97[$B0+i]=0
endif
set i=i+1
endloop
endfunction
function R9F takes nothing returns nothing
local trigger t
set t=CreateTrigger()
call TriggerRegisterUnitInRange(t,JA4,900.,null)
call TriggerAddCondition(t,Condition(function SY7))
call TriggerAddAction(t,function B1060WaitOwner_B6E)
set t=CreateTrigger()
call TriggerRegisterUnitInRange(t,IZ4,900.,null)
call TriggerAddCondition(t,Condition(function SX7))
call TriggerAddAction(t,function B1060WaitOwner_B6E)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,$A,true)
call TriggerAddAction(t,function R8F)
set t=null
endfunction
function RDF takes nothing returns nothing
local player b1060GetTriggerPlayer=GetTriggerPlayer()
local trigger b1060GetTriggeringTrigger=GetTriggeringTrigger()
local trigger t=null
local string VH=GetEventPlayerChatString()
local player pl=K27(S2I(SubString(VH,8,StringLength(VH))))
if(pl!=null)and(pl!=b1060GetTriggerPlayer)and TY7(pl)then
if b1060GetTriggerPlayer==QT4 then
if IsPlayerAlly(GetLocalPlayer(),QT4)then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,Q[0]+"达拉然势力|r的AI队长被授予给"+Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r.")
endif
set QT4=pl
set t=b1060GetTriggeringTrigger
call OZ7(t)
set t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,QT4,"-aigrant",false)
call TriggerAddAction(t,function RDF)
call OZ7(CP4)
set CP4=CreateTrigger()
call Q_F(CP4,true,false,false)
call TriggerAddAction(CP4,function B1060WaitOwner_P2F)
else
if IsPlayerAlly(GetLocalPlayer(),QU4)then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10.,Q[6]+"黑暗势力|r的AI队长被授予给"+Q[GetPlayerId(pl)]+GetPlayerName(pl)+"|r.")
endif
set QU4=pl
set t=b1060GetTriggeringTrigger
call OZ7(t)
set t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,QU4,"-aigrant",false)
call TriggerAddAction(t,function RDF)
call OZ7(CQ4)
set CQ4=CreateTrigger()
call Q_F(CQ4,false,false,false)
call TriggerAddAction(CQ4,function B1060WaitOwner_P2F)
endif
else
call X37(b1060GetTriggerPlayer,"无效的队长选择")
endif
set b1060GetTriggerPlayer=null
set b1060GetTriggeringTrigger=null
endfunction
function REF takes nothing returns boolean
local unit b1060GetEventDamageSource=B1060EventDamageSource()
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(OB7),2))
local unit m5=LoadUnitHandle(L7,(OB7),30)
local real YM7=(LoadReal(L7,(OB7),20))
local real so
local real YNG
local real d=GetEventDamage()
if b1060GetTriggerEventId==EVENT_UNIT_DAMAGED and GetUnitAbilityLevel(b1060GetTriggerUnit,'B0HP')==1 then
if C677(d) then
set YNG=d*(0.45)
set so=d*(1.45)
call YW7("+"+I2S(R2I(so)),1,m5,.023,$FF,0,0,$D8)
call DisableTrigger(t)
call B67(b1060GetEventDamageSource,b1060GetTriggerUnit,7,YNG)
call EnableTrigger(t)
endif
endif
if b1060GetTriggerEventId!=EVENT_UNIT_DAMAGED or(GetUnitAbilityLevel(b1060GetTriggerUnit,'B031')==0 and GetUnitAbilityLevel(b1060GetTriggerUnit,'B0HP')==0)then
call DestroyEffect((LoadEffectHandle(L7,(OB7),32)))
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call B67(p5,m5,1,YM7)
if YM7>0 then
call YW7("+"+I2S(R2I(YM7)),1,m5,.023,$FF,0,0,$D8)
endif
elseif C677(d) then
call SaveReal(L7,(OB7),20,((YM7+d*.3)*1.))
endif
set t=null
set p5=null
set m5=null
set b1060ReturnValue=false
set b1060GetEventDamageSource=null
set b1060GetTriggerEventId=null
set b1060GetTriggerUnit=null
return b1060ReturnValue
endfunction
function RFF takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit p5=(LoadUnitHandle(L7,(OB7),2))
local unit m5=(LoadUnitHandle(L7,(OB7),17))
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
set t=CreateTrigger()
set OB7=GetHandleId(t)
call SaveUnitHandle(L7,(OB7),2,(p5))
call SaveUnitHandle(L7,(OB7),30,m5)
call SaveEffectHandle(L7,(OB7),32,(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl",m5,"overhead")))
call SaveReal(L7,(OB7),20,(0*1.))
call B1023RegisterDamage(t,m5)
call TriggerRegisterTimerEvent(t,5,false)
call TriggerAddCondition(t,Condition(function REF))
set t=null
set p5=null
set m5=null
return false
endfunction
//紫苑 血棘
function RGF takes nothing returns nothing
local unit b1060GetSpellTargetUnit=GetSpellTargetUnit()
local unit b1060GetTriggerUnit=GetTriggerUnit()
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddCondition(t,Condition(function RFF))
call SaveUnitHandle(L7,(OB7),17,(b1060GetSpellTargetUnit))
call SaveUnitHandle(L7,(OB7),2,(b1060GetTriggerUnit))
set t=null
set b1060GetSpellTargetUnit=null
set b1060GetTriggerUnit=null
endfunction
