if p5==null or GetUnitTypeId(p5)==0 then
return
endif
set id=GetUnitTypeId(p5)
if id=='N10R' then
    set tx='h198'
elseif id=='N20R' then
    set tx='h298'
elseif id=='N30R' then
    set tx='h398'
else
    set tx='h098'
endif
if m5==null then
set m5=DME(p5)
endif
if m5==null then
call X37(GetOwningPlayer(p5),GetObjectName('n03H'))
return
endif
call B287_SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A0R0',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(p5),'A2MB',true)
call XF7(p5,'A2MB')
set t=CreateTrigger()
