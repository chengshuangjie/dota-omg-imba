function YMCZ3 takes nothing returns boolean
local eventid b1060GetTriggerEventId=GetTriggerEventId()
local boolean b1060ReturnValue
local trigger t=GetTriggeringTrigger()
local integer OB7=GetHandleId(t)
local unit ZX7=(LoadUnitHandle(L7,(OB7),(2)))
local unit IH7=(LoadUnitHandle(L7,(OB7),(3)))
local integer KP7=(LoadInteger(L7,(OB7),(5)))
local integer ALYCC=(LoadInteger(L7,(OB7),(8)))
local real TargetX=(LoadReal(L7,(OB7),(47)))
local real TargetY=(LoadReal(L7,(OB7),(48)))
local real Y2D=(LoadReal(L7,(OB7),($D)))
local real SourceX=(LoadReal(L7,(OB7),(6)))
local real SourceY=(LoadReal(L7,(OB7),(7)))
local real speed=(LoadReal(L7,(OB7),(1)))
local real Z7D=X57(SourceX+speed*Cos(Y2D))
local real Z8D=X27(SourceY+speed*Sin(Y2D))
local integer Z9D=(LoadInteger(L7,(OB7),($C)))
local location l
local unit BB7
call SetUnitPosition(ZX7,Z7D,Z8D)
call SetUnitFacing(ZX7,Y2D*bj_RADTODEG)
call SaveReal(L7,(OB7),(6),((Z7D)*1.))
call SaveReal(L7,(OB7),(7),((Z8D)*1.))
if ModuloInteger(GetTriggerEvalCount(t),4)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",Z7D,Z8D))
endif
if ModuloInteger(GetTriggerEvalCount(t),3)==0 then
call Y67(Z7D,Z8D,$C8)
endif
if b1060GetTriggerEventId==EVENT_UNIT_DEATH or GetTriggerEvalCount(t)>Z9D then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",Z7D,Z8D))
set BB7=CreateUnit(GetOwningPlayer(ZX7),'e00E',Z7D,Z8D,0)
call XF7(BB7,'A4H5')
call B947IssueImmediateOrderById("YMCZ3 @ war3map.j:175516 (B968)",BB7,$D0080)
call SetUnitPathing(ZX7,true)
if IH7!=null and UnitAlive(IH7) then
call B947IssueTargetOrderById("YMCZ3 @ war3map.j:175519 (B968)",ZX7,$D000F,IH7)
endif
call FlushChildHashtable(L7,(OB7))
call OZ7(t)
call Y67(Z7D,Z8D,200)
if IsPointInRegion(IU4,GetUnitX(ZX7),GetUnitY(ZX7)) then
set l=YV8(GetUnitX(ZX7),GetUnitY(ZX7))
call SetUnitX(ZX7,X57(GetLocationX(l)))
call SetUnitY(ZX7,X27(GetLocationY(l)))
call RemoveLocation(l)
set l=null
endif
endif
set t=null
set ZX7=null
set BB7=null
set IH7=null
set b1060ReturnValue=false
set b1060GetTriggerEventId=null
return b1060ReturnValue
endfunction
function YMCZ2 takes nothing returns nothing
local trigger t=CreateTrigger()
local integer OB7=GetHandleId(t)
local real TargetX=X57(GetSpellTargetX())
local real TargetY=X27(GetSpellTargetY())
local unit ZX7=GetTriggerUnit()
local unit IH7=GetSpellTargetUnit()
local real SourceX=GetUnitX(ZX7)
local real SourceY=GetUnitY(ZX7)
local integer skill=B287_GetSpellAbilityId()
local real a=J77(SourceX,SourceY,TargetX,TargetY)*bj_DEGTORAD
local real speed=24.
call SetUnitPathing(ZX7,false)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,ZX7,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function YMCZ3))
call SaveUnitHandle(L7,(OB7),(2),(ZX7))
if IH7!=null and IsUnitEnemy(IH7,GetOwningPlayer(ZX7))  then
call SaveUnitHandle(L7,(OB7),(3),(IH7))
endif
call SaveReal(L7,(OB7),(47),((TargetX)*1.))
call SaveReal(L7,(OB7),(48),((TargetY)*1.))
call SaveReal(L7,(OB7),(6),((SourceX)*1.))
call SaveReal(L7,(OB7),(7),((SourceY)*1.))
call SaveReal(L7,(OB7),($D),((Atan2(TargetY-SourceY,TargetX-SourceX))*1.))
call SaveInteger(L7,(OB7),($C),(R2I(KF7(SourceX,SourceY,TargetX,TargetY)/speed)))
call SaveReal(L7,(OB7),(1),(speed))
set t=null
set ZX7=null
set IH7=null
endfunction
function YMCZ takes nothing returns nothing
if B287_GetSpellAbilityId()=='A4H4' then
call YMCZ2()
endif
endfunction
