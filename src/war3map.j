if suijiDeathProphetSilenceLevel>0 and SuijiMode_EnsureExactLiveAbilityLevel(suijiDeathProphetLearnedUnit,'A6DP',1,true) and GetUnitAbilityLevel(suijiDeathProphetLearnedUnit,'A02C')>0 then
call SetUnitAbilityLevel(suijiDeathProphetLearnedUnit,'A02C',suijiDeathProphetSilenceLevel)
