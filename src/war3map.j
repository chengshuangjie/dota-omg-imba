function PB8 takes player HY7,string PC8 returns nothing
local force enemyMessageAudience=GetPlayersEnemies(HY7)
if IsPlayerInForce(GetLocalPlayer(),enemyMessageAudience)then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,E9,40,Q[GetPlayerId(HY7)]+(KZ4[GetPlayerId((HY7))])+"|r "+PC8)
endif
call DestroyForce(enemyMessageAudience)
set enemyMessageAudience=null
endfunction
function P38 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
set M14=true
set B1008SelectionPending=false
call OZ7(t)
call DestroyFogModifier(CreateFogModifierRadius(Z7[0],FOG_OF_WAR_MASKED,O_4,P44,700,false,false))
call DestroyFogModifier(CreateFogModifierRadius(A7[0],FOG_OF_WAR_MASKED,O_4,P44,700,false,false))
set t=null
return false
endfunction
//任意单位进入地图排除单位
function P68 takes unit u returns boolean
if B998TempestCreating then
return false
endif
return GetUnitTypeId(u)!='H00M' and not DGFS(u) and GetUnitTypeId(u)!='H07G' and GetUnitTypeId(u)!='H00Y' and GetUnitTypeId(u)!='H00J' and GetUnitTypeId(u)!='H0B8' and GetUnitTypeId(u)!='Z053' and GetUnitTypeId(u)!='NB0S' and GetUnitTypeId(u)!='NTY1' and GetUnitTypeId(u)!='NTY2'
endfunction
//去除了排除地卜师分身
function P68_gai takes unit u returns boolean
if B998TempestCreating then
return false
endif
return GetUnitTypeId(u)!='H00M' and not DGFS(u) and GetUnitTypeId(u)!='H07G' and GetUnitTypeId(u)!='H00Y' and GetUnitTypeId(u)!='H0B8' and GetUnitTypeId(u)!='Z053' and GetUnitTypeId(u)!='NB0S' and GetUnitTypeId(u)!='NTY1' and GetUnitTypeId(u)!='NTY2'
endfunction
function PL8 takes nothing returns boolean
return(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and IsUnitIllusion(GetTriggerUnit())==false and OO7(GetHandleId(GetTriggerUnit()),"EnteredAlready")==false and P68(GetTriggerUnit()))!=null
endfunction
function P18 takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='n00C'
endfunction
function P08 takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function P58 takes player j8 returns nothing
local group LQ7=WS7()
local boolexpr hP=Condition(function P18)
call GroupEnumUnitsOfPlayer(LQ7,j8,hP)
call ForGroup(LQ7,function P08)
call DestroyBoolExpr(hP)
call WR7(LQ7)
set hP=null
set LQ7=null
endfunction
function P28 takes nothing returns boolean
return GetUnitTypeId(GetFilterUnit())=='ncop'
endfunction
function P_8 takes nothing returns nothing
local unit u=GetEnumUnit()
local player p=GetOwningPlayer(u)
local integer id=GetPlayerId(p)
local integer uid=GetUnitTypeId(M7[id])
if VT then
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(1))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(1)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(2))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(2)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(3))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(3)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(4))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(4)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(5))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(5)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(6))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(6)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(7))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(7)))]=false
    endif
    if LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(8))!=uid then
        set J[GetUnitPointValueByType(LoadInteger(TABLE_XJ,(GetHandleId(KU4[id])),(8)))]=false
    endif
call UnitRemoveAbility(KU4[id],'A4DD')
call UnitRemoveAbility(KU4[id],'A4EP')
call FlushChildHashtable(TABLE_XJ,(GetHandleId(KU4[id])))
call UnitAddAbility(KU4[id],'A331')
// call UnitAddAbility(KU4[id],'A4AL')
// call UnitAddAbility(KU4[id],'A4B0')
// call UnitAddAbility(KU4[id],'A4GB')
// call UnitAddAbility(KU4[id],'A4AL')
// call UnitAddAbility(KU4[id],'A4B0')
// call UnitAddAbility(KU4[id],'A4GB')
// call UnitAddAbility(KU4[id],'A4AL')
// call UnitAddAbility(KU4[id],'A4B0')
// call UnitAddAbility(KU4[id],'A4GB')
call UnitAddAbility(KU4[id],'A4HJ')
call UnitAddAbility(KU4[id],'A0HU')
if TV7(p) then
call UnitAddAbility(KU4[id],'A141')
else
call UnitAddAbility(KU4[id],'A1WI')
endif
endif
if GetUnitAbilityLevel(u,'A0I4')==0 then
call UnitAddAbility(u,'A0I4')
endif
set u=null
set p=null
endfunction
function Q48 takes player p returns nothing
local group g=WS7()
call GroupEnumUnitsOfPlayer(g,p,Condition(function P28))
call ForGroup(g,function P_8)
call WR7(g)
set g=null
endfunction
function u6 takes player Ua returns player
local integer O5=1
local integer Uc=0
local boolean O6=false
loop
if((Uc>0)and(NI7(O5,O6)!=null)and(IsPlayerInForce(NI7(O5,O6),QX4)))then
return NI7(O5,O6)
endif
if(Z7[O5]==Ua)then
set O6=true
set Uc=O5
elseif(A7[O5]==Ua)then
set Uc=O5
endif
set O5=O5+1
exitwhen O5>5
endloop
return null
endfunction
function Q78 takes unit WI7,player p returns string
local string s=GetObjectName('n0DB')
set s=L87(s,"$hero",GetUnitName(WI7))
set s=L87(s,"$p",(KZ4[GetPlayerId((p))]))
return s
endfunction
function Q88 takes unit Q98 returns nothing
local item QD8=UnitItemInSlot(Q98,0)
local item QF8=UnitItemInSlot(Q98,1)
local item QG8=UnitItemInSlot(Q98,2)
local item QH8=UnitItemInSlot(Q98,3)
local item QI8=UnitItemInSlot(Q98,4)
local item QJ8=UnitItemInSlot(Q98,5)
local integer QK8=KZ7(QD8)
local integer QM8=KZ7(QF8)
local integer QN8=KZ7(QG8)
local integer QO8=KZ7(QH8)
local integer QP8=KZ7(QI8)
local integer QQ8=KZ7(QJ8)
local integer QR8=0
call DisableTrigger(H94)
call UnitRemoveItem(Q98,QD8)
call UnitRemoveItem(Q98,QF8)
call UnitRemoveItem(Q98,QG8)
call UnitRemoveItem(Q98,QH8)
call UnitRemoveItem(Q98,QI8)
call UnitRemoveItem(Q98,QJ8)
call RemoveItem(QD8)
call RemoveItem(QF8)
call RemoveItem(QG8)
call RemoveItem(QH8)
call RemoveItem(QI8)
call RemoveItem(QJ8)
call EnableTrigger(H94)
if QK8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QK8])
endif
if QM8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QM8])
endif
if QN8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QN8])
endif
if QO8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QO8])
endif
if QP8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QP8])
endif
if QQ8>-1 then
set QR8=QR8+Get_Item_Price(ZU[QQ8])
endif
call SetPlayerState(GetOwningPlayer(Q98),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(Q98),PLAYER_STATE_RESOURCE_GOLD)+QR8)
set dH[GetPlayerId(GetOwningPlayer(Q98))]=0
set QJ8=null
set QI8=null
set QH8=null
set QG8=null
set QF8=null
set QD8=null
endfunction
function HZYJ_SKILL takes unit ZX7,boolean HaveA returns nothing
local integer X8G=(LoadInteger(L7,(GetHandleId(ZX7)),(746)))
local integer HZYJLevel=GetUnitAbilityLevel(ZX7,'A2JK')+GetUnitAbilityLevel(ZX7,'A3JK')
if HZYJLevel==0 then
return
endif
if HaveA then
call UnitRemoveAbility(ZX7,'A2JL')
call XF7(ZX7,'A3JL')
call SetUnitAbilityLevel(ZX7,'A3JL',HZYJLevel)
if X8G>0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A3JL',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2YX',false)
else
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A3JL',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2YX',true)
endif
if GetUnitAbilityLevel(ZX7,'A2JO')>0 then
call UnitRemoveAbility(ZX7,'A2JO')
call XF7(ZX7,'A3JO')
endif
if GetUnitAbilityLevel(ZX7,'A2JP')>0 then
call UnitRemoveAbility(ZX7,'A2JP')
call XF7(ZX7,'A3JP')
endif
if GetUnitAbilityLevel(ZX7,'A2JQ')>0 then
call UnitRemoveAbility(ZX7,'A2JQ')
call XF7(ZX7,'A3JQ')
endif
if GetUnitAbilityLevel(ZX7,'A2JR')>0 then
call UnitRemoveAbility(ZX7,'A2JR')
call XF7(ZX7,'A3JR')
endif
endif
if HaveA==false then
call UnitRemoveAbility(ZX7,'A3JL')
call XF7(ZX7,'A2JL')
call SetUnitAbilityLevel(ZX7,'A2JL',HZYJLevel)
if X8G>0 then
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2JL',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2YX',false)
else
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2JL',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(ZX7),'A2YX',true)
endif
if GetUnitAbilityLevel(ZX7,'A3JO')>0 then
call UnitRemoveAbility(ZX7,'A3JO')
call XF7(ZX7,'A2JO')
endif
if GetUnitAbilityLevel(ZX7,'A3JP')>0 then
call UnitRemoveAbility(ZX7,'A3JP')
call XF7(ZX7,'A2JP')
endif
if GetUnitAbilityLevel(ZX7,'A3JQ')>0 then
call UnitRemoveAbility(ZX7,'A3JQ')
call XF7(ZX7,'A2JQ')
endif
if GetUnitAbilityLevel(ZX7,'A3JR')>0 or GetUnitAbilityLevel(ZX7,'A3JS')>0 or GetUnitAbilityLevel(ZX7,'A3JT')>0 then
call UnitRemoveAbility(ZX7,'A3JR')
call UnitRemoveAbility(ZX7,'A3JS')
call UnitRemoveAbility(ZX7,'A3JT')
call XF7(ZX7,'A2JR')
call SaveInteger(L7,(GetHandleId(ZX7)),(747),(3))
endif
endif
endfunction
