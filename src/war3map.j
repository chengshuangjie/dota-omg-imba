endfunction
function NXI takes nothing returns nothing
local unit b1061SavedGetSpellTargetUnit=GetSpellTargetUnit()
local real b1061SavedGetSpellTargetX=GetSpellTargetX()
local real b1061SavedGetSpellTargetY=GetSpellTargetY()
